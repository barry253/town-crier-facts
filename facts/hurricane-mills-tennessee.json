  "facts": [
    {
      "id": 1,
      "text": "Hurricane Mills originated as a milling hub around a gristmill operated by George Hillman in the 1870s, with a general store, post office, church, and school.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hurricane_Mills,_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name likely comes from the frequent severe storms that once battered the area, a fact that also shaped its early milling operations.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hurricane_Mills,_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1966 Loretta Lynn and her husband Oliver “Doolittle” Lynn bought the ranch, turning it into a 3,500‑acre destination with campsites, cabins, pool, and tubing on Hurricane Creek.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Hurricane_Mills,_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The ranch hosts annual concerts and motocross races, including the AMA Amateur National Motocross Championship since 1982, drawing fans from across the country.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurricane_Mills%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hurricane Mills is part of the Hurricane Mills Rural Historic District, which earned a spot on the National Register of Historic Places for its well‑preserved 19th‑century architecture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hurricane_Mills%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Hurricane Creek watershed, covering about 75 square miles, supports more than 100 rare species of fish, mussels, snails, and crustaceans, making it a hotspot for biodiversity.",
      "sourceSentenceIds": [
        8
      ],
