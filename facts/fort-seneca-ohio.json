  "facts": [
    {
      "id": 1,
      "text": "Fort Seneca was built July 1813 by General William Henry Harrison as a square stockade on a bluff overlooking the Sandusky River.",
      "sourceSentenceIds": [
        3,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_fort_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original fort served as Harrison's headquarters during the War of 1812 before the Battle of Fort Stephenson.",
      "sourceSentenceIds": [
        6,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_fort_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The modern community was platted in 1836 and named after the nearby Old Fort, located two miles away.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Seneca%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Nickel Plate Railroad reached Old Fort in November 1881, spurring trade and growth through the late 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_fort_ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Fort covers about 0.6 square miles, remaining a quiet rural area that preserves its frontier heritage.",
