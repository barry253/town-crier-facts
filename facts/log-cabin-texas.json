  "facts": [
    {
      "id": 1,
      "text": "Log Cabin Village in Fort Worth is a living history museum owned and operated by the City of Fort Worth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.whatsoninfortworth.com/log-cabin-village/"
    },
    {
      "id": 2,
      "text": "Each historic structure in the village is furnished with authentic artifacts, offering a vivid look at 19th‑century North Texas frontier life.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.whatsoninfortworth.com/log-cabin-village/"
    },
    {
      "id": 3,
      "text": "Historical interpreters—City of Fort Worth staff and volunteers—depict the lifestyle of people who settled the area in the mid‑to‑late 1800s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.whatsoninfortworth.com/log-cabin-village/"
    },
    {
      "id": 4,
      "text": "Free admission to Log Cabin Village is available with a library card pass, one pass per loan period per library card.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fortworthtexas.gov/departments/library/services/12-log-cabin-village-passes"
    },
    {
      "id": 5,
      "text": "Admission passes are not valid for group tours, special program fees, or craft fees, only general admission.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fortworthtexas.gov/departments/library/services/12-log-cabin-village-passes"
    },
    {
      "id": 6,
      "text": "Each admission pass must be returned to any Fort Worth Public Library after use.",
