  "facts": [
    {
      "id": 1,
      "text": "Slickville was named for mining official Donald Slick, a key figure in the town’s early development.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slickville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s company housing included single-family homes with indoor plumbing, a rarity for early 20‑century mining towns.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slickville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "The Pennsylvania Railroad last ran through Slickville in the late 1950s, and its abandoned railbed is now a hiking trail to Saltsburg.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slickville%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Slickville’s heyday ended in 1942 when the mine closed, but the original company store and mine office still stand.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slickville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Slickville Historic District was added to the National Register of Historic Places in 1994, preserving its early 20‑century architecture.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thenewpittsburghexposition.org/directory-content/slickville-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2003 a photo captured the abandoned commissary, showing how the town’s once‑busy company store has fallen silent.",
