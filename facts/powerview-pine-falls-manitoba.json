  "facts": [
    {
      "id": 1,
      "text": "Powerview-Pine Falls began as a paper mill town in the mid‑1920s, founded by the Manitoba Pulp and Paper Company.",
      "sourceSentenceIds": [
        10,
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powerview-Pine_Falls"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its proximity to a hydroelectric plant built on the Winnipeg River in 1951.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mhs.mb.ca/docs/municipalities/powerview.shtml"
    },
    {
      "id": 3,
      "text": "In 2005 Powerview merged with the nearby unincorporated area of Pine Falls, creating the present‑day town.",
      "sourceSentenceIds": [
        3,
        8,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://mhs.mb.ca/docs/municipalities/powerview.shtml"
    },
    {
      "id": 4,
      "text": "The original mill changed hands several times—Abitibi, Pine Falls Paper Group, then Tembec—before closing in 2012.",
      "sourceSentenceIds": [
        11,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Powerview-Pine_Falls"
    },
    {
      "id": 5,
      "text": "After the mill shut down, the Pine Falls Health Complex became the largest employer in the community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powerview-Pine_Falls"
    },
    {
      "id": 6,
      "text": "Powerview-Pine Falls sits on the border of the Rural Municipality of Alexander and the Sagkeeng First Nation reserve.",
      "sourceSentenceIds": [
        9
      ],
