      "id": 1,
      "text": "Macedonia, Ohio, was named after the ancient Greek kingdom of Macedon, a nod to settlers who admired that distant land.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
