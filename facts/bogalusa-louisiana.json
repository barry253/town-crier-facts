  "facts": [
    {
      "id": 1,
      "text": "Bogalusa was founded in 1906 by the Goodyear brothers and the Great Southern Lumber Company, its name taken from the nearby Bogue Lusa creek.",
      "sourceSentenceIds": [
        1,
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.bogalusa.gov/page/about-the-city",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At its peak, Bogalusa operated one of the world’s largest sawmills, cementing its status as a lumber powerhouse.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bogalusa.gov/page/about-the-city",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was originally laid out with a “Mill Town” on the south side and a “Commercial Town” on the north, with racially segregated quadrants defined by the railroad and Bogue Lusa Creek.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogalusa%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1965, activists founded Bogalusa’s first Deacons for Defense chapter, a pivotal African‑American self‑defense organization during the civil rights era.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bogalusa%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Bogalusa Paper Mill Museum tells the story of the town’s lumber‑industry roots and its evolution into an industrial hub.",
      "sourceSentenceIds": [
