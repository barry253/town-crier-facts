  "facts": [
    {
      "id": 1,
      "text": "Coloma, named from the Nisenan word \"Cullumah\" meaning \"beautiful valley,\" sits on the South Fork of the American River.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Coloma,_California"
    },
    {
      "id": 2,
      "text": "In 1848, James W. Marshall struck gold at Sutter's Mill near Coloma, igniting the California Gold Rush.",
      "sourceSentenceIds": [
        18,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Coloma%2C_California"
    },
    {
      "id": 3,
      "text": "The Marshall Gold Discovery State Historic Park preserves over 70% of original Coloma, showcasing more than 20 Gold Rush‑era buildings.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Coloma,_California"
    },
    {
      "id": 4,
      "text": "Coloma earned National Historic Landmark District status on July 4, 1961, recognizing its pivotal role in American expansion.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coloma%2C_California"
    },
    {
      "id": 5,
      "text": "The town’s ghost‑town vibe remains, with abandoned civic buildings like the jail, while former boom‑era structures now serve as museums.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coloma%2C_California"
    },
    {
      "id": 6,
      "text": "A replica of Sutter's Mill stands beside the original site, symbolizing the rush’s lasting impact on the region.",
      "sourceSentenceIds": [
        3
      ],
