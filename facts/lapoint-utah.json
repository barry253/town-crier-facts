  "facts": [
    {
      "id": 1,
      "text": "Lapoint earned its name by lying on a southward‑jutting spur, or “point,” of the Uinta Mountains.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapoint%2C_Utah"
    },
    {
      "id": 2,
      "text": "The community sits at 5,568 feet, a high‑elevation spot just inside the Uintah and Ouray Indian Reservation.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapoint%2C_Utah"
    },
    {
      "id": 3,
      "text": "Deep Creek, a tributary of the Uinta River, winds southwest through Lapoint, shaping the local landscape.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapoint%2C_Utah"
    },
    {
      "id": 4,
      "text": "Before settlers arrived, Lapoint was the site of the Fremont “Caldwell Village,” a 1,050‑to‑1,200‑AD archaeological complex.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lapoint%2C_Utah"
    },
    {
