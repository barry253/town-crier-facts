  "facts": [
    {
      "id": 1,
      "text": "Arkwright takes its name from British inventor Richard Arkwright, who pioneered mechanized textile production with the water frame spinning machine.",
      "sourceSentenceIds": [
        2,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arkwright_south_carolina"
    },
    {
      "id": 2,
      "text": "Local investors founded Arkwright Mills in 1896, utilizing water from Fairforest Creek and steam engines to power the facility.",
      "sourceSentenceIds": [
        1,
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arkwright_south_carolina"
    },
    {
      "id": 3,
      "text": "The community grew as a mill village where entire families relied on factory employment, often signing contracts across multiple generations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arkwright_south_carolina"
    },
    {
      "id": 4,
      "text": "During the Great Depression, the Arkwright Mills company diversified its operations by producing smoked hams to sustain the business.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arkwright_south_carolina"
    },
    {
      "id": 5,
      "text": "Remnants of the original mill ruins and dam still persist today along the banks of Fairforest Creek.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arkwright_south_carolina"
    },
    {
      "id": 6,
      "text": "Many homes in Arkwright are single-unit structures, reflecting the town's heritage as a historic textile mill village.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arkwright_south_carolina"
