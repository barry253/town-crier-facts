  "facts": [
    {
      "id": 1,
      "text": "Combs was named after the influential local Combs family, whose legacy shaped the town's early development.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/combs-perry-county-from-dolen-coal-camp-to-a-north-fork-community/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1916, the Louisville and Nashville Railroad opened a station called Combs, tying the town to the regional rail network.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/combs-perry-county-from-dolen-coal-camp-to-a-north-fork-community/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On July 17, 1922, the Combs post office opened with Dewey Colwell as postmaster, just a short distance from the station.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/combs-perry-county-from-dolen-coal-camp-to-a-north-fork-community/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1923, the original landowner subdivided his holdings into residential and commercial lots, spurring Combs' growth toward 900 residents by 1932.",
      "sourceSentenceIds": [
        27,
