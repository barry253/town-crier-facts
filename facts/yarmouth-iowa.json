  "facts": [
    {
      "id": 1,
      "text": "The community was founded in the 1870s and named after Yarmouth, a coastal town in Norfolk, England, likely due to English immigrant settlers in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yarmouth_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Burlington and Northwestern Railway reached Yarmouth in 1881, the nearby La Vega post office moved into the new village and was renamed Yarmouth.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yarmouth_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wells drilled in Yarmouth uncovered the Yarmouth paleosol, an interglacial soil layer buried beneath the Illinoian terminal moraine.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yarmouth_iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yarmouth is located on a broad low ridge that has been identified as a terminal moraine of the Illinoian glaciation.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yarmouth%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village was laid out by Andrew C Kline after arriving here in 1876 and opening a general store.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yarmouth_iowa"
    },
    {
      "id": 6,
      "text": "By 1885, Yarmouth boasted three general stores, a drug store, a blacksmith shop, a billiard hall, and two churches.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
