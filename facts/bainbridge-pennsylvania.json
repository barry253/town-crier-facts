      "id": 1,
      "text": "Bainbridge was founded in 1813 by brothers Henry Haldeman and John B.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew along the Susquehanna River, becoming a stop on the 1832 Pennsylvania Canal and 1838 railroad.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Native Americans lived there before Europeans; Shenks Ferry people built stockaded villages near Conoy Creek around 1200 AD.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Haldeman Mansion, now a museum, sits on the site of an 18th‑century village and showcases the Haldeman family's scientific legacy.",
      "sourceSentenceIds": [
        28,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bainbridge_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bainbridge lies on Pennsylvania Route 441, which runs 9 miles to Middletown and 10 miles to Columbia.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bainbridge%2C_Pennsylvania",
