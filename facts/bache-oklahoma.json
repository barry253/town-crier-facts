  "facts": [
    {
      "id": 1,
      "text": "Bache was established around 1903 as a coal mining camp within the Choctaw Nation of Indian Territory.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bache_oklahoma"
    },
    {
      "id": 2,
      "text": "The community was named for Franklin Bache, a prominent mining operator and co-founder of the Bache-Denman Coal Company.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bache%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Bache is located in the Arkoma Basin, a major geological feature known for its sedimentary rock and historical resource extraction.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bache_oklahoma"
    },
    {
      "id": 4,
      "text": "The Pittsburg County Railway interurban linked Bache to several other local towns from 1903 until 1946.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bache%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "A post office opened in Bache on February 26, 1903, and served the community until it closed in 1995.",
      "sourceSentenceIds": [
