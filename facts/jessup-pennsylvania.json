  "facts": [
    {
      "id": 1,
      "text": "Jessup was first settled in 1849 as part of Winton in Blakely Township before becoming its own borough in 1876.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jessup%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The borough was incorporated on January 8 1877, when the villages of Winton and Jessup were carved from Blakely Township.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jessup_pennsylvania"
    },
    {
      "id": 3,
      "text": "In the early 1890s, new anthracite mines opened, turning Jessup into a bustling coal town.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jessup%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Immigrants from Europe were drawn to Jessup by the booming coal industry, shaping the town’s diverse heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jessup%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Jessup’s name honors Judge William Jessup, a 19th‑century Pennsylvania jurist and railroad president.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jessup_pennsylvania"
    },
    {
      "id": 6,
      "text": "Today, Jessup has evolved from a coal hub into a vibrant residential and commercial community with deep immigrant roots.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lackawannacounty.com/jessup"
