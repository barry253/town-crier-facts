  "facts": [
    {
      "id": 1,
      "text": "Bolivar Peninsula takes its name from South American hero Simón Bolívar, the Venezuelan leader who fought for independence across Latin America.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://bolivarpeninsulatexas.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Point Bolivar Lighthouse, built in 1872, now sits privately owned and is not open to the public.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bolivar_Peninsula%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European arrival, the Karankawa Indians, known for their imposing stature, called the peninsula home.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://crystalbeach.com/area-information/discover/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The late‑19th‑century Gulf & Interstate Railroad linked Bolivar Peninsula to Texas, sparking a tourism boom in the early 1900s.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://crystalbeach.com/area-information/discover/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hurricane Ike struck in 2008, unleashing winds over 170 mph and a storm surge that devastated the peninsula.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://crystalbeach.com/area-information/discover/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Stretching 27 miles, Bolivar Peninsula is a coastal strip rich in farming, ranching, and historic charm.",
      "sourceSentenceIds": [
        12
