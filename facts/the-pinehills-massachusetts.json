    },
    {
      "id": 3,
      "text": "Mirbeau Inn & Spa in the Pinehills is the second U.S. location of the famed spa, the first being in New York's Finger Lakes.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
