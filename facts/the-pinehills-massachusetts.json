    },
    {
      "id": 2,
      "text": "The Pinehills preserves more than 2,200 acres of open space within a 3,060‑acre area, larger than many Massachusetts towns.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
