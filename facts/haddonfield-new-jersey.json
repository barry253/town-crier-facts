        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Haddonfield%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first settler, Quaker Francis Collins, established the Mountwell plantation in 1682.",
      "sourceSentenceIds": [
