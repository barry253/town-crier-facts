  "facts": [
    {
      "id": 1,
      "text": "Orillia sits where Lake Couchiching meets Lake Simcoe, a natural confluence that shaped its early settlement.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orillia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city earned the nickname “Sunshine City” thanks to its long, sunny waterfront that draws tourists for over a century.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.orillialakecountry.ca/tourism-orillia/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Stephen Leacock Museum & National Historic Site in Orillia preserves the home of Canada’s beloved humourist, a key cultural landmark.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experience.simcoe.ca/places-to-go/north-lake-simcoe/orillia/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Orillia’s downtown hosts the famous Mariposa Folk Festival each summer, drawing musicians from around the world.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://experience.simcoe.ca/places-to-go/north-lake-simcoe/orillia/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Sir Sam Steele Building houses the Orillia Museum of Art & History, a hub for local art and culture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orillia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gordon Lightfoot, the legendary folk singer, grew up in Orillia, adding musical heritage to the city’s identity.",
