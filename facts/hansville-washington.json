  "facts": [
    {
      "id": 1,
      "text": "Hansville was named after Norwegian emigrant Hans Zachariasen, one of the first settlers after the lighthouse keepers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hansville%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Point No Point Light, built in 1879, is the oldest lighthouse on Puget Sound and sits within a 60‑acre park.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hansville%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1908 a road linked Hansville to the Point No Point Light, opening the community to travelers for the first time.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hansville%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1924 road to Kingston made Hansville accessible by land, turning it into a resort fishing destination before the 1960s decline.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hansville%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hansville Historical Society preserves local history through archives, oral interviews, and a published book titled “People of the North Kitsap Peninsula.”.",
      "sourceSentenceIds": [
        2,
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hansville.org/hansville-historical-society/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s first permanent non‑lighthouse resident was a Norwegian fisherman who arrived in 1893, marking the start of civilian settlement.",
