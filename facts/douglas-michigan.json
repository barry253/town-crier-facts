  "facts": [
    {
      "id": 1,
      "text": "Douglas was first settled as a lumber mill town in 1851, originally called Dudleyville.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1861 residents renamed the town Douglas to honor Stephen A. Douglas, though some say a relative of the landowner suggested the name.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village created a Historic Preservation Committee in 1991 to protect its civil, religious, social, cultural, and natural history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/douglas-michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Saugatuck-Douglas Historical Society runs a volunteer museum that educates visitors about Douglas’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/douglas-michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Douglas’s 1867 Dutcher Lodge, listed on the Michigan Register of Historic Sites, was recently restored by the village.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
