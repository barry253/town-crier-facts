  "facts": [
    {
      "id": 1,
      "text": "Saylorsburg grew around the Saylor brothers, Charles and Samuel, who lent their name to the village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Saylorsburg,_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 1800s, Saylorsburg was a hub for glazed brick production, supplying homes across the United States.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://monroehistorical.org/articles_files/category-saylorsburg.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saylorsburg sits in the Pocono Mountains, just off PA Route 33, about five miles northwest of Wind Gap.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saylorsburg%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Wildlife here includes black bears, white‑tailed deer, and even bald eagles that soar over the forested hills.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saylorsburg%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s rolling hills and nearby creeks place parts of Saylorsburg in FEMA flood zone A, meaning 100‑year flood risk.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Saylorsburg,_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Saylorsburg straddles both Ross and Hamilton townships, a fact that dates back to its early settlement days.",
