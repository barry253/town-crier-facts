  "facts": [
    {
      "id": 1,
      "text": "Henry Peters founded the town in 1851, platted 25 lots and named it Petersville.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uchistoricalvillage.com/petersville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town boasted Alaska’s only county ferry, crossing the Grand River when water was too high for wagons.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://uchistoricalvillage.com/petersville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Petersville was abandoned long before the 1876 map, with its last county record in 1858.",
      "sourceSentenceIds": [
        2,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.thematsualaska.com/about-the-area/cities-communities/trapper-creek-petersville/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Mining remains active today, but the rugged trails and weathered landscapes tell the story of the Peters Hills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thematsualaska.com/about-the-area/cities-communities/trapper-creek-petersville/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits just south of Denali National Park, bordered to the north by the park itself.",
      "sourceSentenceIds": [
