      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village sits at the foot of Bukhansan Mountain, giving visitors panoramic views and easy access to the Eunpyeong Dulle‑gil Trail.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
