      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jingwansa Temple, just a ten‑minute walk from the village, is considered one of Seoul’s four most prestigious Buddhist temples.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
