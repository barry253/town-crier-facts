      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Eunpyeong Historical Hanok Museum & Observatory is free to visit and offers hands‑on exhibits that tell the area's rich history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
