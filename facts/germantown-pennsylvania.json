  "facts": [
    {
      "id": 1,
      "text": "Germantown was founded in 1683 by German Quakers and Mennonites under Francis Daniel Pastorius, becoming America’s first permanent German settlement.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencepa.com/germantown-historical-district/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Battle of Germantown on October 4, 1777, cemented the town’s Revolutionary War legacy, and Cliveden is now a National Historic Landmark.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencepa.com/germantown-historical-district/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wyck House, an early‑18th‑century National Historic Landmark, stands as a treasured gem in Germantown’s colonial‑era streets.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencepa.com/germantown-historical-district/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every year, Germantown hosts Revolutionary Germantown Day, where locals reenact the 1777 battle with parades and talks.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.experiencepa.com/germantown-historical-district/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Philadelphia’s first railroad, the Philadelphia, Germantown and Norristown line, linked Germantown to Center City’s 9th and Green station.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown%2C_Philadelphia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Germantown’s founding principles of community and equality still echo today, fostering a diverse and spirited neighborhood.",
