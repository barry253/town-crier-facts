  "facts": [
    {
      "id": 1,
      "text": "Founded in 1779 after Bute County split, Warrenton grew as the new county seat of Warren County.",
      "sourceSentenceIds": [
        3,
        4,
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
