    },
    {
      "id": 2,
      "text": "Between 1840 and 1860, Warrenton became North Carolina's richest town, thanks to booming tobacco and cotton trade.",
      "sourceSentenceIds": [
        9,
        10,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrenton%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The historic Jacob Holt House now hosts the Warrenton Visitor Center, preserving the town's architectural legacy.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitnc.com/warrenton-visitor-center"
    },
    {
      "id": 4,
      "text": "More than 90% of Warrenton's buildings are on the National Register, and its historic district covers almost half the town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrenton%2C_North_Carolina"
    },
    {
      "id": 5,
      "text": "Builder Jacob Holt crafted Greek Revival homes across the region, supplying millwork to builders even farther afield.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrenton%2C_North_Carolina"
    },
    {
      "id": 6,
      "text": "The Warrenton Male Academy, founded in 1788, was one of the town's earliest private schools for planters' children.",
