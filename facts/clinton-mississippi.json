  "facts": [
    {
      "id": 1,
      "text": "Clinton was renamed in 1828 to honor DeWitt Clinton, the New York governor who championed the Erie Canal.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clinton%2C_Mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began in 1823 as Mt. Salus, a frontier settlement that grew around a spring called Swafford's Spring.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clinton%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mississippi College, founded in 1826, is the state’s oldest college and the first Baptist university in the world to grant degrees to women.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clinton%2C_Mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clinton Visitor Center showcases the Natchez Trace’s history, with displays that trace the ancient Native American path through the area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.natcheztracetravel.com/natchez-trace-mississippi/jackson-raymond-ms/197-clinton-visitor-center.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every Friday night, the Visitor Center hosts local musicians, turning the historic space into a lively music venue for the community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.natcheztracetravel.com/natchez-trace-mississippi/jackson-raymond-ms/197-clinton-visitor-center.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Clinton‑Vicksburg Railroad, incorporated in 1831, was the second oldest railroad in Mississippi, linking the town to the wider region.",
