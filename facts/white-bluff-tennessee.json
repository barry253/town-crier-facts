  "facts": [
    {
      "id": 1,
      "text": "White Bluff takes its name from the historic White Bluff Iron Forge that once operated on the hill.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Bluff%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A fort appeared on the bluff in 1806, followed by an iron forge a few years later.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Bluff%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was officially platted in 1867, evolving from a Union Army encampment during the Civil War.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Bluff%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "William James Middle School traces its roots to a 1923 donation by Colonel William James, a Spanish–American War officer.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Bluff%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "White Bluff sits at the crossroads of U.S. Route 70 and State Route 47, linking it to Nashville and Dickson.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
