  "facts": [
    {
      "id": 1,
      "text": "Edith Brundage Tillinghast, a pioneer writer, adopted the pen name La Plume, which became the township’s name in 1876.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.laplumetownship.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pennamite Wars of 1769–1771 and 1775 saw early settlers and Native Americans clash over the area that is now La Plume.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.laplumetownship.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tinkenpaugh and Tunkhannock Creeks cut through La Plume’s valley, offering clear, fish‑filled streams that still flow today.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.laplumetownship.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers farmed crops, raised dairy cattle, and tapped maple trees for syrup, shaping La Plume’s rural character.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.laplumetownship.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Keystone College, tracing back to 1868’s Keystone Academy, sits within La Plume, linking the township to a long academic legacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lackawannacounty.com/la-plume",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Covering just 2.4 square miles, La Plume has 3.6 miles of roadway and remains primarily residential.",
      "sourceSentenceIds": [
        5
