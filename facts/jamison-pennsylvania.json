  "facts": [
    {
      "id": 1,
      "text": "Jamison is a small village in Warwick Township, Bucks County, Pennsylvania, along Pennsylvania Route 263.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamison%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The village was first called DeCoursey’s Corner, then Jamison Cross Roads, and became simply Jamison after a post office was established in 1868.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/jamison-pennsylvania.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jamison’s name comes from the Jamison family, whose ancestor Henry Jamison arrived from County Ulster, Ireland, around 1720 and settled in Warwick Township.",
      "sourceSentenceIds": [
        1,
        10,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/jamison-pennsylvania.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Henry Jamison won a $50,000 lottery prize in 1813, a fortune that helped him fund loans for neighbors and grow the community.",
      "sourceSentenceIds": [
        19,
        21,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/jamison-pennsylvania.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Middle Bucks Institute of Technology, a notable technical college, is located in Jamison.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jamison%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Jamison’s proximity to Doylestown and New Hope offers quick access to cultural attractions, historical sites, and dining, making it a convenient spot for travelers.",
