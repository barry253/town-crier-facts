  "facts": [
    {
      "id": 1,
      "text": "Visitacion Valley gets its name from the Spanish \"Visita de la Santa Cruz,\" a 1776 missionary visit that erected a cross.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sanfrancisco.wiki/a/Visitacion_Valley"
    },
    {
      "id": 2,
      "text": "Once a sprawling agricultural area, Visitacion Valley evolved into a diverse residential community after World War II suburbanization.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sanfrancisco.wiki/a/Visitacion_Valley"
    },
    {
      "id": 3,
      "text": "The Schlage Lock Factory, built in 1926, dominated the valley’s economy until its 1999 closure, sparking a long redevelopment saga.",
      "sourceSentenceIds": [
        7,
        9,
        10,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Visitacion_Valley%2C_San_Francisco"
    },
    {
      "id": 4,
      "text": "Sunnydale Housing, originally WWII military barracks, became permanent low‑income homes for veterans after the war.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Visitacion_Valley%2C_San_Francisco"
    },
    {
      "id": 5,
      "text": "Visitacion Valley’s strong African‑American heritage emerged mid‑20th century, shaping its cultural institutions and traditions.",
      "sourceSentenceIds": [
