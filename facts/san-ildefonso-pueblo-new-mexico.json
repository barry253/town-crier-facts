  "facts": [
    {
      "id": 1,
      "text": "San Ildefonso Pueblo was founded around 1300 by people who migrated from the Mesa Verde complex via Bandelier.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Ildefonso_Pueblo%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "In 1598, Spanish explorer Juan de Oñate visited the pueblo and gave it the name San Ildefonso.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://home.nps.gov/subjects/travelspanishmissions/san-ildefonso-pueblo.htm"
    },
    {
      "id": 3,
      "text": "The pueblo sits at the foot of Black Mesa, a prominent landmark in the region.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Ildefonso_Pueblo%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "Maria and Julian Martinez revived the traditional Black‑on‑Black pottery technique in the early 20th century, putting San Ildefonso on the world map.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Ildefonso_Pueblo%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "During the 1692 Reconquista, Spanish forces led by General Diego de Vargas reentered San Ildefonso and secured a promise of peace from its people.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://home.nps.gov/subjects/travelspanishmissions/san-ildefonso-pueblo.htm"
    },
    {
      "id": 6,
      "text": "After the Pueblo Revolt of 1680, the Spanish granted San Ildefonso limited religious freedom and self‑governing rights.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
