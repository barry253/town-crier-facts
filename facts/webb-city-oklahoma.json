  "facts": [
    {
      "id": 1,
      "text": "Webb City was named for its founder, Horace Webb, who settled the land in 1910 and opened the area's first school.",
      "sourceSentenceIds": [
        1,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Webb_City%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Webb City was located at the northern end of the Burbank Oil Field, which was discovered in 1920.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Webb_City%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Osage Railway built a line through Webb City in 1924 to connect Shidler and Lyman during the oil boom.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Webb_City%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "A historic 1924 brick schoolhouse remains a prominent landmark along Main Street in Webb City.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/webb-oklahoma-ghost-town/"
    },
    {
      "id": 5,
      "text": "Local churches continue to serve surrounding rural areas, preventing the complete abandonment of Webb City.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/webb-oklahoma-ghost-town/"
    },
    {
      "id": 6,
      "text": "Webb City struggled with a lack of electricity and scarce water, preventing it from developing into a modern town.",
