  "facts": [
    {
      "id": 1,
      "text": "Lake Barrington began as Indian Lake, a 90‑acre impoundment created by a dam in 1925 that became the village’s centerpiece.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakebarringtonneighborhood.org/articles/the-history-of-lake-barrington-from-marshlands-to-modern-community/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1946 visionary developer Robert Bartlett renamed the area Lake Barrington, setting the stage for its modern identity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakebarringtonneighborhood.org/articles/the-history-of-lake-barrington-from-marshlands-to-modern-community/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Construction of Lake Barrington Shores, a planned residential community, started in 1973 and reshaped the lakeside landscape.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakebarringtonneighborhood.org/articles/the-history-of-lake-barrington-from-marshlands-to-modern-community/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1990 the Shores community boasted more than 1,300 condominium units lining the tranquil lake shore.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakebarringtonneighborhood.org/articles/the-history-of-lake-barrington-from-marshlands-to-modern-community/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village preserves natural corridors with the Fox River Forest Preserve and the village‑owned Fetherling Park, offering wildlife trails and fishing piers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakebarringtonneighborhood.org/articles/the-history-of-lake-barrington-from-marshlands-to-modern-community/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Barrington’s waters are privately managed by the Lake Barrington Shores Homeowners Association, granting residents exclusive swimming and fishing access.",
