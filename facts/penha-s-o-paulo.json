  "facts": [
    {
      "id": 1,
      "text": "Penha’s heart grew around the Igreja de Nossa Senhora da Penha de França, built in 1667 by Mateus Nunes de Siqueira.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/penha/w/hist%C3%B3rico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The church’s devotion turned Penha into a major Marian pilgrimage site, earning it freguesia status in 1796.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/penha/w/hist%C3%B3rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1957, the cornerstone of the current Basílica de Nossa Senhora da Penha was laid, a landmark still visible from the highway.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/penha/w/hist%C3%B3rico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Penha’s name may stem from a French devotee who claimed to see the saint’s image on a cliff, a story passed down orally.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/penha/w/hist%C3%B3rico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district’s growth accelerated in the 20th century when the Engenheiro Goulart train station opened, linking it to downtown São Paulo.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prefeitura.sp.gov.br/web/penha/w/hist%C3%B3rico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the Parque Tiquatira borders the eponymous creek, offering one of the largest green spaces in São Paulo’s eastern zone.",
