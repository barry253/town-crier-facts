  "facts": [
    {
      "id": 1,
      "text": "Mendon’s village hall, officially the Mendon Town Hall, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendon%2C_Ohio"
    },
    {
      "id": 2,
      "text": "Originally named Guilford, Mendon was platted in 1834 before adopting its current name.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendon%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The town organized in 1813, holding its first meeting at Thomas Ewer’s home on West Bloomfield and Cheese Factory Roads.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hfmhistorical.org/history-of-mendon-a-capsule-history/"
    },
    {
      "id": 4,
      "text": "A Mendon post office has been in operation since 1839, serving the community for over two centuries.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendon%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Mendon began as part of Ontario County before joining Monroe County when the latter was formed in 1821.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hfmhistorical.org/history-of-mendon-a-capsule-history/"
    },
    {
      "id": 6,
      "text": "Around 1896, Rochester Junction evolved into a hamlet featuring a railroad station, hotel, and post office.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hfmhistorical.org/history-of-mendon-a-capsule-history/"
