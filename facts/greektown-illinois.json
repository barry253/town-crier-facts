  "facts": [
    {
      "id": 1,
      "text": "Greektown earned the nickname “Greek Delta” because its streets form a triangle resembling the Greek letter Delta.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown%2C_Chicago"
    },
    {
      "id": 2,
      "text": "The neighborhood’s roots trace back to Greek ship captains arriving in the 1840s, who settled near the river and built early homes.",
      "sourceSentenceIds": [
        20,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://nationalhellenicmuseum.org/visit/greektown-and-west-loop/"
    },
    {
      "id": 3,
      "text": "After the 1871 Great Chicago Fire, many Greeks moved into the area, including founder Christ Chakonas, dubbed the “Columbus of Sparta.”.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greektown%2C_Chicago"
    },
    {
      "id": 4,
      "text": "The National Hellenic Museum, housed in a former church, showcases Greek-American contributions and hosts an annual parade that celebrates heritage.",
      "sourceSentenceIds": [
        13,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://achicagoblog.com/explore-the-vibrant-culture-of-greektown/"
    },
    {
      "id": 5,
      "text": "The Parthenon replica, a full‑scale marble structure, stands on the corner of Halsted and Blue Island and is a centerpiece of the neighborhood.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
