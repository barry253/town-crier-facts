  "facts": [
    {
      "id": 1,
      "text": "Haddock was once an incorporated town in 1905, boasting schools, a train station, a saw mill, a bank, and a canning factory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haddock%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community takes its name from the Haddock family, who owned a large plantation in the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haddock%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1870s, Haddock began as a small settlement that later grew into a railroad stop known as Haddocks Station.",
      "sourceSentenceIds": [
        15,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haddock%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, most historic businesses are closed, and Haddock serves mainly as a bedroom community for Macon and Milledgeville.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Haddock%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Haddock sits along State Route 22, just east of Gray, the county seat of Jones County.",
