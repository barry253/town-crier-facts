  "facts": [
    {
      "id": 1,
      "text": "North Greece was founded as part of the Town of Gates and became independent on March 22, 1822.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greeceny.gov/Visitors/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town seat, Charlotte, was named for Lieutenant Colonel Robert Troup’s daughter and reflects the era’s admiration for Greek independence.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greeceny.gov/Visitors/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Greece Road, built in the 1800s, ran north‑south through homesteads and became the area’s main spine.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northgreecegreeceneighborhood.org/from-farmland-to-community-the-rich-history-and-heritage-of-north-greece/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The North Greece United Methodist Church, established in the mid‑1800s, is one of the neighborhood’s oldest institutions.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northgreecegreeceneighborhood.org/from-farmland-to-community-the-rich-history-and-heritage-of-north-greece/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Braddock Bay Park offers summer picnics and a marshy shoreline that once supported orchards and family farms.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northgreecegreeceneighborhood.org/from-farmland-to-community-the-rich-history-and-heritage-of-north-greece/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Greece Public Library’s North Greece branch hosts community learning programs for all ages, continuing a long tradition of local education.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
