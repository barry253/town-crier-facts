      "id": 1,
      "text": "Stoddard was founded in 1853 as a farming community and named after its first postmaster, Hiram Stoddard.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
