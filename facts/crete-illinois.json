  "facts": [
    {
      "id": 1,
      "text": "Crete was originally called Wood's Corner and was founded in 1836 by Vermonters Dyantha Wood, Willard Wood and Gary Neal.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crete%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The Crete Area Historical Society and Museum, along with the adjacent cemetery, is listed on the National Park Service’s Underground Railroad Network to Freedom.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitchicagosouthland.com/1565/crete-area-historical-society-and-museum"
    },
    {
      "id": 3,
      "text": "Crete hosts Balmoral Park Racetrack, a historic horse racing venue that has entertained locals for decades.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crete%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Located just 30 miles south of Chicago’s Loop, Crete has kept its small‑town charm while growing to nearly 9,000 residents.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofcrete.org/our-community/about-us/"
    },
    {
      "id": 5,
      "text": "The village preserves its past through the Crete Area Historical Society, which actively maintains local history and artifacts.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitchicagosouthland.com/1565/crete-area-historical-society-and-museum"
    },
    {
      "id": 6,
      "text": "Crete’s forest preserve and Plum Creek (Goodenow Grove) offer winter ice skating, sledding, and summer hiking, showcasing the area’s natural beauty.",
      "sourceSentenceIds": [
        23
