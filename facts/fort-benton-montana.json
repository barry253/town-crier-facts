      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Benton%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Steamboat trade dominated Fort Benton until transcontinental railroads in the late 19th century ended the era.",
      "sourceSentenceIds": [
