  "facts": [
    {
      "id": 1,
      "text": "Vantage’s original town was flooded when Wanapum Dam filled the Columbia River, forcing residents to relocate uphill.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vantage%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1,640‑foot cantilever bridge opened in 1927, built with workers entering pressurized caissons seventy feet below the riverbed.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vantage%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the bridge, a small ferry launched in 1914 carried only two cars at a time across the Columbia River.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vantage%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wanapum Native Americans have occupied the Vantage area since prehistory, leaving petroglyphs that were later submerged by the dam.",
      "sourceSentenceIds": [
        2,
        10,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vantage%2C_Washington",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic buildings were physically moved to higher ground during the town’s relocation, preserving some original structures.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/vantage-washington-ghost-town/",
      "category": "history",
      "quality": "good",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Remnants of the old town now lie beneath Lake Wanapum, drawing cultural tourists interested in Washington’s submerged history.",
