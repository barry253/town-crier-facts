  "facts": [
    {
      "id": 1,
      "text": "Eleanor was named for Eleanor Roosevelt and established as a New Deal Homestead Community in the 1930s.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Eleanor%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "President Franklin D. Roosevelt and First Lady Eleanor visited Putnam County in 1934 to develop the town as a test site for families.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eleanor%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "Many residences in Eleanor date from the New Deal era and are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/eleanor-west-virginia/"
    },
    {
      "id": 4,
      "text": "Eleanor is situated along the Kanawha River and is part of the Huntington–Ashland metropolitan area.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eleanor%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Early houses in Eleanor were built to look very similar to one another and are now called old Eleanor houses.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eleanor%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "Eleanor was one of three resettlement communities in West Virginia, alongside Arthurdale and Tygart Valley.",
