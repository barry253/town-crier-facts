  "facts": [
    {
      "id": 1,
      "text": "Bigfoot was named for Texas Ranger William A. Wallace when a post office opened there in 1883.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bigfoot%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to 1865, when settlers first crossed Farm Roads 462 and 472 to establish a small community.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.mysanantonio.com/lifestyle/article/bigfoot-texas-what-to-do-20780864.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bigfoot Wallace Museum displays an exact replica of the building where Texans signed the Declaration of Independence in 1836.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mysanantonio.com/lifestyle/article/bigfoot-texas-what-to-do-20780864.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A public school opened in the 1890s, and by 1907 it served 105 students with three teachers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bigfoot%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1950s and 60s, the discovery of the Bigfoot oilfield helped the unincorporated town grow to more than 200 residents.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mysanantonio.com/lifestyle/article/bigfoot-texas-what-to-do-20780864.php",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1890 a Baptist church, a general store, and about 25 people marked Bigfoot’s early community life.",
