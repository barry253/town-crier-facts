  "facts": [
    {
      "id": 1,
      "text": "La Molina began as a Jesuit agricultural estate in the 16th century before evolving into one of Lima’s most affluent districts in the 20th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/peru/lima-region_la-molina"
    },
    {
      "id": 2,
      "text": "The district is home to the University of La Molina, a leading agricultural university that shapes Peru’s agrarian research.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/peru/lima-region_la-molina"
    },
    {
      "id": 3,
      "text": "A wall dubbed the “Wall of Shame” once divided La Molina from nearby slums, symbolizing economic inequality in Peru.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Molina_District"
    },
    {
      "id": 4,
      "text": "Many residents are wealthy individuals, embassy staff, and government officials, reflecting the district’s upscale character.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Molina_District"
    },
    {
      "id": 5,
      "text": "In the early days, the new arrivals—often very poor—erected hastily built shacks in the surrounding hills.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Molina_District"
    },
    {
      "id": 6,
      "text": "During colonial times, the abandoned site later hosted the Hacienda Granados, a notable estate in the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://portal.munimolina.gob.pe/turismo/"
