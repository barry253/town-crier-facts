      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Piermont Railroad Station, a Victorian Stick style building erected in 1873, once served the Erie Railroad’s Northern Branch.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piermont%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The hand‑cranked Sparkill Creek Drawbridge, constructed in 1880 by Cleveland’s King Iron Bridge Company, still spans the creek.",
      "sourceSentenceIds": [
        13
