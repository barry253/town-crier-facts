  "facts": [
    {
      "id": 1,
      "text": "Piermont, founded in the 19th century, grew from an industrial hub into a thriving residential community while keeping its historic waterfront charm.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
