  "facts": [
    {
      "id": 1,
      "text": "Farmington was founded in 1822 as Murphy's Settlement after William Murphy first visited the area in 1798.",
      "sourceSentenceIds": [
        2,
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The town was renamed Farmington in 1825, taking its name from the region’s rich farmland.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_Missouri"
    },
    {
      "id": 3,
      "text": "A post office opened in Murphy's Settlement in 1817, long before the town’s official founding.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_Missouri"
    },
    {
      "id": 4,
      "text": "Farmington became an incorporated town in 1836 and later a village in 1856.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_Missouri"
    },
    {
      "id": 5,
      "text": "The historic Plank Road, built in the mid‑19th century, linked Farmington to Pilot Knob and helped the town grow.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_Missouri"
    },
    {
      "id": 6,
      "text": "The Francois County Jail and Sheriff’s Residence, built in the 1800s, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farmington%2C_Missouri"
    }
  ]
