  "facts": [
    {
      "id": 1,
      "text": "Lalor House on Church Street, once Peter Lalor’s home, stands as a boom‑style landmark in Richmond.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Victoria"
    },
    {
      "id": 2,
      "text": "Access Health and Community at 283 Church Street began as the Richmond Dispensary in 1868, possibly the oldest continuous GP practice in Australia.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Victoria"
    },
    {
      "id": 3,
      "text": "Richmond Town Hall, built in the 1880s and redecorated between the wars, remains a City of Yarra landmark.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Victoria"
    },
    {
      "id": 4,
      "text": "The Richmond Gaol museum holds the town’s prison history, offering a glimpse into its past justice system.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://richmond.vic.guide/Tourism"
    },
    {
      "id": 5,
      "text": "Mid‑19th‑century Richmond was a manufacturing hub, home to factories like Bryant & May, Jaques Limited, and Pelaco.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Victoria"
    },
    {
      "id": 6,
      "text": "Richmond Power Station, erected in 1891, marked the town’s entry into the era of industrial electricity.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Victoria"
