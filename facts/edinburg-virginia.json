  "facts": [
    {
      "id": 1,
      "text": "Edinburg’s 1848 Mill, a Virginia Historic Landmark, survived the Civil War burnings and now houses a museum and wine shop.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://visitshenandoahcounty.com/plan-your-visit/towns-and-villages/edinburg/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Three historic homes—Christian Hockman, Lantz Mill, and John Miley Maphis—are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edinburg%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Edinburg Mill Museum showcases Civil War artifacts and the nation’s first Civilian Conservation Camp, a unique local heritage.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofedinburg.com/attractions/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Heritage Mill Wines 1848, located in the lower level of the historic mill, offers vintages that echo the town’s 19th‑century roots.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofedinburg.com/attractions/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Edinburg Mill Restaurant serves farm‑fresh dishes while guests enjoy views of the mill’s original waterwheel.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofedinburg.com/attractions/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before incorporation in 1852, Edinburg was known as Shryock and Stony Creek, reflecting early settlers’ names.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edinburg%2C_Virginia",
