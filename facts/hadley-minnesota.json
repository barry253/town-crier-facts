  "facts": [
    {
      "id": 1,
      "text": "Hadley began as a Norwegian settlement in 1872 near Summit Lake, was platted and named in 1879, and got its post office in 1880.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hadley_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Railroad officials renamed the site Hadley, replacing Summit Lake, and the village grew into a grid of four streets and four avenues.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hadley_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1991, the village built a community center beside the liquor store for meetings and events, while the long‑standing Clauson Well Company closed in 1995.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hadley_minnesota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Hadley’s average temperatures swing from about 14°F in January to around 72°F in July, reflecting its interior continental climate.",
      "sourceSentenceIds": [
        7
