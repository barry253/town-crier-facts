  "facts": [
    {
      "id": 1,
      "text": "Kootenai County was founded in 1864 and takes its name from the Kootenai tribe that once roamed the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kootenai_County%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Mullan Road was constructed through the area in 1859 with the route originally running on the southern side of Coeur d'Alene Lake.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kootenai_County%2C_Idaho",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1899 the Ellersick family moved their sawmill from Minnesota to a railroad spur near Kootenai, and the surrounding community grew into the town that bears their name.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofkootenai.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A county government was not immediately organized as a result of lack of significant settlement in the region.",
