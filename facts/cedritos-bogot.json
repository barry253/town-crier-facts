  "facts": [
    {
      "id": 1,
      "text": "Usaquén was re-founded as a municipality in 1846 and saw a battle in 1860 between government troops and Tomás Cipriano de Mosquera.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Usaqu%C3%A9n"
    },
    {
      "id": 2,
      "text": "The name Usaquén comes from cacique Usaque, ruler of southern Muisca; in Muysccubun it means 'under the pole'.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Usaqu%C3%A9n"
    },
    {
      "id": 3,
      "text": "In 1954, Usaquén was annexed into Bogotá, ending its status as a separate municipality.",
      "sourceSentenceIds": [
        8,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Usaqu%C3%A9n"
    },
    {
      "id": 4,
      "text": "The colonial quarter preserves Spanish colonial architecture, including the 1665 Santa Barbara church now modernized.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Usaqu%C3%A9n"
    },
    {
      "id": 5,
      "text": "La Aguadora Trail, a hiking path managed by Bogotá Aqueduct Company, runs through Usaquén’s natural hills.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
