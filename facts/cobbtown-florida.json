  "facts": [
    {
      "id": 1,
      "text": "Cobbtown takes its name from the Cobb family, Welsh descendants who migrated from western Georgia via the Old Three Notch Military Road shortly after 1819.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobbtown_florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cobbtown traces its origins to the early 19th century, founded shortly after the 1819 Adams–Onís Treaty transferred Florida from Spain to the U.S.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobbtown_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cobbtown sits on gently rolling hills formed by erosion of sandy soils topped with red clay subsoils.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobbtown_florida"
    },
    {
      "id": 4,
      "text": "Cobbtown experiences a humid subtropical climate, with hot, humid summers and mild winters.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobbtown_florida"
    },
    {
      "id": 5,
      "text": "In July 1943, a military station near Cobbtown opened, spurring local residents to adapt to increased air traffic and wartime economic activity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cobbtown_florida"
    },
    {
      "id": 6,
      "text": "Cobbtown remains an unincorporated community, preserving its rural character without municipal development.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
