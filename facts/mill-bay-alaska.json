  "facts": [
    {
      "id": 2,
      "text": "The Alutiiq people have lived on Kodiak Island for over 7,500 years, with archaeological sites near Mill Bay.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
