  "facts": [
    {
      "id": 1,
      "text": "After World War II, Wong Chuk Hang became a booming industrial hub as refugees from mainland China set up textile, electronics and plastics factories.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cultureplus.asia/features/wong-chuk-hang-from-industrial-zone-to-edgy-art-hub/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the late 1980s, the area housed more than 1,190 factories, a boom helped by the 1982 opening of the Aberdeen tunnel.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://cultureplus.asia/features/wong-chuk-hang-from-industrial-zone-to-edgy-art-hub/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1990s saw most factories relocate to mainland China, leaving Wong Chuk Hang with only a handful of small‑scale operations.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cultureplus.asia/features/wong-chuk-hang-from-industrial-zone-to-edgy-art-hub/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The district’s revival began when artists and designers moved in, drawn by affordable studio spaces and the area’s unique character.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cultureplus.asia/features/wong-chuk-hang-from-industrial-zone-to-edgy-art-hub/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Wong Chuk Hang is a vibrant art district, hosting galleries, murals and street‑art festivals that celebrate contemporary creativity.",
      "sourceSentenceIds": [
        11,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://cultureplus.asia/features/wong-chuk-hang-from-industrial-zone-to-edgy-art-hub/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Aberdeen tunnel, a two‑tube passage, links Wong Chuk Hang with Happy Valley and has been a key transport artery since 1982.",
      "sourceSentenceIds": [
