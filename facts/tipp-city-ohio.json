  "facts": [
    {
      "id": 1,
      "text": "Tipp City began in 1840 as Tippecanoe City, built along the Miami and Erie Canal.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tipp_City%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1938 the town changed its name to Tipp City to avoid confusion with another Ohio Tippecanoe.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tipp_City%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "East of downtown, the dry canal locks still stand, echoing the city’s early waterway era.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tipp_City%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "City Park’s historic Roundhouse remains a beloved picnic spot for families and reunions.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
