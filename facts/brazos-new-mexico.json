  "facts": [
    {
      "id": 1,
      "text": "Brazos sits at the confluence of the Chama River and the Brazos River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brazos_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to Juan de Oñate’s 1598 expedition, which brought Spanish colonial influence into the upper Chama Valley.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brazos_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1832 Manuel Martínez of Abiquiu petitioned for the Tierra Amarilla land grant, covering over 1,000 square miles and including the Rio Brazos area.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brazos_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Los Brazos Historic District, a well‑preserved rural farming village, was listed on the National Register of Historic Places in 1985.",
      "sourceSentenceIds": [
        14,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Brazos%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Conservation efforts by the Trust for Public Land have protected more than 6,780 acres along the Brazos River, preserving habitats for nine threatened or endangered species.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brazos_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early 19th‑century settlers used the Rio Brazos for irrigation, growing flax and supporting ranching, while the river also served as a trade route on the Old Spanish Trail.",
      "sourceSentenceIds": [
        21
