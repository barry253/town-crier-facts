  "facts": [
    {
      "id": 1,
      "text": "San Luis Rey was founded June 13, 1798 by Father La Suén, quickly becoming the most prosperous mission in California.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://californiamissionsfoundation.org/mission-san-luis-rey/"
    },
    {
      "id": 2,
      "text": "The neighborhood takes its name from Mission San Luis Rey de Francia, established in 1798 near its geographic center.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Luis_Rey%2C_Oceanside%2C_California"
    },
    {
      "id": 3,
      "text": "Unlike most California missions, San Luis Rey has remained a Franciscan mission since its founding, one of only two with that continuity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://californiamissionsfoundation.org/mission-san-luis-rey/"
    },
    {
      "id": 4,
      "text": "Since 1996, the San Luis Rey Band hosts an annual inter‑tribal powwow on Mission grounds, open to the public with arts, crafts, food and dancing.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Luis_Rey%2C_Oceanside%2C_California"
    },
    {
      "id": 5,
      "text": "In the late 1950s, some episodes of the television series Zorro were filmed at Mission San Luis Rey, adding a touch of Hollywood history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
