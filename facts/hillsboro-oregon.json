  "facts": [
    {
      "id": 1,
      "text": "Hillsboro was founded in 1842 and named after pioneer David Hill, who donated land for the city.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoregon.com/cities/hillsboro-oregon/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Orenco company town, now a conservation zone, once housed the Oregon Nursery Company and is a key part of Hillsboro’s heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad reached Hillsboro in 1871, but the city declined to give land for a station, keeping the line just south of town.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Oregon",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Historic Landmarks Advisory Committee, formed in 2008, works to preserve landmarks like the giant sequoias outside the County courthouse.",
      "sourceSentenceIds": [
        8,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hillsboro-oregon.gov/services/community-support/grants/historic-preservation",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hillsboro’s downtown features the Morgan and Bailey building, the Imbrie Farmstead, and the Pioneer Cemetery, all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hillsboro-oregon.gov/services/community-support/grants/historic-preservation",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Venetian Theatre, the last historic theater in town, reopened in 2008 and operated until its closure in 2017.",
      "sourceSentenceIds": [
        26
      ],
