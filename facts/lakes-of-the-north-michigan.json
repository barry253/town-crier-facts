  "facts": [
    {
      "id": 1,
      "text": "Lakes of the North incorporated in 1972, becoming one of Michigan’s first property‑owner associations.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesofthenorth.com/Home/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "David Ward, a timber king, owned much of what is now Lakes of the North before the 1912 fires ended the logging era.",
      "sourceSentenceIds": [
        8,
        9,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesofthenorth.com/Home/History",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1968, former Ward lands were split into 19 plats, creating 8,028 lots and 110 miles of roads.",
      "sourceSentenceIds": [
        16,
        17,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesofthenorth.com/Home/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mullett Lake, part of the Inland Waterway, blends historical significance with stunning natural landscapes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan-state.blog/lakes-north-michigan-ultimate-2024-visitor-guide",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1912 fires, residents rebuilt the community, preserving clean air and boating opportunities that still draw visitors today.",
      "sourceSentenceIds": [
        11,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesofthenorth.com/Home/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, more than 1,500 homes line Lakes of the North, a testament to steady growth since the 1960s.",
      "sourceSentenceIds": [
        21
