    },
    {
      "id": 2,
      "text": "The Merion Friends Meeting House, built in 1695, is one of the oldest Quaker meeting houses in the U.S. and a National Historic Landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
