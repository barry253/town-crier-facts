  "facts": [
    {
      "id": 1,
      "text": "Ignatius Mission was founded in 1854 by Jesuit missionaries and is one of Montana's oldest standing buildings.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/st-ignatius/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ignatius Mission is a National Historic Landmark and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://discoveringmontana.com/towns/st-ignatius/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1919, a forest fire devastated most of St. Ignatius, sparing only a bank, a store, a hotel, and the historic Catholic Church located west of the town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofstignatius.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "St. Ignatius sits on the Flathead Indian Reservation, where indigenous culture and Catholic mission history intertwine.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/st-ignatius/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The mission is also home to a museum and gift shop that sell books and souvenirs related to its history.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/st-ignatius/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "U.S. Route 93 runs through St. Ignatius, linking the town to the broader Montana highway network.",
