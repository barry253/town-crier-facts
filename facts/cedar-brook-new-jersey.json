  "facts": [
    {
      "id": 1,
      "text": "Cedar Brook grew from a mid‑19th‑century hamlet that sprang up along the Philadelphia and Atlantic City Railroad, which helped move farm produce and timber.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_brook",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Cedar Brook likely honors the Atlantic white cedar trees that lined local wetlands and streams such as Pump Branch, a tributary of the Great Egg Harbor River.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cedar_brook",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cedar Brook sits within Winslow Township, a community that was incorporated in 1845 from parts of Gloucester Township.",
      "sourceSentenceIds": [
        11,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winslow_Township%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The area once hosted a thriving glass industry, powered by abundant timber, clay, and sand, though the industry faded by the early 1900s.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winslow_Township%2C_New_Jersey",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "St. Lucy’s Roman Catholic Church, a historic landmark on Route 73, marks one of the township’s oldest community centers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winslow_Township%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cedar Brook’s gentle west‑to‑east slope directs surface water flow, shaping the local landscape and influencing early settlement patterns.",
      "sourceSentenceIds": [
        9
