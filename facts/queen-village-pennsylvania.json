      "id": 1,
      "text": "Queen Village was named after Sweden's Queen Christina, honoring the area’s earliest Swedish settlers.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
