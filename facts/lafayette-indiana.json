  "facts": [
    {
      "id": 1,
      "text": "Lafayette was founded on May 25, 1825, when William Digby laid out the town on the Wabash River’s southeast bank.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lafayette.in.gov/3728/City-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors the French Revolutionary War hero Marquis de Lafayette, who was touring the United States at the time of the town’s founding.",
      "sourceSentenceIds": [
        3,
        9,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lafayette%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads arrived in the 1850s, linking Lafayette to major markets and later becoming part of the Monon Railroad network.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lafayette%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1865, local entrepreneur Moses Digby and his wife Rebecca built the Ball Mansion on Prospect Hill, a landmark that still stands on South Ninth Street.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lafayette.in.gov/3728/City-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Lafayette, across the river, became the seat of Purdue University in 1869, a land‑grant college founded thanks to a gift from local businessman John Purdue.",
      "sourceSentenceIds": [
        10
      ],
