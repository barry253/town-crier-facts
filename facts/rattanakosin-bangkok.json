  "facts": [
    {
      "id": 1,
      "text": "Rattanakosin was founded in 1782 when King Rama I moved the capital to Bangkok, starting the Chakri Dynasty.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rattanakosin_Kingdom_(1782%E2%80%931932)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Rattanakosin means 'Jewel of Indra,' a nod to the Emerald Buddha that King Rama I honored during his coronation.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rattanakosin_Kingdom_(1782%E2%80%931932)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rattanakosin Island houses Bangkok’s most famous landmarks, from the Grand Palace to Wat Pho, all clustered on the historic island.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thisisbangkok.com/see-and-do/neighborhoods/rattanakosin-island/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The island is a cultural heritage hub, showcasing traditional Thai architecture and dozens of temples that date back centuries.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thisisbangkok.com/see-and-do/neighborhoods/rattanakosin-island/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rattanakosin’s age exceeds 240 years, making it one of the oldest continuously inhabited capitals in Southeast Asia.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thisisbangkok.com/see-and-do/neighborhoods/rattanakosin-island/",
      "category": "history",
      "quality": "good"
    }
  ],
