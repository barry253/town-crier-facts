  "facts": [
    {
      "id": 1,
      "text": "Bovina Center’s name comes from the early cattle herds that once grazed the area, a nod to its dairy roots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bovina_center_historic_district",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Alexander Brush cleared land near the Little Delaware River in 1794, founding the spot that would become Bovina Center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bovina_center_historic_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bovina Center Historic District, listed on the National Register in 2000, preserves the hamlet’s 19th‑century architecture.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bovina%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area was part of the Hardenburgh Patent, a 1.5‑million‑acre grant from Queen Anne in 1708.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bovina_center_historic_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A former two‑room school built in 1893 now houses the town library, a testament to local self‑sufficiency.",
      "sourceSentenceIds": [
        10
      ],
