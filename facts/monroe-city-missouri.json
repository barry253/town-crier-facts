    {
      "id": 1,
      "text": "Monroe City was platted in 1857 and named for its location within Monroe County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monroe_City%2C_Missouri"
    },
    {
      "id": 2,
      "text": "The town evolved from Monroe Station, a railroad stop, into Monroe City in 1869 after the Hannibal and Central Missouri Railroads reached the area in 1871.",
      "sourceSentenceIds": [
        13,
        20,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.monroecitychamber.com/history"
    },
    {
      "id": 3,
      "text": "Monroe City sits at the junction of Monroe, Marion, and Ralls counties, making it a tri‑county hub.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.monroecitychamber.com/history"
    },
    {
      "id": 4,
      "text": "The historic Jude's Episcopal Church and Washington School in Monroe City are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
