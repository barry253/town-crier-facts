  "facts": [
    {
      "id": 1,
      "text": "Andersonville was named after John Anderson, a South Western Railroad director, when the line reached the town in 1853.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andersonville%2C_Georgia"
    },
    {
      "id": 2,
      "text": "During the Civil War, Andersonville hosted a prisoner‑of‑war camp that later became the Andersonville National Historic Site.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andersonville%2C_Georgia"
    },
    {
      "id": 3,
      "text": "The historic site includes the prison camp, the National Prisoner of War Museum, and Andersonville National Cemetery, all managed by the National Park Service.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thetruewilderness.com/andersonville-ga/"
    },
    {
      "id": 4,
      "text": "A replica of Camp Sumter’s gate stands at the site, reminding visitors of the original 16.5‑acre stockade chosen in 1863.",
