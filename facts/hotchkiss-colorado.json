  "facts": [
    {
      "id": 1,
      "text": "Hotchkiss was named for Walter Hotchkiss, a key figure in the Denver & Rio Grande Railroad, which arrived in 1882.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colorado.wiki/a/Hotchkiss,_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at 5,584 feet in a valley carved by the North Fork of the Gunnison River, surrounded by the West Elk Mountains and Grand Mesa.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colorado.wiki/a/Hotchkiss,_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hotchkiss became a major fruit shipping hub by the early 20th century, with orchards of peaches, pears, apples, and cherries dominating the landscape.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colorado.wiki/a/Hotchkiss,_Colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town celebrated its agricultural roots with the Hotchkiss Sweet Cherry Festival, drawing visitors from across the region each year.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colorado.wiki/a/Hotchkiss,_Colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hotchkiss‑Crawford Historical Society Museum, located on 2nd Street, preserves artifacts that chronicle the town’s pioneer and mining heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
