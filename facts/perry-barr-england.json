  "facts": [
    {
      "id": 1,
      "text": "Perry Barr's name comes from Old English 'pirige' meaning pear tree and Celtic 'barro' meaning hill top.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry_Barr",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area once had two separate settlements recorded as Pirio and Barre in the Domesday Book.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wikishire.co.uk/wiki/Perry_Barr",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The old Perry Barr railway station, opened in 1837, is one of the oldest stations still on its original site.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perry_Barr",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The remains of a Roman fort can still be seen near Perry Barr Locks, linking the area to ancient military history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townandvillageguide.com/West_Midlands/Perry_Barr.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Birmingham Polytechnic, now Birmingham City University, was formed in 1971 after Aston Technical College moved to Perry Barr in the 1960s.",
      "sourceSentenceIds": [
