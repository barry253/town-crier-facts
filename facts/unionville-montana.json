  "facts": [
    {
      "id": 1,
      "text": "Unionville sprang from the Whitlatch-Union Mine, named after discoverer James Whitlatch and his Union Army service.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128192"
    },
    {
      "id": 2,
      "text": "Unionville's mine yielded over 17,000 ounces of gold, 8,000 ounces of silver, and 40 tons of lead.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unionville%2C_Montana"
    },
    {
      "id": 3,
      "text": "In 1926, the movie 'The Growler Girl' was filmed in Unionville, one of Montana's first on‑location productions.",
      "sourceSentenceIds": [
        12,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Unionville,_Montana"
    },
    {
      "id": 4,
      "text": "Many of Unionville's old, historic buildings still stand today, preserving its mining‑era charm.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Unionville,_Montana"
    },
    {
      "id": 5,
      "text": "Despite losing its mine, Unionville kept a distinct identity, remaining active through the 1950s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unionville%2C_Montana"
    },
    {
      "id": 6,
      "text": "Today, Unionville thrives as a bedroom community for Helena, yet its mining heritage remains visible.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128192"
    }
