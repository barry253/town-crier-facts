  "facts": [
    {
      "id": 1,
      "text": "Roulette was officially named Roulet in 1816 to honor John S. Roulette, a land partner of John Keating.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roulettetwp.com/about-our-township-2/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1816 a court confirmed Roulette township, spanning 18 miles long by 5 wide, covering present‑day Clara, Sharon, Pleasant Valley and Roulette.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pa-roots.com/potter/beershistory/chapter21.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When a locomotive whistle rang in 1883, Roulette sprang to life with Benton & Co.'s steam mill and a new sash and blind factory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pa-roots.com/potter/beershistory/chapter21.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Allegheny River cuts through Roulette, joined by Trout Brook and Fishing Creek, creating a valley of clear, swift streams.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pa-roots.com/potter/beershistory/chapter21.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early mining in Roulette centered on coal measures found along Trout Brook and other nearby creeks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pa-roots.com/potter/beershistory/chapter21.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Roulette township maintains over 28 miles of roads, a testament to its rural infrastructure.",
