  "facts": [
    {
      "id": 1,
      "text": "Uehling was founded in 1905 by Theodore Uehling, who sold land to the Burlington and Missouri Railroad.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.uehlingnebraska.com/"
    },
    {
      "id": 2,
      "text": "The village was named after its founder, Theodore Uehling, the original owner of the town site.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uehling%2C_Nebraska"
    },
    {
      "id": 3,
      "text": "Uehling became an incorporated village in 1906, just a year after its founding.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Uehling%2C_Nebraska"
    },
    {
      "id": 4,
      "text": "The town offices now sit in the old fire station at the north end, where maintenance crews keep equipment.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uehlingnebraska.com/"
    },
    {
      "id": 5,
      "text": "The Uehling family built a general store, two hotels, a drug store, and a newspaper that served early residents.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uehlingnebraska.com/"
    },
    {
      "id": 6,
      "text": "The Uehling School, founded by the family, offered early education to village children.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
