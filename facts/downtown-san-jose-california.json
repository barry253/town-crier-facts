      "id": 1,
      "text": "Downtown San Jose hosts the Cathedral Basilica of St. Joseph, a landmark noted for its hand‑painted murals, stained glass, and custom organ.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
