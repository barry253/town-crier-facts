  "facts": [
    {
      "id": 1,
      "text": "West Monroe was first settled in 1806 when four farmers bought land from George Scriba for just a few dollars per acre.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Monroe%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town officially formed on March 21, 1839, carved out of the older town of Constantia.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Monroe%2C_New_York"
    },
    {
      "id": 3,
      "text": "The West Monroe Historical Society, founded in 1972, runs a museum that showcases the town’s rich heritage.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/21666"
    },
    {
      "id": 4,
      "text": "The society’s museum houses a wide array of artifacts, documents, and photographs that chronicle West Monroe’s past.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/21666"
    },
    {
      "id": 5,
      "text": "Originally covered by dense timber, the area supported several saw mills that once thrived along the local waterways.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://genealogytrails.com/ny/oswego/countyhistory_westmonroe.html"
    },
    {
      "id": 6,
      "text": "West Monroe’s southern boundary follows the mean high‑water mark on the south shore of Oneida Lake.",
