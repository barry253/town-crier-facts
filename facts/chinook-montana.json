    },
    {
      "id": 2,
      "text": "Chinook has been home to the Sugarbeeters ever since the Utah-Idaho Sugar Company helped purchase jerseys for the boys' basketball team in 1929.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chinook%2C_Montana"
    },
    {
      "id": 3,
      "text": "The town center hosts the Blaine County Museum and the Blaine County Wildlife Museum, showcasing regional history and wildlife.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
