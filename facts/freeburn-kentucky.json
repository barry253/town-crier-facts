  "facts": [
    {
      "id": 1,
      "text": "Freeburn got its name in 1932, a nod to a coal seam that burned freely, linking the town forever to its mining roots.",
      "sourceSentenceIds": [
        1,
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeburn%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Freeburn’s post office opened in 1933, following the town’s naming after the Freeburn Coal and Coke Company.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/freeburn-pike-county-coal-coke-and-a-company-town-on-the-tug-fork/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Freeburn sits where Peter Creek meets the Tug Fork of the Big Sandy River, a natural crossroads that shaped its early industry.",
      "sourceSentenceIds": [
        15,
        20,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/freeburn-pike-county-coal-coke-and-a-company-town-on-the-tug-fork/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A vital rail link ran north to Portsmouth, Ohio, connecting Freeburn’s coke ovens to the wider industrial market.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://appalachianhistorian.org/freeburn-pike-county-coal-coke-and-a-company-town-on-the-tug-fork/",
      "category": "transport",
      "quality": "good"
    },
    {
