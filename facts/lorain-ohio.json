  "facts": [
    {
      "id": 1,
      "text": "Lorain was first called Black River, became Charleston in 1836, and adopted its current name in 1874 after the county, itself named for Lorraine, France.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lorain",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on Lake Erie’s shoreline at the mouth of the Black River, about 25 miles west of Cleveland.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lorain%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Norfolk Southern Railway runs a freight line parallel to the lake, keeping Lorain connected to the national rail network.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lorain%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 11th Street Bridge, a single‑track vertical‑lift truss built in 1974, carries the Norfolk‑Southern line over the lakefront.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lorain%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1924 a devastating tornado struck Lorain, killing 72 people and leaving the city with one of Ohio’s highest single‑building death tolls.",
      "sourceSentenceIds": [
        27,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lorain%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Lorain Historical Society, founded in 1981, preserves the city’s heritage through exhibits, programs, and research.",
