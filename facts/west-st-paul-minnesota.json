  "facts": [
    {
      "id": 1,
      "text": "West St. Paul earned its confusing name from its position on the west bank of the Mississippi River, not simply because it lies west of South St. Paul.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_St._Paul%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Saint Paul annexed the West Side in 1887 to curb criminals escaping across the county line and to eliminate Wabasha Street Bridge tolls that stunted development.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_St._Paul%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before settlement, the area that is now West St. Paul was bordered by Sioux villages Kaposia to the east and Mendota to the west.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wspmn.gov/159/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Robert Street honors Captain Louis Robert, a Mississippi River boat captain and early French‑Canadian settler of Saint Paul.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_St._Paul%2C_Minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West St. Paul’s 2.5‑mile retail strip along Robert Street has been a commercial hub since the early 20th century.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_St._Paul%2C_Minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city of West St. Paul was officially incorporated in 1889, following the dissolution of the earlier independent town of Paul.",
