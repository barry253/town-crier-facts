  "facts": [
    {
      "id": 1,
      "text": "Matinecock Village traces its roots to the 17th‑century Native American Matinecock tribe that once spanned from Newtown to the Nissequogue River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.matinecockvillage.gov/HistoryOfMatinecock.aspx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1643, settlers Robert Fordham and John Carman crossed the Long Island Sound to negotiate land with local tribes, founding the area that would become Matinecock.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hempstead_(village)%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s name honors the Matinecock people, whose territory was later absorbed into the Town of Hempstead and Nassau County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hempstead_(village)%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Friends Academy School opened in 1876, founded by Gideon Frost to serve the children of the local Quaker community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.matinecockvillage.gov/HistoryOfMatinecock.aspx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Matinecock’s railroad history includes a terminus at Locust Valley until 1889, when the line extended to Oyster Bay, linking the village to broader Long Island trade.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.matinecockvillage.gov/HistoryOfMatinecock.aspx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s first incorporated status dates to May 6, 1853, making it the earliest incorporated community in what is now Nassau County.",
      "sourceSentenceIds": [
        28
