  "facts": [
    {
      "id": 1,
      "text": "Woods Bay was named after John Wood, who arrived in 1891 and established the first cherry orchards on the lake's shore.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127930",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Located on Flathead Lake’s eastern shore, Woods Bay sits at the lake’s northern tip, overlooking the largest natural freshwater body between the Mississippi and the Pacific.",
      "sourceSentenceIds": [
        4,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Woods_Bay%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Woods Bay Recreation Area offers a day-use boat ramp, dock, restrooms, and trailer access up to 30 feet, making it a popular spot for fishing and windsurfing.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoveringmontana.com/towns/woods-bay/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "John Wood’s family grew Bing and Royal Anne cherries, among the first to market Montana cherries eastward, while apple and plum orchards also thrived nearby.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127930",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woods Bay sits at an elevation of 2,902 feet, offering panoramic views of Flathead Lake and the surrounding mountains.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
