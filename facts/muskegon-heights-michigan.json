  "facts": [
    {
      "id": 1,
      "text": "Muskegon Heights gets its name from the Potawatomi word 'mishigamaa,' meaning 'great water,' a nod to Lake Michigan.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/muskegon-heights-41178",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city officially incorporated on January 2, 1891, after growing from a lumber and foundry region.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muskegon_Heights%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Route 31, known locally as Seaway Drive, traces the western edge of Muskegon Heights.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muskegon_Heights%2C_Michigan",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "In 1938, a five‑page 'Chronological History of the City of Muskegon Heights' was published by the city.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Muskegon_Heights%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area’s economy once thrived on manufacturing and shipping, a legacy still visible in its architecture.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/muskegon-heights-41178",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Native American tribes, especially the Potawatomi, historically used Muskegon Heights’ abundant natural resources.",
