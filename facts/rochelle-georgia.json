  "facts": [
    {
      "id": 1,
      "text": "Rochelle sprang to life in 1887 when the Americus, Preston, and Lumpkin Railroad crossed Wilcox County, sparking a new town at the tracks.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochelle%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors France’s La Rochelle, chosen by the Georgia General Assembly when Rochelle was incorporated in 1888.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochelle%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A devastating fire just a decade after its founding razed much of downtown, but the community rebuilt and kept growing.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochelle%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1913 Rochelle issued municipal bonds to build its first water supply and electrical system, modernizing the town for the first time.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochelle%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cotton dominated the surrounding county’s economy through World War I, but falling prices and the Great Depression slowed Rochelle’s growth for decades.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochelle%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic residential neighborhood in Rochelle is so notable that it has earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
