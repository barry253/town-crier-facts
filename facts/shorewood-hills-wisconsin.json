    },
    {
      "id": 2,
      "text": "Olympic speed skating medalists Eric and Beth Heiden were raised in Shorewood Hills, and the local skating rink features the Heiden Haus.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shorewood_Hills%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Streets in the College Hills part of Shorewood Hills are all named after various colleges and universities.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shorewoodhillswi.gov/?SEC=9167A934-66D5-43AC-BE54-E34B625D271D&Type=B_BASIC"
    },
    {
      "id": 4,
      "text": "The land in Shorewood Hills was originally covered in prairie and oak forest before the village was established.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://shorewoodhillswi.gov/?SEC=9167A934-66D5-43AC-BE54-E34B625D271D&Type=B_BASIC"
    },
    {
      "id": 5,
      "text": "Certain areas of the Blackhawk Country Club in Shorewood Hills are preserved and listed on the National Register of Historic Places.",
