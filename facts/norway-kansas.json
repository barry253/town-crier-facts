  "facts": [
    {
      "id": 1,
      "text": "Rasmus Rimol from Trondheim, Norway, became Norway, Kansas's first settler when he arrived in February 1869.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/norway-kansas/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Soon after, a colony of ten Norwegian families settled in Norway, Kansas.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/norway-kansas/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Norway's post office opened on October 3, 1870, with Rasmus Rimol serving as its first postmaster.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/norway-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1910, Norway lay on the Missouri Pacific Railroad, connecting it to regional trade.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/norway-kansas/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, an active Lutheran church stands beside abandoned businesses and a historic school gymnasium.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://legendsofkansas.com/norway-kansas/",
