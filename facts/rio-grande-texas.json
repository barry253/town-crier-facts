  "facts": [
    {
      "id": 1,
      "text": "From 1848 until the railroad opened in 1883, Rio Grande City was a key trade hub between Texas and Mexico.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rio_Grande_City%2C_Texas"
    },
    {
      "id": 2,
      "text": "Despite its isolation, Rio Grande City thrived as a cattle center and maintained a bustling ship trade with New Orleans in the 19th century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.achp.gov/preserve-america/community/rio-grande-city-texas"
    },
    {
      "id": 3,
      "text": "Historic Fort Ringgold and the La Borde House remain prominent landmarks in Rio Grande City and are preserved as reminders of the town’s early frontier days.",
      "sourceSentenceIds": [
        10,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/rio-grande-city-texas"
    },
    {
      "id": 4,
      "text": "Rio Grande City sits on the Rio Grande River and serves as the county seat of Starr County.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rio_Grande_City%2C_Texas"
    },
    {
      "id": 5,
      "text": "The city is part of “Los Caminos del Rio,” a 200‑mile heritage corridor that showcases a blend of Hispanic, Latino, and Anglo cultures.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.achp.gov/preserve-america/community/rio-grande-city-texas"
    },
    {
      "id": 6,
      "text": "The Rio Grande City–Camargo International Bridge links the city directly to Camargo, Tamaulipas, across the Rio Grande.",
