  "facts": [
    {
      "id": 1,
      "text": "Basalt was originally called Aspen Junction until 1895, when the name changed to honor the local basalt rock formations.",
      "sourceSentenceIds": [
        1,
        4,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Basalt%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Colorado Midland Railroad arrived in 1887, turning the area into a bustling rail hub for miners and charcoal producers.",
      "sourceSentenceIds": [
        21,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://basaltchamber.org/discover/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seven charcoal kilns were built in 1882 near the confluence of the Roaring Fork and Fryingpan Rivers to supply smelters in Aspen.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.basalt.net/380/History-of-Basalt",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On August 25, 1993, the Fryingpan Kilns at Arbaney Park were officially designated a Local Historic Landmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.basalt.net/380/History-of-Basalt",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Basalt was incorporated as a town on August 26, 1901, formalizing its municipal government.",
