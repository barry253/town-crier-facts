  "facts": [
    {
      "id": 1,
      "text": "Central Square’s historic depot, once a joint station for the New York, Ontario & Western and New York Central railroads, burned in 1908 and was rebuilt the next year.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cnynrhs.org/web/museums/central-square/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Richard Montgomery, a Revolutionary War soldier, settled in Central Square in the 1770s and his cottage still stands on Livingston Street today.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rhinebeck_(village)%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wilderstein mansion, a Hudson River landmark, showcases colonial architecture and archaeological finds dating back to 1853.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rhinebeck_(village)%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The name “Wilderstein” comes from a local petroglyph meaning “wild man’s stone,” a reminder of the Sepasco people who once lived here.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rhinebeck_(village)%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rhinecliff, just two miles west of Central Square, hosts an Amtrak station that connects the village to the broader New York metropolitan area.",
