  "facts": [
    {
      "id": 1,
      "text": "Ash Flat earned its name from a nearby grove of ash trees that once lined the original town site.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ash_Flat%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ash Flat was founded in 1854 by Lazarus Thomas and John David as part of a plan to settle the Osage Indians after they were driven from Missouri.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://intotheozarks.com/cities-of-the-ozarks/ash-flat-arkansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1967, the Arkansas General Assembly made Ash Flat the sole county seat of Sharp County, ending a shared arrangement with Hardy and Evening Shade.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ash_Flat%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Visitors to Ash Flat can enjoy folk music concerts, craft demonstrations, and lessons about the Ozark region’s history and culture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://intotheozarks.com/cities-of-the-ozarks/ash-flat-arkansas/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Historic White River Inn, a charming 19th‑century hotel, remains a comfortable and affordable place to stay in Ash Flat.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://intotheozarks.com/cities-of-the-ozarks/ash-flat-arkansas/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nestled in the Ozarks, Ash Flat boasts beautiful natural surroundings that have inspired generations of artists and musicians.",
      "sourceSentenceIds": [
