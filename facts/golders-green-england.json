  "facts": [
    {
      "id": 1,
      "text": "Golders Green’s name comes from the Godyere family and a common green at a crossroads where the settlement first grew.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golders_Green"
    },
    {
      "id": 2,
      "text": "The Northern Line’s Golders Green station opened in 1907, sparking rapid suburban growth and linking the area to central London.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golders_Green"
    },
    {
      "id": 3,
      "text": "The Golders Green Hippodrome, built in 1913, once hosted the BBC Concert Orchestra and still echoes that musical heritage.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golders_Green"
    },
    {
      "id": 4,
      "text": "More than 40 synagogues and 30 Jewish schools serve Golders Green, making it a major hub for London’s Jewish community.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Golders_Green"
    },
    {
      "id": 5,
      "text": "Carmelli’s, a kosher bakery on Golders Green Road, has been baking bagels and challah for North Londoners since the 1930s.",
