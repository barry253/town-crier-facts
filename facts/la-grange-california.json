  "facts": [
    {
      "id": 1,
      "text": "La Grange was founded in 1852 after French miners moved from the flood‑prone French Bar, and it became Stanislaus County’s seat in 1856.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_California"
    },
    {
      "id": 2,
      "text": "The town’s name means “the barn” or “the farm” in French, reflecting its early settlers’ origins.",
      "sourceSentenceIds": [
        8,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://mercedcountytimes.com/a-history-of-historic-la-grange-1850-2023/"
    },
    {
      "id": 3,
      "text": "At its peak, La Grange housed several thousand residents and was known for its bustling gold mining and agricultural economy.",
      "sourceSentenceIds": [
        23,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_California"
    },
    {
      "id": 4,
      "text": "La Grange’s historic district is a registered California Historical Landmark, preserving buildings from the mid‑1800s.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://mercedcountytimes.com/a-history-of-historic-la-grange-1850-2023/"
    },
    {
      "id": 5,
      "text": "The town sits at 259 feet along the Tuolumne River, just upstream of the La Grange Dam and the New Don Pedro Dam.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Grange%2C_California"
    },
    {
      "id": 6,
      "text": "Gold dredgers operated in the La Grange area until the early 1950s, leaving a legacy of mining infrastructure still visible today.",
