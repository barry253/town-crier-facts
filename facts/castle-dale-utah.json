  "facts": [
    {
      "id": 1,
      "text": "Castle Dale first appeared on the map in 1879 and officially became a city in July 1920.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Dale%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town nestles on Cottonwood Creek in Castle Valley, flanked by the Wasatch Plateau to the west and the San Rafael Swell to the east.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onlineutah.com/castledalehistory.shtml",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Castle Dale serves as the county seat of Emery County, hosting the county government offices.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.onlineutah.com/castledalehistory.shtml",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its cool semi‑arid climate brings hot summer afternoons and frigid winter mornings, with most afternoons below freezing in winter.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Dale%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Year‑round precipitation is sparse, peaking in late summer, and the wettest month on record, October 2006, dumped 3.8 inches.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Dale%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Annual snowfall averages 16.6 inches, but January 1980 delivered a record 24.2 inches, the snowiest month ever recorded.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Castle_Dale%2C_Utah",
