      "id": 1,
      "text": "Kenyon was founded in 1856 and named after Kenyon College in Ohio.",
      "sourceSentenceIds": [
        1,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
