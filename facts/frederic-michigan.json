  "facts": [
    {
      "id": 1,
      "text": "Frederic was settled as a village around 1874 as a stop along the Michigan Central Railroad.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frederic_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Forest, then Fredericville, the town was a “wooding‑up” stop for wood‑fired logging locomotives.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Frederic_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened on June 3, 1901, and the mill operated until 1912 before the town was deserted by 1932.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frederic_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Au Sable River flows southward through the township, passing near Frederic, while the Manistee River runs through the western part.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frederic_Township%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Judge Batterson, who arrived in Crawford County in 1878, had a significant influence on the county’s history.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.upnorthvoice.com/arts-entertainment/2020/02/frederic-with-a-c/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name changed from Fredericville to Frederic on August 4, 1886, shortening the original name.",
      "sourceSentenceIds": [
        20,
