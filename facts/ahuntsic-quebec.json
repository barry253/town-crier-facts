  "facts": [
    {
      "id": 1,
      "text": "Ahuntsic’s oldest church, La Visitation-de-la-Bienheureuse-Vierge-Marie, dates back to 1750 and still stands as Montreal’s oldest surviving church.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Ahuntsic",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Ahuntsic comes from a Huron nickname for a Frenchman who arrived in New France around 1619, a detail uncovered by recent historical research.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Ahuntsic",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ahuntsic was founded as an independent village on January 21, 1897, before being annexed to Montreal in 1910.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ahuntsic",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area’s early economy relied on milling and agriculture along the Rivière des Prairies, with mill remnants still visible today.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Ahuntsic",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ahuntsic hosts the Collège Ahuntsic, a prominent CEGEP that attracts students from across the city.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ahuntsic",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood is known for its green spaces, including the revitalized Ahuntsic Park and the nearby L'Île-de-la-Visitation Nature Park.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
