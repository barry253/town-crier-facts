  "facts": [
    {
      "id": 1,
      "text": "Mount Hermon was once called \"Tuxedo Junction\" and served as a stop on the South Coast Pacific Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Hermon%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Zayante Inn, renamed in 1906, became the site of the 1906 dedication of the Christian retreat center, drawing 1,400 attendees.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Hermon%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A fire on April 18, 1921, destroyed the Zayante Inn and surrounding cottages, reshaping the town’s historic core.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Hermon%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the Mount Hermon Christian Conference Center operates three separate facilities on much of the original property.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Hermon%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town hosts a general store, a daily train ride, and a Chuckwagon BBQ, preserving its historic charm.",
