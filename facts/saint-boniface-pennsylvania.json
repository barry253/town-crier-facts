  "facts": [
    {
      "id": 1,
      "text": "The community's name derives from Saint Boniface, the 8th‑century Anglo‑Saxon missionary and patron saint of Germany, underscoring the predominant German Catholic heritage of its founders.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_boniface_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Initial settlement began around 1800 as part of northern Cambria County pioneer expansion.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_boniface_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Boniface Catholic Church established in the 1870s, it originated as a 19th‑century coal mining settlement along Pennsylvania Route 36 roughly 2 miles east of Hastings.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_boniface_pennsylvania",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Seldom Seen Coal Mine, once a bituminous operation, became a tourist attraction in 1963, offering miner train rides until its 2018 closure.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/saint_boniface_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Saint Boniface remained an unincorporated village within Elder Township, which was carved from Chest Township and incorporated on February 12, 1878.",
