      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Silverton sits within the San Juan Skyway, surrounded by 13,000‑foot peaks, the ghost town of Animas Forks, and the Alpine Loop.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
