  "facts": [
    {
      "id": 1,
      "text": "Clearfield was incorporated as the first borough in the county and is known as the \"Old Town Historic District\" with Victorian homes from 1860-1890.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/pennsylvania-wilds/clearfield/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Clearfield County Courthouse, built in 1804, is the oldest public building in town and sits at the center of county government.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitclearfieldcounty.org/historical_sites",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Joseph and Elizabeth Shaw Public Library, founded in 1940, serves as a cultural hub in Clearfield.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clearfield%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clearfield lies where the West Branch of the Susquehanna River meets Clearfield Creek, a notable geographic confluence.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clearfield%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name comes from the clear fields spotted by early travelers when the county was formed March 26, 1804.",
      "sourceSentenceIds": [
        7,
        1
      ],
      "sourceLabels": [
        "Web source 2"
