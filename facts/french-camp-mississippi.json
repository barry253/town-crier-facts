  "facts": [
    {
      "id": 1,
      "text": "French Camp began around 1810 when French trader Louis Lefleur opened a trading post and inn on the Natchez Trace.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/French_Camp%2C_Mississippi"
    },
    {
      "id": 2,
      "text": "Historic French Camp is a living history village that showcases 19th‑century pioneer life through restored cabins, a National Register home, and a carriage house.",
      "sourceSentenceIds": [
        9,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamstates.com/destinations/historic-french-camp-mississippi"
    },
    {
      "id": 3,
      "text": "Visitors can watch artisans demonstrate traditional crafts and skills, turning history into a hands‑on experience.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamstates.com/destinations/historic-french-camp-mississippi"
    },
    {
      "id": 4,
      "text": "The village features a pottery studio, a gift shop, a restaurant, and a museum that bring the past to life.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.frenchcamphistoricvillage.com/"
    },
    {
      "id": 5,
      "text": "Spring and fall offer mild weather, making them the best seasons to stroll the historic grounds.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roamstates.com/destinations/historic-french-camp-mississippi"
    },
    {
