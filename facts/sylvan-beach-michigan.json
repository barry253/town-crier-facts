  "facts": [
    {
      "id": 1,
      "text": "The land that is Sylvan Beach was once an Ottawa campsite led by Wabiwindego, later renamed Wabaningo by settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sylvanbeachmi.com/community-history/"
    },
    {
      "id": 2,
      "text": "The White River Light Station, standing on the bluff, was constructed in 1875 and still marks the shoreline.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sylvanbeachmi.com/community-history/"
    },
    {
      "id": 3,
      "text": "Sylvan Beach Resort Company was founded in 1895, launching the first organized resort on the Lake Michigan–White Lake peninsula.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sylvanbeachmi.com/community-history/"
    },
    {
      "id": 4,
      "text": "Early 1890s saw the first private cottages built on the bluff, many of which remain in the same families today.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sylvanbeachmi.com/community-history/"
    },
    {
      "id": 5,
      "text": "The arrival of automobiles and paved roads in the 1920s opened Sylvan Beach to travelers from farther afield.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sylvanbeachmi.com/community-history/"
    },
    {
      "id": 6,
      "text": "The Wabaningo Hotel, perched high on the bluff, welcomed Midwesterners arriving by ship through the White Lake channel.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sylvanbeachmi.com/community-history/"
    }
  ]
}
