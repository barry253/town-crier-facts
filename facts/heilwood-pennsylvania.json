  "facts": [
    {
      "id": 1,
      "text": "Heilwood was founded in 1904 by coal pioneer John Heil Weaver, who named the town after himself.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.heilwood.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was built as a “model town,” complete with a school, church, boarding house, company store, hotel, and hospital to support miners.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heilwood%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1905, Heilwood employed 494 men across five mine complexes, producing roughly 100,000 tons of coal each year.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heilwood%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1906 the Penn‑Mary Coal Company, a subsidiary of Pennsylvania and Maryland Steel Companies, bought Heilwood’s holdings for $1.8 million.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Heilwood%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today the original coal company offices, a jail, and a carpenter shop survive as historic ruins and a lone standing structure, respectively.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://coalcampusa.com/westpa/blacklick/heilwood/heilwood.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Heilwood’s early history is preserved online at Heilwood.com, where photographs and stories document the town’s rise and decline.",
