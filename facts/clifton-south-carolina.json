  "facts": [
    {
      "id": 1,
      "text": "Clifton was established in 1880 as an industrial settlement centered around the Clifton Manufacturing Company.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clifton_south_carolina"
    },
    {
      "id": 2,
      "text": "Industrialist Dexter Edgar Converse and A.H. Twichell co-founded the town's textile operations along the Pacolet River.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clifton_south_carolina"
    },
    {
      "id": 3,
      "text": "Clifton grew into one of the largest textile complexes in the Upstate region by the early twentieth century.",
      "sourceSentenceIds": [
        11,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clifton_south_carolina"
    },
    {
      "id": 4,
      "text": "A devastating flood in 1903 ravaged the Pacolet River valley, prompting the community to rebuild on higher ground.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clifton_south_carolina"
    },
    {
      "id": 5,
      "text": "The Rainey Amphitheater, built in 2016 from old mill materials, serves as a reminder of the industrial heritage of Clifton.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clifton_south_carolina"
    },
    {
      "id": 6,
      "text": "Clifton is located on the east side of Spartanburg County, situated between the cities of Spartanburg and Cowpens.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
