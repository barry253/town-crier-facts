    {
      "id": 2,
      "text": "A post office station between Hillsdale and Amboy sparked Frontier’s modest growth into a small town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/frontier-michigan-small-town/"
    },
    {
      "id": 3,
      "text": "In 1834 William Saxton bought 160 acres, built a log cabin, and settled just before Hillsdale County formed.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frontier%2C_Michigan"
    },
    {
      "id": 4,
      "text": "Frontier’s post office opened January 30, 1857, closed August 6, 1858, reopened November 9, 1861, and has operated ever since.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frontier%2C_Michigan"
    },
    {
      "id": 5,
      "text": "An Independent Order of Odd Fellows lodge was built in Frontier in 1912, serving as a historic social center.",
      "sourceSentenceIds": [
