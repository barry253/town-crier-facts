  "facts": [
    {
      "id": 1,
      "text": "Hoback is named for John Hoback, a mountain man who guided the Astor party through the area in 1811.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hoback%2C_Wyoming"
    },
    {
      "id": 2,
      "text": "The Shoshone and Bannock peoples used the Hoback canyon as a vital migration route and hunting ground for elk, deer, and bison.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hoback_wyoming"
    },
    {
      "id": 3,
      "text": "John Hoback helped Wilson Price Hunt's 1811 expedition navigate steep, snow-laden passes after the group abandoned their route along the North Platte River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hoback_wyoming"
    },
    {
      "id": 4,
      "text": "The local economy in Hoback revolves around ranching, tourism, and seasonal outdoor guiding services.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hoback_wyoming"
    },
    {
      "id": 5,
      "text": "Outdoor enthusiasts often visit Hoback to go climbing at the Hoback Shield or soak in the Granite Hot Springs.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hoback_wyoming"
    },
    {
      "id": 6,
      "text": "Hoback serves as an unincorporated extension of the broader Jackson Hole region within Teton County.",
      "sourceSentenceIds": [
        17
