      "quality": "good"
    },
    {
      "id": 2,
      "text": "Arden was surveyed in 1911 by J. Spence Howard, an early county family.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ardencommunityassociation.com/home/aca-committees-clubs/historic-preservation/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Arden spanned about 600 acres, stretching from Whitneys Landing Drive to Plum Creek.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ardencommunityassociation.com/home/aca-committees-clubs/historic-preservation/history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Early deeds imposed two covenants: no alcohol sales and a ban on selling land to 'a celestial'.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ardencommunityassociation.com/home/aca-committees-clubs/historic-preservation/history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Each Arden home may use two crab traps from May through late October, catching 5‑7 blue crabs daily.",
      "sourceSentenceIds": [
        16
      ],
