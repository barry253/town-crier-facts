      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1958 musical “Marjorie Morningstar” filmed scenes on Schroon Lake, immortalizing its summer romance.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
