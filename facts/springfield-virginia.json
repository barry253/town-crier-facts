      "id": 1,
      "text": "Springfield was founded in 1847 around the Orange and Alexandria Railroad's Daingerfield Station, now the Backlick Road VRE station.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
