  "facts": [
    {
      "id": 1,
      "text": "Elizabeth was founded in 1787 by Samuel Mackay, Colonel Stephen Bayard, and his wife Elizabeth Mackay Bayard, after whom the town was named.",
      "sourceSentenceIds": [
        1,
        2,
