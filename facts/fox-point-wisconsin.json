  "facts": [
    {
      "id": 1,
      "text": "Fox Point’s name comes from a fox‑shaped point of land at Doctors Park that jutted into Lake Michigan, a feature early residents noticed.",
      "sourceSentenceIds": [
        1,
        5,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.northshorefamilyadventures.com/fox-point/fox-point-wisconsin-historical-facts"
    },
    {
      "id": 2,
      "text": "Four historic bus stations line Lake Drive, built between 1937 and 1963, reflecting Fox Point’s early 20th‑century transit heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.northshorefamilyadventures.com/fox-point/fox-point-wisconsin-historical-facts"
    },
    {
      "id": 3,
      "text": "The 1940 Bell Road bus station earned landmark status for its unique design and role as a community character marker.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.northshorefamilyadventures.com/fox-point/fox-point-wisconsin-historical-facts"
    },
    {
      "id": 4,
      "text": "The 1952 Friedlander Residence, designed by Lillian Leenhouts, Wisconsin’s first licensed female architect, showcases midcentury modernism in Fox Point.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.northshorefamilyadventures.com/fox-point/fox-point-wisconsin-historical-facts"
    },
    {
      "id": 5,
      "text": "Wealthy Milwaukeeans built summer homes in Fox Point after 1870, when the Lakeshore & Western Railroad and later streetcars made the lakeside accessible.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fox_Point%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The Old Dutch Schoolhouse Site and Burial Ground, erected 1848–1852, stands as a Milwaukee County landmark honoring early Dutch settlers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
