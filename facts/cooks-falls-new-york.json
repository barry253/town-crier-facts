  "facts": [
    {
      "id": 1,
      "text": "Cooks Falls was originally called Butternut Grove by the Cook brothers John and Robert, who built their log cabin on the Beaverkill River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colchesterhsny.org/our-town/cooks-falls-2/"
    },
    {
      "id": 2,
      "text": "The falls on the Beaverkill made it impossible to float large rafts, prompting the blasting of the falls to allow log transport through Cooks Falls.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colchesterhsny.org/our-town/cooks-falls-2/"
    },
    {
      "id": 3,
      "text": "Rafting businesses thrived between 1875 and 1885, with over three thousand rafts floating down the Delaware River after a spring freshet.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colchesterhsny.org/our-town/cooks-falls-2/"
    },
    {
      "id": 4,
      "text": "The O&W Railroad helped prosper Cooks Falls, carrying logs and sawed lumber to the Treyz plant and promoting the Catskills to city residents.",
      "sourceSentenceIds": [
        5,
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colchesterhsny.org/our-town/cooks-falls-2/"
    },
    {
      "id": 5,
      "text": "Cooks Falls sits east-southeast of East Branch on the north shore of Beaver Kill, a scenic spot in Delaware County.",
      "sourceSentenceIds": [
        10
