  "facts": [
    {
      "id": 1,
      "text": "San Fernando is nicknamed “The Mission City” because the 1797 San Fernando Mission sits on former mission land.",
      "sourceSentenceIds": [
        3,
        10,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://lacountylibrary.org/sanfernando-local-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1874 during a land boom, the Southern Pacific Railroad built a line through the valley, making San Fernando the first city in the San Fernando Valley.",
      "sourceSentenceIds": [
        20,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lacountylibrary.org/sanfernando-local-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before Spanish arrival, Gabrielino and Tataviam Indians called the area “Achois Comihabit,” naming it before settlers arrived.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lacountylibrary.org/sanfernando-local-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "San Fernando’s Mediterranean climate and deep wells once made it a leading producer of citrus and olives, earning a reputation for abundant produce.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lacountylibrary.org/sanfernando-local-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "San Fernando was incorporated on August 31, 1911, becoming a general‑law city within the Los Angeles metropolitan area.",
      "sourceSentenceIds": [
        6
      ],
