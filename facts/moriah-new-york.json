      ],
      "source": "https://www.lakechamplainregion.com/living-here/towns-and-villages/port-henry-moriah",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Moriah sits inside Adirondack Park, about 47 miles south‑southwest of Burlington, Vermont.",
