      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "French‑speaking settlers established Bayou L'Ourse in the 1800s along the waterway.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/la/bayou-lourse/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Texas and Pacific Railway in the late 19th century spurred Bayou L'Ourse’s growth.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wikixm.com/us/la/bayou-lourse/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bayou L'Ourse remains a tight‑knit community where Cajun and Creole traditions shape local cuisine, music, and gatherings.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
