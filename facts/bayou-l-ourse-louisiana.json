      "id": 1,
      "text": "Bayou L'Ourse, meaning \"Bayou of the Bear\" in French, was named in honor of King Louis XIV.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 2",
