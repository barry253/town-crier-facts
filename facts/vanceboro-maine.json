  "facts": [
    {
      "id": 1,
      "text": "Vanceboro takes its name from landowner William Vance, who owned much of the area in the 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vanceboro%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1882, the Maine Central Railroad leased the E&NA rail line from Vanceboro to Bangor, linking the town to the state’s rail network.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vanceboro%2C_Maine",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Vanceboro School closed in 2016, and its 1993 building now houses the Vanceboro Historical Museum.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vanceboro%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Saint Croix–Vanceboro Bridge links Vanceboro to Croix, New Brunswick, making it a key border crossing.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vanceboro%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Vanceboro Historical Society acknowledges that the town sits on the homeland of the Passamaquoddy Nation.",
