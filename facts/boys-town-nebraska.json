      "id": 1,
      "text": "Boys Town, Nebraska, was founded on December 12, 1917 as the headquarters of Father Edward J. Flanagan's Boys' Home.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
