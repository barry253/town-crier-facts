  "facts": [
    {
      "id": 1,
      "text": "Brightwaters began as a planned waterfront community in the late 1800s and early 1900s, designed for seaside living.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/brightwaters/"
    },
    {
      "id": 2,
      "text": "Residents petitioned to incorporate the village in 1916, and Brightwaters officially became a village on November 30 of that year.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brightwaters%2C_New_York"
    },
    {
      "id": 3,
      "text": "The village’s streets, parks, and waterfront still echo its early suburban planning, featuring tree‑lined avenues and historic canals.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/brightwaters/"
    },
    {
      "id": 4,
      "text": "A historic snapshot shows elegant gazebos overlooking pristine waters, where sailboats and rowboats glide gracefully along the bay.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brightwatershistory.org/"
    },
    {
      "id": 5,
      "text": "The Brightwaters Historical Society collects and preserves the village’s heritage, ensuring future generations can explore its stories.",
      "sourceSentenceIds": [
        2,
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://brightwatershistory.org/"
    },
    {
      "id": 6,
      "text": "Brightwaters sits in the southwestern part of the Town of Islip, Suffolk County, on Long Island’s Great South Bay.",
