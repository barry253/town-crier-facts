  "facts": [
    {
      "id": 1,
      "text": "Packanack Lake’s name comes from a Lenape word meaning “land made clear for cultivation,” echoing the area’s historic cleared fields.",
      "sourceSentenceIds": [
        4,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/packanack_lake_new_jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1780, the area that is now Packanack Lake sat just outside General George Washington’s and Marquis de Lafayette’s encampments during the Revolutionary War.",
      "sourceSentenceIds": [
        7,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/packanack_lake_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The lake itself was created in 1928 when an earth and clay dam was built across a valley of marshland.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Packanack_Lake%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Residents enjoy a private tennis and golf club on Osborne Terrace, run by the Packanack Lake Community Association.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Packanack_Lake%2C_New_Jersey",
