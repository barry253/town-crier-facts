  "facts": [
    {
      "id": 1,
      "text": "Pearl Creek Colony was established in 1949 as a division from the Huron Hutterite Colony in Manitoba, Canada.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearl_creek_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Pearl Creek Colony emphasizes communal living, shared property, and agricultural self-sufficiency as part of the Hutterian Brethren.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearl_creek_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Pearl Creek Colony sits on the northwest side of Middle Pearl Creek, a tributary of the James River.",
      "sourceSentenceIds": [
        7,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pearl_Creek_Colony%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "Hutterite principles of collective ownership led Pearl Creek Colony to build shared longhouses, barns, and workshops during its first decade.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearl_creek_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Pearl Creek Colony expanded its community by establishing the Long Lake Hutterite Colony near Wetonka in 1966.",
      "sourceSentenceIds": [
        11,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pearl_creek_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Agricultural operations at Pearl Creek Colony include raising livestock and cultivating crops like corn, wheat, and alfalfa.",
