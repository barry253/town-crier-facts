  "facts": [
    {
      "id": 1,
      "text": "Fairford’s name comes from an early Spanish‑origin settler who passed through the area, giving the community its distinctive name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairford_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fairford emerged as an unincorporated community in Washington County, Alabama, the state’s oldest county founded in 1800.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairford_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888, a Seaboard Manufacturing sawmill and 36‑inch gauge railroad sprang up in Fairford, later converted to standard gauge by 1904.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairford_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community was established in the late 19th century, with a post office opening in 1889 under postmaster Thomas Spottswood and remaining in operation until 1965.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairford_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fairford sits amid forests and the Tombigbee River, about 10 miles southwest of McIntosh, offering outdoor recreation and historic transport links.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairford_alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the 1814 Treaty of Fort Jackson, Creek lands were ceded, opening the area for settlers who founded communities like Fairford.",
