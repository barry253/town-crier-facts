  "facts": [
    {
      "id": 1,
      "text": "Florin was named in 1864 by Crocker, from Latin flora meaning flower.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elkgrovehistoricalsociety.com/history-the-town-of-florin/"
    },
    {
      "id": 2,
      "text": "Florin once called 'The Strawberry Capitol of the World' because 245 train cars of strawberries and grapes were shipped annually.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.florinhistoricalsociety.org/"
    },
    {
      "id": 3,
      "text": "The Florin Historical Society was founded to preserve local history and opened a museum at 7145 McComber Street after a long renovation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elkgrovehistoricalsociety.com/history-the-town-of-florin/"
    },
    {
      "id": 4,
      "text": "In the early 1980s, residents formed a group to protect Florin’s landmarks from developers, sparking the historical society.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elkgrovehistoricalsociety.com/history-the-town-of-florin/"
    },
    {
      "id": 5,
      "text": "The town’s early settlers were mainly of European and Asian descent in the early days.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elkgrovehistoricalsociety.com/history-the-town-of-florin/"
    },
    {
      "id": 6,
      "text": "In 2018 the Florin Historical Society published its first book detailing the town’s history.",
      "sourceSentenceIds": [
        5
      ],
