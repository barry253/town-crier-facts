  "facts": [
    {
      "id": 1,
      "text": "Hamilton is home to several historic homes like John Abbott II House, where patriot funds were hidden from the British in 1776.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hamiltonnj.com/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Grafton House, once home to the first Sheriff of Mercer County, now hosts events and reflects early county governance.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hamiltonnj.com/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kuser Farm Mansion, documented by Helen Almy West in 1954, is one of the few surviving 19th‑century farm estates in the township.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hamiltonnj.com/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hamilton’s historic sites include the Isaac Pearson House and the Civil War & Native American Museum, preserving local heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mercercounty.org/visit/our-towns/hamilton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s recreational heart includes Anchor Thread Park and Switlik Park, popular spots for families and cyclists.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mercercounty.org/visit/our-towns/hamilton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hamilton Library serves as the central hub for local history, offering a comprehensive tour of the township’s colorful past.",
      "sourceSentenceIds": [
        12
      ],
