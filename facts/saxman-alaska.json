      ],
      "source": "https://ketchikanshoretours.com/travel-tips/exploring-saxman-village-a-cultural-gem-of-southeast-alaska",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village was named after a Presbyterian missionary and established in the late 19th century when several Tlingit clans relocated from nearby islands.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ketchikanshoretours.com/travel-tips/exploring-saxman-village-a-cultural-gem-of-southeast-alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saxman is the headquarters of the Organized Village of Saxman, a federally recognized tribe of Tlingit Native Americans.",
