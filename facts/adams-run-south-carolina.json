  "facts": [
    {
      "id": 1,
      "text": "Originally known as Adamsville, Adams Run developed in the 19th century as a pastoral settlement with a post office established in 1843.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_run_south_carolina"
    },
    {
      "id": 2,
      "text": "Adams Run is home to several antebellum plantations on the National Register of Historic Places, including Grove Plantation and Willtown Bluff.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_run_south_carolina"
    },
    {
      "id": 3,
      "text": "The area falls within the ACE Basin ecological region, one of the largest undeveloped estuaries on the Atlantic Coast.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_run_south_carolina"
    },
    {
      "id": 4,
      "text": "Christ Church is one of the oldest churches in Adams Run, with a congregation organized around 1835.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Adams_Run%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "The topography of Adams Run consists of flat, low-lying coastal plain terrain featuring sandy soils and extensive marshes.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/adams_run_south_carolina"
    },
    {
      "id": 6,
      "text": "Prior to European colonization, the land surrounding Adams Run was used for hunting and fishing by the Yemassee and Cusabo tribes.",
