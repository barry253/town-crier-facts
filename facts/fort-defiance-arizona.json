  "facts": [
    {
      "id": 1,
      "text": "Fort Defiance was founded on September 18, 1851 by Col. Edwin Vose Sumner to maintain a visible Army presence among the Navajos.",
      "sourceSentenceIds": [
        25,
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Defiance%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort occupied grazing land the federal government prohibited the Navajos from using, sparking early tensions.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Defiance%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In January 1860, warriors ambushed a wagon train en route to resupply Fort Defiance, and a month later attacked cattle guards.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://armyhistory.org/fort-defiance-arizona/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The army abandoned Fort Defiance in 1861, redirecting forces to Fort Fauntleroy, later renamed Fort Wingate.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/az-fortdefiance/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Civil War, the fort was again abandoned and most of it was destroyed by remaining renegade Indians.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/az-fortdefiance/",
