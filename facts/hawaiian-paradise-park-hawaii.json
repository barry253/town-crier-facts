  "facts": [
    {
      "id": 1,
      "text": "Hawaiian Paradise Park began as a subdivision in the late 1950s, selling over 8,800 lots by 1967 and sparking rapid home construction.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hawaiian_paradise_park_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the 2010s, more than 4,000 homes had been built across its agricultural‑zoned landscape, reflecting steady influx driven by economic opportunities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hawaiian_paradise_park_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The subdivision preserves numerous historic sites, including Native Hawaiian petroglyphs, heiau temples, and burial grounds.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawaiian_Paradise_Park%2C_Hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Archaeological evidence shows the area hosted Native Hawaiian settlement as early as 300–600 AD, long before modern development.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hawaiian_paradise_park_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local lore ties the region to Pele and Hiʻiaka, with place names like Waikahekahe reflecting underground streams and kapu‑restricted sacred groves.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hawaiian_paradise_park_hawaii",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Elevations in Hawaiian Paradise Park range from sea level along the Pacific shore to 490 feet in the southern corner.",
      "sourceSentenceIds": [
