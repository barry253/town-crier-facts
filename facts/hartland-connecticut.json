  "facts": [
    {
      "id": 1,
      "text": "In 1733, 67 landowners formed the Proprietors of Hartland, and the General Court decreed the area 'Hartford land,' later shortened to Hartland.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartland%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Captain Thomas Giddings Jr. and his wife Mary Coult became Hartland's first permanent settlers in 1754.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartland%2C_Connecticut",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Saville Dam was completed in 1940, the town's Hartland Hollow was flooded to create the Barkhamsted Reservoir.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartland%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The east branch of the Farmington River bisects Hartland and became the northern section of the Barkhamsted Reservoir after the Saville Dam.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartland%2C_Connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Small Native American bands used Hartland's river valley for summer camps, hunting, and fishing, leaving artifacts that still surface today.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hartlandhistoricalsociety.com/history-of-hartland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "More than 70 percent of Hartland's 15,500 acres are permanently set aside as open space, including state forests and conservation trusts.",
