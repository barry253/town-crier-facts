  "facts": [
    {
      "id": 1,
      "text": "Troy Grove was originally laid out as Homer, Illinois, but was renamed after a nearby grove to avoid confusion with another Homer in the state.",
      "sourceSentenceIds": [
        1,
        3,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy_Grove%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "One of the first Presbyterian churches in LaSalle County was founded in Troy Grove in 1849 with a congregation of just eight members.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy_Grove%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wild Bill Hickok was born in Troy Grove, and his father William Alonzo Hickok opened the village’s first store.",
      "sourceSentenceIds": [
        18,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy_Grove%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area around Troy Grove is known for silica sand, a fine white sand mined for glass production.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy_Grove%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Troy Grove once sat on the Northern Illinois Railroad, now owned by Union Pacific, which hauled raw material from local silica mines.",
