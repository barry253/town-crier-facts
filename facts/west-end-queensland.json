      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1928 Tristram’s soft‑drink factory on Boundary Street became one of Australia’s finest Mission Revival Style buildings.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
