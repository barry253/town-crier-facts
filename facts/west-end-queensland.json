      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thomas Dixon’s tannery on Ferry Road was a 19th‑century landmark, later joined by a boot and shoe factory across Montague Road.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
