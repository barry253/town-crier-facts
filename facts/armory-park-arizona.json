  "facts": [
    {
      "id": 1,
      "text": "The first armory in Arizona opened in 1914 within what is now Armory Park, marking the state’s earliest military construction.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tucsonaz.gov/Departments/Parks-and-Recreation/Parks/Armory-Park"
    },
    {
      "id": 2,
      "text": "Camp Lowell, the site that became Armory Park, was founded in 1866 and renamed Fort Lowell in 1879.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tucsonaz.gov/Departments/Parks-and-Recreation/Parks/Armory-Park"
    },
    {
      "id": 3,
      "text": "In 1873 the camp moved out of town and was reestablished at the confluence of the Pantano and Tanque Verde washes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tucsonaz.gov/Departments/Parks-and-Recreation/Parks/Armory-Park"
    },
    {
      "id": 4,
      "text": "The Tucson World War II Memorial in Armory Park honors local service members who gave their lives during the global conflict.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tucsonaz.gov/Departments/Parks-and-Recreation/Parks/Armory-Park"
    },
    {
      "id": 5,
      "text": "Armory Park’s streets are lined with historic territorial-era adobe homes and Victorian townhomes, reflecting Tucson’s early architectural heritage.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.comeseearizona.com/explore/neighborhood/armory-park"
    },
    {
      "id": 6,
      "text": "The neighborhood’s walkable layout, former streetcar access, and proximity to downtown Tucson make it a classic example of early 20th‑century urban planning.",
      "sourceSentenceIds": [
