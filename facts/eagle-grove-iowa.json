  "facts": [
    {
      "id": 1,
      "text": "Eagle Grove earned its name from the grand old eagles that nested in nearby oak trees along the Boone River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/eagle-grove-public-library/"
    },
    {
      "id": 2,
      "text": "The Chicago & Northwestern Railroad built Eagle Grove Junction in the mid‑1800s, placing a station here to supply water for steam engines.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eaglegrove.gov/history"
    },
    {
      "id": 3,
      "text": "Eagle Grove Public Library began in 1885 as a subscription library in the post office, then grew after a 1901 donation of 250 books.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/eagle-grove-public-library/"
    },
    {
      "id": 4,
      "text": "The library’s archives showcase its long‑standing dedication to learning, expanding collections and services while preserving its historical roots.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/eagle-grove-public-library/"
    },
    {
      "id": 5,
      "text": "Eagle Grove’s Community History Archive offers free access to over 140,000 pages of newspapers, chronicling the town from 1882 to 2019.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/eagle-grove-public-library/"
    },
    {
      "id": 6,
      "text": "Eagle Grove stands as the largest city in Wright County, Iowa, reflecting its growth since the late 19th century.",
