  "facts": [
    {
      "id": 1,
      "text": "El Rancho de Las Golondrinas opened in spring 1972 as New Mexico’s premier living‑history museum, showcasing 18th‑ and 19th‑century life.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://golondrinas.org/about/history/"
    },
    {
      "id": 2,
      "text": "The museum sits on 500 acres just south of Santa Fe, on the historic Camino Real that linked Mexico City to Santa Fe.",
      "sourceSentenceIds": [
        8,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://golondrinas.org/about/history/"
    },
    {
      "id": 3,
      "text": "The area that is now El Rancho was first settled by Tewa‑speaking peoples around 500 AD, who farmed corn, beans, and squash along the Pojoaque River.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_rancho_new_mexico"
    },
    {
      "id": 4,
      "text": "In 1680 the Pueblo Revolt forced the Spanish to abandon Pojoaque Pueblo, reshaping the region’s history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/el_rancho_new_mexico"
    },
    {
      "id": 5,
      "text": "After marrying in 1946, Leonora and Y.A. Paloheimo transformed the old ranch into an outdoor living‑history museum.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://golondrinas.org/about/history/"
    },
    {
      "id": 6,
      "text": "El Rancho celebrated its 50th anniversary in 2022, marking half a century of preserving Northern New Mexico heritage.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://golondrinas.org/about/history/"
    }
  ]
