  "facts": [
    {
      "id": 1,
      "text": "Ripley was founded in 1832 as the centrally located seat of government for the newly organized Jackson County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ripleycvb.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is named after Harry Ripley, a young Methodist minister who drowned in Mill Creek in 1830 before his wedding.",
      "sourceSentenceIds": [
        2,
        4,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://msripley.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jacob Starcher built a grist mill in 1824, laid out Ripley in 1830, and donated land for the courthouse and jail.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripley%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When Jackson County formed in 1831, residents could not decide on a county seat, so in 1832 the Starchers donated eight acres for the courthouse.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripley%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Ripley remained under Union control except for a brief Confederate incursion in September 1862.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripley%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The last public hanging in West Virginia took place in Ripley in 1897, leading the legislature to ban public executions shortly after.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripley%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    }
