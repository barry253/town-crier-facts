  "facts": [
    {
      "id": 1,
      "text": "Santa Nella’s name comes from the Spanish word centinela, meaning sentinel, not from any saint.",
      "sourceSentenceIds": [
        1,
        3,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Santa_Nella,_California"
    },
    {
      "id": 2,
      "text": "The town began in 1810 as Rancho de Centinela, a sub‑rancho of the larger Rancho San Luis Gonzaga.",
      "sourceSentenceIds": [
        7,
        8,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Santa_Nella,_California"
    },
    {
      "id": 3,
      "text": "The original Centinela Adobe was a single‑story adobe built as living quarters for the ranch along El Camino Viejo.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Nella%2C_California"
    },
    {
      "id": 4,
      "text": "In the 19th century, the old ranch became a stagecoach stop on El Camino Viejo before Interstate 5 replaced the route.",
      "sourceSentenceIds": [
        21,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Santa_Nella%2C_California"
    },
    {
      "id": 5,
      "text": "Today, Santa Nella serves as a major stop for travelers on Interstate 5 between Los Angeles and the Bay Area, offering fast food, motels, and gas.",
