      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Creek%2C_Pennsylvania",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Beech Creek–Marsh Creek Watershed Heritage Museum, located in Beech Creek, preserves the natural, cultural, and industrial history of the watershed.",
      "sourceSentenceIds": [
