  "facts": [
    {
      "id": 1,
      "text": "Beech Creek is a borough in Clinton County, Pennsylvania in the heart of the Appalachian foothills.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Creek%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 2,
      "text": "The borough sits on the northeastern side of Beech Creek, a tributary of Bald Eagle Creek, part of the West Branch Susquehanna watershed.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beech_Creek%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pennsylvania Route 150 cuts through Beech Creek, heading northeast to Lock Haven and southwest toward Interstate 80 near Milesburg.",
      "sourceSentenceIds": [
