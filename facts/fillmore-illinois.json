    },
    {
      "id": 2,
      "text": "A dedicated volunteer team runs the society, driven by a passion for preserving Fillmore’s heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/9565"
    },
    {
      "id": 3,
      "text": "The society’s headquarters sits in a historic schoolhouse that once served the community’s children.",
