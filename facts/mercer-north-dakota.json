  "facts": [
    {
      "id": 1,
      "text": "Founded in 1905 along a now-abandoned Northern Pacific Railway branch from Carrington to Turtle Lake, Mercer grew with the early 20‑century railroad boom.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mercer_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name comes from William Henry Harrison Mercer, a well‑known rancher in the Missouri River Valley for many years and for whom Mercer County is also named.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercer%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Zion Lutheran Cemetery, a National Register site, showcases unique 19th‑ and early 20th‑century wrought‑iron crosses that reflect the area's German‑Russian heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mercer_north_dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mercer's flat to undulating terrain, formed by glacial deposits, offers fertile loess soils perfect for wheat and sunflower farming.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mercer_north_dakota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community adopted the motto 'Bringing Home the Bison' to evoke its connection to North Dakota's wildlife and open prairies.",
