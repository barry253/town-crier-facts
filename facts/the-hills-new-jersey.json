  "facts": [
    {
      "id": 1,
      "text": "Cherry Hill got its name from the cherry trees that once lined the original farm property, later turning into the Cherry Hill Inn.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hill%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The tavern founded by Isaac Ellis later became the Ellisburg Inn after John Ilg purchased it.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hill%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Croft Farm, built in 1753 as a working mill and farm, remains a historic landmark in Cherry Hill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hill%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before English settlers, the Lenni‑Lenape Native Americans originally inhabited the area now known as Cherry Hill.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hill%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The inn served as a popular stagecoach shop until 1881, when the Philadelphia‑Medford railroad was completed.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cherry_Hill%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
