  "facts": [
    {
      "id": 1,
      "text": "High Bridge was originally the Aqueduct Bridge, a steel arch that carried water from the Croton River to New York City.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Bridge_(New_York_City)"
    },
    {
      "id": 2,
      "text": "The bridge first carried two water tubes; a third tube and a walkway were added in the early 1860s, expanding its capacity.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Bridge_(New_York_City)"
    },
    {
      "id": 3,
      "text": "Eight wide arches and seven narrow arches spanned the Harlem River, with the narrow ones still standing today.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Bridge_(New_York_City)"
    },
    {
      "id": 4,
      "text": "High Bridge is a New York City designated landmark and sits on the National Register of Historic Places, recognized as a National Historic Landmark in 1992.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Bridge_(New_York_City)"
    },
    {
      "id": 5,
      "text": "The bridge’s deck never carried vehicles; the walkway was only reachable by stairs at each end, preserving its original function.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Bridge_(New_York_City)"
    },
    {
      "id": 6,
      "text": "High Bridge Park on the Manhattan side takes its name from the bridge, linking the park’s identity to this historic structure.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/High_Bridge_(New_York_City)"
    }
  ]
