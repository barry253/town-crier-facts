  "facts": [
    {
      "id": 1,
      "text": "Oxoboxo River’s name comes from the Mohegan‑Pequot term Oquesse‑paug‑suck, meaning “small pond outlet.”.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oxoboxo_river",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The river runs about six miles from Oxoboxo Lake southeast to its confluence with the Thames.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxoboxo_River",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2020, the defunct dam at Uncasville Mill was removed, restoring natural flow and reducing flood risk.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oxoboxo_river",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The river drops 350 feet in its six‑mile course, a steep gradient that powered early mills.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oxoboxo_river",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first sawmill on the Oxoboxo River opened in 1653, marking the start of industrial use.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oxoboxo_River",
      "category": "history",
      "quality": "good"
    },
    {
