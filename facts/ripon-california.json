  "facts": [
    {
      "id": 1,
      "text": "Ripon was renamed for Ripon, Wisconsin, itself named after a town in North Yorkshire, England, in 1876.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripon%2C_California"
    },
    {
      "id": 2,
      "text": "Ripon's history dates back to 1857 when William Hiller Hughes claimed 160 acres near the Stanislaus River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofripon.org/295/History"
    },
    {
      "id": 3,
      "text": "The Mormons abandoned their settlement after flooding in January 1847 inundated the area around their encampment.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://riponchamber.org/history-of-ripon/"
    },
    {
      "id": 4,
      "text": "When Hughes granted a railroad right of way in 1872, a depot called Stanislaus Station opened, later renamed Ripon in December 1874.",
      "sourceSentenceIds": [
        18,
        19,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofripon.org/295/History"
    },
    {
      "id": 5,
      "text": "Ripon's economy is largely agriculture based, known especially for its high production of almonds.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ripon%2C_California"
    },
    {
      "id": 6,
      "text": "In 1910, Ripon boasted a church, a grammar school, a bank, and two hotels among other businesses.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://riponchamber.org/history-of-ripon/"
    }
  ]
