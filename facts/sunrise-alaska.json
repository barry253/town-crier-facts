  "facts": [
    {
      "id": 1,
      "text": "Sunrise was founded in 1895, incorporated in 1896, and grew into a major supply hub for gold miners along Turnagain Arm.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunrise%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in a valley west of Sixmile Creek, overlooking 4,600‑foot peaks to the west and Bradley Peak to the east.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunrise%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sunrise’s elevation is only 69 feet above sea level, making it one of Alaska’s lowest‑lying communities near tidal Turnagain Arm.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunrise_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Turnagain Arm is a narrow tidal fjord with up to 30‑foot tides that shape sediment bars at Sixmile Creek’s mouth, limiting winter navigation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunrise_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area’s harsh avalanche risks stem from snow buildup on surrounding peaks, a result of its northerly latitude and coastal climate.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunrise_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Remnants of Sunrise were listed on the National Register of Historic Places in 1997 as an archaeological historic district.",
      "sourceSentenceIds": [
