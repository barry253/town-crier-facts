      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Blue Rapids sits on historic rail lines, with Union Pacific running north‑south, Missouri Pacific east‑west, and a depot that served both.",
      "sourceSentenceIds": [
        8,
        10,
        12,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/blue-rapids-kansas/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s 1875 public library is the oldest continuously operating library west of the Mississippi in the same building.",
      "sourceSentenceIds": [
        17,
        18,
