    },
    {
      "id": 2,
      "text": "The Houston East and West Texas Railway reached Corrigan in 1881, sparking the town’s rapid growth.",
      "sourceSentenceIds": [
        6,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
