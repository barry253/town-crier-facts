  "facts": [
    {
      "id": 1,
      "text": "Blackstone began as the village of Blacks and Whites, named after two tavern keepers before the Revolutionary War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackstone%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1875 the town was renamed Bellefonte to match the railroad station, then returned to Blacks and Whites in 1882.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackstone%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On February 23, 1886 Blackstone incorporated, honoring English jurist William Blackstone.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackstone%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Blackstone Historic District lists Butterwood Methodist Church, Butterwood Cemetery, Little Mountain Pictograph Site, Oakridge, and Schwartz Tavern on the National Register.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackstone%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s grid street pattern was laid out in 1874, a design that still guides its layout today.",
      "sourceSentenceIds": [
        17
