      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Monongahela Incline, built in 1869–1870, was the first of four steep‑slope planes that opened Mount Washington to commuters.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
