      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the Monongahela and Duquesne Inclines still carry passengers, offering sweeping views of downtown Pittsburgh from the hilltop.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
