  "facts": [
    {
      "id": 1,
      "text": "Preemption was originally called Fairfield Township before 1921, a name change that reflected Illinois’ early land‑claim policies.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/preemption_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in 1850 at Farlow’s Grove, with mail carried by horseback before stagecoaches linked it to river ports.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/preemption_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hopkins Boone built the first saw and grist mill on the Edwards River in 1835, sparking the township’s early logging and grain industry.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/preemption_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1840s and 1850s, Preemption served as a stop on the Underground Railroad, helping fugitives escape from Missouri toward Canada.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/preemption_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Preemption lies just four miles west of Sherrard, placing it close to the historic Mississippi River trade routes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Preemption%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Industrialist and philanthropist Roy James Carver, born in Preemption in 1909, founded the Carver Pump Company and later established the Carver Charitable Trust.",
