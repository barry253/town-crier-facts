      "id": 1,
      "text": "Vassar was named after Matthew Vassar, the uncle of founder Edmunds, who later founded Vassar College in New York.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
