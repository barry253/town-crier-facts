    {
      "id": 1,
      "text": "Chase Mills earned its name from early grist and lumber mill owners who built water‑powered mills around 1808.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chase_mills_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet sits on the Grasse River, just 6.2 miles east of Waddington in northern New York.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chase_Mills%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "It lies within the Ogdensburg‑Massena micropolitan area, close to the industrial and recreational opportunities of the Saint Lawrence Seaway.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chase_mills_new_york",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Before becoming Chase Mills, the area was called Long Rapids, where water‑powered mills sparked early economic growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chase_mills_new_york",
