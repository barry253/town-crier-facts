  "facts": [
    {
      "id": 1,
      "text": "Hanscom AFB was named in 1943 for Medal of Honor winner Laurence G. Hanscom, a pilot who died in a 1941 crash.",
      "sourceSentenceIds": [
        7,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://mybaseguide.com/hanscom-afb-welcome-center"
    },
    {
      "id": 2,
      "text": "During World War II, the base trained fighter squadrons in 1942‑43, even though it never had an active flight line.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanscom_Air_Force_Base"
    },
    {
      "id": 3,
      "text": "Hanscom AFB borders Bedford, Lincoln, Concord, and Lexington, placing it in the very cradle of the American Revolution.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mybaseguide.com/hanscom-afb-welcome-center"
    },
    {
      "id": 4,
      "text": "The base employs more than 10,000 people, from active‑duty Air Force members to civilian scientists and contractors.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mybaseguide.com/hanscom-afb-welcome-center"
    },
    {
      "id": 5,
      "text": "Adjacent Hanscom Field offers general aviation and charter flights, while military aircraft account for less than one percent of its traffic.",
      "sourceSentenceIds": [
        21,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hanscom_Air_Force_Base"
    },
    {
      "id": 6,
      "text": "The 66th Air Base Group, the host unit, reports to Air Force Materiel Command under the Air Force Life Cycle Management Center.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
