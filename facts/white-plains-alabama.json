  "facts": [
    {
      "id": 1,
      "text": "White Plains in Chambers County sits on land once inhabited by the Creek (Muscogee) people before European-American settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_plains_chambers_county_alabama"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1837, marking its early establishment as a community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/al/white-plains-xx-calhoun-profile.htm"
    },
    {
      "id": 3,
      "text": "Chambers County, where White Plains lies, was created in 1832 from newly ceded Creek lands and named after Senator Henry H.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_plains_chambers_county_alabama"
    },
    {
      "id": 4,
      "text": "Families such as the Sharps arrived in the 1840s, and by the 1880s their graves appeared in local cemeteries, reflecting early settlement patterns.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_plains_chambers_county_alabama"
    },
    {
      "id": 5,
      "text": "Today, White Plains remains a quiet agricultural enclave, highlighted by preserved early‑to‑mid‑20th‑century farmsteads like the Holland Family Homestead.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/white_plains_chambers_county_alabama"
    },
    {
      "id": 6,
      "text": "The town sits at 730 feet above sea level and experiences a humid subtropical climate with hot, humid summers and mild winters.",
      "sourceSentenceIds": [
        17,
