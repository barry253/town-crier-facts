  "facts": [
    {
      "id": 1,
      "text": "Scipio Center is a hamlet in Cayuga County, New York, located along New York State Route 34, 10.3 miles south of Auburn.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
