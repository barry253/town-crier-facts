  "facts": [
    {
      "id": 1,
      "text": "Grifton’s annual John Lawson Legacy Days, first held in 2010, celebrates the English explorer who mapped North Carolina in 1701.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grifton%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Grifton Historical Museum & Catechna Indian Village sits on Contentnea Creek, offering a glimpse into the area’s early Native American history.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.visitgreenvillenc.com/plan/cities-and-towns/grifton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the fall festival, Grifton honors its heritage with a two‑day John Lawson Legacy Days, featuring reenactors and historic demonstrations.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitgreenvillenc.com/plan/cities-and-towns/grifton/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Grifton’s name evolved from Peter’s Ferry in 1756 to Blount’s Ford by 1764, finally becoming Grifton in 1889 to honor a local merchant.",
      "sourceSentenceIds": [
        14,
        15,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grifton%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Contentnea Creek, a southeastward‑flowing tributary of the Neuse River, forms Grifton’s county line and has been central to the town’s early settlement.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grifton%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Back‑N‑Time Book Club, run by the Grifton Historical Museum with North Carolina Literacy, introduces children and adults to reading through themed discussions.",
