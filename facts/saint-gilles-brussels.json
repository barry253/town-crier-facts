  "facts": [
    {
      "id": 1,
      "text": "Saint‑Gilles was once a rural village outside Brussels, absorbed into the city in the 19th century during rapid urban expansion, becoming a hub for Art Nouveau architecture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/belgium/brussels-capital_saint-gilles",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hall in Saint‑Gilles showcases impressive Gothic Revival architecture, a prominent landmark that reflects the municipality’s historic character.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/belgium/brussels-capital_saint-gilles",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saint‑Gilles is one of the 19 municipalities of the Brussels‑Capital Region, legally bilingual but predominantly French‑speaking today.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Gilles%2C_Belgium",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The street pattern of Saint‑Gilles was completely remodelled in the 1860s by architect and urbanist Victor Besme, shaping the area’s modern layout.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Gilles%2C_Belgium",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The name Saint‑Gilles comes from its patron saint and main church, a tradition that dates back to the village’s early history.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
