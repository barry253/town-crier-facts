  "facts": [
    {
      "id": 1,
      "text": "Woodlawn Park began as the farm of Frank Levi Braniger, who acquired the land around the Land Run of 1889.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "One of Braniger's sons subdivided a heavily wooded part of the property into residential lots in 1923.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Woodlawn Park is a doubly enclaved municipality, meaning it is entirely surrounded by Bethany, which is itself inside Oklahoma City.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The town of Woodlawn Park incorporated in July 1952 as the neighboring city of Bethany began to envelop the area.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "A long park located between Northwest 37th and 38th streets serves as the center of Woodlawn Park.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Woodlawn Park supports no commercial development, maintaining a purely residential character within its boundaries.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodlawn_Park%2C_Oklahoma"
    }
