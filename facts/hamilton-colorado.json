  "facts": [
    {
      "id": 1,
      "text": "Hamilton sprang up when the Hamilton brothers settled on the Williams Fork, igniting the first energy boom in northwest Colorado.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmoffatcounty.com/our-towns/hamilton/"
    },
    {
      "id": 2,
      "text": "Gold rush fever turned Hamilton from 150 miners in 1859 into a 6,000‑person boomtown by 1862.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/hamilton-colorado-ghost-town/"
    },
    {
      "id": 3,
      "text": "Today only one building stands in Hamilton, surrounded by foundations, tailing piles, and a cemetery reclaimed by nature.",
      "sourceSentenceIds": [
        6,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/hamilton-colorado-ghost-town/"
    },
    {
      "id": 4,
      "text": "The town’s post office was the social hub where more than 20,000 residents registered over Hamilton’s history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/hamilton-colorado-ghost-town/"
    },
    {
      "id": 5,
      "text": "A 5,000‑barrel‑per‑day discovery well sparked an oil boom that rapidly built Hamilton in the 1920s.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmoffatcounty.com/our-towns/hamilton/"
    },
