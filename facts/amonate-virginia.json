  "facts": [
    {
      "id": 1,
      "text": "Amonate began as a Faraday Coal & Coke camp in the early 1920s before becoming a Pocahontas Fuel company town in 1923.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Amonate%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a nickname for Pocahontas, reflecting its coal‑mining heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amonate%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Amonate once boasted a bustling company store and a movie house that are now gone, but their stories live on in local memory.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://amonatealways.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Virginia Tech’s Community Design Assistance Center partnered with Amonate Always to document the town’s history and propose preservation plans.",
      "sourceSentenceIds": [
        1,
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vtechworks.lib.vt.edu/items/4bcb98b0-e480-407f-9baa-4f3de280ee3a",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The 2026 report titled “Amonate: A Coal Camp Through Time” offers a comprehensive inventory and actionable steps for revitalizing the community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vtechworks.lib.vt.edu/items/4bcb98b0-e480-407f-9baa-4f3de280ee3a",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Amonate sits 8.5 miles northwest of Tazewell, nestled in the Appalachian foothills of Tazewell County.",
