  "facts": [
    {
      "id": 1,
      "text": "Oxford’s Greek Revival Band Stand, built in 1875 and rebuilt in 1917 by Fred Tracy, crowns Washington Park.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofoxfordny.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Oxford, Massachusetts, chosen by early settler Benjamin Hovey.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofoxfordny.gov/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oxford Academy, founded in 1794 by Uri Tracy, was one of New York State’s first chartered schools.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofoxfordny.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Oxford Memorial Library houses the Theodore Burr Covered Bridge Resource Center, the nation’s first of its kind.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.villageofoxfordny.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chenango River bisects Oxford, making it a historic transportation hub and scenic backdrop for the town.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofoxfordny.gov/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Loomis Family Farm, listed on the National Register of Historic Places in 2014, reflects Oxford’s agricultural heritage.",
      "sourceSentenceIds": [
        9
