    },
    {
      "id": 3,
      "text": "In 1810, Brigittenau welcomed its first hand‑craft businesses, including a steam sawmill and a fire‑syringe factory.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
