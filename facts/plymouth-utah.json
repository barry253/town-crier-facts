  "facts": [
    {
      "id": 1,
      "text": "Mormon pioneers founded Plymouth, Utah, in March 1869.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/plymouth_utah"
    },
    {
      "id": 2,
      "text": "Plymouth was originally called Squaretown because the first four families built homes on adjoining corners of four sections of land.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://onlineutah.us/plymouthhistory.shtml"
    },
    {
      "id": 3,
      "text": "The town was renamed Plymouth after a local lime rock formation that settlers thought resembled Plymouth Rock.",
      "sourceSentenceIds": [
        4,
        5,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plymouth_utah"
    },
    {
      "id": 4,
      "text": "Early settlers in Plymouth faced severe winters, cricket infestations, and difficulties with initial irrigation from the Malad River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/plymouth_utah"
    },
    {
      "id": 5,
      "text": "Plymouth formally incorporated as a town in 1933 to access state aid and infrastructure support during the Great Depression.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/plymouth_utah"
    },
    {
      "id": 6,
      "text": "The construction of the Nucor Steel mill along the historic Malad Valley railroad branch introduced industrial employment to the rural community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/plymouth_utah"
    }
  ]
