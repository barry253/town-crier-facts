  "facts": [
    {
      "id": 1,
      "text": "Vandalia was founded in 1819 as Illinois’ new capital, a move that kept the seat in one place for twenty years.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vandalia%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name may honor Queen Charlotte, who claimed descent from the Vandals, a Germanic tribe once thought to be a brave Native American people.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vandalia%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vandalia’s State House, built in 1836, is the oldest surviving capitol building in Illinois and now serves as a state historic site.",
      "sourceSentenceIds": [
        7,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Vandalia%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The National Road’s western terminus ran through Vandalia, making the town a key stop on America’s first federal highway.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vandalia%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Abraham Lincoln began his political career in Vandalia, where he first served in the Illinois General Assembly.",
