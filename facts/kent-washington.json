      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as “White River,” then “Titusville” after settler James Henry Titus before becoming Kent.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kent%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1906 a logjam on the White River diverted it into the Puyallup River, reshaping local waterways.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kentwa.gov/guides/kent-history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Japanese issei settled in Kent in the early 1900s, many starting farms that still influence the area’s heritage.",
