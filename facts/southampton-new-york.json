  "facts": [
    {
      "id": 1,
      "text": "Southampton was founded in 1640 by English Puritans from Lynn, Massachusetts, who landed at Conscience Point.",
      "sourceSentenceIds": [
        3,
        13,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Southampton%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors the British Earl of Southampton, echoing its English roots.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Southampton%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1640s, Southampton became the first organized whale‑fishery in New England, chasing pilot whales onto its beaches.",
      "sourceSentenceIds": [
        9,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southampton%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Montauk Branch of the Long Island Rail Road, with a Southampton station, has served the town since the 19th century.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southampton%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stony Brook University’s Southampton campus brings research and education to the town’s southeastern edge.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southampton%2C_New_York",
