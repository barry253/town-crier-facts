  "facts": [
    {
      "id": 1,
      "text": "Lealman was founded in the late 19th century by Elza Beasley Lealman Sr., a Georgia native who turned a rural outpost into a thriving agricultural community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lealman_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Elza Lealman, who served as Suwannee County sheriff during the Civil War before moving to Pinellas in the 1870s.",
      "sourceSentenceIds": [
        5,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.usacitiesonline.com/flcountylealman.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lealman Heights, the area’s original name, grew around a train station established by 1895, linking the community to the CSX Railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lealman_florida",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 2016, Lealman has been a Community Redevelopment Area, receiving tax‑increment financing for parks, crosswalks, and affordable housing projects like Greenway Lofts.",
      "sourceSentenceIds": [
        3,
        10
      ],
