  "facts": [
    {
      "id": 1,
      "text": "White settlement in New Union began in the late 1790s and early 1800s following the resolution of Native American conflicts.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_union_tennessee"
    },
    {
      "id": 2,
      "text": "New Union was established in the early 19th century as a stagecoach stop along the route between Nashville and Chattanooga.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/tennessee_new-union"
    },
    {
      "id": 3,
      "text": "New Union is situated near the Stones River and is known for its rural charm and proximity to Nashville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/tennessee_new-union"
    },
    {
      "id": 4,
      "text": "New Union is home to the Tennessee Walking Horse National Celebration satellite grounds, where regional horse shows are held annually.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/tennessee_new-union"
    },
    {
      "id": 5,
      "text": "The area around New Union is part of the Highland Rim, a region known for rolling hills and limestone caves.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
