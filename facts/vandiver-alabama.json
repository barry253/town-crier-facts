      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Falkner School in Vandiver is listed on the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vandiver%2C_Alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Vandiver sits on the southern slope of Coosa Mountain, part of the Appalachian foothills, giving the area gently rolling terrain.",
