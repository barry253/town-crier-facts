      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Wendover Nugget, once the State Line Casino, held Nevada's oldest continuous gaming license for 66 years until 2001.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
