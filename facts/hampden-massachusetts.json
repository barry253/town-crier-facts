  "facts": [
    {
      "id": 1,
      "text": "Hampden, Massachusetts, takes its name from English patriot John Hampden, who opposed King Charles I in the 1600s.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Hampden-county-Massachusetts"
    },
    {
      "id": 2,
      "text": "The town’s first European settlers were the Stebbins and Hitchcock families, who arrived in the mid‑1700s.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampden%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "A sawmill on the Scantic River marked Hampden’s early industrial start, powering the town’s first grist and saw mills.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampden%2C_Massachusetts"
    },
    {
      "id": 4,
      "text": "In 1761, a rattlesnake bite claimed the life of Timothy Merrick, an event immortalized in one of America’s earliest ballads.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampden%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "Hampden Public Library opened its doors in 1891, becoming a long‑standing community hub for learning and culture.",
