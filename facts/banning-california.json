  "facts": [
    {
      "id": 1,
      "text": "Banning began as Moore City before being renamed for Phineas Banning, the “Father of the Port of Los Angeles.”.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Banning%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Known as “Stagecoach Town, U.S.A.,” Banning still honors its roots with an annual Stagecoach Days parade, carnival, and rodeo.",
      "sourceSentenceIds": [
        13,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Banning%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Southern Pacific railroad arrived in 1876, replacing the stagecoach and fueling Banning’s rapid growth.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Banning%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Banning borders the Morongo Indian Reservation, home to the Morongo Band of Cahuilla (Mission) Indians.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Banning%2C_California",
