  "facts": [
    {
      "id": 1,
      "text": "Diamond Heights was the first San Francisco Redevelopment Agency project, running from 1948 to 1978.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Diamond_Heights%2C_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood rises from three hills—Red Rock, Gold Mine, and Fairmount, which includes Billy Goat Hill.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Diamond_Heights%2C_San_Francisco",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The name “Diamond Heights” comes from Diamond Street, which climbs the eastern slopes of the hills and was highlighted by the Redevelopment Agency.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.glenparkhistory.org/diamond-heights-c1l4v",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The redevelopment plan mixed housing for all income levels with churches, schools, parks, and a commercial center, displacing only a few residents.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Diamond_Heights%2C_San_Francisco",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The San Francisco Police Academy sits on the slopes of Diamond Heights, a notable landmark for the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.glenparkhistory.org/diamond-heights-c1l4v",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Diamond Heights hosts five parks—four with playgrounds—alongside a shopping center and three churches.",
      "sourceSentenceIds": [
        12
      ],
