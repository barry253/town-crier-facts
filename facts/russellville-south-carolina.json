  "facts": [
    {
      "id": 1,
      "text": "Russellville is named for W.P. Russell, a local patriarch who operated a cotton gin and grist mill on his farm.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_south_carolina"
    },
    {
      "id": 2,
      "text": "The community grew around a general store that served as the local post office starting in 1916.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_south_carolina"
    },
    {
      "id": 3,
      "text": "Russellville's early growth was driven by the lumber industry, starting with a sawmill and a self-contained mill village in 1922.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_south_carolina"
    },
    {
      "id": 4,
      "text": "A historic mill village in Russellville once featured twenty-two employee cottages, a company store, and a two-story schoolhouse.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_south_carolina"
    },
    {
      "id": 5,
      "text": "Georgia-Pacific Corporation eventually acquired the local lumber site, creating an industrial complex that employs over 500 people today.",
      "sourceSentenceIds": [
        11,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/russellville_south_carolina"
    },
    {
      "id": 6,
      "text": "Russellville occupies a rural landscape with an elevation of 79 feet above sea level.",
      "sourceSentenceIds": [
        29
      ],
