  "facts": [
    {
      "id": 1,
      "text": "Liberty takes its name from the American ideal of liberty in the United States.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty%2C_Kansas"
    },
    {
      "id": 2,
      "text": "The original village of Liberty sat on a high bluff overlooking the Verdigris Valley, two miles north and one mile west of where it sits today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kansasgenealogy.com/montgomery/early-history-of-liberty.htm"
    },
    {
      "id": 3,
      "text": "In the 1860s, Liberty fiercely competed with Independence for Montgomery County's seat, even serving as the county seat for a brief period in 1869‑70.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kansasgenealogy.com/montgomery/early-history-of-liberty.htm"
    },
    {
      "id": 4,
      "text": "When the railroad arrived in 1870, Liberty moved to its current location to stay connected to the rail line.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty%2C_Kansas"
    },
    {
      "id": 5,
      "text": "The 2021 Wes Anderson film The French Dispatch mentions Liberty, Kansas, though the scenes were not filmed there.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberty%2C_Kansas"
    },
    {
      "id": 6,
      "text": "Liberty's first post office opened in May 1870, shortly after the town's relocation.",
      "sourceSentenceIds": [
        13
