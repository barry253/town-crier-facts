  "facts": [
    {
      "id": 1,
      "text": "Twentynine Palms earned its name from the 29 Washingtonia filifera palms the Serrano planted around the Oasis of Mara.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twentynine_Palms%2C_California"
    },
    {
      "id": 2,
      "text": "The Oasis of Mara, the original water source, has sustained all economic activity in Twentynine Palms since its founding.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twentynine_Palms%2C_California"
    },
    {
      "id": 3,
      "text": "The 29 Palms Historical Society, housed in the town’s original schoolhouse, preserves a museum dedicated to local history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twentynine_Palms%2C_California"
    },
    {
      "id": 4,
      "text": "Twentynine Palms showcases 26 vibrant outdoor murals that depict desert life and the town’s rich history.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twentynine_Palms%2C_California"
    },
    {
      "id": 5,
      "text": "In 1945, The Chase and Sanborn Hour broadcast from Twentynine Palms Auxiliary Naval Air Station, featuring Edgar Bergen and Joan Blondell.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Twentynine_Palms%2C_California"
    },
    {
      "id": 6,
      "text": "Rock legend Robert Plant released the solo single “29 Palms” in 1993, naming it after the desert town.",
