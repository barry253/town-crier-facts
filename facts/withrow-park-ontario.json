      "id": 1,
      "text": "Withrow Park, spanning 8.5 hectares, opened in the 1910s as Riverdale’s first large multi‑purpose green space.",
      "sourceSentenceIds": [
        10,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
