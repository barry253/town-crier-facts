  "facts": [
    {
      "id": 1,
      "text": "Irving was renamed in 1846 after the Irving Company investors, distinguishing it from other Cattaraugus villages.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irving%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Thomas Indian School operated from 1855 to 1957 as a state boarding school for Native American children, now a site of cultural trauma.",
      "sourceSentenceIds": [
        5,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irving%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Irving sits at the mouth of Cattaraugus Creek where it flows into Lake Erie, a historic crossroads between Erie and Chautauqua counties.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irving%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1840s, Irving briefly considered as the western terminus of the New York & Erie Railroad, but the choice went to Dunkirk.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irving%2C_New_York",
