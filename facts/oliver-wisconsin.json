  "facts": [
    {
      "id": 1,
      "text": "Oliver may have originally been known as Bear’s First Pause, a resting point on the canoe route to the St. Louis River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofoliver.org/village-history/"
    },
    {
      "id": 2,
      "text": "Serbian families were once the dominant ethnic group in Oliver, maintaining close ties with fellow Serbs in the region.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofoliver.org/village-history/"
    },
    {
      "id": 3,
      "text": "Oliver was officially incorporated as a village on February 24, 1917, though its post office opened several years earlier.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofoliver.org/village-history/"
    },
    {
      "id": 4,
      "text": "The Oliver Bridge originally featured a walkway so workers could walk from the village to the Morgan Park steel plant.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofoliver.org/village-history/"
    },
    {
      "id": 5,
      "text": "Early families moved to Oliver to find work in the burgeoning steel industry located just across the river.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofoliver.org/village-history/"
    },
    {
      "id": 6,
      "text": "Oliver is a village in Douglas County, Wisconsin, located just west of the city of Superior.",
