  "facts": [
    {
      "id": 1,
      "text": "Bowmansville takes its name from Benjamin Bowman, the early 19th‑century sawmill owner who expanded operations on Ellicott Creek.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowmansville%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first sawmill in the hamlet was built in 1808 by Daniel Robinson, and Benjamin Bowman purchased it in 1810.",
      "sourceSentenceIds": [
        11,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Bowmansville,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A West Shore Railroad station once served Bowmansville, located just north of the hamlet along Maple Drive.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowmansville%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ellicott Creek, a tributary of Tonawanda Creek, historically powered Bowmansville’s mills and today shapes its floodplain.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bowmansville_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The hamlet rests on glacial outwash sand and gravel over till, giving its soils a silt loam to loamy fine sand character.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bowmansville_new_york",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Bowmansville lies along Genesee Street (NY Route 33) and is noted for its historic character within the suburban landscape.",
      "sourceSentenceIds": [
        12
