  "facts": [
    {
      "id": 1,
      "text": "New Miami was originally called Coke Otto because of its large coal field and steel mill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Miami%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The village sits just north of Hamilton, Ohio, in central Butler County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Miami%2C_Ohio"
    },
    {
      "id": 3,
      "text": "In 1905 the United Coke and Gas Company built Otto‑Hoffman coke ovens, covering about 50 acres with 120 ovens.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Miami%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The coke plant earned New Miami the nickname Coke Otto, a name that stuck until the village incorporated in 1929.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Miami%2C_Ohio"
    },
    {
      "id": 5,
      "text": "The American Rolling Mill Company bought the plant in 1937, later becoming ARMCO and now AK Steel Holdings in Middletown.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Miami%2C_Ohio"
    },
    {
      "id": 6,
      "text": "New Miami’s incorporation as a village in 1929 marked its transition from an industrial hub to a residential community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Miami%2C_Ohio"
    }
  ]
