      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Water from the East Branch feeds the Pepacton Reservoir, which supplies New York City with over 1.4 billion gallons daily.",
      "sourceSentenceIds": [
        21,
        13
      ],
      "sourceLabels": [
        "Web source 1"
