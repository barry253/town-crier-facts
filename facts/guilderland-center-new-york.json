  "facts": [
    {
      "id": 1,
      "text": "Guilderland Center was settled in the 1730s and grew around Abel French’s mill founded in 1800.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://guilderlandchamber.com/guilderland-center/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s name comes from French’s Mills, named after Abel French, whose mill stood until the Black Creek damming in 1916.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilderland_Center%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "French’s Hollow, once a bustling industrial area, was largely destroyed when the Watervliet Reservoir was created in 1916.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilderland_Center%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Guilderland Center lies along New York Route 146 beside Black Creek, a tributary of the Normans Kill.",
      "sourceSentenceIds": [
        11,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilderland_Center%2C_New_York",
      "category": "other",
