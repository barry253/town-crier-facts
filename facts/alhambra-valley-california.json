    {
      "id": 1,
      "text": "Alhambra got its name from Washington Irving’s book, which was inspired by the Moorish palace in Granada, Spain.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alhambra%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded as a Los Angeles suburb, Alhambra remained unincorporated through most of the mid‑19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alhambra%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Southern Pacific Railroad built a station in 1886 near Ramona, anchoring Alhambra’s early growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alhambraca.gov/466/About-Alhambra",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Garfield Theatre, a vaudeville venue from 1925, once hosted the Gumm Sisters and a young Judy Garland.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alhambra%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alhambra Historical Society sits on Alhambra Road in a former medical office, preserving the city’s heritage.",
      "sourceSentenceIds": [
        18
