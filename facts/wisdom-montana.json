  "facts": [
    {
      "id": 1,
      "text": "Wisdom earned its name from the Wisdom River, which today is called the Big Hole River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitmt.com/cities-towns/wisdom",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1880, Wisdom originally called “the Crossing” sat at a crossroads of trails to Idaho and the Bitterroot.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/wisdom/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ten miles west of Wisdom lies the Big Hole Battlefield, the 1877 clash between the Nez Perce and U.S. troops.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/wisdom/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During a cold wave on December 23, 1983, Wisdom plunged to a record low of –55°F, the coldest ever recorded there.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wisdom%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A U.S. Forest Service ranger station in Wisdom employs roughly twenty to thirty full‑time staff, swelling in the summer.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southwestmt.com/communities/wisdom/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The most snow ever on the ground in Wisdom was 32 inches, recorded on January 2, 1943.",
      "sourceSentenceIds": [
        24
      ],
