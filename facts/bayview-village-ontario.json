    {
      "id": 1,
      "text": "Street names like Citation Drive and Palomino Crescent honor Bayview Village's past as a racehorse training ground.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayview_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The winding streets follow a curvilinear pattern designed by planner Faludi to match the East Don Valley contours.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayview_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nearly a quarter of Bayview Village is green, with mature birch, cedar, willow, spruce, pine and maple lining the cul‑de‑sacs.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayview_Village",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bayview Village Shopping Centre, opened in 1963, once housed a public library, a health spa, and four movie theatres.",
      "sourceSentenceIds": [
        27,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayview_Village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From Sheppard Avenue south to Duncan Mills Road, the paved Betty Sutherland Trail honors a long‑serving municipal councillor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/north-york/bayview-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bayview Village began as a small rural farming community in the 1800s before being planned in 1954 by Farlinger Development Ltd.",
