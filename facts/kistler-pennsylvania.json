  "facts": [
    {
      "id": 1,
      "text": "Kistler emerged as a company town in the early twentieth century to support the Mount Union Refractories Company's brick manufacturing operations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kistler_pennsylvania"
    },
    {
      "id": 2,
      "text": "The town was designed as a planned industrial village starting in 1916 to provide comfortable housing for factory workers.",
      "sourceSentenceIds": [
        13,
        15,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kistler%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Kistler's economy historically revolved around a refractory brick plant that used local ganister rock resources until its closure in 1990.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kistler_pennsylvania"
    },
    {
      "id": 4,
      "text": "The triangular site of Kistler was strategically bordered by the Juniata River and the Pennsylvania Railroad to buffer residents from industrial noise.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/kistler_pennsylvania"
    },
    {
      "id": 5,
      "text": "By 1918, the model industrial village of Kistler housed approximately 700 residents to promote worker efficiency and moral character.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kistler_pennsylvania"
    },
    {
      "id": 6,
      "text": "Federal studies state that Hackman and Davis named the town Kistler, though the specific reason for the choice is unknown.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
