  "facts": [
    {
      "id": 1,
      "text": "Pompeys Pillar town founded 1907, named after nearby 150‑foot sandstone pillar where William Clark carved his name July 25, 1806.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pompeys_Pillar_(community)%2C_Montana"
    },
    {
      "id": 2,
      "text": "The town began as a railroad station under the Huntley Project, an irrigation effort by the U.S. Bureau of Reclamation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pompeys_Pillar_(community)%2C_Montana"
    },
    {
      "id": 3,
      "text": "Pompeys Pillar National Monument, created in 2001, sits under BLM jurisdiction and hosts over 5,000 petroglyphs and etchings.",
      "sourceSentenceIds": [
        18,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pompeys_Pillar_(community)%2C_Montana"
    },
    {
      "id": 4,
      "text": "The monument marks the only surviving on‑site evidence of the Lewis and Clark Expedition, with Clark’s 1806 inscription still visible.",
      "sourceSentenceIds": [
        30,
        1
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.nps.gov/places/pompeys-pillar-national-monument.htm"
    },
    {
      "id": 5,
      "text": "In 2006 a new visitor center and museum opened, celebrating the bicentennial of the Lewis and Clark Expedition.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pompeys_Pillar_(community)%2C_Montana"
    }
  ]
