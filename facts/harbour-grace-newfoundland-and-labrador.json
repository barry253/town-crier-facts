      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Amelia Earhart’s statue overlooking Conception Bay marks the town’s role in pioneering transatlantic flight history.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
