      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Harbour Grace Court House, built in 1830, is the oldest surviving public building in Newfoundland and a National Historic Site.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
