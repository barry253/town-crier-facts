  "facts": [
    {
      "id": 1,
      "text": "Sun Valley sits on the south slope of Pohopoco Mountain, with Pohopoco Creek originating within its boundaries.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sun_valley_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community lies west of PA 115, extending along the mountain's south flank, forming its primary eastern and northern boundaries.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sun_valley_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The area was first inhabited by Lenni Lenape, who used the forested landscape for hunting and fishing before European roads followed their trails.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sun_valley_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1954, Sun Valley Dam was built on Pohopoco Creek, creating a small reservoir for private swimming and leisure.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sun_valley_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wilkes-Barre and Easton Turnpike, built in 1808, evolved into modern PA 115, linking Sun Valley to eastern markets.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sun_valley_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sun Valley is home to New Jersey Camp Jaycee, a summer camp for adults with developmental disabilities, founded in 1975.",
      "sourceSentenceIds": [
