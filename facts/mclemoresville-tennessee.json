  "facts": [
    {
      "id": 1,
      "text": "McLemoresville is the birthplace and final resting place of television star Dixie Carter and her husband, actor Hal Holbrook.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLemoresville%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bethel College, Tennessee’s only four‑year liberal arts school founded by the Cumberland Presbyterian Church, began its campus in McLemoresville before moving to McKenzie.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLemoresville%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the mid‑1800s, McLemoresville boasted more than eleven saloons and several boarding schools, including the Collegiate Institute and Women’s Collegiate Institute.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLemoresville%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town once served as Carroll County’s seat and was the county’s largest community before the railroad bypassed it in the 19th century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLemoresville%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Locals affectionately call McLemoresville “McLey,” a nickname that echoes the town’s historic pronunciation.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLemoresville%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The McLemoresville Activities Center, known locally as the “MAC,” hosts community events in a building that once housed the town’s high school.",
      "sourceSentenceIds": [
        23
