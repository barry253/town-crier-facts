  "facts": [
    {
      "id": 1,
      "text": "Cantrall earned its name when Levi Cantrall donated land that became the village’s 1872 plat, after the area was first called Antioch.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cantrall_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village began as a farming settlement in winter 1818‑19 when preacher Stephen England and his sons‑in‑law moved north of the Sangamon River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cantrall_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads arrived in the 1880s, with the Chicago & Illinois Midland bringing grain to Springfield and sparking a 1926 labor riot.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cantrall_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cantrall sits about ten miles north of Springfield, the state capital, making it a quiet suburb of the city.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/village-cantrall.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Baseball history notes Carl Vandagrift, an infielder for the Indianapolis Hoosiers, was born in Cantrall.",
