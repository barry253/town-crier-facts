      "id": 1,
      "text": "Greenfield’s name comes from the green wheat fields that inspired the first train engineer to call the town Greenfield.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greenfieldtn.org/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Illinois Central Gulf Railroad track was laid through Greenfield in 1873, sparking the town’s early growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greenfieldtn.org/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greenfield hosts the Big Cypress Tree State Natural Area, home to the largest bald cypress east of the Mississippi.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greenfieldtn.org/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "John W. built the first dwellings in Greenfield in 1874, marking the town’s first permanent homes.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greenfieldtn.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first post office opened in Greenfield the same year the first dwellings appeared, 1874.",
