  "facts": [
    {
      "id": 1,
      "text": "Santa María la Ribera once housed the National Natural History Museum from 1913 to 1964.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Santa_Mar%C3%ADa_la_Ribera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The colonia earned the nickname “Palacio de Cristal” because its architecture resembles England’s Crystal Palace.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Santa_Mar%C3%ADa_la_Ribera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1972, the INAH declared the area an Artistic Monument of the Nation, protecting its historic buildings.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Santa_Mar%C3%ADa_la_Ribera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The colonia’s 1,040 structures catalogued by the Instituto Nacional de Bellas Artes include over 1,000 with architectural or historic value.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Santa_Mar%C3%ADa_la_Ribera",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1985 earthquake, poorer residents moved in and economic housing appeared, shifting the colonia’s social mix.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colonia_Santa_Mar%C3%ADa_la_Ribera",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Santa María la Ribera’s main park hosts cultural events like chamber orchestras and dance classes, keeping the area lively.",
