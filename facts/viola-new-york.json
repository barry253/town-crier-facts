  "facts": [
    {
      "id": 1,
      "text": "Viola, settled in the late 18th century by Dutch and English families, takes its name from a musical instrument.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_viola"
    },
    {
      "id": 2,
      "text": "A one‑room schoolhouse built in the 19th century still hosts community events and historical education in Viola.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/new-york_viola"
    },
    {
      "id": 3,
      "text": "The Alms House, established in 1837 at Viola—then called Mechanicsville—served the poor and debtors.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_New_York"
    },
    {
      "id": 4,
      "text": "In 1883 a brick building was constructed for the Alms House, later becoming part of Rockland Community College.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_New_York"
    },
    {
      "id": 5,
      "text": "The original Alms House building now serves as Daniel T. Brucker Hall, an administration building on the college campus.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_New_York"
    },
    {
      "id": 6,
      "text": "The Poor Cemetery, also known as Potter's Field, remains on the Rockland Community College campus in Viola.",
      "sourceSentenceIds": [
