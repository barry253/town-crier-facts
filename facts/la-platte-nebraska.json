  "facts": [
    {
      "id": 1,
      "text": "La Platte was originally founded in 1855 as Larimer Mills along the Missouri River by General William Larimer and Governor Samuel Cuming.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_platte_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed La Platte in 1870 to reflect its proximity to the Platte River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_platte_nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original 1855 settlement was abandoned after one year because of Missouri River floods, prompting a move to higher ground west of the river.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_platte_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1870, the Omaha and Southwestern Railroad Company platted La Platte, merging parts of the Larimer site and making it a key access point to the Platte Valley.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_platte_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office operated in La Platte from 1871 until its closure in 1955, serving the community for 84 years.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Platte%2C_Nebraska",
      "category": "history",
      "quality": "good"
    }
