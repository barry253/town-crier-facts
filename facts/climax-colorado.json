  "facts": [
    {
      "id": 1,
      "text": "Climax sits at 11,341 ft, making it the highest human settlement in the United States and the coldest in the contiguous US.",
      "sourceSentenceIds": [
        9,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang up around a massive molybdenum deposit discovered in the early 1900s, turning it into the world’s largest molybdenum mine.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its railroad station, built in 1884, held the title of North America’s highest until 1904 and again from 1928 until 1937.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Climax post office operated from 1887 to 1898 and 1917 to 1974, holding the record for the highest post office in the U.S.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the town was razed in 1962, all residential houses were moved to Leadville’s West Park subdivision, leaving only mining buildings.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The mine reopened in 2012 after a 17‑year shutdown, resuming molybdenum shipments to the global market.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Colorado",
