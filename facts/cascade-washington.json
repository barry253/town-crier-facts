  "facts": [
    {
      "id": 1,
      "text": "Cascade hosts North Cascades National Park, where historic treasures range from abandoned mines to a lost hotel that captures rustic recreation.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/noca/learn/historyculture/index.htm"
    },
    {
      "id": 2,
      "text": "The park records more than 260 prehistoric sites, some older than 8,500 years.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/noca/learn/historyculture/index.htm"
    },
    {
      "id": 3,
      "text": "Archaeologists at Cascade Pass have uncovered evidence of human activity that stretches back 9,600 years.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/noca/learn/historyculture/index.htm"
    },
    {
      "id": 4,
      "text": "The North Cascades cultural history spans thousands of years, from native peoples to miners, loggers, fire lookouts, climbers, rangers, and dam workers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ncascades.org/discover/north-cascades-ecosystem/cultural-history"
    },
    {
      "id": 5,
      "text": "The Cascade Party of Washington, a minor political party, was founded in 2024 by former Nirvana bassist Krist Novoselic.",
      "sourceSentenceIds": [
        16,
