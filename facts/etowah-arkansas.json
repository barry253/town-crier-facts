  "facts": [
    {
      "id": 1,
      "text": "Etowah began as a lumber camp for the Chapman and Dewey Lumber Company in the 1890s, drawing workers to the swampy Mississippi Delta.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etowah%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1902 a post office opened, and the name 'Etowah'—chosen after other options were rejected—stayed with the town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Etowah%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Jonesboro, Lake City and Eastern Railroad that same year linked Etowah to Big Lake and Blytheville, boosting timber and crop transport.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/etowah_arkansas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before European settlement, Native Americans built mounds and villages across Etowah’s swampy cypress forests, leaving archaeological traces that echo the region’s prehistoric culture.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/etowah_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Drainage projects in the late 19th and early 20th centuries turned Etowah’s marshlands into fertile farmland, supporting crops like cotton, soybeans, and rice.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/etowah_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Little River’s Left Hand Chute slices through Etowah’s southeastern corner, a reminder of the town’s riverine geography.",
      "sourceSentenceIds": [
        20
      ],
