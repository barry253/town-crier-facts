  "facts": [
    {
      "id": 1,
      "text": "Meade was named for Union General George Meade, a Civil War hero who led the Union army at Gettysburg.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kansashistory.gov/kansapedia/meade-county-kansas/15315"
    },
    {
      "id": 2,
      "text": "The Old Meade County Museum, run by the Meade County Historical Society, showcases the town’s pioneer era and local lore.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitoldmeadecounty.com/"
    },
    {
      "id": 3,
      "text": "The Dalton Gang Hideout, once a refuge for the infamous outlaws, sits in Meade County and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kansashistory.gov/kansapedia/meade-county-kansas/15315"
    },
    {
      "id": 4,
      "text": "Meade was both laid out and incorporated in 1885, marking the town’s formal founding during the westward expansion.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meade%2C_Kansas"
    },
    {
      "id": 5,
      "text": "Before settlers arrived, the area that is now Meade County was hunting grounds for Plains Indians, shaping its early landscape.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kansashistory.gov/kansapedia/meade-county-kansas/15315"
    },
    {
      "id": 6,
      "text": "During the 1930s, the Works Progress Administration renovated the Dalton Gang Hideout, turning it into a historic park for visitors.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kansashistory.gov/kansapedia/meade-county-kansas/15315"
