  "facts": [
    {
      "id": 1,
      "text": "Ponshewaing, some say means \"Peaceful Waters\", others say \"Winter Home\".",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.michiganwatertrails.org/location.asp?ait=av&aid=1638",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ponshewaing was a flag stop on the railroad, with no depot.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.michiganwatertrails.org/location.asp?ait=av&aid=1638",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "The summer waiting station had two wooden benches, a cement floor, and a roof.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.michiganwatertrails.org/location.asp?ait=av&aid=1638",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A boardwalk ran from the station to the Ponshewaing Hotel.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.michiganwatertrails.org/location.asp?ait=av&aid=1638",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ponshewaing Hotel, built around 1900 on an ancient Indian village site, burned down in the 1950s, leaving only stone pillars and a hidden well head.",
