      ],
      "source": "https://grokipedia.com/page/blain_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Blain hosts Sherman's Valley Heritage Day each fall, a modern take on the long‑standing picnic tradition celebrating local agriculture and crafts.",
      "sourceSentenceIds": [
