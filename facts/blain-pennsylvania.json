      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1846 lots were platted and the post office name changed to Blain, leading to official borough incorporation in 1877.",
      "sourceSentenceIds": [
        23,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
