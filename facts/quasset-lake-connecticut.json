  "facts": [
    {
      "id": 1,
      "text": "Quasset Lake’s name comes from the Algonquian word Wappaquasset, meaning “a place covered with rush matting.”.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/quasset_lake_connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake began as a marsh pond that the Nipmuc people raised with a stone dam, creating a managed water body.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/quasset_lake_connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quasset’s waters flow from small streams and groundwater, then exit via Quasset Brook into the Quinebaug River watershed.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/quasset_lake_connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1844 Leonard Cocking built a woolen mill on Quasset Lake, harnessing its waters for textile production until the late 1800s.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/quasset_lake_connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After World War II, the lake’s shores saw a boom in cottage construction, turning Quasset into a popular rural retreat.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/quasset_lake_connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Quasset Lake sits inside Connecticut’s Last Green Valley National Heritage Corridor, a 35‑town stretch celebrating rural New England landscapes.",
      "sourceSentenceIds": [
        12
