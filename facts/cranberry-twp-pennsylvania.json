    {
      "id": 1,
      "text": "Cranberry Twp, Pennsylvania, was named for the wild cranberries that once grew abundantly along Brush Creek before they disappeared by the 1880s.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
