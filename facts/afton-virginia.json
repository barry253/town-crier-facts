  "facts": [
    {
      "id": 1,
      "text": "Afton once thrived as a railroad town, thanks to the Blue Ridge Tunnel built in the 1850s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visit151.com/articles/afton-virginia-guide",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "French engineer Claudius Crozet, known as the “Pathfinder of the Blue Ridge,” directed the construction of four mountain tunnels, including the longest in the region.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/002-5075/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Afton sits in the foothills of the Blue Ridge Mountains, about 20 miles west of Charlottesville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The town’s historic core includes the mid‑19th‑century villages of Greenwood Depot and Afton, plus early‑20th‑century African‑American communities of New Town and Free Town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/002-5075/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Afton is home to several craft producers, including Hazy Mountain Vineyards & Brewery, Silverback Distillery, Veritas Vineyard and Winery, Blue Mountain Brewery, and Cardinal Point Vineyard & Winery.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Scott Castle, a 25,000‑square‑foot Tudor‑Gothic mansion built in 1911 by engineer Henry Baskervill and architect John Russell Pope, once hosted a charity auction for local fire services.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Afton%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    }
