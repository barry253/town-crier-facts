  "facts": [
    {
      "id": 1,
      "text": "Shorncliffe railway station, at Railway Avenue, is the terminus of the Shorncliffe line, originally called the Sandgate line.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shorncliffe%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from Sandgate, after the seaside town in Kent, England, before adopting Shorncliffe for its cliffs.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shorncliffe%2C_Queensland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shorncliffe Pier, built in 1879, became the longest recreational pier in Australia after extensions in 1883‑84 and later low‑tide docking.",
      "sourceSentenceIds": [
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shorncliffe%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Moora Park’s 1897 octagonal kiosk, designed by Hubert Thomas, still hosts the band rotunda that once entertained holidaymakers.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.brisbane.qld.gov.au/events-arts-and-culture/art-and-culture/heritage-trails/shorncliffe-heritage-trail",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shorncliffe Infants State School opened 28 January 1919 in the old courthouse beside the police station, marking early education in the suburb.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shorncliffe%2C_Queensland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The suburb’s only land boundary is with Sandgate, forcing all road access through that neighboring suburb.",
