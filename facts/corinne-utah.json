  "facts": [
    {
      "id": 1,
      "text": "Corinne was founded in 1869 by non-Mormon merchants who wanted to create a town that could compete economically with the Saints of Utah.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinne%2C_Utah"
    },
    {
      "id": 2,
      "text": "One of the founders named Corinne after his fourteen-year-old daughter.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinne%2C_Utah"
    },
    {
      "id": 3,
      "text": "For nearly ten years, Corinne prospered as the unofficial Gentile Capital of Utah and served as a major freight-transfer point.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinne%2C_Utah"
    },
    {
      "id": 4,
      "text": "Corinne once felt like the Dodge City of Utah, featuring fifteen saloons and sixteen liquor stores to serve freighters and stagecoach drivers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Corinne%2C_Utah"
    },
    {
      "id": 5,
      "text": "The town's status as a shipping center declined after the building of the Utah Northern Railroad and the Lucin Cut-Off.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.corinnecity.gov/city-history/"
    },
    {
      "id": 6,
      "text": "Corinne is now a quiet farming community located in southeastern Box Elder County on the west side of the Bear River.",
      "sourceSentenceIds": [
        9,
        15,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.corinnecity.gov/city-history/"
    }
  ]
}
