  "facts": [
    {
      "id": 1,
      "text": "Brownstown was founded in 1815 and named after Jacob Brown, a local landowner and early settler in Lancaster County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_brownstown",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Brownstown Covered Bridge, built in 1849, is one of Pennsylvania’s few remaining covered bridges and a historic landmark.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_brownstown",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Brownstown grew around a mile east of the Brown family homestead, with its first post office opening in 1860.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brownstown_lancaster_county_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers were German pioneers from the Palatinate region, attracted by religious freedom and fertile soil, forming the area originally part of Earl Township.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brownstown_lancaster_county_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A stone Wenger’s Mill on the Conestoga, built in 1855, processed grain for surrounding farms and later generated electricity in 1903, marking a shift to utilities.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brownstown_lancaster_county_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Brownstown’s rural character is reinforced by its proximity to Amish Country, influencing local agriculture and maintaining four historic churches dating to the 19th century.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brownstown_lancaster_county_pennsylvania",
      "category": "culture",
      "quality": "good"
    }
