      "id": 1,
      "text": "Kimballton takes its name from railroad employee Edward Kimball, whose work helped bring the rail line to the area.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kimballton%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1883, Kimballton began when Danish immigrant Hans Jensen Jorgensen opened a post office on his farmland.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/kimballton_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Danish Lutheran churches like Bethany and Immanuel were central hubs, offering services in Danish with pastors from Denmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kimballton_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kimballton boasts eight National Register sites, from the Bethany Danish Evangelical Lutheran Church to historic farmsteads reflecting immigrant styles.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/kimballton_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On Main Street, a gazebo echoes the early 1900s band gazebo where the Kimballton Band played every Saturday night.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
