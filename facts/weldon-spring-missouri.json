  "facts": [
    {
      "id": 1,
      "text": "Weldon Spring was named after a spring near the original town site.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weldon_Spring%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1941 the U.S. Army bought 17,000 acres to build the largest explosives factory in the U.S., producing TNT and DNT for WWII.",
      "sourceSentenceIds": [
        3,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weldon_Spring%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The plant produced over 710 million pounds of TNT and 33 million pounds of DNT before closing on August 15, 1945.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weldon_Spring%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the war, the Atomic Energy Commission built a uranium ore processing plant that produced yellow cake uranium, contaminating the site with asbestos and radioactive material.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weldon_Spring%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Department of Energy began decontamination in the late 1980s and finished in 2001, leaving a 45‑acre rubble mountain.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weldon_Spring%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today the Weldon Spring Interpretive Center educates visitors about the military and atomic past while opening remediated green spaces.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/weldon_springs_missouri",
      "category": "landmark",
      "quality": "good"
    }
