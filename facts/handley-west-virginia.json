  "facts": [
    {
      "id": 1,
      "text": "Handley is located in the Upper Kanawha Valley on the south side of the Kanawha River.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Handley%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "First established in 1877 as Upper Creek, the town was renamed Handley in 1881 for the area's pioneer settlers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Handley%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "The Wyoming Manufacturing Company laid out the town of Handley and opened coal mines in the Kanawha seam.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvgw.net/kanawha/local/handley.html"
    },
    {
      "id": 4,
      "text": "Handley's oldest house is the James Morris residence, which now serves as a hotel.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvgw.net/kanawha/local/handley.html"
    },
    {
      "id": 5,
      "text": "The Chesapeake and Ohio Railway Company established yards and a round house in Handley during early 1891.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvgw.net/kanawha/local/handley.html"
    },
    {
      "id": 6,
      "text": "Trains and barges once hauled coal for the Chesapeake Mining Company until the local deposits were removed.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Handley%2C_West_Virginia"
