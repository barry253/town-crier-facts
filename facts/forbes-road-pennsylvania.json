  "facts": [
    {
      "id": 1,
      "text": "Forbes Road was built in 1758 by Brigadier General John Forbes during the French and Indian War.",
      "sourceSentenceIds": [
        4,
        6,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Forbes_Road"
    },
    {
      "id": 2,
      "text": "The road stretched roughly 220 miles from Carlisle to the Forks of the Ohio, passing forts like Loudon, Lyttleton, Bedford, and Ligonier.",
      "sourceSentenceIds": [
        6,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forbes_Road"
    },
    {
      "id": 3,
      "text": "A historical marker near Everett, Bedford County, commemorates the road’s completion and its role in linking Pennsylvania to Pittsburgh.",
      "sourceSentenceIds": [
        17,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bloodyrunhistory.org/Dates/ForbesRoad.html"
    },
    {
      "id": 4,
      "text": "The original path, once called the Raystown Path, was widened under Forbes’ supervision to serve as a military supply route.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bloodyrunhistory.org/Dates/ForbesRoad.html"
    },
    {
      "id": 5,
      "text": "Forbes Road’s alignment influenced the modern Pennsylvania Turnpike, which follows its westward trend from Carlisle to near Monroeville.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forbes_Road"
    },
    {
      "id": 6,
      "text": "A roadside marker in Forbes Road village notes that the next two miles follow the original trace, highlighting the road’s enduring legacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forbes_Road"
    }
  ]
}
