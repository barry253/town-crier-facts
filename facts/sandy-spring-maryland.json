  "facts": [
    {
      "id": 1,
      "text": "Sandy Spring was founded by Quakers in the early 1700s, who sought land to grow tobacco and corn.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Spring%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sharp Street Church, founded in 1822, became Montgomery County's first African‑American congregation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Spring%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sandy Spring Museum started in 1980 inside a bank basement and now chronicles African‑American heritage from slavery to today.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.islands.com/1954637/sandy-spring-maryland-between-dc-baltimore-historic-gem-adventure-park-museums-art/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its digitized archives, especially rich in African‑American history, give public access to personal narratives and historic photographs.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/sandy-spring-museum.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quakers erected a brick meeting house in 1817, replacing a 1770 frame structure that still stands today.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Spring%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sandy Spring Library opened behind the store in 1842, with a research addition added in 2007.",
