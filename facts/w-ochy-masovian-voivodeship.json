  "facts": [
    {
      "id": 1,
      "text": "Włochy took its name from Jan Włoch, who bought part of the village Porzucewo in 1452, turning a small settlement into the town we know today.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/W%C5%82ochy",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1998, the Helena Chodkowska University of Technology and Economics opened in Old Włochy, marking the town’s first private higher‑education institution.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/W%C5%82ochy",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wiktoryn railway station was relocated to a new line at Popularna and Krańcowa Streets and later renamed Warszawa Włochy Graniczna, reflecting the town’s growing connectivity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/W%C5%82ochy",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Second Northern War, Swedish troops razed the village of Górki in 1656, along with neighboring Sopęchy, a reminder of the region’s turbulent past.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/W%C5%82ochy",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1930, Włochy was granted municipal status, becoming the seat of a new municipality that included Solipse and the hamlet of Wiktoryn.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/W%C5%82ochy",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Przyszłość Włochy sports club was founded on 15 April 1930, becoming one of the town’s earliest organized athletic groups.",
      "sourceSentenceIds": [
        28
