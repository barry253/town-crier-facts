  "facts": [
    {
      "id": 1,
      "text": "Fort Frederica, built in 1736, sits on the west side of St. Simons and was named after Prince Frederick Louis, the heir to the British throne.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/st-simons-island/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1742, troops from Fort Frederica defeated Spanish forces at the Battle of Bloody Marsh, ending Spanish influence in Georgia.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/st-simons-island/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "St. Simons is Georgia’s second‑largest barrier island, known for its extensive oak tree canopies and historic landmarks.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/st-simons-island/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The St. Simons African American Heritage Coalition hosts the annual Georgia Sea Islands Festival, celebrating Geechee music, food, and crafts.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Simons%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Visitors flock to St. Simons for its warm climate, pristine beaches, and a variety of outdoor activities like fishing, sailing, and golf.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Simons%2C_Georgia",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "A large nature preserve in the island’s northeast protects trails, historical ruins, and an undisturbed maritime forest.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
