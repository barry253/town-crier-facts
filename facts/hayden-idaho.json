  "facts": [
    {
      "id": 1,
      "text": "Mat Heyden, a soldier from Fort Sherman, won a poker game that decided Hayden Lake's name, and the spelling settled as Hayden.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayden%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Swiss‑Chalet Bozanta Tavern, designed by Spokane architect KK Cutter, lured Presidents Theodore Roosevelt and William Howard Taft to Hayden.",
      "sourceSentenceIds": [
        18,
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayden%2C_Idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1906 investors expanded Bozanta Tavern into a resort that steamboats used to serve nearby sawmills on Lake Hayden.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayden%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first general store and post office opened near Lake Hayden in the 1890s, later moving closer to Government Way as the town shifted from lake to road.",
      "sourceSentenceIds": [
        26,
        27,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayden%2C_Idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hayden was officially incorporated on June 27, 1955, after a history rooted in cattle ranching, lumber, farming, and Indian folklore.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.haydenid.gov/about_hayden/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 1936 Art Deco building on Government Way still stands today, a relic of Hayden's early 20th‑century growth.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hayden%2C_Idaho",
      "category": "landmark",
      "quality": "good"
    }
