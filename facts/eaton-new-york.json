    },
    {
      "id": 2,
      "text": "The town was officially created in 1807, carved out of the older Town of Hamilton.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eaton%2C_New_York"
    },
    {
      "id": 3,
      "text": "Eaton hosts the geographic center of New York State, located near the hamlet of Pratts Hollow.",
