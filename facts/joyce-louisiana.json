  "facts": [
    {
      "id": 1,
      "text": "Joyce named after Chicago-based Joyce family, who brought lumber operations in the 1920s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/joyce_louisiana"
    },
    {
      "id": 2,
      "text": "The Tremont Lumber Company moved its main sawmill to Joyce in 1948, expanding into a kiln, plywood, and flooring plant.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/joyce_louisiana"
    },
    {
      "id": 3,
      "text": "The company’s presence sparked an employment boom, with company‑owned subdivisions and housing for workers.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/joyce_louisiana"
    },
    {
      "id": 4,
      "text": "Joyce was incorporated as a municipality on May 13, 1963, led by former Tremont employees.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/joyce_louisiana"
    },
    {
      "id": 5,
      "text": "The town sits in the piney woods region, about 5 miles northeast of Winnfield, blending suburban and rural landscapes.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/joyce_louisiana"
    },
    {
      "id": 6,
      "text": "Peggy Hopkins Joyce, a former actress and socialite, managed the Tremont Lumber Company in Joyce from 1944 until her death in 1957.",
