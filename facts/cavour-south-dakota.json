    },
    {
      "id": 2,
      "text": "The town of Cavour was named for Camillo Benso, Count of Cavour, an Italian statesman who helped unify Italy.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
