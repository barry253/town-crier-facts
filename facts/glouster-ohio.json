  "facts": [
    {
      "id": 1,
      "text": "Glouster was first called Sedalia, but in 1886 the name changed to Glouster, a spelling nod to Gloucester, England.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glouster%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The village lies where the West Branch of Sunday Creek joins Sunday Creek, creating a natural confluence.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glouster%2C_Ohio"
    },
    {
      "id": 3,
      "text": "In the early twentieth century, Glouster’s economy thrived on mining, brickmaking, and the railroad industry.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glouster%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Just a mile north stands the Palos Covered Bridge, built in 1879 over the East Fork of Sunday Creek and listed on the National Register.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glouster%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Glouster hosts a branch of the Athens County Public Libraries, offering residents access to regional books and resources.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
