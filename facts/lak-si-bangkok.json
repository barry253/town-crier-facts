  "facts": [
    {
      "id": 1,
      "text": "Lak Si means \"fourth milestone,\" named after the fourth marker on Khlong Prem Prachakon, a canal dug by King Chulalongkorn.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lak_Si_district",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district sits along the historic Khlong Prem Prachakon, a waterway that once linked Bangkok to the royal town of Bang Pa‑in.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lak_Si_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residents enjoy quiet streets because Lak Si blends residential neighborhoods with pockets of commercial activity, keeping crowds lower than central Bangkok.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aroundus.com/p/9600971-lak-si",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Local artisans in Lak Si keep Thai kite‑making and mask‑carving traditions alive, producing Khon masks for classical dance performances.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aroundus.com/p/9600971-lak-si",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The MRT Pink Line connects Lak Si to downtown Bangkok, making the area well‑served by rapid transit.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://aroundus.com/p/9600971-lak-si",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Daily life in Lak Si feels authentic with bustling street markets, family‑run restaurants, and parks that showcase everyday Thai culture.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
