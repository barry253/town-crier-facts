  "facts": [
    {
      "id": 1,
      "text": "Lake Nokomis was originally called Lake Amelia, named by Captain George Gooding for his daughter in 1819.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://discoverthecities.com/nokomis-neighborhood-minneapolis/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Minneapolis Park and Recreation Board dredged the lake from 1914 to 1917, removing 2.5 million cubic yards and deepening it to an average of 15 feet.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nokomis_minneapolis",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Nokomis sits in the heart of the Nokomis neighborhood, a 170‑acre park that once served as a public green space and now hosts native gardens and the Minneapolis Parks Foundation offices.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverthecities.com/nokomis-neighborhood-minneapolis/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The lake’s oval shape stretches southwest to northeast, and a 2.7‑mile pedestrian trail circles its perimeter.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Nokomis",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the early 1900s, annexation of land from Richfield in 1927 accelerated development, and the lake became part of Minneapolis’s Chain of Lakes system under landscape architect Horace Cleveland.",
      "sourceSentenceIds": [
        7
      ],
