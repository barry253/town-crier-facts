  "facts": [
    {
      "id": 1,
      "text": "Onaway grew from a logging settlement in the 1880s to the largest city in Presque Isle County by the 1900s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/onaway-michigan-the-town-that-steered-the-world/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from “Onaiweh,” meaning “awake,” coined by Henry Wadsworth Longfellow’s Song of Hiawatha.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/onaway-michigan-the-town-that-steered-the-world/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1898, the first Detroit & Mackinac freight train arrived, linking Onaway to regional commerce.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/onaway-michigan-the-town-that-steered-the-world/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Onaway housed the Lobdell & Emery Wooden Steering Wheel Factory, producing about 65% of the world’s wooden steering wheels in the early 1900s.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onaway%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1926 factory fire devastated the Wood Rim Company, but the community rebuilt and survived the Great Depression.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/onaway-michigan-the-town-that-steered-the-world/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Onaway Historical Museum, inside the historic courthouse, showcases artifacts from the town’s lumber boom to today.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.onawayhistoricalmuseum.com/",
