  "facts": [
    {
      "id": 1,
      "text": "Southwest City was formally platted in 1870 and named for its position in the extreme southwest corner of McDonald County and the state of Missouri.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1846 a general store opened in the valley, turning the settlement into a crossroads for travelers near the border of Indian Territory.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Honey Creek runs through the city, flowing northwest to the Neosho River within Lake of the Cherokees in Oklahoma.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By the late 19th century, Southwest City had banks, churches, schools, and businesses serving both locals and travelers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early 1900s railroads, like the Southwest Missouri Railroad, connected the town to the Tri‑State mining district famous for lead and zinc.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Southwest City blends frontier heritage with modern farming, food processing, and cross‑border commerce.",
      "sourceSentenceIds": [
        15
      ],
