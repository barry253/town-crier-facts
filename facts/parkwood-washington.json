  "facts": [
    {
      "id": 1,
      "text": "Parkwood once hosted Pershing Station, a stop on the early Seattle–Everett Interurban Railway that linked the community to regional growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.destinationshoreline.com/neighborhoods/parkwood"
    },
    {
      "id": 2,
      "text": "The Parkwood Neighborhood Association, an all‑volunteer group, keeps the town’s streets safe and connects residents with the City of Shoreline.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.destinationshoreline.com/neighborhoods/parkwood"
    },
    {
      "id": 3,
      "text": "The Interurban line stretched 29 miles with 30 stops, and Parkwood’s Pershing Station sat near 155th Street, a key junction for travelers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.destinationshoreline.com/neighborhoods/parkwood"
    },
    {
      "id": 4,
      "text": "A historic photo of Parkwood is displayed in the Shoreline Historical Museum, preserving the town’s early visual record.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.destinationshoreline.com/neighborhoods/parkwood"
    },
    {
      "id": 5,
      "text": "The Lewis County Historical Museum holds a photo of Parkwood’s early days, offering a glimpse into the community’s past.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lewistalk.com/2021/12/31/small-town-tales-the-story-of-packwood/"
    },
    {
      "id": 6,
      "text": "Parkwood’s name appears on maps as a distinct census‑designated place within the City of Shoreline, reflecting its unique local identity.",
