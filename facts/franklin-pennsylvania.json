      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Liberty Street, Franklin’s main artery, earned a spot on the American Planning Association’s 2010 list of Great Streets of America.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
