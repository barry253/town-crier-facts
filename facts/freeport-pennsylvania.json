  "facts": [
    {
      "id": 1,
      "text": "Freeport began as Todd's Town in 1796, then in 1797 David Todd renamed it Freeport after declaring all river craft could dock without wharfage.",
      "sourceSentenceIds": [
        11,
        14,
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeport%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lucesco Oil Refinery and Freeport Brick Company once powered the borough’s 19th‑century industry, and their ruins still line the Allegheny River.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeport%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Freeport sits where the Kiskiminetas River meets the Allegheny, a confluence that historically boosted trade toward Pittsburgh.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeport%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough was a stop on the former Pennsylvania Canal, linking it to a vast inland waterway network.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Freeport%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
