  "facts": [
    {
      "id": 1,
      "text": "Karen was named after Danish author Karen Blixen, who lived on a coffee plantation there in the early 1900s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bantu.co.ke/discover-karen-nairobi/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Karen Blixen Museum, preserved on the former author's estate at the foot of Ngong Hills, lets visitors step into the life that inspired Out of Africa.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ollosowan.com/post/hidden-gems-to-discover-in-karen-nairobi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Karen borders the Ngong Forest and hosts the Ngong Racecourse, a historic venue for horse racing.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Karen%2C_Kenya",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The suburb evolved into a cultural and ecological hub while keeping its elegant character, blending luxury, history, and nature.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bantu.co.ke/discover-karen-nairobi/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 1975, Kazuri, meaning 'small and beautiful' in Swahili, started as a workshop to give sustainable jobs to single mothers.",
