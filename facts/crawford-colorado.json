  "facts": [
    {
      "id": 1,
      "text": "Crawford was founded in 1882, establishing a small mining community that grew into the town we know today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crawford%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Captain George A. Crawford, whose idea to start a post office sparked its growth.",
      "sourceSentenceIds": [
        2,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Crawford%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Crawford’s downtown preserves a western feel with historic false‑front, stone, and clapboard buildings and a few old settler log cabins.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://northforkvalley.net/Community",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The post office opened on April 14, 1883, marking the town’s official start.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crawford%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Crawford sits at 6,520 feet and serves as the gateway to the North Rim of the Black Canyon of the Gunnison National Park.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://deltacountycolorado.com/stay/towns/crawford/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town hosts an annual Pioneer Days festival featuring a locally produced melodrama, craft booths, and a Fire Auxiliary BBQ dinner.",
