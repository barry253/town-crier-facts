  "facts": [
    {
      "id": 1,
      "text": "Victoria–Fraserview began as one of the earliest settlement areas, with first European settlers arriving in the 1860s and a wagon road built in 1875.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%E2%80%93Fraserview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighbourhood sits on a south‑facing slope overlooking the Fraser River, Mitchell Island, Richmond and Delta.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%E2%80%93Fraserview",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1940s, 1,100 new homes were built for World War II veterans on land expropriated by the CMHC, sparking a rapid post‑war expansion.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%E2%80%93Fraserview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fraserview branch of Vancouver Public Library on Argyle Drive serves the community and is within walking distance of David Thompson Secondary School.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%E2%80%93Fraserview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Avalon Dairy remains the only heritage building in Victoria–Fraserview, a relic of the neighbourhood’s early industrial past.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%E2%80%93Fraserview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Fraserlands development has turned former industrial riverfront into condominiums and other residential projects, reshaping the area since the 1980s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victoria%E2%80%93Fraserview",
