  "facts": [
    {
      "id": 1,
      "text": "Barrington was named by Robert Campbell after Barrington Center when he platted a community near Deer Grove station.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barrington%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and North Western Railway extended a line to Deer Grove in 1854, building the station that later moved to Barrington’s modern site.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barrington%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Barrington History Museum, housed in a former Bowman Dairy ice house built in 1904, preserves the town’s early 20th‑century architecture.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barrington%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Catlow Theater, still operating as a single‑screen venue, opened in 1927 and remains on the National Register of Historic Places.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barrington%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s library, founded in 1915, relocated to its current location in the mid‑1970s, serving as a community hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
