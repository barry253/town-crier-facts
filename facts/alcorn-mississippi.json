  "facts": [
    {
      "id": 1,
      "text": "Alcorn is home to Alcorn State University, the nation's oldest public historically black land‑grant university, founded on a former Oakland College campus.",
      "sourceSentenceIds": [
        12,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alcorn_mississippi"
    },
    {
      "id": 2,
      "text": "The university’s campus covers 1,700 acres, originally purchased as 225 acres in 1871 from the defunct Oakland College.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alcorn_mississippi"
    },
    {
      "id": 3,
      "text": "Alcorn’s early history includes a unique role for women in academia, a fact noted in local histories.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/alcorn-county/"
    },
    {
      "id": 4,
      "text": "The community sits within the Big Black River basin, where riparian habitats shape local soil and biodiversity.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/alcorn_mississippi"
    },
    {
