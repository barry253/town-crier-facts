  "facts": [
    {
      "id": 1,
      "text": "Sangerfield takes its name from Jedediah Sanger, one of the town’s earliest settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sangerfield%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town was officially formed on March 5, 1795, carved out of the older town of Paris.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://oneida.nygenweb.net/towns/sangerfield/index.htm"
    },
    {
      "id": 3,
      "text": "Sitting on the historic Cherry Valley Turnpike—now US Route 20—Sangerfield once buzzed with taverns and stores for travelers between Albany and Buffalo.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sangerfieldny.gov/community/history"
    },
    {
      "id": 4,
      "text": "While dairy farming has long dominated, the 1830s introduction of hops turned Sangerfield and nearby Waterville into the world’s hops capital.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sangerfieldny.gov/community/history"
    },
    {
      "id": 5,
      "text": "Pleasant Valley Grange Hall, a 19th‑century landmark, earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sangerfield%2C_New_York"
    },
    {
      "id": 6,
      "text": "The Sangerfield River winds southward through the town, shaping its landscape and early industry.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sangerfield%2C_New_York"
