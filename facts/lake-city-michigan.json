  "facts": [
    {
      "id": 1,
      "text": "Lake City was originally settled in 1868 when Daniel Reeder built the first log cabin near what became Lake Missaukee.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Lake_City,_Michigan"
    },
    {
      "id": 2,
      "text": "The town was renamed Lake City in 1877 to reflect its proximity to Lake Missaukee, formerly Muskrat Lake.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_City%2C_Michigan"
    },
    {
      "id": 3,
      "text": "A 1873 connection to the Grand Rapids and Indiana Railroad turned Lake City into a logging hub, shipping timber to larger markets.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_City%2C_Michigan"
    },
    {
      "id": 4,
      "text": "In 1932 Lake City transitioned from a village to a city, marking a milestone in its municipal development.",
