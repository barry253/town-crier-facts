  "facts": [
    {
      "id": 1,
      "text": "Old Town San Diego State Historic Park preserves five original adobe buildings that now house museums, shops, and restaurants.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/?page_id=663"
    },
    {
      "id": 2,
      "text": "The park’s Historic Plaza hosts gatherings and historic activities, echoing the town’s role as California’s birthplace.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.parks.ca.gov/?page_id=663"
    },
    {
      "id": 3,
      "text": "La Casa de Estudillo, one of the first houses in San Diego, sits among dozens of preserved historic buildings in Old Town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.govisitsandiego.com/things-to-do/history/history-of-old-town-the-birthplace-of-california/"
    },
    {
      "id": 4,
      "text": "The area evolved from a Kumeyaay village to a Mexican pueblo and then an American settlement, a journey showcased in living history demos.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/?page_id=663"
    },
    {
      "id": 5,
      "text": "Old Town’s name originated when the original settlement became known as Old Town, while the surrounding city was named San Diego.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.govisitsandiego.com/things-to-do/history/history-of-old-town-the-birthplace-of-california/"
    },
    {
      "id": 6,
      "text": "The Presidio and Mission San Diego de Alcalá were founded in 1769 by Gaspar de Portolá and Junípero Serra on a bluff beside the San Diego River.",
