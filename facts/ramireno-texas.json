  "facts": [
    {
      "id": 1,
      "text": "Ramireno was named after Don José Luis Ramírez, who received the land from the king of Spain in 1784.",
      "sourceSentenceIds": [
        22,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ramireno%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town moved to its present spot on U.S. Highway 281 when Falcon Dam was completed in 1953.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ramireno-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the move, Ramireno lay two miles south of its current location on the banks of the Rio Grande.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/ramireno-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The founding families were the Ramírez clan, who had ten children whose descendants became the core of the community.",
