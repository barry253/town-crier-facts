  "facts": [
    {
      "id": 1,
      "text": "The Arizona Biltmore opened on February 23, 1929, in grand fashion, with a wooden key dropped by Scenic Airways on its roof that day.",
      "sourceSentenceIds": [
        2,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.arizonabiltmore.com/about-us/resort-history/"
    },
    {
      "id": 2,
      "text": "Frank Lloyd Wright’s architectural vision shaped the resort, with his student Albert Chase McArthur designing the original structure and later adding Wright‑inspired décor.",
      "sourceSentenceIds": [
        18,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.arizonabiltmore.com/about-us/resort-history/"
    },
    {
      "id": 3,
      "text": "Actors Clark Gable and Carole Lombard often stayed in room 1201, now called the Clark Gable room, right beside the Mystery Room.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arizona_Biltmore_Hotel"
    },
    {
      "id": 4,
      "text": "The original hotel solarium was converted into a restaurant in 1973 and has been called Wright's since the mid‑1990s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arizona_Biltmore_Hotel"
    },
    {
      "id": 5,
      "text": "In 2009 the Biltmore celebrated its 80th anniversary with two additions that reinforced its architectural legacy.",
