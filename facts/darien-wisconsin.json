  "facts": [
    {
      "id": 1,
      "text": "Darien was originally called Bruceville until 1840, when it was renamed after Darien, New York.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://darienvillagewi.gov/history"
    },
    {
      "id": 2,
      "text": "John Bruce purchased the land where the village of Darien now stands in the spring of 1837.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://darienvillagewi.gov/history"
    },
    {
      "id": 3,
      "text": "The downtown district of Darien is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://darienvillagewi.gov/history"
    },
    {
      "id": 4,
      "text": "John Bruce set aside three acres of land in perpetuity to be known as The Commons.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://darienvillagewi.gov/history"
    },
    {
      "id": 5,
      "text": "Darien served as a stop on the Racine and Southwestern branch line of the Chicago, Milwaukee, St. Paul and Pacific Railroad.",
      "sourceSentenceIds": [
        25
