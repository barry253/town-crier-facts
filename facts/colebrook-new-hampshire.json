  "facts": [
    {
      "id": 1,
      "text": "Colebrook was first granted in 1762 by Governor Benning Wentworth to a group of investors, before being renamed after Sir George Colebrooke in 1770.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://colebrooknh.org/history/41-2/"
    },
    {
      "id": 2,
      "text": "In 1812, a woolen factory opened in what became Factory Village, spurred by the town’s abundant sheep farms.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://colebrooknh.org/history/41-2/"
    },
    {
      "id": 3,
      "text": "The first street lamp in Colebrook lit up in 1876, illuminating the town’s growing streets for the first time.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://colebrooknh.org/history/historical-information/"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad in 1887 shifted Colebrook’s economy from stagecoach routes to rail‑connected manufacturing.",
      "sourceSentenceIds": [
        18,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Colebrook%2C_New_Hampshire"
    },
    {
      "id": 5,
      "text": "The unfinished Metallak hotel, designed by John Calvin Stevens, remains the most thoroughly documented Victorian resort project in the White Mountains.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colebrook%2C_New_Hampshire"
    },
    {
      "id": 6,
      "text": "Beaver Brook Falls, a natural waterfall within Colebrook’s boundaries, is a popular spot for hikers exploring the Great North Woods.",
