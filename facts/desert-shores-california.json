  "facts": [
    {
      "id": 1,
      "text": "Desert Shores began as a 1950s resort built to tap the Salton Sea craze, featuring shoreline homes and piers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Desert_Shores,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Salton Sea was accidentally created in 1905 when a Colorado River flood breached a canal, forming a saline lake.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Desert_Shores,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the sea has shrunk, exposing vast playa as evaporation and reduced inflows damage local communities.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Desert_Shores,_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Salinity now exceeds 60 g/L—about 1.7 times the Pacific Ocean—causing toxic algal blooms and oxygen loss.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Desert_Shores,_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Salton Sea Authority has restored 1,302 acres of wetlands to curb dust and support bird foraging areas.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Desert_Shores,_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Desert Shores lies on Quaternary alluvial sands and clays, part of the Colorado Desert ecoregion along the Salton Sea.",
