  "facts": [
    {
      "id": 1,
      "text": "Paw Paw Lake stretches 12.1 miles of shoreline, almost three times longer than a perfectly round lake of the same area.",
      "sourceSentenceIds": [
        1,
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pawpawlakemanagement.org/lake-facts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake’s shoreline development factor of 2.8 shows its irregular shape, a measure of how winding the banks are.",
      "sourceSentenceIds": [
        1,
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pawpawlakemanagement.org/lake-facts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1890s and 1900s, Paw Paw Lake became a bustling resort, drawing visitors to its pavilions, hotels, and cottages.",
      "sourceSentenceIds": [
        6,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paw_Paw_Lake%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nationally known performers once entertained crowds at the lake’s pavilions, though most of those historic buildings no longer exist.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paw_Paw_Lake%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Paw Paw River, the lake’s outlet, forms most of the southern boundary of the surrounding community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paw_Paw_Lake%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The lake’s property was auctioned in 2015 and again in 2021, with a final sale completed in March 2022.",
