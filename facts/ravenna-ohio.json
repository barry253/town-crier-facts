    {
      "id": 1,
      "text": "Benjamin Tappan founded Ravenna in 1799, naming it after the Italian city of Ravenna at his wife Nancy Wright's suggestion.",
      "sourceSentenceIds": [
        1,
        2,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenna%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Congregational Church, built in 1822, was Ravenna's first church and remains a historic landmark.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenna%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rail service reached Ravenna in 1851 via the Cleveland and Pittsburgh Railroad, linking it to regional trade.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenna%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1877, the Quaker Oats Company was founded in Ravenna, later becoming a national breakfast staple.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ravennaoh.gov/community/about-ravenna/our-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A $3 million downtown facelift in the late 1990s restored Ravenna's historic architecture and preserved its heritage.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ravenna%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ravenna serves as the county seat of Portage County and lies just 15 miles east of Akron.",
