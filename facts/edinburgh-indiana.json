  "facts": [
    {
      "id": 1,
      "text": "Edinburgh, Indiana was named after Edinburgh, Scotland, a choice that early settlers honored by keeping the original spelling until the town incorporated in 1853.",
      "sourceSentenceIds": [
        1,
        2,
        6,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Edinburgh%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Madison and Indianapolis Railroad in 1845 turned Edinburgh into a regional hub for grain and pork, a status boosted by later interurban lines.",
      "sourceSentenceIds": [
        11,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Edinburgh,_Indiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Edinburgh hosts Camp Atterbury, a National Guard training base that opened in 1942 and once housed more than 1,500 buildings for WWII artillery and engineering units.",
      "sourceSentenceIds": [
        18,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Edinburgh%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Edinburgh Wright‑Hageman Public Library, founded in 1822, now holds the town’s historic collection and is a key community landmark.",
      "sourceSentenceIds": [
        14,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Edinburgh%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just west of Edinburgh, the Big Blue River meets Sugar Creek to form the Driftwood River, a local waterway that shapes the town’s landscape.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Edinburgh%2C_Indiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Edinburgh was laid out around 1822 and has had a post office in continuous operation since 1823.",
      "sourceSentenceIds": [
