  "facts": [
    {
      "id": 1,
      "text": "Yellow Springs was founded in 1825 by William Mills and about 100 families following Robert Owen, aiming to recreate New Harmony's utopia.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Antioch College, a private liberal arts college, began in 1850 at Yellow Springs and was led by Horace Mann as its first president.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Little Miami Railroad reached Yellow Springs in 1846, boosting commerce, tourism, and the village’s growth as a health resort.",
      "sourceSentenceIds": [
        9,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Yellow Springs hosts WYSO, a public radio station that joined National Public Radio and became independent in 2019.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yellow_Springs%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s historic district includes a replica 1880s train depot, rebuilt in 2001 as the Chamber of Commerce office.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.buckeyetrail.org/towns/yellow-springs",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Yellow Springs’ springs were famed for iron‑rich waters believed to have medicinal benefits, drawing visitors since 1805.",
