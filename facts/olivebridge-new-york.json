      ],
      "source": "https://grokipedia.com/page/Olivebridge,_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The hamlet’s annual Olive Day festival showcases local music, runs, and crafts, highlighting its resilient, close‑knit community spirit.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
