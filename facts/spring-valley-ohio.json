  "facts": [
    {
      "id": 1,
      "text": "Spring Valley was founded in 1844 by Quaker brothers Edward and Moses Walton from Virginia.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.springvalleyoh.com/spring-valley-heritage/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits on a slope above the Little Miami River, surrounded by natural springs that gave it its name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://buckeyetrail.org/towns/spring-valley",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Walton Park, bordered by Elm, Main, and Route 725, honors the founders and is a community gathering spot.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 3"
      ],
      "source": "",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Barrett House, listed on the National Register, features a fire‑proof concrete wing built with river rock and animal‑hair mortar.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 6"
      ],
      "source": "",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Little Miami Railroad once ran through Spring Valley, later converted into the scenic Little Miami Trail that hikers still use today.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Web source 10",
        "Web source 15"
      ],
      "source": "",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every October, the village hosts a Potato Festival, during which the Barrett House museum opens to showcase local artifacts.",
