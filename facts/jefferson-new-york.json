  "facts": [
    {
      "id": 1,
      "text": "The Jefferson Historical Society, a nonprofit, dedicates itself to researching, preserving, and celebrating the town’s history, architecture, and culture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thejeffersonhistoricalsociety.org/"
    },
    {
      "id": 2,
      "text": "Through books, handouts, newsletters, and its Facebook page, the society spreads Jefferson’s rich historical stories to residents and visitors.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitschohariecounty.com/listing/the-jefferson-historical-society"
    },
    {
      "id": 3,
      "text": "The society also curates a music series, farmers’ market, and guided history walks that bring the town’s past to life.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitschohariecounty.com/listing/the-jefferson-historical-society"
    },
    {
      "id": 4,
      "text": "Monthly meetings, held on the first Tuesday at 3:30 p.m., take place in person at Judd Hall or via Zoom.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thejeffersonhistoricalsociety.org/"
    },
    {
      "id": 5,
      "text": "Restoring the Maple Museum and Judd Hall, the society has created venues for public events that honor local heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.thejeffersonhistoricalsociety.org/"
    },
    {
      "id": 6,
      "text": "Jefferson County, where the town lies, was named after Thomas Jefferson, the third President of the United States.",
