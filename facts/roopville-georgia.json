  "facts": [
    {
      "id": 1,
      "text": "Roopville was founded in 1881 by John K. Roop, whose family settled the area in the 1850s.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Roopville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Thomas M. Roop, whose son John King Roop helped establish the first post office.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://roopvillega.com/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Roop House, a preserved home, now houses the Roopville Archives and Historical Society and once served as a bank and post office.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://roopvillega.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Carroll County Historical Society opens the Roopville Archive building during the Homecoming Festival each September.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://carrollcountyhistory.org/roopville.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Roopville sits along U.S. Route 27, about 10 miles south of Carrollton and 6 miles north of Centralhatchee.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
