      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town honors brothers Clark Wallace “C.W.” and William Jasper “W.J.” Noel, stockmen who owned a sawmill.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
