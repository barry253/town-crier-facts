  "facts": [
    {
      "id": 1,
      "text": "Warner was first granted in 1735 as “Number One,” the first of several Masonian Proprietor settlements between the Merrimack and Connecticut rivers.",
      "sourceSentenceIds": [
        9,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://theglobalnext.com/the-fascinating-history-of-warner-nh/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1774, the town was incorporated as Warner, named for Jonathan Warner, a Royal Council member and close associate of Governor John Wentworth.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Warner%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1840s saw the Concord and Claremont Railroad reach Warner, linking the town to larger markets and sparking industrial growth.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://theglobalnext.com/the-fascinating-history-of-warner-nh/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Warner’s 1885 Great Fire rebuilt the downtown with modern brick buildings, a testament to the town’s resilience and modernization.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://theglobalnext.com/the-fascinating-history-of-warner-nh/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Upton Chandler House Museum and the Waterloo Covered Bridge are two historic landmarks that draw history lovers to Warner’s scenic streets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
