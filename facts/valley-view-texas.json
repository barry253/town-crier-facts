  "facts": [
    {
      "id": 1,
      "text": "Valley View was first settled in 1870 by the Lee family, who planted the first crops in the fertile Spring Creek valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_View%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1872, Lee plotted a town on his land and named it Valley View, likely because the site offered a sweeping view of the surrounding valley.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_View%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A blacksmith shop opened in 1873 and doubled as the community’s first school, teaching children right beside the forge.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_View%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Gulf, Colorado and Santa Fe Railway—now part of BNSF—reached Valley View in 1886, turning the town into a regional shipping hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_View%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1903, Valley View celebrated a two‑story brick schoolhouse, six brick business buildings, telephone service, and a new bank, signaling rapid growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_View%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Valley View News began publishing weekly in 1904, becoming the town’s first local newspaper.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley_View%2C_Texas",
