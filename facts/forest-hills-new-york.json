      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Long Island Rail Road opened a Forest Hills station in 1906, complete with a brick courtyard and clock tower that matched the nearby Forest Hills Gardens.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
