  "facts": [
    {
      "id": 1,
      "text": "Wilmot was incorporated in 1807 from parts of New London, Kearsarge gore, and a piece of New Chester.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmot%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors James Wilmot, an English clergyman who opposed England’s treatment of the colonies.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmot%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mount Kearsarge, at 2,931 feet, sits on Wilmot’s southern border and is the county’s highest point.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmot%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sunapee–Ragged–Kearsarge Greenway cuts through Wilmot, crossing Bog Mountain and climbing Mount Kearsarge.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmot%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eagle Pond hosts Camps Kenwood and Evergreen, two summer camps that have operated for decades.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilmot%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cascade Brook, Kimpton Brook, and Frazier Brook drain Wilmot, all flowing into the Blackwater River watershed.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
