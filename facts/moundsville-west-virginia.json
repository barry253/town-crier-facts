  "facts": [
    {
      "id": 1,
      "text": "Moundsville takes its name from the nearby Grave Creek Mound, built between 250 and 100 BC by the Adena culture.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moundsville%2C_West_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1852 the Baltimore and Ohio Railroad opened a line through Moundsville, linking the eastern rail network with the Ohio and Mississippi riverboat system.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moundsville%2C_West_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On August 4, 1927, Charles Lindbergh landed The Spirit of St. Louis at Langin Field in Moundsville.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moundsville%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fostoria Glass Company, known for its hand‑blown glass, was headquartered in Moundsville from 1891 until 1986.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moundsville%2C_West_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The West Virginia State Penitentiary operated in Moundsville from 1867 to 1995, serving as a notable historic institution.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moundsville%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Moundsville became the county seat of newly formed Marshall County in 1835, following Elizabethtown’s incorporation in 1830.",
