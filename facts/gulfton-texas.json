      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Families from El Salvador, Mexico, Vietnam, Honduras, and Guatemala crossed oceans and borders to call Gulfton home after the oil boom.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
