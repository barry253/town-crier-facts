    {
      "id": 1,
      "text": "São Bernardo do Campo was founded in 1553 by João Ramalho and originally called Vila de Santo André da Borda do Campo de Piratininga.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
