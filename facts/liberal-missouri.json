  "facts": [
    {
      "id": 1,
      "text": "Liberal was founded in 1880 by lawyer George Walser, who wanted a town of free thinkers.",
      "sourceSentenceIds": [
        7,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitbartoncounty.com/liberal-mo/"
    },
    {
      "id": 2,
      "text": "Walser advertised across the country for atheists, promising a community with no God, Hell, Church, or saloon.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberal%2C_Missouri"
    },
    {
      "id": 3,
      "text": "The Free Thought University opened in 1886, staffed by seven teachers who held lectures and debates.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberal%2C_Missouri"
    },
    {
      "id": 4,
      "text": "Walser relaxed restrictions, allowing saloons in 1887 and churches in 1889, after initial resistance.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberal%2C_Missouri"
    },
    {
      "id": 5,
      "text": "A nearby Christian settlement named Pedro emerged in 1884 after Walser fenced Liberal with barbed wire.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberal%2C_Missouri"
    },
    {
      "id": 6,
      "text": "Today Liberal hosts a branch of the Barton County Library, preserving its historical roots.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Liberal%2C_Missouri"
    }
  ]
