  "facts": [
    {
      "id": 1,
      "text": "Coltons Point houses Clement’s Island Museum, where visitors learn about Maryland’s first European settlement and the first Catholic Mass in English-speaking North America.",
      "sourceSentenceIds": [
        14,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Coltons_Point%2C_Maryland"
    },
    {
      "id": 2,
      "text": "Clement’s Island, the birthplace of Maryland, is reached by a short water taxi ride from Coltons Point.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/st-clements-island-museum.htm"
    },
    {
      "id": 3,
      "text": "A replica of the historic Maryland Dove ship sits on the island, celebrating local waterman heritage.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dnr.maryland.gov/publiclands/Pages/southern/stclements.aspx"
    },
    {
      "id": 4,
      "text": "The island’s lighthouse, part of the museum complex, marks the shoreline and echoes early maritime navigation.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coltons_Point%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Coltons Point was added to the National Register of Historic Places in 1972, honoring its rich heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coltons_Point%2C_Maryland"
    },
    {
      "id": 6,
      "text": "Exhibits at the museum highlight Piscataway culture, letting visitors experience indigenous traditions long before European arrival.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/st-clements-island-museum.htm"
