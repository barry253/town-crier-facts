  "facts": [
    {
      "id": 1,
      "text": "Namdaemun Gate, built in 1398, is South Korea's first National Treasure and a pagoda‑style gateway that once greeted foreign emissaries.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Namdaemun",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The market survived wars, invasions, and colonial rule, remaining open while many other Korean markets closed during Japanese occupation.",
      "sourceSentenceIds": [
        12,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.koreatripguide.com/destinations/historical-landmarks-and-sightseeing-around-namdaemun-market-seoul",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2008 a fire destroyed most historic buildings, including the wooden gate, but restoration plans cost ₩20 billion, the most expensive in Korea.",
      "sourceSentenceIds": [
        14,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Namdaemun",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Namdaemun Market hosts over 20,000 shops and is the largest traditional market in Korea, slated to become a global heritage market blending tradition with modern values.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://english.seoul.go.kr/namdaemun-traditional-market-with-600-year-long-history-to-transform-into-global-heritage-market/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A new arcade inspired by hanok eaves will be installed on the main road, reflecting the market’s 600‑year history.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://english.seoul.go.kr/namdaemun-traditional-market-with-600-year-long-history-to-transform-into-global-heritage-market/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Guided walking tours around Namdaemun include nearby Deoksugung Palace, a 10‑minute walk, offering history buffs a close look at Joseon‑era architecture.",
      "sourceSentenceIds": [
