  "facts": [
    {
      "id": 1,
      "text": "Bronzeville became known as Black Metropolis, a hub of African American business, arts, music, and culture that influenced the nation.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/bronzeville-black-metropolis-national-heritage-area.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bronzeville-Black Metropolis National Heritage Area spans from 18th to 71st Street, Lake Michigan to Canal, telling Great Migration and Civil Rights stories.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/places/bronzeville-black-metropolis-national-heritage-area.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Legendary jazz trumpeter Louis Armstrong lived in Bronzeville with his wife Lil Hardin, adding to the neighborhood’s musical legacy.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Chicago",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gwendolyn Brooks, Pulitzer‑winning poet and Chicago’s first black American poet laureate, called Bronzeville home, shaping the Black Renaissance.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas%2C_Chicago",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wabash YMCA in Bronzeville helped launch Black History Month, marking a national celebration of African American heritage.",
