  "facts": [
    {
      "id": 1,
      "text": "Winslow got its current name on August 3, 1881, in honor of Edward F., a key figure in the town’s early history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winslow%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town flourished in the early 1880s when the Louis‑San Francisco Railroad ran through the steep Boston Mountains, turning Winslow into a rail hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://washcohistoricalsociety.org/Winslow",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After regular passenger service began on the Frisco line in 1882, Winslow blossomed into a lively resort town with fine hotels for wealthy summerers.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://washcohistoricalsociety.org/Winslow",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winslow Museum, a centerpiece of downtown, displays artifacts, photographs, and dioramas that chronicle the region’s unique history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://intotheozarks.com/cities-of-the-ozarks/winslow-arkansas/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Winslow Public Library, housed in the old high school building, also hosts a bookstore and an internet café for locals.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winslow%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before becoming Winslow, the community was a stagecoach stop called Summit Home and opened its first post office on December 11, 1876.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
