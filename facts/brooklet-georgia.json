  "facts": [
    {
      "id": 1,
      "text": "Brooklet grew around a stop on the Savannah and Statesboro Railroad, becoming a town when two railroads crossed at Railroad and Cone Streets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofbrooklet.org/history-of-brooklet-georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially chartered in 1906, and the Georgia General Assembly incorporated Brooklet as a town that same year.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooklet%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Brooklet hosts the annual Peanut Festival each third Saturday of September, featuring a slow tractor race where the last tractor to finish wins.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooklet%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The festival’s first edition in 1990 drew about 2,000 people and helped finance a town park with benches, a gazebo, and a fountain.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooklet%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brooklet’s historic churches include Mary’s AME (1907), Christian Church (1909–1954), and the Primitive Baptist Church founded in 1914.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofbrooklet.org/history-of-brooklet-georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name first appeared in a 1899 Bulloch Herald announcement for a new post office at Parker and Cone’s Store, nine miles below Statesboro.",
      "sourceSentenceIds": [
        8
