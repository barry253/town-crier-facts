  "facts": [
    {
      "id": 1,
      "text": "Ashville was originally called St. Clairsville and was renamed to honor John Ash, the first white settler who arrived in 1817.",
      "sourceSentenceIds": [
        1,
        2,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashville%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890, investors formed the Ashville Railroad Company, building a line to Whitney that linked the town to the Alabama Great Southern Railroad.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The John Looney Pioneer House Museum, possibly Alabama's oldest dogtrot log house, was heavily damaged by fire in August 2022 and remains closed.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/ashville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Electric lights reached Ashville in 1891, and the first telephone company was chartered the same year, marking early modern communication.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ashville serves as one of two county seats of Clair County, the other being Pell City, established in 1907 due to travel difficulty over Backbone Mountain.",
      "sourceSentenceIds": [
        13,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s first courthouse, a log structure, was built in 1823 and replaced in 1844 with the current courthouse building.",
