  "facts": [
    {
      "id": 1,
      "text": "Cuauhtémoc borough takes its name from the 16th‑century Aztec ruler who led the last stand against the Spanish.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cuauht%C3%A9moc%2C_Mexico_City"
    },
    {
      "id": 2,
      "text": "It contains the oldest parts of Mexico City, covering what was the entire urban core in the 1920s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cuauht%C3%A9moc%2C_Mexico_City"
    },
    {
      "id": 3,
      "text": "Cuauhtémoc borough hosts key national institutions and landmarks, including the historic center and the lively Zona Rosa district.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mexicanroutes.com/cuauhtemoc-mexico-city/"
    },
    {
      "id": 4,
      "text": "Since the 1990s, city and federal governments, plus private groups, have worked to revitalize Cuauhtémoc, especially its historic center.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cuauht%C3%A9moc%2C_Mexico_City"
    },
    {
      "id": 5,
      "text": "A number of the oldest streets near the Zócalo have been turned pedestrian‑only, pushing most street vendors out of the historic center.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cuauht%C3%A9moc%2C_Mexico_City"
    },
    {
      "id": 6,
      "text": "Cuauhtémoc is the most visited area of Mexico City, drawing tourists mainly to the historic center and Zona Rosa.",
