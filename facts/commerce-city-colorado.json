      "quality": "good"
    },
    {
      "id": 2,
      "text": "Riverside Cemetery, founded in 1876, sits in the city’s southwest corner at East 52nd Avenue and Brighton Boulevard.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.c3gov.com/Residents/Living-In-Commerce-City/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Derby, a Burlington Railroad station established in 1887, became a town in 1889 but was largely abandoned by 1891.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.c3gov.com/Residents/Living-In-Commerce-City/History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Irondale was first settled in 1889, named after a foundry opened that year.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.c3gov.com/Residents/Living-In-Commerce-City/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rocky Mountain Arsenal, founded in 1942 east of the growing community, was created to support World War II efforts.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.c3gov.com/Residents/Living-In-Commerce-City/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rose Hill Cemetery, established in 1892 by the United Hebrew Cemetery Association, lies in the heart of historic Commerce City.",
