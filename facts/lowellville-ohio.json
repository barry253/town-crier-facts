  "facts": [
    {
      "id": 1,
      "text": "Lowellville’s name may stem from three local towns—McGillsville, Petersburg, and Lowell—joining together in 1836 to form the village.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communitylowellville-ysu.weebly.com/history.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Roman Catholic congregation of Our Lady of the Holy Rosary began in 1867, but the first church building wasn’t completed until 1888.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communitylowellville-ysu.weebly.com/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1800s, a wave of Italian immigrants arrived, adding a rich cultural layer to Lowellville’s community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communitylowellville-ysu.weebly.com/history.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At the turn of the 19th century, railroad construction replaced the canal as the main transport route, reshaping Lowellville’s economy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communitylowellville-ysu.weebly.com/history.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before settlers arrived, the Delaware Tribe once inhabited the area that is now Lowellville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communitylowellville-ysu.weebly.com/history.html",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lowellville sits on the Pennsylvania–Ohio border, just west of Mahoningtown and Hillsville, and is part of the Youngstown–Warren metropolitan area.",
