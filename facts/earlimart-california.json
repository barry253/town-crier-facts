  "facts": [
    {
      "id": 1,
      "text": "Earlimart got its name in 1910 when farmers called the town “earli‑mart” because their melons ripened early and hit market ahead of schedule.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://tularecountyedc.com/city/earlimart/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a rail stop in 1880, originally called Alila, when the San Joaquin Valley Railroad laid tracks through the valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tularecountyedc.com/city/earlimart/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A branch library opened in the old Alila School in October 1914, becoming the first public library in Tulare County’s Earlimart.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earlimart%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The current library building, located at 780 East Washington Street, was constructed in 1959 and still serves the community today.",
