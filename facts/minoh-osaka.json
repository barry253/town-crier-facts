  "facts": [
    {
      "id": 1,
      "text": "Minoh was founded over 1,300 years ago by the Shugendo monk Enno Gyoja, who is said to have ascended to heaven at Minoh Tenjogatake.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://matcha-jp.com/en/mcm28880",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name, officially romanized as “Minoh,” is a nod to its long history while locals often spell it “Minō” or “Minoo.”.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minoh",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Minoh’s skyline is dominated by the Minoh River, which flows southwestward and is paralleled by the historic Hankyu Minoh Line.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minoh",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In March 2024, two new stations—Minoh Kayano and Senba Osakadaimae—opened, linking the city directly to Osaka Station, Shin-Osaka, Namba, and Tennoji.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://matcha-jp.com/en/mcm28880",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Minoh Onsen, located beside the Hankyu station, remains a favorite hot‑spring spot for locals and visitors alike.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minoh",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s central and northern areas rise into mountains, offering hikers scenic trails that wind past historic waterfalls and traditional cafés.",
