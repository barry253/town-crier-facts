    {
      "id": 2,
      "text": "Hawk Springs developed in the 1920s as a railroad stop along the Union Pacific line to facilitate regional transport.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hawk_springs_wyoming"
    },
    {
      "id": 3,
      "text": "Revised homesteading laws after World War I attracted veterans to Hawk Springs with offers of eighty-acre irrigated farmsteads.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hawk_springs_wyoming"
    },
    {
      "id": 4,
      "text": "Hawk Springs remains a quiet rural enclave focused on dryland agriculture, producing crops like wheat, barley, and sugar beets.",
