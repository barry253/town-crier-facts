  "facts": [
    {
      "id": 1,
      "text": "Grand Avenue’s name honors former Arizona Senator Dennis DeConcini, who helped shape the state’s border policies.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nogales-Grand_Avenue_Port_of_Entry"
    },
    {
      "id": 2,
      "text": "The Grand Avenue border crossing opened in the early 20th century and has inspected vehicles, pedestrians, and trains ever since.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nogales-Grand_Avenue_Port_of_Entry"
    },
    {
      "id": 3,
      "text": "In 1931, Prohibition prompted a nationwide border‑security push that added a fence and two small inspection bungalows—called “garitas”—to Grand Avenue.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nogales-Grand_Avenue_Port_of_Entry"
    },
    {
      "id": 4,
      "text": "The original Grand Avenue garita was expanded in 1949 but was replaced by the current multi‑lane inspection facility in 1966.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nogales-Grand_Avenue_Port_of_Entry"
    },
    {
      "id": 5,
      "text": "Grand Avenue’s diagonal path once served as a vital link between Phoenix and Los Angeles, shaping early travel routes.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreamericanstreets.com/grand-avenue-phoenix/"
    },
    {
      "id": 6,
      "text": "Historic Grand Avenue has evolved continuously since before Phoenix’s founding in 1872, layering history more visibly than any other Valley street.",
