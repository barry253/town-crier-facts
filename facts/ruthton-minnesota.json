      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ruthton was platted in June 1888 as a station on the Willmar & Sioux Falls Railway, now part of BNSF.",
      "sourceSentenceIds": [
        1,
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://ruthton-mn.com/home/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city officially incorporated on November 2, 1897, solidifying its status as a municipal entity.",
      "sourceSentenceIds": [
        1,
        7,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://ruthton-mn.com/home/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ruthton’s post office has been in operation since 1888, serving residents for over a century.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ruthton%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Redwood River flows through Ruthton as an intermittent stream near its headwaters.",
