  "facts": [
    {
      "id": 1,
      "text": "Monument was first settled as a stop along the Rio Grande Railroad in 1872 and incorporated as Henry's Station in 1879 before changing its name.",
      "sourceSentenceIds": [
        7,
        8,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monument%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original name honored pioneer Henry Limbach, whose family ran a grocery store and helped plan the early community.",
      "sourceSentenceIds": [
        4,
        13,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://palmerdividehistory.org/monument-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A public art piece called “Ice Harvest” in Tri‑Lakes Views commemorates the region’s historic ice‑harvesting industry on nearby lakes.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofmonument.org/351/History-Arts-and-Culture",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Friends of Monument Preserve partners with the U.S. Forest Service to protect historic and recreational lands surrounding the town.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monument%2C_Colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The Western Museum of Mining & Industry showcases Colorado’s mining history with guided tours of exhibits in Monument.",
