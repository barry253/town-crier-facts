  "facts": [
    {
      "id": 1,
      "text": "The first house in Wheatley Heights was built in 1710 by Jacob Conklin, marking the area's earliest settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofbabylonny.gov/725/Wheatley-Heights-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wheatley Heights takes its name from a 1913 development planned by real‑estate investor William Geiger.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofbabylonny.gov/725/Wheatley-Heights-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1800s, Wheatley Heights and Wyandanch produced over 1.6 million bricks a year, shipped by rail to New York City.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofbabylonny.gov/725/Wheatley-Heights-History",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mid‑1800s companies bottled the region’s mineral springs, claiming health benefits, and sold the water under the Colonial Mineral Springs brand.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofbabylonny.gov/725/Wheatley-Heights-History",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1974, civic leader Hermann Griem spearheaded naming the local post office substation Wheatley Heights, cementing the community’s identity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofbabylonny.gov/725/Wheatley-Heights-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original Conklin home stood for more than two centuries before a fire destroyed it in 1918.",
      "sourceSentenceIds": [
