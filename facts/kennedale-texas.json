      "id": 1,
      "text": "Kennedale takes its name from Oliver S. Kennedy, who settled there in the 1860s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kennedale%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Kennedy platted the town and donated every other lot to the Southern Pacific Railroad.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kennedale%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 2011, the Kennedale Historical Society began donating its archives to Tarrant County in 2023.",
