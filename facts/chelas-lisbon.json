  "facts": [
    {
      "id": 1,
      "text": "Chelas began as a rural parish, but the 1960s saw large social‑housing projects that welcomed migrants from Portugal’s former African colonies.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/portugal/lisbon_chelas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chelas metro stop sits on Lisbon’s Red Line, linking the city’s eastern suburbs to the historic city centre.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelas_Station",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At the intersection of Avenida Doutor Augusto de Castro and Rua Engenheiro Rodrigues de Carvalho, the Chelas station borders the Instituto Superior de Engenharia de Lisboa.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chelas_Station",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chelas enjoys excellent public‑transport links, with Oriente Station nearby serving as a major hub for trains, buses, and the metro.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/portugal/lisbon_chelas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just a short walk from Chelas is the Oceanário de Lisboa, one of Europe’s largest aquariums, drawing marine‑enthusiasts worldwide.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/portugal/lisbon_chelas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chelas station’s design was crafted by architect Ana Nascimento, featuring installation art by plastic artist Jorge Martins.",
