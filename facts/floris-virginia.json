  "facts": [
    {
      "id": 1,
      "text": "Floris Historic District, listed on the National Register in 2010, preserves the village that once served Fairfax County’s dairy farms.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/029-5179/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the 1700s, the Carter family owned the land that would become Floris, a legacy of colonial Virginia’s elite.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/029-5179/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1867, Pleasant Baptist Church was founded by Black congregants, marking one of the earliest African‑American churches in the area.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/029-5179/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Edward Lee, son of the first Black landowners, helped found the first rural NAACP branch in 1915.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/029-5179/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1948 4‑H group behind Floris schools launched the Fairfax County Junior Fair, a local agricultural showcase.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/029-5179/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Frying Pan Farm Park opened in 1960, remaining segregated until the mid‑1960s while preserving rural Fairfax County scenery.",
