  "facts": [
    {
      "id": 1,
      "text": "Riverview in James City County features an antebellum dwelling that offers panoramic views of the York River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/047-0025/"
    },
    {
      "id": 2,
      "text": "The historic Riverview home in James City County was built in the 1850s on or near an 18th-century site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/047-0025/"
    },
    {
      "id": 3,
      "text": "Riverview in James City County is designed as an I-house and resembles Virginia plantation houses from a century earlier.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/047-0025/"
    },
    {
      "id": 4,
      "text": "The original owner of the Riverview estate in James City County was Albert Hankins, whose family owned the land since the mid-1700s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/047-0025/"
    },
    {
      "id": 5,
      "text": "One story wings were added to the Riverview home in James City County during 1913.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/047-0025/"
    },
    {
      "id": 6,
      "text": "Riverview is also the name of a statistical community located in Wise County.",
