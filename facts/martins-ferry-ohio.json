  "facts": [
    {
      "id": 1,
      "text": "Martins Ferry is the oldest European settlement in Ohio, first settled in 1779, almost a decade before Marietta.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Martins_Ferry%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Martin's Ferry in 1865 after Ebenezer Martin’s father operated a ferry across the Ohio River.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Martins_Ferry%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Martins Ferry sits on the Ohio River, directly opposite Wheeling, West Virginia, and is part of the Wheeling metropolitan area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Martins_Ferry%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 19th and early 20th centuries, Martins Ferry grew into a key rail hub and river port, fueling its industrial boom.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Martins_Ferry%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1835 redesign by Ebenezer Martin introduced a grid street system that still defines much of the city’s layout today.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Martins_Ferry%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s early history began with squatters from across the Ohio, who settled on the west bank despite the 1768 Treaty of Fort Stanwix.",
      "sourceSentenceIds": [
