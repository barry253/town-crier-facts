  "facts": [
    {
      "id": 1,
      "text": "Darrouzett takes its name from John Louis Darrouzet, a Texas legislator who served as an attorney for the Santa Fe Railroad.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Darrouzett%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was platted where Plummer Creek meets Kiowa Creek, right at the junction of the two waterways.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/darrouzett-tx",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Plummer and Kiowa Creeks converge just east of town, near the volunteer‑run Darrouzett Golf Course, a nine‑hole par‑three.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darrouzett%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Oklahoma border lies only about four miles north of Darrouzett, keeping the town close to the state line.",
      "sourceSentenceIds": [
