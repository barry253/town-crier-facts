  "facts": [
    {
      "id": 1,
      "text": "Art, Texas was founded in 1856 when five German families settled along Upper Willow Creek.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Art%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Eli Dechart, who renamed the post office after the last three letters of his own name in 1920.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Art%2C_Texas"
    },
    {
      "id": 3,
      "text": "A log Methodist church built in 1858 doubled as a schoolhouse for the early settlers.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Art%2C_Texas"
    },
    {
      "id": 4,
      "text": "The original stone church replaced the log building in 1875, reflecting the community’s growth.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Art%2C_Texas"
    },
    {
      "id": 5,
      "text": "Otto Plehwe opened one of the first general stores in Art, later becoming the town’s first post office.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Art%2C_Texas"
    },
    {
      "id": 6,
      "text": "Today, Art remains a widely dispersed ranching community in Mason County, Texas.",
      "sourceSentenceIds": [
