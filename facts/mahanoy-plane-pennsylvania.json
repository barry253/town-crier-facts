  "facts": [
    {
      "id": 1,
      "text": "Mahanoy Plane earned its name from the steep incline that hauled coal up Broad Mountain to the Reading Railroad’s main line.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wynninghistory.com/2026/05/13/photograph-shows-the-village-of-mahanoy-plane/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The incline opened on July 16, 1861, and at its peak moved 800 to 900 cars each day up a 524‑foot rise.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mahanoy_Plane",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a 1886 fire, the plane received 6,000‑horsepower engines that were once the most powerful in the world.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mahanoy_Plane",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mahanoy Plane closed on February 27, 1932, when the easier Mahanoy Tunnel route made the incline obsolete.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mahanoy_Plane",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historical marker erected in 2007 commemorates the plane’s role in Pennsylvania’s anthracite coal industry.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
