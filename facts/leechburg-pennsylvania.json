      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Leechburg Area Museum, housed in the historic David Leech home, showcases artifacts from the town’s industrial past.",
      "sourceSentenceIds": [
        2,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
