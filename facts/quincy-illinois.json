      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1860 debate between Lincoln and Douglas took place on Washington Park’s 1858 debate site, now commemorated by a museum.",
      "sourceSentenceIds": [
        11
