  "facts": [
    {
      "id": 1,
      "text": "John Flora and his family arrived by covered wagon in October 1827, founding the settlement that would become Flora.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofflora.org/flora-history/"
    },
    {
      "id": 2,
      "text": "The town was first called Fountain City because of Sarah Flora’s spring, then renamed Ino when another Fountain City existed, before settling on Flora.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofflora.org/flora-history/"
    },
    {
      "id": 3,
      "text": "In 1870 the Vandalia Railroad announced it would pass through the community, prompting the town to be formally planned and later called Flora Station.",
      "sourceSentenceIds": [
        8,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.townofflora.org/flora-history/"
    },
    {
      "id": 4,
      "text": "A post office opened in Flora in 1873, marking its growth as a recognized community.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flora%2C_Indiana"
    },
    {
      "id": 5,
      "text": "Flora hosts the Flora-Monroe Township Public Library, a free lending library serving the town’s residents.",
