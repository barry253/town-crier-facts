  "facts": [
    {
      "id": 1,
      "text": "Founded in 1872 by developer George Norris, Glenwood was originally called Spring Garden before becoming the lumber and citrus hub it is today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenwood_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When a post office opened in 1879, the community officially adopted the name Glenwood, cementing its identity for early settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenwood_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1880s, the Bond Lumber Company’s sawmill near the railroad employed most of Glenwood’s residents, driving rapid growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenwood_florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Glenwood gave birth to the Hamlin orange, a seedling found by Hamlin in an orchard that later became Florida’s most widely grown variety.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glenwood_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Glenwood African American Cemetery, founded in 1885, remains the only fully abandoned cemetery in Volusia County as of 2015.",
      "sourceSentenceIds": [
