  "facts": [
    {
      "id": 1,
      "text": "Named for Major Francis Langhorne Dade, who fell in 1835 during the Second Seminole War, Dadeville carries his legacy.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dadeville%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic district, anchored by the county courthouse, showcases charming Southern architecture amid thriving local businesses.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofdadevilleal.org/home-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Martin, just south of Dadeville, offers boating, fishing, and swimming for locals and visitors alike.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://cityofdadevilleal.org/living-visiting/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1838, Dadeville has served as Tallapoosa County’s seat, anchoring regional governance for over a century.",
      "sourceSentenceIds": [
        6,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://cityofdadevilleal.org/home-2/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alabama’s first medical school, the Graefenberg Institute, opened in Dadeville in 1852 but closed after the Civil War.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dadeville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1926 Martin Dam created Lake Martin, boosting Dadeville’s economy through tourism and water‑based recreation.",
