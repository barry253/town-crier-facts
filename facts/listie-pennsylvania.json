  "facts": [
    {
      "id": 1,
      "text": "Listie takes its name from Listie Tate, the daughter of Bedford County attorney Humphrey Tate, after a nearby mine chartered in 1892.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/listie_pennsylvania"
    },
    {
      "id": 2,
      "text": "The town sits atop Paleozoic sedimentary rocks, including sandstones, shales, and bituminous coal seams that shaped its mining history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/listie_pennsylvania"
    },
    {
      "id": 3,
      "text": "A humid continental climate gives Listie a 5.6‑month growing season, ideal for corn and hay production.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/listie_pennsylvania"
    },
    {
      "id": 4,
      "text": "A post office opened in Listie in 1892, marking its rise alongside regional coal mining.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/listie_pennsylvania"
    },
    {
      "id": 5,
      "text": "Listie rests at about 2,110 feet above sea level, overlooking the rolling Allegheny hills.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/listie_pennsylvania"
    },
    {
      "id": 6,
      "text": "The community lies roughly 3.7 miles east‑northeast of Somerset, the county seat.",
