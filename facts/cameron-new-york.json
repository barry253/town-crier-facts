  "facts": [
    {
      "id": 1,
      "text": "Cameron was named for Dugald Cameron, an early settler and land agent of the Pulteney Estate.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cameron%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The New York and Erie Railroad opened a line through Cameron in September 1850, linking the town to regional trade.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cameron%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Canisteo River winds through Cameron, with Route 119 running parallel and shaping the town’s landscape.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cameron%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cameron was formed from the Town of Addison in 1822, later losing land to the cities of Thurston and Rathbone.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cameron%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Middletown Historical Society preserves Cameron’s history and serves researchers for the town and surrounding communities.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofcameron.us/",
      "category": "other",
