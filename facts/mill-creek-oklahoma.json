  "facts": [
    {
      "id": 1,
      "text": "Mill Creek was first established in 1852 as Mineral Hill within the Choctaw Nation of Indian Territory.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town was renamed Harris Mill in 1859 after Chickasaw Governor Cyrus Harris built a large grist mill on the local creek.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Mill Creek became one of the largest shipping points for cattle in the region after the railroad arrived around 1901.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Mill Creek officially incorporated in Indian Territory in 1902 and became part of Oklahoma on November 16, 1907.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mill_Creek%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The main economic activity in Mill Creek today is the extraction of gravel and granite.",
