  "facts": [
    {
      "id": 1,
      "text": "Dennison’s railroad depot is a National Historic Landmark, sharing status with the Empire State Building and the White House.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/small-town-ohio-historic/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The depot houses a museum with wartime exhibits, a model train layout of Dennison’s busy years, and a Panhandle Theater film about the WWII canteen.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://compassohio.com/blog/dennison-railroad-in-ohio-a-railroad-town-with-a-lasting-legacy/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dennison was incorporated in 1873 and named after Governor William Dennison, a prominent Ohio figure.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dennison%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic Center Street brick buildings now host shops, restaurants, and services, preserving the daily life of boom and post‑industrial eras.",
      "sourceSentenceIds": [
        19,
