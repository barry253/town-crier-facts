    },
    {
      "id": 2,
      "text": "The original post office in Empire City was established in February 1921 and later discontinued in December 1934.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Empire_City%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Empire City experienced a rebound in the mid-1980s, although a post office was never reestablished in the town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Empire_City%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Every single resident of Empire City lives in a rural area rather than an urban setting.",
      "sourceSentenceIds": [
