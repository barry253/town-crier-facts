  "facts": [
    {
      "id": 1,
      "text": "South Gate incorporated January 20, 1923, and later earned the nickname Azalea City after adopting the azalea as its symbol in 1965.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Gate%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Between 1910 and 1940, agricultural land gave way to homes and factories, and by 1940 South Gate boasted over 35 factories producing chemicals, machinery, furniture, and roofing materials.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Gate%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Tweedy family promoted the area as fertile suburbia in the late 1800s, leading to roads like Tweedy Road by 1886.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/South_Gate,_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Factories quickly sprang up near the railroad tracks, and a post office and a few shops formed a serviceable downtown in early South Gate.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
