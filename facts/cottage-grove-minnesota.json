  "facts": [
    {
      "id": 1,
      "text": "Cottage Grove’s Historic Preservation Program began in 1981, guiding city officials and residents to protect over 400 historic buildings.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cottagegrovemn.gov/399/History",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Langdon Butter and Cheese Factory, founded in 1875, was one of Minnesota’s earliest creameries and still stands in Cottage Grove.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wchsmn.org/cottage-grove/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two homes—Furber House and Cordenio Severance House—are listed on the National Register of Historic Places, showcasing 19th‑century architecture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottage_Grove%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city sits on the north bank of the Mississippi River, just north of its confluence with the St. Croix.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cottage_Grove%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A rail line built by the Paul & Chicago Railroad in the late 19th century cut through Cottage Grove’s western township, linking Hastings to St. Paul.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wchsmn.org/cottage-grove/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "More than 400 historic sites have been cataloged, with 12 already on the National Register, reflecting Cottage Grove’s rich heritage.",
      "sourceSentenceIds": [
