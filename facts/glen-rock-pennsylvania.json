  "facts": [
    {
      "id": 1,
      "text": "Glen Rock was named in December 1843 by William Heathcote, inspired by lines from the poem Marmion.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Rock%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1838 the first passenger train arrived, establishing a station that would become the town’s transportation hub.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.glenrockpa.org/news-info-faq/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town once housed three furniture factories, three sewing factories, and two carriage makers, fueling early industrial growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.glenrockpa.org/news-info-faq/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Glen Rock’s historic band played along the East Coast for over a century, making music a town hallmark.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.glenrockpa.org/news-info-faq/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1972 Tropical Storm Agnes flood washed out bridges, leading to the railroad’s demise and a shift to a residential community.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.glenrockpa.org/news-info-faq/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A time capsule was dedicated at a 2020 car show, scheduled to open in 2060, preserving local history.",
