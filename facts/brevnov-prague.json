  "facts": [
    {
      "id": 1,
      "text": "Břevnov Monastery, founded in 993 by Boleslav II and Bishop Adalbert, is the first Benedictine friary in Bohemia.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prague.eu/en/objevujte/brevnov-monastery-brevnovsky-klaster/"
    },
    {
      "id": 2,
      "text": "The monastery’s Baroque gardens open daily and include the Vojtěška summer house, a chapel over the Brusnice Stream’s spring.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prague.eu/en/objevujte/brevnov-monastery-brevnovsky-klaster/"
    },
    {
      "id": 3,
      "text": "Inside the complex, the Theresian Hall commemorates Maria Theresa’s 1753 visit and showcases High Baroque architecture.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prague.eu/en/objevujte/brevnov-monastery-brevnovsky-klaster/"
    },
    {
      "id": 4,
      "text": "The monastery’s historic brewery, first mentioned in the 13th century, still brews Břevnovský Benedict beer for tasting on site.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://prague.eu/en/objevujte/brevnov-monastery-brevnovsky-klaster/"
    },
    {
      "id": 5,
      "text": "The Petřiny metro station on line A lies just west of Břevnov, connecting the district directly to central Prague.",
      "sourceSentenceIds": [
        8
      ],
