      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Stone House, built in 1765, is Washington, D.C.’s oldest standing building and a reminder of early colonial life.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
