      ],
      "source": "https://en.wikipedia.org/wiki/Georgetown_(Washington%2C_D.C.)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Georgetown University, founded by Father John Carroll in 1789, sits on a campus that includes the National Historic Landmark Healy Hall.",
      "sourceSentenceIds": [
        18,
