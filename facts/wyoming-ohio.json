  "facts": [
    {
      "id": 1,
      "text": "Wyoming was named after Wyoming County, Pennsylvania, where some settlers had come from.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyoming%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s historic Village District, listed on the National Register in 1986, contains over 300 buildings and showcases a unique architectural array.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wyominghistoricalsociety.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads reached Wyoming in 1851, turning the town into a rail hub that bordered Lockland and spurred industrial growth.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyoming%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Miami and Erie Canal, built nearby in 1828, added a vital waterway that connected Cincinnati to northern Ohio.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wyoming%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wyoming Historical Society, housed at 800 Oak Avenue, preserves the town’s heritage and operates the Wyoming History Museum.",
