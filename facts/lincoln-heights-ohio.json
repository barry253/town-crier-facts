  "facts": [
    {
      "id": 1,
      "text": "Lincoln Heights became the first majority‑African‑American, self‑governing municipality north of the Mason‑Dixon line when it incorporated in 1946.",
      "sourceSentenceIds": [
        13,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.theheightsmovement.org/history-of-lincoln-heights-1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before incorporation, residents fought for basic services; the area originally had no fire, police, streetlights, or paved roads.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_Heights%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s early 1920s roots trace back to developers creating a suburban enclave for black homeowners who were barred by redlining elsewhere.",
      "sourceSentenceIds": [
        19,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_Heights%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because no major factories ever settled inside its limits, Lincoln Heights never built an industrial tax base, keeping its economy largely residential.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_Heights%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1970s and 1980s factory closures cut the city’s tax revenue, making it hard to fund community programs.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln_Heights%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lincoln Heights is the birthplace of poet Nikki Giovanni, whose work has earned international acclaim.",
      "sourceSentenceIds": [
