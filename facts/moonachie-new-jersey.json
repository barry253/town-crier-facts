  "facts": [
    {
      "id": 1,
      "text": "Moonachie takes its name from the 1600s Iroquois chief Monaghie, who once watched the cedar forests here.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moonachie%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During WWII, five Moonachie boys lost their lives, and the borough later honored them by naming streets after each.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moonachie.us/197/About",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1947, Moonachie established its first ambulance corps and welcomed mobile homes, marking a postwar shift in community life.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moonachie.us/197/About",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1950s saw Moonachie flourish with new civic groups, including the Panoramic Civic Association and Girl Scout troops formed in 1957.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moonachie.us/197/About",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A century ago, 103 property owners were dispossessed, leaving homes abandoned and farms barren, reshaping the borough’s landscape.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moonachie.us/197/About",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Roads were upgraded, parks added, and the first municipal building opened on Moonachie Road in 1954, boosting local infrastructure.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moonachie.us/197/About",
      "category": "landmark",
      "quality": "good"
    }
