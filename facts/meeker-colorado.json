  "facts": [
    {
      "id": 1,
      "text": "Meeker takes its name from Nathan Meeker, the U.S. Indian Agent who was killed in the 1879 Meeker Incident.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meeker%2C_Colorado"
    },
    {
      "id": 2,
      "text": "The town was founded in 1883 after U.S. troops were removed from the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meeker%2C_Colorado"
    },
    {
      "id": 3,
      "text": "Theodore Roosevelt visited twice, in 1901 and 1905, staying at Hotel Meeker opposite the courthouse.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meeker%2C_Colorado"
    },
    {
      "id": 4,
      "text": "Meeker hosts the annual Meeker Classic Sheepdog trials, a nod to its ranching and hunting heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meeker%2C_Colorado"
    },
    {
      "id": 5,
      "text": "The White River Museum, just north of the courthouse, occupies original wooden structures from the Army garrison.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meeker%2C_Colorado"
    },
    {
      "id": 6,
      "text": "Meeker is the county seat of Rio Blanco County, the most populous municipality in that northwestern Colorado county.",
