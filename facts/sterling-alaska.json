    {
      "id": 2,
      "text": "Archaeologists have found Dena'ina house pits near Sterling, proving the area was inhabited over a thousand years ago.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sterling%2C_Alaska"
    },
    {
      "id": 3,
      "text": "The Cottonwood Creek Village Site near Sterling contains depressions used as dwellings and storage, with radiocarbon dates ranging from about 802 years before present to later prehistoric periods.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sterling_alaska"
    },
    {
      "id": 4,
      "text": "Early transportation routes, including river access, helped sustain settlement into the mid-20th century and beyond.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sterling_alaska"
    },
    {
      "id": 5,
      "text": "Sterling sits at the confluence of the Moose and Kenai Rivers on the western side of the Kenai Peninsula.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sterling_alaska"
    },
    {
