  "facts": [
    {
      "id": 1,
      "text": "Worthington was founded in 1803 by the Scioto Company, led by pioneer James Kilbourne, who later served in the U.S. House.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worthington%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Thomas Worthington, one of Ohio’s first senators and a future governor, after he helped locate the land.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worthington.org/82/History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers came from Connecticut’s Farmington River Valley, arriving in September 1803 and clearing the forest with laborers paid $12 a month.",
      "sourceSentenceIds": [
        12,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.worthington.org/82/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Worthington’s public library, established in the 1800s, is the first unionized library in central Ohio, now represented by the Ohio Federation of Teachers.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worthington%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Public transport is limited; the Central Ohio Transit Authority runs only bus line 102 along High Street.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worthington%2C_Ohio",
