  "facts": [
    {
      "id": 1,
      "text": "Watertown was founded in 1879 as a rail terminus when the Chicago & Northwestern Railroad reactivated part of a line it had constructed to Lake Kampeska.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_South_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Watertown was named after Watertown, New York, the hometown of brothers John E and their pioneering spirit.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_South_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "An earlier settlement, called Kampeska City, was abandoned in 1874 after grasshoppers destroyed the crops.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Watertown-South-Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Watertown sits on the Big Sioux River and two major lakes, Pelican Lake and Lake Kampeska.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_South_Dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Redlin Art Center in Watertown houses many of Terry Redlin’s wildlife paintings and a planetarium.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_South_Dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
