  "facts": [
    {
      "id": 1,
      "text": "McAllister, Montana, got its name in 1896 when the town was renamed after James Alexander McAllister Jr., a pioneer settler’s son.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128691",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "McAllister sits on U.S. Route 287, six miles north of Ennis, on the west side of Ennis Lake, an impoundment of the Madison River.",
      "sourceSentenceIds": [
        7,
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McAllister%2C_Montana",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "The town expanded by buying land from the Northern Pacific Railway’s Norris branch line, which became the site of McAllister.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128691",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the local school burned in the 1890s, James Jr. rallied community support to build a new one.",
      "sourceSentenceIds": [
        11,
