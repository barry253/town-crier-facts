  "facts": [
    {
      "id": 1,
      "text": "Folsom was founded in 1849 and locals say it’s “the place where the West came and stayed.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/folsom/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was renamed after Captain Joseph Libbey Folsom, a New Hampshire native honored by changing Granite City’s name.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.folsom.ca.us/residents/folsom-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Folsom’s Historic District houses the Folsom History Museum, where visitors explore gold mining, Native American heritage, and the railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.folsom.ca.us/residents/folsom-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Folsom Powerhouse, a National Historic Landmark, opened after harnessing river power to transmit electricity to Sacramento.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Folsom%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Johnny Cash’s Folsom State Prison, northwest of town, inspired the song “Folsom Prison Blues” and now draws music fans.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Folsom%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1893 Historic Truss Bridge and the 2014 Folsom Lake Crossing bridge showcase the city’s celebrated bridge architecture.",
