  "facts": [
    {
      "id": 1,
      "text": "Downsville was founded in 1848 and named after Charles Downs, the town’s first storekeeper who died in 1857.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wmspthistory.org/downsville"
    },
    {
      "id": 2,
      "text": "The village sprang up where the road from Sharpsburg to Williamsport meets the old Manor Road, now Downsville Pike.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wmspthistory.org/downsville"
    },
    {
      "id": 3,
      "text": "In 1913, a local Cornet band performed at a church picnic in Gus Izer's grove, a cherished community event.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wmspthistory.org/downsville"
    },
    {
      "id": 4,
      "text": "The 1895 Downsville School House still stands today, now serving as the home of the Downsville Ruritan Club.",
      "sourceSentenceIds": [
        23,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wmspthistory.org/downsville"
    },
    {
      "id": 5,
      "text": "Downsville lies southeast of Williamsport on Maryland Route 63 and Route 632, just southwest of Hagerstown.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downsville%2C_Maryland"
    },
    {
      "id": 6,
      "text": "The town sits on land once part of Lord Baltimore’s 10,000‑acre Manor of Conococheague, later owned by the Ringgold family.",
      "sourceSentenceIds": [
