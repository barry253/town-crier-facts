  "facts": [
    {
      "id": 1,
      "text": "Yavne sits atop Tel Yavne, a hill that preserves ruins from the Middle Bronze Age right through to the 12th‑century CE.",
      "sourceSentenceIds": [
        9,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yavne"
    },
    {
      "id": 2,
      "text": "During the Crusader era, the city was renamed Ibelin and a castle was erected there in 1141.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yavne"
    },
    {
      "id": 3,
      "text": "In the 1930s, planners proposed rebuilding the ancient Talmudic academy founded by Yochanan Ben Zakkai.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yavne"
    },
    {
      "id": 4,
      "text": "Yavne is famed for sparking Judaism’s rebirth after the Second Temple, guided by sages ben Zakkai and Gamaliel II.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yavne"
    },
    {
      "id": 5,
      "text": "The modern city of Yavne was founded in 1949 on the former village of Yibna, near the ancient ruins of Tel Yavne.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yavne"
    },
    {
      "id": 6,
      "text": "Archaeologists uncovered a 1,200‑year‑old gold coin and pottery kilns at Tel Yavne in 2019.",
      "sourceSentenceIds": [
