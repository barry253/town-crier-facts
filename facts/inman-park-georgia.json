    {
      "id": 1,
      "text": "Inman Park was Atlanta's first planned suburb, founded by Joel Hurt in the late 1880s as a streetcar suburb.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://atlantaandbeyond.com/atlanta-inman-park-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood was named after Samuel Inman, a friend of developer Joel Hurt.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/inman-park/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1973 Inman Park was officially listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/inman-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Krog Street Tunnel beneath CSX Railroad connects Inman Park with Cabbagetown and is famous for street art.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inman_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Asa Candler and Ernest Woodruff, Coca‑Cola magnates, once owned lots in Inman Park.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/inman-park/",
      "category": "people",
      "quality": "good"
    },
    {
