  "facts": [
    {
      "id": 1,
      "text": "Volcano Golf Course sits on the rim of the active Kīlauea crater, 4,000 feet above sea level.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.volcanogc.com/the-course/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "From the course, golfers enjoy panoramic views of Mauna Loa and Mauna Kea, the two tallest volcanoes in the world.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.volcanogc.com/the-course/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The course is bordered by endemic ‘ōhi‘a trees that bloom bright red and by nēnē, Hawaii’s state bird, nesting throughout the property.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.volcanogc.com/the-course/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Volcano Golf Course is part of the Kamehameha Schools network, which emphasizes sustainable stewardship of Hawaii’s natural lands.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.volcanogc.com/the-course/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The course operates from a temporary space, offering cold beverages and pre-packaged snacks during play.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.volcanogc.com/the-course/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Visitors are reminded not to feed or disturb nēnē, and to report any injured wildlife to the pro shop.",
