  "facts": [
    {
      "id": 1,
      "text": "Whyte Avenue takes its name from Sir William Whyte, the Canadian Pacific Railway superintendent who began leading the western division in 1886.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Whyte_Avenue",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The street was once the heart of the old city of Strathcona, serving as its main thoroughfare before the two cities merged.",
      "sourceSentenceIds": [
        3,
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Whyte_Avenue",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912 Edmonton and Strathcona joined, and the new city adopted a numbering system that left Whyte Avenue as both 82 Avenue and its historic name.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whyte_Avenue",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Whyte Avenue hosts more than 70 murals, graffiti walls, and street art pieces that give the district a vibrant, ever‑changing gallery.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelalberta.com/listings/whyte-avenue-11922",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The International Fringe Festival, one of Edmonton’s largest arts events, takes place each summer along Whyte Avenue and its side streets.",
