  "facts": [
    {
      "id": 1,
      "text": "Sutton, West Virginia, takes its name from founder John Sutton, who established the town in the early 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/communities/cities-towns/sutton-west-virginia/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was first settled where Granny's Creek joins the Elk River, a strategic spot for early settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton%2C_West_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sutton once functioned as a railroad hub, with the Sutton Branch connecting to the West Virginia and Pittsburgh Railroad.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton%2C_West_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In September 1861, Union troops occupied Sutton, and later General William Rosecrans bivouacked 10,000 soldiers there.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A suspension bridge was erected over the Elk River at Sutton in 1853, linking the Weston and Gauley Bridge Turnpike.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sutton%2C_West_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sutton Dam, completed in 1961, created a reservoir that added a tourism component to the local economy.",
      "sourceSentenceIds": [
        30
