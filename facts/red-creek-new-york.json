  "facts": [
    {
      "id": 1,
      "text": "Red Creek Historical Association, founded in 1972, preserves the town’s past and operates out of the 1880 Old Schoolhouse.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/22075",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The association restored the Old Schoolhouse and the Red Creek Village Hall, keeping key historic buildings alive for future generations.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/22075",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A research library and archives in the Old Schoolhouse hold photographs, documents, and artifacts that chronicle Red Creek’s history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/22075",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1700s, Native Mohicans enjoyed the same landscape that later became Red Creek, as noted in Hendrick Aupaumut’s 1791 account.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Hook%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Stockbridge‑Munsee Band of Mohicans considers Dutchess County, including Red Creek, an area of archaeological interest.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Hook%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Land patents granted after the War of Independence were bought by Gorham and Phelps, early settlers who helped shape Red Creek’s development.",
      "sourceSentenceIds": [
        5
