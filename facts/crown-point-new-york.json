  "facts": [
    {
      "id": 1,
      "text": "Crown Point sits on a peninsula at Lake Champlain’s southern end, once a strategic colonial military spot for French and British forces.",
      "sourceSentenceIds": [
        11,
        26,
        27,
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Point%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town’s name translates from French “Pointe à la Chevelure,” meaning “Hair Point,” reflecting early French explorers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Crown_Point%2C_New_York"
    },
    {
      "id": 3,
      "text": "Crown Point State Historic Site preserves ruins of Fort Saint‑Frédéric and Fort Crown Point, built during the French and Indian War.",
      "sourceSentenceIds": [
        1,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.ny.gov/visit/historic-sites/crown-point-state-historic-site"
    },
    {
      "id": 4,
      "text": "In 1759 the French abandoned Fort Saint‑Frédéric, then burned it to deny the British, a dramatic event still remembered at the site.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.ny.gov/visit/historic-sites/crown-point-state-historic-site"
    },
    {
      "id": 5,
      "text": "The historic site hosts living‑history reenactments, including the 1776 Crown Point Council of War where generals plotted defense against the Continental Army.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.ny.gov/visit/historic-sites/crown-point-state-historic-site"
    },
    {
      "id": 6,
      "text": "The Crown Point picnic pavilion, open May–October, offers a place to enjoy Lake Champlain views while learning about the area’s Revolutionary past.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.ny.gov/visit/historic-sites/crown-point-state-historic-site"
