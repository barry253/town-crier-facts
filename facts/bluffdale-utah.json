  "facts": [
    {
      "id": 1,
      "text": "Bluffdale first saw settlers in 1848–1849, led by Jens and Rise Madsen, when the area was still part of West Jordan.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluffdale%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first train rolled into Bluffdale in 1876, riding the narrow‑gauge railroad that linked the valley to the rest of Utah.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bluffdale.gov/407/History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bluffdale’s name reflects its landscape of bluffs and dales, a nod to the dramatic terrain that surrounds the city.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluffdale%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Seven irrigation canals, including the 1862‑started Utah–Salt Lake Canal, spring from the Jordan Narrows and water the Salt Lake Valley.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluffdale%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Perched at 4,436 feet, Bluffdale offers sweeping views of the Wasatch and Oquirrh Mountain Ranges.",
      "sourceSentenceIds": [
        24,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluffdale%2C_Utah",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bluffdale became an incorporated city in 1978 after growing from portions of Herriman, South Jordan, and Draper.",
