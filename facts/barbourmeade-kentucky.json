  "facts": [
    {
      "id": 1,
      "text": "Barbourmeade takes its name from early settlers Thomas and Richard Barbour, whose family home once sat on a 500‑acre tract along what is now Barbour Lane.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barbourmeade%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s elementary school honors WAVE founder George Norton Jr., whose leadership helped shape local education.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barbourmeade%2C_Kentucky",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A planned Louisville‑Interurban Railroad line in the early 1910s would have crossed Barbourmeade, but the project never materialized.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barbourmeade%2C_Kentucky",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "In 1941, Barbourmeade was noted for its fertile soil yet surprisingly inexperienced farmers, as wealthy hobbyists from Louisville settled there.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barbourmeade%2C_Kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A modest shopping center erected in 1966 on the Barbour Lane–Brownsboro corner still serves as the community’s commercial hub.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barbourmeade%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first liquor store opened in 1978 at the Barbour Lane intersection, its floor crafted from wood reclaimed from Fontaine Ferry Park’s roller‑skating rink.",
