    },
    {
      "id": 2,
      "text": "Nescopeck Creek runs west through Sybertsville, feeding the Susquehanna River about 30 miles downstream.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sybertsville_pennsylvania"
    },
    {
      "id": 3,
      "text": "The historic Brainerd Church, a brick Greek Revival building from 1853, stands as Sybertsville's architectural landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sybertsville_pennsylvania"
    },
    {
      "id": 4,
      "text": "Early settlers cleared land in 1818, establishing general stores and lumber operations that shaped the community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sybertsville_pennsylvania"
    },
    {
      "id": 5,
      "text": "The Jeddo Tunnel, built 1891, once drained mining waste and guided coal transport near Nescopeck Creek.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sybertsville_pennsylvania"
    },
    {
      "id": 6,
      "text": "Sybertsville lies just one mile northwest of Conyngham and six miles west-northwest of Hazleton, linking it to regional hubs.",
