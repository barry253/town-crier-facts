  "facts": [
    {
      "id": 1,
      "text": "Rosalia was founded in 1870 by T.J. Favorite, who named it after his wife.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosalia%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the rolling Palouse, a region famed for its fertile wheat fields and dramatic limestone bluffs.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosalia%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1858, Rosalia was the site of the Battle of Pine Creek, where U.S. troops clashed with several Native tribes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosalia%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rosalia proudly calls itself the “Gateway to the Palouse” and is the first stop on the north part of the Palouse Scenic Byway.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofrosalia.net/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The town’s library, a community hub, can be reached by calling 509‑523‑3109.",
