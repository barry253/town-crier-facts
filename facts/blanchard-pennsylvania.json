  "facts": [
    {
      "id": 1,
      "text": "Blanchard, a village in Liberty Township, is also known locally as Eagleville, the name used for its post office and station.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/libtwp1.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1845, Solomon Strong and Dr. Roberts laid out Eagleville in town lots, and a meeting house for the Society of Disciples was erected nearby.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/libtwp1.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first surveys of the area were conducted as early as July 1769, long before the township’s formal establishment.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/libtwp1.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tax assessment records for Liberty Township, including Blanchard, date back to 1847 and are housed in the basement of the Centre County Library and Historical Museum in Bellefonte.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centre.pagenweb.org/twpsboros/libtwp1.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Blanchard’s earliest settlers included John Marsden, Christian Bechdel, the Kunes, and the Gardners, who helped shape the community’s early character.",
      "sourceSentenceIds": [
        7
      ],
