  "facts": [
    {
      "id": 1,
      "text": "Lewis, Colorado, was named after an early merchant whose store hosted the town’s first post office on September 7, 1911, a key stop on the historic Old Spanish Trail.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewis_colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Lewis School, founded the same year as the store, became an early social hub with dances, linking the community to nearby ancient Puebloan sites.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewis_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lewis sits near the Mancos River valley, a tributary of the San Juan, shaping the area’s intermittent riparian zones amid the high desert.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewis_colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "About 20 miles south of Lewis lies Mesa Verde National Park, a UNESCO World Heritage site that draws visitors to the Montezuma County region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewis_colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town emerged in the late 19th century as ranchers moved into public domain lands opened after the 1880 Ute land cessions, sparking homesteading in 1882.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewis_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dry farming began north of Lewis in 1909–1910, proving wheat and beans could thrive on mesa tops and attracting veterans from Kansas, Oklahoma, and Texas.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lewis_colorado",
      "category": "history",
      "quality": "good"
