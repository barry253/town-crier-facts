  "facts": [
    {
      "id": 1,
      "text": "Tarina is a census‑designated place in Kern County, California, and it has no municipal government of its own.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://california.hometownlocator.com/ca/kern/tarina.cfm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Kern County observes Pacific Time, which is eight hours behind Coordinated Universal Time during standard time.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://california.hometownlocator.com/ca/kern/tarina.cfm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Because Tarina lacks a city government, county officials handle property taxes, building permits, and public record services.",
      "sourceSentenceIds": [
        13,
        20,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://californiaporch.com/places/tarina-cdp-ca/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Tarina is officially recognized as a community name by Kern County, even though it does not form a city.",
