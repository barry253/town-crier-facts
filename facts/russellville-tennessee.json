  "facts": [
    {
      "id": 1,
      "text": "Russellville was founded by George Russell in 1784 in the Appalachian foothills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "During the Civil War, Confederate Lt. Gen. James Longstreet set up headquarters at the Nenney House after the Battle of Bean's Station in December 1863.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "The Nenney House now serves as the General Longstreet Museum.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Russellville%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "Russellville became the county seat in 1887, a milestone marked by the 1917 train depot that still stands.",
      "sourceSentenceIds": [
        24,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverrussellville.org/historic-district/"
    },
    {
      "id": 5,
      "text": "The downtown historic district preserves the 1917 train depot and offers events, dining, and art walks.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://discoverrussellville.org/historic-district/"
    },
    {
      "id": 6,
      "text": "Russellville once hosted a bootleg whiskey production hub in the mid‑twentieth century.",
