  "facts": [
    {
      "id": 1,
      "text": "Clifford Township was created in 1806 from parts of Nicholson Township, which later became Lenox Township.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifford_Township%2C_Susquehanna_County%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The township takes its name from a Philadelphia gentleman named Clifford, who was expected to pay for the honor.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifford_Township%2C_Susquehanna_County%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Every third Sunday from May to October, the Historical Society hosts history‑packed church tours from 1 to 4 pm.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cliffordtownshiphistoricalsociety.org/places-to-visit/"
    },
    {
      "id": 4,
      "text": "The Agricultural Museum, a local heritage spot, sits on the Clifford Firemen’s Picnic Grounds at 1035 State Route 106.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cliffordtownshiphistoricalsociety.org/places-to-visit/"
    },
    {
      "id": 5,
      "text": "The Yarns Cider Mill, transferred to the Historical Society in 2018, is slated to produce cider again next year.",
      "sourceSentenceIds": [
        11,
