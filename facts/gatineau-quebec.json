  "facts": [
    {
      "id": 1,
      "text": "Philemon Wright founded Hull in 1800 at a portage around Chaudière Falls, just upstream from where the Gatineau and Rideau rivers meet the Ottawa.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gatineau"
    },
    {
      "id": 2,
      "text": "Originally called Wright's Town, the settlement was renamed Hull when it incorporated in 1875.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gatineau"
    },
    {
      "id": 3,
      "text": "In 2002, Hull merged into the larger City of Gatineau, creating the current municipal structure.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gatineau"
    },
    {
      "id": 4,
      "text": "The Canadian Museum of History, designed by Douglas Cardinal, draws over a million visitors each year and sits on Gatineau’s riverfront.",
      "sourceSentenceIds": [
        11,
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Gatineau"
    },
    {
      "id": 5,
      "text": "Gatineau lies on the northern bank of the Ottawa River, directly opposite Ottawa, Ontario.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gatineau"
    },
    {
