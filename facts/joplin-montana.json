  "facts": [
    {
      "id": 1,
      "text": "Joplin was founded in 1910 by Lebanese immigrant Joseph E., who helped establish the town’s early community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joplin%2C_Montana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began as a Great Northern Railway section house in 1909, evolving into a full station by 1910.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/joplin_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The depot became Joplin’s central landmark, complete with a sign proclaiming it the “Biggest Little Town on Earth.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/joplin_montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Joplin’s economy centers on farming and ranching, highlighted by grain elevators, a Lutheran church, a bar, and a community hall that hosts an annual antique car show.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/joplin_montana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the Great Northern merged into Burlington Northern in 1970, Joplin became a minor freight stop, mainly for grain shipments.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
