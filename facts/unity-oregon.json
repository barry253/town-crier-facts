    {
      "id": 1,
      "text": "Unity is a city in Baker County, Oregon, located within the Burnt River Valley.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unity%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Early pioneers settled Unity during the 1860s, drawn by gold mining, timber logging, and cattle ranching.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/unity_oregon"
    },
    {
      "id": 3,
      "text": "The name Unity reflects a spirit of community cooperation and an amicable agreement among early settlers to relocate the local post office.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/unity_oregon"
    },
    {
      "id": 4,
      "text": "The Unity Ranger Station was built by the Civilian Conservation Corps in 1936 and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Unity%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Mail once reached Unity by stage from the Sumpter Valley Railroad, providing a vital link for isolated ranchers and miners.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/unity_oregon"
    },
    {
