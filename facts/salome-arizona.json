  "facts": [
    {
      "id": 1,
      "text": "Salome was founded in 1904 by Dick Wick Hall, Ernest Hall and Charles Pratt, named after Pratt's wife Grace Salome Pratt.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salome%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned a reputation as a “marriage mill” because Arizona had no waiting period, attracting couples and boosting local businesses.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Salome,_Arizona",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Salome’s historic Dick Wick Hall building, once a dance hall, still stands as a local landmark.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/arizona_salome",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community began as a railroad stop and now serves as a gateway to Kofa National Wildlife Refuge, home to bighorn sheep.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/arizona_salome",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Salome sits in the Sonoran Desert transition zone, where Colorado River Valley influences make the climate especially arid and hot.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Salome,_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Route 60 runs through Salome, linking it east to Wickenburg and west to Interstate 10 between Brenda and Quartzsite.",
