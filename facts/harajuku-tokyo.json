    },
    {
      "id": 2,
      "text": "Harajuku’s name means 'meadow lodging,' reflecting its history as a post town on Edo’s travel routes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
