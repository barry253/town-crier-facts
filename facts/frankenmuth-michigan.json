    {
      "id": 1,
      "text": "Frankenmuth was founded in 1845 by 15 German Lutheran settlers led by Reverend August Craemer, who came from Neuendettelsau to evangelize Native Americans.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
