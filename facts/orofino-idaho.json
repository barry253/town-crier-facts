      ],
      "source": "https://cityoforofino.org/city-of-orofino-home/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just four miles north of Orofino stands Dworshak Dam, the third‑highest dam in the U.S., finished in the 1970s.",
