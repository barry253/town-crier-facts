    },
    {
      "id": 2,
      "text": "In 1899, a railroad line from Lewiston reached Orofino, linking the town to the wider region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orofino%2C_Idaho"
    },
    {
      "id": 3,
      "text": "Orofino boasts a rich history of logging and mining that shaped its early economy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityoforofino.org/city-of-orofino-home/"
    },
    {
      "id": 4,
      "text": "Just four miles north of Orofino stands Dworshak Dam, the third‑highest dam in the U.S., finished in the 1970s.",
      "sourceSentenceIds": [
