      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Collins Axe Company, founded by Samuel W. Collins, turned Collinsville into a 19th‑century industrial powerhouse and now houses the Canton Historical Museum.",
      "sourceSentenceIds": [
