  "facts": [
    {
      "id": 1,
      "text": "Maidens earned its name when the Chesapeake and Ohio Railway christened its local station 'Maidens'.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maidens%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled on the north bank of the James River, Maidens lies roughly 20 miles west of Richmond.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/maidens_virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The James River and Kanawha Canal, which opened in 1840, ran through Maidens, linking the James River to the Ohio River.",
      "sourceSentenceIds": [
        15,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/11678972",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The canal was meant to connect Chesapeake Bay to the Gulf of Mexico via the Ohio River, but the Civil War halted its completion.",
      "sourceSentenceIds": [
        16,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/11678972",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Maidens hosts the Mount Bernard Complex and Tanglewood, both listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maidens%2C_Virginia",
