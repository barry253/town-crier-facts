      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood sits along the Santa Clara River between the Sierra Pelona and San Gabriel Mountains, placing it inside the Angeles National Forest boundaries.",
      "sourceSentenceIds": [
        16,
        27,
        28
      ],
      "sourceLabels": [
