      "id": 1,
      "text": "Canyon Country was originally called Solemint before adopting its current name in 1968 by popular vote.",
      "sourceSentenceIds": [
        5,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
