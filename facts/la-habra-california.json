      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1908, the Pacific Electric Railroad line was completed through La Habra, hauling citrus and walnuts across the valley.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Web source 1",
