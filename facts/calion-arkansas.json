  "facts": [
    {
      "id": 1,
      "text": "Calion got its name by combining the first three letters of Calhoun County with the last three of Union County.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calion%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 19th century, the town began as El Dorado Landing, a steamboat hub that faded when railroads took over river traffic.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calion_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thomas sawmill opened in 1916, quickly becoming Calion's main employer and driving the town's rapid growth around the lock and dam.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calion_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ouachita River Lock and Dam Number Eight, finished in 1916 by the U.S. Army Corps of Engineers, anchored Calion's development.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Calion%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Great Flood of 1927 swept the Ouachita River valley near Calion, flooding the town and disrupting its river‑dependent economy.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/calion_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Calion sits in a low‑lying, timber‑rich floodplain that makes it especially vulnerable to Ouachita River overflows.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
