  "facts": [
    {
      "id": 1,
      "text": "Clinton was named after New York Governor De Witt Clinton, a prominent 19th‑century leader who helped build the Erie Canal.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Clinton,_Louisiana"
    },
    {
      "id": 2,
      "text": "Founded in 1824 on land near Pretty Creek, Clinton became the seat of the newly split East Feliciana Parish, replacing Jackson.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Clinton,_Louisiana"
    },
    {
      "id": 3,
      "text": "By the mid‑1830s, the Clinton and Port Hudson Railroad turned the town into a bustling legal and cotton‑trading hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Clinton,_Louisiana"
    },
    {
      "id": 4,
      "text": "The 1840s‑era Historic Courthouse on St. Helena Street remains Louisiana’s oldest continuously used parish courthouse.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Clinton,_Louisiana"
    },
    {
      "id": 5,
      "text": "Clinton has hosted several films, including The Dukes of Hazzard (2005) and The Free State of Jones (2016).",
      "sourceSentenceIds": [
        13,
        16,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Clinton%2C_Louisiana"
    },
    {
      "id": 6,
      "text": "The town’s streets showcase antebellum and Victorian homes, reflecting its 19th‑century prosperity.",
