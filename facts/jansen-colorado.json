  "facts": [
    {
      "id": 1,
      "text": "Jansen sits in the Purgatoire River valley of western Las Animas County, Colorado.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jansen%2C_Colorado",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town’s name changed to Jansen in 1902 when its post office opened, though the origin of the name remains unclear.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jansen_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jansen’s early history traces back to the Santa Fe Trail, where Hispanic settlers called it Chimayoses before becoming a mining hub.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jansen_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Allen Coal Mine, later New Elk Mine, operated from 1951 until 1982, producing over 26 million tons of coal for Pueblo steelworks.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jansen_colorado",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After a brief reopening by Cline Mining in 2010, the mine shut again in 2012 when coking coal prices fell, leading to bankruptcy in 2014.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jansen_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2021 Allegiance Coal resumed underground mining, but operations halted abruptly in May 2023, leaving 80‑100 workers unemployed.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
