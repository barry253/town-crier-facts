  "facts": [
    {
      "id": 1,
      "text": "D'Iberville takes its name from French explorer Pierre Le Moyne d'Iberville, who first landed on the Gulf Coast in 1699.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/D'Iberville%2C_Mississippi"
    },
    {
      "id": 2,
      "text": "The city sits on the Back Bay, just north of Biloxi, across the waterway that once hosted the first European fort, Fort Maurepas.",
      "sourceSentenceIds": [
        10,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/D'Iberville%2C_Mississippi"
    },
    {
      "id": 3,
      "text": "D'Iberville officially became a city in 1988, after years of growth as a community of resilient families.",
      "sourceSentenceIds": [
        12,
        8,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/D'Iberville%2C_Mississippi"
    },
    {
      "id": 4,
      "text": "The Back Bay area that now hosts D'Iberville was originally settled by families who still live there today.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://diberville.ms.us/"
    },
    {
      "id": 5,
      "text": "D'Iberville is part of the Gulfport–Biloxi metropolitan area, linking it to a larger regional economy.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/D'Iberville%2C_Mississippi"
    },
    {
      "id": 6,
      "text": "The city’s coordinates place it at 30°26′13″N 88°53′51″W, right on the Gulf Coast.",
