  "facts": [
    {
      "id": 1,
      "text": "Bloorcourt Village, once dubbed Toronto's worst bar neighborhood, has flipped into a creative hub crowned by Civil Liberties, named Canada’s best bar in 2022 and 2023.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloorcourt_village",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the 1910s, Bloor Street became a lively corridor of shops and homes, thanks to streetcar access that linked workers to Massey‑Harris factories.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloorcourt_village",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The McGiffen Bloor‑Gladstone Library opened October 25, 1913 as Canada’s largest branch then, the first Toronto library built entirely with municipal funds.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloorcourt_village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bloorcourt Village stretches from Dufferin Street in the west to Montrose Avenue near Crawford in the east, forming a tight business corridor.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bloorcourt_village",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Located west of downtown Toronto, Bloorcourt Village sits within the historic boundaries of the former City of Toronto before 1998 amalgamation.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloorcourt_Village",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Today, the area balances affordability with cultural vibrancy, drawing young professionals, artists, and families through walkable streets, great transit, and microgrants for local businesses.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
