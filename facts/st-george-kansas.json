      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "St. George, Kansas gained a rail link in 1866 when the Kansas Pacific Railroad—now Union Pacific—passed through the town.",
      "sourceSentenceIds": [
