      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Its layout emphasizes walkability, featuring interconnected trails and landscaped boulevards that make strolling a daily pleasure.",
      "sourceSentenceIds": [
