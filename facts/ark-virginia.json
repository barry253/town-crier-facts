  "facts": [
    {
      "id": 1,
      "text": "Ark was named for Henry Stuart, Duke of Gloucester, the third son of King Charles I, a nod to Virginia’s colonial heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ark_virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ark lies roughly three miles west‑northwest of Gloucester Courthouse, reached by Route 17 and State Route 14.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ark_virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The area enjoys a humid subtropical climate, averaging 60 °F year‑round, with about 47 inches of rain and frequent summer thunderstorms.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ark_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the mid‑17th century, settlers in Ark received tobacco land grants under the headright system, fueling Virginia’s Tidewater economy.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ark_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1865 emancipation, Ark’s plantation system collapsed, prompting formerly enslaved workers to seek land ownership and independence.",
