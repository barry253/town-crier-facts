  "facts": [
    {
      "id": 1,
      "text": "Jumeirah’s Palm Jumeirah is an artificial archipelago shaped like a palm tree when viewed from above.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palm_Jumeirah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island was engineered to mimic a palm tree, divided into a trunk, fronds, and an outer crescent.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palm_Jumeirah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The trunk hosts mixed commercial and residential spaces, the fronds are for villas, and the crescent shelters luxury resorts.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palm_Jumeirah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dutch dredging firm Van Oord built the island, also responsible for the nearby World Islands.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palm_Jumeirah",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Construction began in June 2001, with the first residential units handed over in 2006 and 75% ready by October 2007.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palm_Jumeirah",
      "category": "history",
      "quality": "good"
    },
    {
