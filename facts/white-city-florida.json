  "facts": [
    {
      "id": 1,
      "text": "They purchased land from railroad magnate Henry Flagler, naming their settlement White City after the famous Chicago World Fair.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/white-city-florida-ghost-town/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Louis Pio, a Danish promoter from Chicago, led settlers to buy land from Henry Flagler to create a Danish community in Florida.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/white-city-florida-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "You’ll find Pio’s influence in the town’s design, with Midway Road named after the World’s Fair’s main avenue.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/white-city-florida-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Though a devastating land scheme by Colonel Myers and the Great Freeze of 1894‑1895 challenged early settlers, their resilience shaped this historic community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/white-city-florida-ghost-town/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Despite the exodus, some historic structures like the Captain Hammond House and White City Marketplace remain as testament to settlement’s past.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/white-city-florida-ghost-town/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The settlers’ commitment to Danish identity and cultural preservation took shape through the White City Improvement Club, founded 1894.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/white-city-florida-ghost-town/"
    }
  ]
