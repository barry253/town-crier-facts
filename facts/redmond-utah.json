    },
    {
      "id": 2,
      "text": "Mormon pioneers settled Redmond in 1875 to develop irrigable lands along the Sevier River Valley following the Black Hawk War.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redmond_utah"
    },
    {
      "id": 3,
      "text": "The Redmond Town Hall was built in 1881 using adobe and rock to serve as a school, church, and community center.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redmond_utah"
    },
    {
      "id": 4,
      "text": "Pink rock salt is mined near Redmond and sold as Real Salt, extracted from an ancient Jurassic Period sea deposit.",
      "sourceSentenceIds": [
        19,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
