    },
    {
      "id": 2,
      "text": "Long before Europeans arrived, La Tierra lay within the traditional lands of Tewa-speaking peoples, a Tanoan subgroup.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_tierra_new_mexico"
    },
    {
      "id": 3,
      "text": "The community lies at an elevation of 6,677 feet (2,035 meters) above sea level.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_tierra_new_mexico"
    },
    {
      "id": 4,
      "text": "La Tierra hosts a 25‑mile trail network managed by the Santa Fe Conservation Trust, offering hiking, biking, and equestrian paths through piñon‑juniper woodlands.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_tierra_new_mexico"
    },
    {
      "id": 5,
      "text": "La Tierra’s semi‑arid climate, shaped by high elevation, averages 13 inches of rain and snow each year, mostly from summer monsoons.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/la_tierra_new_mexico"
    },
    {
