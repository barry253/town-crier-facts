      "id": 1,
      "text": "After New Mexico's Spanish colony formed, La Tierra’s Pojoaque Valley joined colonial settlement patterns centered on Santa Fe, founded in 1610.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
