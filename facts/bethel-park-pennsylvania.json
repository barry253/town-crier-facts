      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Montour Railroad tracks have been transformed into a scenic trail that is part of the Great Allegheny Passage, running all the way to Washington D.C.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bethelparkpa.gov/community/destinations",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bethel Park Historical Society has raised more than $1.2 million over eight years to renovate the Schoolhouse Arts & History Center, a volunteer‑run effort.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
