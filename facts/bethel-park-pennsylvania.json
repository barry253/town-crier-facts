      "id": 1,
      "text": "Bethel Park takes its name from Bethel Presbyterian Church, which in turn was named after the ancient Israelite sanctuary of Bethel.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
