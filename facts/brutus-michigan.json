  "facts": [
    {
      "id": 1,
      "text": "Brutus was founded in 1874 when Abner Lee built the Brutus House inn on the Old Stagecoach Road, naming the town after his New York hometown.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/brutus_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first post office opened the same year, with Lee as postmaster, making Brutus the first Emmet County post office not on Lake Michigan.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brutus_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1882 the Grand Rapids & Indiana Railroad reached Brutus, prompting the town to relocate eastward to sit beside the new station.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brutus_michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Logging boom in the 1880s brought lumber mills, stores, and churches, turning Brutus into a bustling rural hub by the late 19th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brutus_michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2024 the historic Maple River Dam was removed, restoring the river’s natural flow and opening new recreational opportunities for residents.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
