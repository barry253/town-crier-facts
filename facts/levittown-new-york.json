  "facts": [
    {
      "id": 1,
      "text": "Levittown was officially named on January 1, 1948, marking the birth of America’s first mass‑produced suburban community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Levittown%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew from four distinct developments: Green Acres, Levitt, Omega, and Miller, together housing over 18,000 homes by the early 1950s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Levittown’s original houses were built on concrete slabs using pre‑cut lumber shipped from Levitt & Sons’ own California factories.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Levittown%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Little Red Schoolhouse, built in 1876, still stands as a reminder of the area’s pre‑suburban roots.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Billy Joel, the famed singer‑songwriter, grew up in a Levitt‑built house in nearby Hicksville, a testament to the town’s influence on American music.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Levittown%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1985, a historic landmark was designated on Old Jerusalem Road, just across from MacArthur High School, preserving a piece of Levittown’s early history.",
      "sourceSentenceIds": [
        6
      ],
