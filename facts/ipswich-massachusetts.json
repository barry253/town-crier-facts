  "facts": [
    {
      "id": 1,
      "text": "Ipswich earned the nickname “Birthplace of American Independence” after residents resisted taxation without representation in 1687.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicipswich.net/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bull Brook archaeological site in Ipswich holds evidence of human habitation dating back 9,000 to 11,000 years, making it one of New England’s oldest.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ipswich%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1634 by John Winthrop the Younger, Ipswich is one of the earliest English settlements on the Massachusetts North Shore.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ipswich%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ipswich’s historic houses include the 17th‑century Whipple House, one of the town’s most preserved colonial homes.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicipswich.net/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s coastline features Crane Beach, a barrier beach that attracts visitors for its dunes and historic Crane estate.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ipswich%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1828, the Ipswich Female Seminary opened, becoming one of the first institutions dedicated to women’s higher education in the United States.",
