  "facts": [
    {
      "id": 1,
      "text": "Shelby, Michigan began as a frontier settlement in the 1860s, with a rough building serving as both hotel and post office by 1864.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-shelby-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago & West Michigan Railroad arrived in 1870, turning Shelby into a rail hub that brought farmers’ crops and new residents to the area.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-shelby-michigan/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1900, the Field family owned an orchard of 45,000 fruit trees, making Shelby a notable fruit‑belt town in Michigan.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michigan4you.com/history-of-shelby-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Shelby’s early history includes the lost villages of Disco and Prestonville, before the township was named for a Revolutionary War hero from Kentucky.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shelbytwp.org/our-township/resident-information/shelby-township-history",
      "category": "history",
      "quality": "good"
    },
    {
