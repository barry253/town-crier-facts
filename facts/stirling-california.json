  "facts": [
    {
      "id": 1,
      "text": "Stirling City got its name from a boiler made by the Stirling Boiler Company, chosen by Diamond Match official Fred Clough.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town began in 1903 when the Diamond Match Company of Barberton, Ohio, opened a lumber processing center in the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling_City%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A loop of the Southern Pacific Railroad, built to haul lumber from Lassen National Forest, circles Stirling City’s historic core.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling_City%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Stirling City Historical Society museum now occupies the 1930s U.S. Forest Service fire station, preserving the town’s logging heritage.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.explorebuttecounty.com/places/stirling-city-historical-society",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 1976, the society relies on dedicated volunteers to keep Stirling City’s rich history alive for future generations.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/3142",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Inside the museum, artifacts and exhibits chronicle Stirling City’s journey from a lumber camp to a quiet mountain community.",
      "sourceSentenceIds": [
        2
      ],
