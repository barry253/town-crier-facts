  "facts": [
    {
      "id": 1,
      "text": "Ehrenberg was founded by Herman Ehrenberg and originally called Mineral City before adopting its current name in 1866.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ehrenberg%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a steamboat landing on the Colorado River, making it a key river port before railroads bypassed it.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ehrenberg%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Colorado River Historical Society Museum in Ehrenberg preserves artifacts and offers digital archives through the Arizona Memory Project.",
      "sourceSentenceIds": [
        2,
