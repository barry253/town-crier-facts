  "facts": [
    {
      "id": 1,
      "text": "Centerville’s historic district, a classic “pike town,” stretches 3,300 feet along the old National Road, showcasing early 19th‑century travel culture.",
      "sourceSentenceIds": [
        17,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Washington_County/Centerville_Borough/Centerville_Historic_District.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1920 John Williams Service Station at 968 Old National Pike stands out with its Spanish Revival roof that mimics red terra‑cotta tiles.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Washington_County/Centerville_Borough/Centerville_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Centerville’s Rogers Tavern, once a bustling inn, now sports aluminum siding but still holds its historic charm from the early 1900s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Washington_County/Centerville_Borough/Centerville_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Most buildings in Centerville front directly onto the National Road, reflecting the town’s origins as a roadside service hub.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Washington_County/Centerville_Borough/Centerville_Historic_District.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Centerville’s historic district earned a spot on the National Register of Historic Places, thanks to its well‑preserved Federal and Greek Revival homes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thenewpittsburghexposition.org/directory-content/centerville-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s layout mirrors the typical early gas station design, with a small square building connected to a canopied pump area along the National Road.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.livingplaces.com/PA/Washington_County/Centerville_Borough/Centerville_Historic_District.html",
      "category": "landmark",
      "quality": "good"
    }
