  "facts": [
    {
      "id": 1,
      "text": "Woodbury Heights was officially formed as a borough on April 6, 1915 after a local referendum on April 27, 1915.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodbury_Heights%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from nearby Woodbury, which was itself named for founder Henry Wood who arrived from England in 1683.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodbury_Heights%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1925, Woodbury Heights exchanged land with Woodbury, and in 1938 annexed more territory from the city.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodbury_Heights%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Glen Lake, once a popular swimming spot, now offers fishing and non‑motorized boating for residents and visitors.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodbury_Heights%2C_New_Jersey",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woodbury Heights borders Deptford Township, West Deptford Township, and Woodbury within Gloucester County.",
