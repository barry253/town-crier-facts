  "facts": [
    {
      "id": 1,
      "text": "Steele Creek sits where Steele Creek meets the Fortymile River inside the National Wild and Scenic River corridor.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/programs/cultural-resources/archaeology/alaska/steele-creek",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original roadhouse began as a one‑room log cabin built in 1898 and grew into a two‑story log building by 1911.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/programs/cultural-resources/archaeology/alaska/steele-creek",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In its heyday, Steele Creek supplied travelers on the overland trail between Eagle on the Yukon and Chicken in the Fortymile drainage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/programs/cultural-resources/archaeology/alaska/steele-creek",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The roadhouse is the only historic two‑story log building left in the Fortymile drainage and one of the oldest in interior Alaska.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.blm.gov/programs/cultural-resources/archaeology/alaska/steele-creek",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2002, the BLM and volunteers have stabilized Steele Creek’s buildings, protecting them for future visitors.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.blm.gov/blog/2021-03-18/steele-creek-history-heart-alaskas-fortymile-region",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Three cabins and the roadhouse still stand at the site, while historic photos show additional tents and garden fields that once dotted the area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.blm.gov/blog/2021-03-18/steele-creek-history-heart-alaskas-fortymile-region"
    }
