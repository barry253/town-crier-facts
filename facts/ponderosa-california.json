      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming a community, the land served as a sheep pasture owned by Alex Kramer, who moved his flock to the mountains in 1925.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
