  "facts": [
    {
      "id": 1,
      "text": "Canóvanas takes its name from the Taíno chief Canobaná, whose legacy lives in the town’s very identity.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boricua.com/discovering-canovanas-a-vibrant-blend-of-history-culture-and-nature/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1970, Canóvanas broke away from Loíza to become its own municipality, marking a new chapter.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boricua.com/discovering-canovanas-a-vibrant-blend-of-history-culture-and-nature/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hipódromo Camarero, once called El Nuevo Comandante, remains Puerto Rico’s only horse‑racing track.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boricua.com/discovering-canovanas-a-vibrant-blend-of-history-culture-and-nature/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Villarán Bridge, built in 1892, showcases a rare Eiffel pony‑truss design and now serves pedestrians.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://boricua.com/discovering-canovanas-a-vibrant-blend-of-history-culture-and-nature/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Canóvanas’s downtown sits along historic PR‑3, once the main artery between San Juan and Fajardo.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Can%C3%B3vanas%2C_Puerto_Rico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s coat of arms features a broken chain for its split from Loíza, a crown for Cacique Canobaná, and laurels celebrating 23 straight basketball wins.",
      "sourceSentenceIds": [
        13
      ],
