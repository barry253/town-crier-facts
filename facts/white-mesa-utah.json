  "facts": [
    {
      "id": 1,
      "text": "Ute tradition says the people of White Mesa came to the Four Corners region when the god Tav-woats released them from a sack.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://utahindians.org/archives/whiteMesa.html"
    },
    {
      "id": 2,
      "text": "The people of White Mesa descend from the Weenuche band of Southern Utes, who traditionally moved with the seasons to harvest plants.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://utahindians.org/archives/whiteMesa.html"
    },
    {
      "id": 3,
      "text": "White Mesa Utes are well known for their skills in basketry and weaving, as well as their expertise in horsemanship and hunting.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://utahindians.org/archives/whiteMesa.html"
    },
    {
      "id": 4,
      "text": "The Bear Dance in White Mesa facilitates socializing and courtship and was historically used to plan hunting and gathering for the year.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://utahindians.org/archives/whiteMesa.html"
    },
    {
      "id": 5,
      "text": "White Mesa operates as a branch of the Ute Mountain Ute tribe and is governed by a seven-member board.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://utahindians.org/archives/whiteMesa.html"
    },
    {
      "id": 6,
      "text": "The current settlement of White Mesa began in the 1950s when the Utes built houses on tribal land south of Blanding.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://utahindians.org/archives/whiteMesa.html"
    }
  ]
}
