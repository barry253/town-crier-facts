  "facts": [
    {
      "id": 1,
      "text": "McCutchenville was laid out in 1829, named after Joseph McCutchen, the original owner of the town site.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has operated in McCutchenville since 1833, serving the community for nearly two centuries.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The McCutchen Overland Inn, built in 1829, once served as a stagecoach stop on the Harrison Trail.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1964, the Wyandot County Historical Society purchased the old Inn and restored it to its stagecoach days, now a museum.",
      "sourceSentenceIds": [
        4,
        5,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McCutchenville sits at the crossroads of State Routes 53 and 587, a historic junction that still defines its layout.",
      "sourceSentenceIds": [
        7,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McCutchenville%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Only two original stagecoach inns remain in Ohio, and McCutchenville’s restored Inn is one of them.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
