  "facts": [
    {
      "id": 1,
      "text": "Millwood was originally called Woodard, named after a Kansas family that settled there in 1882.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/23278",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1903, Seth Woodard gave the railroad right‑of‑way across his land, prompting the construction of Woodard Station.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/23278",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A compromise with the Woodard family led to the town’s renaming to Millwood, combining “mill” with the first four letters of Woodard.",
      "sourceSentenceIds": [
        5,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/23278",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic district, centered around the original paper mill, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millwood%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On Veterans Day 1920, a new county bridge over the Spokane River was dedicated as the Argonne Bridge in honor of local soldiers who died in France.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/23278",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1912, Millwood boasted a restaurant, lumber yard, general store, barbershop, hotel, school, and cement factory, reflecting its early growth.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historylink.org/File/23278",
      "category": "history",
      "quality": "good"
    }
