  "facts": [
    {
      "id": 1,
      "text": "Ceiba was named after the ceiba tree, a sacred symbol in Taíno culture that once dominated the island's landscape.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.trawellino.com/destinations/puerto-rico/ceiba_ceiba",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The municipality extends northwest into the seas between Fajardo and Culebra, including the reefs and islets Arrecifes Hermanos and Arrecifes Barriles.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ceiba%2C_Puerto_Rico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ceiba became an independent municipality on May 12, 1838, separating from Fajardo after a petition led by Luis de la Cruz.",
      "sourceSentenceIds": [
        5,
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ceiba%2C_Puerto_Rico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roosevelt Roads Naval Station, one of the Caribbean's largest bases, was established in Ceiba in 1943 and closed in 2004.",
      "sourceSentenceIds": [
        19,
        21,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.kupi.com/en-ae/explore/puerto-rico/ceiba/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ceiba's historic center, known as Pueblo, reflects a dual heritage of traditional Puerto Rican town life and former military influence.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en-ae/explore/puerto-rico/ceiba/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ceiba State Forest and Ensenada Honda Medio Mundo Beach offer coastal ecosystems that were once part of the island's natural riches.",
