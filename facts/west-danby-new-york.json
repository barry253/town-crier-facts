  "facts": [
    {
      "id": 1,
      "text": "West Danby was first settled in 1795 by two families from Kingston, NY, after losing land claims in Ithaca.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danby.ny.gov/ova_dep/historian/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town of Danby was incorporated on February 22, 1811, as part of the Watkins and Flint land purchase.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danby.ny.gov/ova_dep/historian/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A town historian, appointed by the council, preserves local records and deepens community understanding of West Danby's past.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danby.ny.gov/ova_dep/historian/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Before European settlers, Iroquoian and Algonquian peoples inhabited the area that became Danby as far back as the 12th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danby.ny.gov/ova_dep/historian/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Danby sits on the west side of Cayuga Inlet’s deep valley, which flows north into Cayuga Lake at Ithaca.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://danby.ny.gov/ova_dep/historian/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "New York State Routes 34 and 96 run together through West Danby’s center, linking it 10 miles north to Ithaca and 8 miles south to Spencer.",
