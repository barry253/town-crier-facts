  "facts": [
    {
      "id": 1,
      "text": "Indigenous tribes historically used the area around Chugcreek for hunting bison and as part of migration routes across the Great Plains.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chugcreek_wyoming"
    },
    {
      "id": 2,
      "text": "Chugcreek sits at an elevation of 4,760 feet above sea level on the High Plains of the Wyoming Basin ecoregion.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chugcreek_wyoming"
    },
    {
      "id": 3,
      "text": "The landscape around Chugcreek is framed by the Laramie Mountains to the west and the distant Black Hills to the east.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chugcreek_wyoming"
    },
    {
      "id": 4,
      "text": "Chugcreek lies within the North Platte River basin, near the Laramie River and the flowing waters of Chugwater Creek.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chugcreek_wyoming"
    },
    {
      "id": 5,
      "text": "A cold semi-arid climate in Chugcreek brings cold winters, warm summers, and annual precipitation that mostly falls as summer thunderstorms.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chugcreek_wyoming"
    },
    {
      "id": 6,
      "text": "The sagebrush steppe ecosystem surrounding Chugcreek sustains key wildlife species, including mule deer and pronghorn antelope.",
