  "facts": [
    {
      "id": 1,
      "text": "Sudlersville grew from a 1740 land purchase by Joseph Sudler, whose homestead Sledmore dates to 1713.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.qacchamber.com/sudlersville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was first called Sudler's Cross Roads, with a tavern and post office by 1811, and renamed Sudlersville in 1839.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.qacchamber.com/sudlersville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Andrew's Episcopal Chapel and Dudley's Chapel, just outside town, are both listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sudlersville%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sudlersville Memorial Library, located at 105 West Main St., serves the community and is housed in a former church building.",
      "sourceSentenceIds": [
        7,
        6
      ],
