  "facts": [
    {
      "id": 1,
      "text": "Live Oak is located in northeastern Horry County, just three miles west of Loris and eighteen miles northeast of Conway.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Live_Oak%2C_South_Carolina"
    },
    {
      "id": 2,
      "text": "Early settlement of Live Oak began in the 19th century as farmers from North Carolina and Virginia sought fertile agricultural lands.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/live_oak_south_carolina"
    },
    {
      "id": 3,
      "text": "Live Oak lies within the Pee Dee River Basin and is influenced by the Waccamaw and Little Pee Dee River watersheds.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/live_oak_south_carolina"
    },
    {
      "id": 4,
      "text": "Proximity to extensive pine-dominated woodlands and riverine floodplains shapes the local environment and landforms around the Live Oak community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/live_oak_south_carolina"
    },
    {
      "id": 5,
      "text": "Horry County transitioned Live Oak from a tobacco and timber economy to a mixed rural-residential landscape during the twentieth century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/live_oak_south_carolina"
    },
    {
      "id": 6,
      "text": "Settlers established scattered homesteads amid pine forests and swamps in the region near Live Oak by the mid-1800s.",
