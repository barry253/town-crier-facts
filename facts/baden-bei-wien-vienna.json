  "facts": [
    {
      "id": 1,
      "text": "Baden bei Wien earned UNESCO World Heritage status in 2021 as part of \"Great Spa Towns of Europe\" for its historic springs.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baden_bei_Wien"
    },
    {
      "id": 2,
      "text": "The town's name comes from 14 hot springs ranging 22-36°C, rich in calcium carbonate and magnesium sulphate.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baden_bei_Wien"
    },
    {
      "id": 3,
      "text": "Beethoven stayed several times; his former residences are now popular tourist spots.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baden_bei_Wien"
    },
    {
      "id": 4,
      "text": "The first freestanding spa hotel in Europe, the Sauerhof, opened in 1820.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baden_bei_Wien"
    },
    {
      "id": 5,
      "text": "Baden sits at the mouth of the Schwechat River's St Helena Valley in the Vienna Woods.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Baden_bei_Wien"
    },
    {
      "id": 6,
      "text": "The Stadttheater Baden, a historic theatre, hosts plays and operettas every night.",
      "sourceSentenceIds": [
