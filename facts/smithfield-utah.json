  "facts": [
    {
      "id": 1,
      "text": "Smithfield was founded in 1857 by Robert and John Thornley and Seth Langton, who were sent north from Salt Lake City.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smithfield%2C_Utah"
    },
    {
      "id": 2,
      "text": "Originally known as Summit Creek, the town was eventually renamed Smithfield after its first bishop, John Glover Smith.",
      "sourceSentenceIds": [
        2,
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Smithfield%2C_Utah"
    },
    {
      "id": 3,
      "text": "Early settlers in Smithfield spent their first winter living in a wagon box before building a small fort by the creek.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smithfield%2C_Utah"
    },
    {
      "id": 4,
      "text": "The Utah Northern Railroad extended to Smithfield by 1873, which provided the community with significantly better mail service.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/smithfield_history_03.shtml"
    },
    {
      "id": 5,
      "text": "Smithfield completed the sizable Smithfield Tabernacle in December 1902.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Smithfield%2C_Utah"
    },
    {
      "id": 6,
      "text": "Once dependent on dairying and the sugar beet industry, Smithfield is now primarily a bedroom community for Logan and Utah State University.",
