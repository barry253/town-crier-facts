  "facts": [
    {
      "id": 1,
      "text": "Rosebank earned its name around 1880 after shifting from Peterstown and Clifton, reflecting the area's romanticized landscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosebank%2C_Staten_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood once housed a federal quarantine station for immigrants, closed in 1971, a reminder of early 20th‑century New York history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosebank%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Garibaldi‑Meucci Museum honors inventor Antonio Meucci and Italian patriot Garibaldi, linking Rosebank to telephone history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rosebank%2C_Staten_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rosebank’s waterfront once hosted dry docks and ship repair, fueling a bustling maritime economy that still echoes in its views.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/rosebank",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rosebank’s Italian‑American roots give rise to vibrant food scenes, a legacy celebrated by locals and visitors alike.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamingverse.com/explore/united-states/new-york/rosebank-NY",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Eibs Pond Park served as a filming location for the 1917 silent film Womanhood, the Glory of the Nation, showcasing early cinema.",
      "sourceSentenceIds": [
