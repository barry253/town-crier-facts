  "facts": [
    {
      "id": 1,
      "text": "Houlton, Maine’s nickname is the “Shiretown,” a nod to its role as the county seat of Aroostook County.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.houlton-maine.com/about-houlton/facts-info/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Meduxnekeag River winds through Houlton’s center, and the Canadian border lies just 3 miles east of the town’s heart.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Houlton%2C_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The federally recognized Houlton Band of Maliseet Indians has its headquarters right in Houlton, underscoring the town’s indigenous roots.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Houlton%2C_Maine",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War I, the U.S. Army installed a transatlantic radio intelligence station just east of Houlton’s town center.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Houlton%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Houlton once hosted the AT&T Transoceanic Receiver Station on Hand Lane, linking American and British long‑wave telephone networks.",
      "sourceSentenceIds": [
        21
