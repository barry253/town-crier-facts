  "facts": [
    {
      "id": 1,
      "text": "Nibley was incorporated in 1935 and named after Charles Wilson Nibley, a presiding bishop of the Church of Jesus Christ of Latter-day Saints.",
      "sourceSentenceIds": [
        1,
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nibley%2C_Utah"
    },
    {
      "id": 2,
      "text": "The Elk Horn Ranch became the first Mormon settlement in the valley before the area was developed into the city of Nibley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nibleycity.gov/city-history/"
    },
    {
      "id": 3,
      "text": "Shoshone Indians occupied the Cache Valley area before it was settled by Mormon Pioneers.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nibleycity.gov/city-history/"
    },
    {
      "id": 4,
      "text": "A severe winter once forced the abandonment of most of the early settlement in Nibley, except for a few remaining settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nibleycity.gov/city-history/"
    },
    {
      "id": 5,
      "text": "Nibley celebrates Heritage Days every year during the week of the fourth Saturday of June.",
