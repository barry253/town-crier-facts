  "facts": [
    {
      "id": 1,
      "text": "Brawley was founded in 1902 as a planned community by the Imperial Land Company, part of a larger reclamation project turning the Colorado Desert into farmland.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Brawley,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally named Braly after land developer J.H. Braly, but the name was changed to Brawley in 1903 after he refused permission.",
      "sourceSentenceIds": [
        3,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brawley%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Southern Pacific Railroad arrived in September 1903, turning Brawley from a tent city of 100 workers into a rail‑linked agricultural hub.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Brawley,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brawley hosts the annual Cattle Call Rodeo, reflecting its strong cattle and feed industry heritage.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brawley%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Summer daytime temperatures often exceed 105°F, with July highs averaging 108°F, making Brawley one of the hottest places in California.",
      "sourceSentenceIds": [
        16,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brawley%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The All‑American Canal, completed in 1942 under the Boulder Canyon Project Act, delivers Colorado River water to Brawley, sustaining its year‑round agriculture.",
