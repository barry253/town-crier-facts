  "facts": [
    {
      "id": 1,
      "text": "A post office opened in 1886, and the town was renamed Woden after the Old English deity Woden.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Woden%2C_Texas"
    },
    {
      "id": 2,
      "text": "In the early 1890s the Haywood Lumber Company built a railroad that bypassed the original town, prompting residents to relocate closer to the tracks.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/woden-tx"
    },
    {
      "id": 3,
      "text": "Woden sits on Farm Road 226, roughly eleven miles southeast of Nacogdoches in southern Nacogdoches County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/woden-tx"
    },
    {
      "id": 4,
      "text": "Logging was the chief economic activity until the 1930s, after which the industry declined sharply.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woden%2C_Texas"
    },
    {
      "id": 5,
      "text": "Today agriculture drives the local economy, with farms producing a variety of crops in the region.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woden%2C_Texas"
    },
    {
      "id": 6,
      "text": "Before becoming Woden, the settlement was known as Jacobs and later as King's Store, reflecting its early Southern roots.",
      "sourceSentenceIds": [
        22,
        28
      ],
      "sourceLabels": [
