  "facts": [
    {
      "id": 1,
      "text": "Maysville began as Beatie’s Prairie, hosting Arkansas’s first post office from 1840 to 1850.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.todayinfortsmith.com/post/our-arklahoma-heritage-small-community-on-the-arkansas-oklahoma-border-holds-big-historical-secrets"
    },
    {
      "id": 2,
      "text": "Named in 1850 after settler John Martin May, Maysville was Benton County’s largest town in the 1840s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.todayinfortsmith.com/post/our-arklahoma-heritage-small-community-on-the-arkansas-oklahoma-border-holds-big-historical-secrets"
    },
    {
      "id": 3,
      "text": "Arkansas’s first commercial apple orchard, founded by a Cherokee woman near Maysville, flourished until the Civil War destroyed its buildings.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.todayinfortsmith.com/post/our-arklahoma-heritage-small-community-on-the-arkansas-oklahoma-border-holds-big-historical-secrets"
    },
    {
      "id": 4,
      "text": "Even without a railroad, Maysville boomed by 1888, boasting general stores, a grocery, a hardware shop, a grist mill, and a hotel.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.todayinfortsmith.com/post/our-arklahoma-heritage-small-community-on-the-arkansas-oklahoma-border-holds-big-historical-secrets"
    },
    {
      "id": 5,
      "text": "Maysville holds the distinction of being Arkansas’s westernmost settlement, a title it still carries today.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Maysville%2C_Arkansas"
    },
    {
      "id": 6,
      "text": "In the late 1850s, the Harmonial Vegetarian Society in Maysville built a mansion for a healing institute and published a monthly paper called The Theocrat.",
