  "facts": [
    {
      "id": 1,
      "text": "Flanders Village Historical Society, founded in 2008 by Gary Cobb, works to preserve the town’s 350‑year history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.flandersvillagehistoricalsociety.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Blue Barn, located at 949 Flanders Road just west of the Big Duck, is a key project of the historical society.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.flandersvillagehistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Big Duck, a duck‑shaped building that started as a 1930s farm stand, is one of Long Island’s most recognizable roadside landmarks.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.longislandguide.com/visit/flanders/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Both the Big Duck and the James Benjamin Homestead are listed on the National Register of Historic Places, underscoring Flanders’ historic value.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.longislandguide.com/visit/flanders/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name traces back to Algonquian “Akkobauk,” used by Eastern Long Island natives to describe the area now called Flanders.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.flandersvillagehistoricalsociety.org/",
      "category": "etymology",
      "quality": "good"
    }
  ],
