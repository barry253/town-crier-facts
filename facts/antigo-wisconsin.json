  "facts": [
    {
      "id": 1,
      "text": "Antigo's name comes from Ojibwe phrase meaning \"summer balsam firs by the river\".",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antigo%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The city was founded in 1876 by Francis A. Deleglise, whose log cabin is now on display at the Langlade County Historical Society Museum.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antigo%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Antigo's post office building is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antigo%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Langlade County Historical Society Museum houses artifacts and archives of Antigo and hosts a self‑guided tour.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antigo%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Horse racing has been part of Antigo life since the 1890s, with races held at the Langlade County Fairgrounds.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antigo%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The former Carnegie library on Route 45 served as Antigo’s public library from 1905 to 1997 and now houses a steam locomotive and the original founder’s cabin.",
