  "facts": [
    {
      "id": 1,
      "text": "Suffern was founded in 1796, marking the beginning of a village that would grow into a key Rockland County community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suffern%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Judge John Suffern, who settled near the Ramapo Mountains in 1773, lent his name to the village when it was established.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.suffernchamber.org/suffern-past",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lafayette Avenue, the main street of Suffern, honors Revolutionary War hero Marquis de Lafayette, reflecting the town’s patriotic roots.",
      "sourceSentenceIds": [
        9,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Suffern%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Erie Railroad crossed the area in 1841, it named its depot \"Suffern's Station\" to acknowledge Judge Suffern’s land grant.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suffern%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brooklands Park preserves the historic home of Boy Scouts founder Daniel Carter Beard, a landmark that celebrates the town’s connection to youth scouting.",
      "sourceSentenceIds": [
