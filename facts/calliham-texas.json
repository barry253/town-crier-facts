    {
      "id": 1,
      "text": "Calliham was renamed in 1923 after rancher Joseph Thomas Calliham, who owned the townsite.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/calliham-tx"
    },
    {
      "id": 2,
      "text": "The town sprang up during an oil‑prospecting boom that began in 1918 on the Calliham Ranch.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/calliham-tx"
    },
    {
      "id": 3,
      "text": "A post office opened in Calliham in 1923, marking its official recognition as a community.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/calliham-tx"
    },
    {
      "id": 4,
      "text": "In the 1920s Calliham boasted four cafés, three two‑story hotels, a bakery, a drugstore, a pool hall, a newspaper office, and a dance pavilion.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/calliham-tx"
    },
    {
      "id": 5,
      "text": "A relocated community three miles south of the original site preserves Calliham’s memory through historical markers.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/calliham-texas-ghost-town/"
    },
    {
