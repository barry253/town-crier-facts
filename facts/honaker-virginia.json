  "facts": [
    {
      "id": 1,
      "text": "Honaker earned the title \"Redbud Capital of the World\" after the eastern redbuds burst into pink‑purple blooms each spring.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1989796/fun-festivals-honaker-virginia-town-redbud-capital-of-world-creekside-trails/"
    },
    {
      "id": 2,
      "text": "Each spring, the town celebrates its blooming trees with an annual Redbud Festival that honors its world‑wide nickname.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Honaker%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Honaker’s commercial district was listed on the National Register of Historic Places in 2009, preserving its late‑19th‑century architecture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Honaker%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Settled in 1772 by William Ferrill, the area saw a fort—New Garden Fort—erected in 1774 during Dunmore’s War.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Honaker%2C_Virginia"
    },
    {
      "id": 5,
      "text": "The Honaker Heritage Museum showcases the town’s rich history through artifacts and photographs.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1989796/fun-festivals-honaker-virginia-town-redbud-capital-of-world-creekside-trails/"
    },
    {
