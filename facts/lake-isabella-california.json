  "facts": [
    {
      "id": 1,
      "text": "Lake Isabella sits on the southwestern edge of the reservoir, about six miles south of Wofford Heights in the Kern River Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Isabella%2C_California"
    },
    {
      "id": 2,
      "text": "The town was moved 1.5 miles south in 1953 when the dam on the Kern River flooded the original site.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Isabella%2C_California"
    },
    {
      "id": 3,
      "text": "The 1953 dam not only created the lake but also submerged the historic town of Kernville.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Isabella%2C_California"
    },
    {
      "id": 4,
      "text": "Lake Isabella lies at the confluence of the North and South Forks of the Kern River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Isabella%2C_California"
    },
    {
      "id": 5,
      "text": "The Tübatulabal people, whose name means “people that go to the forest to gather piñon nuts,” have long called this area home.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hiddenca.com/isabella-lake/"
    },
    {
      "id": 6,
      "text": "The community sits 35 miles east‑northeast of Bakersfield at an elevation of 2,513 feet.",
