    },
    {
      "id": 2,
      "text": "The town was moved 1.5 miles south in 1953 when the dam on the Kern River flooded the original site.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Isabella%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1953 dam not only created the lake but also submerged the historic town of Kernville.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Isabella%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Isabella lies at the confluence of the North and South Forks of the Kern River.",
