  "facts": [
    {
      "id": 1,
      "text": "Lawrence Park was named for Captain James Lawrence and the U.S.S. Lawrence, which served as Oliver Hazard Perry's flagship.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lawrenceparktwp.org/about-the-township/township-history/"
    },
    {
      "id": 2,
      "text": "General Electric established a factory here in 1910, designing Lawrence Park as a Garden City to provide healthy environments for workers.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.lawrenceparktwp.org/about-the-township/township-history/"
    },
    {
      "id": 3,
      "text": "World War One housing shortages led the town to replace the Garden City concept with brick row houses and garden spaces.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lawrenceparktwp.org/about-the-township/township-history/"
    },
    {
      "id": 4,
      "text": "The Lawrence Park Diner was added to the National Register of Historic Places in 2004.",
