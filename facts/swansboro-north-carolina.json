  "facts": [
    {
      "id": 1,
      "text": "Swansboro’s first permanent settlement appeared around 1730 on the site of an Algonquin village at the mouth of the White Oak River.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.visitswansboro.org/culture/historic-swansboro/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was incorporated in 1783 and named after Samuel Swann, a former Speaker of the North Carolina House of Commons.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://swansboro-nc.org/about/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1818, Otway Burns launched the Prometheus, North Carolina’s first river steamboat, out of Swansboro’s harbor.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swansboro%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Swansboro Historic District was added to the National Register of Historic Places in 1990, preserving its 18th‑century architecture.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swansboro%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town celebrates its heritage with an annual Historic Homes Tour, part of Onslow County’s America 250 celebration.",
