      ],
      "source": "https://en.wikipedia.org/wiki/Montpelier_(Orange%2C_Virginia)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1983, Marion duPont Scott bequeathed Montpelier to the National Trust for Historic Preservation.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montpelier_(Orange%2C_Virginia)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 197‑acre forest on the Montpelier grounds was named a National Natural Landmark in 1987.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montpelier_(Orange%2C_Virginia)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Montpelier Hunt Races, started in 1934, still run annually on the estate’s grounds.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montpelier_(Orange%2C_Virginia)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Montpelier is the lifelong home of James Madison, the fourth U.S. president, and his wife Dolley.",
