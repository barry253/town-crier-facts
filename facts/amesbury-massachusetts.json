      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed from Salisbury to Amesbury in 1667, modeled after Amesbury, England, which sits next to Salisbury.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
