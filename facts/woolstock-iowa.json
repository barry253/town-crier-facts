  "facts": [
    {
      "id": 1,
      "text": "Woolstock is the birthplace of actor George Reeves, who played Superman in the 1950s, and a local sign commemorates him since 2015.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woolstock_iowa",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from early settlers who raised sheep for wool, a trade that inspired Gilbert Perry to call it Woolstock.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woolstock%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Woolstock sits just north of where Eagle Creek meets the Boone River, a spot that once drew Native American hunters and fishermen.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woolstock%2C_Iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1881 the Western Town Lot Company platted Woolstock along a new railroad line, shifting the town’s center toward the tracks.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woolstock%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alsatian immigrants from the late 1800s to the 1940s settled in Woolstock, creating a bilingual French‑English community that lasted into the mid‑20th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/woolstock_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Historic French Church, built in 1896, became the focal point for Woolstock’s Alsatian settlers, and its cemetery remains the primary burial ground for that community.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
