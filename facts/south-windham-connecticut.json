  "facts": [
    {
      "id": 1,
      "text": "South Windham developed as a distinct village due to its position at the confluence of the Willimantic and Shetucket Rivers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/ct/south-windham/overview"
    },
    {
      "id": 2,
      "text": "The Windham Textile Mill was founded in 1831, establishing the industrial character of South Windham.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/ct/south-windham/overview"
    },
    {
      "id": 3,
      "text": "The Norwich and Worcester Railroad connected South Windham directly to major regional markets starting in the 1830s.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/ct/south-windham/overview"
    },
    {
      "id": 4,
      "text": "Historic mill complexes in South Windham were repurposed in 1970 to house small businesses and storage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/ct/south-windham/overview"
    },
    {
      "id": 5,
      "text": "South Windham retains a unique blend of historic mill housing, open spaces, and modest commercial corridors.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/ct/south-windham/overview"
    },
    {
      "id": 6,
      "text": "Several historic buildings and mill complexes in South Windham serve as tangible links to the area's industrial past.",
