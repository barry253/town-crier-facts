  "facts": [
    {
      "id": 1,
      "text": "Culloden, West Virginia, is a community in Cabell County located in the Teays Valley midway between Charleston and Huntington.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/culloden-west-virginia/"
    },
    {
      "id": 2,
      "text": "L. White named Culloden, possibly in honor of the Battle of Culloden in Scotland, because the name was so unique in America.",
      "sourceSentenceIds": [
        3,
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/culloden-west-virginia/"
    },
    {
      "id": 3,
      "text": "One theory suggests Culloden was named because railroad ties were culled and loaded here during the construction of the Chesapeake and Ohio Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/culloden-west-virginia/"
    },
    {
      "id": 4,
      "text": "Culloden is part of the Huntington–Ashland metropolitan area in the Metro Valley Region of western West Virginia.",
      "sourceSentenceIds": [
        7,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Culloden%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Culloden was briefly incorporated to allow property owners who disputed prohibition to obtain liquor licenses for saloons.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/culloden-west-virginia/"
    },
    {
      "id": 6,
      "text": "Townspeople eventually repealed the liquor license, and Culloden subsequently became an unincorporated community.",
      "sourceSentenceIds": [
        21
      ],
