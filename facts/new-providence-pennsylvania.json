    {
      "id": 1,
      "text": "New Providence is an unincorporated village in Providence Township, Lancaster County, Pennsylvania.",
      "sourceSentenceIds": [
        5,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Providence%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "New Providence once buzzed with train and trolley traffic, and today its old station buildings and still‑running tracks echo that era.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mussershistoriccountrysuites.com/new-providence/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic fish hatchery in New Providence once held the title of the world’s largest, raising gold carp and other species in lily‑pad‑lined ponds.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mussershistoriccountrysuites.com/new-providence/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Mennonite church still hosts Sunday services, while an old tavern has become a private home in New Providence.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mussershistoriccountrysuites.com/new-providence/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Main Street meets Pennsy Road at New Providence’s center, and Little Beaver Creek runs parallel through the town.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Providence%2C_Pennsylvania",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "New Providence once had two general stores, the Bair Store and the Peoples’ Store, before the post office moved into its own building.",
      "sourceSentenceIds": [
