  "facts": [
    {
      "id": 1,
      "text": "Downtown Jacksonville was once an industrial hub centered around the Jacksonville Shipyards before those facilities closed.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downtown_Jacksonville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Andrew Jackson, celebrated by Floridians for his role in the First Seminole War.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downtown_Jacksonville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1901, a massive fire—known as the Great Fire of 1901—devastated downtown, becoming Florida’s largest urban blaze.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downtown_Jacksonville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic LaVilla neighborhood, part of downtown, earned the nickname “Harlem of the South” and was a railroad hub.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dia.jacksonville.gov/about-downtown/explore-downtown",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Downtown’s Skyway, a free automated people mover, connects key civic buildings and runs through the city’s oldest suburb.",
