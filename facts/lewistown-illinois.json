  "facts": [
    {
      "id": 1,
      "text": "Lewistown was renamed from its original name, Fulton Courthouse, on March 14, 1831.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewistown%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lewistown hosts the Dickson Mounds Museum, a premier archaeological site that opened just five miles southeast of town.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://lewistownillinois.org/plan-your-visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oak Hill Cemetery, famous for its Civil War memorial, is the setting for Edgar Lee Masters’ Spoon River Anthology.",
      "sourceSentenceIds": [
        8,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://lewistownillinois.org/plan-your-visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every October, the Spoon River Valley Scenic Drive turns Lewistown into a two‑weekend festival of arts, crafts, and history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lewistownillinois.org/plan-your-visit/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Emiquon National Wildlife Refuge, a 7,000‑acre wetland restoration, lies just six miles east of Lewistown along the Illinois River.",
      "sourceSentenceIds": [
        28
