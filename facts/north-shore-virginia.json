  "facts": [
    {
      "id": 1,
      "text": "North Shore sits on a 6‑mile peninsula in Smith Mountain Lake, an impoundment on the Roanoke River.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Shore%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The peninsula’s northern edge follows the Roanoke River arm of the lake, which also marks the Bedford County line.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Shore%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Native Americans such as the Monacan and Tutelo lived in the area for over 7,000 years, using the Roanoke River valley for hunting and trade.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_shore_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Franklin County, where North Shore lies, was created in 1785 from parts of Bedford and Henry Counties and named after Benjamin Franklin.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_shore_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s shoreline stretches over 500 miles along Smith Mountain Lake, featuring landmarks like Bernard’s Landing, the lake’s first resort.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_shore_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "North Shore’s central hub is the unincorporated community of Scruggs, located in the middle of the CDP.",
      "sourceSentenceIds": [
        15
