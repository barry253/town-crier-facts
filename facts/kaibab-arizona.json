      ],
      "source": "https://grcahistory.org/sites/beyond-park-boundaries/kaibab-national-forest/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1,000‑year‑old Cohonina ruin is being reconstructed at the ranger station in Williams.",
