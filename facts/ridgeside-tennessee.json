  "facts": [
    {
      "id": 1,
      "text": "Ridgeside’s name comes from its position on the eastern slope of Missionary Ridge, a fact noted by local historians.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgeside%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city is an enclave, completely surrounded by Chattanooga’s city limits, making it a unique pocket of Hamilton County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgeside%2C_Tennessee",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Ridgeside was once a dairy farm run by John T. Shepherd, whose legacy helped shape the area’s early development.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgeside%2C_Tennessee",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1931, the Shepherd Hills subdivision incorporated as the city of Ridgeside to avoid annexation by the rapidly growing Chattanooga.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ridgeside%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ridgeside Pool, built in the 1960s, has been a community gathering spot since its opening and was renovated in 2018 with new pavilions.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ridgesidetn.gov/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every year, Ridgeside celebrates its 90th anniversary with a party that began in 2015, marking a century of community life.",
