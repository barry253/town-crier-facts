  "facts": [
    {
      "id": 1,
      "text": "Fangshan lies 38 km southwest of downtown Beijing, nestled in the Western Hills east of the Taihang Mountains.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fangshan%2C_Beijing"
    },
    {
      "id": 2,
      "text": "The Wanfotang and Kongshuidong Caves, called the Ten Thousand Buddha Hall, date back to the Tang Dynasty and house six large stone figures reminiscent of Yungang and Longmen.",
      "sourceSentenceIds": [
        22,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chinaculturetrip.com/beijing-fangshan-wanfotang-kongshuidong-shike-ji-ta/"
    },
    {
      "id": 3,
      "text": "Originally named Longquan Temple, the site was renamed Dali Chan Temple during the Ming Dynasty and features a three‑chamber hall without internal columns.",
      "sourceSentenceIds": [
        24,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chinaculturetrip.com/beijing-fangshan-wanfotang-kongshuidong-shike-ji-ta/"
    },
    {
      "id": 4,
      "text": "Fangshan hosts the Beijing Fangshan National Geopark, which includes the Zhoukoudian Peking Man Site, home to famous Peking Man fossils.",
      "sourceSentenceIds": [
        11,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-fangshan-district-travel-guide/"
    },
    {
      "id": 5,
      "text": "The geopark’s eight scenic zones offer diverse landscapes, from prehistoric wonderlands to spiritual retreats like Shangfang Mountain and Yunju Temple.",
      "sourceSentenceIds": [
        13,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ruqintravel.com/china-destination-guides/beijing-fangshan-district-travel-guide/"
    },
    {
      "id": 6,
      "text": "Fangshan’s humid continental climate averages 12.5 °C annually, supporting greenhouse agriculture that now attracts significant investment.",
      "sourceSentenceIds": [
