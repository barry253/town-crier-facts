  "facts": [
    {
      "id": 1,
      "text": "Ludowici was named after a German tile manufacturer who settled there and made red clay roofing tiles popular throughout South Georgia.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longcountyga.gov/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s origins trace back to the 1840s when the Atlantic and Gulf Railroad opened a stop called “Four and a Half,” sparking early settlement.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ludowici%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ludowici tile factory covered more than 1,100 acres and employed around 100 workers, producing tiles stamped “Ludowici – Dixie.”.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ludowici%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Long County Courthouse, built in 1926, sits in Ludowici and is listed on the National Register of Historic Places.",
