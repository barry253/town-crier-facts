    },
    {
      "id": 2,
      "text": "The city hosts the private College of Wooster and the main branch of Wayne County Public Library.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wooster%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The Wooster Symphony Orchestra, founded in 1915, is a joint venture between the community and the College of Wooster.",
      "sourceSentenceIds": [
