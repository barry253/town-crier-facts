      ],
      "source": "https://en.wikipedia.org/wiki/View_Park%E2%80%93Windsor_Hills%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The View Park Library honors late writer Bebe Moore Campbell, a longtime resident.",
