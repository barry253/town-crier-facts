      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/View_Park%E2%80%93Windsor_Hills%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district showcases Spanish Colonial Revival, Mediterranean, and Mid‑Century homes that still stand today.",
      "sourceSentenceIds": [
