  "facts": [
    {
      "id": 1,
      "text": "In May 1867, the post office was renamed Spring Lake, matching the name of a railway station on the Detroit‑Grand Haven line.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Lake%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before Europeans arrived in 1837, Ottawa, Chippewa, and Potawatomi tribes called the area home for thousands of years.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Lake,_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1874, Spring Lake boasted nine sawmills, two planing mills, and a sash‑and‑door factory, making it a lumber hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Lake,_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Verplank Dock Company, founded in 1908, kept operating into the 20th century while tourism and residential appeal grew.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Lake,_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1987, the 1844 Barber School was relocated and repurposed for community meetings, preserving a historic landmark.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Spring_Lake,_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Spring Lake’s 20th‑century shift from industry to suburbia was driven by its proximity to Grand Haven and Grand Rapids via I‑96.",
      "sourceSentenceIds": [
        10
