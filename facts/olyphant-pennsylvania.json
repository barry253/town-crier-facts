  "facts": [
    {
      "id": 1,
      "text": "Olyphant was originally called “Queen City” before being renamed for George Talbot Olyphant, president of the Delaware & Hudson Canal Company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lackawannacounty.com/olyphant",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough once housed the headquarters of the Lackawanna Coal Company, making it a hub for anthracite mining and shipping.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lackawannacounty.com/olyphant",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 20th century, factories in Olyphant produced blasting powder, cigars, silks, and steel goods, reflecting its diverse industrial past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lackawannacounty.com/olyphant",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Until 2018, Cinram, a manufacturer of CDs and DVDs, was Olyphant’s largest employer, a reminder of the town’s shift from coal to digital media.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lackawannacounty.com/olyphant",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Broadway actress Judy McLane, known for playing Tania in “Mamma Mia!”, was born in Olyphant, though she grew up near Scranton.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://olyphantboro.com/site/community/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Olyphant sits six miles northeast of downtown Scranton on the Lackawanna River, placing it in the heart of Pennsylvania’s anthracite region.",
      "sourceSentenceIds": [
