  "facts": [
    {
      "id": 1,
      "text": "Prattsville was named after Zadock Pratt, a congressman who turned the area into a major trading hub in the 1800s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.greatnortherncatskills.com/prattsville-ny",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pratt Rock, dubbed “New York’s Mount Rushmore,” displays stone carvings of Pratt’s life and his Civil War son.",
      "sourceSentenceIds": [
        6,
        27,
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.greatnortherncatskills.com/prattsville-ny",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Episcopal Manse, built in the early 1800s, earned a spot on the National Register of Historic Places in 2000.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofprattsville.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Prattsville’s Main Street follows New York State Route 23, linking the town 39 miles northwest to Oneonta and 36 miles southeast to Catskill.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prattsville_(CDP)%2C_New_York",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "In 1824 Prattsville split from Windham, and in 1848 part of it became the new town of Ashland.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofprattsville.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hurricane Irene in 2011 flooded Schoharie Creek, wiping out every Main Street business yet leaving no deaths.",
