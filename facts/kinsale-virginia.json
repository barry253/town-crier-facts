  "facts": [
    {
      "id": 1,
      "text": "Kinsale was named after Kinsale, Ireland, by early settlers in the 1700s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinsale%2C_Virginia"
    },
    {
      "id": 2,
      "text": "Kinsale’s deepwater creek gave it a sheltered harbor that drew colonial deep‑draft ships and later Chesapeake schooners.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/096-0090/"
    },
    {
      "id": 3,
      "text": "Officially founded in 1706 and again in 1784, Kinsale really grew when steamboats arrived in the early 1800s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/096-0090/"
    },
    {
      "id": 4,
      "text": "During the War of 1812, Royal Marines raided the Yeocomico River and captured four schooners at Kinsale in August 1814.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinsale%2C_Virginia"
    },
    {
      "id": 5,
      "text": "The Kinsale Historic District, covering homes and businesses from the late 1700s to today, was added to the National Register in 2005.",
      "sourceSentenceIds": [
        11,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kinsale%2C_Virginia"
    },
    {
      "id": 6,
      "text": "After 1952, when the last canning factory closed and a firehouse was built, Kinsale shifted from a port to a quiet residential community.",
