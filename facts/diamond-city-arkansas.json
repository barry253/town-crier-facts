  "facts": [
    {
      "id": 1,
      "text": "Diamond City earned the nickname \"The Jewel of Bull Shoals Lake\" because of its scenic location on the lake's south shore.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://diamondcityar.gov/"
    },
    {
      "id": 2,
      "text": "The town sits between east and west Sugarloaf Creeks, which flow into Bull Shoals Lake.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Diamond_City%2C_Arkansas"
    },
    {
      "id": 3,
      "text": "Bull Shoals Lake is renowned for bass, crappie, and walleye fishing, making it a top destination for anglers.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://diamondcityar.gov/"
    },
    {
      "id": 4,
      "text": "Before settlers arrived, the Osage people hunted in the area that would become Diamond City.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://diamondcityar.gov/city-of-diamond-city-about/"
    },
    {
      "id": 5,
      "text": "The Trail of Tears passed through the region in the late 1830s, marking a significant historical route.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://diamondcityar.gov/city-of-diamond-city-about/"
    },
    {
      "id": 6,
      "text": "Early settlers in the 19th century were mostly Scots-Irish and German, establishing a small community on West Sugarloaf Creek after a steamboat arrived in 1851.",
