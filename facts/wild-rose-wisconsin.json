  "facts": [
    {
      "id": 1,
      "text": "Wild Rose was settled by Welsh immigrants in the mid-nineteen fifties, creating a unique cultural history for the village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.villageofwildrose.com/"
    },
    {
      "id": 2,
      "text": "Wild Rose may be named for the wild rose bushes nearby or for the town of Rose, New York, where many settlers originated.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wild_Rose%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Elisha Stewart House stands as a remaining example of early pioneer homes in central Wisconsin.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofwildrose.com/history/"
    },
    {
      "id": 4,
      "text": "Pioneer Hall in Wild Rose once served as a bank and post office, and its back room displays early patent medicines.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofwildrose.com/history/"
    },
    {
      "id": 5,
      "text": "Nearly three dozen buildings in Wild Rose from the late eighteen eighties through the early nineteen hundreds are listed in a historic architecture inventory.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofwildrose.com/history/"
    },
    {
