  "facts": [
    {
      "id": 1,
      "text": "Plainview earned its name from Gardner, who christened the town amid Yell County's forested hills near the Petit Jean River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plainview_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A small post office called Balloon opened nearby, acting as Plainview's first administrative hub for scattered settlers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plainview_arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Plainview grew around the Fort Smith Lumber Company, which sent three daily trains on a short‑line railroad to supply timber for Folk Victorian homes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plainview_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Sanborn maps from 1913 to 1919 let visitors trace Plainview's downtown layout and see businesses that once thrived.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-plainview-arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1910 Plainview boasted Baptist and Methodist churches, a four‑room schoolhouse, two banks, two drugstores, a depot, and a lumber‑built hotel.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
