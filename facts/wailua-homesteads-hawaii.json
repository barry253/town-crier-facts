  "facts": [
    {
      "id": 1,
      "text": "Wailua Homesteads sits beside the Wailua Complex of Heiau, a National Historic Landmark that once housed four major temples, a refuge, and petroglyphs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wailua_homesteads_hawaii",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the early 1900s, canals, railroads, and flooding reshaped Wailua Homesteads into a residential enclave for plantation workers who still practiced communal fishing and honored sacred sites.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wailua_homesteads_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European arrival, Wailua Homesteads was one of Hawaii’s most sacred sites, serving as a major religious and political center for Native Hawaiians.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wailua_homesteads_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1978 Hawaiian Constitution affirmed the state’s duty to protect Native Hawaiian interests, expanding Hawaiian Homes Commission Act lands that shaped Wailua Homesteads.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wailua_homesteads_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wailua Homesteads began in the 1930s when former taro and rice fields were auctioned into residential lots for local families.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wailua_homesteads_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Wailua Complex includes Holoholoku Heiau, a luakini temple linked to human sacrifice, and Hikinaakalā Heiau, aligned with sunrise for ceremonies.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
