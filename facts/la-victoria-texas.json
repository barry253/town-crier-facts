  "facts": [
    {
      "id": 1,
      "text": "La Victoria grew around a ranch established by Antonio de la Garza in 1807, near the San Antonio River at Carlos Crossing.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.allacrosstexas.com/texas-small-town.php?city=La%20Victoria"
    },
    {
      "id": 2,
      "text": "In 1834, Garza secured a league of land that included the old Garza ranch, laying the legal groundwork for the town.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.allacrosstexas.com/texas-small-town.php?city=La%20Victoria"
    },
    {
      "id": 3,
      "text": "The early community, called Carlos Rancho, featured a commissary run by Garza and extensive livestock holdings.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.allacrosstexas.com/texas-small-town.php?city=La%20Victoria"
    },
    {
      "id": 4,
      "text": "Residents still celebrate La Victoria’s cow‑town roots, a proud part of the town’s cultural identity.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.allacrosstexas.com/texas-small-town.php?city=La%20Victoria"
    },
    {
      "id": 5,
      "text": "The CDP contains 548 housing units, averaging 150.5 per square mile.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Victoria%2C_Texas"
    },
    {
      "id": 6,
      "text": "In 2024, about 8% of La Victoria residents live below the poverty line.",
