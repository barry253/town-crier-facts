      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Highland Mill Lofts, once a textile mill, now houses lofts and Heist Brewery, a National Register landmark.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.noda.org/historyofnoda",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Hand Pharmacy building was repurposed into Cabo Fish Taco, a local eatery that draws crowds daily.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/NoDa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Aberdeen and Carolina Western Railroad once crossed NoDa, and the Norfolk Southern mainline still runs parallel today.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/NoDa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Center of the Earth Gallery, founded in the early 1900s, was the first artist space in NoDa and led the neighborhood’s cultural revival.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
