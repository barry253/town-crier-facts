      "id": 1,
      "text": "NoDa, formerly North Charlotte, evolved from a 19th‑century mill village into a vibrant arts district.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
