  "facts": [
    {
      "id": 1,
      "text": "Tuckasegee, whose Cherokee name Dvkasigi means \"river confluence,\" grew beside the historic Cherokee town that once stood here.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckasegee%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Because the town sits where the Tuckasegee River’s East and West forks meet, early settlers battled frequent floods until dams were built in the 1930s.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckasegee%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tuckasegee hosts several early mountain churches, including the 19th‑century Tuckasegee Wesleyan and the East LaPorte Community Church.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckasegee%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Upper forks of the river now feed manmade lakes—Wolf, Tanasee Creek, Bear, Cedar Cliff, and Glenville—created by 1930s dams.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckasegee%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Canada Elementary operated from 1952 to 1982, and Tuckasegee School, rebuilt after a 1940s fire, once served all grades.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckasegee%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The valley offers boating, rafting, hiking, and mountain climbing, making Tuckasegee a gateway to outdoor adventures.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
