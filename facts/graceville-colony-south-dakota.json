  "facts": [
    {
      "id": 1,
      "text": "Graceville Colony was established in 1948 as a daughter colony of the Schmiedeleut branch of Hutterites.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graceville_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Graceville Colony operates as a communal agricultural settlement based on Anabaptist principles of shared property and pacifism.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graceville_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "Graceville Colony sits on the east side of the East Fork of the Vermillion River, a tributary of the Missouri River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Graceville_Colony%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "The community maintains traditional Hutterite practices, including German-language worship services and distinctive dress.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graceville_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Graceville Colony achieved self-sufficiency by the mid-1960s through diversifying into livestock rearing and crop production.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graceville_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Modern mechanized farming tools like diesel tractors and self-propelled combines were adopted to enhance efficiency at Graceville Colony.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
