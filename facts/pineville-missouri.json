  "facts": [
    {
      "id": 1,
      "text": "Pineville began as Maryville in 1847, then changed its name to Pineville in 1849 to avoid postal confusion.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pineville_missouri"
    },
    {
      "id": 2,
      "text": "The city sits where Big and Little Sugar Creeks meet, forming the Elk River in the Ozark Mountains.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pineville%2C_Missouri"
    },
    {
      "id": 3,
      "text": "Pineville became McDonald County’s seat when the county was organized in 1849.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pineville_missouri"
    },
    {
      "id": 4,
      "text": "The Old McDonald County Courthouse, now a museum, joined the National Register of Historic Places in 2012.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pineville%2C_Missouri"
    },
    {
      "id": 5,
      "text": "The 1939 film Jesse James was shot almost entirely in Pineville, and its 1941 sequel Belle Starr followed suit.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pineville%2C_Missouri"
    },
    {
      "id": 6,
      "text": "Founded in 1963, the McDonald County Historical Society restored the courthouse into a museum beginning in 2013.",
