  "facts": [
    {
      "id": 1,
      "text": "Pattison was named after James Tarrant Pattison, who bought land in 1839 and built a plantation house on a hill.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pattison-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town organized in 1877 when Pattison’s children granted the Texas Western Narrow Gauge Railroad a right‑of‑way and donated land for a townsite.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pattison-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1875 the German Methodist Church was founded, followed by Christ Lutheran in 1890, reflecting the town’s German immigrant roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pattison-tx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mount Calvary Baptist Church began as itinerant black ministers’ camp meetings in 1889, marking early African‑American religious life.",
