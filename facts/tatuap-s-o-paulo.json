    },
    {
      "id": 2,
      "text": "Governor Paulo Maluf opened Tatuapé station on 5 November 1981, riding a wheelchair despite no elevators yet.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tatuap%C3%A9_(S%C3%A3o_Paulo_Metro)"
    },
    {
      "id": 3,
      "text": "Tatuapé station links São Paulo Metro Line 3‑Red with CPTM Lines 11‑Coral and 12‑Sapphire, offering free transfers on weekends.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tatuap%C3%A9_(S%C3%A3o_Paulo_Metro)"
    },
    {
      "id": 4,
      "text": "Building the station required excavating 313,346 cubic metres of soil and driving 7,713 metres of 'Franki' stakes.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
