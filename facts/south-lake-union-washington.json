  "facts": [
    {
      "id": 1,
      "text": "South Lake Union grew from Duwamish Tribe lands to an industrial hub by the late 19th century.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.seattleparksfoundation.org/the-evolution-of-south-lake-union-a-journey-through-time/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake Union’s name comes from the Lushootseed word x̌ax̌čuʔ, meaning “small lake,” a diminutive of Lake Washington’s name.",
      "sourceSentenceIds": [
        16,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Union",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Aurora Bridge, officially the George Washington Memorial Bridge, carries State Route 99 over Lake Union’s western arm.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Union",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Fremont Cut, Lake Union’s westernmost point, is spanned by the Fremont Bridge, separating the lake from the rest of the canal.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Union",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Lake Union’s industrial past is highlighted by historic commercial laundries that once occupied the Cascade neighborhood.",
      "sourceSentenceIds": [
        11
