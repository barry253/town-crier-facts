  "facts": [
    {
      "id": 1,
      "text": "Margaret Island was once called Insula leporum, the Island of Rabbits, before being renamed after Saint Margaret in the 14th century.",
      "sourceSentenceIds": [
        1,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margaret_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The island’s current shape formed by linking three former islands—Festő, Fürdő, and Nyulak—at the end of the 19th century to control the Danube’s flow.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margaret_Island",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1908, Margaret Island became a public park, opening its green spaces to all citizens for the first time.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hungaryunlocked.com/hidden-gems-and-historic-wonders-on-budapests-margitsziget/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The island hosts a small zoo that keeps a variety of exotic waterfowl, a rarity for a city park.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margaret_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1973 Centennial Memorial by István Kiss marks Budapest’s unification, standing beside the island’s musical fountain.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margaret_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Medieval ruins on the island include a 13th‑century Franciscan church, a Dominican convent, and a Premonstratensian church from the 12th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margaret_Island",
      "category": "landmark",
      "quality": "good"
    }
  ]
