  "facts": [
    {
      "id": 1,
      "text": "Pierre Part is named after Pierre Part, an Acadian exile who arrived in Spanish Louisiana in 1766.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pierre_Part%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community was founded by Acadian exiles after the Great Upheaval of 1755, settling amid bayous and wetlands in Acadiana.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Pierre_Part,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before the Great Depression, residents fished and hunted alligators; afterward many turned to logging, levee work, and the burgeoning oil industry.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pierre_Part%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A sinkhole appeared near Pierre Part in 2012, expanding over months and frightening locals who feared an imminent threat.",
      "sourceSentenceIds": [
        30,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pierre_Part%2C_Louisiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The History Channel series Swamp People follows the Landry family, a Cajun clan living in Pierre Part, and first aired in 2010.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pierre_Part%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pierre Part remained cut off from the outside world until the mid‑twentieth century because it was surrounded by water and inaccessible by land.",
