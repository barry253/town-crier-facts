  "facts": [
    {
      "id": 1,
      "text": "Strathpine’s name comes from the Scottish words ‘strath’, meaning valley, and ‘pine’, referring to the nearby Pine River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strathpine%2C_Queensland"
    },
    {
      "id": 2,
      "text": "In 1887 the Railways Department named Strathpine after a distinctive name was sought for a new station on the North Coast Railway.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moretonbay.qld.gov.au/Galleries-Museums/Explore/History-And-Heritage/Moreton-Bay-History/Pine-Rivers-District-History/Pine-Rivers-Regions/Strathpine-History"
    },
    {
      "id": 3,
      "text": "In 1888 Strathpine became the administrative centre of the Pine local‑government divisional board, adding a bakery and rum distillery to the village.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.moretonbay.qld.gov.au/Galleries-Museums/Explore/History-And-Heritage/Moreton-Bay-History/Pine-Rivers-District-History/Pine-Rivers-Regions/Strathpine-History"
    },
    {
      "id": 4,
      "text": "The Strathpine Library opened in 1990, serving the community with books and digital resources.",
