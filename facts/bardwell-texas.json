  "facts": [
    {
      "id": 1,
      "text": "Bardwell sprang to life in the early 1880s when John W. Bardwell built a cotton gin a mile south of the town’s current site.",
      "sourceSentenceIds": [
        3,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.elliscountytx.gov/189/Bardwell",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A school opened in 1892, followed by a post office the next year, marking Bardwell’s first steps toward a permanent community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bardwell%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Trinity and Brazos Valley Railway cut through Ellis County in 1907, Bardwell’s gin and residents relocated to sit beside the new tracks.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bardwell%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1914, Bardwell boasted its own telephone system and electricity supplied by lines from Ennis, a first for the town.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bardwell%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1920s, Bardwell thrived as a cotton shipping hub, operating three gins and six grocery stores at its peak.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bardwell%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Bardwell lies just two miles east of the town, offering a nearby waterway that locals enjoy for fishing and recreation.",
      "sourceSentenceIds": [
        15
