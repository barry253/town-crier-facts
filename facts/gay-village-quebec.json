  "facts": [
    {
      "id": 1,
      "text": "Gay Village grew from a poor working‑class Centre‑Sud area that attracted LGBTQ businesses after other parts of Montreal pushed them out.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gay_Village%2C_Montreal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first recorded gay shop in North America opened in 1869 when Montrealer Moise Tellier sold apple and cake on Craig Street.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gay_Village%2C_Montreal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1976, Montreal’s Gay Coalition Against Repression staged Canada’s largest gay demonstration on July 19, sparking a citywide push for rights.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gay_Village%2C_Montreal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mid‑March 1987 saw police raid several Village bars, forcing many to close and marking a dark chapter in its history.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gay_Village%2C_Montreal",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Recent gentrification and tourism have drawn straight residents, leading some to say the Village’s historic queer bars are no longer the community’s hub.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mcgilldaily.com/2025/10/the-changing-landscape-of-the-gay-village/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Beaudry metro station, the Village’s main entrance, now sports rainbow pillars and a council‑room flag to honor its LGBTQ heritage.",
      "sourceSentenceIds": [
        11
      ],
