      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Reesville Methodist Episcopal Church began in 1872 in a converted schoolhouse, swelling to 70 members by the 1880s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
