  "facts": [
    {
      "id": 1,
      "text": "Eudora takes its name from Frances Eudora James, the daughter of a plantation owner who died at age four in 1858.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://intotheozarks.com/eurdora-arkansas/"
    },
    {
      "id": 2,
      "text": "The town’s first house, built by the Sweet family around 1858, still stands as a reminder of Eudora’s early settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://intotheozarks.com/eurdora-arkansas/"
    },
    {
      "id": 3,
      "text": "Eudora’s First Baptist Church, an African‑American congregation founded in 1860, is one of the town’s oldest religious institutions.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://intotheozarks.com/eurdora-arkansas/"
    },
    {
      "id": 4,
      "text": "During the catastrophic Flood of 1927, Eudora’s residents showed remarkable resilience, rebuilding the town against rising waters.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://intotheozarks.com/eurdora-arkansas/"
    },
    {
      "id": 5,
      "text": "Eudora is the warmest populated area in Arkansas, with temperatures often soaring above 100°F in summer.",
      "sourceSentenceIds": [
