  "facts": [
    {
      "id": 1,
      "text": "Triangle earned the nickname “Crossroads of the Marine Corps” because Marine Corps Base Quantico sits at its heart.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitolia.com/triangle-travel-guide-V102076"
    },
    {
      "id": 2,
      "text": "The National Museum of the Marine Corps, a flagship exhibit of U.S. military history, is located right in Triangle.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Triangle%2C_Virginia"
    },
    {
      "id": 3,
      "text": "During the Great Depression, Triangle began as a camp for underprivileged children and later doubled as a WWII spy training ground.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitolia.com/triangle-travel-guide-V102076"
    },
    {
      "id": 4,
      "text": "Triangle’s landscape blends military heritage with the expansive wilderness of Prince William Forest Park, the largest protected area in the Washington D.C. region.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Triangle%2C_Virginia"
    },
    {
      "id": 5,
      "text": "Triangle’s attractions focus on powerful military stories and outdoor adventures, offering visitors both history and nature in one place.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitolia.com/triangle-travel-guide-V102076"
    },
    {
      "id": 6,
      "text": "Located about 32 miles southwest of Washington, D.C., Triangle serves as a quiet gateway to the nation’s capital.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
