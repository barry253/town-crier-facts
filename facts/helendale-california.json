  "facts": [
    {
      "id": 1,
      "text": "Helendale began as a watering stop called Point of Rocks, built by the Santa Fe Railroad in the 1880s along the old camel trail.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://main.sbcounty.gov/2026/02/05/san-bernardino-county-history-helendale/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name changed again in 1918 to Helendale, a blend of Helen and the surrounding desert landscape.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://main.sbcounty.gov/2026/02/05/san-bernardino-county-history-helendale/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Helendale sits on historic Route 66, just west of Interstate 15 between Barstow and Victorville.",
      "sourceSentenceIds": [
        11,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Helendale%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two artificial lakes were created in 1969, covering 277 acres, and the Silver Lakes resort community grew along their shores.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
