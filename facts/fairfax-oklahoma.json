  "facts": [
    {
      "id": 1,
      "text": "Fairfax was created when the Santa Fe Railway bypassed the village of Gray Horse to build a line through the Osage Reservation.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfax%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town of Fairfax was named after a hotel in Washington, D.C., where a local resident had previously stayed.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfax%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Fairfax was the home of Maria and Marjorie Tallchief, who were among the first Native American prima ballerinas in the world.",
      "sourceSentenceIds": [
        21,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://visittheosage.com/destinations/fairfax"
    },
    {
      "id": 4,
      "text": "The Tall Chief Theatre in Fairfax was built during the oil boom as a tribute to the town's famous ballerinas.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visittheosage.com/destinations/fairfax"
    },
    {
      "id": 5,
      "text": "Portions of the movie Killers of the Flower Moon were filmed in Fairfax to tell a story tied to Osage Nation history.",
      "sourceSentenceIds": [
        5,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://visittheosage.com/destinations/fairfax"
    },
    {
      "id": 6,
      "text": "The Fairfax Historical Society's museum is housed in the former First State Bank building.",
