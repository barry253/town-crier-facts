  "facts": [
    {
      "id": 1,
      "text": "Fulton was named after Robert Fulton, the inventor of the steamboat, in the 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulton%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The city honors its Dutch roots with the windmill De Immigrant, perched beside the Mississippi dike.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulton%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Dickson Mounds Museum, a National Register site, lets visitors trace 12,000 years of Illinois River Valley history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fultoncountyil.gov/visitors-guide/"
    },
    {
      "id": 4,
      "text": "Fulton’s Martin House Museum, Heritage Canyon, and annual Dutch Days festival showcase local culture and history.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulton%2C_Illinois"
    },
    {
      "id": 5,
      "text": "The city sits on the east bank of the Mississippi River, just downstream of Lock and Dam #13.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fulton%2C_Illinois"
    },
    {
      "id": 6,
      "text": "Ellisville Opera House, the only surviving opera house in the county, still operates as originally intended.",
      "sourceSentenceIds": [
