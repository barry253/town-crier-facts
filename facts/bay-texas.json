  "facts": [
    {
      "id": 1,
      "text": "Bay City was incorporated in 1894 as the county seat of Matagorda County.",
      "sourceSentenceIds": [
        28,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_City%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its location on Bay Prairie between the Colorado River and Caney Creek bottomlands.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baycitytxcdc.net/about-us/history/"
    },
    {
      "id": 3,
      "text": "In 1914 Bay City boasted four cotton gins, two rice mills, a brick and tile factory, and a large cooling station for fruits and vegetables.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baycitytxcdc.net/about-us/history/"
    },
    {
      "id": 4,
      "text": "The manmade port of Bay City was completed in the 1930s, and an inflatable rubber dam was built to impound water for rice irrigation.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baycitytxcdc.net/about-us/history/"
    },
    {
      "id": 5,
      "text": "Bay City sits on the Union Pacific Railroad main line that parallels the Texas Gulf Coast from Brownsville to Algoa, near Houston.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_City%2C_Texas"
    },
    {
      "id": 6,
      "text": "By 1915 residents had built a library, and Bay City Business College offered the community’s first higher education.",
      "sourceSentenceIds": [
