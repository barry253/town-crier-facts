  "facts": [
    {
      "id": 1,
      "text": "Fredericksburg was founded in the mid‑1800s as settlers moved into northeastern Iowa seeking farmland, timber, and water along Plum Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fredericksburgiowadevelopment.org/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors early settler Frederick Padden, who built the first dwelling, store, and a steam sawmill on Plum Creek in the 1850s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericksburg_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1886, the Chicago Great Western Railway turned Fredericksburg into a station, ending its isolation and opening markets for local farmers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericksburg_iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dairy has been a cornerstone since the 1870s, with the Fredericksburg Cheese Company founded in 1875 and a second creamery added in 1882.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericksburg_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first school district in Fredericksburg organized around 1855, reflecting the community’s early commitment to education.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fredericksburg_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town was incorporated on December 18, 1894, formalizing its municipal governance after nearly a century of growth.",
      "sourceSentenceIds": [
        13
