  "facts": [
    {
      "id": 1,
      "text": "Glen Ridge was officially incorporated on December 11, 1947, after resident Helen Mosler suggested the name because the wooded canal bank looked like a glen ridge.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ridge%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is a registered bird sanctuary, where dense green foliage creates a canopy that drapes over the streets as you drive in.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ridge%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1932, the Trout family built and moved into the first house that would become the core of what is now Glen Ridge.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ridge%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original housing development split in 1951, with part of it evolving into the neighboring town of Cloud Lake.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ridge%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Glen Ridge opened a permanent town hall and community center in September 2002 after spending about $110,000 to repurpose a former residence.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Ridge%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Twin brothers Kenyon and Karl Riddle bought land west of the Seaboard Air Line Railroad in 1935, laying the groundwork for the town.",
