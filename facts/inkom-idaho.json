  "facts": [
    {
      "id": 1,
      "text": "Inkom’s name comes from the Shoshone word “Ingacom,” meaning the rock formation on the eastern side where the “Red Hare” still stands.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Inkom%2C_Idaho",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Railroad tracks first ran through Inkom in 1889, bringing trappers, hunters, and settlers to the area.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://inkomcity.org/1744-2/inkom-city-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On June 16, 1902, 418,000 acres opened for white settlement, sparking a rush of homesteaders from Pocatello to Inkom.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://inkomcity.org/1744-2/inkom-city-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The iconic Red Hare rock formation still dominates Inkom’s skyline and appears in the city’s official logo.",
      "sourceSentenceIds": [
        13,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Inkom%2C_Idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Until about 2010, cement manufacturing was a major employer in Inkom, but a sharp decline left many workers laid off.",
