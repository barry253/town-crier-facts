  "facts": [
    {
      "id": 1,
      "text": "Fallston was incorporated in 1859 but has existed since 1796, marking over two centuries of continuous community life.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mail.bcpahistory.org/beavercounty/BeaverCountyCommunities/Fallston/Fallstonsstory.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Fallston Brick Company site now houses a steel construction firm that earned the American Institute of Steel Construction’s Architectural Award of Excellence in 1975.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mail.bcpahistory.org/beavercounty/BeaverCountyCommunities/Fallston/Fallstonsstory.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Col‑Fin Specialty Steel Corporation, founded in 1976, also operates in Fallston, underscoring the town’s long‑standing industrial roots.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mail.bcpahistory.org/beavercounty/BeaverCountyCommunities/Fallston/Fallstonsstory.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historical Society of Harford County preserves Fallston’s early mills—saw, oil, woolen, and paper—showing the town’s diverse manufacturing past.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.harfordhistory.net/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fallston’s landscape is semi‑rural, blending farms with suburban‑like developments that define its unique character.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fallston%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Bon Air, Little Falls Meetinghouse, and Rockdale, all from Fallston, are listed on the National Register of Historic Places.",
