  "facts": [
    {
      "id": 1,
      "text": "Waterford was founded around 1733 by Quaker Amos Janney, a Bucks County immigrant who named the town after his hometown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waterfordfoundation.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough proudly hosts the only statue of George Washington wearing a British uniform, a reminder of his 1753 mission to Fort Le Boeuf.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Le Boeuf sits just south of Waterford, feeding the French Creek watershed that eventually joins the Allegheny River.",
      "sourceSentenceIds": [
        14,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Waterford’s historic core, bounded by North Park Row, High Street, West First Street, and Walnut Street, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Eagle Hotel, a landmark in the borough, and the nearby Waterford Covered Bridge are both recognized on the National Register of Historic Places.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waterford%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Local civic life includes clubs such as the Waterford Garden Club, the Fort LeBoeuf Historical Society, and the Stancliff Hose Company, all rooted in community tradition.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
