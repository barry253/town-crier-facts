  "facts": [
    {
      "id": 1,
      "text": "Banks Lake South sits on the east side of the man‑made Banks Lake, formed by North Dam and Dry Falls Dam and fed by Lake Roosevelt.",
      "sourceSentenceIds": [
        15,
        16,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wdfw.wa.gov/places-to-go/wildlife-areas/banks-lake-wildlife-area-unit",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The surrounding wildlife area was acquired piece‑by‑piece from 1956 to 2003, preserving basalt cliffs and shrubsteppe habitat.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wdfw.wa.gov/places-to-go/wildlife-areas/banks-lake-wildlife-area-unit",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community lies within the Upper Grand Coulee valley, just south of Grand Coulee and north of Moses Lake.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Banks_Lake_South%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "A Discover Pass is required to access the WDFW lands around Banks Lake, unless you hold a hunting or fishing license.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wdfw.wa.gov/places-to-go/wildlife-areas/banks-lake-wildlife-area-unit",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The Banks Lake Unit is part of the larger Columbia Basin Wildlife Area, managed by the Washington Department of Fish & Wildlife.",
      "sourceSentenceIds": [
        25,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wdfw.wa.gov/places-to-go/wildlife-areas/banks-lake-wildlife-area-unit",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s shoreline features basalt cliffs and talus slopes, while the uplands host shallow soils and rocky outcrops typical of shrubsteppe.",
