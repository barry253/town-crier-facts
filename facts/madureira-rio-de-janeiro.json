  "facts": [
    {
      "id": 1,
      "text": "Madureira got its name from a 19th‑century cowboy, Lourenço Madureira, who owned the Fazenda do Campinho until 1851.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rolecarioca.com.br/en/roteiro/15/madureira.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s railway station opened in 1890, a gift of the Central do Brasil, and still echoes the era of early train travel.",
      "sourceSentenceIds": [
        2,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Madureira_Rio_de_Janeiro",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two samba schools, Portela and Império Serrano, call Madureira home, turning its streets into a living carnival stage every year.",
      "sourceSentenceIds": [
        24,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Madureira%2C_Rio_de_Janeiro",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1990, Madureira hosted Brazil’s largest charm ball, a historic celebration that drew crowds from across the country.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.rolecarioca.com.br/en/roteiro/15/madureira.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area once lay within the isolated rural holdings of the North Zone, but the 1896 station turned it into a bustling suburban hub.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Madureira_Rio_de_Janeiro",
      "category": "history",
      "quality": "good"
    },
    {
