      ],
      "source": "https://en.wikipedia.org/wiki/McArthur%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2021 the Vinton County Convention and Visitors Bureau bought the McArthur Hotel, launching a revitalization in 2022.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McArthur%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Originally called McArthurstown, the village honored General Duncan McArthur’s military leadership during the War of 1812.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/McArthur_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McArthur sits at the crossroads of U.S. Route 50 and Ohio State Route 93, a historic travel junction.",
