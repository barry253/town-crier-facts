      "id": 1,
      "text": "Nong Chok’s name comes from the Thai words for swamp and water spinach, reflecting the wetlands that once covered the area.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
