  "facts": [
    {
      "id": 1,
      "text": "Morristown was named after pioneer John Morris, who received land grants in 1787 that included present-day Hamblen and Jefferson counties.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morristown%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first railroad in Tennessee, the East Tennessee and Virginia Railroad, reached Morristown in 1858, turning the town into a regional rail hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morristown%2C_Tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Crockett Tavern Museum, listed on the National Register of Historic Places, occupies the site of a tavern that once hosted David “Davy” Crockett.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morristown%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1940s, the Tennessee Valley Authority built Cherokee Lake just north of Morristown, creating an artificial reservoir that now surrounds the city.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morristown%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s textile and furniture factories once drew workers from surrounding countryside, establishing Morristown as a regional economic powerhouse in the early 20th century.",
