  "facts": [
    {
      "id": 1,
      "text": "Hickory Ridge first got its post office in 1875, when the Brushy Lake Township post office was named after the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickory_Ridge%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town emerged in the 1870s as a small settlement during the post‑Civil War expansion into Arkansas’s rural areas.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_ridge_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Cotton Belt railway reached the area in 1882, Hickory Ridge prospered from timber and agriculture, and the post office reopened in 1892.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickory_Ridge%2C_Arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hickory Ridge incorporated in 1949, a late move that mirrored post‑World War II trends in rural Arkansas where towns sought municipal status to manage local governance.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_ridge_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city sits within the Mississippi embayment of the Delta, a flat fertile floodplain that shapes its agricultural landscape.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickory_Ridge%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Row agriculture dominates today, with soybeans and cotton leading, while commercial aquaculture—crawfish, baitfish, and catfish farms—is also common.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hickory_Ridge%2C_Arkansas",
