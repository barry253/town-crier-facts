  "facts": [
    {
      "id": 1,
      "text": "Homer was named after the Greek poet, laid out around the courthouse square in 1850 by Frank Vaughn.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homer%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The brick courthouse in Homer, built in Greek Revival style, is one of only four pre‑Civil War courthouses in Louisiana still in use.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homer%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oil was discovered in Homer in 1921, sparking a boom that helped the town thrive.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homer%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hotel Claiborne, built in 1890, became a state historic site in 1984 and once hosted many travelers during the town’s boom.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homer%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Across from the courthouse in Homer, the Ford Memorial Museum houses the oldest compressed bale of cotton in the U.S., a relic of the region’s cotton heritage.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homer%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After devastation in 1876, residents feared Homer would never recover, yet the town eventually rebounded and prospered.",
