      ],
      "source": "https://www.tshaonline.org/handbook/entries/samnorwood-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Samnorwood sits on Highway 83 in north‑central Collingsworth County, a shipping hub for the surrounding ranching and agricultural area.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/samnorwood-tx",
