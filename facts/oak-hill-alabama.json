  "facts": [
    {
      "id": 1,
      "text": "Oak Hill was first settled in the early 1820s by South Carolinians and Virginians, establishing a plantation led by the Jones family.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/oak-hill/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's original name was Arnold, but it was quickly renamed Oak Hill to reflect the surrounding oak trees.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/oak-hill/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oak Hill Academy opened in 1849, providing education for two decades before the building was razed in the 1940s.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/oak-hill/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cedarcrest, a private residence in Oak Hill, earned national recognition by being listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.atlasalabama.gov/municipalities/oak-hill/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early twentieth century, a lumber mill sparked renewed prosperity, and the town grew to include a cotton gin, blacksmith shop, and Masonic Lodge.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/oak-hill/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oak Hill sits on a ridge that historically protected settlers from malaria, a disease that plagued the low‑lying areas nearby.",
      "sourceSentenceIds": [
        24,
