  "facts": [
    {
      "id": 1,
      "text": "Moorefield was chartered in 1777 and named after Conrad Moore, who owned the land where the town was laid out.",
      "sourceSentenceIds": [
        1,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moorefield%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits where the South Branch Potomac River meets its South Fork, a spot that shaped early settlement patterns.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moorefield%2C_West_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Stone Tavern, Conrad Moore’s home, still stands on Main Street, a living reminder of the town’s founding era.",
      "sourceSentenceIds": [
