      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first railroad bridge near Westport appeared in 1859, just a few feet from the town’s original settlement.",
      "sourceSentenceIds": [
        6,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Westport%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic bridge built by Clinton County in 1852 was swept away by a flood in 1865 but later rebuilt, marking a resilient local engineering effort.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westport%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Westport sits above the Susquehanna River and lies near Pennsylvania Route 120, a detail that has guided travelers for generations.",
      "sourceSentenceIds": [
        15,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Westport%2C_Pennsylvania",
