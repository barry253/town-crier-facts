      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The Westport Museum for History and Culture, a nonprofit run by the Westport Historical Society, showcases the town’s four‑hundred‑year story through objects and oral histories.",
      "sourceSentenceIds": [
        2,
        8,
        3
      ],
