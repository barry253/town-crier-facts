  "facts": [
    {
      "id": 1,
      "text": "Founded in 1904 by Quaker families from Philadelphia, Pocono Lake Preserve covers 3,300 acres of forest and lakefront, bought in 1908 from the ice company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pocono_lake_preserve_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1900, a dam on the Tobyhanna and Upper Tunkhannock Creeks enlarged Pocono Lake for ice harvesting before it became a recreational spot.",
      "sourceSentenceIds": [
        22,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pocono_lake_preserve_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "What began as tent camping in 1904 evolved into 140 permanent “camps,” many of which have stayed in families for generations.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pocono_lake_preserve_pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Community life features Sunday worship groves, Friday night square dances, and youth‑led summer programs organized by high school and college residents.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pocono_lake_preserve_pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elevations range from about 1,600 to 1,800 feet, averaging 1,673 feet, creating gentle slopes that support extensive woodland.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pocono_lake_preserve_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pocono Lake Preserve sits on the north shore of Pocono Lake, just south of PA Route 940 between Blakeslee and Pocono Pines.",
      "sourceSentenceIds": [
        7
