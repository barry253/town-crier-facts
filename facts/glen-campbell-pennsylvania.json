  "facts": [
    {
      "id": 1,
      "text": "Glen Campbell was founded in 1889 as the first dedicated coal town in Indiana County by the Glenwood Coal Company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glen_campbell_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough was named for Cornelius Campbell, the first superintendent of the Glenwood Coal Company, whose Scottish word for valley explains the name.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Campbell%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1971 country singer Glen Campbell surprised residents with a visit that drew national attention to the tiny borough.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Campbell%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Allegheny Valley Railroad, integrated into the Pennsylvania Railroad by 1906, enabled coal shipments to Pittsburgh and beyond.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glen_campbell_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clark House, a historic home in Glen Campbell, was listed on the National Register of Historic Places in 2011.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glen_Campbell%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Company housing built by the Glenwood Coal Company accommodated hundreds of European immigrant miners during the town’s boom.",
      "sourceSentenceIds": [
