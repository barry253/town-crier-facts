  "facts": [
    {
      "id": 1,
      "text": "Redding became an official town in 1767, when the Connecticut General Assembly incorporated it with fewer than 1,000 residents.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://reddingct.gov/about-redding/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Danbury and Norwalk Railroad finished in 1852, adding depots to Georgetown, Topstone, and West Redding.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://reddingct.gov/about-redding/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Redding lists 230 historic structures on its State Historic Resource Inventory, and a project is underway to document out-buildings.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://reddingct.gov/about-redding/historic-homes/national-register-properties-in-redding/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Georgetown Historic District, which extends into Redding, received its National Register designation on January 21, 1987.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://reddingct.gov/about-redding/historic-homes/national-register-properties-in-redding/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1930s, building the Saugatuck Reservoir sparked controversy because it submerged historic areas.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://reddingct.gov/about-redding/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Redding's documented history continues to guide its future, and the town is creating a new history book that builds on Charles Burr Todd's classic.",
