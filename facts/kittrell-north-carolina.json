  "facts": [
    {
      "id": 1,
      "text": "Kittrell’s Depot, named for George Kittrell and his wife Elizabeth, opened after they donated land for a Raleigh and Gaston Railroad station.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kittrell%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first post office in Kittrell opened in 1854 with Elisha Overton as postmaster, soon after the depot began operations.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kittrell%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "James Episcopal Church and its rectory in Kittrell earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kittrell%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kittrell College once stood here, later becoming the campus of the Kittrell Job Corps Center.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kittrell%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During North Carolina’s “Golden Age” of spas, Kittrell hosted two luxury health hotels: the Davis Hotel and Kittrell Springs Hotel.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kittrell%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kittrell Township, centered around the depot, was created when Granville County divided into townships under a 1868 state law.",
