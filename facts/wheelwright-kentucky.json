  "facts": [
    {
      "id": 1,
      "text": "Wheelwright, Kentucky, a coal town founded in 1916 by the Elk Horn Coal Company, was named after company president Jere H.",
      "sourceSentenceIds": [
        1,
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.wheelwrighthistoricalsociety.com/history"
    },
    {
      "id": 2,
      "text": "When the city was founded, the coal company built housing, stores, churches, schools, and medical facilities to provide for the miners' families.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheelwright%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "The only entrance to Wheelwright is the Junction Bridge in Bypro, also called Wheelwright Junction, spanning state route 122.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheelwright%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "The Junction Bridge, now the Timothy Hall Memorial Bridge, was rebuilt in concrete in 1959 to honor Commissioner Timothy Hall.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheelwright%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Wheelwright was home to one of the pack horse libraries in the 1930s and early 1940s.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wheelwright%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "In 2018, Big Creek Missions purchased a former church building and turned it into a Christian Mission Retreat Center.",
