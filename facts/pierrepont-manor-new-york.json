    {
      "id": 1,
      "text": "Pierrepont Manor Historic District was listed on the National Register of Historic Places in 1977, preserving five key 19th‑century buildings.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pierrepont_manor_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1826 Federal‑style manor house, built by the Pierrepont family, still stands as the district’s centerpiece.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pierrepont_manor_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Zion Episcopal Church, erected in 1836 with later Gothic Revival additions, reflects the community’s early religious life.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pierrepont_manor_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Watertown & Rome Railroad arrived May 28, 1851, giving Pierrepont Manor its first rail link and sparking commercial growth.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pierrepont_manor_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A carriage barn built in 1826 features arched bays that once housed horses and equipment for the manor’s operations.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pierrepont_manor_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The hamlet’s post office opened November 29, 1843, marking its formal recognition as a community hub.",
