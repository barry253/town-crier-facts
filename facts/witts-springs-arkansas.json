  "facts": [
    {
      "id": 1,
      "text": "Witts Springs got its name from a stone carving of 'Witts' found at a spring east of town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/witts_springs_arkansas"
    },
    {
      "id": 2,
      "text": "Before the 19th century, the area that is now Witts Springs was part of Osage hunting territory, though no permanent Osage camps were found.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/witts_springs_arkansas"
    },
    {
      "id": 3,
      "text": "A post office opened in 1874, and the town grew with general stores, a blacksmith, grist and saw mills, and a tanning yard.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/witts_springs_arkansas"
    },
    {
      "id": 4,
      "text": "At its peak in the late 1800s, Witts Springs boasted six general stores and a single drug store.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/witts_springs_arkansas"
    },
    {
      "id": 5,
      "text": "Today, Witts Springs is a hub for outdoor adventures, offering hiking on the Ozark Highlands Trail, kayaking on Richland Creek, and rock climbing at Stack Rock.",
      "sourceSentenceIds": [
        9,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/witts_springs_arkansas"
    },
    {
      "id": 6,
      "text": "Witts Springs sits at about 1,900 feet on the Boston Mountains of the Ozark Plateau, giving it rugged terrain and scenic vistas.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/witts_springs_arkansas"
    }
  ],
