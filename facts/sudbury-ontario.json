  "facts": [
    {
      "id": 1,
      "text": "Sudbury was founded in 1883 after nickel ore was discovered during Canadian Pacific Railway construction, evolving from a mining town into a vibrant urban center.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://icasudbury.ca/Discover-Sudbury-ON.aspx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The interactive science museum focuses on geology and mining history and is home to the Big Nickel, one of Sudbury's most famous landmarks.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greater_Sudbury",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "SNOLAB, originally built for the Sudbury Neutrino Observatory, now operates as a leading underground particle physics laboratory.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greater_Sudbury",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city hosts the Up Here Festival, blending underground music with public murals, and the francophone La Nuit sur l'étang music event.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greater_Sudbury",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1970 a tornado struck Sudbury, one of Canada’s worst, causing significant damage and loss of life.",
