  "facts": [
    {
      "id": 1,
      "text": "Solvay takes its name from the Belgian inventors of the Solvay Process, whose chemical plant once dominated the village.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Solvay%2C_New_York"
    },
    {
      "id": 2,
      "text": "Founded in 1794 by James Geddes, the village was first called Geddesburgh before becoming Solvay in 1884.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solvay%2C_New_York"
    },
    {
      "id": 3,
      "text": "The Solvay Public Library, a Carnegie gift from 1902, earned a spot on the National Register of Historic Places in 2007.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solvay%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Solvay Process plant, once owned by Allied Chemical, shut down in 1985, leaving the village to reinvent itself.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solvay%2C_New_York"
    },
    {
      "id": 5,
      "text": "Solvay sits just west of Syracuse, south of Onondaga Lake, and the Erie Canal still cuts through its streets.",
      "sourceSentenceIds": [
