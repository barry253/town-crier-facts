  "facts": [
    {
      "id": 1,
      "text": "Coos Bay was founded as Marshfield in 1853, named after the Massachusetts hometown of its founder, J. C. Tolman.",
      "sourceSentenceIds": [
        2,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Coos_Bay%2C_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city celebrated its 150th birthday in 2024, marking a sesquicentennial that included a big birthday party at the Coos History Museum.",
      "sourceSentenceIds": [
        17,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.oregonsadventurecoast.com/blog/10-interesting-facts-about-coos-bay-s-150-year-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nelson Machine Works, one of the nation’s oldest still‑operating machine shops, opened in Coos Bay in 1888 and remains a historic landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coos_Bay%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1999, the Japanese freighter New Carissa ran aground near Coos Bay, drawing international attention to the area’s busy waterfront.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coos_Bay%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Coos Historical & Maritime Center, an 11,000‑square‑foot museum, sits on a 3‑acre site along Coos Bay’s historic waterfront.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coos_Bay%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Coos Bay’s rail history includes the Central Oregon and Pacific Railroad, which linked the port to the national rail network.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coos_Bay%2C_Oregon",
