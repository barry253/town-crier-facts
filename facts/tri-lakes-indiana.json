  "facts": [
    {
      "id": 1,
      "text": "Tri‑Lakes sits on land that once belonged to the Miami and Potawatomi tribes, whose ancestral villages dotted the northern Indiana plains.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tri_lakes_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s humid continental climate, with about 38 inches of rain each year, keeps the three glacial lakes fed and lively.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tri_lakes_indiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tri‑Lakes earned its name from three interconnected glacial lakes—Shriner, Round, and Cedar—forming a natural waterway system.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/tri-lakes-193290",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Glacial retreat during the Wisconsin epoch carved the deep, clear basins that now hold Tri‑Lakes’ signature lakes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/tri-lakes-193290",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Tri‑Lakes became a resort hotspot, with postcard‑era cottages and boating scenes drawing visitors from afar.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tri_lakes_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cedar Lake, the largest at 144 acres, connects to the other lakes via channels, creating a unified water system that supports local wildlife.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tri_lakes_indiana",
