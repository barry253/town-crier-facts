  "facts": [
    {
      "id": 1,
      "text": "Frederickson’s name means “son of the peaceful ruler,” tracing back to the Old High German elements fridu and ric.",
      "sourceSentenceIds": [
        2,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/frederickson-20793",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled in Pierce County, Frederickson sits within the Puget Sound region, surrounded by temperate rainforests and the Cascade Mountains.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/frederickson-20793",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historically an agricultural hub, Frederickson has recently grown into a logistics and manufacturing center thanks to its strategic transport links.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/frederickson-20793",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "While not a major tourist spot itself, Frederickson offers easy access to Tacoma’s attractions and Washington’s natural beauty for outdoor adventures.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/frederickson-20793",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community enjoys a long day in summer, with sunrise at 6:56 am and sunset at 8:55 pm, giving drivers plenty of daylight.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/washington_frederickson",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Frederickson remains an unincorporated community, meaning it lacks its own municipal government and relies on county services.",
