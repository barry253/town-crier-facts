      "quality": "good"
    },
    {
      "id": 3,
      "text": "Scenic is part of the Arizona Strip, a remote region north of the Grand Canyon with flat to gently rolling desert terrain.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scenic_arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The area experiences a hot desert climate, with extremely hot summers, chilly winters, and low humidity throughout the year.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scenic_arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Annual precipitation averages just 5.3 inches, mostly falling in February and during the summer monsoon from July to September.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scenic_arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The limited rainfall and desert terrain create occasional flash floods from monsoon storms and frequent dust storms in spring.",
