  "facts": [
    {
      "id": 1,
      "text": "Delft Colony’s name echoes Dutch roots, named after Bartsch’s hometown of Delft, Minnesota, itself founded by immigrants from Delft in the Netherlands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/delft_colony_california",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mennonite settler Bartsch built Delft Colony as a ministry to house Dust‑Bowl refugees from Arkansas and Oklahoma.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/delft_colony_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers, called Okies and Arkies, worked in cotton fields owned by Mennonite farmers, fueling the region’s agriculture.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/delft_colony_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Post‑1900 irrigation projects using the Kings River shifted Tulare County from dry wheat to intensive cotton, fruit, and vegetable farming.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/delft_colony_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2012, Tulare County’s General Plan 2030 Update formally recognized Delft Colony as a hamlet within the county’s planning framework.",
      "sourceSentenceIds": [
