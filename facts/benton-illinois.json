  "facts": [
    {
      "id": 1,
      "text": "Founded in 1841, Benton became Franklin County’s seat and built its first courthouse in the town square in 1874.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.iml.org/page.cfm?key=29763&parent=5281"
    },
    {
      "id": 2,
      "text": "The 1905 Franklin County Jail, restored and listed on the National Register, now serves as an interpretive museum and tourism office.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bentonil.com/?page_id=345"
    },
    {
      "id": 3,
      "text": "Benton’s early growth sprang from high‑sulfur coal, fertile soil, and a network of railroads that still crisscross the town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benton%2C_Illinois"
    },
    {
      "id": 4,
      "text": "The town library offers a unique brick‑engraving program where patrons can pay to have their names etched into a public brick.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benton%2C_Illinois"
    },
    {
      "id": 5,
      "text": "In 1963, George Harrison visited Benton, and a historical marker now tells the story of his first U.S. stop.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bentonil.com/?page_id=345"
    },
    {
      "id": 6,
      "text": "After 148 years, the original courthouse was replaced in 2022 by a new 46,000‑square‑foot building that remains the town’s centerpiece.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
