  "facts": [
    {
      "id": 1,
      "text": "Founded in 1885, Thornton grew as the last settled town in the area, with residents planting trees and parks to overcome challenging land.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/thornton_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before Thornton's official founding, pioneers began settling the region in the 1850s, claiming land around Clear Lake and other waterways.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/thornton_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad shortly after 1885 sparked Thornton's growth, enabling grain and other agricultural products to reach larger markets.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/thornton_iowa",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Thornton celebrates Heritage Days each year, a tradition that evolved from the 1908 Roast Oxen Day festival featuring barbecues, parades, and contests.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/thornton_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Residents enjoy a public library, a community center, and two parks, all maintained by dedicated city staff who keep Thornton running smoothly.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofthorntonia.com/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Thornton's historic hardware store has been a staple for local farmers and travelers since the town's early days.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
