  "facts": [
    {
      "id": 1,
      "text": "Annawan was named after a Wampanoag chief from Massachusetts, though some say it honors a local Winnebago chief of the same name.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annawan%2C_Illinois"
    },
    {
      "id": 2,
      "text": "When the Chicago, Rock Island and Pacific Railroad surveyed the line in 1850, landowners Charles Atkinson and James Grant plotted Annawan in 1853.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annawan%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Daniel Morton built the first log cabin in 1846, and by the next year a schoolhouse stood on his property.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annawan%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Early settlers found the land a swampy marsh to the north, with Green River running parallel to what is now Interstate 80.",
