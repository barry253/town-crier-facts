  "facts": [
    {
      "id": 1,
      "text": "Woodstock was first settled in the 1820s, when William Houston received a formal land grant on February 27, 1826.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
