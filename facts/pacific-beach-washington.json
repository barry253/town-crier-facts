  "facts": [
    {
      "id": 1,
      "text": "Pacific Beach turned into a tourist hotspot after the Northern Pacific Railroad spur line reached the area in the early 1900s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/pacific-beach-state-park-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1942 the U.S. Navy repurposed the Pacific Beach Hotel into an anti‑aircraft‑gunnery training base.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/pacific-beach-state-park-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the training base closed in 1945, an Air Force radar station opened on the site in 1948 to close a coastal detection gap.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pacificbeachwa.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1958 the Navy launched a classified SOSUS station at Pacific Beach, helping pinpoint submarine movements across the Pacific.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/pacific-beach-state-park-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By the early 1970s Norman and Helen Ross founded Ross Campground near Joe Creek’s mouth, capitalizing on the area’s revived vacation traffic.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://parks.wa.gov/about/news-center/field-guide-blog/pacific-beach-state-park-history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pacific Beach State Park sits on land ceded by Coast Salish tribes in the 1855 Treaty of Quinault River, preserving traditional fishing rights.",
      "sourceSentenceIds": [
        18,
