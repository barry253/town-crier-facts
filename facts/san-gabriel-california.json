  "facts": [
    {
      "id": 1,
      "text": "San Gabriel was founded by the Spanish in 1771 when Mission San Gabriel Arcángel was established by Saint Junípero Serra.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Gabriel%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The mission earned the nickname 'Pride of the California Missions' as the fourth of twenty-one Spanish missions in the state.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Gabriel%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "San Gabriel’s historic district features City Hall, the Mission Playhouse, and the Arcade Building, once home to a department store, market, barber shop, and drug store.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sangabrielcity.com/78/History-of-San-Gabriel",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dubbed the 'Birthplace of the Los Angeles Region,' San Gabriel’s mission laid the foundation for the surrounding communities.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Gabriel%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Near the Playhouse, the Grapevine Arbor houses a descendant of the Mission’s original 'Mother Vine' planted in 1861.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sangabrielcity.com/78/History-of-San-Gabriel",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "San Gabriel is the oldest settlement in Los Angeles County, located in the valley beneath the San Gabriel Mountains.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lacountylibrary.org/sangabriel-local-history/",
      "category": "history",
      "quality": "good"
