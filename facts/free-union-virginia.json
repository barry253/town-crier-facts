  "facts": [
    {
      "id": 1,
      "text": "Free Union was once called Nicksville, named after a free slave blacksmith named Nick who opened a shop there in the early 1800s.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Free_Union%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ballard‑Maupin House, one of the oldest homes in the area, was added to the National Register of Historic Places in 1999.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Free_Union%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Free Union’s area was first settled in the mid‑1700s and became part of Albemarle County in 1761.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.cvillepedia.org/Free_Union",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community still hosts the historic Free Union Country School, a private institution that has served local families for generations.",
