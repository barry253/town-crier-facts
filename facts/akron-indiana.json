  "facts": [
    {
      "id": 1,
      "text": "On July 4 1836, Joseph Sippy led 47 settlers to the crossroads of the Pottawatomie and Miami trails, founding Akron.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akron%2C_Indiana"
    },
    {
      "id": 2,
      "text": "In 1855, settlers renamed the town Akron, after the Ohio city, replacing its original name Newark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akron%2C_Indiana"
    },
    {
      "id": 3,
      "text": "The first structure in Akron was erected where the Methodist church now stands.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Akron%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Akron hosts a free lending library, the Akron Carnegie Public Library, serving the community.",
      "sourceSentenceIds": [
        5
