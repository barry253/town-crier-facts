      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Just outside Keeseville, the Ausable Chasm—one of North America’s oldest attractions—draws hikers into a 2‑mile gorge.",
      "sourceSentenceIds": [
        10,
        30
      ],
      "sourceLabels": [
