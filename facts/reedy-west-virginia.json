    },
    {
      "id": 2,
      "text": "Originally known as Three Forks of Reedy, the community became known simply as Reedy in the mid-nineteenth century.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/reedy-west-virginia/"
    },
    {
      "id": 3,
      "text": "Settlement in the Reedy Creek country began during the early nineteenth century and the town was incorporated in 1894.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/reedy-west-virginia/"
    },
    {
      "id": 4,
      "text": "The town of Reedy is home to the historic Robey Theatre and hosts the annual West Virginia Black Walnut Festival.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/reedy-west-virginia/"
    },
    {
      "id": 5,
      "text": "Downtown Reedy features a historic post office and grocery store that served people across the rural countryside.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/reedy-west-virginia/"
    },
    {
      "id": 6,
      "text": "Reedy developed where early roads and waterways converged along the rolling hill country of central West Virginia.",
