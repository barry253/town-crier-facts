  "facts": [
    {
      "id": 1,
      "text": "The Silos sits on the west shore of Canyon Ferry Lake, a reservoir on the Missouri River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Silos%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The brick silos were built around 1920 by rancher Cook to store sheep feed along the Missouri River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montanahistoriclandscape.com/2021/07/11/the-silos-of-canyon-ferry-lake-then-and-now/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Canyon Ferry Dam was completed in the 1950s, the lake flooded the ranching area, but the silos survived as a relic.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montanahistoriclandscape.com/2021/07/11/the-silos-of-canyon-ferry-lake-then-and-now/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2021, the community began restoring the silos, turning them from lonely structures into a well‑known local landmark.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://montanahistoriclandscape.com/2021/07/11/the-silos-of-canyon-ferry-lake-then-and-now/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Silos is a census‑designated place, not a legal municipality, and has no governmental functions.",
      "sourceSentenceIds": [
        10
      ],
