      "quality": "good"
    },
    {
      "id": 2,
      "text": "The college’s 1,100‑acre campus houses the stunning Toccoa Falls waterfall.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.americasstateparks.org/state-park/toccoa-falls/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Toccoa Falls itself sits within the boundaries of the college campus, making it a natural centerpiece of the school.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.americasstateparks.org/state-park/toccoa-falls/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Just five miles south of Toccoa, Currahee Mountain served as a World War II training site for paratroopers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.americasstateparks.org/state-park/toccoa-falls/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paratroopers who trained on Currahee Mountain later formed the 506th Parachute Infantry Regiment, featured in the HBO series Band of Brothers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.americasstateparks.org/state-park/toccoa-falls/",
      "category": "people",
      "quality": "good"
    },
    {
