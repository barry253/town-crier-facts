  "facts": [
    {
      "id": 1,
      "text": "The town’s name came from a riverboat captain who was reading Thaddeus of Warsaw by Jane Porter when it was founded.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Warsaw began in 1798 as a river landing called Great Landing on the Ohio River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city’s courthouse, built in the 19th century, remains the oldest operating courthouse in Kentucky.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Henry Yates House, a log structure built around 1809, is Warsaw’s oldest surviving home.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warsaw%2C_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic downtown Warsaw still showcases homes and businesses that capture the charm of an Ohio River town.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitgallatincountyky.com/local-attractions/city-of-warsaw/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Warsaw’s Historic District, encompassing the town’s core, was added to the National Register of Historic Places in 1982.",
