      ],
      "source": "https://en.wikipedia.org/wiki/Hinckley%2C_Utah"
    },
    {
      "id": 2,
      "text": "Originally called Bloomington, Hinckley was renamed in 1891 to honor Ira N. Hinckley, an early Latter Day Saint leader.",
      "sourceSentenceIds": [
        2,
        3,
        25,
        30
      ],
