  "facts": [
    {
      "id": 1,
      "text": "Sammamish’s name comes from the Lushootseed word sc̓ababš, meaning “meander dwellers,” echoing the area’s historic Native American roots.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammamish%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits on a plateau bordered by Lake Sammamish to the west and the Snoqualmie Valley to the east, giving it a unique topography.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammamish%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After a 1991 vote to join Issaquah failed, residents approved incorporation in 1998, and Sammamish became an official city on August 31, 1999.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammamish%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Sammamish, the city’s namesake, covers 1,200 acres and has long drawn residents to its shores and trails.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammamish%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2024, construction began on 38 townhomes in a new downtown phase, advancing Sammamish’s plan for a denser, mixed‑use center.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammamish%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Council meetings happen at City Hall, part of Sammamish Commons, which also hosts the Sammamish Library, a King County Library System branch.",
