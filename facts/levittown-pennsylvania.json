  "facts": [
    {
      "id": 1,
      "text": "Levittown actually consists of four distinct developments—Green Acres, Levitt, Omega, and Miller—built from the 1930s through the 1950s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/"
    },
    {
      "id": 2,
      "text": "The Little Red Schoolhouse, built in 1876, remains the oldest surviving building in Levittown.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/"
    },
    {
      "id": 3,
      "text": "In 1985, a historic landmark was designated on Old Jerusalem Road across from MacArthur High School.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/"
    },
    {
      "id": 4,
      "text": "The Central Branch of the Long Island Rail Road ran through future Levittown from 1871 until the 1930s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/"
    },
    {
      "id": 5,
      "text": "The Vanderbilt Cup Race drew 250,000 spectators to the area between 1908 and 1910.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/"
    },
    {
      "id": 6,
      "text": "Levittown’s name comes from developer William Levitt, who bought farmland after a pest outbreak in the 1940s.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://levittownpl.org/levittown-history-collection/facts-and-trivia/"
    }
  ]
