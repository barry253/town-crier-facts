  "facts": [
    {
      "id": 1,
      "text": "Lakewood Park was established in the early 1980s as a planned residential and recreational subdivision on over 800 acres of land.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakewood_park_tennessee"
    },
    {
      "id": 2,
      "text": "The community features a private no-wake lake used for fishing and scenic views.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakewood_park_tennessee"
    },
    {
      "id": 3,
      "text": "Lakewood Park sits at an elevation of 1,204 feet above sea level, contributing to its scenic lakeside appeal.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakewood_park_tennessee"
    },
    {
      "id": 4,
      "text": "A designated beach area along one of the lakes provides a space for swimming and community use.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakewood_park_tennessee"
    },
    {
      "id": 5,
      "text": "Environmental restrictions in Lakewood Park prohibit open fires in common areas and ban projectile hunting across all properties.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lakewood_park_tennessee"
    },
    {
      "id": 6,
      "text": "The original developer filed for bankruptcy before completion, leaving Lakewood Park as a structured, owner-managed community.",
