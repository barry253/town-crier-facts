      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At 2,060 feet above sea level, Chalk Hill enjoys cooler summers and heavy snowfall, averaging 88.8 inches annually.",
      "sourceSentenceIds": [
        17,
        21
      ],
      "sourceLabels": [
        "Web source 1"
