  "facts": [
    {
      "id": 1,
      "text": "New Castle is the only town in Craig County and serves as its county seat.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Castle%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The 1851 Craig County Courthouse, built when New Castle became the seat, still shows saber cuts from Union troops.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/268-0013/"
    },
    {
      "id": 3,
      "text": "The courthouse square is flanked by a Greek‑Revival jail and the antebellum Central Hotel, a two‑tier tavern that once hosted county leaders.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/268-0013/"
    },
    {
      "id": 4,
      "text": "New Castle sits at the crossroads of State Routes 311, 42, and 615, anchoring the town’s historic commercial core.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Castle%2C_Virginia"
    },
    {
      "id": 5,
      "text": "The town’s historic district, expanded in 1993, features typical two‑story frame stores with false‑front parapets and large display windows.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/268-0013/"
    },
    {
      "id": 6,
      "text": "Located at 37°30′3″N 80°6′39″W, New Castle lies just north of the Sinking Creek Valley Cluster within the Jefferson National Forest’s “Mountain Treasures.”.",
      "sourceSentenceIds": [
        7,
        9
      ],
