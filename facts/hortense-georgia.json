  "facts": [
    {
      "id": 1,
      "text": "Hortense emerged in the late nineteenth century as a timber and turpentine hub in what would become Brantley County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hortense_georgia"
    },
    {
      "id": 2,
      "text": "The 1902 railroad intersection at Hortense opened a new market for pine products, sparking a boom in logging and turpentine.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hortense_georgia"
    },
    {
      "id": 3,
      "text": "When Brantley County was created on August 14, 1920, Hortense became an unincorporated community within the new jurisdiction.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hortense_georgia"
    },
    {
      "id": 4,
      "text": "Hortense sits at 56 feet above sea level where U.S. 301 meets Georgia 32, a key crossroads in southeastern Georgia.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hortense%2C_Georgia"
    },
    {
      "id": 5,
      "text": "Until about 1950, roughly 80 percent of Brantley County was forested, sustaining the local timber industry.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hortense_georgia"
    },
    {
      "id": 6,
      "text": "The community straddles Brantley and Wayne counties, with a small portion extending into the neighboring county.",
      "sourceSentenceIds": [
