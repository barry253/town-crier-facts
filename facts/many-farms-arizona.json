  "facts": [
    {
      "id": 1,
      "text": "Many Farms, Arizona derives its name from the Navajo term meaning 'Water Stringing Out in Rivulets,' reflecting the area's historic water routes.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://manyfarms.navajochapters.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled in northeastern Arizona, Many Farms sits within the central region of the Navajo Nation, a unique cultural enclave.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://manyfarms.navajochapters.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Irrigation reached Many Farms in 1937, transforming the area into fully irrigated farmland and boosting local agriculture.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Many_Farms%2C_Arizona",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Between 1952 and 1962, Many Farms hosted two major medical experiments led by researcher Walsh McDermott.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Many_Farms%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first of those experiments tested the tuberculosis drug isoniazid, aiming to reduce fatal TB rates among the Navajo.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Many_Farms%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Many Farms High School, operated by the Bureau of Indian Education, serves as the area's secondary education hub.",
