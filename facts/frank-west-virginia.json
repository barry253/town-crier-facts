  "facts": [
    {
      "id": 1,
      "text": "Frank was named to honor Frank Hoffman, who was the proprietor of a local tannery.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frank%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The community developed around the tanning industry in 1904 to capitalize on the region's abundant hemlock forests.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frank_west_virginia"
    },
    {
      "id": 3,
      "text": "Frank once hosted the largest tannery in West Virginia and one of the world's leading producers of sole leather.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frank_west_virginia"
    },
    {
      "id": 4,
      "text": "Frank sits at an elevation of about 2,772 feet, characteristic of the higher plateaus in this part of the state.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frank_west_virginia"
    },
    {
      "id": 5,
      "text": "Efforts are underway to repurpose a 1942 office building into a museum highlighting the leather industry's impact on the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frank_west_virginia"
    },
    {
      "id": 6,
      "text": "Indigenous peoples, including the Shawnee and Cherokee, historically traversed the area around Frank for hunting and travel.",
