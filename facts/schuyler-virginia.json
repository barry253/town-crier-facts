  "facts": [
    {
      "id": 1,
      "text": "Schuyler was renamed in 1882 after mill operator Schuyler George Walker, who also served as the first postmaster.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around soapstone quarrying, with the Alberene Stone Company cutting native soapstone into flat slabs for labs and hospitals.",
      "sourceSentenceIds": [
        9,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Schuyler’s historic district, listed on the National Register in 2007, showcases early 20th‑century mill architecture and company‑built homes.",
      "sourceSentenceIds": [
        16,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hamner House, the boyhood home of author Earl Hamner Jr., is a key landmark in the Schuyler Historic District.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/062-5002/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Schuyler’s soapstone industry collapsed during the Great Depression, and the area never fully recovered.",
      "sourceSentenceIds": [
        10,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Schuyler%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town endured Hurricane Camille in 1969, when two to three feet of rain flooded the upper mountain creeks and devastated the region.",
      "sourceSentenceIds": [
        15,
