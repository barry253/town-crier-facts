    },
    {
      "id": 2,
      "text": "In 1882 the Port Huron & Northwestern Railroad reached Clifford, turning the village into a key junction that linked it to larger markets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
