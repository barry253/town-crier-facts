  "facts": [
    {
      "id": 1,
      "text": "Clifford takes its name from Clifford Lyman, the first child born in the settlement, whose father became the village’s first postmaster.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifford%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1882 the Port Huron & Northwestern Railroad reached Clifford, turning the village into a key junction that linked it to larger markets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clifford_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s origins trace back to a crossroads where a State road met the north‑south center road of Burlington Township in 1862.",
      "sourceSentenceIds": [
        8,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/clifford_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Unlike many Michigan towns, Clifford sits entirely within Burlington Township and contains no major rivers, lakes, or prominent natural landmarks.",
