  "facts": [
    {
      "id": 1,
      "text": "The Village of Athens sits on the west bank of the Hudson River, just four miles north of the Rip Van Winkle Bridge.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://athensvillageny.gov/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Town of Athens was established on February 25, 1815, carved from parts of Catskill and Coxsackie.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofathensny.gov/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "More than 300 buildings in Athens are listed on national and state historic registers, making it a living museum of American architecture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofathensny.gov/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Athens’ small, friendly community blends artisans, business people, and families who cherish the village’s historic charm.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://athensvillageny.gov/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The eastern town line follows the Hudson River, marking the border with Columbia County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Athens%2C_New_York",
      "category": "other",
