  "facts": [
    {
      "id": 1,
      "text": "Shelly was founded in the late 19th century and named after early trapper John Shely, who settled the area in 1870.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Shelly%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The town’s Main Street runs crooked because the 1897 plat aligned streets to the northeast‑running railroad tracks.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/shelly_minnesota"
    },
    {
      "id": 3,
      "text": "The Red River History Museum, an Art Deco building, is a hidden gem that showcases the region’s prairie heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shellymn.com/"
    },
    {
      "id": 4,
      "text": "Shelly’s identity has long been tied to agriculture and Norwegian settler culture, with institutions like the Good Templar Lodge and a post office that has operated since 1896.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/shelly_minnesota"
    },
    {
      "id": 5,
      "text": "The spelling “Shelly” was adopted to avoid confusion with the already existing Shely Township, which was organized in 1874.",
      "sourceSentenceIds": [
        8,
        1
      ],
      "sourceLabels": [
