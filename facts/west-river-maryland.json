      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Quakers settled West River in the 1660s, drawn by Maryland’s religious tolerance under the Lords Baltimore.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
