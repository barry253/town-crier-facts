      ],
      "source": "https://grokipedia.com/page/west_river_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The West River Sailing Club, founded in 1930, still hosts regattas and sailing lessons on the sheltered waters.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
