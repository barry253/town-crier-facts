  "facts": [
    {
      "id": 1,
      "text": "Lisbon was founded in 1810 by Caleb Pancoast, who originally called it New Lisbon before shortening the name.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The National Road, now Maryland Route 144, cuts through Lisbon, linking Baltimore to Frederick and passing the historic 1804 Caleb Pancoast House.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lisbon sits where the Patapsco River meets the B&O Railroad, a crossing that once powered the town’s stagecoach traffic.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1993, Lisbon opened Maryland’s first roundabout, a unique traffic feature still visible on the town’s main road.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s early school history includes the single‑room Annapolis Rock School, built in 1894 and used until 1943.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lisbon’s Carr’s Mill Landfill, the county’s second landfill, closed in 1977 after years of toxic dumping concerns.",
