  "facts": [
    {
      "id": 1,
      "text": "Bald Eagle, Pennsylvania, takes its name from Munsee Lenni Lenape chief Woapalanne, whose name means 'bald eagle'.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/bald-eagle-state-park/history"
    },
    {
      "id": 2,
      "text": "The Foster Joseph Sayers Dam honors a World War II Private First Class who received the Medal of Honor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/bald-eagle-state-park/history"
    },
    {
      "id": 3,
      "text": "Bald Eagle State Park opened to the public on July 4 1971, offering 1,200 acres of forest and water recreation.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/bald-eagle-state-park/history"
    },
    {
      "id": 4,
      "text": "The town sits in the Bald Eagle Valley at the foot of Bald Eagle Mountain ridge, beside Big Fill Run near Bald Eagle Creek’s headwaters.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bald_Eagle%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "In the 1800s loggers felled pine, chestnut, oak, and hickory on Bald Eagle Mountain to fuel charcoal furnaces, later replaced by farmland.",
      "sourceSentenceIds": [
        11,
        12,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.pa.gov/agencies/dcnr/recreation/where-to-go/state-parks/find-a-park/bald-eagle-state-park/history"
    },
    {
      "id": 6,
      "text": "The 100‑foot‑high, 1.3‑mile long Foster Joseph Sayers Dam, completed in 1969, was built to reduce downstream flood damage.",
      "sourceSentenceIds": [
        15
      ],
