  "facts": [
    {
      "id": 1,
      "text": "Lefors was founded in 1888 by Travis Leach, Perry LeFors, Henry Thut, and Henry B. Lovett.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lefors%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Perry LeFors, who became foreman of the Diamond F Ranch and later joined the White Deer Lands Trust.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lefors%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1932 the Fort Worth and Denver Railway extended its line from Pampa, giving Lefors its first railroad.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lefors%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A two‑story frame courthouse costing less than $2,500 was built, and Thut erected a hotel, marking early civic growth.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lefors%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lefors became the county seat when Gray County organized on May 27, 1902.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lefors%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s middle‑school teams, the Lefors Pirates and Bandits, play six‑man football on newly refurbished grounds each fall.",
