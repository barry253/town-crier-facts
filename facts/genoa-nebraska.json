  "facts": [
    {
      "id": 1,
      "text": "Genoa was founded by Mormon pioneers in 1857 as a way‑station for emigrants traveling west.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Genoa%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the fall of 1859, the Mormon colony abandoned Genoa when the area became part of the new Pawnee Reservation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Genoa%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s early settlers planted maize, beans, squash, and sunflowers each spring before hunting, harvesting them in the fall.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ci.genoa.ne.us/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Genoa housed the Genoa Indian Industrial School, an American Indian boarding school that operated in the early 20th century.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Genoa%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the Mormons left, the Pawnee Indian Agency used the vacated structures to serve the local tribe.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Genoa%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Visitors can explore Genoa’s heritage at the Genoa Historical Museum, which showcases artifacts from the town’s pioneer era.",
