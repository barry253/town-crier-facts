  "facts": [
    {
      "id": 1,
      "text": "Elk River’s Champion Tree, a cedar over 3,000 years old, stands proudly as the town’s living landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
