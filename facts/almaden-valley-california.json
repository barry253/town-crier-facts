  "facts": [
    {
      "id": 1,
      "text": "Almaden Valley derives its name from the Spanish mining town Almadén, where mercury mining dates back to Roman times.",
      "sourceSentenceIds": [
        1,
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Almaden_Valley%2C_San_Jose",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1820s Mexican miners discovered mercury on Rancho Los Capitancillos, sparking the New Almaden mines that became California's first commercial mercury operation.",
      "sourceSentenceIds": [
        1,
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Almaden_Valley%2C_San_Jose",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Graystone Quarry, once a major Bay Area quarry, supplied stone for San Francisco City Hall and Stanford University.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Almaden_Valley%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Almaden Quicksilver County Park preserves over 4,000 acres of scenic views and the historic New Almaden Quicksilver Mines.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sanjose.org/neighborhoods/almaden-valley",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Almaden Vineyards, founded in 1852 by Charles LeFranc, was California's first commercial winery and later moved to Madera.",
      "sourceSentenceIds": [
        9,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Almaden_Valley%2C_San_Jose",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Old Almaden Winery, now a public park and California Historic Landmark, hosts interpretive exhibits about the mines and workers.",
