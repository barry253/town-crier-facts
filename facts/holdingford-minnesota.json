    {
      "id": 1,
      "text": "Holdingford was named after Irish pioneer Randolph Holding who arrived in 1868.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://holdingford.gov/history-of-holdingford/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally called the 'Scotch Settlement' and was settled by Scottish-Canadian families from clans Stewart, MacArthur, Campbell, Kennedy, and MacPherson.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdingford%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Soo Line Railroad ran through Holdingford between 1907 and 1909, linking the town to regional trade.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://holdingford.gov/history-of-holdingford/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1908, the local newspaper 'The Advertizer' began publishing, becoming a key voice for the community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://holdingford.gov/history-of-holdingford/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Slovak Congregational Church, founded in 1886 by theology student John Sabol, remains a historic landmark across a country road from the former St. site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holdingford%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Holdingford calls itself 'The Gateway to Lake Wobegon,' referencing the fictional town created by Garrison Keillor.",
