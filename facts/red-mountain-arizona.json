  "facts": [
    {
      "id": 1,
      "text": "Red Mountain is a volcanic cinder cone 25 miles northwest of Flagstaff, rising 1,000 feet above the surrounding terrain.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Mountain_(Coconino_County%2C_Arizona)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The cone’s distinctive U‑shape opens to the west and contains a large natural amphitheater on its northeast flank.",
      "sourceSentenceIds": [
        4,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Mountain_(Coconino_County%2C_Arizona)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Erosional pillars called “hoodoos” and dark mineral crystals decorate the amphitheater’s walls.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fs.usda.gov/r03/coconino/recreation/trails/red-mountain-trail-no-159",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Scientists estimate the volcano erupted about 740,000 years ago.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Mountain_(Coconino_County%2C_Arizona)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The trail to the amphitheater is a mild walk with a gradual climb and a short ladder near the end to reach a 6‑foot rise.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fs.usda.gov/r03/coconino/recreation/trails/red-mountain-trail-no-159",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Vegetation at 7,200 feet includes pinyon‑juniper pines, grass, sagebrush, and occasional wildflowers, offering wide views across the plains.",
