  "facts": [
    {
      "id": 1,
      "text": "Incline Village was named after the Great Incline Tramway built by loggers in 1878.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thelifeofluxury.com/incline-village-at-lake-tahoe-an-historic-past/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name also honors the Sierra Nevada Wood and Lumber Company’s incline railway that hauled timber up 1,400 feet.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Incline_Village%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Incline Village and Crystal Bay Historical Society, founded in 1976, preserves local heritage and sponsors events like Crystal Bay History Day.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/18626",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Chateau at Incline Village, the town hall, and Crystal Bay Cottage are among sites the Historical Society has worked to preserve.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://museumsdatabase.com/museums/view/18626",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Incline Village hosts the Diamond Peak Ski Resort, the only ski resort owned by a community in Nevada.",
