  "facts": [
    {
      "id": 1,
      "text": "Chanhassen’s name comes from the Dakota word for “sugar maple tree,” chosen by Clarissa Cleaveland in the 1850s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chanhassenmn.gov/residents/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Village of Chanhassen was officially incorporated in 1896, thanks to the arrival of the Paul Railroad.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chanhassenmn.gov/residents/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A log house built on Henry Pauly Sr.’s donated land became the historic church that now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chanhassenmn.gov/residents/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first land claim in Chanhassen Township was filed in June 1852 by Joseph Vogel near Rice Lake.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chanhassenmn.gov/residents/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, home‑builder Herb Bloomberg opened a lumber and hardware store in Chanhassen to supply specialty wood.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chanhassenmn.gov/residents/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Chanhassen evolved from a quiet town into a thriving Twin Cities suburb over the past few decades.",
