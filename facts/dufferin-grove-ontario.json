    {
      "id": 1,
      "text": "Dufferin Grove’s streets were once lined with grand country villas, including Dover Court, Rush Holme, and Heydon Villa.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dufferin_Grove",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Most houses in Dufferin Grove were built between 1890 and 1930, showcasing Victorian, Edwardian, and English Cottage styles.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dufferin_Grove",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dufferin Grove is known for its green streets, large gardens, and a popular community park that attracts families every weekend.",
      "sourceSentenceIds": [
        9,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dufferin_Grove",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Dufferin bus links riders to the Dufferin subway station on the Bloor‑Danforth line, while the Dovercourt and Ossington buses connect to Ossington station.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
