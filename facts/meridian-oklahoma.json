  "facts": [
    {
      "id": 1,
      "text": "Non-Indians settled the west side of Meridian during the Land Run of 1889, while the east side was occupied in 1891.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=ME015"
    },
    {
      "id": 2,
      "text": "Meridian was incorporated in 1902 after the Meridian Right-of-way and Townsite Company platted the town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=ME015"
    },
    {
      "id": 3,
      "text": "The Missouri, Kansas and Oklahoma Railroad constructed a branch line to Guthrie through Meridian in 1903.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=ME015"
    },
    {
      "id": 4,
      "text": "Meridian citizens successfully gained political influence within Oklahoma's territorial government during the town's early years.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=ME015"
    },
    {
