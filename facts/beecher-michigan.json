  "facts": [
    {
      "id": 1,
      "text": "Beecher was named after Henry Ward Beecher, the famed orator, by founder T.L. Miller in the late 1800s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofbeecher.org/village-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago, Danville and Vincennes Railroad was promised to the village, securing Beecher’s future and spurring early growth.",
      "sourceSentenceIds": [
        17,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofbeecher.org/village-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beecher celebrated its 125th anniversary in 1995, a milestone called a Quasquicentennial.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofbeecher.org/village-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Beecher Historical Society Museum, housed in the old depot, showcases local artifacts and documents that trace the town’s heritage.",
      "sourceSentenceIds": [
        4,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/beecher-travel-guide-top-10-must-visit-tourist-places/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Beecher’s Eisenhower Public Library has a long history rooted in community education and development.",
