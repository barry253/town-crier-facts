  "facts": [
    {
      "id": 1,
      "text": "Wildwood Crest was founded in 1895 by the Wildwood Beach Improvement Company, naming the borough after its forested seaside setting.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cresthistory.org/founding/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from the wild flowers that once carpeted the shoreline, giving it a natural, botanical charm.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Wildwood%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wildwood Crest’s history spans just over a century, yet it has witnessed more than a dozen memorable events since its 1910 incorporation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cresthistory.org/founding/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "NJ Transit’s 313, 315, 319, and 552 buses connect Wildwood Crest to Cape May, Philadelphia, Manhattan, and Atlantic City, keeping the borough linked to major hubs.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Wildwood%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Hereford Inlet Lighthouse, perched on a rocky spit, stands as Wildwood Crest’s oldest maritime landmark.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Wildwood%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wildwood Crest is one of only five New Jersey municipalities that offer free, lifeguard‑monitored public oceanfront beaches, a rare perk for coastal towns.",
      "sourceSentenceIds": [
