  "facts": [
    {
      "id": 1,
      "text": "Tioga Terrace sits on land once farmed by Cayuga and Onondaga tribes of the Iroquois Confederacy, who used the fertile Susquehanna valley for agriculture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tioga_terrace_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s name reflects the Iroquois term meaning 'at the forks', referencing nearby river confluences.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tioga_terrace_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tioga Terrace lies within the Glaciated Allegheny Plateau, where glacial and river forces carved low-relief valleys and gentle hills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tioga_terrace_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Revolutionary War, General John Sullivan’s 1779 expedition razed Iroquois villages in the Tioga region, opening the area to European settlers.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/tioga_terrace_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tioga Terrace grew as a suburban enclave in the late 1900s, with most homes built after 1990 amid post‑World War II expansion.",
      "sourceSentenceIds": [
        26
      ],
