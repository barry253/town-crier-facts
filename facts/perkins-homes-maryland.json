  "facts": [
    {
      "id": 1,
      "text": "Perkins Homes was built in 1942 as one of Baltimore's oldest public housing projects in the East Harbor Empowerment Zone.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perkins_Homes%2C_Baltimore",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The complex sat between Fells Point, the waterfront, and downtown, making it a focal point for how housing policy and rising land values intersect.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://urbanlithograph.com/research/perkins-homes-baltimore/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2024, the Housing Authority announced a 5‑phase redevelopment that will add 788 units, including 377 deeply affordable, 155 tax‑credit, and 256 market‑rate homes.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Perkins_Homes%2C_Baltimore",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The demolition plan preserves the promise that residents will be able to return to the site after the new mixed‑income development is complete.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://urbanlithograph.com/research/perkins-homes-baltimore/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A longtime resident recalled, “A part of history, a part of Baltimore; these homes have been here since I was a kid,” highlighting the project’s deep community roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cbsnews.com/baltimore/news/perkins-homes-public-housing-demolition/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The new redevelopment will reserve 76 percent of its 1,300 units as affordable housing, a figure announced by the Housing Authority.",
