      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A small church built in 1907 on the east side of town remains in use today, earning Lamoille the title of “Little Church of the Crossroads.”.",
      "sourceSentenceIds": [
        13,
        4
      ],
      "sourceLabels": [
