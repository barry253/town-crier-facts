      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lamoille sits at the base of the Ruby Mountains, 5,700 feet above sea level, and serves as the main gateway to Lamoille Canyon via Nevada State Route 227.",
      "sourceSentenceIds": [
        12,
        25
      ],
      "sourceLabels": [
