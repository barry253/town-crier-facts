      "id": 1,
      "text": "Tolchester Beach is an unincorporated community on the eastern shore of the Chesapeake Bay in Kent County, Maryland.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tolchester_Beach%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Established in 1877, Tolchester Beach expanded from a 10‑acre resort to 155 acres, drawing up to 20,000 visitors each weekend.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tolchester_Beach%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A steamship ferry from Baltimore let city residents hop over for day trips or overnight stays, making Tolchester a main destination for generations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tolchester_Beach%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The resort closed in 1962 after decades of entertainment, leaving behind memories of its dance hall, roller coaster, and miniature steam train.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tolchester_Beach%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Steamships that served Tolchester Beach included the Emma Giles and Louise, ferrying guests across the bay.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tolchester_Beach%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tolchester Beach once featured a roller coaster called Whirl Pool Dips, a novelty that thrilled visitors in the early 20th century.",
