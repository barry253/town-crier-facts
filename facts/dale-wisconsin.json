  "facts": [
    {
      "id": 1,
      "text": "Dale is a town in Outagamie County, Wisconsin, that was officially established on November 17, 1853.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dale%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The land that now encompasses the town of Dale was originally part of the neighboring town of Hortonia.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dale%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Dale was first organized as the town of Medina during a special night session of the Hortonia town board in 1851.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dale%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Dissension over proposed borders led the board to repeal the creation of Medina and return the land to Hortonia in 1852.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dale%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The town of Dale finally separated from Hortonia for good when it was established in November 1853.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dale%2C_Wisconsin"
    }
  ]
}
