    {
      "id": 1,
      "text": "Pleasant View was originally called Bradley's Stand and Turnbull Horse Stamp, serving as a stagecoach stop between Clarksville and Nashville.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://townofpleasantview.com/history.html"
    },
    {
      "id": 2,
      "text": "In 1870 citizens renamed the community Pleasant View to highlight its scenic beauty.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_View%2C_Tennessee"
    },
    {
      "id": 3,
      "text": "The town was incorporated in 1921 under a house bill and later unincorporated ten years later.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_View%2C_Tennessee"
    },
    {
      "id": 4,
      "text": "Pleasant View grew from a small railroad community into a thriving town that balances history with modern growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofpleasantview.com/history.html"
    },
    {
      "id": 5,
      "text": "The first post office opened in 1880, marking the town’s early communication link.",
