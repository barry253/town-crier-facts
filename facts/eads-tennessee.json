  "facts": [
    {
      "id": 1,
      "text": "Eads was founded in 1888 when Tennessee Midland Railroad tracks were laid through the former village of Sewardville.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Eads%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community was renamed Eads in honor of Civil War engineer James Buchanan Eads, famed for the Eads Bridge.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Eads,_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Around 1840, Joseph Harris and Simon Price established Shelby County’s first African‑American church, a landmark in early civil‑rights history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ruralheritagetrust.com/eads.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area that is now Eads was originally part of land ceded by the Chickasaw Nation in the 1818 Jackson Purchase, opening it to European settlers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Eads,_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eads sits on West Tennessee’s flat loess plains, with no dramatic bluffs or large water bodies nearby.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Eads,_Tennessee",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "In 2020, a southern portion of Eads was returned to county control after being briefly annexed by Memphis, reflecting its shifting municipal status.",
