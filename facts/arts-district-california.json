  "facts": [
    {
      "id": 1,
      "text": "Arts District grew from a 1907 Santa Fe Freight Depot that now houses SCI‑Arc, a nationally recognized architecture school.",
      "sourceSentenceIds": [
        18,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arts_District%2C_Los_Angeles",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s name honors the 1781 founding of El Pueblo de Nuestra Señora, La Reina de Los Angeles, the city’s original pueblo.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arts_District%2C_Los_Angeles",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A century‑old Coca‑Cola plant at 4th and Merrick now serves as a creative hub, illustrating the district’s shift from industry to art.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arts_District%2C_Los_Angeles",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Railroads that arrived in 1876 turned the neighborhood into a freight hub, later giving way to trucking and shaping its industrial past.",
      "sourceSentenceIds": [
        23,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://artsdistrictla.org/about/arts-district-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The district’s street art includes murals like “Pope of Broadway” and “Bloom,” turning sidewalks into an open‑air gallery.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.discoverlosangeles.com/discover-la-your-way-downtown-los-angeles-the-arts-district",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the late 1970s, the Atomic Cafe on 1st Street became a legendary spot for musicians and artists, fueling the area’s counterculture scene.",
      "sourceSentenceIds": [
        17
