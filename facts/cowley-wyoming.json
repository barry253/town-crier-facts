  "facts": [
    {
      "id": 1,
      "text": "Cowley was named in honor of Matthias F. Cowley.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://townofcowley.com/"
    },
    {
      "id": 2,
      "text": "Mormon pioneers were called to settle the Big Horn Basin and founded the town of Cowley.",
      "sourceSentenceIds": [
        8,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://townofcowley.com/"
    },
    {
      "id": 3,
      "text": "Cowley sits at the foot of the Bighorn Mountains near the Shoshone River.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://townofcowley.com/"
    },
    {
      "id": 4,
      "text": "Early settlers in Cowley were drawn by reports of cheap land and reliable water from the Shoshone River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cowleymuseum.org/history"
    },
    {
      "id": 5,
      "text": "Settlers in Cowley worked on both the Sidon irrigation canal and a railroad line from Montana to Cody.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://cowleymuseum.org/history"
    },
    {
      "id": 6,
      "text": "Cowley established its first post office in October 1900 and was officially incorporated in May 1907.",
      "sourceSentenceIds": [
