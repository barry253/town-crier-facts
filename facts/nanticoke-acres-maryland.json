  "facts": [
    {
      "id": 1,
      "text": "The name Nanticoke means “tidewater people” in Algonquian, reflecting the tribe’s life along the Chesapeake Bay.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/"
    },
    {
      "id": 2,
      "text": "Captain John Smith first recorded contact with the Nanticoke in 1608 while exploring the Chesapeake Bay.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/"
    },
    {
      "id": 3,
      "text": "Women and children tended gardens of corn, beans, squash, pumpkins, sunflowers, and tobacco in Nanticoke Acres.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/"
    },
    {
      "id": 4,
      "text": "By the late 17th century, the Nanticoke and Choptank were the only native tribes left on Maryland’s Eastern Shore, surviving 70 years of conflict.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/"
    },
    {
      "id": 5,
      "text": "Maryland required the Nanticoke to agree not to leave their reservation land if they wished to keep it legally.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/"
    },
    {
      "id": 6,
      "text": "After the Nanticoke returned from winter hunting, squatters had built homesteads and cut timber on their reservation, destroying it.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nanticokeindians.org/about/history/"
    }
