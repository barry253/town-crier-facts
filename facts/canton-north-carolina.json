  "facts": [
    {
      "id": 1,
      "text": "Canton, NC sits in the Southern Appalachian Mountains on the Pigeon River, 20 miles from Asheville.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cantonnc.com/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town was originally called Buford, then Vinson, Pigeon Ford, before adopting the name Canton in 1893 after the Ohio town that supplied steel for its bridge.",
      "sourceSentenceIds": [
        4,
        12,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pigeon River runs through Canton, powering historic mills and still offering adventure for river enthusiasts.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cantonnc.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Blue Ridge Southern Railroad once served Canton, with a small railyard beside the mill that helped transport logs before railroads replaced river transport.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_North_Carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Garden Creek site, on the side of the Pigeon River, is listed on the National Register of Historic Places and lies about seven miles west of Canton.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canton%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Canton’s early industry grew around the Champion Coated Paper Company, founded by Thomson, who chose the site in 1905 for its abundant timber and water power.",
      "sourceSentenceIds": [
        27,
        28,
