  "facts": [
    {
      "id": 1,
      "text": "Lost Lake Woods began as a logging area before 1920, then the Monteith Land Company repurposed the cut‑over forest into a private recreation club.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://michigan4you.com/lost-lake-woods-club-early-history-1926-1950-video/"
    },
    {
      "id": 2,
      "text": "The club’s founders envisioned a family‑oriented outdoor community, calling it a “workingman’s outdoor club” to welcome ordinary families, not just elites.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://michigan4you.com/lost-lake-woods-club-early-history-1926-1950-video/"
    },
    {
      "id": 3,
      "text": "A clubhouse on Badger Lake was required by deed, and the first lodge opened in 1927, offering lodging, dining, and social space for members.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://michigan4you.com/lost-lake-woods-club-early-history-1926-1950-video/"
    },
    {
      "id": 4,
      "text": "By the late 1920s, Lost Lake Woods controlled roughly 10,000 acres of forestland and lakes, giving members ample space for hunting, fishing, and other pursuits.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://michigan4you.com/lost-lake-woods-club-early-history-1926-1950-video/"
    },
    {
      "id": 5,
      "text": "The community sits within Alcona Township, just north of the village of Lincoln in Alcona County, Michigan.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lost_Lake_Woods%2C_Michigan"
    },
    {
      "id": 6,
      "text": "Lost Lake Woods is a private, member‑owned conservation club that has remained strictly for members and guests since its founding.",
      "sourceSentenceIds": [
        6,
