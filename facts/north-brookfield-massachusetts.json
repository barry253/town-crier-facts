  "facts": [
    {
      "id": 1,
      "text": "North Brookfield’s Town House, built in the early 1800s, once served as the town’s meeting hall and remains the historic heart of the community.",
      "sourceSentenceIds": [
        12,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thebostondaybook.com/historical-places-in-north-brookfield/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Brookfield Cemetery on Central Street preserves graves that date back several centuries, offering a tangible link to the town’s early settlers.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thebostondaybook.com/historical-places-in-north-brookfield/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Brookfield was first settled in 1664 and officially became its own town in 1812 after separating from neighboring Brookfield.",
      "sourceSentenceIds": [
        30,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Brookfield%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s public library, founded in 1879, has been a cornerstone of community learning for well over a century.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Brookfield%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "North Brookfield Common, a historic district, showcases well‑preserved 18th‑ and 19th‑century buildings that reflect the town’s architectural heritage.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thebostondaybook.com/historical-places-in-north-brookfield/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Quaboag Historical Society Museum in North Brookfield houses artifacts that chronicle the town’s cultural and social evolution.",
