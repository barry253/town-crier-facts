  "facts": [
    {
      "id": 1,
      "text": "Redwood was laid out by Thomas Redwood and originally marketed as Carthage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Redwood is best known for the ancient Fort Saint-Pierre, built by French colonists in 1719.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The French fort at Redwood was destroyed by Native Americans in 1729, ending its brief colonial presence.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Redwood%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Saint-Pierre served as a buffer against English-allied Chickasaw incursions and a trade hub with local Indigenous groups.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redwood_mississippi",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "By the 1830s, cotton production in the Big Black-Yazoo region exceeded 25,000 bales annually, spurring the 1838 Vicksburg-Jackson railroad.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/redwood_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Archaeological sites near Redwood, including prehistoric mounds B and D, were leveled in 1967 for development, erasing centuries of history.",
