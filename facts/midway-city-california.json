      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midway_City%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1922 farmer John Harper mapped streets and sidewalks, then sold lots the next year to build a new community.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://midwaycity.com/midway-city-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Harper Street, cutting through the city’s center, honors its founder John Harper and runs north‑south across Midway City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
