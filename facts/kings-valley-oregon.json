  "facts": [
    {
      "id": 1,
      "text": "Kings Valley was named after Nahum King, who established a land claim in the area in 1846.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kings_Valley%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The historic Kings Valley Store, built in the 1860s, remains the community's only open brick-and-mortar business.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://guides.library.oregonstate.edu/localhistory/kingsvalley"
    },
    {
      "id": 3,
      "text": "Benton County's first recorded rural gristmill was built in Kings Valley in 1853 and powered by the Luckiamute River.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://guides.library.oregonstate.edu/localhistory/kingsvalley"
    },
    {
      "id": 4,
      "text": "The millstone for the local gristmill was quarried in France and transported by ship and wagon to the site.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://guides.library.oregonstate.edu/localhistory/kingsvalley"
    },
    {
      "id": 5,
      "text": "The Valley and Siletz Railroad once ran through Kings Valley to transport timber and agricultural goods.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kings_Valley%2C_Oregon"
    },
    {
