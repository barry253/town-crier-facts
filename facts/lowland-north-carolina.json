  "facts": [
    {
      "id": 1,
      "text": "Lowland's post office began as Goose Creek Island on May 26, 1856, renamed Lowland on May 23, 1892 to serve the remote coastal community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lowland_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historically, Lowland grew as a rural coastal settlement in the 19th and 20th centuries, relying on cotton, corn, potatoes, and shrimp, crab, oyster fishing.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lowland_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In recent decades, oyster farming has replaced traditional agriculture; the I&M Oyster Company, founded in 2011, now raises oysters in cages on the Pungo River and Oyster Creek.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lowland_north_carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lowland sits just three feet above sea level on Goose Creek Island, surrounded by Pamlico Sound, the Intracoastal Waterway, Pungo River, and Oyster Creek.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lowland_north_carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community lies 16 miles northeast of Bayboro, the Pamlico County seat, and is part of the Atlantic Coastal Plain, a flat low‑elevation province shaped by marine terraces.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lowland_north_carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Lowland's low elevation makes it vulnerable to hurricanes and tidal flooding; storm surges have once forced evacuations and left standing water for over a week.",
      "sourceSentenceIds": [
        24,
        25
      ],
