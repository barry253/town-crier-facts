  "facts": [
    {
      "id": 1,
      "text": "Gravette was founded in 1893 by Ellis Tillman Gravett, who moved his distillery and general store from Nebo to the new town.",
      "sourceSentenceIds": [
        7,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gravettechamber.org/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Arkansas and Oklahoma Railroad arrived in 1898, linking Gravette to Rogers and Grove, Oklahoma, and boosting regional trade.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gravettechamber.org/our-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Gravette Historical Museum, housed in the historic Kindley House, displays local heirlooms and artifacts that chronicle the town’s past.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gravettear.com/historical-museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gravette’s early economy featured a flour mill, canning factory, vinegar plant, broom factory, and four hotels, reflecting its industrial diversity.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gravettechamber.org/our-history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1900, the neighboring community of Hiwasse was annexed into Gravette, expanding its area to 15.33 square miles.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gravette%2C_Arkansas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Arnold Murray, a former world heavyweight champion, once called Gravette home during his early career.",
