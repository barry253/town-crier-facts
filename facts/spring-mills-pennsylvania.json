      "id": 1,
      "text": "Spring Mills earned its name from the abundant springs at the confluence of Sinking Creek and Penns Creek, where early settlers first settled.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
