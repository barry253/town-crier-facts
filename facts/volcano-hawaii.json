  "facts": [
    {
      "id": 1,
      "text": "Volcano sits on the east side of Hawaiʻi island, right on the border of Hawaii Volcanoes National Park and near Kīlauea’s summit caldera.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Volcano%2C_Hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park stretches from sea level up to 13,680 feet, covering the peaks of Kīlauea and Mauna Loa and earning UNESCO World Heritage status.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/havo/index.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1986, an eruption moved two miles northeast to the Kupaianaha vent, sending lava to the ocean and later burying the historic town of Kalapana in 1990.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Hawaii-Volcanoes-National-Park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Kahuku Unit, within the park, blends active volcanism with rich Hawaiian traditions and a ranching past that shaped the area’s culture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/havo/index.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hawaii Route 11 cuts through Volcano’s southern edge, linking the community to Hilo 27 miles northeast and Nāʻālehu 37 miles southwest.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
