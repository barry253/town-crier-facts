  "facts": [
    {
      "id": 1,
      "text": "Derwood’s name evolved from “Deer Park” to “Deer Wood” before settling on Derwood, reflecting local speech.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Derwood%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a B&O Railroad stop first noted in the 1880s, now at Indianola Drive and MD Route 355.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Derwood%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A larger station was erected between 1886 and 1889, a three‑story 32‑by‑56 building built across the tracks.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Derwood%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Metro Red Line reached Derwood in 1984, erasing the last physical traces of the old B&O station and mill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ericcarlson.net/derwood-history.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Intercounty Connector (MD 200) was built through central Derwood between 2009 and 2011, reshaping the town’s landscape.",
      "sourceSentenceIds": [
