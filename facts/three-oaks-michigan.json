  "facts": [
    {
      "id": 1,
      "text": "Three Oaks earned its name from three oak trees that stood beside the original post office when it opened in 1854.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swmichigan.org/plan-and-stay/towns/three-oaks",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Warren Featherbone Factory, built over a century ago, once stripped turkey feathers for corsets and now houses Journeyman Distillery and Acorn Theater.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Oaks%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Journeyman Distillery, located in the restored Featherbone building, crafts certified organic spirits like whiskey, gin, rum, and vodka.",
      "sourceSentenceIds": [
        13,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swmichigan.org/plan-and-stay/towns/three-oaks",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every summer, Dewey Cannon Park hosts Music in the Park, where regional musicians play under the historic Spanish‑American War cannon.",
      "sourceSentenceIds": [
        14,
        21,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swmichigan.org/plan-and-stay/towns/three-oaks",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The 1989 holiday film Prancer was set in Three Oaks, with several exterior shots filmed right in the village.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Oaks%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Three Oaks is a designated Tree City, celebrated for its Victorian inns, historic inns, and a sculpture of a dog following a bicyclist.",
