  "facts": [
    {
      "id": 1,
      "text": "Hammond was renamed in 1873 to honor meatpacking magnate George Hammond, after the town’s original name State Line.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Hammond",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s first major industry began in 1869 when George Hammond and Marcus Towle founded the State Line Slaughterhouse.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Hammond",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Marcus Morton Towle House at 229 Ogden Street became Hammond’s first local landmark when it was designated in July 1984.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gohammond.com/departments/planning-and-development/city-planning/historic-preservation-commission/historic-districts-landmarks/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hammond’s streets are threaded by railroads and expressways, including the South Shore Line, Borman Expressway, and Indiana Toll Road.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hammond%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hammond Public Library was the first in Indiana to form a recognized union, a local of AFSCME, led by president Robinson.",
      "sourceSentenceIds": [
