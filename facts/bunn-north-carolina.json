  "facts": [
    {
      "id": 1,
      "text": "Bunn takes its name from Green Walker Bunn, an 18th‑century settler who moved to the area in 1838.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bunn_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s modern roots began in 1909 when the Montgomery Lumber Company bought land and shifted the settlement south for a railroad, auctioning lots that year.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bunn_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bunn was officially incorporated on March 3 1913, turning a rural lumber outpost into a recognized municipality.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bunn_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Andrews‑Moore House and Baker Farm, both on the National Register, showcase the area’s antebellum farm life.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bunn%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Located in southeastern Franklin County, Bunn lies about 15 miles west of Wake Forest along Route 64.",
