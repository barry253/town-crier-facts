  "facts": [
    {
      "id": 1,
      "text": "Glória Hill once hosted the Tupí village Karioca, the namesake of Rio’s famous carioca identity.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gl%C3%B3ria%2C_Rio_de_Janeiro",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At Glória Hill’s summit stands the 17th‑century Nossa Senhora da Glória do Outeiro church, a historic landmark.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gl%C3%B3ria%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 3‑ft narrow‑gauge funicular, opened in 1945, still climbs Glória Hill’s steep slope for visitors.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gl%C3%B3ria%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Marina da Glória, opened in 1979, offers waterfront views overlooking Guanabara Bay.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gl%C3%B3ria%2C_Rio_de_Janeiro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since June 2022, Rio’s ‘Dias de Glória’ project has been renovating streets, restoring monuments like Marechal Deodoro, and reconnecting the Dolphin Fountain.",
      "sourceSentenceIds": [
