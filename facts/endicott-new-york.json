  "facts": [
    {
      "id": 1,
      "text": "Endicott was founded as a company town by the Endicott-Johnson Corporation, becoming the largest shoe company worldwide by WWI.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Endicott%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was named in honor of Henry B. Endicott, a Massachusetts shoemaker who bought the company in 1890.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.endicottny.com/history/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1911, the Computing-Tabulating-Recording Company, later IBM, was founded in Endicott, launching a century of tech innovation.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Endicott%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Endicott History & Heritage Center, run by the Old Village of Union Historical Society, showcases extensive displays on both EJ and IBM.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://endicotthistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During World War II, several IBM factories in Endicott were converted to produce sidearm pistols for the war effort.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Endicott%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s historic business district sits at the intersection of NYS Route 26 and NYS Route 17C, once the original Union village center.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
