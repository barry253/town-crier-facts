  "facts": [
    {
      "id": 1,
      "text": "Seneca Falls is the birthplace of the women’s rights movement, where the 1848 convention drafted the Declaration of Rights and Sentiments.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seneca_Falls%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town sits on a historic Erie Canal branch, and a scenic canal trail is being completed to honor that legacy.",
      "sourceSentenceIds": [
        4,
        5,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seneca_Falls%2C_New_York"
    },
    {
      "id": 3,
      "text": "Seneca Falls hosts the Women’s Rights National Historical Park, a National Park Service unit that preserves the convention site.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seneca_Falls%2C_New_York"
    },
    {
      "id": 4,
      "text": "The Seneca Museum of Waterways and Industry showcases the town’s industrial past and its role in the canal era.",
      "sourceSentenceIds": [
        10,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://senecamuseum.com/tourism-center/"
    },
    {
      "id": 5,
      "text": "The town’s historic district features architecture that reflects the growth of a 19th‑century canal community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://senecafalls.gov/experience-seneca-falls/"
    },
    {
      "id": 6,
      "text": "Seneca Falls’ name honors the Cayuga people, the original inhabitants of the region before European settlement.",
