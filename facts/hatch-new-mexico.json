  "facts": [
    {
      "id": 1,
      "text": "Hatch was first settled by New Mexican farmers in 1851 along the road between Jornada del Muerto and Cooke's Wagon Road, but Apache raids forced them to leave.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatch%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort at Fort Thorn closed in 1859, and the town was abandoned again in 1860 when raids resumed.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatch%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1875 the area was reoccupied and renamed \"Hatch\" after Edward Hatch, a commander in the military District of New Mexico.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatch%2C_New_Mexico",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The Southwestern Railroad passes through Hatch, linking it to regional trade routes.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatch%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hatch hosts the annual Hatch Chile Festival each Labor Day, drawing crowds to celebrate its renowned chile varieties.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hatch%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hatch's water is diverted from the Rio Grande and two lakes 20 miles north, including Caballo and Elephant Butte Reservoir.",
