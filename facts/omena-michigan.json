  "facts": [
    {
      "id": 1,
      "text": "Omena began when Ottawa and Chippewa band led by Chief Ahgosa moved from Old Mission in 1850.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.omenahistoricalsociety.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Reverend Peter Dougherty followed the Ahgosa band in 1852 to the bay, founding the New Mission that later became Omena.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.omenahistoricalsociety.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1858 Omena Presbyterian Church, originally New Grove Mission Church, is the oldest Protestant church in Leelanau County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.omenahistoricalsociety.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Steamers and the 1903 railroad brought tourists to Omena’s cottages and hotels, making it a summer resort hub.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.omenahistoricalsociety.org/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sunset Lodge, once a retirement home, grew into a vacation resort with cottages and a social hall until World War II.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.omenahistoricalsociety.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2017 Omena’s historic district, including the church and dock pilings, was listed on the National Register of Historic Places.",
