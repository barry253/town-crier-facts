  "facts": [
    {
      "id": 1,
      "text": "Esperance’s name comes from the French word for “hope,” a nod to the optimism of its early settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esperancemuseum.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Commons today houses the 1878 schoolhouse museum, a carriage barn with farm gear, and an active 1824 Presbyterian church.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitschohariecounty.com/listing/esperance-historical-society-and-museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1846 the Town of Esperance was carved out of the larger Town of Schoharie, marking its formal birth.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Esperance%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village of Esperance first appeared on maps in 1818, gaining a new charter in 1835 before the town itself was established.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Esperance%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "When the Erie Canal and later railroads rerouted traffic away from the Great Western Turnpike, Esperance’s bustling streets began to quiet.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.esperancemuseum.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "General William North granted the land that became Esperance’s public square in 1820, later housing the historic schoolhouse museum.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
