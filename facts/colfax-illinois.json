  "facts": [
    {
      "id": 1,
      "text": "Colfax was founded in 1880 and named after Vice President Schuyler Colfax.",
      "sourceSentenceIds": [
        6,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colfax_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Clinton, Bloomington, and Northwestern Railroad reached Colfax in 1881, turning the town into a rail hub for the region.",
      "sourceSentenceIds": [
        12,
        28,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/colfax_illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A cigar factory and a tin‑can factory opened around the same time, giving Colfax its first industrial roots.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colfax%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Four churches—Christian, Methodist, Presbyterian, and Roman Catholic—were built shortly after the town’s founding.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colfax%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, a restoration project is refurbishing Old Town Hall and creating Colfax Plaza with murals and a pavilion for concerts.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colfax%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early 20th‑century Colfax housed tuberculosis treatment centers, documented in more than 50 photographs and maps.",
