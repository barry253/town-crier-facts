      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fennville%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fennville earned its own American Viticultural Area designation in 1981, sparking a local wine industry that gained national awards.",
      "sourceSentenceIds": [
