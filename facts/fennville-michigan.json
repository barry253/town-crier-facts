      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and Michigan Lake Shore Railroad reached Fennville in 1865, turning the settlement into a thriving agricultural hub.",
      "sourceSentenceIds": [
        2,
        17,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fennville%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1910, the historic Stevens Hotel opened downtown, becoming a landmark that still stands today.",
      "sourceSentenceIds": [
        11
