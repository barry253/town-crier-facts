  "facts": [
    {
      "id": 1,
      "text": "Tamboerskloof’s name comes from the Dutch words tamboer, meaning drum, and kloof, meaning valley.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamboerskloof",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When Dutch settlers arrived in the 1650s, they built lookout points where watchmen beat drums to warn farmers of approaching ships.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamboerskloof",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tamboerskloof lies on the lower slopes of Signal Hill, overlooking Cape Town’s City Bowl.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.colourdots.co.za/tamboerskloof/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tamboerskloof Neighbourhood Watch runs volunteer patrols, a radio network, CCTV, and reports street light issues.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tamboerskloof",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "This suburb, one of Cape Town’s oldest, features Victorian‑style homes side‑by‑side with art‑deco architecture.",
