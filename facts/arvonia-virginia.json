  "facts": [
    {
      "id": 1,
      "text": "Arvonia was founded by Welsh immigrants in the mid‑19th century, making it a hub for slate quarrying.",
      "sourceSentenceIds": [
        3,
        5,
        7,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Arvonia%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Caernarfon, Wales, the birthplace of the slate industry that brought its workers to Virginia.",
      "sourceSentenceIds": [
        13,
        17,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/arvonia_virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arvonia’s slate earned gold medals at the 1876 Philadelphia Exposition, the 1893 World’s Columbian Exposition, and the 1904 Louisiana Purchase Exposition.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/arvonia_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1885 the Arvon Presbyterian Church was founded to serve the Welsh miners working in the local quarry.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Arvonia%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Williams Slate Company, founded in the 1870s by brothers Evan and John Williams, was one of eight major quarry firms by the early 20th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/arvonia_virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bryn Arvon and Gwyn Arvon, Queen Anne‑style homes built for the Williams brothers, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
