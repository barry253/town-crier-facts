      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname “Little Appalachia” during a mid‑20th‑century influx of Appalachian migrants.",
      "sourceSentenceIds": [
        4,
        12,
        14
      ],
      "sourceLabels": [
