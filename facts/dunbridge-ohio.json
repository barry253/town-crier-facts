      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Robert Dunn laid out Dunbridge in 1882, marking the town’s official start.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunbridge%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Dunbridge in 1883, becoming the first federal service in the community.",
