  "facts": [
    {
      "id": 1,
      "text": "Beausejour’s name means “beautiful stay” in French, chosen by a railway employee when the station opened in 1877.",
      "sourceSentenceIds": [
        5,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beausejour%2C_Manitoba",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Manitoba Glass Works, founded in 1906 by Joseph Keilback, still stands as a provincial heritage site in Beausejour.",
      "sourceSentenceIds": [
        2,
        6,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://townofbeausejour.com/p/museums-historical-sites-and-points-of-interest",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s Pioneer Village Museum, opened in 1967, recreates a small pioneer village with a log house, school, and Ukrainian church.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.beausejourhistoricalsociety.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Beausejour was the filming location for the 1990 film “The Outside Chance of Maximilian Glick” and its TV adaptation.",
      "sourceSentenceIds": [
        8,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beausejour%2C_Manitoba",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1881, the first post office opened in the station house, and TS Gray opened the first store, marking the town’s commercial start.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.beausejourhistoricalsociety.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town sits 46 kilometres northeast of Winnipeg, just west of the Canadian Shield and Whiteshell Provincial Park.",
