  "facts": [
    {
      "id": 1,
      "text": "Knightsville sprang up in 1867 around an iron furnace built the year before.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knightsville%2C_Indiana"
    },
    {
      "id": 2,
      "text": "The furnace, located two and a half miles east of Brazil, was the town’s economic catalyst and drew workers to a former hamlet called Hazlebrush.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knightsville_indiana"
    },
    {
      "id": 3,
      "text": "The town was formally incorporated in 1872 after the Western Iron Company’s plant employed 250‑300 men at its peak.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knightsville_indiana"
    },
    {
      "id": 4,
      "text": "Knightsville was named for Dr. Knight, a prominent local physician who owned the land and platted the town in 1867.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knightsville_indiana"
    },
    {
      "id": 5,
      "text": "The original town plat was laid out by Bailey in 1867, with additions by Nicoson, Witty, and Watson in the following years.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/knightsville_indiana"
    },
    {
      "id": 6,
      "text": "Knightsville sits at 39°31′34″N 87°5′27″W, placing it within the Terre Haute Metropolitan Statistical Area.",
      "sourceSentenceIds": [
