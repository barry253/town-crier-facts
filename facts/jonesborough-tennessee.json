      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jonesborough claims the title of “Storytelling Capital of the World,” hosting annual events that celebrate oral tradition.",
      "sourceSentenceIds": [
        15,
        17
      ],
      "sourceLabels": [
