      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad arrived in 1880, and the town’s first official vote—25 ballots—was taken at the depot on May 6th.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://swanvillemn.gov/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Swanville’s post office, established in 1883, has been a steady community hub for over a century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
