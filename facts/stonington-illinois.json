  "facts": [
    {
      "id": 1,
      "text": "Stonington was named after North Stonington, Connecticut, by settlers who laid out a 160‑acre town site in the early 1830s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://christian.illinoisgenweb.org/history/stonington.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original settlers traveled south from Connecticut, choosing land near present‑day Stonington after finding no single tract large enough in the surrounding counties.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://christian.illinoisgenweb.org/history/stonington.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1833 Thomas P. Chapman visited Illinois to visit relatives in Fulton, Warren, and Knox Counties, marking the first recorded arrival of a Connecticut settler in the area that would become Stonington.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://christian.illinoisgenweb.org/history/stonington.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stonington sits in Christian County, Illinois, a detail that ties the village to the county’s broader historical narrative.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stonington%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "On December 1, 2018, an EF2 tornado struck the western part of Stonington, but fortunately no injuries or deaths were reported.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stonington%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s founding colony was part of a larger migration that included travel by railroad, riverboat, and wagon across the prairie.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
