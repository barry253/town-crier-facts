  "facts": [
    {
      "id": 1,
      "text": "Highland Park’s ravine on Nose Hill’s southern slope is a prominent geographical landmark that once guided early farmers and later became a golf course.",
      "sourceSentenceIds": [
        1,
        5,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandparkcommunity.ca/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "McKnight Boulevard, named after WWII Battle of Britain pilot William McKnight, runs along Highland Park’s northern boundary.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandparkcommunity.ca/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Centre Street North was once part of Calgary’s streetcar network, linking Highland Park’s 32nd Avenue station to downtown.",
      "sourceSentenceIds": [
        15,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandparkcommunity.ca/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Highland Park was annexed in 1910 and grew rapidly during the 1940s‑50s oil boom, transforming from homesteads to a suburban community.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandparkcommunity.ca/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The industrial area that once belonged to Highland Park is now known as Greenview Industrial, yet locals still consider it part of the neighbourhood.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.highlandparkcommunity.ca/history",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "A steep escarpment on the eastern edge of Highland Park’s plateau physically bisects the residential area, creating a dramatic skyline.",
      "sourceSentenceIds": [
        22
