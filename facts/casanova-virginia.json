  "facts": [
    {
      "id": 1,
      "text": "Casanova, Virginia, began as “Three Mile Station” in 1852, later renamed to avoid confusion and honor Juan Casanova of the Murray family.",
      "sourceSentenceIds": [
        1,
        10,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Casanova%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around a Warrenton Branch spur of the Orange and Alexandria Railroad, with the station demolished in 1956 after passenger service ended.",
      "sourceSentenceIds": [
        3,
        4,
        5,
        16,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Web source 2",
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5163/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Casanova Historic District, a cluster of intact late‑19th‑to‑early‑20th‑century buildings, was listed on the National Register of Historic Places in 2005.",
      "sourceSentenceIds": [
        23,
        27,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Casanova%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Among its preserved structures is a rare steam‑powered mill, one of the few of its kind still standing in Virginia.",
      "sourceSentenceIds": [
        8,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Casanova%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1909 the Casanova Hunt club launched traditional foxhunts, hunter paces, and steeplechase races that drew riders from across the county.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Casanova%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village sits near Melrose Castle, a Gothic Revival estate built 1857‑60 by Dr. John M. Murray, whose family owned the land.",
