    {
      "id": 1,
      "text": "Grand Island was platted in 1866 by Union Pacific, a few miles west of a German settlement, anticipating the transcontinental railroad.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitgrandisland.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors a natural island on the Platte River, once the centerpiece of the “Great American Desert” prairie.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitgrandisland.com/about",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grand Island hosts the first U.S. sugar beet processing factory, built in the town’s southwest corner.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Island%2C_Nebraska",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During WWII, the nearby Cornhusker Army Ammunition Plant produced bombs for that war and later for Korea and Vietnam.",
