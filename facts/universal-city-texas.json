  "facts": [
    {
      "id": 1,
      "text": "Aubrey Milner named the town Universal City in 1931, hoping its proximity to Randolph Air Force Base would give it universal importance.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/universal-city-tx"
    },
    {
      "id": 2,
      "text": "Across the Union Pacific Railroad tracks from Randolph Air Force Base’s main gate lies Universal City, a short drive northeast of San Antonio.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/universal-city-tx"
    },
    {
      "id": 3,
      "text": "Randolph Field opened October 25, 1931, and the first business across the tracks—a service station—opened in 1932.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/universal-city-tx"
    },
    {
      "id": 4,
      "text": "The Universal City Public Library began in the former city hall in June 1985 after a new municipal building opened in 1984.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/universal-city-tx"
    },
    {
      "id": 5,
      "text": "In 1979 Universal City became the first community in Bexar County to receive cable television service.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/universal-city-tx"
    },
    {
      "id": 6,
      "text": "Universal City sits about 15 miles northeast of downtown San Antonio, bordering Schertz, Selma, Live Oak, and Converse.",
      "sourceSentenceIds": [
