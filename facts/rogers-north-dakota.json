  "facts": [
    {
      "id": 1,
      "text": "Rogers was founded in 1897 and named after railroad engineer John Rogers, whose work helped bring the Great Northern Railway through the area.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/rogers_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Norwegian and German immigrants settled Rogers, focusing on agriculture and building homes, stores, and community buildings amid harsh winters and land clearing.",
      "sourceSentenceIds": [
        25,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rogers_north_dakota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rogers sits in the Drift Prairie, a landscape of glacial till and outwash, and lies near the Sheyenne River valley that shapes local farmland.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rogers_north_dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s short growing season of about 144 days forces farmers to use frost‑protective techniques to keep crops alive.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rogers_north_dakota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Rogers survived the 1910–1911 floods and hosted annual threshing bees from the 1920s through the 1940s, a testament to its resilient farming community.",
      "sourceSentenceIds": [
