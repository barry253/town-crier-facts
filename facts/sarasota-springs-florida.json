  "facts": [
    {
      "id": 1,
      "text": "Archaeologists have found evidence of Native American habitation in Sarasota Springs dating back more than 12,000 years, with sites near local springs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
