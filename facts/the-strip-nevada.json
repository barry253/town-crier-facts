  "facts": [
    {
      "id": 1,
      "text": "Residencies have been a staple of the Strip since 1944, when Liberace began a long‑term engagement at the Hotel Last Frontier, followed by legends like Louis Armstrong, Nat King Cole, Elvis Presley, and Frank Sinatra.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Las-Vegas-Strip",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Strip got its name from Los Angeles police officer Guy McAfee, who called it after his hometown’s Sunset Strip in Hollywood.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Las_Vegas_Strip",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Next to MGM Grand, the Showcase Mall features a 100‑foot Coca‑Cola bottle that towers over the Strip’s skyline.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Las_Vegas_Strip",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2021 the Pinball Hall of Fame relocated near the “Fabulous Las Vegas” sign at the south end of the Strip, bringing arcade nostalgia to the heart of the city.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Las_Vegas_Strip",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 2024 proposal unveiled an NBA‑ready arena on the Strip as part of the planned LVXP resort development, aiming to add a major sports venue to the corridor.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Las_Vegas_Strip",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A new stadium and hotel are slated to open in 2028 for the MLB season, marking the Strip’s first major sports complex in decades.",
      "sourceSentenceIds": [
