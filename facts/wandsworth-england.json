  "facts": [
    {
      "id": 1,
      "text": "Wandsworth Prison, opened in 1851, famously held Oscar Wilde in 1895 and was the site of Ronnie Biggs’ daring 1965 escape.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Wandsworth",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 20th century, Wandsworth’s compact terraced streets attracted white‑collar families, sparking a boom of restaurants and antique shops.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Wandsworth",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The River Wandle cuts through Wandsworth, its waters once powering the borough’s industrial mills and factories.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Wandsworth",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every year from 23 May to 14 June, Wandsworth Heritage Festival celebrates the borough’s rich history with events borough‑wide.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://welcometowandsworth.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wandsworth is bridged by five major road crossings over the Thames—Chelsea, Albert, Battersea, Wandsworth, and Putney.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Wandsworth",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The council’s headquarters sit in Wandsworth Town Hall, located in the heart of the borough’s historic centre.",
