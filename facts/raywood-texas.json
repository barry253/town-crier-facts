      ],
      "source": "https://www.tshaonline.org/handbook/entries/raywood-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rice cultivation began in the 1830s, but Alexander Miller’s 1890 introduction of rice culture really transformed the local economy.",
      "sourceSentenceIds": [
