  "facts": [
    {
      "id": 1,
      "text": "Horizon Colony was founded in 2012 as a split from Hillside Hutterite Colony near Sweetgrass, Montana.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/horizon_colony_montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pacifism is a core tenet, leading to historical migrations to avoid military conscription, and spiritual security is derived from daily righteous living rather than ritual alone.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/horizon_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hutterisch, a Carinthian German dialect, is spoken daily; the colony uses electricity and farm machinery communally but avoids TV and radio.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/horizon_colony_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The colony sits amid flat to gently rolling plains typical of northern Montana’s prairie.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/horizon_colony_montana",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The climate is semi-arid continental, marked by cold winters with average lows below 0°F (-18°C) and mild summers reaching highs around 80°F (27°C).",
