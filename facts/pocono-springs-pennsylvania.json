  "facts": [
    {
      "id": 1,
      "text": "Pocono Springs first settled by English and German settlers in 1742, with Nicholas Depui establishing the first permanent residence in 1725 at Shawnee.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Delaware Water Gap, near Pocono Springs, was called a scenic “Wonder of the World” and Jim Thorpe dubbed the “Switzerland of America.”.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1829, Anthony Dutot opened the first boarding house hotel at the Delaware Water Gap, sparking a resort industry that drew Philadelphia and New York visitors by 1900.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lehigh Coal & Navigation Company mined coal from Carbon County in the 1800s, and Honesdale welcomed the first U.S. commercial steam locomotive in 1829.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gifford Pinchot, a Milford resident, became the first Chief of the U.S. Forest Service under President Roosevelt and was called the “Father of the Conservation Movement.”.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.poconomountains.com/plan-your-vacation/about-the-poconos/pocono-mountains-history/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Pennsylvania Power and Light Company began building Lake Wallenpaupack in 1926, creating the third‑largest man‑made lake in Pennsylvania.",
