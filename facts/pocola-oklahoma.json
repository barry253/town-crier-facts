  "facts": [
    {
      "id": 1,
      "text": "Pocola takes its name from the Choctaw word for ten, representing the town's distance in miles from Fort Smith, Arkansas.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocola%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "A post office was first established at Pocola, Indian Territory, on February 15, 1881.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocola%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Will Hartshorne operated a small coal mine in the Pocola area during the 1880s before selling it in 1896.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocola%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Pocola did not incorporate until 1963 to secure water rights along the McClellan-Kerr Arkansas River Navigation System.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pocola%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Poteau River forms the western boundary of the town of Pocola.",
