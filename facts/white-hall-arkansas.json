  "facts": [
    {
      "id": 1,
      "text": "White Hall earned its name when early settlers called a white‑washed clapboard building the “white hall,” making it the town’s first landmark.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehallar.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A spring‑fed creek north of Pine Bluff, later known as Crenshaw Springs, drew travelers for water, washing, and horse care in the 1800s.",
      "sourceSentenceIds": [
        2,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.whitehallar.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "White Hall hosts the Pine Bluff Arsenal, a major U.S. Army facility that has operated since the 1940s.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Hall%2C_Arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s public library, part of the Pine Bluff and Jefferson County Library System, sits near the historic White Hall City Park.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Hall%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
