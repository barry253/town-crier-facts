  "facts": [
    {
      "id": 1,
      "text": "Wolfeboro earned its name in 1759 when colonial Governor Benning Wentworth honored General James Wolfe, the victor at the Plains of Abraham.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolfeboro%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Clark Museum, run by the Wolfeboro Historical Society, showcases the town’s rich history through curated exhibits and engaging displays.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wolfeborohistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wolfeboro sits at the head of Wolfeboro Bay on Lake Winnipesaukee, where the Smith River flows into the lake.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolfeboro%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Known as “The Oldest Summer Resort in America,” Wolfeboro attracted Boston families in the 19th century as a seasonal retreat.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolfeboro%2C_New_Hampshire",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Celebrities like Prince Rainier, Grace of Monaco, Kurt Vonnegut, Drew Barrymore, and Jimmy Fallon have spent vacations in Wolfeboro.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolfeboro%2C_New_Hampshire",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2025 the Wolfeboro Historical Society received a proclamation from Governor Kelly Ayotte, celebrating 100 years of museum excellence.",
