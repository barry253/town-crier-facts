    {
      "id": 1,
      "text": "Pine Island earned its name from the Dakota term 'Wa-zu-wee-ta,' meaning 'Isle of Pines,' after a stand of pine trees by the river.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
