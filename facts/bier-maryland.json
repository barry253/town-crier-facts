  "facts": [
    {
      "id": 1,
      "text": "Bier’s name probably comes from early German settlers, perhaps a family surname, though the exact origin remains unclear.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bier_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 19th and early 20th centuries, Bier’s economy focused on brickmaking, using local clay from Helderberg limestone deposits.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bier_maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Baltimore and Ohio Railroad, Chesapeake and Ohio Canal, and Cumberland and Pennsylvania Railroad once ferried Bier’s bricks to national markets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bier_maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area averages about 39 inches of precipitation each year, with roughly 34 inches of snow, giving it a fairly even seasonal climate.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bier_maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Bier was part of Frederick County until Allegany County formed in 1789, after which organized land grants encouraged farming and frontier outposts.",
