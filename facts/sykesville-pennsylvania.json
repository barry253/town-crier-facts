      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Shaffer City for pioneer Henry Shaffer, the town was renamed Sykesville in the early 1900s.",
      "sourceSentenceIds": [
        19,
        23
      ],
      "sourceLabels": [
        "Web source 1"
