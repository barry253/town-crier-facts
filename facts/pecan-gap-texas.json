  "facts": [
    {
      "id": 1,
      "text": "Pecan Gap takes its name from a natural gap between two pecan trees, one of which was felled by a tornado in 1963.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pecan_Gap%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Settlers first organized the Pecan Gap Baptist Church in 1884, naming it after a nearby pecan grove.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pecan-gap-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pecan Gap sits at the junction of Farm Roads 64 and 128, right on the historic Atchison, Topeka and Santa Fe Railway line.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/pecan-gap-tx",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Long before settlers, the Caddo people inhabited the area that is now Pecan Gap as early as 800 AD.",
