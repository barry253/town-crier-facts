  "facts": [
    {
      "id": 1,
      "text": "Moores Hill got its name when postal officials misspelled the original Moores Mill, and the typo stuck.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moores_Hill%2C_Indiana"
    },
    {
      "id": 2,
      "text": "Platted in 1839 by Adam Moore and Andrew Stevens, the town began with nine lots beside a gristmill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moores_Hill%2C_Indiana"
    },
    {
      "id": 3,
      "text": "Carnegie Hall and the 1871 United Methodist Church in Moores Hill are both listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moores_Hill%2C_Indiana"
    },
    {
      "id": 4,
      "text": "Moores Hill boasts a wide variety of historic homes, showcasing diverse architectural styles that reflect its rich past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historyinyourownbackyard.com/city/moores-hill-in/"
    },
    {
      "id": 5,
      "text": "The town was pioneered in 1818 by Adam Moore, who brought his family from Maryland to settle the area.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historyinyourownbackyard.com/city/moores-hill-in/"
