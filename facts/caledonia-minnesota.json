      "quality": "good"
    },
    {
      "id": 2,
      "text": "History Lane in Caledonia showcases an old schoolhouse, pioneer cabin, church, and town hall, offering a walk back in time.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
