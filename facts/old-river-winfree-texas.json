  "facts": [
    {
      "id": 1,
      "text": "Old River-Winfree was created in the 1970s when the neighboring communities of Old River and Winfree merged.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/texas_old-river-winfree",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially incorporated in 1979, spurred by the growth of the petrochemical complex in nearby Mont Belvieu.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/old-river-winfree-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office named Straddle operated from 1880 to 1881, followed by the Winfree post office from 1885 to 1919.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/old-river-winfree-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old River-Winfree sits at the crossroads of Farm Roads 565 and 1409, about 35 miles east of Houston.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/old-river-winfree-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "In 1982 the Texas Historical Commission erected a marker to honor the historic Old River waterway.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/old-river-winfree-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
