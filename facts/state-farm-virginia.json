  "facts": [
    {
      "id": 1,
      "text": "James River Correctional Center sits in Goochland County near Crozier, Virginia, as a former state‑run medium‑security prison.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/James_River_Correctional_Center"
    },
    {
      "id": 2,
      "text": "Opened in 1896, it was the oldest prison in Virginia.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/James_River_Correctional_Center"
    },
    {
      "id": 3,
      "text": "The facility once housed about 450 male inmates and employed 160 staff members.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/James_River_Correctional_Center"
    },
    {
      "id": 4,
      "text": "It closed on April 1, 2011 after a proposed $10.9 million budget cut for the next fiscal year.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/James_River_Correctional_Center"
    },
    {
      "id": 5,
      "text": "After closing, the state‑run property became a film set for movies like Harriet and Lincoln, and shows such as John Adams.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/James_River_Correctional_Center"
    },
