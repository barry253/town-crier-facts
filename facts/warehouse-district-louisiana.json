  "facts": [
    {
      "id": 1,
      "text": "The Warehouse District began in the early 19th century as a storage hub for goods moving through New Orleans’ port.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neworleans.com/plan/neighborhoods/arts-warehouse-district/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1830s New Basin Canal linked Lake Pontchartrain to the Mississippi River, cementing the area’s role in shipping.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://preservethewarehousedistrict.com/district/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the 1803 Louisiana Purchase, the area earned the nickname “The American Sector” for its rapid American‑influenced growth.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://preservethewarehousedistrict.com/district/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, many of the district’s historic warehouses have been turned into apartments, condominiums, and boutique hotels.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neworleans.com/plan/neighborhoods/arts-warehouse-district/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood is now called the Arts District, reflecting its vibrant mix of galleries, studios, and performance spaces.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://preservethewarehousedistrict.com/district/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Piazza d’Italia, designed by Charles Moore in the late 1970s, blends classical Italian design with postmodern flair.",
      "sourceSentenceIds": [
        8
      ],
