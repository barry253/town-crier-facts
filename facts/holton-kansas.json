  "facts": [
    {
      "id": 1,
      "text": "Holton was founded by Free State settlers who trekked from Milwaukee in 1856, crossing Elk Creek and building a log fort known as Jim Lane's Fort.",
      "sourceSentenceIds": [
        12,
        13,
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holton%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after Edward Dwight Holton, a Milwaukee abolitionist who financed the settlers’ journey to Kansas.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holton%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Holton became the county seat of Jackson County in 1858, a status it holds to this day.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holton%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original courthouse, a simple frame building, stood on the east side of the square until a new courthouse was completed in 1921.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holton%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1859, abolitionist John Brown escorted a group of escaped slaves through Holton, sparking the skirmish known as the Battle of the Spurs.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holton%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
