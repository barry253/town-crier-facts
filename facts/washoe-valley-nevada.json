  "facts": [
    {
      "id": 1,
      "text": "Washoe Valley gets its name from the Washoe people, a nomadic tribe that once roamed these grasslands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/washoe_valley_nevada"
    },
    {
      "id": 2,
      "text": "In the 1850s, Washoe Valley became a vital trail for emigrants heading to the Comstock Lode silver mines.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/washoe_valley_nevada"
    },
    {
      "id": 3,
      "text": "Bowers Mansion, built in 1864 by Comstock Lode millionaires, now serves as a county museum showcasing Nevada's mining era.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/washoe_valley_nevada"
    },
    {
      "id": 4,
      "text": "Washoe Lake State Park spans 3,775 acres, offering hiking, horseback riding, and birdwatching in the valley's open spaces.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/washoe_valley_nevada"
    },
    {
      "id": 5,
      "text": "Washoe Valley's steep slopes and dry vegetation make it highly fire prone, with limited water for protection.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washoe_Valley%2C_Nevada"
    },
    {
      "id": 6,
      "text": "For thousands of years, the Washoe people used the valley seasonally for hunting, gathering pine nuts, and fishing at Lake Tahoe.",
      "sourceSentenceIds": [
        12
