  "facts": [
    {
      "id": 1,
      "text": "The Annex’s leafy streets are lined with historic Victorian homes that still showcase the neighborhood’s 19th‑century charm.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/annex/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood was formally subdivided in the 1870s and 1880s, marking the start of its development as a distinct community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://toronto-future.com/en/eternal-13348-the-annex-one-of-torontos-oldest-and-most-well-known-neighbourhoods",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its roots trace back to the 1790s, when the area was part of the original Town of York settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://toronto-future.com/en/eternal-13348-the-annex-one-of-torontos-oldest-and-most-well-known-neighbourhoods",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Architecturally, the Annex blends brick and sandstone, making it one of North America’s most interesting examples of historic urban development.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://toronto-future.com/en/eternal-13348-the-annex-one-of-torontos-oldest-and-most-well-known-neighbourhoods",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early residents included retail magnate Timothy Eaton and distillery president George Gooderham, both of whom helped shape the area’s elite status.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/annex/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Annex Residents Association successfully opposed the proposed Spadina Expressway, preserving the neighborhood’s continuity and character.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.neighbourhoodguide.com/toronto/midtown/annex/",
