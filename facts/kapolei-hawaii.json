  "facts": [
    {
      "id": 1,
      "text": "Kapolei is nicknamed Oahu’s Second City, a title it earned in 1977 when the state officially recognized it as the island’s second urban center.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://hawaiihome.me/kapolei/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Kapolei’s land was once part of the estate of industrialist James Campbell, whose legacy lives on in the area’s development plans.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kapolei%2C_Hawaii",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The region that is now Kapolei was built on former sugarcane and pineapple fields, reflecting Hawaii’s agricultural past.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kapolei%2C_Hawaii",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kapolei Property Development, a subsidiary of the James Campbell Company, has been the primary developer shaping the community’s modern skyline.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kapolei%2C_Hawaii",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original master plan called for a smart city with energy‑efficient technologies, walkable streets, and a hub for government and business offices.",
