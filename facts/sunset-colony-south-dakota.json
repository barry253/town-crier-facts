  "facts": [
    {
      "id": 1,
      "text": "Sunset Colony was established in 1977 as a Hutterite community through a division from the Glendale Hutterite Colony.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunset_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Sunset Colony operates as a communal agricultural settlement adhering to Anabaptist traditions of shared property and pacifism.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunset_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The community focuses on farming and livestock, including a seasonal greenhouse that retails flowers, produce, and pumpkins.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunset_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Sunset Colony grew enough to form a daughter community, the Blue Sky Hutterite Colony, in 2019.",
      "sourceSentenceIds": [
        16,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunset_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Sunset Colony experiences a humid continental climate with cold, snowy winters and warm, humid summers.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/sunset_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Sunset Colony is located in a region known for its agricultural productivity and glacial till soils.",
