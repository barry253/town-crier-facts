  "facts": [
    {
      "id": 1,
      "text": "Dimond was originally a separate settlement distinct from Oakland, located in Dimond Canyon.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Dimond_District,_Oakland,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The district is named after Hugh Dimond, a Gold Rush miner who bought the land in 1867.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dimond_District%2C_Oakland%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1897 cottage built by Hugh Dimond reused adobe bricks from the Peralta family’s 1827 home, later used in the Boy Scout hut still standing in Dimond Park.",
      "sourceSentenceIds": [
        17,
        18,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dimond_District%2C_Oakland%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dimond Park’s utility building hides a plaque that mentions the park’s history and the use of those same adobe bricks.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.embracedimond.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Altenheim, a historic building in Dimond, began as a retirement home for German Americans.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dimond_District%2C_Oakland%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "La Farine, a famous French bakery in Dimond, reflects the neighborhood’s multicultural character.",
