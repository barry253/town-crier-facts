  "facts": [
    {
      "id": 1,
      "text": "Saint Clair is famed for producing squibs, fuses, and caps that powered the region’s coal mines.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Clair%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "In 1888, the Hayes squib factory burned to the ground, shaking the local mining industry.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stclairpa.gov/history-of-st-clair/"
    },
    {
      "id": 3,
      "text": "Daddow & Beadles, the other squib makers, shuttered their operations in 1928.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stclairpa.gov/history-of-st-clair/"
    },
    {
      "id": 4,
      "text": "Daddow also opened the Lattimer Cap Factory on Nicholas and Patterson Streets.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stclairpa.gov/history-of-st-clair/"
    },
    {
      "id": 5,
      "text": "The first railroad reached Saint Clair in 1829, linking it to the coal boom.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stclairpa.gov/history-of-st-clair/"
    },
    {
      "id": 6,
      "text": "Saint Clair sits just two miles north of Pottsville, anchoring it in Pennsylvania’s southern Coal Region.",
      "sourceSentenceIds": [
        22
      ],
