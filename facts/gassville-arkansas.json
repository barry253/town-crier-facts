  "facts": [
    {
      "id": 1,
      "text": "Gassville got its name from 1800s postmaster Cox, who was nicknamed \"gasser\" because of his talkative nature.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofgassville.gov/"
    },
    {
      "id": 2,
      "text": "Before becoming Gassville, the town was known as Mount Pleasant and even earlier as Turkey's Neck.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gassville%2C_Arkansas"
    },
    {
      "id": 3,
      "text": "The settlement that would become Gassville dates back to the 1840s, making it one of Arkansas's older communities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gassville%2C_Arkansas"
    },
    {
      "id": 4,
      "text": "Gassville sits at 36°16′59″N 92°29′24″W, placing it in the heart of Baxter County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gassville%2C_Arkansas"
    },
    {
      "id": 5,
      "text": "American Stitchco, the town’s largest manufacturer, employs over 90 people at its Gassville facility.",
