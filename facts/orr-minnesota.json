  "facts": [
    {
      "id": 1,
      "text": "William Orr, a lumberman, built the first hotel and general store that became the town's core.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orrmn.gov/history-of-orr/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Orr was founded in 1905 and quickly became a hub during the peak of the lumbering industry.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://orrmn.gov/history-of-orr/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Canadian National Railroad runs through Orr, with sidings close to the city limits, shaping its growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://orrmn.gov/visitors/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Orr sits on the shores of Pelican Lake, a clear water body that defines its landscape.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orr%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town lies within the Kabetogama State Forest, surrounded by dense pine and spruce.",
      "sourceSentenceIds": [
        7
