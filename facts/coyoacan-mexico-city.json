  "facts": [
    {
      "id": 1,
      "text": "Coyoacán’s name comes from Nahuatl, meaning ‘place of those who own coyotes,’ a nod to its pre‑Hispanic roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coyoac%C3%A1n",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During colonial times, Coyoacán served as the first capital of the Viceroyalty and later stood guard against the Mexican‑American War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lugares.inah.gob.mx/en/node/4791",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hernán Cortés and his troops established the first municipal council in Coyoacán after conquering the area.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lugares.inah.gob.mx/en/node/4791",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough’s cultural center hosts three art galleries—Alfredo Ramos Martínez, Guillermo Kahlo, and Miguel Álvarez Acosta—each showcasing temporary exhibitions.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coyoac%C3%A1n",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Coyoacán also houses the Instituto del Derecho de Asilo y las Libertades Públicas, founded in 1990, which champions asylum rights.",
