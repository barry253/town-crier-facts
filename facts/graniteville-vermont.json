  "facts": [
    {
      "id": 1,
      "text": "Graniteville is home to the E. L. Smith Quarry, which is the world's largest deep hole granite quarry.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Graniteville%2C_Vermont"
    },
    {
      "id": 2,
      "text": "The Rock of Ages Corporation in Graniteville operates one of North America's deepest active quarries, reaching nearly 600 feet deep.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graniteville_east_barre_vermont"
    },
    {
      "id": 3,
      "text": "Graniteville served as a filming backdrop for the 1997 movie Batman and Robin and the 2009 Star Trek film.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vermont.com/cities/graniteville/"
    },
    {
      "id": 4,
      "text": "Permanent European settlement in the Graniteville area began in 1788 when John Goldsbury and Samuel Rogers arrived from Massachusetts and New Hampshire.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graniteville_east_barre_vermont"
    },
    {
      "id": 5,
      "text": "Quarrying in Graniteville exploded after the Civil War thanks to railroad access that enabled the export of durable gray granite.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/graniteville_east_barre_vermont"
    },
    {
      "id": 6,
      "text": "The land encompassing Graniteville was part of the original 1780 charter for the town of Barre, then called Wildersburgh.",
