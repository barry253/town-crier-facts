      ],
      "source": "https://www.franklincountychamber.com/about-franklin-county/cities/decherd",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Haynes House, a historic home in Decherd, earned a spot on the National Register of Historic Places.",
