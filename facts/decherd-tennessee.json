      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from Peter Decherd, who settled the area in 1831 and owned the Hundred Oaks plantation.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.franklincountychamber.com/about-franklin-county/cities/decherd",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Decherd sprang up around the Nashville and Chattanooga Railroad, which ran through the area in 1851.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
