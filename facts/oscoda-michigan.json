      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The famous Lumberman's Monument stands in Oscoda’s Lake Huron National Forest, a tribute to the region’s logging heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
