      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oscoda was declared Michigan’s official home of Paul Bunyan after a 1906 press article by James MacGillivray.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oscoda%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wurtsmith Air Force Base, opened in 1923, housed B‑52 Stratofortress jets during the Cold War before closing in 1993.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
