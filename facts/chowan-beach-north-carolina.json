  "facts": [
    {
      "id": 1,
      "text": "Chowan Beach began in 1928 when Eli Reid turned 400 acres on the Chowan River into a segregation‑era resort for African Americans.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.irememberourhistory.org/authors-poets/chowan-beach",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The resort boasted wide sandy beaches, guest cottages, a bathhouse, a dance hall, a photo studio, a restaurant, a picnic area, and a German‑made carousel.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.irememberourhistory.org/authors-poets/chowan-beach",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Legendary performers such as King, James Brown, Sam Cooke, and The Drifters once entertained crowds at Chowan Beach’s dance hall.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.irememberourhistory.org/authors-poets/chowan-beach",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chowan Beach sits on the east bank of the tidal Chowan River in northern Chowan County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chowan_Beach%2C_North_Carolina",
