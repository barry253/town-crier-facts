      "id": 1,
      "text": "Elk City began as a trading post by John Kappell in 1868 at the confluence of Duck Creek and the Elk River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
