  "facts": [
    {
      "id": 1,
      "text": "Emma was named for Emma Clayton, the wife of contractor Thomas Clayton, whose family helped build the post‑war railroad.",
      "sourceSentenceIds": [
        2,
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emma_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled between Dryman Mountain and the French Broad River, Emma’s geography shapes its valley views.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://specialcollections.buncombenc.gov/2019/06/01/cousin-caney-the-corrupt-commissioner-and-the-brand-new-emma-leicester-road-52-weeks-52-communities/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Emma Station, a modest depot built in the late 1880s, was the first stop west of Asheville on the WNCRR line to Murphy.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emma_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Commissioner Brown pushed for the Emma‑Leicester Road, a tough‑terrain route that linked Leicester and Asheville over bridges like Hazel Mill.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/emma_north_carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Emma’s central crossroads at North Louisiana Avenue and Emma Road once served as a key river‑crossing access point.",
