  "facts": [
    {
      "id": 1,
      "text": "Uniontown was platted in 1816 by Elias Brenner and Thomas Albert on land in Lake Township.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Uniontown,_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name came from two stagecoach lines that met near the original site, prompting the choice of “Union.”.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uniontown%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1830s Uniontown boasted a church, schoolhouse, tannery, tavern, and two general stores.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uniontown%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "South of Uniontown lies the Industrial Excess Landfill, now a Superfund site that closed in 1980.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Uniontown%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Uniontown sits along the Tuscarawas River, a tributary that flows through Stark County.",
