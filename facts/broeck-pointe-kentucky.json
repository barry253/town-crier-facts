  "facts": [
    {
      "id": 1,
      "text": "Broeck Pointe became a home‑rule city on February 6, 1980, giving residents control over zoning, taxes, and street maintenance.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/broeck_pointe_kentucky"
    },
    {
      "id": 2,
      "text": "The city’s original borders covered just 0.07 square miles, a compact footprint focused on preserving a quiet residential enclave.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/broeck_pointe_kentucky"
    },
    {
      "id": 3,
      "text": "Broeck Pointe sits 11 miles northeast of downtown Louisville, bordered by Goose Creek to the west and Ten Broeck to the east.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Broeck_Pointe%2C_Kentucky"
    },
    {
      "id": 4,
      "text": "In 1985, the city adopted Ordinance 4, Series 1985, formally integrating the Kentucky Building Code into all construction regulations.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/broeck_pointe_kentucky"
    },
    {
      "id": 5,
      "text": "Broeck Pointe’s incorporation was driven by residents’ desire to prevent annexation by Louisville and maintain local control over services.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/broeck_pointe_kentucky"
    },
    {
      "id": 6,
      "text": "The community remains a quiet enclave with no major commercial or industrial presence, preserving its residential character.",
