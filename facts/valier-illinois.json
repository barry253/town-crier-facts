  "facts": [
    {
      "id": 1,
      "text": "Valier sprang to life in 1905 when the Chicago, Burlington, and Quincy Railroad cut through the area, sparking hopes for a nearby coal mine.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
