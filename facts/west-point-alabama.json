  "facts": [
    {
      "id": 1,
      "text": "West Point started as an unnamed crossroads where north‑south roads from Battle Ground and Clarkson met east‑west roads to Malaby and Crooked Creek, settled in the late 1870s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/west-point/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1910 residents began calling the community West Point, a name chosen because it lay west of the Louisville and Nashville Railroad, and it was established in 1918.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/west_point_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "West Point's first telephone service arrived in 1909, connecting the small community to the wider world.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/west-point/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Around 1900 a sawmill, grist mill, and cotton gin opened, and the first general store began operating in 1910.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/west-point/",
      "category": "economy",
      "quality": "good"
    },
    {
