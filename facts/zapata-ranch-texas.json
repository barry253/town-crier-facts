  "facts": [
    {
      "id": 2,
      "text": "The area was first settled in 1753 by José Vázquez Borrego, a rancher from Coahuila, after earlier attempts described as barren.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/zapata-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The county’s name honors local rancher Antonio Zapata, and its borders touch Webb, Jim Hogg, Starr counties and Mexico.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/zapata-county",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Zapata County Museum of History houses an encyclopedic collection of cultural objects and biological specimens, drawing repeat visitors.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://zapatamuseum.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The museum’s exhibits trace Zapata’s history from disasters to diversity, showcasing interactive artifacts that tell local stories.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://zapatamuseum.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The region’s early history includes the founding of Nuestra Señora de los Dolores Hacienda in 1750, a few miles from present San Ygnacio.",
