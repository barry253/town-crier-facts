  "facts": [
    {
      "id": 1,
      "text": "Pamplin City was renamed in 1854 after a railroad official, reflecting its origins as a railroad boom town.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.appomattoxcountyva.gov/292/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pamplin Pipe Factory, built around 1880, once held the title of the largest clay pipe factory in the United States.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pamplin_City%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Pamplin Train Depot now houses the Pamplin City Community Museum, showcasing local artifacts.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicappomattox.com/directory/pamplin-city-community-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1980 the town’s historic district was listed on the National Register of Historic Places.",
