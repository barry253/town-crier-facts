    {
      "id": 2,
      "text": "Since 1973, Nuiqsut hosts the village corporation Kuukpik, with over 600 shareholders.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nuiqsut%2C_Alaska"
    },
    {
      "id": 3,
      "text": "Founded in 1974 by relocated Utqiagvik families, Nuiqsut blends modern life with enduring cultural traditions.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://icas-nsn.gov/nuiqsut/"
    },
    {
      "id": 4,
      "text": "Nuiqsut sits on the Colville River, about five miles north of its confluence with the Itkillik River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nuiqsut%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Nuiqsut is accessible during winter via an ice road, a vital link for supplies and travel.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nuiqsut%2C_Alaska"
    },
    {
