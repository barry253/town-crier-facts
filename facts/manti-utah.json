  "facts": [
    {
      "id": 1,
      "text": "Manti was named by Brigham Young after a city mentioned in the Book of Mormon.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manti%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Manti Utah Temple, the fifth temple built by the Church of Jesus Christ of Latter‑Day Saints, crowns the town’s skyline.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manti%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Manti hosted the Mormon Miracle Pageant each summer for two weeks, a large outdoor reenactment of Book of Mormon stories.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Manti%2C_Utah",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Main Street’s historic brick buildings date back to the late 1800s, giving the town a postcard‑like feel.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/utah-gorgeous-historic-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The John Patten House Museum, a pioneer home, now showcases history amid lavender blooms.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/utah-gorgeous-historic-town/",
      "category": "landmark",
      "quality": "good"
    },
