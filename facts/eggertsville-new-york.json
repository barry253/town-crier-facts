  "facts": [
    {
      "id": 1,
      "text": "Eggertsville takes its name from Christian Eggert, the town’s first postmaster, whose legacy lives on in the local street names.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://buffalostreets.com/2022/01/07/eggert/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Eggert Road, one of the longest streets in the area, honors that same pioneer postmaster and runs north‑south through four municipalities.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://buffalostreets.com/2022/01/07/eggert/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historically, Eggertsville grew as a quiet residential enclave within the larger Town of Amherst, benefiting from its proximity to Buffalo.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/eggertsville-29582",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Eggertsville‑Snyder Public Library is often treated as a single community hub, reflecting the close ties between the two hamlets.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://buffalostreets.com/2022/01/07/eggert/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eggertsville is officially part of the Buffalo‑Niagara Falls metropolitan area, linking it to one of New York’s largest urban regions.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eggertsville%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Within the Town of Amherst, Eggertsville ranks among five distinct hamlets that share the town’s historic character.",
