  "facts": [
    {
      "id": 1,
      "text": "Asahi Breweries was founded in 1889, originally named 朝日麦酒株式会社, marking the start of Japan’s oldest beer company.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
