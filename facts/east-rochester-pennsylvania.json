  "facts": [
    {
      "id": 1,
      "text": "East Rochester was incorporated in 1908, breaking away from Rochester Township to become its own borough.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eastrochesterpa.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from its neighbor to the west, Rochester, Pennsylvania.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bcpahistory.org/beavercounty/BeaverCountyCommunities/EastRochesterfolder/EastRochester.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1901 the Rochester Tumbler Works, a major glass factory along the Ohio River, burned down in the worst fire in Beaver County history.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eastrochesterpa.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Locals once called the town “Seldom Seen” because the railroad kept residential streets hidden from the main road.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eastrochesterpa.com/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The Monaca–East Rochester Bridge opened in 1959, replacing the original 1914 suspension bridge and linking the borough to Monaca across the Ohio River.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://eastrochesterpa.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "East Rochester’s early growth peaked in 1960 with a population of 1,025, supported by warehouses, a K‑Mart Shopping Plaza, and other businesses.",
      "sourceSentenceIds": [
        26,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
