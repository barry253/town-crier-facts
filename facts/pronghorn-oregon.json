    {
      "id": 1,
      "text": "Pronghorn, Oregon, is named for the antelope herds that were historically common across the region's open rangelands.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pronghorn_oregon"
    },
    {
      "id": 2,
      "text": "The land around Pronghorn was traditionally used for hunting and gathering by the Northern Paiute and Warm Springs tribes.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pronghorn_oregon"
    },
    {
      "id": 3,
      "text": "Pronghorn sits at an elevation of about 3,200 feet within a high desert ecosystem of sagebrush and bunchgrasses.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pronghorn_oregon"
    },
    {
      "id": 4,
      "text": "Early settlers in the Pronghorn area focused on livestock ranching due to the challenging, arid climate of the high desert.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/pronghorn_oregon"
    },
    {
