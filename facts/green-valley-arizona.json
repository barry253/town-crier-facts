  "facts": [
    {
      "id": 1,
      "text": "Founded in 1964 as a retirement destination, Green Valley offers sunshine, healthcare, golf, shopping, and outdoor recreation within the historic San Ignacio de las Canoa Land Grant.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greenvalleysahuarita.com/chamber-visitor-center",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hohokam people, who once inhabited the area, were known for peaceful communities and sophisticated irrigation systems.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.greenvalleysahuarita.com/chamber-visitor-center",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Green Valley houses the Titan Missile Museum, a Cold War-era missile site and National Historic Landmark that offers unique tours.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.greenvalleysahuarita.com/chamber-visitor-center",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Green Valley sits along the western side of the Santa Cruz River, 20 miles south of Tucson and 40 miles north of Nogales.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Valley%2C_Arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The community is surrounded by copper mines and lies near the Santa Rita Mountains, popular for cycling, hiking, and birding.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Valley%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Green Valley experiences a hot semi-arid climate with three distinct seasons, including a dry summer and a humid monsoon from July to September.",
