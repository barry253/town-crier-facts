      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bitely’s post office opened September 13, 1889, with Archer D. as first postmaster.",
      "sourceSentenceIds": [
        3,
        13,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
