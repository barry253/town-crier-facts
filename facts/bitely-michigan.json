      ],
      "source": "https://en.wikipedia.org/wiki/Bitely%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every July, residents celebrate the Bitely Homecoming parade on the third Saturday, a tradition that keeps the community’s history alive.",
      "sourceSentenceIds": [
