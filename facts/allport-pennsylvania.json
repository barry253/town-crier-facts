  "facts": [
    {
      "id": 1,
      "text": "Allport takes its name from James Allport, a prominent pioneer who helped develop the community during the nineteenth century.",
      "sourceSentenceIds": [
        8,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allport_pennsylvania"
    },
    {
      "id": 2,
      "text": "Before European colonization, the land around Allport was part of the traditional territory of the Lenape people.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allport_pennsylvania"
    },
    {
      "id": 3,
      "text": "Allport transitioned from pioneer farming to lumbering in the 1830s, using local tributaries to float logs down to sawmills.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allport_pennsylvania"
    },
    {
      "id": 4,
      "text": "The Allport Coal Company began mining bituminous coal in 1900, utilizing the Walnut Run Branch of the Pennsylvania Railroad.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allport_pennsylvania"
    },
    {
      "id": 5,
      "text": "Allport borders the expansive Moshannon State Forest to the east, which provides a natural buffer of dense woodlands.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/allport_pennsylvania"
    },
    {
      "id": 6,
      "text": "Sitting at an elevation of 1,600 feet, Allport typically sees an average of 46 inches of snowfall each year.",
      "sourceSentenceIds": [
