  "facts": [
    {
      "id": 1,
      "text": "Al Garhoud grew from a 20th‑century creekside settlement into a trading hub as Dubai’s maritime trade expanded.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Al_Garhoud",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Al Garhoud comes from Arabic “garaheed,” meaning hard earth mounds that once made early habitation difficult.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Al_Garhoud",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2008, a new bridge opened over Dubai Creek, replacing the old 16‑metre span and easing traffic through the area.",
      "sourceSentenceIds": [
        24,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Al_Garhoud",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Al Garhoud’s proximity to Dubai International Airport’s Terminals 1 and 3 has turned it into a residential spot for airport staff.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Al_Garhoud",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Summer heat in Al Garhoud often tops 40 °C, while winter highs stay around 20–25 °C, making the climate noticeably mild in winter.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Al_Garhoud",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Average annual rainfall is only about 80–100 mm, mostly in brief winter showers between November and March.",
