  "facts": [
    {
      "id": 1,
      "text": "Brigantine’s boardwalk, built in 1906, stretches close to the Atlantic Ocean, making it more vulnerable to storm damage than its neighbor’s boardwalk.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margate_City%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s boardwalk suffered heavy losses during the 1944 Great Atlantic hurricane, with only a few sections surviving until the 1962 Ash Wednesday Storm.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margate_City%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Brigantine’s name honors Margate in Kent, England, reflecting the town’s early settlers’ heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margate_City%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city sits on Absecon Island, an 8.1‑mile stretch that also hosts Atlantic City and Ventnor City to the northeast.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margate_City%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Local marinas offer docks for lease, equipment rentals, fuel stations, and fishing charters, catering to boating enthusiasts.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Margate_City%2C_New_Jersey",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lucy the Elephant, a 65‑foot wooden and metal‑clad elephant, stands as America’s oldest surviving roadside attraction and a National Historic Landmark.",
