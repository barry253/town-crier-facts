  "facts": [
    {
      "id": 1,
      "text": "Meridian earned its name from the nearby Meridian Creek and Meridian Knobs, named for their proximity to the ninety‑eighth meridian.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 1",
