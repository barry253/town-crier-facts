      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wvexplorer.com/travel/communities/cities-towns/terra-alta-west-virginia/"
    },
    {
      "id": 3,
      "text": "Originally called Portland, the town was later incorporated as Terra Alta in 1890.",
      "sourceSentenceIds": [
