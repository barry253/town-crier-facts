      "quality": "good"
    },
    {
      "id": 2,
      "text": "In March 1849 the Boston, Concord & Montreal Railroad reached Meredith, turning it into a summer resort destination.",
      "sourceSentenceIds": [
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Meredith%2C_New_Hampshire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Meredith Village sits on Lake Winnipesaukee’s shore, with several other large lakes partially inside town borders.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meredith%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town hosts the Stonedam Island Natural Area, a protected spot on Lake Winnipesaukee.",
