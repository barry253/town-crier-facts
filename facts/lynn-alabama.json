  "facts": [
    {
      "id": 1,
      "text": "John Lynn, a Civil War veteran, donated land for a railroad in 1888, and the town was named after him.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/lynn/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area around what is now Lynn began to be settled in 1814, five years before Alabama achieved statehood.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/lynn/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1890s, coal mines began to open around Lynn, and at one point the area was the fourth‑largest coal producer in the state.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/lynn/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lynn has an elementary school, Lynn Elementary School, and a high school, Lynn High School.",
