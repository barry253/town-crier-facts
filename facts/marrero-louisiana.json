  "facts": [
    {
      "id": 1,
      "text": "Marrero takes its name from Louis Herman Marrero, the Louisiana politician who founded the Marrero Land Company.",
      "sourceSentenceIds": [
        19,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://arklasdahistory.org/a-brief-history-of-marrero-louisiana/"
    },
    {
      "id": 2,
      "text": "A French long‑lot plantation once stretched 80 arpents—about three miles—along the Mississippi, reaching what is today Eighty Arpent Road.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nola.com/entertainment_life/how-marrero-grew-from-the-land-of-truck-farms-to-become-a-suburb-of-new/article_e0e3c442-7a19-40ed-8b83-108498c5a250.html"
    },
    {
      "id": 3,
      "text": "The New Orleans, Opelousas & Great Western Railroad opened in 1853 along present‑day Fourth Street, turning the plantation into a freight and passenger hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nola.com/entertainment_life/how-marrero-grew-from-the-land-of-truck-farms-to-become-a-suburb-of-new/article_e0e3c442-7a19-40ed-8b83-108498c5a250.html"
    },
    {
      "id": 4,
      "text": "Unlike nearby towns, Marrero never developed a historic downtown, lacking a central square or Main Street.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nola.com/entertainment_life/how-marrero-grew-from-the-land-of-truck-farms-to-become-a-suburb-of-new/article_e0e3c442-7a19-40ed-8b83-108498c5a250.html"
    },
    {
