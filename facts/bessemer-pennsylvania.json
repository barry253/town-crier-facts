  "facts": [
    {
      "id": 1,
      "text": "Bessemer was founded in 1913 as a company town for limestone quarry workers.",
      "sourceSentenceIds": [
        13,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bessemerpa.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Sir Henry Bessemer, whose steel‑purifying process inspired local limestone quarrying.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bessemerpa.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two railroad spurs from the Pennsylvania and Pittsburgh & Lake Erie Railroads once hauled cement and brick out of Bessemer.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bessemerpa.com/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bessemer Area Historical Society preserves the borough’s industrial heritage and runs a museum with shared historical materials.",
      "sourceSentenceIds": [
        1,
        5,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bessemerhistory.org/about/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Campbell Memorial Library, once central, now sits on the town’s outskirts, serving residents with books and community events.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bessemerpa.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Quarry lakes formed by historic limestone extraction now offer fishing and boating for locals.",
      "sourceSentenceIds": [
        16
