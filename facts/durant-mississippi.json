      "id": 1,
      "text": "Durant was founded in 1858 as a station on the Mississippi Central Railroad, on a 169‑acre tract donated by landowner J.A.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
