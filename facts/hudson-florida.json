  "facts": [
    {
      "id": 1,
      "text": "Hudson was founded in 1878 when Isaac Hudson moved his family and set up a post office in his home.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew when the Fivay Company cut lumber and shipped it by rail to Tampa in the early 1900s.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_Florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912 the Fivay Company closed, causing Hudson to shift to shrimping and fishing, employing half the men through the 1950s.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_Florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hudson’s sea‑level elevation and Gulf of Mexico location give it a humid subtropical climate with hot summers and cool winters.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_Florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hurricane Idalia in 2023 damaged Hudson’s waterfront homes through fires and flooding, highlighting the town’s vulnerability.",
