  "facts": [
    {
      "id": 1,
      "text": "Rachel, Nevada, was founded in May 1973 by alfalfa farmer D.C. and renamed in 1978 after the first child born there, Rachel Jones.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
