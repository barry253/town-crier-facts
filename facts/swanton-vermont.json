  "facts": [
    {
      "id": 1,
      "text": "Swanton was chartered on August 17, 1763 by New Hampshire Governor Benning Wentworth, long before Vermont became a state.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.swantonvt.gov/about/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Missisquoi River winds through Swanton, crossing the Village Dam before emptying into Lake Champlain via the Missisquoi National Wildlife Refuge.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.swantonvt.gov/about/overview",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Swanton’s town green hosts a pair of “royal” swans, a gift from the Queen of England in 1961 that still visit every summer.",
      "sourceSentenceIds": [
        14,
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.swantonvt.gov/about/overview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Abenaki people, who first settled the area around 10,000 years ago, maintain a museum just outside the village on South River Street.",
      "sourceSentenceIds": [
        8,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.swantonvt.gov/about/overview",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Swanton has been a transportation hub since the 18th century, moving timber by water and later by rail, a legacy still visible in the freight trains that run east of town today.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
