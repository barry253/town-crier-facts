  "facts": [
    {
      "id": 1,
      "text": "Paradise Inn, perched at 5,400 feet on Mount Rainier’s south slope, opened its doors in 1916 as a rustic retreat for early park visitors.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paradise_Inn_(Washington)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The inn’s design, crafted by Frederick Heath in 1915, showcases National Park Service rustic architecture that blends stone, timber, and handcrafted details.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paradise_Inn_(Washington)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1987, Paradise Inn earned National Historic Landmark status, recognizing its architectural integrity and role in the park’s heritage.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Paradise_Inn_(Washington)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The inn’s great room features custom furniture by carpenter Hans Fraehnke, adding a unique touch to its historic interior.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Paradise_Inn_(Washington)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Originally planned for Longmire, the National Park Service shifted the inn’s location to Paradise after financier John Reese withdrew support.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paradise_Inn_(Washington)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nearby, the historic Paradise Ranger Station sits beside the upper parking lot, offering a glimpse into the park’s early visitor services.",
      "sourceSentenceIds": [
        7
      ],
