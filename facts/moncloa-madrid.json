    {
      "id": 3,
      "text": "Moncloa metro station opened on 17 July 1963 when Line 3 extended from Argüelles.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncloa_(Madrid_Metro)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Its original 90‑metre platforms made it the longest on Line 3, a feature that kept it from being renovated in 2006.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Moncloa_(Madrid_Metro)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A new underground bus terminal opened on 19 February 2008, moving seven lines into the former Line 3 platform space.",
