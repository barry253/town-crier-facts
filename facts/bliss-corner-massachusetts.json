    {
      "id": 1,
      "text": "Bliss Corner takes its name from the Bliss family, Seventh Day Baptists who settled the area in the mid‑1700s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dartmouthma.gov/846/Bliss-Corner",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Unlike other villages on Dartmouth’s Heritage Trail, Bliss Corner never grew into a commercial hub and stayed a quiet residential neighborhood.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dartmouthma.gov/846/Bliss-Corner",
      "category": "history",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "In the late 1800s a trolley line ran from Bliss Corner to Padanaram, spurring modest growth along the route.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dartmouthma.gov/846/Bliss-Corner",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clark’s Cove Guano Company, built in the late nineteenth century, processed bird guano shipped from the Americas and Pacific for Bay State Fertilizer.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dartmouthma.gov/846/Bliss-Corner",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early residents owned land, farmed, preached, and ran a saw mill, making the village a modest center of local industry.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dartmouthma.gov/846/Bliss-Corner",
      "category": "economy",
      "quality": "good"
    },
    {
