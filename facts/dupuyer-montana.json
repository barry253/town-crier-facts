  "facts": [
    {
      "id": 1,
      "text": "Dupuyer, named after the creek that borders it, originally called Osaks itukai by the Blackfeet and later translated to Depouille by French trappers.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dupuyer%2C_Montana"
    },
    {
      "id": 2,
      "text": "Dupuyer began in 1877 as a stagecoach stop on the Fort Benton–Fort Browning road, later becoming a ranch supply center.",
      "sourceSentenceIds": [
        8,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Dupuyer%2C_Montana"
    },
    {
      "id": 3,
      "text": "Back roads from Dupuyer lead west into the Bob Marshall Wilderness Complex, home to deer, elk, grizzly, black bears, and mountain sheep.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centralmontana.com/communities/dupuyer/"
    },
    {
      "id": 4,
      "text": "Dupuyer sits on the verge of the Rocky Mountain front, offering stunning scenery that enchants both visitors and residents.",
      "sourceSentenceIds": [
        9,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://centralmontana.com/communities/dupuyer/"
    },
    {
      "id": 5,
      "text": "In the 1890s, Dupuyer vied for Teton County seat but lost to Choteau, a contest that shaped local politics.",
