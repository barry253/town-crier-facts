  "facts": [
    {
      "id": 1,
      "text": "Waupun’s name comes from the Ojibwe word “Waubun,” meaning dawn, but a spelling mistake stuck when Wisconsin officially recorded it.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waupun%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Seymour Wilcox founded Waupun in 1839, becoming the first settler along the Rock River in a forested valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waupun%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1971 the Carnegie Library was leased to the Waupun Historical Society, preserving the town’s early civic heart.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mlsm.org/waupun-historical-society/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Milwaukee & Horicon Railroad arrived in Waupun in 1856, linking the town to regional trade routes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waupun%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Waupun Library Association started in 1858, and by 1900 the town offered a free public library thanks to the Women’s Club.",
      "sourceSentenceIds": [
        15,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waupun%2C_Wisconsin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Built in 1904 with a $10,000 Carnegie grant, the former library now houses the Waupun Heritage Museum.",
      "sourceSentenceIds": [
        20
