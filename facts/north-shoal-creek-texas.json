  "facts": [
    {
      "id": 1,
      "text": "Shoal Creek was named by Edwin Waller, and its mouth roughly marked the western city limits in Austin’s original 1839 Waller Plan.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shoal_Creek%2C_Austin%2C_Texas"
    },
    {
      "id": 2,
      "text": "Little Shoal Creek vanished beneath downtown in 1917, but the creek now flows under the historic Third Street Railroad Trestle.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shoal_Creek%2C_Austin%2C_Texas"
    },
    {
      "id": 3,
      "text": "The West Sixth Street Bridge, built in 1887 to span an 80‑foot wide creek, remains in use today and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shoal_Creek%2C_Austin%2C_Texas"
    },
    {
      "id": 4,
      "text": "North Shoal Creek’s modern neighborhood grew from the 1958 Steck Company printing facility to a mix of residential and commercial spaces.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nscna.org/history/"
    },
    {
      "id": 5,
      "text": "The Georgetown Limestone outcrop can be seen where Shoal Creek meets Martin Luther King Jr. Boulevard.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shoal_Creek%2C_Austin%2C_Texas"
    },
    {
      "id": 6,
      "text": "Shoal Creek hosts abundant dragonflies and damselflies, and iNaturalist records a Twinflagged Jumping Spider in the area.",
