  "facts": [
    {
      "id": 1,
      "text": "Lanark Village began as Lanark‑by‑the‑Gulf, a name borrowed from the Scottish borough of Lanark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lanarkvillageassociation.org/history"
    },
    {
      "id": 2,
      "text": "The Lanark Inn boasted 100 rooms, nightly live music, and a dancing pavilion connected by a boardwalk.",
      "sourceSentenceIds": [
        14,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lanarkvillageassociation.org/history"
    },
    {
      "id": 3,
      "text": "After a 1907 fire, the Inn was rebuilt in 1908, only to be torn down in 1942 for a military camp.",
      "sourceSentenceIds": [
        16,
        17,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lanarkvillageassociation.org/history"
    },
    {
      "id": 4,
      "text": "Camp Gordon Johnston, built on the site, trained a quarter‑million amphibious soldiers who later fought in the D‑Day invasion.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lanarkvillageassociation.org/history"
    },
    {
      "id": 5,
      "text": "Lanark Village sits 5 miles east of Carrabelle on U.S. 98, overlooking the Gulf of Mexico.",
      "sourceSentenceIds": [
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lanark_Village%2C_Florida"
    },
    {
      "id": 6,
      "text": "A private railroad once carried wealthy Tallahassee visitors from the capital straight to the Lanark Inn.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lanarkvillageassociation.org/history"
