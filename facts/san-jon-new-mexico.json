  "facts": [
    {
      "id": 1,
      "text": "San Jon was founded in 1902 and grew after the Atchison, Topeka and Santa Fe Railway arrived in 1904.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Jon%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first postmaster, W., named San Jon’s post office in 1906, and the town adopted that name.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_jon_new_mexico",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "San Jon sits on the Llano Estacado, a high plain whose deep soils support dryland farming and ranching.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_jon_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The stretch of Route 66 through San Jon, running from Glenrio to Tucumcari, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        3,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.theroute-66.com/san-jon.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1920s, Route 66 turned San Jon into a bustling stopover, spawning motels, cafes, and gas stations that peaked mid‑century.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/san_jon_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the 1990s, most of San Jon’s Route 66 motels and diners closed as traffic shifted to the interstate.",
      "sourceSentenceIds": [
