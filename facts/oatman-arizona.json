  "facts": [
    {
      "id": 1,
      "text": "Oatman was named after Olive Oatman, a girl captured by Native Americans in 1851 whose survival story became a regional symbol.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://visitoatman.com/pages/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sprang to life in 1915 when prospectors struck gold worth $10 million, turning it into a bustling boomtown for a decade.",
      "sourceSentenceIds": [
        14,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oatman%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The oldest two‑story adobe in Mohave County, still standing, earned historic landmark status and is a reminder of Oatman’s early days.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oatman%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1921 fire destroyed many buildings but spared the 1902 Oatman Hotel, which later claimed a rumored honeymoon suite for Clark Gable and Carole Lombard.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oatman%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oatman’s Wild West vibe endures with staged shootouts on Main Street and burros roaming the streets, a quirky tradition that began when miners brought the animals.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitoatman.com/pages/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town sits on the longest remaining stretch of historic Route 66, a fact that once drew travelers between Kingman and Needles before the highway was rerouted.",
