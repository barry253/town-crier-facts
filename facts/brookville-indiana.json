  "facts": [
    {
      "id": 1,
      "text": "Brookville served as the meeting place for Indiana’s first General Assembly in 1825, making it older than most historic sites.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/tiny-valley-town-indiana/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s Whitewater Canal connection tells a fascinating chapter of Indiana transportation history that most people overlook.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/tiny-valley-town-indiana/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Brookville’s historic Main Street looks like a movie set, with authentic 19th‑century buildings still standing.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/tiny-valley-town-indiana/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hermitage, a historic home in Brookville, showcases the residential architecture wealthy families built during the town’s heyday.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/tiny-valley-town-indiana/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Brookville Historical Society preserves the town’s rich past, educating younger generations about local heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://franklincountyhistoricalsociety.com/brookville-html/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Brookville’s library, more than a book collection, holds microfiche archives and oral histories that bring the town’s lineage to life.",
