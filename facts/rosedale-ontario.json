  "facts": [
    {
      "id": 1,
      "text": "Rosedale was named by Mary Boyles Powell after the wild roses that carpeted the estate of her husband, Sheriff William Botsford Jarvis, in the 1820s.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Rosedale,_Toronto",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s streets were laid out in a curvilinear pattern, a design choice that set Rosedale apart as one of Toronto’s earliest planned suburbs for the elite.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Rosedale,_Toronto",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Balfour Park, a 20.5‑hectare green space in Rosedale, houses the historic Rosehill Reservoir and a playground that connects to the Kay Gardner Beltline bike trail.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Rosedale,_Toronto",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rosedale’s heritage homes are protected by the Toronto Historical Board, with many properties listed as Heritage Properties for their architectural significance.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://communitysearch.ca/community/rosedale-toronto/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 2026 University—Rosedale by‑election was triggered by the resignation of Liberal MP Chrystia Freeland, who left her seat to serve as Canada’s Special Representative for the Reconstruction of Ukraine.",
      "sourceSentenceIds": [
        17,
        18,
        19,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/2026_University%E2%80%94Rosedale_federal_by-election",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Rosedale’s residents include many affluent and influential figures, a fact highlighted by local media that notes the neighborhood’s long history of attracting prominent citizens.",
