  "facts": [
    {
      "id": 1,
      "text": "Hillsboro was founded in 1807, just four years after Ohio became a state, and its original wide streets still guide traffic today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.discoverourhillsboro.org/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the hills near the original site, giving the city its distinctive topography.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873, Hillsboro became the birthplace of the Woman's Christian Temperance Union, a national movement that helped secure women's suffrage and prohibition.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two railroad lines once crossed Hillsboro, turning it into a hub for agricultural and industrial trade in the late 19th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.discoverourhillsboro.org/about",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The downtown “uptown” area, where all streets rise toward a central square, hosts a mix of shops and services that reflect the city’s historic streetscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.discoverourhillsboro.org/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hillsboro’s civic life thrives with family‑friendly festivals and parades that showcase the city’s heritage and historic streets.",
      "sourceSentenceIds": [
        8
