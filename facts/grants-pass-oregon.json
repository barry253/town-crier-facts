      ],
      "source": "https://en.wikipedia.org/wiki/Grants_Pass%2C_Oregon",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The through‑arch bridge over the Rogue River, a landmark since the 19th century, was refurbished in 2019.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
