  "facts": [
    {
      "id": 1,
      "text": "Rosedale’s streets were laid out after the South Side Railroad opened in 1867, turning the rural area into a suburban enclave.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/rosedale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s original name was Foster’s Meadow, honoring 17th‑century settler Christopher Foster who farmed the land.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/rosedale",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rosedale Avenue, the main artery, still hosts many homes built in the early 1900s, some dating back over a century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rosedalewhiteplainsneighborhood.org/rosedale-revealed-the-rich-history-and-lasting-heritage-of-a-white-plains-neighborhood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The LIRR’s Rosedale Station, rebuilt in 2019, sits at Brookville Boulevard and North Conduit Avenue, linking the neighborhood directly to Manhattan.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/rosedale",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rosedale Civic Association, founded in 1922, was pivotal in securing paved roads, schools, and better drainage for the community.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/rosedale",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rosedale was once part of the larger Springfield Gardens area before becoming its own distinct neighborhood in Queens.",
