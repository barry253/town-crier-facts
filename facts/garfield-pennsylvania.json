    },
    {
      "id": 2,
      "text": "The Bloomfield‑Garfield Corporation, founded by Lawrence O'Toole Parish, once supplied the town’s growing industrial needs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nulfre.com/garfield.html"
    },
    {
      "id": 3,
      "text": "Between 1960 and 1975 Garfield saw a sharp decline as businesses closed and housing projects were built, prompting many residents to leave.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nulfre.com/garfield.html"
    },
    {
      "id": 4,
      "text": "The Garfield Community Farm turns neglected lots into productive gardens, teaching residents how to grow organic food.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nulfre.com/garfield.html"
    },
    {
      "id": 5,
      "text": "Third Space Bakery offers everything from fresh bread to sweet treats, and even hosts baking classes for locals.",
      "sourceSentenceIds": [
