  "facts": [
    {
      "id": 1,
      "text": "Coalport’s downtown was added to the National Register of Historic Places in April 2000, thanks to 51 original buildings.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitclearfieldcounty.org/museum_history_coalport_museum",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Coalport Area Coal Museum opened in 1991, funded by community donations and small grants, and now sits on Main Street.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.coalportmuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The museum offers free tours of bituminous coal history, lumber heritage, and regional community records, all without charge.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.coalportmuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pennsylvania Route 53 runs through Coalport, linking it two miles north to Irvona and two miles south to Flinton.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coalport%2C_Pennsylvania",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "The museum’s new video series, “Coalport Chronicles,” spotlights the town’s historic Dixie Theatre and Opera House productions.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.coalportmuseum.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Central Hotel once housed miners and guests for many decades, now highlighted in the museum’s video projects.",
      "sourceSentenceIds": [
        7
