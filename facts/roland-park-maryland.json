  "facts": [
    {
      "id": 1,
      "text": "Roland Park was founded by Chicago firm Jarvis and Conklin in 1891, buying 500 acres near Lake Roland with $1M capital.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roland_Park%2C_Baltimore",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood was the first Baltimore subdivision to use deed restrictions, setting covenants that barred businesses and required setbacks.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roland_Park%2C_Baltimore",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Frederick Law Olmsted Jr. and Edward Bouton designed the layout, with Olmsted Brothers laying out the second tract and installing graded streets and a Lake Roland Elevated Railroad.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roland_Park%2C_Baltimore",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roland Park’s eclectic homes blend historic styles with Arts and Crafts, a hallmark of the area’s architectural character.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tclf.org/roland-park",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1974, Roland Park was added to the National Register of Historic Places, recognizing its status as a model streetcar suburb.",
