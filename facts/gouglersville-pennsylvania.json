  "facts": [
    {
      "id": 1,
      "text": "Named for early settlers John and Philip Gougler, Gouglersville emerged as one of Cumru Township's earliest villages amid German and Welsh settlement in the 18th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gouglersville_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Route 222 ran through the village, making it a key stagecoach stop between Reading and Lancaster, with inns, shops, a woolen factory and gun barrel works.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gouglersville_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1881 the village had 78 residents in 17 dwellings, with carpentry, blacksmithing, and small factories complementing farming.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/gouglersville_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gouglersville sits at the intersection of Old Lancaster Pike, Vermont Road, Gouglersville Road, and Mohns Hill Road, just east of a U.S. highway interchange.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gouglersville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Today the area remains a quiet rural enclave within the Reading metro, featuring historic structures like Wyomissing Church and surrounding agricultural land.",
