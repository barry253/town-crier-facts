  "facts": [
    {
      "id": 1,
      "text": "Copperopolis was founded in 1860 by William K. Reed and Thomas McCarty after copper ore was discovered, making it California's first copper town.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copperopolis%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, demand for copper surged, turning Copperopolis into a critical supplier of shell casings for the Union army.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copperopolis%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s main street was originally named Union, reflecting its Civil War ties, and later renamed Main as the town evolved.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/copperopolis",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1867 conflagration razed Copperopolis’s center, and with the war’s end and copper demand fading, the town never fully rebuilt.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/copperopolis",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Reed built Reeds Turnpike in 1862, a toll road linking Copperopolis to Stockton that remained in toll operation until 1865.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Copperopolis%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Four historic buildings in Copperopolis are listed on the National Register of Historic Places, preserving the town’s mining heritage.",
      "sourceSentenceIds": [
