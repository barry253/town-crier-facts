        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dranesvillees.fcps.edu/about/history/dranesville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dranesville’s rural past gradually merged into the Washington D.C. metropolitan area.",
      "sourceSentenceIds": [
        10
      ],
