  "facts": [
    {
      "id": 1,
      "text": "Carrabelle was founded in 1877 by Oliver Hudson Kelley, who named it after his niece Caroline Hall.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrabelle%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Carrabelle, Tallahassee and Georgia Railroad linked Carrabelle to Augusta and brought tourists to the Lanark Springs Hotel.",
      "sourceSentenceIds": [
        8,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrabelle%2C_Florida",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1963, Carrabelle became home to the “World’s Smallest Police Station,” a quirky landmark that has survived hurricanes and even a pickup truck collision.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrabelle%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Carrabelle History Museum, opened in 2009 in the former 1938 city hall, showcases the original smallest police station and shipwreck artifacts.",
      "sourceSentenceIds": [
        2,
        3,
        9,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrabelle%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ships once anchored behind Dog Island in Ballast Cove, dropping ballast before heading into Carrabelle to load cargo, giving the area its maritime heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mycarrabelle.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Every March, the museum hosts the Carrabelle Culture Crawl, a free celebration featuring local musicians, book signings, and exhibits on Dog Island shipwrecks.",
