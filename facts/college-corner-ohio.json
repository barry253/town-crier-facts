  "facts": [
    {
      "id": 1,
      "text": "College Corner’s name literally means a corner or junction linked to a college, reflecting its origin beside Miami University’s regional campus.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/college-corner-106899",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits on the Ohio–Indiana line, directly abutting West College Corner and lying roughly five miles northwest of Oxford.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/College_Corner%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "College Corner was officially laid out in 1837, marking the early settlement of the area.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/College_Corner%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "It straddles Oxford Township in Butler County and Israel Township in Preble County, a rare dual‑county arrangement.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/College_Corner%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The village’s identity has been shaped by its proximity to Miami University, which drove its early growth and community character.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/college-corner-106899",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "College Corner’s borders place it uniquely at the intersection of two states, making it a literal “college corner” on the map.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
