      "quality": "good"
    },
    {
      "id": 2,
      "text": "French‑Canadian traders reestablished a trading post there in 1784, abandoning it after the 1794 Battle of Fallen Timbers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
