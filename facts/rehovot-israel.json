  "facts": [
    {
      "id": 1,
      "text": "Rehovot was founded in 1890 by Polish Jews of the First Aliyah, choosing a site near Khirbat Deiran to avoid Rothschild influence.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rehovot",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name means “wide expanse” in Hebrew, reflecting its early citrus orchards that stretched across the coastal plain.",
      "sourceSentenceIds": [
        21,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://waypointwonder.com/what-to-see-and-do-in-rehovot-a-complete-guide-to-israels-science-city/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1934, chemist Chaim Weizmann established a research institute that later became the Weizmann Institute of Science, Israel’s premier research university.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Rehovot",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1920 opening of Rehovot Railway Station linked the town’s citrus trade to Tel Aviv and Jaffa, boosting export to Europe.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rehovot",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1987, authorities restored the former juice factory building and converted it into a historical museum, preserving industrial heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
