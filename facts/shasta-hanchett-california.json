  "facts": [
    {
      "id": 1,
      "text": "Shasta-Hanchett Park was originally part of Mission Santa Clara de Asís and later owned by Native American Roberto Balermino.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shpna.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Alameda, the neighborhood’s main street, was once part of El Camino Real, the historic road linking California’s missions.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shpna.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John McLaren, designer of Golden Gate Park, laid out Shasta-Hanchett Park’s streets, spacing trees 20 feet apart and placing utility poles in backyards.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shasta_Hanchett_Park%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood’s Craftsman houses, built mainly between 1915 and 1930, form San Jose’s largest concentration of that style.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shasta_Hanchett_Park%2C_San_Jose",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1907 Lewis E. Hanchett began developing the area, and the streetcar line that followed made the subdivision accessible to buyers.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shasta_Hanchett_Park%2C_San_Jose",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Shasta-Hanchett Park and neighboring Hester Park were designated a Historic Conservation Area, preserving early 20th‑century architecture.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
