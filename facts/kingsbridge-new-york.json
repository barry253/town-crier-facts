  "facts": [
    {
      "id": 1,
      "text": "Kingsbridge takes its name from a bridge erected in 1693 by enslaved Africans, later owned by Frederick Philipse, the lord of Philipsburg Manor.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsbridge%2C_Bronx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Kingsbridge Historical Society, founded in 1949, is the oldest local historical society in the Bronx and preserves the area’s rich heritage.",
      "sourceSentenceIds": [
        2,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kingsbridgehistoricalsociety.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kingsbridge Armory, a red‑brick fortress built between 1912 and 1917 for the New York National Guard, dominates the neighborhood skyline.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/kingsbridge",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A scene from Martin Scorsese’s The Irishman was filmed at the American Legion in Kingsbridge, linking the area to Hollywood history.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsbridge%2C_Bronx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kingsbridge transformed from a rural waystation into a suburb after the 1874 annexation of the western Bronx and the arrival of the New York Central Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/kingsbridge",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A Carnegie library designed by McKim, Mead & White opened in 1905, showcasing early 20th‑century architectural heritage in Kingsbridge.",
      "sourceSentenceIds": [
        23
