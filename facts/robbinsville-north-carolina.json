      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://828vibes.com/visit-robbinsville-nc",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Moonshiner 28 route, once used by bootleggers, winds beside Fontana and Cheoah Lakes for a scenic ride full of history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
