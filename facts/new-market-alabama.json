      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mount Paran Cemetery in New Market is a historic site on the Alabama Register of Landmarks and Heritage, holding graves of pioneers Isaac Criner and John Miller.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
