      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New Market Historic District was first listed on the Alabama Register of Landmarks and Heritage in 1991 and added to the National Register of Historic Places in 2004.",
      "sourceSentenceIds": [
