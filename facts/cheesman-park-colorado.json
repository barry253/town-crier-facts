  "facts": [
    {
      "id": 1,
      "text": "Cheesman Park got its name from Denver pioneer Walter Cheesman, whose family funded a neoclassical pavilion after his death.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cheesman_Park%2C_Denver"
    },
    {
      "id": 2,
      "text": "Before becoming a park, the site was Prospect Hill Cemetery, opened in 1858, and it closed when the land was converted in 1907.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cheesman_Park%2C_Denver"
    },
    {
      "id": 3,
      "text": "Reinhard Schuetze drew the original park plans in the early 1900s, making it one of the nation’s best‑designed public spaces.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cheesmanpark.org/park-history"
    },
    {
      "id": 4,
      "text": "The 80‑acre park hosts 1,880 trees from 57 species, including American linden, black walnut, and Colorado blue spruce.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cheesman_Park%2C_Denver"
    },
    {
      "id": 5,
      "text": "In 1986 Cheesman Park earned a spot on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cheesmanpark.org/park-history"
    },
    {
      "id": 6,
      "text": "Denver Parks adopted a Historic Landscape Assessment and Master Plan for Cheesman Park in 2008 to guide future preservation.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cheesmanpark.org/park-history"
