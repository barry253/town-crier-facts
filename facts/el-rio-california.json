      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1895 the post office changed its name to El Rio, the Spanish translation for “the river”.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Rio%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Santa Clara Catholic Church, built in 1885, was the first Catholic church in Ventura County since Mission San Buenaventura.",
      "sourceSentenceIds": [
        18,
