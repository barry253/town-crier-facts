  "facts": [
    {
      "id": 1,
      "text": "Duboistown (pronounced \"doo-BOYS town\") was named after founders John and Mathias DuBois who bought 489 acres between 1852 and 1857.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboistown%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The borough was officially established in 1878, but the area’s history stretches back to the 18th‑century settlement of Andrew Culbertson.",
      "sourceSentenceIds": [
        7,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboistown%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Duboistown sits at the mouth of Mosquito Run on the banks of the West Branch Susquehanna River, a spot once home to a major Susquehannock village.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboistown%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "The land that became Duboistown was first surveyed in 1769 and was originally called \"Walnut Bottom\" for its black walnut forests.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Duboistown%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Andrew Culbertson built a sawmill at the mouth of Mosquito Run after moving there in 1773, before fleeing during the Revolutionary War.",
