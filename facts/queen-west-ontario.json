  "facts": [
    {
      "id": 1,
      "text": "Queen West was laid out as Lot Street in 1793 and became a hub for independent businesses by 1860.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://queenstreetwest.ca/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Over a century, Queen West nurtured textiles, fashion, punk music, and graffiti, making it a creative hotspot.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://queenstreetwest.ca/about/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s architecture, street art, live music venues, and diverse stores keep that history alive today.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://queenstreetwest.ca/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pair an espresso with a freshly baked pastry at Forno Cultura, a third‑generation Italian café and bakery on Queen West.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.destinationtoronto.com/neighbourhoods/westside/queen-west/",
