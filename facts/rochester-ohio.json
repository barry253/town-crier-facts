    {
      "id": 1,
      "text": "Rochester, Ohio takes its name from Rochester, New York, the hometown of a land agent who helped settle the area.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rochester%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Olmsted County Historical Society’s 100‑year exhibit celebrates a century of the History Center, spotlighting key people and buildings.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.olmstedhistory.com/current-exhibits",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Visitors can explore how wartime conflicts shaped the community in the History Center’s “War Stories of Olmsted County” exhibit.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.olmstedhistory.com/current-exhibits",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the History Center is restoring the Stoppel Farmstead, a historic property it owns, to preserve the story for future generations.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.olmstedhistory.com/current-exhibits",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A new exhibit opened in November 2025 dives into the secret society of the Independent Order of Odd Fellows, active in Rochester from 1863 to 1999.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.olmstedhistory.com/current-exhibits",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Olmsted County Exhibit takes guests on a journey from prehistoric cephalopods and woolly mammoths to the present, covering Native peoples, early settlers, and surveying.",
