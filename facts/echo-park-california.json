  "facts": [
    {
      "id": 1,
      "text": "Echo Park was originally called Edendale, founded 1892 by Thomas Kelley who bought 70 acres including a reservoir that became Echo Park Lake.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lastoryprojects.uscannenberg.org/echopark/past-to-present/index.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area known as Edendale was the West Coast’s filmmaking hub before Hollywood, hosting studios like Keystone and Selig in the 1910s.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Echo_Park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Echo Park Lake, the neighborhood’s centerpiece, was created in 1895 from a transformed reservoir and remains a historic recreational spot.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lastoryprojects.uscannenberg.org/echopark/past-to-present/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The neighborhood has attracted famous artists such as Jackson Pollock, Tom Waits, and Frank Zappa, who once called it home.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lastoryprojects.uscannenberg.org/echopark/past-to-present/index.html",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1964 the historic Taix French restaurant moved to Echo Park, becoming a long‑standing culinary landmark since 1911.",
