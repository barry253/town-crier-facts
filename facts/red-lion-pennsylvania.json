      "id": 1,
      "text": "Red Lion was settled in 1852 and named after the Red Lion Tavern, one of the first pubs in town.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
