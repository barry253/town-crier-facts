  "facts": [
    {
      "id": 1,
      "text": "Rocheport was founded in 1825 by Joseph Kinney and quickly became a vital riverport for settlers and traders.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitrocheport.com/rocheport-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name means “rocky port” in French, reflecting its early role as a river trading hub.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocheport%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rocheport sits on the Missouri River and is home to the historic Rocheport Historic District, listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocheport%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Katy Trail, a 225‑mile bike path built on a former railroad right‑of‑way, cuts through Rocheport’s middle, linking it to the rest of Missouri.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Rocheport%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Rocheport played a significant role in the state’s history, with local residents and organizations preserving its historic buildings.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitrocheport.com/rocheport-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Rocheport’s early days were shaped by Native American trade, as a Sauk, Meskwaki, and Ioway village near Moniteau Creek was noted by Zebulon Pike in 1806.",
      "sourceSentenceIds": [
        28
      ],
