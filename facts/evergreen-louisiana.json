  "facts": [
    {
      "id": 1,
      "text": "Evergreen got its name in the mid‑19th century, replacing Bayou Ridge after the region’s evergreen magnolia trees caught the settlers’ eye.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/evergreen_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1992, Evergreen Plantation earned National Historic Landmark status for its exceptional Greek‑Revival architecture and deep historical roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evergreen_Plantation_(Wallace%2C_Louisiana)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The plantation’s main house, originally built around 1790, was remodeled into its current Greek‑Revival style in 1832.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evergreen_Plantation_(Wallace%2C_Louisiana)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Even today, Evergreen Plantation continues to grow sugarcane, a crop that has defined the area since the 18th century.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Evergreen_Plantation_(Wallace%2C_Louisiana)",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Great Flood of 1927, caused by Mississippi River levee breaches, flooded parts of Avoyelles Parish, including areas near Evergreen.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/evergreen_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Evergreen Plantation served as a filming location for Quentin Tarantino’s Django Unchained and the 2020 drama Antebellum.",
      "sourceSentenceIds": [
