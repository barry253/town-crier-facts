      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lyndonville hosts Lyndon Institute, Vermont State University‑Lyndon, and five historic covered bridges that draw visitors year‑round.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
