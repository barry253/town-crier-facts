  "facts": [
    {
      "id": 1,
      "text": "Kenton was first laid out in 1796 by landowner Philip Lewis, originally called Georgetown and Lewis Crossroads before adopting the name Kenton in 1806.",
      "sourceSentenceIds": [
        1,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/kenton_delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Delaware and Maryland Railroad arrived in 1869, turning Kenton into a bustling shipping hub for grain, lumber, and other agricultural goods.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kenton_delaware",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kenton’s Historic District earned a spot on the National Register of Historic Places in 1983, preserving its 19th‑century charm.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenton%2C_Delaware",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1870s and 1880s, Kenton showcased a mix of vernacular, Italianate, and Queen Anne‑style buildings, reflecting its agrarian heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kenton_delaware",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kenton experiences a humid subtropical climate, with hot, humid summers and mild winters typical of the mid‑Atlantic region.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kenton_delaware",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1780 Wilds‑Prettyman House, a Flemish bond brick building, once served both as a residence and a general store.",
      "sourceSentenceIds": [
