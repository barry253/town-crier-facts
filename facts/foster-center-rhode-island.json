  "facts": [
    {
      "id": 1,
      "text": "Foster Center serves as the historic village core and governmental seat for the town of Foster, Rhode Island.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_center_rhode_island"
    },
    {
      "id": 2,
      "text": "The area was originally inhabited by the Narragansett people before colonial lands were purchased in 1662.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_center_rhode_island"
    },
    {
      "id": 3,
      "text": "Foster Center is named after Theodore Foster, a prominent resident and lawyer who supported the town's early administration.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_center_rhode_island"
    },
    {
      "id": 4,
      "text": "The Foster Center Historic District was added to the National Register of Historic Places in 1974.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Foster_Center%2C_Rhode_Island"
    },
    {
      "id": 5,
      "text": "Early settlers in Foster Center cleared woodlands for farms, producing dairy products and crops like corn and rye.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/foster_center_rhode_island"
    },
    {
      "id": 6,
      "text": "The Foster Preservation Society organizes the annual Old Home Days festival to celebrate colonial heritage and rural traditions.",
