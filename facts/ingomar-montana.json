  "facts": [
    {
      "id": 1,
      "text": "Ingomar began in 1908 as a Milwaukee Road depot town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127852"
    },
    {
      "id": 2,
      "text": "By 1915 the town swelled to 400 residents, making it a bustling hub for wool shipping.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/ingomar-montana-ghost-town/"
    },
    {
      "id": 3,
      "text": "The Jersey Lilly, originally the 1914 Wiley, Clark & Greening Bank, now a historic bar, sits on the National Register.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/ingomar-montana-ghost-town/"
    },
    {
      "id": 4,
      "text": "A 1923 fire devastated Ingomar, but the town rebuilt and continued as a wool center until drought and railroad abandonment.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127852"
    },
    {
      "id": 5,
      "text": "The Milwaukee Road abandoned its line in 1980, turning Ingomar into a ghost town with only 14 residents today.",
      "sourceSentenceIds": [
        7,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://unitedstatesghosttowns.com/ingomar-montana-ghost-town/"
    },
    {
      "id": 6,
      "text": "Ingomar’s location between three major rivers made it an ideal international wool shipping point, handling two million pounds annually.",
