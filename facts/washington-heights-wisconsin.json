      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mount Olive Lutheran Church, established in 1894, sponsors a kindergarten‑through‑eighth‑grade school and serves the neighborhood’s families.",
      "sourceSentenceIds": [
