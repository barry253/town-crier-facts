      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 2007, the Union City Artists Collective launched the city’s first Art Curator, Amado Mora, who opened the gallery at City Hall.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
