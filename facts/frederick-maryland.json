  "facts": [
    {
      "id": 1,
      "text": "Frederick was laid out in 1745 as Frederick Town, likely named for Frederick Calvert, 6th Baron Baltimore, though some say Frederick Louis, prince of Wales.",
      "sourceSentenceIds": [
        15,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Frederick-Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town's first house was built by Johann Thomas Schley, a young German Reformed schoolmaster from the Rhineland Palatinate, who led immigrants to Maryland.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frederick%2C_Maryland",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Frederick’s location as a crossroads made it a minor distribution center for people and goods in Western Maryland.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frederick%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Battle of Monocacy, known as the 'Battle that Saved Washington,' took place just southeast of Frederick, where Union troops delayed Confederate forces.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Frederick%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The oldest African‑American church in Frederick, Asbury United Methodist Church, began as the mixed congregation Old Hill Church in 1818 and became an all‑black congregation in 1864.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
