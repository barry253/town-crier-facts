      ],
      "source": "https://www.townofcortlandtny.gov/cn/webpage.cfm?TI=D20&TPID=2564",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Verplanck derives its name from Abraham Isaacsen Verplanck, a 17th‑century settler who founded the family’s New Amsterdam roots.",
