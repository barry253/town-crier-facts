    {
      "id": 1,
      "text": "Alcorn State University, founded in 1871, is the oldest public historically black land‑grant institution in the United States.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://facts.net/society-and-social-sciences/society/30-facts-about-alcorn-state-university/"
    },
    {
      "id": 2,
      "text": "The campus sits on land that once housed Oakland College, a Presbyterian school for white youth opened in 1828 and closed after the Civil War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/alcorn-state-university/"
    },
    {
      "id": 3,
      "text": "Alcorn’s first president was Hiram Rhoades Revels, the first black U.S. senator in history.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/alcorn-state-university/"
    },
    {
      "id": 4,
      "text": "Alcorn’s marching band, the “Sounds of Dyn‑O‑mite,” formed in the 1960s and performed in the 2025 Macy’s Thanksgiving Day Parade.",
      "sourceSentenceIds": [
        2,
