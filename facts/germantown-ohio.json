  "facts": [
    {
      "id": 1,
      "text": "Germantown was founded in 1804 by German‑speaking settlers from Berks County, Pennsylvania, with Philip Gunckel laying out the town plan in 1814.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The downtown core, known as the Gunckel Town Plat, was added to the National Historic Register in 1976, preserving its 19th‑century layout.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Germantown’s historic alley system features a unique wagon‑wheel design, a rare urban layout first laid out by founder Philip Gunckel.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town hosts the Germantown Covered Bridge, a 19th‑century wooden bridge that remains a landmark for cyclists and pedestrians.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wondrousdrifter.com/north-america/usa/ohio/germantown-ohio/reasons-to-visit-germantown-ohio-at-least-once-in-your-lifetime/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1847, the Mudlick Distillery opened, producing 30 barrels of whiskey daily and becoming the largest distillery in the country for years.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Germantown%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Germantown Historical Society, founded in 1973, documents the town’s architecture and offers guided tours of historic buildings like the 1814 log cabin.",
      "sourceSentenceIds": [
        1,
        10
      ],
