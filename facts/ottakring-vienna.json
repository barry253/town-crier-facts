  "facts": [
    {
      "id": 1,
      "text": "Ottakring was founded about 1,000 years ago by Bavarian settlers who cleared a forest on the cityward slope of the Gallitzinberg.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottakring",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ottakringer Bach once flowed through what are now Ottakringer Straße, Abelegasse, and Thaliastraße before emptying into the Donaukanal.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottakring",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Industrialization began in 1898 when a tobacco factory opened on Thaliastraße, marking the area's shift from agrarian to manufacturing.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottakring",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The U3 subway line reached Ottakring in 1998, sparking revitalization around the new station and reshaping the neighborhood.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ottakring",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ottakring Cemetery offers a quiet retreat where history, art, and nature converge for reflection and strolls.",
