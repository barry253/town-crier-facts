  "facts": [
    {
      "id": 1,
      "text": "Erie, North Dakota, first settled in 1880 by pioneers who homesteaded after the Northern Pacific railroad opened the region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/erie_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was never incorporated; instead it was officially recognized as a census‑designated place by the U.S. Census Bureau.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/erie_north_dakota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "The Mosher family from New York, the Morrow brothers from Canada, and the Thompson family from Pennsylvania built homesteads, schools, and basic infrastructure on Erie’s prairie.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/erie_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Delamater School, first taught by a 16‑year‑old girl from Fargo, was moved into town before burning down in the 1880s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/erie_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the mid‑20th century, the Morrow family’s land in Section 28, originally claimed in the 1880s, passed through several owners, illustrating generational shifts in local agriculture.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/erie_north_dakota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Erie is listed in both the FIPS‑55 and GNIS databases, confirming its official geographic recognition.",
