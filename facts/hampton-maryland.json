    },
    {
      "id": 2,
      "text": "During the Revolutionary War, Hampton’s ironworks fired cannons for the Continental Army.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/hamp/learn/historyculture/index.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1948, Hampton became home to the first National Park Service historic site ever established.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/hamp/learn/historyculture/index.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the 63‑acre park preserves the mansion, gardens, farm buildings, enslaved quarters, and a family cemetery.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/hamp/learn/historyculture/index.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hampton’s land was first granted in 1695 to a relative of Lord Baltimore, setting the stage for the Ridgely plantation.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hampton%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1929, the Hampton Development Company split the Ridgely estate, giving rise to the town’s current layout.",
