  "facts": [
    {
      "id": 1,
      "text": "Saks was named after the early‑settling Saks family, who donated land for the local railroad in the late 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/alabama_saks",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlement, the area that is now Saks lay within Creek and Cherokee ancestral lands in the early 19th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/saks_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After Saks died in 1933, his family donated land in the late 1940s for a high school, and the area was named Saks in his honor.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/saks_alabama",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Despite its small size, Saks is home to the Anniston Museum of Natural History, which houses one of the largest collections of dinosaur fossils in the Southeast.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/alabama_saks",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Military influence and Anniston's wartime contracts spurred mid‑century growth in Saks, leading to new schools, homes, and infrastructure.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/saks_alabama",
      "category": "economy",
      "quality": "good"
    }
