  "facts": [
    {
      "id": 1,
      "text": "York Haven’s historic hydro plant earned National Historic Mechanical Engineering Landmark status for its pioneering water‑power technology.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yorkhavenborough.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1899 the hydro plant was the sixth largest factory employer in all of York County, powering the town’s growth.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://yorkhavenborough.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before railroads, the Susquehanna Canal turned York Haven into a bustling business hub, drawing merchants from Philadelphia.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yorkhavenborough.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Cube Hydro Partners owns the plant, one of the oldest and best‑run hydropower facilities in the United States.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://yorkhavenborough.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Along the river, visitors can see the ruins of old mills and the nearby hydro dam that once powered local industry.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://yorkblog.com/wandering/susquehanna-river-ruins-paper-mill-hydro-dam-york-haven/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "York Haven hosts the Brunner Island coal‑fired power plant, a major electricity source on the Susquehanna River.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/York_Haven%2C_Pennsylvania",
