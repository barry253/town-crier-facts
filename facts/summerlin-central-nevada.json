      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1952, Howard Hughes purchased 30,000 acres of desert for just $3 a acre, dreaming of an industrial hub that never materialized.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
