  "facts": [
    {
      "id": 1,
      "text": "Camanche North Shore was first called Limerick, then renamed in 1849 after settlers’ hometown of Camanche, Iowa.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/camanche_california",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the California Gold Rush, Camanche North Shore sprang up as a bustling placer mining town along the Mokelumne River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/camanche_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Irish miners brought their traditional placer techniques, giving Camanche a distinct cultural flavor that still echoes in local lore.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/camanche-california-ghost-town/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s original streets now lie beneath Camanche Reservoir, a 7,700‑acre lake that replaced the mining hub in the 20th century.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/camanche_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Camanche North Shore is commemorated as California Historical Landmark No. 254, marked by a plaque at South Camanche Shore Park.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/camanche-california-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community sits at 308 feet above sea level, nestled between the Central Valley and the Sierra Nevada foothills.",
      "sourceSentenceIds": [
        22
