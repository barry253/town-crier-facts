  "facts": [
    {
      "id": 1,
      "text": "Presque Isle Peninsula, the namesake of the county, hosts two historic lighthouses that once guided ships into the only natural harbor between Detroit and Mackinac.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presque_Isle_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community of Presque Isle sits a few miles south of the peninsula and once housed the Fireside Inn, Birch Hill Hotel, and Grand Lake Hotel for vacationers.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presque_Isle_Township%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The New Presque Isle Lighthouse, built in 1870, remains the tallest climbable tower on the Great Lakes and houses a preserved Third Order Fresnel Lens.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presque_Isle_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Presque Isle Harbor Marina, a restaurant, and a gift shop line the sandy beaches where sunrise and sunset over Lake Huron are visible from the tombolo strip.",
      "sourceSentenceIds": [
        16,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Presque_Isle_Township%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Presque Isle Township Museum Society celebrates maritime heritage by hosting an annual photo contest featuring the two lighthouses and surrounding range lights.",
      "sourceSentenceIds": [
        3,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.presqueislelighthouses.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Grand Lake and Long Lake, each over 5,000 acres, are nearly identical inland lakes that have appeared twice on the Outdoor Channel’s Major League Fishing for their bass.",
      "sourceSentenceIds": [
        25,
