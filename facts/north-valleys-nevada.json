  "facts": [
    {
      "id": 1,
      "text": "Primm, once called State Line, began as a modest motel and coffee shop built by Ernest Primm in the 1950s.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Primm%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1996 the town officially adopted the name Primm to honor its founder and avoid confusion with nearby Stateline.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Primm%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Primm sits on Ivanpah Dry Lake, a vast salt flat that stretches north and south of the town.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Primm%2C_Nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community’s economy once thrived on three casinos, but by 2026 only the Primm Valley Resort remained before its planned July 4 closure.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Primm%2C_Nevada",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A store just over the California line sells state lottery tickets to Nevada residents, since Nevada’s constitution bans a state lottery.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Primm%2C_Nevada",
