    },
    {
      "id": 2,
      "text": "Mennonite immigrants from Germany and Ukraine, including Bernard Warkentin, helped shape North Newton into a key agricultural hub in Kansas.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.travelks.com/places-to-visit/cities/newton/"
    },
    {
      "id": 3,
      "text": "Bethel College, founded in 1874, is located in North Newton and serves as a center for higher education in the region.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Newton%2C_Kansas"
    },
    {
      "id": 4,
      "text": "The Kauffman Museum at Bethel College showcases local art and history, reflecting North Newton's cultural heritage.",
      "sourceSentenceIds": [
        22
