      "text": "North Newton was founded in 1871 when the Santa Fe Railroad expanded westward and cowboys drove cattle along the Chisholm Trail.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
