  "facts": [
    {
      "id": 1,
      "text": "Pioneer Village, named after its original subdivision, was incorporated on December 3, 1974, just months after neighboring Hillview.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bullittcountyhistory.org/memories/pvillage.html"
    },
    {
      "id": 2,
      "text": "On May 28, 1996, an F4 tornado struck Pioneer Village, destroying dozens of homes, yet the community rebuilt without tax increases and cleared debts by 2014.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pioneer_village_kentucky"
    },
    {
      "id": 3,
      "text": "Pioneer Village began in the early 1970s as a planned residential subdivision on former farmland just south of Hillview in Bullitt County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pioneer_village_kentucky"
    },
    {
      "id": 4,
      "text": "The city borders Hillview to the north and west, and Hebron Estates to the south.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pioneer_Village%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Without major natural landmarks, Pioneer Village focuses on maintained urban green spaces for recreation.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pioneer_village_kentucky"
    },
    {
      "id": 6,
      "text": "Downtown Louisville lies just 16 miles (26 km) north of Pioneer Village.",
      "sourceSentenceIds": [
        14
