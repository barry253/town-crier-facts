  "facts": [
    {
      "id": 1,
      "text": "Lancaster is the county seat of Grant County, founded as a planned community in 1837 with a compass‑aligned grid and a central square for government.",
      "sourceSentenceIds": [
        15,
        16,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Lancaster, Pennsylvania, chosen by Major Price after a relative migrated there.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic glass‑domed Grant County Courthouse, built in 1902, is a favorite of history and architectural enthusiasts.",
      "sourceSentenceIds": [
        1,
        23
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grantcounty.org/community-information/lancaster/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pleasant Ridge, just outside Lancaster, was one of Wisconsin’s first African‑American communities, founded by the Shepard family in 1849.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lancaster%2C_Wisconsin",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Grant County History Museum in Lancaster houses a special display of Civil War era items and extensive genealogical records.",
      "sourceSentenceIds": [
        14,
