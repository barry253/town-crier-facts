  "facts": [
    {
      "id": 1,
      "text": "Stokes County Historical Society began in 1968 to preserve local history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sc-hs.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The society turned the 1859 Fulton House in Danbury into a museum showcasing county artifacts.",
      "sourceSentenceIds": [
        2,
        5,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sc-hs.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Rock House, a Revolutionary War-era building built by John Martin, sits on society property and is on the National Register.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sc-hs.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Great Wagon Road ran through eastern Stokes County, drawing settlers mainly from Virginia Piedmont and Pennsylvania.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stokes_County%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stokes County was carved out of Surry County in 1789, before that it belonged to Rowan County.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stokes_County%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1849 the southern half of Stokes County split off to form Forsyth County.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stokes_County%2C_North_Carolina",
