  "facts": [
    {
      "id": 1,
      "text": "Lyndora was named for the daughter of one of the founders of Standard Steel Car.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/plan-your-visit/area-information/cultural-origins/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The factory was the first world‑class plant to build all‑steel railroad cars on a standardized assembly line.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/plan-your-visit/area-information/cultural-origins/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1890s, a French‑speaking community in Lyndora grew so large it spawned a French and Belgian Club.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/plan-your-visit/area-information/cultural-origins/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1908, an interurban trolley linked Lyndora to Butler, Evans City and Pittsburgh, later replaced by buses.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homeacre-Lyndora%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Because the factory ran three shifts daily, workers shared a single room, sleeping in turns so beds were never empty.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.experiencebutler.com/plan-your-visit/area-information/cultural-origins/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lyndora’s post office opened in 1902, marking the town’s first official federal presence.",
