  "facts": [
    {
      "id": 1,
      "text": "Warthen was the first settlement in Washington County, founded in 1754 as the site of the county’s superior courts and jail.",
      "sourceSentenceIds": [
        2,
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warthen%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s oldest jail, built in 1786, still stands and once held Aaron Burr in 1804 while he awaited trial.",
      "sourceSentenceIds": [
        14,
        15,
        16,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitwacoga.org/warthen.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bethlehem Baptist Church, founded in 1790, is Washington County’s oldest church and one of the first in the area.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitwacoga.org/warthen.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A narrow‑gauge railroad from Augusta reached Warthen via Tennille, opening a vast market for local cotton farmers.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wacohistorical.org/warthenhistorictour/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Warthen’s historic district, listed on the National Register of Historic Places, preserves the town’s 18th‑century architecture.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warthen%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Warthen Community Center, originally a two‑story schoolhouse with a coffered front door, now hosts local events.",
