      "id": 1,
      "text": "Spring City’s history is marked by a Vincent Canal marker, honoring the canal that sparked the borough’s founding and growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
