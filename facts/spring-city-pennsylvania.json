      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough sits on the Schuylkill River, directly opposite the town of Royersford across the water.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_City%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Main, New, and Bridge Streets form Spring City’s core thoroughfares, winding through its historic downtown.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_City%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The local historical society will host 2026 programs celebrating the nation’s 250th anniversary, featuring talks on early American lighting and flag manufacturing.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
