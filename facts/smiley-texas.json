      "id": 1,
      "text": "Smiley was founded in the early 1870s when trader John Smiley settled beside a long, narrow lake that later bore his name.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
