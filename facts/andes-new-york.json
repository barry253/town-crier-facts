  "facts": [
    {
      "id": 1,
      "text": "Andes takes its name from the Andes brothers, English immigrants of Irish descent who founded one of America’s first grain‑trading firms.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andes%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town split from Middletown and was officially formed in 1819.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://andesgazette.net/about-andes/"
    },
    {
      "id": 3,
      "text": "Andes was a flashpoint in the 1845 Anti‑Rent War, where tenant farmers staged a rebellion against feudal rents.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://andesnewyork.gov/discover/"
    },
    {
      "id": 4,
      "text": "The Pepacton Reservoir, an impoundment on the East Branch Delaware River, bisects Andes’ south‑central region.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andes%2C_New_York"
    },
    {
      "id": 5,
      "text": "The Jackson‑Aitken Farm in Andes earned a place on the National Register of Historic Places in 2003.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Andes%2C_New_York"
    },
    {
      "id": 6,
      "text": "Most of Andes’ Main Street architecture is listed on the National Register of Historic Places, showcasing its historic character.",
      "sourceSentenceIds": [
