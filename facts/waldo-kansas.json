      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Waldo developed as an agricultural shipping and receiving point, with a small business community that included a bank, stores, and three grain elevators.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waldo%2C_Kansas",
      "category": "economy",
      "quality": "good"
    },
    {
