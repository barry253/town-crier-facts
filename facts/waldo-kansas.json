      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits in the Smoky Hills of the Great Plains, on the east bank of the West Fork of Wolf Creek, part of the Saline River watershed.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
