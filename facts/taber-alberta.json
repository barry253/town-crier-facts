  "facts": [
    {
      "id": 1,
      "text": "Taber was incorporated as a village on March 15, 1905, marking the start of its formal municipal governance.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taber.ca/discover-taber/taber-tourism/history-of-taber",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A CPR printing error that spelled the town “Taber” instead of “Tabor” became official when the post office opened.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taber.ca/discover-taber/taber-tourism/history-of-taber",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alberta’s only sugar factory, the Alberta Sugar Company, began processing beet sugar in 1950 and remains a major employer.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taber.ca/discover-taber/taber-tourism/history-of-taber",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Taber Courthouse, built in the 1920s, was the first of its architectural style in Alberta and was provincially historicized in 2013.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.taber.ca/discover-taber/taber-tourism/history-of-taber",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every spring, downtown Taber hosts the “Cluesolvers Adventure,” a mystery‑solving event that lets participants uncover quirky local history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visittaber.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2004, Taber petitioned the Canadian Heraldic Authority and received an official coat of arms, formalizing its municipal identity.",
      "sourceSentenceIds": [
        24,
        25
      ],
