  "facts": [
    {
      "id": 1,
      "text": "Mountain City sprang up in 1870 when a silver mine was found, drawing over a thousand miners before the ore ran out and the town emptied.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mountain_City%2C_Nevada"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its lofty setting, a descriptive nod to the high elevation that surrounds the community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mountain_City%2C_Nevada"
    },
    {
      "id": 3,
      "text": "A post office has operated in Mountain City nonstop since 1870, keeping a living link to the town’s mining past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/mountain-city-nevada-ghost-town/"
    },
    {
      "id": 4,
      "text": "Mountain City sits on the Owyhee River, about 16 miles south of the Idaho border along State Route 225.",
      "sourceSentenceIds": [
        8
