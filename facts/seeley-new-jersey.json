  "facts": [
    {
      "id": 1,
      "text": "Seeley began as a mid‑1700s milling village, where early settlers built grist and saw mills powered by the Cohansey River.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seeley_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Cohansey River forms Seeley's western border, marking the line with Hopewell Township.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seeley%2C_New_Jersey",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At just 55 feet above sea level, Seeley sits in the low‑lying floodplain of Cumberland County.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seeley_new_jersey",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "After the grist mill closed in 1813, its ponds were later turned into cranberry fields in the early 1900s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seeley_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1922, Upper Deerfield Township was created from parts of Deerfield Township, officially adding Seeley to the new municipality.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/seeley_new_jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Seeley's coordinates, 39°29′15″N 75°15′19″W, place it in the heart of southern New Jersey’s Delaware Bay region.",
      "sourceSentenceIds": [
