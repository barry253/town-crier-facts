    },
    {
      "id": 3,
      "text": "Construction of the Satsop Nuclear Power Plant began in 1977 but was halted in 1983 after a $61 million budget shortfall, leaving it 75% complete.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
