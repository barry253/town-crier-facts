  "facts": [
    {
      "id": 1,
      "text": "Mormon pioneers founded Rockville in 1862, and the town has maintained its original historical town plan ever since.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://rockvilleutah.gov/"
    },
    {
      "id": 2,
      "text": "Rockville is nestled in the canyon of the Virgin River, just outside the boundary for Zion National Park.",
      "sourceSentenceIds": [
        6,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://rockvilleutah.gov/"
    },
    {
      "id": 3,
      "text": "The historic Rockville Bridge, built in 1924, is the only surviving Parker Through Truss bridge used for vehicles in Utah.",
      "sourceSentenceIds": [
        1,
        8,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://rockvilleutah.gov/historic-rockville/"
    },
    {
      "id": 4,
      "text": "The National Register of Historic Places listed the Rockville Bridge in 1995 due to its exceptional structural and historical integrity.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://rockvilleutah.gov/"
    },
    {
      "id": 5,
      "text": "Historians have referred to Rockville as Utah's last treasure because of its preserved rural and agricultural character.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://rockvilleutah.gov/"
    },
    {
      "id": 6,
      "text": "An Ogden bridge contractor erected the Rockville Bridge using prefabricated steel components from the Minneapolis Steel and Machinery Company.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
