      "id": 1,
      "text": "Flanagan was founded in 1880 by brothers Edward, Peter, and Patrick Flanagan, who owned the land that became the village.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
