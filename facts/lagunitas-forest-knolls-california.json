      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lagunitas Creek, a tributary of San Geronimo Creek, hosts the largest remaining wild run of Coho salmon in Central California.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
