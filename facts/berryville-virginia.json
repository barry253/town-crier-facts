  "facts": [
    {
      "id": 1,
      "text": "Berryville was founded at the intersection of the Winchester Turnpike and Charlestown Road.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berryville%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic district, including the 1836 courthouse, was listed on the National Register of Historic Places in 1987.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Berryville,_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Shenandoah Valley Railroad in 1879 turned Berryville into a regional processing hub for grains and fruit.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Berryville,_Virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1857 Italianate Grace Episcopal Church stands as a principal landmark beside the 1836 courthouse.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/168-0012/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Berryville’s name comes from Benjamin Berry, who bought land from John Smith in 1797 and helped lay out the town.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Berryville%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The restored 1780s Burwell-Morgan Mill now serves as a demonstration museum operated by the Clarke County Historical Association.",
