  "facts": [
    {
      "id": 1,
      "text": "Los Osos, Spanish for \"the bears\", earned its name when Padre Juan Crespi noted the abundance of bears in the area during the 1769 Portolá expedition.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Los_Osos%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first people of Los Osos were the Northern Chumash, known in their language as yak titʸu titʸu yak tiłhini.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Los_Osos%2C_California",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A stabilized sand dune in Los Osos shelters a Northern Chumash archaeological site that dates back to at least 1200 CE.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Los_Osos%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Los Osos lies in the valley, roughly 10.6 miles west of San Luis Obispo and 2.3 miles south of Morro Bay.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Los_Osos%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town enjoys a mild warm‑summer Mediterranean climate, with July averages hovering around 60 °F (16 °C).",
