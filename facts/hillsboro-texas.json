  "facts": [
    {
      "id": 1,
      "text": "Hillsboro was named after Dr. George Washington Hill, a physician and the Republic of Texas Secretary of War.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hillsboro, once spelled Hillsborough, was chosen as Hill County’s seat when the county was formed.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Missouri, Kansas & Texas Railroad arrived in the early 1880s, sparking rapid growth and new jobs in Hillsboro.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Texas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hillsboro’s downtown still hosts an 1870s rock saloon, a Renaissance‑Revival library, and the state’s oldest pharmacy.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://texastimetravel.com/cities/hillsboro/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rusted Chandelier Event Venue began life as the 1912 Colonial Trust Company, later remodeled into a historic event hall.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
