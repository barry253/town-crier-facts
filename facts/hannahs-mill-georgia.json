  "facts": [
    {
      "id": 1,
      "text": "Hannahs Mill was built in 1859 on Ten Mile Creek by Dr. Herring, who originally called it Rose Hill Mill.",
      "sourceSentenceIds": [
        16,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vanishinggeorgia.com/category/hannahs-mill-ga/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Herring was a physician and amateur engineer who also built several covered bridges in Upson County, including the Auchumpkee Creek Bridge.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vanishinggeorgia.com/category/hannahs-mill-ga/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Unlike most mills of its era, Hannahs Mill used a turbine instead of a traditional water‑wheel.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vanishinggeorgia.com/category/hannahs-mill-ga/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1887 the mill was bought by Dr. George Whitfield Telford Hannah, a Confederate veteran and prominent Thomaston physician.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vanishinggeorgia.com/category/hannahs-mill-ga/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The gristmill operated until the 1970s before closing its doors for the last time.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vanishinggeorgia.com/category/hannahs-mill-ga/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today the surrounding community, now part of Thomaston, still carries the name Hannahs Mill.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
