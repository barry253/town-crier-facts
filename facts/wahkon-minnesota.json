  "facts": [
    {
      "id": 1,
      "text": "Wahkon is the Dakotah name for \"spirit,\" and the railroad company adopted it because Indians knew Lake Mille Lacs as \"Spirit Lake.\".",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://millelacs.com/stories/communities-around-the-lake/city-of-wahkon"
    },
    {
      "id": 2,
      "text": "Wahkon was the earliest settlement in the Mille Lacs Lake area, beginning its history in 1885.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofwahkon.com/aroundtown"
    },
    {
      "id": 3,
      "text": "Veterans' Park in Wahkon offers a quiet spot to reflect on the town's history of service.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofwahkon.com/aroundtown"
    },
    {
      "id": 4,
      "text": "The Ellen Ruth, a historic fishing vessel, rests in a Wahkon park, echoing the lake's fishing heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofwahkon.com/aroundtown"
    },
    {
      "id": 5,
      "text": "The city sits on the south and east shore of Wahkon Bay on the south side of Mille Lake.",
