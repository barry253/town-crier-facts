  "facts": [
    {
      "id": 1,
      "text": "Cashiers sits on a 3,400‑foot plateau in the Blue Ridge Mountains, stretching about five miles long and one and a half wide.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cashiershistory.org/our-history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Zachary family’s role as “cashiers” for gold miners, a term that stuck when Jonathan Zachary became postmaster in 1839.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cashiers%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1900 the Southern Railway opened a station in nearby Toxaway, sparking a boom in visitors to the Cashiers Valley.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cashiershistory.org/our-history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cashiers Historical Society, founded in 1996, preserves four historic structures and the broader heritage of the valley.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cashiershistory.org/our-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cashiers receives more than 87 inches of rain each year, making it one of the rainiest spots in the eastern United States.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cashiers%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village’s cool July average of 78°F keeps it one of the coolest mountain communities during summer.",
