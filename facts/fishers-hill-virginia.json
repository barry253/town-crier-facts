  "facts": [
    {
      "id": 1,
      "text": "The Battle of Fisher’s Hill, fought on September 22 1864, ended with a Union victory that forced Confederate General Early’s forces to retreat toward Waynesboro.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shenandoahatwar.org/fishers-hill-battlefield/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fisher’s Hill’s ridges earned the nickname “The Gibraltar of the Valley” because they sit between Little North Mountain and Massanutten Mountain, just 3.9 miles apart.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.shenandoahatwar.org/fishers-hill-battlefield/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Snapp House, built by German settlers, was added to the National Register of Historic Places in 1979 for its classic 19th‑century architecture.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fishers_Hill%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fishers Hill sits just 2.1 miles west of Strasburg, placing it deep within the Shenandoah Valley’s rolling hills.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fishers_Hill%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "German-American painter and champion walker Bertha von Hillern made Fisher's Hill her studio in the 1880s, drawn by the Shenandoah Valley's scenic ridges.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fishers_Hill%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Ramseur’s Hill Park on the battlefield offers walking trails that let visitors trace the 1864 Union assault.",
