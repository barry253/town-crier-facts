  "facts": [
    {
      "id": 1,
      "text": "The Greenhorn Creek project blended historic preservation with commercial development, setting a statewide example of thoughtful land use.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/greenhorn-creek-history-and-archaeology",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the 1988‑1992 studies, 32 prehistoric and historic sites were catalogued, guiding the final design to protect the most important ones.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/greenhorn-creek-history-and-archaeology",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The development plan called for an 18‑hole golf course, 767 homes, a conference center with hotel, a swim‑and‑tennis club, and a fire station.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/greenhorn-creek-history-and-archaeology",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "A walking trail named Greenhorn Creek was added to the project, allowing visitors to stroll past many preserved landmarks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/greenhorn-creek-history-and-archaeology",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Federal law required the identification of cultural resources before permitting, so archaeological studies were conducted to safeguard Greenhorn’s heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.calaverashistory.org/greenhorn-creek-history-and-archaeology",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Greenhorn Creek project’s monitoring program, directed by the City of Angels, ensures ongoing protection of the identified historic sites.",
      "sourceSentenceIds": [
