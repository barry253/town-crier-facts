  "facts": [
    {
      "id": 1,
      "text": "Silo, Oklahoma, was originally part of the traditional homeland of the Choctaw people following their forced removal from the southeastern United States.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silo_oklahoma"
    },
    {
      "id": 2,
      "text": "Silo emerged as a settlement near a vital spring and an American Indian school, with a post office opening in 1893.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silo_oklahoma"
    },
    {
      "id": 3,
      "text": "Early travelers and homesteaders used the Silo post office while traveling the stage route from Fort Smith, Arkansas, to Texas.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silo_oklahoma"
    },
    {
      "id": 4,
      "text": "Silo began to decline after the Louis, San Francisco and New Orleans Railroad bypassed the town during construction in 1902 and 1903.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=SI003"
    },
    {
      "id": 5,
      "text": "The Silo post office operated out of a local store until it finally closed in 1946.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silo_oklahoma"
    },
    {
      "id": 6,
      "text": "Silo is a rural town located in Bryan County, Oklahoma, and is served by Silo High School.",
