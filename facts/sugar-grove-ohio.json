  "facts": [
    {
      "id": 1,
      "text": "Sugar Grove earned its name from a nearby sugar orchard that once flourished beside the original town site.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Grove%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Situated where Rush Creek meets the Hocking River, Sugar Grove has long been called the gateway to the Hocking Hills, reflecting its historic transport role.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Grove%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village was incorporated in 1851 and served as a stop along the Hocking Canal, a key artery in Ohio’s early transportation network.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Grove%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every summer and fall, Main Street comes alive with the Berne Union Golden Rockets Marching Band, a local tradition that echoes the town’s community spirit.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sugar-grove.com/village-history.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just outside the village limits on Buckeye Road lies the historic Sugar Grove Cemetery, a quiet reminder of the town’s early settlers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sugar-grove.com/village-history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The new Town Hall now stands where the old Sugar Grove Community Building once did, preserving the site’s civic heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museum.sugargrovehistory.org/collections/show/39",
