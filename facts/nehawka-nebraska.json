  "facts": [
    {
      "id": 1,
      "text": "Nehawka means 'rustling water,' a name chosen after the nearby 'Weeping Water' was already taken.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.nehawkanebraska.com/index.php/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent settlement in Nehawka dates back to 1855, long before the town was officially platted.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nehawka%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When a railroad line extended to Nehawka in 1887, the town was platted and a station was secured, turning it into a real town.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nehawka%2C_Nebraska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A stone quarry existed in the area before the town, supplying building materials for homes and businesses.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nehawkanebraska.com/index.php/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "First State Bank Nebraska has served the local agricultural economy since 1895, still operating in Nehawka.",
      "sourceSentenceIds": [
        11
