      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Vice‑President Kenneth Lewis Anderson, who died at the Fanthorp Inn in 1845.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Anderson%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Anderson’s historic district preserves buildings that span from the Mexican era through early Texas statehood.",
      "sourceSentenceIds": [
