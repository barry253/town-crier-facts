  "facts": [
    {
      "id": 1,
      "text": "Black Rock’s basaltic escarpment has supported Zuni irrigation fields since about 3000 BP, when the first crops were grown beside a reliable spring.",
      "sourceSentenceIds": [
        1,
        9,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/black_rock_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A small, seasonally occupied Zuni village perched on a lava flow north of the Zuni River earned the Spanish name “Ranchos de Zuni.”.",
      "sourceSentenceIds": [
        10,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/black_rock_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Black Rock Reservoir, created by damming the Zuni River in 1908, has been rebuilt three times, most recently in the mid‑1990s.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_Rock%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Black Rock grew into a modern hub when the Bureau of Indian Affairs built the Zuni Agency Boarding School, turning the area into an agency town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/black_rock_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Black Rock’s Zuni people were part of extensive Southwest trade networks, exchanging turquoise, shell, and macaw feathers from Mexico and California.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/black_rock_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Black Rock’s non‑commercial airstrip, constructed after World War II, remained unpaved until 1970.",
