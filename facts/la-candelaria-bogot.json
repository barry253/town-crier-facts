      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood takes its name from the colonial Church of Nuestra Señora de la Candelaria.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
