  "facts": [
    {
      "id": 1,
      "text": "Fayetteville sits in Fayette County, a region named after the French hero Marquis de LaFayette who aided George Washington during the Revolution.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.fayettecountypa.org/551/Fayette-County-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Dunbar Historical Society, located in Fayetteville, preserves iron furnaces, brick ovens, and early loghouses that tell the county’s industrial story.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/southwestern-pennsylvania/fayette",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 2005 educational video titled “Fayette County, A Video History” is available from the Fayette County Historical Society for anyone curious about the area’s past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fayettecountypa.org/551/Fayette-County-History",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Fayetteville’s Flatiron Building, built around 1830 along the National Road, still stands as a wedge‑shaped reminder of early commercial architecture.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/southwestern-pennsylvania/fayette",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The National Road, which once ran through Fayetteville, was authorized by Congress in 1806 and linked the East Coast to the Midwest.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fayettecountypa.org/551/Fayette-County-History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Fayette County Historical Society, founded in 1971, collects and preserves artifacts that portray the county’s rich heritage for future generations.",
      "sourceSentenceIds": [
        23,
