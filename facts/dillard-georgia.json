  "facts": [
    {
      "id": 1,
      "text": "Dillard was founded in 1846 around the homestead of Captain John Dillard, one of the first white settlers in northern Rabun County.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://rabunhistory.org/towns/dillard/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Tallulah Falls Railroad reached Dillard in 1906, turning the town into a bustling lumber hub where hundreds of rail cars shipped logs each year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://rabunhistory.org/towns/dillard/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the same year, 1906, the Georgia General Assembly incorporated the place as the Town of Dillard, formalizing its status.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillard%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "John Dillard’s grandson built a stagecoach way station on the historic Rabun Turnpike, a north‑south route that once served as a toll road.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://rabunhistory.org/towns/dillard/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dillard sits in the Little Tennessee River valley, just south of the North Carolina border and surrounded by the Blue Ridge Mountains.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dillard%2C_Georgia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name honors the Dillard family, whose early settlement and land purchases helped shape the region’s development.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
