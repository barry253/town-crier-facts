      ],
      "source": "https://encyclopediaofalabama.org/article/odenville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first settlers, the Hardin family, called the area Hardin's Shop after establishing a blacksmith shop in 1824.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
