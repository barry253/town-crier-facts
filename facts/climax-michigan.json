  "facts": [
    {
      "id": 1,
      "text": "Climax got its name in 1834 when Judge Caleb Eldred’s family found a prairie and called it the “climax” of their search.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On December 3, 1896, Climax became the first community in Michigan to receive free rural mail service, a milestone celebrated by two riders.",
      "sourceSentenceIds": [
        10,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits within Climax Township, about 12 miles west of Battle Creek and 16 miles east of Kalamazoo, placing it in a rural heartland.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Michigan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Early settlers traced the area to 1825 with John Mullet, and by 1838 more Euro‑American families began farming the fertile prairie.",
      "sourceSentenceIds": [
        7,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Climax%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic “Old Fort” once stood on a high knoll southwest of Climax, its garden beds and trenches marking early defensive plans.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.climaxtownship.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The first white visitor to the prairie was Colonel John Mullet in 1826, a surveyor who mapped the land before settlement.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
