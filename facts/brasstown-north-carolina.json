  "facts": [
    {
      "id": 1,
      "text": "The name 'Brasstown' comes from a mistranslation of Cherokee 'Itse'yĭ', meaning 'New Green Place', not 'brass'.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brasstown%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Brasstown is the oldest continuous settlement in Clay County, tracing back to the early 1800s.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brasstown%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1925, Brasstown hosts the nation's oldest folk school, preserving Appalachian crafts and music.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitsmokies.org/explorers-guide-to-hayesville-and-brasstown/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Little Brasstown Baptist, the community's largest church, was founded in 1850 and remains a local landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brasstown%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brasstown grew along the historic Unicoi Turnpike, a Native American route later turned into a toll road in 1813.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brasstown%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Brasstown Creek runs through the community, literally dividing Clay and Cherokee counties as it flows toward the Hiwassee River.",
