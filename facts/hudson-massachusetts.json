      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hudson%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1895 Colonel Adelbert Mossman House on Park Street is listed on the National Register of Historic Places and showcases Hudson’s Victorian architecture.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
