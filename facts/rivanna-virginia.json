  "facts": [
    {
      "id": 1,
      "text": "Rivanna takes its name from the river, which early colonists christened after Queen Anne.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rivannariverbasin.org/rivannariverstorymapforum/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Long before Europeans, the Monacan Nation called the Rivanna River their heartland, practicing sustainable Three Sisters agriculture.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rivannariverbasin.org/rivannariverstorymapforum/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Canals once boosted Fluvanna County, but the railroad arrived in 1881, reshaping local trade.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fluvannacounty.org/explore/page/fluvanna-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Removing the Woolen Mills Dam restored flow and revived fish habitats along the Rivanna.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rivannariverbasin.org/rivannariverstorymapforum/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thomas Jefferson helped design sluices and wing dams to make the Rivanna navigable for flat‑bottomed batteaux.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rivannariverbasin.org/rivannariverstorymapforum/",
      "category": "history",
      "quality": "good"
    },
    {
