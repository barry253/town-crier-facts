  "facts": [
    {
      "id": 1,
      "text": "Seward sits on the ice‑free Resurrection Bay, a spot that has drawn settlers from prehistoric times through Russian rule, gold rushes, and World War II.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/seward-alaska"
    },
    {
      "id": 2,
      "text": "The town’s name honors William Henry Seward, Lincoln’s Secretary of State who negotiated Alaska’s purchase for two cents an acre in 1867.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.seward.com/plan-your-visit/about-seward/history/"
    },
    {
      "id": 3,
      "text": "Seward was founded in 1903 by the Ballaine Brothers as the ocean terminus for the Alaska Central Railway, linking the coast to the interior.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/seward-alaska"
    },
    {
      "id": 4,
      "text": "The Seward Museum, run by the Resurrection Bay Historical Society, showcases the city’s layered history from First Peoples to modern times.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
