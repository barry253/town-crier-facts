  "facts": [
    {
      "id": 1,
      "text": "Fithian was named after William Fithian, who donated land for the town and once hosted Abraham Lincoln on his farm.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fithian%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town flourished when the Illinois Traction System railroad arrived in 1903, only to decline with the line and the Great Depression.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fithian%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Vermilion County Museum and the historic Fithian Home sit together on a small campus that showcases Danville’s history.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vermilioncountymuseum.org/plan-your-visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Opened in 2002, the museum features galleries on natural history, Native American artifacts, coal mining, and Lincoln’s legacy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vermilioncountymuseum.org/plan-your-visit/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "William Fithian’s farm, just a mile west of the town, was a frequent stop for Lincoln during his mid‑19th‑century circuit.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fithian%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fithian lies about ten miles west of Danville and is part of the Danville, Illinois Metropolitan Statistical Area.",
      "sourceSentenceIds": [
