  "facts": [
    {
      "id": 1,
      "text": "Founded in 1902 as a rail stop on the El Paso and Southwestern Railroad, Rodeo became the cattle‑shipping hub of the San Simon Valley.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rodeo%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Spanish rodeo, meaning “roundup” or “enclosure,” a nod to its early cattle‑gathering role.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rodeo%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The old El Paso and Southwestern line that birthed Rodeo once hauled copper from Bisbee to an El Paso refinery.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/regions/southwest/rodeo/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Rodeo is known as “New Mexico’s Most Western Town,” blending a preserved Old West feel with a thriving arts community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/1908776/rodeo-new-mexico-western-town-artsy-hub-railroad-history-natural-beauty/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A nearly frozen‑in‑time adobe building from 1910 now houses the town’s historic and cultural site, showcasing desert‑inspired art.",
      "sourceSentenceIds": [
        10
