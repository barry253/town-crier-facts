  "facts": [
    {
      "id": 1,
      "text": "Washington Grove began as a Methodist camp meeting site in 1874 with 240 tents, later becoming a permanent town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Grove%2C_Maryland"
    },
    {
      "id": 2,
      "text": "The town’s layout features a central plaza that once hosted a symbolic circle, with six avenues radiating outward, echoing its camp meeting origins.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Grove%2C_Maryland"
    },
    {
      "id": 3,
      "text": "The Baltimore & Ohio Railroad’s Metropolitan Line reached Washington Grove in 1873, offering reduced rates that helped the camp meetings thrive.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washingtongrovemd.gov/about-wg/our-history/history-of-washington-grove/"
    },
    {
      "id": 4,
      "text": "In 1975 a master plan was drafted to preserve Washington Grove’s historic character, leading to its 1980 National Register listing.",
      "sourceSentenceIds": [
        8,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington_Grove%2C_Maryland"
    },
    {
      "id": 5,
      "text": "A belfry added to McCathran Hall now houses a bell that originally hung in a tree, linking the town’s religious heritage to its architecture.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://washingtongrovemd.gov/about-wg/our-history/history-of-washington-grove/"
    },
    {
      "id": 6,
      "text": "Washington Grove’s historic district spans the town’s original residential community, reflecting indigenous use dating back to 10,000 BCE.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
