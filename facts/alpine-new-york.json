  "facts": [
    {
      "id": 1,
      "text": "Alpine was a booming mill town in the mid‑to‑late 19th century, thriving on local timber and water power.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://antharky.ucalgary.ca/mccafferty/miscellaneous/alpine-new-york"
    },
    {
      "id": 2,
      "text": "The boom ended when forests were exhausted and the railroad bypassed Alpine in the late 1800s, shrinking the town’s growth.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://antharky.ucalgary.ca/mccafferty/miscellaneous/alpine-new-york"
    },
    {
      "id": 3,
      "text": "Alpine first appeared on an 1835 Tompkins County map, marking its early settlement in the early 1800s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://antharky.ucalgary.ca/mccafferty/miscellaneous/alpine-new-york"
    },
    {
      "id": 4,
      "text": "By 1857 Beers’ map recorded about two dozen homes and several mills, illustrating the town’s early industrial core.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://antharky.ucalgary.ca/mccafferty/miscellaneous/alpine-new-york"
    },
    {
      "id": 5,
      "text": "A bridge replacement over Swan Hill Creek triggered two seasons of archaeological research, uncovering the town’s industrial past.",
      "sourceSentenceIds": [
