  "facts": [
    {
      "id": 1,
      "text": "Snelling served as Merced County’s seat from 1857 until 1872, making it the county’s early political hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snelling%2C_California"
    },
    {
      "id": 2,
      "text": "Named in 1851 after Charles Snelling, a hotelier and rancher, the town grew around his way station.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://explore.museumca.org/goldrush/dist-snelling.html"
    },
    {
      "id": 3,
      "text": "The 1857 Snelling Courthouse, now Landmark #409, still stands as a rare two‑story example of early California civic architecture.",
      "sourceSentenceIds": [
        2,
        12,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Snelling%2C_California"
    },
    {
      "id": 4,
      "text": "The courthouse functioned as a justice court until the 1990s, earning it a reputation for longevity among state buildings.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Snelling%2C_California"
    },
    {
      "id": 5,
      "text": "Snelling lies on the north bank of the Merced River where the water exits the Sierra Nevada foothills into the Central Valley.",
