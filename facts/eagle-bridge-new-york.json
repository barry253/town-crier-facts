  "facts": [
    {
      "id": 1,
      "text": "Eagle Bridge earned its name from a patriotic eagle emblem painted on an early bridge over the Hoosic River.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/eagle_bridge_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet became a railroad hub in the 19th century, where the Delaware & Hudson, Boston & Maine, and Rutland lines intersected.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eagle_bridge_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1899 iron truss bridge crossed the Hoosic River, later replaced in 1933 by a polygonal Warren through truss that still carries traffic today.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/eagle_bridge_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Grandma Moses, the famed folk artist, lived in Eagle Bridge from 1905 and painted many scenes of the local countryside.",
      "sourceSentenceIds": [
        13,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Eagle_Bridge%2C_New_York",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eagle Bridge lies roughly 30 miles northeast of Albany and 15 miles west of Bennington, Vermont, making it a quiet crossroads between New York and New England.",
