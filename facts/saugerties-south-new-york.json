  "facts": [
    {
      "id": 1,
      "text": "In 1677, New York Governor Andros bought the land that is now Saugerties from Esopus chief Kaelcop for a blanket, cloth, shirt, bread, and coarse fiber.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://saugertiesny.gov/about/history"
    },
    {
      "id": 2,
      "text": "Barent Cornelis Volge ran a sawmill on Sawyer's Kill between 1652 and 1663, earning the nickname 'The Little Sawyer' from local Indians.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://saugertiesny.gov/about/history"
    },
    {
      "id": 3,
      "text": "Within two years of the 1677 purchase, the riverfront land was sold to miller Barent Burhans, whose grandson John Brink Jr. built a ferry to Clermont.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageofsaugerties.gov/about/history-village"
    },
    {
      "id": 4,
      "text": "Saugerties once housed powder and paint manufactories that, after relocating, became the largest in the world.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://villageofsaugerties.gov/about/history-village"
    },
    {
      "id": 5,
      "text": "Saugerties South sits on the west bank of the Hudson River, just south of the Village of Saugerties and Esopus Creek.",
