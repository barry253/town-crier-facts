  "facts": [
    {
      "id": 1,
      "text": "Fowler was platted by Moses and Eliza Fowler on Oct 26 1872 with 583 lots, then re‑platted in 1875 to 1,602 lots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fowler%2C_Indiana"
    },
    {
      "id": 2,
      "text": "In 1875 Fowler incorporated, and by 1883 it boasted ten lawyers, three doctors, a hotel, and about 1,200 residents.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fowler%2C_Indiana"
    },
    {
      "id": 3,
      "text": "The arrival of the Big 4 railroad in 1872 sparked Fowler’s rapid growth, linking grain and livestock to distant markets.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://allthingsusa.blog/town-fowler-indiana-heart-history"
    },
    {
      "id": 4,
      "text": "Moses Fowler lobbied in 1873 to move Benton County’s seat to his town, cementing Fowler’s regional importance.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://allthingsusa.blog/town-fowler-indiana-heart-history"
    },
    {
      "id": 5,
      "text": "The Benton County Courthouse, Fowler Theatre, and Fraser & Isham Law Office are all listed on the National Register of Historic Places.",
