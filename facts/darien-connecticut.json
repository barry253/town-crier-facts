  "facts": [
    {
      "id": 1,
      "text": "Darien was originally part of Stamford, settled by Wethersfield colonists in 1641, and became Middlesex Parish in 1737.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darien%2C_Connecticut"
    },
    {
      "id": 2,
      "text": "The town adopted the name Darien in 1820 after residents couldn't agree on a replacement for Middlesex Parish, inspired by Panama's Darién region.",
      "sourceSentenceIds": [
        11,
        14,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.darienct.gov/216/About-Darien"
    },
    {
      "id": 3,
      "text": "Darien Library, founded in 1894, is the most heavily utilized library in Connecticut.",
