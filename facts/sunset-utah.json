  "facts": [
    {
      "id": 1,
      "text": "Mormon pioneers originally used the Sunset area as a place to feed and graze animals during the cold winter months.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunsetut.gov/city-information/"
    },
    {
      "id": 2,
      "text": "Sunset emerged as a distinct place in 1916 after previously being known as Sandridge, The Range, The Basin, and the Summit.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset%2C_Utah"
    },
    {
      "id": 3,
      "text": "The James Hill family started the first known permanent settlement in Sunset during the 1800s.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunsetut.gov/city-information/"
    },
    {
      "id": 4,
      "text": "Sunset takes its name from a group of local women who admired the colorful sunsets over the Great Salt Lake.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunsetut.gov/city-information/"
    },
    {
      "id": 5,
      "text": "The rails of the Union Pacific Railroad separate Sunset from the city of Clinton to the west.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunsetut.gov/city-information/"
    },
    {
      "id": 6,
      "text": "Sunset is located in northern Davis County, about twenty-five miles north of Salt Lake City.",
      "sourceSentenceIds": [
