    },
    {
      "id": 2,
      "text": "The historic Marcus Hook Plank House once housed Margaret, the alleged mistress of pirate Blackbeard, who visited the town.",
      "sourceSentenceIds": [
        7,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Marcus_Hook%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "In 1653 Queen Christina of Sweden granted a large tract to Captain John Ammundsen Besk, later forming part of Marcus Hook.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.marcushookps.org/history.php"
    },
    {
      "id": 4,
      "text": "The Philadelphia‑Wilmington‑Baltimore Railroad spurred commercial growth in the late 19th century, linking Marcus Hook to major cities.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://marcushookboro.org/about/"
    },
    {
      "id": 5,
      "text": "During the fall of 1777, the Continental Army was stationed in Marcus Hook, using the town as a strategic base.",
      "sourceSentenceIds": [
