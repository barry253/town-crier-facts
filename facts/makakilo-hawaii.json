  "facts": [
    {
      "id": 1,
      "text": "In Hawaiian, maka kilo means \"observing eyes,\" a name that reflects the area’s historic role as a lookout.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Makakilo%2C_Hawaii"
    },
    {
      "id": 2,
      "text": "Makakilo sits on the southern slopes of the Waiʻanae range, overlooking the city of Kapolei.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Makakilo%2C_Hawaii"
    },
    {
      "id": 3,
      "text": "Kahunas gathered on Makakilo’s peaks to watch the skies by day and stars by night, interpreting signs for the island’s chiefs.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hawaiiliving.com/blog/makakilo-history/"
    },
    {
      "id": 4,
      "text": "For centuries, Makakilo served as the decision‑making hub where chiefs heard the hillside’s voice and shaped Oahu’s destiny.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hawaiiliving.com/blog/makakilo-history/"
    },
    {
      "id": 5,
      "text": "Because of its sacred status, the slopes were reserved for kahunas alone, keeping commoners from living there.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hawaiiliving.com/blog/makakilo-history/"
    },
    {
      "id": 6,
      "text": "The first major development of Makakilo began in the early 1960s, sparked by finance factors on lands leased from the Campbell Estate.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hawaiiliving.com/blog/makakilo-history/"
    }
  ]
}
