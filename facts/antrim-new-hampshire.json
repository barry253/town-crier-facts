      "id": 1,
      "text": "Antrim was incorporated in 1777 and named after County Antrim in Ireland, the native home of landowner Philip Riley.",
      "sourceSentenceIds": [
        5,
        7,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
