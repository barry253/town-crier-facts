      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Yaacov Agam’s kinetic sculpture fountain, installed in 1986, replaced a glass statue fountain from the 1970s redesign.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
