      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew when the Atlantic and Pacific Railroad reached it in 1882 and the Kansas and Arkansas Valley Railway followed in 1889.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CL002",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Claremore is the birthplace of Will Rogers, whose home still stands outside Oologah and is a key historic site.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
