  "facts": [
    {
      "id": 1,
      "text": "Wedgwood Rock is a 700‑ton glacial erratic that once marked a dense forest on William Weedin’s farm.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wedgwood_Rock"
    },
    {
      "id": 2,
      "text": "The rock was originally called Lone Rock, later Big Rock, before the neighborhood adopted the name Wedgwood.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wedgwood_Rock"
    },
    {
      "id": 3,
      "text": "In 1887 the Seattle, Lake Shore & Eastern Railway crossed the area, and a station was named after the Ross family who allowed the line.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wedgwoodinseattlehistory.com/"
    },
    {
      "id": 4,
      "text": "The Wedgwood Community Club, founded in 1946, grew from a housing development into a civic hub for residents.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wedgwoodcc.org/about/history/"
    },
    {
      "id": 5,
      "text": "NE 68th Street hosts the Northeast Branch Library, a landmark that has served the community since the early 20th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wedgwoodinseattlehistory.com/"
    },
    {
      "id": 6,
      "text": "The former Morningside Substation site is now a planned park, thanks to voter‑approved funding and Seattle Parks’ design work.",
      "sourceSentenceIds": [
