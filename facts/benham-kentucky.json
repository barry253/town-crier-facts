  "facts": [
    {
      "id": 1,
      "text": "Benham was founded as a model coal town and company town for International Harvester.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.benhamky.org/history/"
    },
    {
      "id": 2,
      "text": "Shortly after Benham was founded, a railway line linked the town to industrial centers, allowing coal to be shipped straight to factories.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.benhamky.org/history/"
    },
    {
      "id": 3,
      "text": "Benham’s historic town center ranks among the finest coal‑mining settlements of its era, and many buildings are listed on the National Register.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.benhamky.org/history/"
    },
    {
      "id": 4,
      "text": "Benham lies in Looney Creek’s valley, flanked by Looney Ridge to the north and Benham Spur to the south.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benham%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Benham was formally incorporated in 1961, earning its status as a home‑rule‑class city.",
      "sourceSentenceIds": [
        12,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benham%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "Benham’s planners built the town as a detailed project, driven by coal’s role in steel, after Wisconsin Steel bought land at Black Mountain’s foot.",
