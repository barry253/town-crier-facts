  "facts": [
    {
      "id": 1,
      "text": "Hollymead’s name means “mead hall of holly,” a nod to old English words for a gathering place surrounded by holly trees.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/hollymead-45476"
    },
    {
      "id": 2,
      "text": "The town’s history dates back to the 1700s, when Orange County was founded in 1734 and later became home to James Madison’s Montpelier estate.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/hollymead-45476"
    },
    {
      "id": 3,
      "text": "Walnut Creek Park, a quiet green escape in Hollymead, was created decades ago to give residents a natural retreat from city life.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/10-breathtaking-tourist-places-to-visit-in-hollymead/"
    },
    {
      "id": 4,
      "text": "Hollymead Town Center, built on a former small airstrip, opened for commercial use in the late 1970s and now blends shopping with walking trails.",
      "sourceSentenceIds": [
        2,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/10-breathtaking-tourist-places-to-visit-in-hollymead/"
    },
    {
      "id": 5,
      "text": "Bodo’s Bagels, a local favorite, opened in Hollymead and is known for its warm atmosphere and delicious bagels that keep visitors coming back.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://touristplaces.guide/10-breathtaking-tourist-places-to-visit-in-hollymead/"
    },
    {
      "id": 6,
      "text": "Spring and fall are the best times to visit Hollymead Town Center, when mild weather and seasonal events bring the community together.",
      "sourceSentenceIds": [
        24,
