  "facts": [
    {
      "id": 1,
      "text": "Layton earned its name from John Layton, who petitioned for the community, and the post office later dropped the 's'.",
      "sourceSentenceIds": [
        1,
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Layton%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "First settled around 1800 by John Layton, the village—originally called Centreville—sits where Layton‑Bevans, Tuttles Corner‑Dingmans, and Layton‑Hainesville roads meet.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Layton%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Dingman's Ferry Bridge spans the Delaware River at Layton, linking New Jersey’s County Route 560 to Pennsylvania’s PA 739.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Layton%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Little Flat Brook runs through the village, once powering early mills that helped shape Layton’s rural economy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Layton%2C_New_Jersey",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Simeon Fisher, a blacksmith, opened the first business in Layton, followed by Abraham Bell’s carpenter shop and tavern.",
      "sourceSentenceIds": [
        7
