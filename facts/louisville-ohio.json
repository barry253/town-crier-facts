  "facts": [
    {
      "id": 1,
      "text": "Louisville was founded in 1834 by German immigrant Henry Lautzenheiser and French Huguenot Frederick Fainot, who settled the area near Nimishillen Creek.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the post office opened in 1837, the town’s name was changed from Lewisville to Louisville to avoid confusion with another Ohio town.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pittsburgh, Fort Wayne and Chicago Railway arrived in 1852, sparking rapid growth that outpaced nearby Harrisburg, which struggled to transport wheat by barge.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Louisville’s historic downtown district, roughly bounded by Chapel Street, Lincoln Court, and East Gorgas Street, houses landmarks like Saint Louis Catholic Church, built in 1870.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Louisville Public Library’s local history collection, featuring books, papers, and photographs about Nimishillen Township, is available online through the library’s website.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.louisvillelibrary.org/content/local-history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s weekly newspaper, The Louisville Herald, first appeared in 1887 and continues to report local news today.",
      "sourceSentenceIds": [
        29
