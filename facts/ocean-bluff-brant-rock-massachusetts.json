  "facts": [
    {
      "id": 1,
      "text": "Ocean Bluff and Brant Rock were once called Missaucatucket, later Green's Harbor, and lay within the Wampanoag confederacy’s territory before European arrival.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ocean_bluff_brant_rock_massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Historically, the region has roots in Native American habitation by the Wampanoag and Massachusett tribes, with early European settlement beginning in 1632 near Green Harbor.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ocean_bluff_brant_rock_massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Brant Rock got its name from the huge rock outcropping where brant geese rested, replacing its earlier name 'Branch's Island'.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ocean_Bluff-Brant_Rock%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the 1870s, the railroad turned Ocean Bluff and Brant Rock into summer resorts, with cottages in Queen Anne, Colonial Revival, and Craftsman styles.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ocean_bluff_brant_rock_massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On Christmas Eve, December 24, 1906, Fessenden transmitted from Brant Rock Station the first radio broadcast of music and entertainment in history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ocean_Bluff-Brant_Rock%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 5,400‑foot concrete seawall built in the 1930s protects Ocean Bluff’s eroding beaches and rock formations from storm surges.",
