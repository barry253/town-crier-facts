  "facts": [
    {
      "id": 1,
      "text": "The Sunset District earned its name in 1886 when developer Aurelius Buckingham first coined the term, a claim echoed by the 1894 Midwinter Exposition.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco"
    },
    {
      "id": 2,
      "text": "East–west streets in the Sunset run alphabetically from Lincoln Way down to Sloat Boulevard, a pattern that mirrors the city’s historic naming of avenues.",
      "sourceSentenceIds": [
        7,
        16,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco"
    },
    {
      "id": 3,
      "text": "Before the 1906 earthquake, the area was mostly sand dunes known as the 'Outside Lands,' only later transformed into the streetcar suburb we see today.",
      "sourceSentenceIds": [
        17,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco"
    },
    {
      "id": 4,
      "text": "Funston Avenue, the only numbered street that skips 13, honors U.S. Army officer Frederick Funston, a nod to the city’s military heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco"
    },
    {
      "id": 5,
      "text": "Children of the Inner Sunset grew up chasing a military airplane that perched atop Larsen Park’s hill, a quirky landmark now remembered in local lore.",
      "sourceSentenceIds": [
        11
