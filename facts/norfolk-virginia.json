      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was the original headquarters of Norfolk Southern Railway, one of North America’s largest Class I railroads, before relocating to Atlanta.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
