      "quality": "good"
    },
    {
      "id": 2,
      "text": "Earle began as two neighboring towns—Earle and Norvell—founded in the 1860s on land that later became the city.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earle%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Earle post office operated out of Norvell before the two communities merged.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Earle%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Earle was founded as a train stop in the late 1880s on land owned by Josiah Francis Earle, a former Confederate soldier.",
      "sourceSentenceIds": [
