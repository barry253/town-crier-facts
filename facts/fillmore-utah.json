  "facts": [
    {
      "id": 1,
      "text": "Fillmore was named for the 13th U.S. President, Millard Fillmore, after whom the town was christened.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
