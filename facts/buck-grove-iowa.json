    },
    {
      "id": 2,
      "text": "Buck Grove sat on the Milwaukee Railroad’s Sioux City branch, fueling its ambition and growth into a thriving 19th‑century town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
