    {
      "id": 1,
      "text": "Eustis takes its name from Colonel Abraham Eustis, a U.S. Army officer who helped settle the area.",
      "sourceSentenceIds": [
        14,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
