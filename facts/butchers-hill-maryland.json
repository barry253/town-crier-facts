  "facts": [
    {
      "id": 1,
      "text": "Butchers Hill earned its name from the butchers and poultry preparers who settled there in the 1800s.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butchers_Hill%2C_Baltimore"
    },
    {
      "id": 2,
      "text": "The neighborhood was once called Loundenslager's Hill until 1835, after its first butcher landlord.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butchers_Hill%2C_Baltimore"
    },
    {
      "id": 3,
      "text": "In the 1970s, revitalization projects respected the historic character of Butchers Hill, preserving its brick rowhouses.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butchers_Hill%2C_Baltimore"
    },
    {
      "id": 4,
      "text": "The area was added to the National Register of Historic Places in the 1980s, highlighting its architectural heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butchers_Hill%2C_Baltimore"
    },
    {
      "id": 5,
      "text": "Historic maps of Butchers Hill can be found at the Library of Congress, offering a window into its past layout.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.butchershill.org/history-of-butchers-hill"
    },
    {
      "id": 6,
      "text": "The neighborhood sits atop Hempstead Hill, a residential enclave that stands out in East Baltimore’s regular street grid.",
