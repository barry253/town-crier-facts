  "facts": [
    {
      "id": 1,
      "text": "Big Timber was originally called Dornix, a stage stop that grew into a wool‑shipping depot when the Northern Pacific Railroad arrived in 1883.",
      "sourceSentenceIds": [
        2,
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://cityofbigtimber.com/"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the large cottonwood trees along Big Timber Creek, a detail William Clark noted when he explored the area.",
      "sourceSentenceIds": [
        4,
        5,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Timber%2C_Montana"
    },
    {
      "id": 3,
      "text": "In 1880 two Irishmen drove 3,000 sheep from California to the area, sparking a long‑standing sheep‑and‑cattle ranching tradition.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofbigtimber.com/"
    },
    {
      "id": 4,
      "text": "Big Timber became the county seat of Sweet Grass County in 1895, cementing its regional importance.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127493"
    },
    {
      "id": 5,
      "text": "A 1908 fire destroyed half the commercial buildings and a third of homes, reshaping the town’s architecture.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Big_Timber%2C_Montana"
    },
    {
      "id": 6,
      "text": "The Crazy Mountain Museum preserves local history, offering a glimpse into Big Timber’s past.",
