  "facts": [
    {
      "id": 1,
      "text": "Southside earned its name because it sits on the south side of the Coosa River, straddling Etowah and Calhoun counties.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofsouthside.com/explore/history/"
    },
    {
      "id": 2,
      "text": "Southside traces its roots back to 1850, when settlers first established the community that would later merge into the city.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/southside/"
    },
    {
      "id": 3,
      "text": "In its early days, Southside's economy relied on agriculture, with Green Valley hosting a grist mill, blacksmith, and sorghum mill.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southside%2C_Alabama"
    },
    {
      "id": 4,
      "text": "Southside nestles in the foothills of the southern Appalachian Mountains, just south of Gadsden.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southside%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Southside is part of the Gadsden Metropolitan Statistical Area, linking it to the regional economy.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southside%2C_Alabama"
    },
    {
      "id": 6,
      "text": "Southside lies 8 to 12 miles south of downtown Gadsden, offering a quick drive into the city.",
