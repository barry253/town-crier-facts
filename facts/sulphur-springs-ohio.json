  "facts": [
    {
      "id": 1,
      "text": "Sulphur Springs earned its name from a nearby sulphur mineral spring that gave the town its distinctive character.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sulphur_Springs%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened in 1846, and in 1890 the federal office added an 's' to distinguish it from other Ohio springs.",
      "sourceSentenceIds": [
        17,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sulphur_Springs%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early Sulphur Springs boasted a hoop and barrel factory, five wagon and buggy shops, and four tanneries that powered its economy.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://crawfordcountyohiogenealogy.org/2024/03/19/sulphur-springs-ohio-its-all-in-the-name/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the early 1800s, Davis and Richards uncovered the underground sulphurous spring while drilling for salt.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://forgotten-oh.com/forgottenoh/GhostTowns/whitesulphur.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The White Sulphur Post Office opened in 1858 at a separate station that also served as the town’s train depot.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://forgotten-oh.com/forgottenoh/GhostTowns/whitesulphur.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today the former resort site hosts a correctional institution, a park, and the Concord Township Fire Station.",
      "sourceSentenceIds": [
        13
      ],
