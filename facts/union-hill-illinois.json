  "facts": [
    {
      "id": 1,
      "text": "The Indiana, Illinois and Iowa Railroad, later the Kankakee Belt Route, cut through Union Hill in 1882, sparking the town’s growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Hill%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Brothers Cornelius and John E. Schobey are credited with founding Union Hill, settling the area in the mid‑1800s.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Hill%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Schobey opened Union Hill’s first post office in 1861, right as the Civil War began.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Hill%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name was chosen to honor the Union during the Civil War, with “Union” added to the original hill designation.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Hill%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Union Hill likely became an incorporated village in either 1903 or 1904, formalizing its local government.",
