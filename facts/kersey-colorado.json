  "facts": [
    {
      "id": 1,
      "text": "Kersey takes its name from a railroad official who honored his mother when naming the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kersey%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1830s Elbridge Gerry founded Fort Gerry, a trading post on the South Platte River that marked the first white settlement in Weld County.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kersey%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kersey Museum, housed in a classic brick building with green trim, showcases pioneer life and agricultural development through thoughtfully arranged exhibits.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/overlooked-peaceful-town-colorado/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kersey Community Church, with its distinctive peaked roof, stands as a spiritual landmark against the bright Colorado blue sky.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/overlooked-peaceful-town-colorado/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kersey is a full‑service town offering 24‑hour police coverage, water and sewer services, a library, senior center, and recreation department.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kerseygov.com/living_visiting/about_kersey/index.php",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Situated just east of the Rocky Mountains’ foothills and south of the Pawnee Buttes, Kersey sits amid Colorado’s picturesque plains.",
