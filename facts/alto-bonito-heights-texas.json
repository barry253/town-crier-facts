  "facts": [
    {
      "id": 1,
      "text": "Alto Bonito Heights was originally part of Spanish colonial ranchos along the Rio Grande established during mid-eighteenth-century colonization efforts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alto_bonito_heights_texas"
    },
    {
      "id": 2,
      "text": "Spanish and Mexican authorities once issued long, narrow strips of land called porciones to facilitate ranching near Alto Bonito Heights.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alto_bonito_heights_texas"
    },
    {
      "id": 3,
      "text": "The Longoria family helped establish the area by claiming and defending land grants against encroachment in the late eighteenth century.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alto_bonito_heights_texas"
    },
    {
      "id": 4,
      "text": "Alto Bonito Heights sits on the flat, arid plains of the Rio Grande Valley at an average height of 236 feet.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alto_bonito_heights_texas"
    },
    {
      "id": 5,
      "text": "The semi-arid climate of Alto Bonito Heights features hot summers and mild winters with annual precipitation of about 22 inches.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/alto_bonito_heights_texas"
    },
    {
      "id": 6,
      "text": "Deep, well-drained silt loams in Alto Bonito Heights support limited irrigated farming of grains and vegetables.",
      "sourceSentenceIds": [
        27
