  "facts": [
    {
      "id": 1,
      "text": "North Bend traces its history to July 4, 1856, when pioneers Robert Millar and George Young climbed out of their wagons near the north bend of the Platte River.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.northbendne.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Union Pacific Railroad bought a piece of ground for a depot on the proposed transcontinental railroad in 1864, giving the town its present name.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Bend%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Bend’s first newspaper, the Independent, was founded in 1879.",
