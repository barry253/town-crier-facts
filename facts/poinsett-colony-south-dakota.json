  "facts": [
    {
      "id": 1,
      "text": "Poinsett Colony takes its name from Joseph Robert Poinsett, an early explorer who surveyed eastern South Dakota in 1838.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakepoinsettcommunity.org/the-lake-poinsett-story"
    },
    {
      "id": 2,
      "text": "Glaciers from the Arctic wastes deposited gravel, sand, and earth here tens of thousands of years ago to form the local lakes.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakepoinsettcommunity.org/the-lake-poinsett-story"
    },
    {
      "id": 3,
      "text": "Ancient Indian villages and burial mounds have been discovered near Poinsett Colony, with some evidence dating back 1,400 years.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakepoinsettcommunity.org/the-lake-poinsett-story"
    },
    {
      "id": 4,
      "text": "Early settlers in the Poinsett Colony area once gathered buffalo bones from the land to sell to a fertilizer factory.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakepoinsettcommunity.org/the-lake-poinsett-story"
    },
    {
      "id": 5,
      "text": "Lake Poinsett served as a gathering place for original American families for generations, providing a rich supply of fish and game.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakepoinsettcommunity.org/the-lake-poinsett-story"
    },
    {
      "id": 6,
      "text": "Farmers plowing their fields around Poinsett Colony still occasionally find ancient relics like flintlock guns, razors, and pottery.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
