  "facts": [
    {
      "id": 1,
      "text": "Valley, Alabama, was incorporated in 1980 by merging the textile mill villages of Langdale, Riverview, Fairfax, and Shawmut.",
      "sourceSentenceIds": [
        10,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://cityofvalley.com/community/about-valley-al/"
    },
    {
      "id": 2,
      "text": "Valley sits on the western bank of the Chattahoochee River, right on the Alabama–Georgia state line.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Valley%2C_Alabama"
    },
    {
      "id": 3,
      "text": "Langdale Mill, constructed in 1866, sparked the growth of the textile village that became Langdale.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofvalley.com/community/about-valley-al/"
    },
    {
      "id": 4,
      "text": "Fairfax First Christian Church, part of the original Fairfax Mill Village, once housed worker homes, a store, a school, a kindergarten, and a movie theater.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofvalley.com/community/about-valley-al/"
    },
    {
      "id": 5,
      "text": "Valley is a pilot city for Alabama’s Communities of Excellence program, partnering with local governments, businesses, and universities.",
      "sourceSentenceIds": [
