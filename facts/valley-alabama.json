      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Valley sits on the western bank of the Chattahoochee River, right on the Alabama–Georgia state line.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
