  "facts": [
    {
      "id": 1,
      "text": "Mayflower Village was named after the Mayflower School, a community landmark built in 1927 that still stands today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mayflower-village"
    },
    {
      "id": 2,
      "text": "Mayflower Village was originally part of the San Gabriel Mission lands granted to settlers after Mexico secularized the missions.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mayflower-village"
    },
    {
      "id": 3,
      "text": "Mayflower Village was established in the 1920s as a planned residential area designed to resemble a small town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mayflower-village"
    },
    {
      "id": 4,
      "text": "Mayflower Village retains a distinct small‑town character with tree‑lined streets and historic bungalows that echo its early 20th‑century roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mayflower-village"
    },
    {
      "id": 5,
      "text": "Mayflower Village is a quiet, suburban residential area that offers a relaxed pace close to urban amenities.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_mayflower-village"
    },
    {
      "id": 6,
      "text": "The Mayflower School, built in 1927, became a central landmark for the town’s early residents and remains a cherished historic site.",
