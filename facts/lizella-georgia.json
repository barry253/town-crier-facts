    },
    {
      "id": 2,
      "text": "The town sprang up in 1891 when the Macon and Birmingham Railroad laid tracks through farms west of Macon, linking the area to LaGrange.",
      "sourceSentenceIds": [
        7,
        9,
        15
      ],
      "sourceLabels": [
