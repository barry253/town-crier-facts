  "facts": [
    {
      "id": 1,
      "text": "Thompson earned its name from William A. Thompson, a prominent early settler who helped shape the town's early days.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 2,
      "text": "The first European settlers arrived in 1749, establishing a community near Dutch Pond that marked Thompson's earliest settlement.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 3,
      "text": "Thompson was officially established in 1803, carved out of the neighboring town of Mamakating.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 4,
      "text": "In 1826, a portion of Thompson was ceded to Fallsburg, reshaping its borders.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 5,
      "text": "The Anshei Glen Wild Synagogue and Glen Wild Methodist Church sit on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 6,
      "text": "Kutsher’s, founded in 1907 as a farm, grew into one of the Catskills' most celebrated resorts.",
      "sourceSentenceIds": [
