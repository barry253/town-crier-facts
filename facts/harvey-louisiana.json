  "facts": [
    {
      "id": 1,
      "text": "Harvey began as the company town Cosmopolite City, founded by Joseph Hale Harvey in 1855, and was later renamed after his family.",
      "sourceSentenceIds": [
        4,
        8,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harvey%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Harvey Canal, dug by slaves and later widened by German settlers, linked the Mississippi River to Bayou Barataria.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harvey%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Harvey sits on the West Bank of the Mississippi, east of the Intracoastal Canal, inside the New Orleans–Metairie–Kenner metro area.",
      "sourceSentenceIds": [
        15,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harvey%2C_Louisiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The 35,000‑square‑foot library opened in 1990 and is the largest public library on the West Bank.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harvey%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jean‑Baptiste d’Estrehan, a French colonial planter, founded the original settlement that later became Harvey.",
      "sourceSentenceIds": [
        16,
        17,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harvey%2C_Louisiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Louise Destrehan, Harvey’s wife, was a great‑granddaughter of Jean‑Baptiste d’Estrehan, linking the families.",
      "sourceSentenceIds": [
