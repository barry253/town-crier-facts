  "facts": [
    {
      "id": 1,
      "text": "Vienna Township had several clock‑making factories between 1812 and the 1830s, a frontier extension of Connecticut's clock industry.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1810 a township green was laid out in what would become Vienna Center, and today it hosts Vienna Presbyterian Church, the Soldiers and Sailors Monument.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first coal mine opened in 1866 by Ira B. Flower, sparking a boom that saw about 20 mines and a surge of workers.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Vienna Academy, an early English school for boys, was housed in a 1825 building on the green.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thomas Robbins founded Vienna's Congregational Church in 1805, which became Presbyterian in 1854, one of Ohio's earliest churches.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vienna_Center%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1798, Uriel Holmes led a survey of Vienna Township under the Connecticut Land Company.",
