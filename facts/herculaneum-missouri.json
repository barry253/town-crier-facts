  "facts": [
    {
      "id": 1,
      "text": "Herculaneum was founded in 1808 by Moses Austin and Samuel Hammond as a shipping point on the Mississippi River.",
      "sourceSentenceIds": [
        23,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herculaneum%2C_Missouri"
    },
    {
      "id": 2,
      "text": "Austin named the town Herculaneum because limestone ledges overlooking the river resembled a Roman amphitheater.",
      "sourceSentenceIds": [
        24,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herculaneum%2C_Missouri"
    },
    {
      "id": 3,
      "text": "In 1819 Herculaneum became Jefferson County’s first county seat, holding that title until 1839.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Herculaneum%2C_Missouri"
    },
    {
      "id": 4,
      "text": "Lead smelting once powered Herculaneum’s economy; the Doe Run Company operated a plant that closed under EPA pressure.",
