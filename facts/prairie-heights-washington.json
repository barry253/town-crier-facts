      "id": 1,
      "text": "Prairie Heights hosts the Connells Prairie Battle Historical Marker, commemorating a key 19th‑century conflict.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-prairie-heights/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Neely Mansion, once owned by the prominent Neely family, offers guided tours that reveal early settler life.",
      "sourceSentenceIds": [
        4,
        8,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-prairie-heights/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Buckley Centennial Monument marks the town’s 100‑year anniversary and stands proudly in the town center.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-prairie-heights/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Fireplace, built in the early 1900s, remains a weathered testament to community gatherings.",
      "sourceSentenceIds": [
        12,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://beckdc.com/historical-places-in-prairie-heights/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hylebos waterway has witnessed numerous historical events and now attracts visitors with its tranquil waters.",
      "sourceSentenceIds": [
