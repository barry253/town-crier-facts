      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Petty grew around 1900, driven by ranching and farming operations led by pioneer rancher Bill Petty.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/petty-tx-lynn-county",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1974 the only remaining business in Petty was a cotton gin, underscoring its agricultural heritage.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/petty-tx-lynn-county",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s name honors Bill Petty, a Lynn County pioneer rancher who managed the T Bar Ranch.",
