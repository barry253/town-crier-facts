  "facts": [
    {
      "id": 1,
      "text": "East Liberty sits in Perry Township, named for Oliver Hazzard Perry, a War of 1812 hero who fought at Lake Erie.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://perrytownship.net/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1875 East Liberty boasted 44 homes, three dry‑goods stores, a tile factory, a gristmill, and even an art gallery.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://perrytownship.net/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Toledo & Ohio Central Railroad reached East Liberty in 1897, turning the depot into a hub that boosted the town’s prosperity.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.peakofohio.com/local-news/logan-county-history-east-liberty-early-history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alonzo Skidmore founded Central Ohio College in East Liberty in 1882, but financial strain closed it in the late 1890s.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Liberty%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 1989, the Honda East Liberty Auto Plant has produced cars, making the town a key site in American automotive manufacturing.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Liberty%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Otter Creek winds through southern East Liberty, eventually joining Mill Creek, a tributary of the Scioto River.",
