  "facts": [
    {
      "id": 1,
      "text": "Elizabeth City was founded in 1794 and prospered early on from the Dismal Swamp Canal as a mercantile city.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1801 the town was renamed Elizabeth City to avoid confusion with another town of the same name.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Known as the “Harbor of Hospitality,” Elizabeth City’s location at a narrowed bend of the Pasquotank River made it a historic shipping hub.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth_City%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city’s semi‑coastal geography once supported thriving oyster and timber industries that shaped its early economy.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth_City%2C_North_Carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Museum of the Albemarle, the northeastern regional branch of the North Carolina Museum of History, sits on the waterfront and showcases the region’s heritage.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elizabeth_City%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Downtown Elizabeth City welcomes visitors with bookstores, coffeehouses and specialty retail shops all housed in historic buildings.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
