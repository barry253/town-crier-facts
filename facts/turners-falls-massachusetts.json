  "facts": [
    {
      "id": 1,
      "text": "Turners Falls takes its name from Captain William Turner, who led a surprise attack on a Native American encampment during King Philip's War in 1676.",
      "sourceSentenceIds": [
        27,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turners_Falls%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was founded in 1868 as a planned industrial community, designed by Alvah Crocker to harness the waterfalls' power for a new city.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Turners_Falls%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Crocker's vision involved building a dam and canal on the Connecticut River, then selling mill sites and worker lots along the power canal to attract industry.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turners_Falls%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village layout follows a horizontal grid, with cross streets numbered sequentially, a common design for planned mill towns of the era.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turners_Falls%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before industrialization, the falls area was a shared resource for the Pocumtuk, Nipmuc, and Wabanaki tribes, drawn by abundant salmon and shad.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turners_Falls%2C_Massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the 1676 attack, Captain Turner's 160 mounted soldiers killed at least 40 Native Americans while withdrawing from the surprise assault.",
      "sourceSentenceIds": [
        27,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turners_Falls%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    }
  ],
