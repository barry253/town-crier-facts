  "facts": [
    {
      "id": 1,
      "text": "The first Lipan mission, San Fernando de Austria, was established on the Rio Escondido in 1754 to convert the Lipan Apache.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lipanapache.org/LAT/timeline.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1761 a third Lipan mission, San Lorenzo de la Santa Cruz, appeared on the upper Nueces near Camp Wood, Texas.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lipanapache.org/LAT/timeline.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Solano mission on the Rio Grande was dismantled and moved to the San Antonio River, becoming Mission San Antonio de Valero.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lipanapache.org/LAT/timeline.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1674 Mission San Ildefonso de la Paz was founded on the Rio Escondido of Coahuila, near the later site of the village of Zaragosa.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lipanapache.org/LAT/timeline.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1813 Apache Creek—formerly Charquito de Los Apaches—and Alazan Creek formed a confluence that became a key Lipan Apache campsite.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lipanapache.org/LAT/timeline.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1870 many Lipan Apache jacals were occupied by descendants of those who had lived at the confluence of Apache Creek and Alazan Creek.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lipanapache.org/LAT/timeline.html",
      "category": "history",
      "quality": "good"
    }
