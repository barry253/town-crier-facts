  "facts": [
    {
      "id": 1,
      "text": "Nevada City’s name comes from Spanish “Nevada” meaning snow‑covered, chosen in 1850 when it became the county seat.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nevadacitychamber.com/history/california-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The entire downtown district was registered as a national historic landmark in 1985, preserving its 19th‑century mining town look.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nevadacitychamber.com/history/california-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pioneer Cemetery, founded around 1851 behind the first Methodist church, is the town’s oldest burial ground.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nevada_City%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Nevada City Narrow Gauge Railroad Museum offers docent‑led tours of a historic railyard and restoration shop, highlighting the town’s rail heritage.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/nevada-city/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nevada City hosts the Film Festival started in 2001, while the Storytelling Festival began in 1985, making the town a hub for creative arts.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nevada_City%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Empire Mine State Historic Park, near Nevada City, lets visitors tour the mineyard and see William Bourn Jr.’s country estate, linking the town to California’s gold rush legacy.",
      "sourceSentenceIds": [
        23
      ],
