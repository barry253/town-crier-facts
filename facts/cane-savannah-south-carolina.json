  "facts": [
    {
      "id": 1,
      "text": "Cane Savannah takes its name from the open grasslands with scattered pine trees that dominate the local landscape.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/south-carolina_cane-savannah"
    },
    {
      "id": 2,
      "text": "Early settlement of Cane Savannah began in the 1740s as Scots-Irish immigrants established communities along the Black River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cane_savannah_south_carolina"
    },
    {
      "id": 3,
      "text": "Cane Savannah was established in the early 19th century as a rural community centered around the timber and turpentine industries.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/south-carolina_cane-savannah"
    },
    {
      "id": 4,
      "text": "Cane Savannah Plantation was established in 1784 through a four thousand acre land grant.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cane_savannah_south_carolina"
    },
    {
      "id": 5,
      "text": "Sharecropping emerged as the dominant economic arrangement on lands subdivided from Cane Savannah, perpetuating inequality for freedpeople.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cane_savannah_south_carolina"
    },
    {
      "id": 6,
      "text": "The establishment of Shaw Air Force Base in 1941 stimulated economic activity and infrastructure improvements throughout Cane Savannah.",
      "sourceSentenceIds": [
        7
