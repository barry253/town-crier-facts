  "facts": [
    {
      "id": 1,
      "text": "Westbrook was first settled in 1648 as the Oyster River Quarter of Old Saybrook, founded by Puritans fleeing Charles I.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westbrookct.us/319/History-of-Westbrook-Ct",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Known as Pochaug until 1810, the town’s name means “at the confluence of two rivers” and it was incorporated in 1840.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westbrookct.us/319/History-of-Westbrook-Ct",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Westbrook Historical Society keeps the town’s past alive in the old library on the Town Green, a former public building.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westbrookct.us/319/History-of-Westbrook-Ct",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "That library, built in 1904 and used until 1978, now houses a museum open on summer weekends.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westbrookct.us/319/History-of-Westbrook-Ct",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Westbrook sits on Connecticut’s shoreline, where the river meets Long Island Sound, right next to Old Saybrook.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westbrook%2C_Connecticut",
