  "facts": [
    {
      "id": 1,
      "text": "Mount Pleasant got its name in 1888, after Jane Fortune Kemp’s Irish hometown, the wife of Henry Valentine Edmonds.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Pleasant%2C_Vancouver"
    },
    {
      "id": 2,
      "text": "A once‑flowing stream turned into Brewery Creek, drawing breweries from 1888 to 1912 and later becoming the route for Vancouver’s first streetcars in 1890.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Pleasant%2C_Vancouver"
    },
    {
      "id": 3,
      "text": "Since the early 1990s, Mount Pleasant has shifted from a working‑class enclave to a trendy hub, especially around Main Street and Broadway.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Pleasant%2C_Vancouver"
    },
    {
      "id": 4,
      "text": "Today, Mount Pleasant buzzes with breweries, owner‑run boutiques, and eateries, making it one of Vancouver’s hipmest neighborhoods.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.destinationvancouver.com/neighbourhoods/mount-pleasant"
    },
    {
      "id": 5,
      "text": "The neighborhood celebrates its culture each year with the Pleasant Day Festival, a street party that draws locals and visitors alike.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.destinationvancouver.com/neighbourhoods/mount-pleasant"
    },
    {
      "id": 6,
      "text": "Mount Pleasant stretches from Cambie Street to Clark Drive and from Great Northern Way to Kingsway, framing a compact yet vibrant area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
