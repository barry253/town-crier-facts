  "facts": [
    {
      "id": 1,
      "text": "Blakely Island was named by Charles Wilkes in 1838 after naval commander Johnston Blakeley.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely_Island%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1889, Viereck and Coffelt opened a sawmill on Thatcher Bay, later bought by the family in 1892 and run until 1945.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://saltwaterpeoplehistoricalsociety.blogspot.com/2025/01/curiosities-on-rugged-blakely-island.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seattle Pacific University operates a 967‑acre biological field station on Blakely Island, the largest research campus in the San Juan Islands.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely_Island%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Blakely Island has no public ferry; visitors reach it only by private boat or ferry docking at the northern marina.",
      "sourceSentenceIds": [
        15,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely_Island%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The sixth‑largest San Juan island spans 16.9 km², is heavily forested, hilly, and hosts two freshwater lakes—Horseshoe and Spencer.",
      "sourceSentenceIds": [
        13,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blakely_Island%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2014, toxic creosote pilings from earlier habitation were removed from Thatcher Bay to protect marine life.",
