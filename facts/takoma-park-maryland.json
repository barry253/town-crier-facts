  "facts": [
    {
      "id": 1,
      "text": "Founded in 1883 by Benjamin Franklin Gilbert, Takoma Park grew from a small railroad stop into a vibrant community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Takoma_Park%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city proudly declared itself a nuclear‑free zone in 1983, requiring contractors to sign a notarized pledge against nuclear weapons.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Takoma_Park%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gilbert named the area “New Takoma,” borrowing the name of Mount Rainier, which in Lushootseed means “snow‑covered mountain.”.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Takoma_Park%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every summer, the Takoma Park Folk Festival draws musicians to six stages, celebrating the town’s long‑standing folk music heritage.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Takoma_Park%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Informally called “Azalea City,” Takoma Park earned Tree City USA status, reflecting its commitment to urban forestry.",
      "sourceSentenceIds": [
        3
