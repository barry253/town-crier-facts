  "facts": [
    {
      "id": 1,
      "text": "Lihue was named by Royal Governor Kaikioʻewa in 1837 after a land he owned on Oahu.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/L%C4%ABhu%CA%BBe%2C_Hawaii"
    },
    {
      "id": 2,
      "text": "The town grew around the Grove Farm Sugar Plantation, where William Harrison Rice built the first irrigation system in 1856.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/L%C4%ABhu%CA%BBe%2C_Hawaii"
    },
    {
      "id": 3,
      "text": "The historic Albert Spencer Wilcox Building, once a 1924 library, now houses the Kauai Museum with exhibits from the island’s birth to the Territorial Period.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.hawaii-guide.com/kauai/towns/lihue"
    },
    {
      "id": 4,
      "text": "In 1883, the first Lutheran church in Hawaii was founded in Lihue, reflecting the German immigrant influence still seen in local architecture.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/L%C4%ABhu%CA%BBe%2C_Hawaii"
    },
    {
      "id": 5,
      "text": "The Kilohana Plantation’s 2.5‑mile railway, opened in 2007, offers narrated tours on Hawaii’s first new railroad in a century.",
