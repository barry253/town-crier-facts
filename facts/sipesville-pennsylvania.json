  "facts": [
    {
      "id": 1,
      "text": "Sipesville takes its name from Michael Sipe, who opened a mercantile business there in 1843.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sipesville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In April 1900, the Somerset Town Council authorized the Lincoln Mutual Telephone Company to lay a new line between Somerset and Sipesville, boosting local communication.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sipesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Peter Sipe served as postmaster until July 1, 1882, and by 1860 mail between Somerset and Johnstown was being delivered three times a week through Sipesville.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sipesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1866 Aaron Casebeer patented a machine for jointing staves, and the next year Henry Sipes patented sleigh brakes, both originating from Sipesville.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sipesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sipesville sits on Pennsylvania Route 985, about 6.3 miles north of the borough of Somerset.",
      "sourceSentenceIds": [
        8
