  "facts": [
    {
      "id": 1,
      "text": "Known as Little Italy, Krebs was founded as a coal-mining town in the Choctaw Nation of Indian Territory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Krebs%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Krebs takes its name from Judge Edmond Folsom Krebs, a county judge born of mixed German and Choctaw ancestry.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Krebs%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The first local of the United Mine Workers in Indian Territory was established in Krebs in 1898.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Krebs%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Joseph's Catholic Church and a local opera house were the first two brick buildings constructed in Krebs.",
      "sourceSentenceIds": [
        23,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Krebs%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The Krebs Italian Band once played festivals and concerts from a double-decker bandstand in the center of town.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Krebs%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "At one time, Krebs supported five different newspapers, including the Krebs Eagle and The Oklahoma Miner.",
