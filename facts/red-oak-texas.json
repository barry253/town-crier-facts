  "facts": [
    {
      "id": 1,
      "text": "Red Oak was originally called Possum Trot because of the many possums that roamed the area before settlers renamed it after the nearby creek and its abundant red oak trees.",
      "sourceSentenceIds": [
        2,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Oak%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Patton and his family first settled on the creek below Billingsley Fort in 1845, then moved to the spot that would become modern Red Oak.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Oak%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Missouri‑Kansas‑Texas Railroad arrived in 1884, and by 1893 the town shifted its center to sit beside the new tracks.",
      "sourceSentenceIds": [
        6,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Oak%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1949, Red Oak officially incorporated as a city under Texas law, marking its transition from a rural community to an incorporated municipality.",
      "sourceSentenceIds": [
        9,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.redoaktx.org/1106/History-of-Red-Oak",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Red Oak sits on the northern edge of Ellis County and is part of the Dallas–Fort Worth metroplex, a region projected to grow to 63,329 residents by 2030.",
      "sourceSentenceIds": [
        11,
