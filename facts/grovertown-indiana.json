    },
    {
      "id": 2,
      "text": "The town’s post office opened on January 20, 1859, originally called “Grover Town” before adopting the current spelling in 1893.",
      "sourceSentenceIds": [
        5,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/grovertown_indiana"
    },
    {
      "id": 3,
      "text": "A two‑story brick school opened in 1904 after a fire destroyed the original wooden building, and it later became a state‑commissioned high school in 1916.",
      "sourceSentenceIds": [
