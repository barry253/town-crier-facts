  "facts": [
    {
      "id": 1,
      "text": "Ogden was the first permanent European settlement in Utah, originally called Fort Buenaventura.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogden%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was renamed Ogden after Hudson's Bay Company trapper Peter Skene Ogden, who hunted in the Weber Valley a generation earlier.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogden%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ogden earned the nickname “Junction City” when the Union Pacific and Central Pacific railroads met here in the early 1900s.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.ogdencity.gov/560/About-Ogden",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Snowbasin Ski Area in Ogden hosted alpine skiing events for the 2002 Winter Olympics.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogden%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ogden Union Station once handled more than 100 trains a day, making it a major freight and passenger hub.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ogden%2C_Utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ogden and Weber Rivers meet at a confluence just west of the city limits, flowing through the city from the east.",
      "sourceSentenceIds": [
