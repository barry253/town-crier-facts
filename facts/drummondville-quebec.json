  "facts": [
    {
      "id": 1,
      "text": "Drummondville was founded in June 1815 by Lieutenant-Colonel Frederick Heriot to house British soldiers and guard the Saint‑François River.",
      "sourceSentenceIds": [
        2,
        4,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/drummondville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Sir Gordon Drummond, the Lieutenant Governor of Upper Canada from 1813 to 1816.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Drummondville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Drummondville sits on the Saint‑François River in Quebec’s Centre‑du‑Québec region, east of Montreal.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/drummondville",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The town hosts the Quebec Maritimes Junior Hockey League’s Drummondville Voltigeurs, who play at Centre Marcel Dionne.",
      "sourceSentenceIds": [
        6,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drummondville",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2008, Drummondville has celebrated Festival de la Poutine, a three‑day event featuring concerts and various styles of the iconic Canadian dish.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
