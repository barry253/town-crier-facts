      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Currahee Military Museum in downtown Toccoa preserves the story of Camp Toccoa, the first U.S. paratrooper training camp featured in HBO’s Band of Brothers.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
