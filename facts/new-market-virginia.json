  "facts": [
    {
      "id": 1,
      "text": "New Market was officially founded on December 14, 1796, when the Virginia General Assembly named it after the nearby crossroads.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmarketvirginia.com/explore/page/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On May 15, 1864, the Battle of New Market unfolded here, where 257 VMI cadets charged under Confederate General John C. Pemberton.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmarketvirginia.com/explore/page/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1972, New Market earned historic district status from the Virginia Historic Landmarks Commission, preserving its 18th‑century charm.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmarketvirginia.com/explore/page/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "John Sevier, later Tennessee’s first governor, was born in New Market in 1745, linking the town to early American frontier history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Market%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "German Mennonite and Lutheran settlers first claimed New Market’s fertile valley in 1727, followed by Scots and Irish migrants.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmarketvirginia.com/explore/page/history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, the New Market Battlefield State Historical Park commemorates the 1864 clash and offers visitors a walk through Civil War history.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Market%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    }
