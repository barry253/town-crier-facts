  "facts": [
    {
      "id": 1,
      "text": "Arcadia was established after the 1889 Land Rush by cotton farmers who named the town after the Greek region of Arcadia.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The soil near the Deep Fork River made Arcadia a thriving agricultural community for cotton production in the early twentieth century.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Tulon's Drugstore is a surviving local building that is now listed in the National Register of Historic Places.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "The Missouri, Kansas and Texas Railroad constructed a line passing immediately south of Arcadia between 1902 and 1903.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arcadia%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Arcadia is located fifteen miles north of Oklahoma City along the path of Historic Route 66.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
