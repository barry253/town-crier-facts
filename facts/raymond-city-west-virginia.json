  "facts": [
    {
      "id": 1,
      "text": "Raymond City is an unincorporated community in Putnam County situated at the confluence of the Pocatalico and Kanawha rivers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/raymond_city_west_virginia"
    },
    {
      "id": 2,
      "text": "European-American exploration of the Raymond City area began in the late 18th century following the discovery of coal deposits in 1798.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/raymond_city_west_virginia"
    },
    {
      "id": 3,
      "text": "Raymond City developed as a post village along the Ohio Central rail lines to facilitate the transport of coal and goods.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/raymond_city_west_virginia"
    },
    {
      "id": 4,
      "text": "Records indicate that the post office in Raymond City first opened its doors in 1865.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/wv/raymond-city-xx-putnam-profile.htm"
    },
    {
      "id": 5,
      "text": "Raymond City sits at an elevation of 600 feet above sea level.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/wv/raymond-city-xx-putnam-profile.htm"
    },
    {
      "id": 6,
      "text": "The local topography of Raymond City contributes to variable weather patterns and a temperate profile compared to more mountainous regions of West Virginia.",
