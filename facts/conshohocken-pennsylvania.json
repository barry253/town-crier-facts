  "facts": [
    {
      "id": 1,
      "text": "Conshohocken’s name comes from the Unami language, meaning “pleasant valley” or “big‑trough ground place” describing the river bend.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conshohocken%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded after the Schuylkill Canal opened, Conshohocken was incorporated as a borough in 1850.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conshohocken%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century Conshohocken boasted a tire plant, steel and iron mill, boiler factory, and textile mills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conshohocken%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After industry waned, the borough reinvented itself as a riverfront hub of commercial and residential development.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conshohocken%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Railroad tracks line both banks of the Schuylkill, carrying Norfolk Southern freight and SEPTA commuter trains.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Conshohocken%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Conshohocken Historical Society began in 1963 inside a local drugstore, founded by citizens who wanted to preserve the town’s past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
