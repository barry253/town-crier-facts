      "id": 1,
      "text": "Takatsuki first appeared in the 14th‑century Kamakura period as a manor listed under Kasuga Shrine in Nara.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
