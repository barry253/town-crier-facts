  "facts": [
    {
      "id": 1,
      "text": "Ida's origins trace back to pre-1840 settlements, with significant growth after the Civil War as migrants arrived by ox-drawn wagons and steamboats.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ida_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the TS&N Railroad and the opening of a post office in 1897 formalized Ida, connecting it to broader commerce and communication.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ida_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1909, Standard Oil built a pumping station in Ida to transport oil from Oklahoma fields, turning the village into a boomtown with banks, cafes, stores, and dancehall.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ida_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ida Methodist Church, built in 1905, still serves the community today, though its bell tower was removed.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ida%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Reynolds Building on East Magnolia Avenue, once the post office from 1923 to 1962, became the Ida Museum in 1997.",
      "sourceSentenceIds": [
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ida%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ida was incorporated as a village in 1967 under Louisiana law, a milestone that formalized its municipal status.",
      "sourceSentenceIds": [
        14,
