  "facts": [
    {
      "id": 1,
      "text": "Saltsburg was named after its thriving salt industry, with early settlers choosing the name to reflect the abundant salt wells.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
