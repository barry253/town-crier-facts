  "facts": [
    {
      "id": 1,
      "text": "West Homestead's historic district spans Homestead, Munhall, and West Homestead and was listed on NRHP in 1990.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thenewpittsburghexposition.org/directory-content/homestead-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Homestead Pennsylvania Railroad Station, an independent NRHP entry, sits within the historic enclave.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thenewpittsburghexposition.org/directory-content/homestead-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1892 Homestead Strike, pitting Henry Clay Frick against the Amalgamated Association, is a defining moment in the borough’s history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/southwestern-pennsylvania/allegheny/homestead",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mesta Mansion, built by George Mesta in 1900 and later expanded for Perle Mesta, anchors the district and is on the National Register.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thenewpittsburghexposition.org/directory-content/homestead-historic-district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Homestead’s Eighth Avenue is a tree‑lined boulevard of Victorian shops and sits on the National Register, surrounded by the largest group of ethnic churches on the list.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Homestead%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Bulgarian Macedonian National Educational and Cultural Center on West Eighth Avenue has served as a cultural hub for Bulgarian and Macedonian communities since 1935.",
      "sourceSentenceIds": [
