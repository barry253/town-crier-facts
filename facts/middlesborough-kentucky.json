  "facts": [
    {
      "id": 1,
      "text": "Middlesboro was founded in 1886 by Alexander Arthur, who envisioned it as the 'Pittsburgh of the Appalachians'.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/middlesborough-kentucky"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened September 14, 1888, named Middlesborough after the English town, later shortened to Middlesboro.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesboro%2C_Kentucky"
    },
    {
      "id": 3,
      "text": "A historic downtown walk spans two miles, marked by a red dotted line and temporary markers that tell forgotten local stories.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/middlesborough-kentucky"
    },
    {
      "id": 4,
      "text": "The Powell's Valley Railroad began construction in 1888 but was replaced by the Knoxville, Cumberland Gap & Louisville after a costly tunnel was built.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesboro%2C_Kentucky"
    },
    {
      "id": 5,
      "text": "Discover Downtown Middlesboro, founded in 2004, has restored Fountain Square, added murals, and created a farmer’s market to revitalize the historic core.",
      "sourceSentenceIds": [
        23,
        24,
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Middlesboro%2C_Kentucky"
    },
    {
      "id": 6,
      "text": "The Bell County Historical Society, housed in a former Carnegie Library, preserves archives and hosts exhibits about Middlesboro’s history.",
