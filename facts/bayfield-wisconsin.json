  "facts": [
    {
      "id": 1,
      "text": "Bayfield was named in 1856 for Henry Bayfield, a British Royal Topographic Engineer who explored the region in the early 1820s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayfield%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Bayfield serves as the main gateway to the Apostle Islands National Lakeshore, a group of twenty-one islands in Lake Superior.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayfield%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "A ferry links Bayfield with La Pointe, a community on Madeline Island, which is the largest of the Apostle Islands.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayfield%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Formerly a center for lumbering and commercial fishing, Bayfield is now known as the Gateway to the Apostle Islands.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayfield%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The first Catholic church in Bayfield was built in 1860, and mass was held in both English and Ojibwe languages.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bayfield%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Nathan Van Cleave, a composer for television shows including The Twilight Zone, was born in Bayfield.",
