      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Asa Shoemaker is believed to be the first settler, arriving in 1837 at Big Spring Creek in what is now Columbia Township.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
