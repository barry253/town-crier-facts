  "facts": [
    {
      "id": 1,
      "text": "Bertha was named after early settler Bertha Ristau, the wife of John Ristau who helped found the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
