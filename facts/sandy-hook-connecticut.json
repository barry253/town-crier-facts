  "facts": [
    {
      "id": 1,
      "text": "Sandy Hook, founded in 1711, began as a cluster of sawmills and gristmills that harnessed the Pootatuck River for timber.",
      "sourceSentenceIds": [
        5,
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Hook%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Charles Goodyear accidentally discovered vulcanization in 1839 while living on Glen Road north of Sandy Hook, sparking the American rubber industry.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://sandyhookvillage.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Goodyear Rubber Packing Factory, built within 15 years of Goodyear’s discovery, became a cornerstone of Sandy Hook’s industrial growth.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Hook%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rocky Glen State Park, located in Sandy Hook, preserves the very glen where Goodyear worked, offering hiking and scenic views.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sandyhookvillage.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Newtown United Methodist Church, originally established in the 1850s, was relocated to Sandy Hook’s center in 1972.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandy_Hook%2C_Connecticut",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Community revitalization efforts, led by the S.H.O.P. initiative, have turned Sandy Hook into a vibrant, connected village with strong arts and culture.",
