      ],
      "source": "https://en.wikipedia.org/wiki/Chatswood%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chatswood Library covers 5,000 m² and includes a 1,000‑seat concert hall and a 500‑seat theatre.",
      "sourceSentenceIds": [
        12
