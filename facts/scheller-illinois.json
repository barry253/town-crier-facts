  "facts": [
    {
      "id": 1,
      "text": "German immigrants George and Gertrude Scheller founded the area in the late 1850s; the village was officially platted in October 1892 with Main and Scheller Streets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scheller_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Named after the prominent Scheller family, the community sits about a mile east of Bald Hill.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scheller_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the Wabash, Chester and Western Railroad in 1895 turned Scheller into a key rural hub for shipping farm produce, poultry, grain, and timber.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/scheller_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After automobiles rose, the depot burned in 1913 and businesses closed, leaving Scheller a quiet residential area with an 1870 log corn crib still standing.",
      "sourceSentenceIds": [
        4
      ],
