  "facts": [
    {
      "id": 1,
      "text": "Fairfield was founded in 1856 by clipper ship captain Robert H. Waterman, who named the town after his hometown in Connecticut.",
      "sourceSentenceIds": [
        2,
        3,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1903 Fairfield became an incorporated city, having served as Solano County’s seat since 1858 after winning the race against Benicia.",
      "sourceSentenceIds": [
        26,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city hosts Travis Air Force Base, one of the largest military installations in the Bay Area, alongside the headquarters of Jelly Belly.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fairfield’s Jelly Belly factory at 1 Jelly Belly Lane produces the iconic candy beans and displays a permanent bean art collection for visitors.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bestattractions.org/usa/california/fairfield-ca-local-facts/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Located north of Suisun Bay, Fairfield sits within the California Coastal Ranges and borders the world’s largest saltwater marsh, Suisun Marsh.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfield%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city’s historic landmarks include a working candy factory, a major Air Force base, restored courthouses, and volcanic parks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
