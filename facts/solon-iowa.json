  "facts": [
    {
      "id": 1,
      "text": "Solon is named after the ancient Athenian statesman, lawmaker, and lyric poet Solon.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solon%2C_Iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Solon was first platted in 1842 by John West, who laid out the initial town plat.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/solon_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Solon's early growth featured a 1841 school, a 1873 flouring and saw mill, and the 1876 arrival of the Burlington, Cedar Rapids and Northern Railway.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/solon_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Saints Peter and Paul Catholic Church, built 1916‑17, now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Solon%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Solon High School’s Spartans mascot nods to the ancient rivalry between Athens and Sparta.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/solon_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
