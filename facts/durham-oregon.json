  "facts": [
    {
      "id": 1,
      "text": "Durham is named after early Oregon pioneer Albert Alonzo Durham, who operated saw and flour mills along Fanno Creek.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://durham-oregon.us/durham-history-and-photos/"
    },
    {
      "id": 2,
      "text": "The site of Durham was originally known as Durhams Mills and is located along the Boones Ferry Road to Portland.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Durham%2C_Oregon"
    },
    {
      "id": 3,
      "text": "In 1908, the Oregon Electric Railway established a stop called Durham, which helped the area become known by that name.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://durham-oregon.us/durham-history-and-photos/"
    },
    {
      "id": 4,
      "text": "Forty-foot timbers were once loaded onto trains at the Durham station and shipped all the way to California.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://durham-oregon.us/durham-history-and-photos/"
    },
    {
      "id": 5,
      "text": "The Tualatin River forms part of the western boundary of Durham, where you can also find Durham City Park.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Durham%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Trees have always been a prominent and defining part of the history of Durham.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://durham-oregon.us/durham-history-and-photos/"
    }
  ]
