      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The town sits near the junction of State Routes 339 and 676, close to Wolf Creek that feeds the Muskingum River.",
      "sourceSentenceIds": [
        5,
        17,
        18,
        19
      ],
      "sourceLabels": [
