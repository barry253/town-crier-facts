      "id": 1,
      "text": "Watertown is an unincorporated community in southwestern Watertown Township, Washington County, Ohio.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Watertown%2C_Ohio",
