      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Kawabata Literature Memorial Hall, 15‑minute walk from Hankyu Ibaraki‑shi station, honors author Kawabata Yasunari with a dedicated collection.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
