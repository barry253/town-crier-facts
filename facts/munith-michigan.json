  "facts": [
    {
      "id": 1,
      "text": "Munith grew around a Grand Trunk Western Railroad depot that opened in the early 1800s, turning the spot into a bustling grain hub by 1884.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.stockbridgeareachamber.com/munith",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors early settler Henry Hurd, who opened the first post office in 1839 and named the township after his hometown of Henrietta, New York.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.stockbridgeareachamber.com/munith",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Munith’s historic Main Street once housed a three‑story store with a dance hall on the top floor, a feature that drew locals for social gatherings in the late 1800s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/munith-michigan/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1913 a fire razed five businesses, including the bank, but the community rebuilt with a new hardware store and slaughterhouse that same year.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/munith-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Munith’s cemetery, known locally as Pixley or Thurston Cemetery, sits just north of town and reflects the early settlers’ burial traditions.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/munith-michigan/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s two churches—Munith United Methodist on Main Street and Jeruel Baptist on M‑106—have served residents since the 19th century.",
      "sourceSentenceIds": [
        12
      ],
