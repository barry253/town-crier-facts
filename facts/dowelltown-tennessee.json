  "facts": [
    {
      "id": 1,
      "text": "Dowelltown takes its name from Frank Dowell, a mid‑19th‑century landowner who married into the early Gray family and lived nearby.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dowelltown_tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1797 Marylander Adam Dale arrived, founding nearby Liberty by 1807 and paving early roads that drew about forty Maryland families around 1800.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dowelltown_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the war, a flour mill powered by Big Spring appeared in 1866, followed by Allan Wright’s Dowelltown Woolen Factory in 1868 and a general store by 1869.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dowelltown_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dowelltown was officially incorporated on April 15 1949 through a private act of Tennessee, establishing its corporate limits and governance.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dowelltown_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 1951 completion of Center Hill Dam on the Caney Fork River upstream of Dowelltown provided flood control, stabilizing local agriculture after the war.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dowelltown_tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "On April 3 1974 a tornado struck Dowelltown, destroying eighteen homes, the school, stores, bank, and post office, yet spared lives.",
      "sourceSentenceIds": [
