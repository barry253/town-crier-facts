    {
      "id": 1,
      "text": "Dixie Inn got its name from a local inn that opened in the early 1900s, anchoring the town’s identity.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/la/dixie-inn/overview",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Dixie Inn resort, built in the 1920s along Dorcheat Bayou, has been a social hub since the early 20th century.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/la/dixie-inn/overview",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area that is now Dixie Inn was once part of the Caddo Confederacy’s traditional territory before European arrival.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/la/dixie-inn/overview",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Interstate 20, built in the 1960s and 1970s, runs just south of Dixie Inn, improving regional connectivity.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/la/dixie-inn/overview",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dixie Inn’s economy thrives on tourism tied to Lake Bistineau, with local bait shops, marinas, and Cajun‑style restaurants drawing visitors.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/la/dixie-inn/overview",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dixie Inn was officially incorporated in 1956, formalizing the community that had grown around the historic inn.",
