  "facts": [
    {
      "id": 1,
      "text": "Granite was named for its proximity to the quarries that provided the stone blocks for the Salt Lake Temple.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://onlineutah.us/granitehistory.shtml"
    },
    {
      "id": 2,
      "text": "The Temple Quarry in Granite began operations in 1859 to provide stone for the Salt Lake Temple and Utah State Capitol.",
      "sourceSentenceIds": [
        10,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite%2C_Utah"
    },
    {
      "id": 3,
      "text": "Granite served as a historic hiding place for LDS Church leaders who were avoiding U.S. Marshals during the time of polygamy.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.granitecommunitycouncil.com/granite-history"
    },
    {
      "id": 4,
      "text": "Granite is a unique community located at the mouth of Little Cottonwood Canyon that is over 150 years old.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.granitecommunitycouncil.com/granite-history"
    },
    {
      "id": 5,
      "text": "The Temple Quarry in Granite reopened in the 1990s to provide stone for the LDS Conference Center.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.granitecommunitycouncil.com/granite-history"
    },
    {
      "id": 6,
      "text": "An LDS chapel built in Granite in 1904 still stands today and features a foundation made of Temple Quarry granite.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.granitecommunitycouncil.com/granite-history"
    }
  ]
}
