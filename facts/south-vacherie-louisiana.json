  "facts": [
    {
      "id": 1,
      "text": "South Vacherie is nicknamed 'Back Vacherie,' a Creole term meaning 'in the Back,' because it sits inland away from the Mississippi.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_vacherie_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s economy once thrived on sugarcane refining, pioneered by 19th‑century figure Valcour Aime, and on unique Perique tobacco cultivation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_vacherie_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Vacherie sits on a low‑lying Mississippi River floodplain, making it highly vulnerable to river overflows, heavy rains, and Gulf storm surges.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/south_vacherie_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oak Alley Plantation, famous for its oak‑lined alley, lies just north of South Vacherie and is a popular historic landmark.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/louisiana_south-vacherie",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Vacherie is part of Louisiana’s historic River Road region, a corridor of antebellum plantations that once lined the Mississippi.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
