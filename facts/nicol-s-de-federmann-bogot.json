  "facts": [
    {
      "id": 1,
      "text": "Nicolás de Federmann, a German conquistador, lends his name to this Bogotá neighborhood after helping refound the city in 1539.",
      "sourceSentenceIds": [
        3,
        5,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nikolaus_Federmann"
    },
    {
      "id": 2,
      "text": "The neighborhood is served by TransMilenio’s Coliseo and Campín stations, linking it to Bogotá’s rapid‑transit network.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://en-academic.com/dic.nsf/enwiki/6560073"
    },
    {
      "id": 3,
      "text": "In 1529 the Welser family sent Federmann to Venezuela, where he transported settlers and miners to Coro.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nikolaus_Federmann"
    },
    {
      "id": 4,
      "text": "Federmann’s 1530 expedition into the Orinoco basin, seeking the “South Sea,” was unauthorized and earned him a four‑year banishment.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nikolaus_Federmann"
    },
    {
      "id": 5,
      "text": "A pedestrian statue of Federmann stands in Rio Hacha’s Parque de los Cañones, one of the few surviving conquistador monuments.",
      "sourceSentenceIds": [
