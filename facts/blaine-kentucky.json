      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Blaine post office has been in operation since at least May 10, 1828, with Neri Swetnam as its first postmaster.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
