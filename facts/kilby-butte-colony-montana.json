  "facts": [
    {
      "id": 1,
      "text": "Kilby Butte Colony was founded in 1992 as a division of Fords Creek Hutterite Colony, establishing a Dariusleut community in central Montana.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kilby_butte_colony_montana"
    },
    {
      "id": 2,
      "text": "The colony sits atop Mesozoic and Paleozoic sandstones and shales, whose erosion shapes the fertile loamy soils of the surrounding grasslands.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kilby_butte_colony_montana"
    },
    {
      "id": 3,
      "text": "Kilby Butte Colony lies nine miles east of Roundup along U.S. Route 12, just north of the Musselshell River.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kilby_Butte_Colony%2C_Montana"
    },
    {
      "id": 4,
      "text": "A few miles north of the colony, Kilby Butte rises to 3,527 feet, offering a prominent landmark for the prairie landscape.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kilby_butte_colony_montana"
    },
    {
      "id": 5,
      "text": "The semi‑arid continental climate brings cold winters with lows around 12°F and warm summers averaging 87°F, giving a 120‑140 day growing season.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kilby_butte_colony_montana"
    },
    {
      "id": 6,
      "text": "Beyond traditional farming, the colony operates a state‑inspected meat‑processing plant and plans a carpentry business to diversify its communal enterprises.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kilby_butte_colony_montana"
