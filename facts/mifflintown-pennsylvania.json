  "facts": [
    {
      "id": 1,
      "text": "John Harris founded Mifflintown in 1774 along the Juniata River, where he first settled at McClellan Ferry.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mifflintownborough.com/mifflintown-borough/history/"
    },
    {
      "id": 2,
      "text": "Harris named the town Mifflintown after the county seat moved west to Lewistown, keeping the name for his settlement.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mifflintownborough.com/mifflintown-borough/history/"
    },
    {
      "id": 3,
      "text": "The borough officially incorporated on March 6, 1833, cementing its status as a local center of governance.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mifflintownborough.com/mifflintown-borough/history/"
    },
    {
      "id": 4,
      "text": "In 1831, a courthouse was erected on a square block John Harris left for the county, becoming the heart of Mifflintown.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mifflintownborough.com/mifflintown-borough/history/"
    },
    {
      "id": 5,
      "text": "Today the circa 1875 Juniata County Courthouse still houses county offices and artifacts, anchoring the town’s historic core.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitpa.com/explore/regions/alleghenies/mifflintown/"
    },
    {
      "id": 6,
      "text": "Mifflintown sits on the banks of the Juniata River, a key waterway that once powered the town’s early trade routes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mifflintownborough.com/mifflintown-borough/history/"
    }
  ]
