  "facts": [
    {
      "id": 1,
      "text": "Willard‑Hay takes its name from the Frances Willard and John Hay elementary schools that once stood inside its borders.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willard-Hay%2C_Minneapolis",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2017 the city declared Willard‑Hay a historic district, honoring its rich Jewish heritage that began in the 1910s.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willard-Hay%2C_Minneapolis",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood sits just west of Theodore Wirth Park, giving residents direct access to Minneapolis’s largest park.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mplswithlove.com/neighborhoods/willard-hay",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Willard‑Hay is often called Willard‑Homewood, a nod to the two communities that merged into one neighborhood.",
      "sourceSentenceIds": [
        15,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willard-Hay%2C_Minneapolis",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Early 20th‑century settlers were mainly Scandinavian and German immigrants who built modest grid‑street homes between Penn Avenue and the park.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mplswithlove.com/neighborhoods/willard-hay",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Homewood Historic District, part of Willard‑Hay, is bounded by Plymouth, Penn, Oak Park, and Xerxes Avenues.",
      "sourceSentenceIds": [
