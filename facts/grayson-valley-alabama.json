  "facts": [
    {
      "id": 1,
      "text": "Grayson Valley earned its name from the Grayson Lumber Company, a Birmingham‑based firm owned by the wealthy Grayson family in the mid‑20th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/grayson_valley_alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s early history traces back to Alabama’s lumber boom of the late 1800s and early 1900s, when yellow pine demand spurred massive logging.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/grayson_valley_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After World War II, Grayson Valley evolved from timberlands and farmland into a growing residential community, shaped by the Grayson Lumber Company’s extensive land holdings.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/grayson_valley_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "As an unincorporated community, Grayson Valley falls under Jefferson County’s jurisdiction rather than having its own municipal government.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/grayson_valley_alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Historical records for the area include railroad schedules and shipping guides that charted routes and commerce during the early 20th century.",
      "sourceSentenceIds": [
        1
      ],
