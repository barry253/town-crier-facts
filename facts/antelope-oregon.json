  "facts": [
    {
      "id": 1,
      "text": "Antelope was named around 1862 for the plentiful herds of pronghorn antelopes that roamed the area freely.",
      "sourceSentenceIds": [
        5,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitoregon.com/cities/antelope-oregon/"
    },
    {
      "id": 2,
      "text": "Antelope began in the mid-nineteenth century as a station along the wagon road connecting The Dalles with gold mines near Canyon City.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antelope%2C_Oregon"
    },
    {
      "id": 3,
      "text": "The city of Antelope was officially incorporated in 1901 after serving as a stage and freight wagon road stop.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Antelope%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Early residents of Antelope once published their own local newspaper known as The Antelope Republican.",
