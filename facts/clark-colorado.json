  "facts": [
    {
      "id": 1,
      "text": "In the early 1860s, German prospector Joseph Hahn struck gold on Ute lands near a bald\u2011headed mountain, sparking Clark\u2019s founding.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://murphy-larsen.com/about/a-brief-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hahn named the new post office Clark, and the town grew as a waypoint between Hahn\u2019s Peak and Steamboat Springs.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://murphy-larsen.com/about/a-brief-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clark sits just north of Steamboat Springs on County Road 129, a tiny village that once served as a mining camp beside Hahns Peak.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/clark/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The community rests at 7,260 feet above sea level, offering a high\u2011altitude backdrop for outdoor adventures.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/clark/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During winter, Clark\u2019s terrain turns into a playground for snowmobiling, cross\u2011country skiing, and snowshoeing enthusiasts.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/clark/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nearby, Steamboat Lake and Pearl Lake provide year\u2011round fishing for trout, walleye, and pike, drawing anglers to the area.",
