  "facts": [
    {
      "id": 1,
      "text": "Parkway Village was built on 429 acres of former farmland east of Oakville, bounded by Getwell, Moriah, Knight Arnold, and Perkins Roads.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Parkway_Village,_Memphis"
    },
    {
      "id": 2,
      "text": "The neighborhood was designed with schools, churches, shopping centers, and green spaces in each mile‑square to promote walkability.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Parkway_Village,_Memphis"
    },
    {
      "id": 3,
      "text": "Knight Road Elementary opened in 1959 and St. James Methodist Church followed in 1960, anchoring the community’s early civic life.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Parkway_Village,_Memphis"
    },
    {
      "id": 4,
      "text": "White flight in the 1980s and 1990s left Parkway Village with a shrinking tax base, causing property values to stagnate and schools to receive low state ratings.",
      "sourceSentenceIds": [
        2,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Parkway_Village,_Memphis"
    },
    {
      "id": 5,
      "text": "In 1998, the Memphis Police Department opened a new substation in Parkway Village to curb rising crime, though it declined to share historical crime data.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
