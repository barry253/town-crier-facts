  "facts": [
    {
      "id": 1,
      "text": "Sammons Point first incorporated on March 21, 2006, to stop the Waste Management landfill from expanding into the area.",
      "sourceSentenceIds": [
        12,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammons_Point%2C_Illinois"
    },
    {
      "id": 2,
      "text": "After a brief disincorporation on August 8, 2007, the village reappeared on February 5, 2008.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammons_Point%2C_Illinois"
    },
    {
      "id": 3,
      "text": "The 2006 incorporation vote saw 82 residents in favor and 41 opposed, a 66.7 percent turnout.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammons_Point%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Reincorporation in 2008 produced 87 votes for the village and 65 against, with 76 percent of voters participating.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sammons_Point%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Sammons Point ranks among Illinois' smallest incorporated places, a testament to residents' commitment to local governance.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bradleyillinois.com/towns/sammons-point.html"
    },
    {
