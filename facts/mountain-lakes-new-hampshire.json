      "id": 1,
      "text": "Mountain Lakes sits on two lakes built on Waterman Brook, a tributary of the Wild Ammonoosuc River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
