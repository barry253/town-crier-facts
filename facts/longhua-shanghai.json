    {
      "id": 1,
      "text": "Longhua Historical and Cultural Block spans 45 hectares, housing cemeteries, temples, former military factories and commercial facilities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-HeritageZones/20240621/1045b154b8f34b64977155a8d9b67582.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Longhua's strategic position along the Huangpu River and Shanghai‑Hangzhou railway made it a military hub with a Qing‑era gunpowder factory and Beiyang offices.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-HeritageZones/20240621/1045b154b8f34b64977155a8d9b67582.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Longhua Temple, dating to the Three Kingdoms period, is one of Shanghai's oldest Buddhist temples.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-HeritageZones/20240621/1045b154b8f34b64977155a8d9b67582.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Millennium Soaring Pagoda, built over 1,750 years ago, is the oldest surviving pagoda in Shanghai.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://baike.baidu.com/en/item/Longhua%20Tourist%20City/943631",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Longhua Martyrs Memorial Hall commemorates revolutionary sacrifices from the 1927 April 12th Incident.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-HeritageZones/20240621/1045b154b8f34b64977155a8d9b67582.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Longhua Airport began operations in late 1922 under the Beiyang government and later hosted Imperial Japanese Airways flights to Fukuoka and Taipei.",
