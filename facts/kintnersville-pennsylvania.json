        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/kintnersville-pennsylvania.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village nestles in the deep, picturesque Gallows Run valley, at the head of the scenic Narrows.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/kintnersville-pennsylvania.htm",
