      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "By 1860, Kintnersville boasted twenty dwelling houses, a hotel, a store, a lumber factory, and a large flouring mill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/kintnersville-pennsylvania.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Major Hugh Kintner, a native, served as the last commander of the Washington Light Horse before it disbanded in 1861.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniagenealogy.org/bucks/kintnersville-pennsylvania.htm",
