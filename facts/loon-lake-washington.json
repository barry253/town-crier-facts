  "facts": [
    {
      "id": 1,
      "text": "Loon Lake sits on the northern shore of the lake that shares its name, about five miles east of Springdale.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Loon_Lake%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic schoolhouse, built in 1906, now houses the Loon Lake Historical Society museum.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/33582",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1992, the society preserves the area’s heritage and offers a research library with original documents.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/33582",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum showcases artifacts, photographs, and records that trace early settlers, logging, and the town’s growth.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/33582",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Community events, from lectures to workshops, are organized yearly by the society to keep local history alive.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/33582",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Old Schoolhouse, the society’s home, often hosts family reunions and community gatherings in its historic setting.",
      "sourceSentenceIds": [
        22
      ],
