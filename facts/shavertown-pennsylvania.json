  "facts": [
    {
      "id": 1,
      "text": "Shavertown is named for early settler Philip Shaver.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shavertown%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Philip Shaver purchased the land that became Shavertown in 1813 from William Trucks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shavertown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Philip and his sons built a sawmill on Toby Creek in 1815, near Prince of Peace Church.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shavertown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1816 he donated land for the first Back Mountain school, a one‑room log cabin that now houses the Back Mountain Memorial Library.",
      "sourceSentenceIds": [
        21,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shavertown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits roughly 7 miles northwest of Wilkes‑Barre and 24 miles southwest of Scranton.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shavertown%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Philip Shaver’s headstone marks the end of Shaver Cemetery, a historic burial site in the town.",
      "sourceSentenceIds": [
        27
      ],
