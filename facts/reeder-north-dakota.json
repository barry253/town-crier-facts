    },
    {
      "id": 2,
      "text": "Reeder was founded in 1907 as a station on the Chicago, Milwaukee, St. line, marking the start of a prairie settlement.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2",
