  "facts": [
    {
      "id": 1,
      "text": "Seven Hills takes its name from the seven rolling hills that shape its landscape, a nod to the area's natural topography.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nevadahenderson.com/what-is-seven-hills-a-luxury-master-planned-community/"
    },
    {
      "id": 2,
      "text": "The community's elevation ranges from about 2,400 to 2,611 feet, giving residents panoramic views of the basin and range province.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Seven_Hills,_Henderson,_Nevada"
    },
    {
      "id": 3,
      "text": "In the mid‑1980s, Japan‑based Cosmo World Corporation first proposed a large‑scale residential project called Sky Harbor Ranch on the site.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Seven_Hills,_Henderson,_Nevada"
    },
    {
      "id": 4,
      "text": "The Sky Harbor Ranch plan was abandoned in 1991 when Cosmo World filed for bankruptcy amid the early 1990s recession.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Seven_Hills,_Henderson,_Nevada"
    },
    {
      "id": 5,
      "text": "Seven Hills is home to the Rio Secco Golf Club, a championship course that attracts golfers from across the region.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Seven_Hills%2C_Henderson%2C_Nevada"
    },
    {
      "id": 6,
      "text": "After Forest City Enterprises and American Nevada Corporation partnered in 1996, development accelerated and the community began to take shape.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
