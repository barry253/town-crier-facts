  "facts": [
    {
      "id": 1,
      "text": "Cathedral Park’s name comes from the Gothic‑style arches of Johns Bridge, which look like cathedral arches.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cathedral_Park%2C_Portland%2C_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park’s only steel suspension bridge, Johns Bridge, is Portland’s sole steel suspension bridge and a designated historical landmark.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://traveloregon.com/things-to-do/destinations/parks-forests-wildlife-areas/cathedral-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1980, the Cathedral Park Committee sealed a time capsule with Mt. St. Helens ash into the Wall of History in the Memorial Garden.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portland.gov/parks/cathedral-park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After eight years of community fundraising and state, county, and city funding, the park was officially dedicated on May 3, 1980.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portland.gov/parks/cathedral-park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cathedral Park sits on Portland’s North Portland peninsula, east of the Willamette River, connecting to Linnton and Northwest Industrial via Johns Bridge.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cathedral_Park%2C_Portland%2C_Oregon",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The park’s 21.85‑acre site, acquired in 1968, has been steeped in history since its early days as part of the original City of St. Johns.",
      "sourceSentenceIds": [
        7
      ],
