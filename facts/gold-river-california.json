  "facts": [
    {
      "id": 1,
      "text": "Gold River earned its name from its proximity to the American River, not from any gold mining that ever took place there.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_gold-river"
    },
    {
      "id": 2,
      "text": "The city was incorporated in 1989 as a master‑planned community, making it one of California’s youngest incorporated cities.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/california_gold-river"
    },
    {
      "id": 3,
      "text": "Geographically, Gold River sits between Rancho Cordova to the south and west, Folsom to the east, and the American River to the north.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_River%2C_California"
    },
    {
      "id": 4,
      "text": "The Gold River Community Association manages 25 separate villages that together form the planned development.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_River%2C_California"
    },
    {
      "id": 5,
      "text": "Local families are served by the Gold River Discovery Center, a K‑8 school that is part of the community’s educational offerings.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gold_River%2C_California"
    },
    {
      "id": 6,
      "text": "Although surrounded by Gold Rush history, Gold River itself opted out of becoming part of Rancho Cordova when it was founded.",
