  "facts": [
    {
      "id": 1,
      "text": "Avilla’s name comes from the French word 'villa', meaning a small town, a suggestion made by Judge Edwin Randall during an early naming vote.",
      "sourceSentenceIds": [
        4,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avilla_indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Noah I settled the area between 1836 and 1844, laying the groundwork for what would become Avilla.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://avillaindiana.com/town-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated in Avilla since 1846, serving the community for over a century.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avilla%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Avilla was officially incorporated as a town in 1876, marking its transition from a settlement to an incorporated municipality.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avilla%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic James Hotel, which operated as a hotel until 1948, now serves as a restaurant and stands as one of Avilla’s oldest landmarks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/avilla_indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Avilla hosts three long‑standing churches: Mary's Catholic (dedicated 1878), Immanuel Lutheran (founded 1844), and Avilla Calvary United Methodist (established 1969).",
