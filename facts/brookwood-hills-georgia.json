  "facts": [
    {
      "id": 1,
      "text": "Benjamin Franklin Burdett and his son Arthur founded Brookwood Hills in the early 1920s on the Battlefield of Peachtree Creek.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookwood_Hills"
    },
    {
      "id": 2,
      "text": "Brookwood Hills streets were built to follow the hilly terrain instead of the grid form popular at the time.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookwood_Hills"
    },
    {
      "id": 3,
      "text": "Oak saplings planted during the founding of Brookwood Hills now stand tall as a trademark quality of the neighborhood.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookwood_Hills"
    },
    {
      "id": 4,
      "text": "Brookwood Hills is now registered as a historic district, preserving the area developed by the Burdett family.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookwood_Hills"
    },
    {
      "id": 5,
      "text": "The Brookwood Hills swim team uses a bullfrog as their mascot and competes in the Atlanta Swim Association league.",
      "sourceSentenceIds": [
