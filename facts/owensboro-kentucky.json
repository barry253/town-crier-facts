      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s riverfront park, Smothers Park, honors frontiersman William Smeathers, the first European descendant to settle there in 1797.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
