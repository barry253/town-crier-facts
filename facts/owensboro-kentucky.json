      ],
      "source": "https://en.wikipedia.org/wiki/Owensboro%2C_Kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kentucky Electrical Lamp Company, founded in 1899, produced light bulbs that lit the first night Major League Baseball game in 1935.",
