  "facts": [
    {
      "id": 1,
      "text": "Salford sits at the crossroads of Salford Street, Salford Station Road, and Old Church Road, just east of the Perkiomen Creek.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Salford%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "First organized in 1727, Salford Township once spanned more than 30,000 acres before splitting into Lower, Upper, Marlborough, and Franconia.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://salfordtownship.com/p-87-Salford-Township-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1892 the eastern district of the original Salford separated and was renamed Salford, a change that became permanent that same year.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://salfordtownship.com/p-87-Salford-Township-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Landis Homestead in Salford Township earned a spot on the National Register of Historic Places in 1986.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alchetron.com/Salford-Township%2C-Montgomery-County%2C-Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Perkiomen Creek drains Salford Township, flowing southeast into the Schuylkill River.",
