      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kiefer%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Kiefer is home to an extensive residence known to locals as the Kiefer Castle, built to resemble a fairy-tale castle.",
      "sourceSentenceIds": [
