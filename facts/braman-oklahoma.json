  "facts": [
    {
      "id": 1,
      "text": "Braman was named for railroad developer Dwight Braman when its post office was first established in April 1898.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Braman%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Braman emerged as a settlement in the former Cherokee Outlet following the land run of September 16, 1893.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/braman_oklahoma"
    },
    {
      "id": 3,
      "text": "The town of Braman officially incorporated on January 9, 1899, located five miles inside the Kansas-Oklahoma state line.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Braman%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Early homesteading in the Braman area focused on agriculture, particularly wheat farming, to support the growing community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/braman_oklahoma"
    },
    {
      "id": 5,
      "text": "Braman has remained an agricultural center since its early days, supporting the region with grain elevators and blacksmith shops.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Braman%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Braman is renovating an unused building into a multipurpose community center and storm shelter, set for completion by late 2024.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/braman_oklahoma"
    }
