  "facts": [
    {
      "id": 1,
      "text": "Ahtanum gets its name from a Yakama word meaning 'place of much camas,' the root vegetable once abundant here.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/washington_ahtanum",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 75,000‑acre Ahtanum State Forest is a working forest that funds local schools, prisons, and universities through timber and other revenues.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dnr.wa.gov/forest-and-trust-lands/ahtanum-state-forest",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Within the forest, visitors can camp, hike, ride off‑road vehicles, and even hunt, making it a hub for outdoor enthusiasts.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dnr.wa.gov/forest-and-trust-lands/ahtanum-state-forest",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Green Dot Roads in the forest stay open for both regular vehicles and off‑road riders, offering wide‑open trails.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dnr.wa.gov/forest-and-trust-lands/ahtanum-state-forest",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ahtanum Campground is closed for flood repairs but is expected to reopen in early June 2026.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
