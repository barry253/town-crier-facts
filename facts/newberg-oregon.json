      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled in the Willamette Valley, Newberg is famed for its vineyards and is called “A Great Place to Grow.”.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 1",
