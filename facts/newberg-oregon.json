    {
      "id": 1,
      "text": "Newberg was named after its first postmaster, Sebastian Brutscher, a German immigrant, and became an incorporated city in 1889.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
