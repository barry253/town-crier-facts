      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "George Fox University, originally Pacific Academy founded by Quakers in 1885, now anchors Newberg’s educational scene.",
      "sourceSentenceIds": [
        2,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
