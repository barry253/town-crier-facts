    },
    {
      "id": 2,
      "text": "The name Wakpala loosely translates to creek in the Lakota language, reflecting the community's proximity to local watercourses.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
