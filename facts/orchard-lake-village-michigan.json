      ],
      "source": "https://en.wikipedia.org/wiki/Orchard_Lake_Village%2C_Michigan",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Orchard Lake Village is home to St. Mary's Preparatory, a private Catholic school that once housed the Michigan Military Academy.",
      "sourceSentenceIds": [
