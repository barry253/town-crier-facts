  "facts": [
    {
      "id": 1,
      "text": "Abbeville was founded in 1823 and named after the Creek expression “Yatta Atta,” meaning “reflections of Dogwood trees on the creek.”.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofabbeville.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town celebrates spring with the Yatta Abba Festival, featuring food, art, and children’s activities, honoring its dogwood heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofabbeville.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Abbeville became the county seat of Henry County in 1833, replacing Columbia, and was formally incorporated in 1853.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Abbeville%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Abbeville Methodist Church, built in 1896, stands as one of the town’s oldest surviving structures.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/abbeville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Actress Tallulah Bankhead, a stage and screen star, lived in Abbeville for a brief period, adding a touch of Hollywood history to the town.",
      "sourceSentenceIds": [
        4
      ],
