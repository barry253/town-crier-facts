      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://murrayharbour.ca/community/history/"
    },
    {
      "id": 2,
      "text": "The community’s waterfront covers 3.89 km² and supports a fishing industry centered on lobster and scallops.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
