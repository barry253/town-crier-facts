  "facts": [
    {
      "id": 1,
      "text": "Kőbánya’s name means \"stone quarry,\" reflecting medieval stone extraction that supplied buildings across Budapest.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapest.city/kobanya/"
    },
    {
      "id": 2,
      "text": "The 1838 flood spurred the founding of the Drasche brick factory, turning Kőbánya into a major industrial hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapest.city/kobanya/"
    },
    {
      "id": 3,
      "text": "The Catholic church in Kőbánya, built 1891‑97, dominates the centre and is a landmark of the district.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapest.city/kobanya/"
    },
    {
      "id": 4,
      "text": "Kőbánya’s limestone mines once fed construction of the Hungarian Academy of Sciences, the University Library, and the Széchenyi Chain Bridge.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapest.city/kobanya/"
    },
    {
      "id": 5,
      "text": "The Dreher Brewery, a historic brewhouse with copper kettles, showcases Kőbánya’s long brewing tradition.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://travelhungarynow.com/surprising-sights-kobanya-budapest/"
    },
    {
      "id": 6,
      "text": "The Kőbánya‑Kispest metro terminus, part of line 3, makes the district easily reachable from downtown Budapest.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/K%C5%91b%C3%A1nya"
    }
  ]
}
