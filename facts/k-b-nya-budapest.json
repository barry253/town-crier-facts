      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After the 1838 Pest flood, the Drasche brick factory was founded, sparking Kőbánya’s industrial era.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapest.city/kobanya/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The magnificent Catholic church, built between 1891 and 1897, anchors Kőbánya’s historic center.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.budapest.city/kobanya/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stone from Kőbánya quarries helped build the Széchenyi Chain Bridge and the Hungarian Academy of Sciences.",
