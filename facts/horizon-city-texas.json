  "facts": [
    {
      "id": 1,
      "text": "Horizon City was named after the Horizon Corporation, a real‑estate developer that built the town as a planned community in the 1960s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horizon_City%2C_Texas"
    },
    {
      "id": 2,
      "text": "The Horizon Corporation sold lots across the Southwest, often sight‑unseen and without utilities, using tactics that drew federal scrutiny.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horizon_City%2C_Texas"
    },
    {
      "id": 3,
      "text": "In 1981 the Federal Trade Commission intervened, halting the Horizon Corporation’s questionable land sales.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horizon_City%2C_Texas"
    },
    {
      "id": 4,
      "text": "The town’s core grew around the intersection of Horizon Boulevard and Kenazo Street, the only successful subdivision.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horizon_City%2C_Texas"
    },
    {
      "id": 5,
      "text": "Horizon City hosts the Horizon City Museum of Art and a public library, reflecting its cultural focus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://citywiseguide.com/texas/horizon-city.html"
    },
    {
      "id": 6,
      "text": "Since 2011, the city’s economic development corporation uses sales‑tax funds to support business relocation, infrastructure, and quality‑of‑life projects.",
      "sourceSentenceIds": [
        19,
