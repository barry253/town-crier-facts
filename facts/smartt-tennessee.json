    },
    {
      "id": 2,
      "text": "During Civil War, Camp Smartt served as Confederate conscription center; units like 35th Tennessee Infantry formed there.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/smartt_tennessee"
    },
    {
      "id": 3,
      "text": "Smartt sits along State Route 55, 4.5 miles southwest of McMinnville, near Caney Fork River.",
      "sourceSentenceIds": [
