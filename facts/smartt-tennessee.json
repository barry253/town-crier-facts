  "facts": [
    {
      "id": 1,
      "text": "Smartt named after pioneer William Cheek Smartt, first Warren County sheriff 1808-1816.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/smartt_tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During Civil War, Camp Smartt served as Confederate conscription center; units like 35th Tennessee Infantry formed there.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/smartt_tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Smartt sits along State Route 55, 4.5 miles southwest of McMinnville, near Caney Fork River.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Smartt%2C_Tennessee",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "The community hosts an annual Smartt family reunion on the original farmstead, a tradition since the 19th century.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/smartt_tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Smartt’s fertile silt loam soils, such as Dickson and Mountview series, support local agriculture thanks to moderate permeability.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/smartt_tennessee",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1862, Confederate troops destroyed railroad bridges at Guest Hollow to slow Union forces, a skirmish near Smartt.",
