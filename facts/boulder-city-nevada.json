    {
      "id": 1,
      "text": "Boulder City sprang to life in 1931, built by the Bureau of Reclamation to house workers constructing the Hoover Dam.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boulder_City%2C_Nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Boulder Canyon, the very canyon that shelters the Hoover Dam.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boulder_City%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Unlike most Nevada cities, Boulder City prohibits gambling, making it one of only two towns in the state with that restriction.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Boulder_City%2C_Nevada",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Boulder City’s streets showcase distinctive 1930s architecture, a living reminder of its early construction era.",
      "sourceSentenceIds": [
