  "facts": [
    {
      "id": 1,
      "text": "Green Lane was founded in 1875, having once been part of Marlborough Township.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenlaneborough.org/about-classic/history-classic/"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from evergreen trees that overhung a lane leading to the historic Green Lane Forge.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenlaneborough.org/about-classic/history-classic/"
    },
    {
      "id": 3,
      "text": "Green Lane Forge, the earliest ironworks in the Perkiomen Valley, was built in 1733 by Thomas Mayburry.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenlaneborough.org/about-classic/history-classic/"
    },
    {
      "id": 4,
      "text": "The forge supplied charcoal to heat pig iron for forging, a key step in early American iron production.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://greenlaneborough.org/about-classic/history-classic/"
    },
    {
      "id": 5,
      "text": "Pennsylvania’s Highlands Trail, a long‑distance hiking route, passes through Green Lane, offering scenic trails year‑round.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Green_Lane%2C_Pennsylvania"
    },
    {
      "id": 6,
