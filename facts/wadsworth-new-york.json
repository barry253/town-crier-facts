  "facts": [
    {
      "id": 1,
      "text": "Wadsworth got its name from the Wadsworth family, who settled the area in 1790 as land agents after the 1797 Treaty of Big Tree.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wadsworth_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened on July 11, 1826, and by the 1840s schools like Livingston County High School, founded in 1842, served the growing community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wadsworth_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort Wadsworth, though not in the hamlet, offers sweeping views of New York Harbor and echoes the area's military heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/places/000/fort-wadsworth.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The fertile clay loam soils of Wadsworth supported a wheat boom in the 19th century, yielding 20–30 bushels per acre.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wadsworth_new_york",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Although the Genesee Valley Canal never passed through Wadsworth, its nearby sections helped farmers export wheat and dairy north to Rochester.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wadsworth_new_york",
      "category": "transport",
      "quality": "good"
    }
