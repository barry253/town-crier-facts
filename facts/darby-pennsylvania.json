  "facts": [
    {
      "id": 1,
      "text": "Darby was settled in 1682 by seven Quaker families led by abolitionist John Blunston, who later served in the Colonial Assembly.",
      "sourceSentenceIds": [
        23,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darby%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The borough’s name comes from the English city of Derby, reflecting the origin of many early settlers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darby%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Darby’s first library, the Darby Free Library, opened in 1743 and is one of the oldest libraries in the United States.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darby%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Three historic railroad stations once served Darby, including two Baltimore and Ohio lines and a Pennsylvania Railroad station now a SEPTA stop.",
      "sourceSentenceIds": [
        6,
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darby%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Darby Transportation Center today hosts SEPTA Subway–Surface Trolley Lines 11 and 13 and the Wilmington/Newark Line.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Darby%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Darby was incorporated as a borough on May 3, 1853, separating from Darby Township.",
