  "facts": [
    {
      "id": 1,
      "text": "Gwynn sits on Gwynn's Island, five miles north‑northeast of Mathews.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gwynn%2C_Virginia"
    },
    {
      "id": 2,
      "text": "Early 17th‑century settler Hugh Gwynn named the island, overlooking a Powhatan population of more than 14,000.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gwynnsislandproject.com/history"
    },
    {
      "id": 3,
      "text": "The Gwynn's Island Museum chronicles island and county history, honoring sailors and veterans.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gwynnsislandmuseum.org/"
    },
    {
      "id": 4,
      "text": "After the Civil War, many enslaved workers fled as runaways or contraband, while freed people and former enslavers lived side by side.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.gwynnsislandproject.com/history"
    },
    {
      "id": 5,
      "text": "By 1910, over twenty African American residents owned property, building a Baptist church, school, and cemetery.",
      "sourceSentenceIds": [
        26,
