      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Leitersburg sits along the Potomac River, the county’s southern border, where kayakers can paddle or boat.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
