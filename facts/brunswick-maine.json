      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bowdoin College, founded in 1794, houses the Peary‑MacMillan Arctic Museum, showcasing memorabilia from explorer Robert E. Peary.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
