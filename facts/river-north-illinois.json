    {
      "id": 1,
      "text": "River North’s Driehaus Museum, once a 1920s bank, now Chicago’s “Marble Palace,” showcases European‑style art in marble‑clad halls.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.choosechicago.com/neighborhoods/river-north/"
    },
    {
      "id": 2,
      "text": "Marina City’s twin corncobs, built in 1960, dominate River North’s skyline and symbolize Chicago’s mid‑century modernist ambition.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.choosechicago.com/neighborhoods/river-north/"
    },
    {
      "id": 3,
      "text": "The Museum of Contemporary Art, housed in River North’s MART building, hosts rotating exhibitions that push artistic boundaries.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.choosechicago.com/neighborhoods/river-north/"
    },
    {
      "id": 4,
      "text": "River North’s stretch of the Chicago Riverwalk offers pedestrians scenic river views and access to historic bridges.",
      "sourceSentenceIds": [
