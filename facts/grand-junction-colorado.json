      "id": 1,
      "text": "Grand Junction was founded in 1881 when settlers saw the fertile land at the junction of the Colorado and Gunnison rivers.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grandjunction.com/history/exploring-the-rich-history-of-grand-junction-key-moments-and-landmarks",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Denver and Rio Grande Western Railroad in the late 19th century turned Grand Junction into a regional trade hub.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grandjunction.com/history/exploring-the-rich-history-of-grand-junction-key-moments-and-landmarks",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Because of its river confluence, Grand Junction earned the nickname “River City.”.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Junction%2C_Colorado",
