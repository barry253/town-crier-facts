  "facts": [
    {
      "id": 1,
      "text": "Markham was renamed by Marshall, son of Chief Justice John Marshall, who also led the Manassas Gap Railroad in the 1850s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5157/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming Markham, the settlement was called North Point, the northernmost stop on a stage line from Culpeper.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5157/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Markham’s early mills powered by Goose Creek made it a key milling center in northwestern Fauquier County during the 19th century.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5157/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The district includes historic homes like Mountain View (c.1811) and Wolfs Crag (c.1820), showcasing early 19th‑century architecture.",
      "sourceSentenceIds": [
        29
      ],
