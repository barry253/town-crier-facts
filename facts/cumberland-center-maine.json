  "facts": [
    {
      "id": 1,
      "text": "Cumberland Center began as part of the 1680 North Yarmouth plantation, spanning lands between Falmouth and the Presumpscot River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cumberland_center_maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When Cumberland split from North Yarmouth in 1821, ship captain Ephraim Sturdivant chose the town’s name.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cumberland_center_maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cumberland Center’s roots in agriculture live on with Sweetser's Apple Barrel and Spring Brook Farms still in operation.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cumberland_center_maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village center is anchored by the handsome Cumberland Congregational Church, with Greely schools and the Historical Society nearby.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/cumberland-center-maine-a-comprehensive-guide-to-discovering-the-beauty-rich-culture-and-charming-community-of-this-hidden-gem",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every September, Cumberland Center hosts the Cumberland Fair, a classic agricultural celebration that began in 1868.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/cumberland-center-maine-a-comprehensive-guide-to-discovering-the-beauty-rich-culture-and-charming-community-of-this-hidden-gem",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cumberland Center serves as the town’s government and school hub, sitting in the geographic middle of Cumberland’s three villages.",
      "sourceSentenceIds": [
        29
