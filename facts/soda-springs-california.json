  "facts": [
    {
      "id": 1,
      "text": "Soda Springs grew around a Central Pacific Railroad stop called Tinkers Station, which operated from 1867 to 1873.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worldatlas.com/cities/soda-springs-california.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The station was renamed Soda Springs Station in 1873 to highlight the area’s mineral springs, sparking early resort development.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Soda_Springs,_Nevada_County,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mark Hopkins and Leland Stanford opened a luxury resort in 1880, turning Soda Springs into a fashionable escape for San Francisco’s elite.",
      "sourceSentenceIds": [
        9,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.worldatlas.com/cities/soda-springs-california.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Soda Springs Ski Area, founded in 1934, remains California’s oldest continuously operating ski resort, offering 400 inches of snowfall each year.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Soda_Springs,_Nevada_County,_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town sits just south of Tahoe National Forest, surrounded by coniferous hills that provide a picturesque backdrop for travelers.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worldatlas.com/cities/soda-springs-california.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before European settlement, the Nisenan (Southern Maidu) people used the natural carbonated springs of the area for generations.",
      "sourceSentenceIds": [
        12
      ],
