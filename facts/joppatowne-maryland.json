  "facts": [
    {
      "id": 1,
      "text": "Joppatowne’s 400‑year story is on display at the Bel Air Museum, tracing the area from Native American hunting grounds to today’s community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wmar2news.com/news/region/harford-county/joppatowne-exhibit-showcases-400-years-of-maryland-suburbs-rich-history"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the ancient port of Jaffa in Israel, echoing the original colonial settlement of Joppa.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland"
    },
    {
      "id": 3,
      "text": "The Old Joppa Site, the remains of the 18th‑century town, was added to the National Register of Historic Places in 1979.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland"
    },
    {
      "id": 4,
      "text": "Before Joppa rose, Gunpowder Town—an early English settlement—failed because the location proved unsuitable for colonists.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Foster’s Neck, a short‑lived community, was abandoned in 1707 after a smallpox outbreak decimated its residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Joppatowne%2C_Maryland"
    },
    {
      "id": 6,
      "text": "Jerusalem Mill Village, a living‑history museum dating back to the 1700s, offers a glimpse into 18th‑century life right in Joppatowne.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
