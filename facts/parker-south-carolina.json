  "facts": [
    {
      "id": 1,
      "text": "Parker was named after Lewis Wardlaw Parker, a prominent Greenville mill owner and industrialist involved in local cotton mills.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_south_carolina"
    },
    {
      "id": 2,
      "text": "Cousins Lewis Wardlaw and Thomas Fleming Parker founded a mill in 1900 that produced print cloth and fancy dress goods.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_south_carolina"
    },
    {
      "id": 3,
      "text": "The original Parker High School auditorium, built in 1938, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_south_carolina"
    },
    {
      "id": 4,
      "text": "Parker High School earned a reputation as a mill town miracle for its progressive educational innovations during the 1930s and 1940s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_south_carolina"
    },
    {
      "id": 5,
      "text": "Early settlers in the Parker area were largely Scotch-Irish immigrants from Pennsylvania and Virginia who received land grants.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/parker_south_carolina"
    },
    {
      "id": 6,
      "text": "Before the rise of industry, the local economy in Parker revolved around subsistence and small-scale commercial agriculture.",
      "sourceSentenceIds": [
        30
