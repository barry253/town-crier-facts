  "facts": [
    {
      "id": 1,
      "text": "Gorham was incorporated in 1764 after settlers built first sawmill in 1743 by John Gorham at Little River.",
      "sourceSentenceIds": [
        29,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gorham%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors New England Ranger John Gorham I, after whom Gorhamtown Plantation was named in the 1700s.",
      "sourceSentenceIds": [
        3,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gorham%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1851 the Poor's York and Cumberland Railroad, later Boston and Maine, reached Gorham, sparking a railroad era that lasted until 1961.",
      "sourceSentenceIds": [
        9,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gorham%2C_Maine",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Babb's Covered Bridge, a historic replica, spans the Presumpscot River and connects Gorham with Windham, offering a scenic landmark.",
      "sourceSentenceIds": [
        12,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mainepedia.com/towns/gorham/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The University of Southern Maine’s Gorham campus brings a vibrant student community to the town, blending academia with New England charm.",
