      "id": 1,
      "text": "Hornsby Bend takes its name from Reuben Hornsby, an early settler who became the town’s first postmaster in 1832.",
      "sourceSentenceIds": [
        3,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
