  "facts": [
    {
      "id": 1,
      "text": "Hornsby Bend takes its name from Reuben Hornsby, an early settler who became the town’s first postmaster in 1832.",
      "sourceSentenceIds": [
        3,
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornsby_Bend%2C_Texas"
    },
    {
      "id": 2,
      "text": "A U.S. post office opened there in 1856, closed during the Civil War, and reopened in 1886.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/hornsby-bend-tx"
    },
    {
      "id": 3,
      "text": "The town sits on Farm Road 969 beside the Colorado River, nine miles east of Austin.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/hornsby-bend-tx"
    },
    {
      "id": 4,
      "text": "Hornsby Bend claims to be the oldest settlement in Travis County since the 1830s.",
