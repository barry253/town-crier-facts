      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A U.S. post office opened there in 1856, closed during the Civil War, and reopened in 1886.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/hornsby-bend-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town sits on Farm Road 969 beside the Colorado River, nine miles east of Austin.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
