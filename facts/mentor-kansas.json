  "facts": [
    {
      "id": 1,
      "text": "Mentor was named after Mentor, Ohio, by settlers who carried the name from their hometown.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mentor%2C_Kansas"
    },
    {
      "id": 2,
      "text": "A north‑south railroad line built in 1879 by the Salina & Southwestern Railroad, later operated by Union Pacific, served Mentor until 1959.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mentor_kansas"
    },
    {
      "id": 3,
      "text": "Mentor’s post office, offering money‑order services and a rural delivery route, operated from 1881 until its closure in 1995.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mentor_kansas"
    },
    {
      "id": 4,
      "text": "Mentor lies near the Smoky Hill River valley, where the floodplain subtly shapes local soil and drainage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mentor_kansas"
    },
    {
      "id": 5,
      "text": "Today Mentor remains a quiet enclave within the Salina micropolitan area, preserving a handful of historic buildings amid farmlands.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mentor_kansas"
    },
    {
      "id": 6,
      "text": "Mentor was founded in the late 19th century as part of the Great Plains homesteading boom.",
