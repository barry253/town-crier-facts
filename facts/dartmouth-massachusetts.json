      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dartmouth’s Southworth Library, founded in 1878, was funded by John Haywood Southworth who donated 2,500 books in memory of his father.",
      "sourceSentenceIds": [
        3,
        28
      ],
      "sourceLabels": [
