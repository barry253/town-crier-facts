  "facts": [
    {
      "id": 1,
      "text": "Carbondale was founded in 1851 as a railroad hub, with the Delaware and Hudson Gravity Railroad beginning operations there in 1829.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.carbondalepa.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s historic City Hall and Courthouse, built in 1894, sits on the National Register of Historic Places and still serves as a civic landmark.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.carbondalepa.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Carbondale hosted America’s first Welsh eisteddfod in 1850, a musical and literary festival that celebrated the town’s strong Welsh immigrant roots.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carbondale%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Carbondale Historical Society & Museum preserves the town’s coal‑mining legacy and is a stop on the annual Coal Miners’ Memorial tour.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitnepa.org/plan-your-visit/regions/carbondale-area/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During special events, a historic train from Scranton’s Steamtown National Historic Site travels the old Delaware and Hudson mainline to Carbondale Station.",
