      ],
      "source": "https://www.ballardhistory.org/mapping-ballard-new/ballard-overview/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The National Nordic Museum in Ballard showcases Scandinavian heritage and offers a walking tour of historic buildings along Ballard Avenue.",
      "sourceSentenceIds": [
        3,
