  "facts": [
    {
      "id": 1,
      "text": "Spotswood, New Jersey, was originally settled in 1685 by James Johnston, who named it after his former home in Scotland, \"Spottiswoode.\".",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spotswood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Camden and Amboy Railroad reached Spotswood in 1832, following the historic stagecoach route established in 1816.",
      "sourceSentenceIds": [
        6,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spotswood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Spotswood was incorporated as a borough on April 15, 1908, after a referendum held a month earlier.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spotswood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The borough is situated in the heart of the Raritan Valley region, where the Manalapan and Matchaponix Brooks converge with the South River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spotswood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Spotswood was historically spelled as \"Spottswood,\" reflecting its Scottish roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spotswood%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
