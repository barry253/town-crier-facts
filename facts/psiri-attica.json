  "facts": [
    {
      "id": 1,
      "text": "Psiri was a haven for revolutionaries during the Greek War of Independence and later home to criminal gangs like the koutsavakides in the 1800s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chasingthedonkey.com/guide-to-psiri-athens-neighborhood-greece/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The central square, Heroes Square (Plateia Iroon), got its name because streets leading to it are named after Greek War of Independence heroes.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Psyri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lord Byron stayed in Psiri and wrote the poem \"Maid of Athens\" while living there.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Psyri",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alexandros Papadiamantis, a celebrated Greek author, lived in Psiri for more than two decades.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Psyri",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1990s Psiri shifted from an ill‑reputed quarter to a fashionable, trendy hub for dining, music, and boutique hotels.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Psyri",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Psiri, also spelled Psirri or Psyrri, is a gentrified Athens neighborhood known today for its restaurants, bars, live music, and small number of hotels.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
