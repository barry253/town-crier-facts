      "id": 1,
      "text": "Rosebush got its name when James Bush traded land with the Ann Arbor Railroad in 1868 so the station would honor his wife, Rose.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
