  "facts": [
    {
      "id": 1,
      "text": "Grand Rapids was founded in 1824 when surveyor Ambrose Rice and John Hollister secured a land patent for the site.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.grandrapidshistoricalsociety.org/a-brief-history.html"
    },
    {
      "id": 2,
      "text": "The village began as Gilead in 1833 and kept that name until 1868, when it became Grand Rapids.",
      "sourceSentenceIds": [
        4,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Rapids%2C_Ohio"
    },
    {
      "id": 3,
      "text": "A 1845 dam on the Maumee River sparked a local boom, leading Grand Rapids to incorporate in 1855 after a side‑cut canal was built.",
      "sourceSentenceIds": [
        25,
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Rapids%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Grand Rapids grew with the railroads, making Toledo a quick trip and keeping freight trains running through the village.",
      "sourceSentenceIds": [
        7,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.grandrapidshistoricalsociety.org/a-brief-history.html"
    },
    {
      "id": 5,
      "text": "The town’s preservation turns it into a living museum where you can stroll without needing audio guides.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/ohio-gorgeous-town-historic/"
    },
    {
      "id": 6,
      "text": "The Maumee River has powered historic mills and now offers scenic views that feed Instagram feeds.",
