    },
    {
      "id": 2,
      "text": "Southampton Meadows primarily encompasses a mobile home park, reflecting a residential model common in southeastern Virginia's rural counties.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/southampton_meadows_virginia"
    },
    {
      "id": 3,
      "text": "The landscape around Southampton Meadows was shaped over millennia by fluvial processes and glacial outwash.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/southampton_meadows_virginia"
    },
    {
      "id": 4,
      "text": "Southampton Meadows lies near the Blackwater and Nottoway Rivers, which converge to form the Chowan River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/southampton_meadows_virginia"
    },
    {
      "id": 5,
      "text": "Southampton Meadows experiences a humid subtropical climate with hot, humid summers and mild, wet winters.",
      "sourceSentenceIds": [
        20
