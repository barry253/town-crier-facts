  "facts": [
    {
      "id": 1,
      "text": "China Lake Acres grew around the Naval Ordnance Test Station, which the Navy founded in November 1943 to test rockets and aviation ordnance.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chinalakemuseum.org/brief-history/"
    },
    {
      "id": 2,
      "text": "Within a month of its formal opening, NOTS began testing rockets at China Lake, moving its aviation assets to Armitage Field by mid‑1945.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chinalakemuseum.org/brief-history/"
    },
    {
      "id": 3,
      "text": "The station helped create the Polaris missile system and fielded early guided weapons like the TV‑guided Walleye and Sidewinders.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://chinalakemuseum.org/brief-history/"
    },
    {
      "id": 4,
      "text": "The community sits at 35.6405 N latitude and –117.764 W longitude, right in Kern County’s high desert.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://california.hometownlocator.com/ca/kern/china-lake-acres.cfm"
    },
    {
      "id": 5,
      "text": "China Lake Acres is 100 % rural, with no residents living in urban areas.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/China_Lake_Acres%2C_California"
    },
    {
      "id": 6,
      "text": "The Naval Ordnance Test Station’s first facilities were built at Inyokern’s Harvey Field before the main China Lake base was constructed.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
