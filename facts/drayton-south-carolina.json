  "facts": [
    {
      "id": 1,
      "text": "Drayton is named for William Henry Drayton, a South Carolina patriot and delegate to the Continental Congress during the American Revolution.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/drayton_south_carolina"
    },
    {
      "id": 2,
      "text": "Drayton originated in the early twentieth century as a mill village centered around a textile facility organized in 1902.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/drayton_south_carolina"
    },
    {
      "id": 3,
      "text": "The Drayton Mill complex features distinctive Tudor Revival architecture and was listed on the National Register of Historic Places in 2007.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/drayton_south_carolina"
    },
    {
      "id": 4,
      "text": "A post office has been in operation in Drayton since 1904, marking its early development as a working-class enclave.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Drayton%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "Drayton lies along the North Tyger River, a tributary of the Broad River that flows through the Upstate region.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/drayton_south_carolina"
    },
    {
      "id": 6,
      "text": "The former mill site was revitalized between 2014 and 2015 into the Drayton Mills Marketplace, a large mixed-use development.",
      "sourceSentenceIds": [
        11
