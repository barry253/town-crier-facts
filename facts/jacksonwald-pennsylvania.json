  "facts": [
    {
      "id": 1,
      "text": "Jacksonwald was originally called Schwarzwald, meaning Black Forest, because the dense woodlands reminded early German settlers of their homeland.",
      "sourceSentenceIds": [
        1,
        7,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/jacksonwald_pennsylvania"
    },
    {
      "id": 2,
      "text": "John Jackson renamed the community Jacksonwald in 1870 when he established a post office and served as its first postmaster.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jacksonwald_pennsylvania"
    },
    {
      "id": 3,
      "text": "The area encompassing modern Jacksonwald was originally inhabited by the Lenape people, part of the Algonquian-speaking indigenous groups.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/jacksonwald_pennsylvania"
    },
    {
      "id": 4,
      "text": "Jacksonwald sits within the scenic Oley Valley, a region known for its pastoral landscapes and enduring Pennsylvania Dutch culture.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/pa/jacksonwald/overview"
    },
    {
      "id": 5,
      "text": "The historic Jacksonwald Hotel is a stone structure that has served as a local landmark and gathering place since the early 1800s.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/pa/jacksonwald/overview"
    },
    {
      "id": 6,
      "text": "A little red schoolhouse built in 1870 overlooks the local hotel and was restored in 1970 for its centennial anniversary.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacksonwald%2C_Pennsylvania"
    }
  ]
}
