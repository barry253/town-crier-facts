  "facts": [
    {
      "id": 1,
      "text": "Chatfield was founded in 1853 by Andrew Twiford and served as Fillmore County's seat before the county split.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatfield%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was named after Territorial Judge Andrew Chatfield, who oversaw the regional General Land Office during territorial settlement.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chatfieldmn.org/about",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town boasts a world‑class sheet‑music library, the Chatfield Brass Band Music Lending Library, preserving brass‑band era scores for musicians.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chatfield%2C_Minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic homes line Main Street, and Chatfield houses Minnesota’s oldest continuously running bank and newspaper, a testament to its early prosperity.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.chatfieldmn.org/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Two waterways flow through Chatfield: the North Branch of the Root River and Mill Creek, the latter a designated trout stream.",
      "sourceSentenceIds": [
        15,
