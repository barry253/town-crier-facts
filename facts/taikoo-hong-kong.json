  "facts": [
    {
      "id": 1,
      "text": "Taikoo Place, once a Swire industrial hub, was redeveloped in the 1980s into a mixed‑use business and entertainment district.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.trawellino.com/destinations/hong-kong/eastern_tai-koo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The complex hosts major IT firms, including the Hong Kong headquarters of IBM and JWT, which occupy the first 15 storeys of the PCCW Tower.",
      "sourceSentenceIds": [
        18,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taikoo_Place",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Swire Properties still manages Taikoo Place, tracing its roots back to the original Taikoo Sugar Refinery and Taikoo Dockyard.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taikoo_Place",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Taikoo Place’s MTR station on the Island Line makes it one of the most accessible business districts on Hong Kong Island.",
      "sourceSentenceIds": [
        6,
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.trawellino.com/destinations/hong-kong/eastern_tai-koo",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area around Taikoo Place, once residential and industrial, has been steadily gentrified since the 1980s, attracting younger professionals.",
      "sourceSentenceIds": [
        20,
        21,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taikoo_Place",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Taikoo Place’s car‑parking, clubs, office apartments, parks, and shops create a self‑contained urban environment rare for a commercial complex.",
      "sourceSentenceIds": [
        11
      ],
