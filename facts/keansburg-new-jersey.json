  "facts": [
    {
      "id": 1,
      "text": "Keansburg was formed as a borough on March 26, 1917, from parts of Middletown and Raritan Townships after a referendum.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keansburg%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area was once called Tanner's Landing, named for a pier on what is now Main Street, until about 1820.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keansburg%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1910 the Keansburg Steamboat Company began ferrying New Yorkers to the borough, marking the start of steamboat transport across Raritan Bay.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Keansburg%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Keansburg Waterfront Public Library opened in 2004 after a town‑wide effort to provide a high‑quality community library.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keansburg%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The borough’s beaches give access to Raritan Bay, offering swimming and sunbathing opportunities.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://newjersey.wiki/a/Keansburg",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Keansburg’s history includes the Gehlhaus brothers, who founded the Steamboat Company and later owned the amusement park that once drew crowds in the 1980s.",
