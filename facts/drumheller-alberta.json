  "facts": [
    {
      "id": 1,
      "text": "Drumheller takes its name from Samuel Drumheller, who surveyed the original townsite and sold lots in 1911.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drumheller"
    },
    {
      "id": 2,
      "text": "A railway station opened in Drumheller in 1912, linking the town to the wider Canadian rail network.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drumheller"
    },
    {
      "id": 3,
      "text": "The town sits on the Red Deer River, in a valley that locals call Dinosaur Valley because of the nearby fossil beds.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drumheller"
    },
    {
      "id": 4,
      "text": "The Royal Tyrrell Museum, one of the world’s largest dinosaur fossil collections, draws science lovers from around the globe.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travelalberta.com/places-to-go/cities-towns/drumheller"
    },
    {
      "id": 5,
      "text": "Coal mining began beside the townsite in 1911, fueling Drumheller’s boom until the end of World War II.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drumheller"
    },
    {
      "id": 6,
      "text": "Drumheller grew from a village in 1913 to a town in 1916, and finally achieved city status in 1930.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Drumheller"
    }
  ]
