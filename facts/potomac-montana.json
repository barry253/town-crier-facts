      "id": 1,
      "text": "Potomac was named by Ashby after the Potomac River in Virginia, reflecting the town’s location at the confluence of Camas and Union creeks.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
