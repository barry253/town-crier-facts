  "facts": [
    {
      "id": 1,
      "text": "Randwick takes its name from the English village of Randwick, the birthplace of Simeon Henry Pearce, who later founded the suburb.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randwick",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Simeon Pearce built the first stone house in the area, Blenheim House, in 1848; the sandstone cottage still stands on Blenheim Street.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randwick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Randwick Racecourse began as a sandy track in 1833, later becoming the site of the Australian Jockey Club’s relocated racecourse in 1860.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.neighbourhoodmedia.com.au/post/early-history-of-randwick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Randwick was proclaimed a municipality in February 1859, a milestone that marked its transition from a rural settlement to an organized suburb.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Randwick",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Randwick Line of Sydney’s light rail network ends at Randwick station, making the suburb a key terminus for commuters and tourists alike.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
