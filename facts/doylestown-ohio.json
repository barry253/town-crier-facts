  "facts": [
    {
      "id": 1,
      "text": "Doylestown was founded in 1827 when William Doyle laid out a 40‑lot town site at the crossing of two Native American trails on a hilltop.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doylestown%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits atop the highest point in Wayne County, giving it a commanding view of the surrounding countryside.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doylestown%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1834, brickmaking began when Abrahamm Franks built a kiln a quarter‑mile southwest of the village, and later brick yards flourished through the 1880s.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doylestown%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Coal mining drove early growth, with mines attracting settlers in the 1840s, but the industry faded around 1900, leaving a legacy of historic mine sites.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doylestown%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A log‑cabin tavern, the first building in Doylestown, was erected by Doyle with help from five friends who moved from Pennsylvania.",
      "sourceSentenceIds": [
        20,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doylestown%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Saints Peter & Paul Catholic Church, a historic landmark, showcases beautiful architecture that reflects the town’s early religious heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
