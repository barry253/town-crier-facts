    {
      "id": 1,
      "text": "Brandon takes its name from former Mississippi governor Gerard Chittocque Brandon, who led the state from 1826 to 1832.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Brandon,_Mississippi"
    },
    {
      "id": 2,
      "text": "The town officially became a city on December 19, 1831, after land sales began in 1835.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Brandon,_Mississippi"
    },
    {
      "id": 3,
      "text": "A railroad chartered in 1836 to link Jackson with Brandon only opened in 1850 after a Pearl River bridge was finished.",
      "sourceSentenceIds": [
