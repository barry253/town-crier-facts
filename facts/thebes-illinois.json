    },
    {
      "id": 2,
      "text": "Thebes served as Alexander County's seat from 1846 until 1859 before the capital moved to Cairo.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thebes%2C_Illinois"
    },
    {
      "id": 3,
      "text": "Abraham Lincoln argued cases in Thebes' 1848 Greek Revival courthouse, which later housed Dred Scott in its basement jail.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
