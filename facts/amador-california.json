  "facts": [
    {
      "id": 1,
      "text": "Amador City was founded in 1849 by gold panners drawn to Amador Creek, making it one of California's earliest mining towns.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amador_City%2C_California"
    },
    {
      "id": 2,
      "text": "The town’s name honors José María Amador, a rancher who mined with the Sunol Group in 1848‑1849.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitamadorcity.com/history-california-gold-country-town-amador-city/"
    },
    {
      "id": 3,
      "text": "The Consolidated Keystone Mine, established in 1853 from two or more small claims, remains a landmark of the city’s mining heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.amador-city.com/amadorcity/amador-city-history.html"
    },
    {
      "id": 4,
      "text": "Amador City’s Imperial Hotel on Main Street showcases classic Californian brickwork and dates back to the town’s early boom years.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amador_City%2C_California"
    },
    {
      "id": 5,
      "text": "The Little Amador Railroad once ran through the town, leaving behind a G‑Scale model train set that still displays miniature mines and mills.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Amador_City%2C_California"
    },
    {
      "id": 6,
      "text": "Covering just 0.3 square miles, Amador City is California’s smallest city by area, a quirky fact that locals love to brag about.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
