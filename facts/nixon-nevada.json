      "id": 1,
      "text": "Nixon was named in honor of Senator George Stuart Nixon, who helped shape Nevada’s early mining boom.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nixon%2C_Nevada",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nixon sits at 3,940 feet above sea level, right where the Truckee River feeds Pyramid Lake.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nixon_nevada",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "July temperatures average 93°F, while January lows dip to about 23°F, a reflection of its high desert climate.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nixon_nevada",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Nixon serves as the administrative headquarters for the Pyramid Lake Paiute Tribe, overseeing the reservation’s natural resources.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nixon_nevada",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1860 Pyramid Lake War, Northern Paiute warriors defended the area against Euro‑American settlers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/nixon_nevada",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Bureau of Reclamation’s Stampede Dam, completed in 1971, now regulates releases to support Pyramid Lake’s water levels.",
