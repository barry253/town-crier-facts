  "facts": [
    {
      "id": 1,
      "text": "Avonmore sits in Westmoreland County, Pennsylvania, along the Kiskiminetas River in the Alle‑Kiski Valley.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avonmore%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Two foundries operated in Avonmore during the 1890s, and the later Akers National Roll, a major employer, closed in 2019.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avonmore%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every summer, Avonmore hosts the Sunny Acres Sunflower Maze, a seasonal attraction that draws visitors to the town’s countryside.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.golaurelhighlands.com/blog/stories/post/discover-westmoreland-avonmore-borough/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 2012 film Promised Land, starring Matt Damon and John Krasinski, was primarily shot in Avonmore, giving the borough a spot in Hollywood history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.golaurelhighlands.com/blog/stories/post/discover-westmoreland-avonmore-borough/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Avonmore’s name reflects its early industrial roots, combining “Avon” from the nearby river with “more” to suggest abundance.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avonmore%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Although Avonmore lacks a passport office, residents can easily access nearby post offices and the Westmoreland County Prothonotary for travel documents.",
