  "facts": [
    {
      "id": 1,
      "text": "Centerville was founded around 1882 and named for its central spot between Louisburg, Warrenton, and Littleton.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic crossroads at NC‑561 and NC‑58 hosts two old‑fashioned general stores that still line the intersection.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Perry School and Vine Hill, two of Centerville’s oldest buildings, earned spots on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Centerville had no police department; the Franklin County Sheriff’s Office keeps the town safe.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "In 2017, a state bill dissolved Centerville, ending its 52‑year status as an incorporated town.",
      "sourceSentenceIds": [
        12,
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Centerville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Sarepta Methodist church, once a community hub, now stands abandoned at NC‑561 and Centerville‑Laurel Mill Road.",
