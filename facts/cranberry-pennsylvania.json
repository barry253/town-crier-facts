  "facts": [
    {
      "id": 1,
      "text": "Cranberry Township got its name from wild cranberries that once lined Brush Creek, the area’s main waterway.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cranberrytownship.org/77/Cranberry-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cranberry Township was officially created on March 12, 1804, as part of the newly formed Butler County.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cranberrytownship.org/77/Cranberry-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1803, Samuel Duncan built a sawmill on Brush Creek, also running a well‑known distillery.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cranberrytownship.org/77/Cranberry-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first tractor appeared in Cranberry Township in 1918, marking a shift from horse‑drawn to mechanized farming.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cranberrytownship.org/77/Cranberry-History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Crider’s Corners became a Harmony Line electric railway stop in 1908, but the station closed in 1931.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cranberrytownship.org/77/Cranberry-History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Cranberry Public Library opened in 1974 inside a modest 10‑by‑12 foot room before moving to the Municipal Center.",
