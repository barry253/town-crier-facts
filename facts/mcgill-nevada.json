    {
      "id": 2,
      "text": "A post office opened at the ranch in 1891, marking the town’s first formal federal presence.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McGill%2C_Nevada"
    },
    {
      "id": 3,
      "text": "John Cowger founded the Steptoe Valley ranch in 1872, securing water rights that would sustain the community.",
      "sourceSentenceIds": [
        8
