    {
      "id": 1,
      "text": "Toomsuba’s name comes from the Choctaw word for a horse‑related term linked to the nearby creek.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/toomsuba_mississippi"
    },
    {
      "id": 2,
      "text": "During the Civil War and afterward, the Mobile and Ohio Railroad ran through Toomsuba, turning the area into a supply route and later a cotton trade hub.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/toomsuba_mississippi"
    },
    {
      "id": 3,
      "text": "Toomsuba is prone to frequent thunderstorms and occasional tornadoes each spring, a result of its location in the Dixie Alley corridor.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/toomsuba_mississippi"
    },
    {
      "id": 4,
      "text": "The town enjoys a humid subtropical climate, with summer highs near 92°F, winter lows around 34°F, and roughly 56 inches of rain annually.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/toomsuba_mississippi"
    },
    {
      "id": 5,
      "text": "At 32°25′49″N 88°30′25″W, Toomsuba sits 302 feet above sea level in the East Gulf Coastal Plain.",
      "sourceSentenceIds": [
        19,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/toomsuba_mississippi"
    },
    {
      "id": 6,
      "text": "U.S. Routes 80 and 11 cross through Toomsuba, forming the town’s main street.",
