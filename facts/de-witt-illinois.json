  "facts": [
    {
      "id": 1,
      "text": "DeWitt was named after New York governor DeWitt Clinton, who served from 1817 to 1823.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/DeWitt%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Abraham Lincoln practiced law in DeWitt County’s courthouse, and visitors can still see the historic office where he worked.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lookingforlincoln.org/education/8thcircuit/com/dewitt.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The DeWitt County Genealogical and Historical Society houses a permanent exhibit titled “Lincoln in DeWitt County,” showcasing Lincoln’s local legacy.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lookingforlincoln.org/education/8thcircuit/com/dewitt.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first permanent settlement in DeWitt County appeared in 1820 on land once held by the Kickapoo and Pottawatomie tribes.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lookingforlincoln.org/education/8thcircuit/com/dewitt.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clinton, the county seat, was founded in 1835 by Jesse Fell and state senator James Allin, two years after Lincoln began his legal career.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
