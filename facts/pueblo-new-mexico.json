      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pueblo’s residents trace their ancestry to the Ancestral Puebloans who settled the Four Corners region more than 600 years ago.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1"
