      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1680 Pueblo Revolt forced Spanish colonists to leave New Mexico, a turning point that reshaped the region’s history.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
