  "facts": [
    {
      "id": 1,
      "text": "Lawrence County was created in 1849 and named for the USS Lawrence, Oliver Hazard Perry’s flagship at the Battle of Lake Erie.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Lawrence-county-Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lawrence sits just north of Washington County, right on the border with Allegheny County, making it a true Pittsburgh suburb.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrence%2C_Pennsylvania",
      "category": "history",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "The town sprang up as a miner’s village for the Montour #4 Mine, which opened its doors in 1914.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrence%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Montour #4 shut its gates in 1980 after a catastrophic flood that ended its mining operations.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawrence%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lawrence is home to the Black Box Corporation, a company known for its innovative electronics manufacturing.",
      "sourceSentenceIds": [
        16
