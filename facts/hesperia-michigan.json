      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hesperia was platted in 1866 by Daniel Weaver and John Cook, who built a sawmill and general store.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
