  "facts": [
    {
      "id": 1,
      "text": "New Jerusalem was originally known as Fryer's Mill after a local mill built by John Fryer in the 1750s.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/pa/new-jerusalem/overview"
    },
    {
      "id": 2,
      "text": "The New Jerusalem Inn began as a stagecoach stop in 1816 and originally operated as the Kline Tavern.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_jerusalem_pennsylvania"
    },
    {
      "id": 3,
      "text": "Amish and Mennonite communities are an integral part of the area's character, often using horse-drawn buggies on the roads.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/pa/new-jerusalem/overview"
    },
    {
      "id": 4,
      "text": "The arrival of the Schuylkill Valley Railroad in the 1850s allowed local farmers to ship produce to urban markets efficiently.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wikixm.com/us/pa/new-jerusalem/overview"
    },
    {
      "id": 5,
      "text": "New Jerusalem is located in the South Mountains and is drained by the Manatawny Creek into the Schuylkill River.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Jerusalem%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Mineral-rich hills surrounding New Jerusalem feature historical deposits of granite and iron ore used for past quarrying activities.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_jerusalem_pennsylvania"
    }
