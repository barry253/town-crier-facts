  "facts": [
    {
      "id": 1,
      "text": "Hilham was founded in 1797 by Dartmouth graduate Moses Fisk, who believed the site marked the geographic center of the United States at the time.",
      "sourceSentenceIds": [
        13,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilham%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fisk platted Hilham with roads radiating north, south, east, and west, hoping the town would become a national crossroads for travel and commerce.",
      "sourceSentenceIds": [
        14,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilham%2C_Tennessee",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1806, Fisk established one of the Southeast’s first female academies in Hilham, chartered by the Tennessee General Assembly for women’s education.",
      "sourceSentenceIds": [
        15,
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hilham%2C_Tennessee",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Moses Fisk House, now at the park entrance, stands as a tangible link to Hilham’s pioneering past and the town’s early surveyor‑founder.",
      "sourceSentenceIds": [
        19,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hilham_tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hilham’s park preserves a historic Native American landmark—a large sandstone boulder that once served as a boundary marker—and offers over eight miles of trails with views of Dale Hollow Lake.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hilham_tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name comes from “Hamlet on the Rill,” reflecting its position near a small stream on the Cumberland Plateau.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hilham_tennessee",
