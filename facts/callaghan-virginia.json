      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Callaghan lies on the eastern slope of the Alleghany Mountains, surrounded by cold mountain streams that have drawn outdoor lovers since the 1700s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://alleghanyhistorical.org/historic_homes/milton-hall/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Humpback Covered Bridge and Wood Hall, both in Callaghan, earned spots on the U.S. National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
