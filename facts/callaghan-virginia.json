  "facts": [
    {
      "id": 1,
      "text": "Milton Hall, a 1874 brick residence, sits in Callaghan and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://alleghanyhistorical.org/historic_homes/milton-hall/"
    },
    {
      "id": 2,
      "text": "Callaghan lies on the eastern slope of the Alleghany Mountains, surrounded by cold mountain streams that have drawn outdoor lovers since the 1700s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://alleghanyhistorical.org/historic_homes/milton-hall/"
    },
    {
      "id": 3,
      "text": "The Humpback Covered Bridge and Wood Hall, both in Callaghan, earned spots on the U.S. National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Callaghan%2C_Virginia"
    },
    {
      "id": 4,
      "text": "Callaghan is part of the Allegheny Highlands, a region celebrated for its breathtaking scenery and rugged wilderness.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hellonation.com/mag/VA/Callaghan/49905"
    },
    {
      "id": 5,
      "text": "Neighbors in Callaghan greet each other with smiles, and community events bring residents together in joyous celebration.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hellonation.com/mag/VA/Callaghan/49905"
    },
    {
      "id": 6,
      "text": "Just moments from Callaghan, hikers can explore trails, anglers can fish, and birdwatchers can spot diverse species in the surrounding forests.",
