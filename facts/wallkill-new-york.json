  "facts": [
    {
      "id": 1,
      "text": "During the American Revolution, Wallkill’s factories in Phillipsburgh and Craigville produced gunpowder for the Continental Army, thanks to Henry Wisner and Moses Phillips.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallkill%2C_Orange_County%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wallkill sits just east of the dramatic Shawangunk Ridge, a landmark that shapes the Hudson Valley’s natural scenery.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://943litefm.com/history-hudson-valley-wallkill-ny/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wallkill’s history stretches back to 1724, but the town wasn’t officially established until 1772, just before Ulster County split off.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallkill%2C_Orange_County%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town proudly hosts the first Lloyd’s Supercenter in New York, a retail milestone that once drew shoppers from across the state.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallkill%2C_Orange_County%2C_New_York",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Every summer, Wallkill opens its gates for the Orange County Fair, a long‑running event that showcases local culture and agriculture.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallkill%2C_Orange_County%2C_New_York",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wallkill’s downtown once housed the first mall in the area, Orange Plaza, before the modern Galleria at Crystal Run and a Super Wal‑Mart took over.",
