  "facts": [
    {
      "id": 1,
      "text": "Waynesboro was named after General Anthony Wayne, a Revolutionary War hero, in the early 19th century.",
      "sourceSentenceIds": [
        1,
        4,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesboro%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early history includes a tragic 1764 massacre of two sisters, now commemorated by a museum and park.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesboro%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Royer–Nicodemus House and Farm, now the Renfrew Museum, showcases 18th‑century farm life in the borough.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesboro%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Waynesboro sits just two miles north of the Mason‑Dixon line, placing it on the edge of historic Civil War territory.",
      "sourceSentenceIds": [
        16,
        20,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://waynesboropa.gov/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Underground Railroad was active in Waynesboro, with records available through the Franklin County Visitors Bureau.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.mainstreetwaynesboro.org/see-and-do",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The borough’s original charter as Waynesburg was repealed in 1825, and it was reincorporated as Waynesboro in 1831.",
