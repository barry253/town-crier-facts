  "facts": [
    {
      "id": 1,
      "text": "Bay earned its name from a nearby slough once called \"Big Bay\" and was originally known as Bay Siding when the railroad first stopped there.",
      "sourceSentenceIds": [
        1,
        2,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bay_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "North of Bay stand two ancient Indian mounds, the last remnants of a once-three-mound complex that dates back to 1200‑1400 AD.",
      "sourceSentenceIds": [
        3,
        4,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bay_arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bay lies within the Francis Lowlands ecoregion of the Mississippi Alluvial Plain, a flat landscape marked by sand blows from the 1811‑12 New Madrid earthquakes.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cotton farming once thrived in Bay during the prosperous 1920s, but the 1970s saw a sharp decline in family farms and a shift to larger operations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bay_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bay is part of the Arkansas Delta, a region known for its fertile alluvial soils that support extensive row‑crop agriculture.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
