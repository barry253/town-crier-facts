      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Emery Trufant built the first water‑powered sawmill in the community in 1872.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trufant%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Later, Hileman and Jacob Hesser erected a steam‑powered mill on the same site.",
      "sourceSentenceIds": [
