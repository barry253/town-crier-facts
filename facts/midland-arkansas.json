  "facts": [
    {
      "id": 1,
      "text": "Midland was incorporated on May 14, 1904, after its post office—originally called Burma—was renamed to highlight the town’s central spot on transportation routes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midland_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Midland, the area that would become the town, saw sparse early settlement in the mid‑19th century before the coal boom.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midland_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The discovery of coal deposits in Sebastian County in the early 1900s drew a diverse influx of multinational workers to Midland.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midland_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Sebastian County Union War of 1914 pitted unionized miners against coal operators in a violent clash that shaped Midland’s mining history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midland_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The conflict sparked over a decade of litigation, with cases reaching the U.S. Supreme Court twice and weakening union influence by the mid‑1920s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midland_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the mid‑20th century, exhausted coal seams and competition from other energy sources ended coal as Midland’s primary economic driver.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/midland_arkansas",
      "category": "economy",
      "quality": "good"
