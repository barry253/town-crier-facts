  "facts": [
    {
      "id": 1,
      "text": "Allenport sits in Washington County, southwestern Pennsylvania, along the Monongahela River southeast of Pittsburgh.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/borough-allenport.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Allenport borders the boroughs of Belle Vernon to the northeast and California to the south, placing it near Pittsburgh’s industrial corridor.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/borough-allenport.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Two Pennsylvania communities share the name Allenport; the one in Washington County is the one travelers will find here.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/pa/allenport-xx-washington-profile.htm",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Allenport’s town hall provides construction permits and building regulations, with staff ready to guide applicants through the process.",
      "sourceSentenceIds": [
