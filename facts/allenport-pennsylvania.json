      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/borough-allenport.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Allenport has no local passport office; residents must use nearby post offices such as Charleroi or Connelsville.",
