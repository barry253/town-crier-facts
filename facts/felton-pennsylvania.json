  "facts": [
    {
      "id": 1,
      "text": "Felton was incorporated as a borough on May 8, 1899, after annexing parts of Chanceford, North Hopewell, and Windsor townships.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://feltonboroughpa.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s name honors Johannes Felton Ziegler, a financier who helped plan the railroad that first ran through the area.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Felton%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Electricity reached Felton in 1923 when the Metropolitan‑Edison Company extended service into the borough.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://feltonboroughpa.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two small streams, Pine Run and Muddy Creek, flow through Felton, adding a gentle waterway charm to the town.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://feltonboroughpa.com/about/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After World War II, Felton replaced its original monument with a new memorial honoring all veterans and those who made the supreme sacrifice.",
