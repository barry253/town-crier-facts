      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Felton%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Electricity reached Felton in 1923 when the Metropolitan‑Edison Company extended service into the borough.",
