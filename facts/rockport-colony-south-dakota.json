  "facts": [
    {
      "id": 1,
      "text": "Rockport Colony is a historic communal settlement of the Hutterite Church, an Anabaptist Christian denomination known for shared property.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_rockport_hutterite_colony"
    },
    {
      "id": 2,
      "text": "A Lehrerleut group founded the Old Rockport Colony in 1891, making it one of nineteen daughter colonies created during a rapid expansion.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_rockport_hutterite_colony"
    },
    {
      "id": 3,
      "text": "Rockport Colony sits along the James River in Hanson County, southwest of Alexandria and southeast of Mitchell.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rockport_Colony%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "The site was listed on the National Register of Historic Places in 1982 for its traditional Hutterite architecture and ethnic heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_rockport_hutterite_colony"
    },
    {
      "id": 5,
      "text": "Hutterites established Rockport Colony after fleeing Ukraine in the 1870s due to the Russian Tsar revoking their military service exemptions.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_rockport_hutterite_colony"
    },
    {
      "id": 6,
      "text": "Rockport Colony continues to operate today under Schmiedeleut Group 2 leadership with a focus on farming and milling.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/old_rockport_hutterite_colony"
    }
  ]
