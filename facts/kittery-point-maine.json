  "facts": [
    {
      "id": 1,
      "text": "Kittery Point is the oldest town in Maine, with a rich history deeply intertwined with the sea.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/kittery-point-maine-exploring-the-charm-of-maine-s-coastal-gem"
    },
    {
      "id": 2,
      "text": "Kittery was named after Kittery Court in Devon, England, the family home of early settler Alexander Shapleigh.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.worldatlas.com/cities/this-maine-town-is-older-than-the-state-itself.html"
    },
    {
      "id": 3,
      "text": "The town was originally a shipbuilding hub, launching its first ship, the Blessing of the Bay, in 1631.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://winslowmaine.org/kittery-point-maine-exploring-the-charm-of-maine-s-coastal-gem"
    },
    {
      "id": 4,
      "text": "Fort McClary State Historic Site at Kittery Point protects the approaches to the Piscataqua River.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.worldatlas.com/cities/this-maine-town-is-older-than-the-state-itself.html"
    },
    {
      "id": 5,
      "text": "The Lady Pepperrell House is a noted Georgian building in Kittery Point that was built in 1760.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kittery_Point%2C_Maine"
    },
    {
      "id": 6,
      "text": "Kittery is known as the Gateway to Maine because it is located at the southern tip of the state.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.worldatlas.com/cities/this-maine-town-is-older-than-the-state-itself.html"
