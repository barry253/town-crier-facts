  "facts": [
    {
      "id": 1,
      "text": "Stirling Castle, founded in 1129, is the city’s second oldest building and a key medieval stronghold.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The saying “he who holds Stirling holds Scotland” reflects Stirling’s historic role as the Gateway to the Highlands.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A ferry, later a bridge, across the River Forth at Stirling once brought wealth and strategic influence to the town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stirling",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Wallace Monument, a towering tribute to the 13th‑century hero, stands beside Stirling Castle overlooking the city.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visit-stirling.co.uk/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every August, the Stirling Highland Games bring athletes, pipe bands, and craft stalls to the city’s historic grounds.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visit-stirling.co.uk/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The old town’s medieval streets still echo with merchants’ trades, while the Old Bridge and port remain linked to Stirling’s rich past.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
