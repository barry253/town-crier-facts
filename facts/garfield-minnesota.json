    {
      "id": 2,
      "text": "Garfield was platted on February 17, 1882, as a planned community in Ida Township, drawn by fertile lands and transport potential.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/garfield_minnesota"
    },
    {
      "id": 3,
      "text": "Garfield officially became an incorporated village in 1905, marking its transition from a planned community to a self‑governing municipality.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/garfield_minnesota"
    },
    {
      "id": 4,
      "text": "The former Burlington Northern railway line near Garfield now powers the Central Lakes State Trail, a multi‑use path for hikers and bikers.",
