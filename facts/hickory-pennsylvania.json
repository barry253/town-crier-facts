      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Township meetings convene the first Monday of every month at 7:00 p.m. in the municipal building on Eastbrook Road.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
