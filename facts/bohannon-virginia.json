  "facts": [
    {
      "id": 1,
      "text": "The community’s name honors the Bohannon family, whose 1667 land patent on the East River helped shape the area’s early tobacco economy.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bohannon_virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bohannon’s historic core includes the 1900 Ro-Mar Market, a vernacular commercial building that once served as the town’s social hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bohannon_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Peninsula School, built around 1920 in Classical Revival style, later became a community center, reflecting early 20th‑century educational priorities.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bohannon_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The East River borders Bohannon to the east, while Mill Creek outlines its southern and western edges, weaving the community into Mathews County’s tidal network.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bohannon_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bohannon experiences a humid subtropical climate, with July highs near 87°F and annual rainfall around 47 inches, supporting lush maritime forests and tidal wetlands.",
      "sourceSentenceIds": [
        19,
        20,
        21,
        22
      ],
