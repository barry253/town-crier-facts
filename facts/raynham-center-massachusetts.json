  "facts": [
    {
      "id": 1,
      "text": "Raynham Center's roots trace back to iron ore discovered on a riverbank in 1652, sparking the town's early industry.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://masscivics.com/raynham/raynham-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad arrived in the 1840s, linking Raynham to Boston and New Bedford and fueling its growth.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://masscivics.com/raynham/raynham-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town's first church, the First Congregational Church, was founded in 1731, making it one of the oldest religious institutions in the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://raynhampubliclibrary.org/raynham-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1888, residents formed the Raynham Public Library Association, turning a private collection into a town library that began in Dean Hall on Johnson's Pond.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://masscivics.com/raynham/raynham-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town celebrated its 200th anniversary in 1931 with a ceremony at Weonit Hall, highlighting Raynham's iron industry heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://raynhampubliclibrary.org/raynham-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A Fallen Hero sign near a soldier's original home in Raynham Center lists names, ranks, conflicts, service, and ages, honoring local veterans.",
