  "facts": [
    {
      "id": 1,
      "text": "Trent was originally established as Rattlesnake near Rattlesnake Creek in 1868 before the post office was renamed in 1875.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trent_oregon"
    },
    {
      "id": 2,
      "text": "The region encompassing modern Trent was part of the traditional territory of the Kalapuya people for thousands of years.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trent_oregon"
    },
    {
      "id": 3,
      "text": "Trent is located along Rattlesnake Creek, a north-flowing tributary of the Middle Fork Willamette River.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trent%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Old railroad cuts around Trent feature agate seams in weathered clay, where minerals like realgar and orpiment were extracted.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trent_oregon"
    },
    {
      "id": 5,
      "text": "Dense forests around Trent attracted logging interests in the late 19th century, with small sawmills processing timber for export.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trent_oregon"
    },
    {
      "id": 6,
      "text": "Riparian areas in Trent provide vital spawning and rearing grounds for native salmonids, such as spring Chinook salmon and trout.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
