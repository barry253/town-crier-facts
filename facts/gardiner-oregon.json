  "facts": [
    {
      "id": 1,
      "text": "Gardiner is named for a Boston merchant whose ship, the Bostonian, shipwrecked at the mouth of the Umpqua in 1850.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Gardiner served as the headquarters of the Umpqua customs district starting in 1851.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Several steamboats were constructed in Gardiner to facilitate trade up the Umpqua River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Gardiner was once the site of the first International Paper mill on the West Coast.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The Gardiner Historic District has been listed on the National Register of Historic Places since 1994.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gardiner%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Gardiner is located on the north bank of the Umpqua River near its mouth.",
