  "facts": [
    {
      "id": 1,
      "text": "Westmoreland City sits beside the historic Hanna's Town, a reconstructed 18th‑century village that once served as the county’s first seat of government.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Westmoreland History Education Center, located in Hanna's Town, opens Thursday through Saturday from 10 a.m. to 4 p.m. for visitors to explore local history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Westmoreland Historical Society, headquartered in Hanna's Town, runs a research library, exhibit gallery, and museum shop that support preservation projects across the county.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Penny River LLC, owned by Jessica Young, offers workshops teaching 18th‑century hand‑sewing stitches, with classes held at Historic Hanna's Town.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westmorelandhistory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Westmoreland County, where the city lies, is one of three counties in Pennsylvania’s Laurel Highlands known for historic sites, arts, and cultural festivals.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westmorelandheritage.org/about/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The Westmoreland Heritage organization, originally housed on the Pitt‑Greensburg campus, shares a mission with the Historical Society to educate residents about the region’s remarkable history and culture.",
      "sourceSentenceIds": [
