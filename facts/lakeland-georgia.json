  "facts": [
    {
      "id": 1,
      "text": "Lakeland began as Alapaha, became Milltown in 1857, and adopted its current name in 1925 to honor nearby lakes.",
      "sourceSentenceIds": [
        1,
        4,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakeland%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lakeland became Lanier County’s seat when the county was created in 1925, the same year the city incorporated.",
      "sourceSentenceIds": [
        7,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.lakelandchamber.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lakeland earned Georgia’s Historic Mural City title thanks to Milltown Murals that portray 1920s everyday life.",
      "sourceSentenceIds": [
        6,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://lakelandga.gov/about/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad built by George Gress in 1904 linked Milltown to Naylor, and the town operated its own line for years.",
      "sourceSentenceIds": [
        13,
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakeland%2C_Georgia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first standalone library opened in 1980 as the Lanier‑Lakeland Library, following a school library that began in 1950.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lakeland%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Early Lakeland economy hinged on mills along the Alapaha River, starting with Joshua Lee’s cotton gin and gristmill in 1838.",
      "sourceSentenceIds": [
        25,
