  "facts": [
    {
      "id": 1,
      "text": "St. Hilaire received its name from a Frenchman named Arthur Yvernault, who bought land in 1882 and named the town after his hometown in France.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Hilaire%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "St. Hilaire was platted in 1882 and incorporated as a village on July 4, 1883.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Hilaire%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "St. Hilaire once hosted a Great Northern Railway station, connecting it to Crookston and neighboring towns.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Hilaire%2C_Minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "St. Hilaire's post office opened in 1882 while the town was still part of Polk County.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Hilaire%2C_Minnesota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "St. Hilaire sits in section 6 of River Falls Township in Pennington County, Minnesota.",
