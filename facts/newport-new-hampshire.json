      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newport%2C_New_Hampshire",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1845 Corbin Covered Bridge, a historic landmark, was destroyed by a suspicious fire, sparking debate over rebuilding it.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
