  "facts": [
    {
      "id": 1,
      "text": "Waynesville was named after Revolutionary War hero General Anthony Wayne when the first plats were filed in 1832.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village began when Prettyman Marvel and his wife Rebecca cleared land near the present site in 1825.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When DeWitt County was created in 1839, Waynesville sat at the far northwest corner and missed becoming the county seat.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1855 a cholera outbreak killed about 50 of Waynesville's 150 residents, one of the worst in central Illinois.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waynesville%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Originally the township balanced prairie and timber, with timber slightly more abundant than prairie land.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ildewitt.whalen-family.org/waynesville-twp.htm",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the 1832 plats were filed, village lots were auctioned, but few were built because of economic circumstances.",
      "sourceSentenceIds": [
        13,
        14
      ],
