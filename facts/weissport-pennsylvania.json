  "facts": [
    {
      "id": 1,
      "text": "Founded in 1792 by Colonel Jacob Weiss, Weissport quickly became a vital hub for canal boat construction and repair.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://weissportborough.com/front-page/"
    },
    {
      "id": 2,
      "text": "Today, Lehigh Canal Park offers a blend of natural beauty and historic canal remnants for visitors.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weissport%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Weissport sits on the east side of the Lehigh River, perched on low ground between the river and the former canal.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weissport%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Within twenty years of its founding, Weissport became the only boat‑building and repair facility along the Lehigh Canal.",
      "sourceSentenceIds": [
        14,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weissport%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The borough’s rich history and access to the Lehigh River and D&L Trail make it a favorite spot for history buffs and nature lovers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://weissportborough.com/front-page/"
    },
    {
      "id": 6,
      "text": "Weissport is part of the Delaware and Lehigh National Heritage Corridor, highlighting its historic canal significance.",
