  "facts": [
    {
      "id": 1,
      "text": "Viola is pronounced \"vy-OLA,\" a name that echoes the village’s modest yet distinctive heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village sits at the crossroads of U.S. Route 67 and Illinois Route 17, a historic junction that shaped local travel.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_Illinois"
    },
    {
      "id": 3,
      "text": "U.S. 67 cuts through Viola on 13th Street, linking the town north to Rock Island and south to Monmouth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Illinois Route 17 runs along 17th Avenue, meeting 13th Street right at Viola’s center, a key local landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Water from Viola drains south into Pope Creek and north into Skunk Creek, both feeding the Edwards River system.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Viola%2C_Illinois"
    },
    {
      "id": 6,
      "text": "Pope Creek and the Edwards River flow westward, ultimately joining the mighty Mississippi River beyond the village’s borders.",
      "sourceSentenceIds": [
        10
