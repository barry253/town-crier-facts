      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Meadview lies 67 miles north of Kingman and 14 miles south of Pearce Ferry on the Colorado River, placing it near the Grand Canyon’s west rim.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
