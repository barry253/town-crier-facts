      ],
      "source": "https://en.wikipedia.org/wiki/Meadview%2C_Arizona",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The community hosts a small library, post office, and two motels, reflecting its modest but essential local services.",
