    },
    {
      "id": 2,
      "text": "The first cotton mill in Randolph County, Cedar Falls Manufacturing Company, chartered 1828, began operations 1836.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_falls_north_carolina",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A new three‑story brick factory, 108 by 48 feet, finished October 1848, could process 1,050 pounds of cotton daily.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_falls_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Quaker settlers in the 1740s influenced the mill’s labor practices, favoring free white labor over enslaved workers.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedar_falls_north_carolina",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Civil War, Cedar Falls Mill supplied the Confederacy with soldiers’ shirts and drawers, exempting its workers from conscription.",
