  "facts": [
    {
      "id": 1,
      "text": "Eden was named by surveyor Washington Jenkins who thought it was one of the most beautiful sites he had ever seen.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eden%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first structure was a log cabin built in 1857 by Mormon pioneers Erastus Bingham and Joseph Hardy near spring on the Middle Fork of the Ogden River.",
      "sourceSentenceIds": [
        4,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Eden,_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eden sits between the North and Middle Forks of the Ogden River, north of Pineview Reservoir, in the Ogden Valley.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eden%2C_Utah",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Eden hosts Powder Mountain ski resort, a major winter sports destination.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eden%2C_Utah",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eden’s climate is semi‑arid (BSk), with hot dry summers and cold snowy winters, and the high elevation brings substantial winter snowfall.",
      "sourceSentenceIds": [
        10,
