  "facts": [
    {
      "id": 1,
      "text": "Cobble Hill takes its name from the conical hill called 'Cobleshill' or 'Ponkiesbergh' at the junction of Atlantic, Pacific, and Court Streets.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobble_Hill%2C_Brooklyn",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dutch farmers first settled the area in the 1640s after Willem Kieft granted them land patents in what is now Cobble Hill.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobble_Hill%2C_Brooklyn",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Christ Church, founded in 1835, was the first organized religious group in Cobble Hill.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobble_Hill%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Cobble Hill Tunnel, built in 1844 under Atlantic Avenue, replaced railroad tracks that ran down the middle of the street.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cobble_Hill%2C_Brooklyn",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In July 2005, HBO's The Sopranos filmed a wedding at the landmark church in Cobble Hill for season six.",
