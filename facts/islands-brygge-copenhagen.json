    },
    {
      "id": 3,
      "text": "German troops occupied Islands Brygge during WWII, and Danish resistance fighters carried out several sabotage acts there.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Islands_Brygge"
    },
    {
      "id": 4,
      "text": "Havneparken, the waterfront park, hosts Copenhagen's popular Harbour Bath and the Islands Brygge Cultural House.",
      "sourceSentenceIds": [
