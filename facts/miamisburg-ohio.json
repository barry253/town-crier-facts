  "facts": [
    {
      "id": 1,
      "text": "Miamisburg was named after the Miami people and grew around a prehistoric Adena burial mound built around 1000‑200 BCE.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miamisburg%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s downtown hosts the historic Baum Opera House, a brick theater erected in 1884 that once served as the Star City Opera House.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historicalmiamisburg.org/historic-sites/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1986 a Baltimore and Ohio train derailment near Miamisburg released toxic gas, prompting Ohio’s largest evacuation ever.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Miamisburg%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Miamisburg History Center, housed in the former Carnegie library, opens Wednesdays and Saturdays from 1 pm to 4 pm.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.historicalmiamisburg.org/historic-sites/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Market Square, built in 1851 as an open‑air market, still anchors downtown and once housed government offices on its upper floor.",
      "sourceSentenceIds": [
