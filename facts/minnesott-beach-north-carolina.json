  "facts": [
    {
      "id": 1,
      "text": "Minnesott Beach sits in Pamlico County on North Carolina's eastern coast, a quiet seaside community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minnesott_Beach%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "The town’s name comes from an old Indian word meaning 'land of the sky‑tinted waters'.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://minnesottbeachnc.govoffice2.com/?SEC=C4E43D15-92FB-43C6-B4BE-C9DE94ACB1CA"
    },
    {
      "id": 3,
      "text": "Minnesott Beach was once the site of one of the largest Indian trading centers in the South Atlantic states.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://minnesottbeachnc.govoffice2.com/?SEC=C4E43D15-92FB-43C6-B4BE-C9DE94ACB1CA"
    },
    {
      "id": 4,
      "text": "During the 1930s through the 1950s, Minnesott Beach thrived as a vacation destination.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://minnesottbeachnc.govoffice2.com/?SEC=C4E43D15-92FB-43C6-B4BE-C9DE94ACB1CA"
    },
    {
      "id": 5,
      "text": "The town lies along the Neuse River and borders Pamlico Sound, offering calm waterways.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://minnesottbeachnc.govoffice2.com/?SEC=C4E43D15-92FB-43C6-B4BE-C9DE94ACB1CA"
    },
    {
