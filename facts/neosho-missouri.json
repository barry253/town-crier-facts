  "facts": [
    {
      "id": 1,
      "text": "Neosho, nicknamed the \"City of Springs\", grew around abundant springs that once could supply a city of 50,000 people.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neosho%2C_Missouri"
    },
    {
      "id": 2,
      "text": "Founded in 1839, Neosho is the county seat of Newton County and sits in the heart of the four‑state region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://neoshocc.com/explore-neosho/"
    },
    {
      "id": 3,
      "text": "The Neosho National Fish Hatchery, established in 1888, remains a historic landmark and one of the oldest hatcheries west of the Mississippi.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://neoshocc.com/explore-neosho/"
    },
    {
      "id": 4,
      "text": "In 1870 the Atlantic and Pacific Railroad reached Neosho, and the Kansas City Southern Railroad still runs through town today.",
      "sourceSentenceIds": [
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neosho%2C_Missouri"
    },
    {
      "id": 5,
      "text": "A 1939 film set, \"Jesse James,\" was shot at Neosho’s Kansas City Southern depot, with locals serving as extras.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neosho%2C_Missouri"
    },
    {
      "id": 6,
      "text": "The town’s history is preserved in public art, museums, and the restored Hearrell Spring, now a public historic park.",
