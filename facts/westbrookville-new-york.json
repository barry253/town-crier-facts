  "facts": [
    {
      "id": 1,
      "text": "Westbrookville takes its name from Dirck Van Keuren Westbrook, an early 18th‑century settler whose family farmed the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westbrookville_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet’s Fort Westbrook, built during the American Revolution, still stands as a relic of the town’s colonial past.",
      "sourceSentenceIds": [
        10,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Westbrookville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Neversink River carves a shallow valley beside the steep Shawangunk ridge, shaping Westbrookville’s wetlands and falls.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westbrookville_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1697, a 1,200‑acre patent granted to Dutch and Huguenot pioneers, including the Swartwout brothers, marked the first organized settlement.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/westbrookville_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Westbrookville once hosted a blanket mill run by Ashworth & Sons, a notable local industry of its time.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Westbrookville%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the French and Indian War, settlers Gerardus Swartwout and two soldiers were killed near the hamlet, highlighting its frontier tensions.",
      "sourceSentenceIds": [
