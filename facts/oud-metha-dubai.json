  "facts": [
    {
      "id": 1,
      "text": "Oud Metha, also called Al Nasr, takes its name from the Arabic 'عود ميثاء', meaning 'The Victory', reflecting early residents' hopes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oud_metha",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the 1960s and 1970s, Oud Metha became a key settlement spot as expatriates flocked to Dubai's growing trade and oil boom.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/oud_metha",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Dubai Metro's Green Line serves Oud Metha with a dedicated station, linking the area directly to downtown and the airport.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oud_Metha",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Al-Nasr Sports Club, founded in 1970, plays in the UAE League and is headquartered in Oud Metha.",
