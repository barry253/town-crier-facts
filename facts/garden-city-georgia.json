  "facts": [
    {
      "id": 1,
      "text": "Garden City was created in 1939 as Industrial City Gardens to house the workforce for factories and chemical plants west of downtown Savannah.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia"
    },
    {
      "id": 2,
      "text": "Garden City hosts the largest and busiest ocean terminal of the Port of Savannah, the flagship operation of the Georgia Ports Authority.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Part industrial and part residential, the city is home to much of the heavy industry in Chatham County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Garden City's industry is located primarily on its waterfront, as is the case for surrounding communities.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia"
    },
    {
      "id": 5,
      "text": "Garden City is also home to numerous trucking and railway companies, making it a key logistics hub.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_Georgia"
    },
    {
      "id": 6,
      "text": "The Georgia Department of Corrections operates the Coastal State Prison near Garden City.",
