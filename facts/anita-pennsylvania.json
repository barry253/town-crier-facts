    {
      "id": 1,
      "text": "Anita emerged as a mining community in the late 1800s, with West Eureka mines shipping up to 60 coal cars daily to New York Central Railroad by 1897.",
      "sourceSentenceIds": [
        10,
        7,
        6
      ],
      "sourceLabels": [
