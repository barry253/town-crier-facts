      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Preservation efforts honor Anita’s mining heritage, with the Jefferson County History Center curating artifacts from the community’s early mines.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
