      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened February 9, 1891, marking its formal recognition within McCalmont Township.",
      "sourceSentenceIds": [
        29,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/anita_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Anita lies within Jefferson County’s coal‑rich Allegheny Plateau, where European immigrants worked in mines and cleared land for agriculture in the 19th century.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/anita_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The origin of Anita’s name is unclear, though it may stem from a local family or figure, following naming patterns in Jefferson County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
