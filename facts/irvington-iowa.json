  "facts": [
    {
      "id": 1,
      "text": "Irvington was named after the famous American author Washington Irving, whose literary works inspired many settlers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_Iowa"
    },
    {
      "id": 2,
      "text": "The original settlement, known as 'Old' Irvington, was founded by pioneers in 1856, marking the town's first permanent community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_Iowa"
    },
    {
      "id": 3,
      "text": "When the Northwestern Railway was built through the township in 1881, the townsite was moved and 'New' Irvington was laid out.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_Iowa"
    },
    {
      "id": 4,
      "text": "Irvington sits on a low bluff on the east side of the East Fork of the Des Moines River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_Iowa"
    },
    {
      "id": 5,
      "text": "The town sits 1,150 feet above sea level, giving it a modest elevation that shapes its local climate.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://roadsidethoughts.com/ia/irvington-xx-kossuth-profile.htm"
    },
    {
      "id": 6,
      "text": "Its geographic coordinates are 43.0075 degrees north latitude and 94.1955 degrees west longitude, placing it in northwestern Iowa.",
