  "facts": [
    {
      "id": 1,
      "text": "Nestled within Pueblo de Cochiti Indian Reservation, Cochiti Lake offers a serene backdrop for outdoor adventures, including no‑wake boating, hiking, and fishing.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamstates.com/destinations/cochiti-lake-new-mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The lake’s no‑wake rule forces motorized boats to idle speed, creating a calm setting ideal for paddling, sailing, and quiet fishing.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamstates.com/destinations/cochiti-lake-new-mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Visitors can spot osprey, deer, coyotes, river otters, rabbits, and beavers while exploring the lake’s surroundings.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamstates.com/destinations/cochiti-lake-new-mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From the lake, you can see the mesas that rise around it and the distant Jemez Mountains.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamstates.com/destinations/cochiti-lake-new-mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Anglers find a variety of fish, including bass, crappie, walleye, pike, catfish, sunfish, and trout.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roamstates.com/destinations/cochiti-lake-new-mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A $5 day‑use fee per vehicle grants access to the lake’s boat ramp, picnic loop, and swim beach.",
