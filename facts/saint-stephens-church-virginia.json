  "facts": [
    {
      "id": 1,
      "text": "Saint Stephens Church was first authorized by the House of Burgesses in 1710 and served as the parish's primary worship site until after the Revolution.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_stephens_church_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The upper church of Saint Stephens housed the earliest known colonial Virginia sundial, donated by Colonel James Taylor, great‑grandfather of Presidents Zachary Taylor and James Madison.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_stephens_church_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1972 the site was listed on the Virginia Landmarks Register, and a year later added to the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_stephens_church_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The lower church, rebuilt between 1730 and 1734, showcases Flemish bond brickwork and a cruciform plan typical of colonial Anglican architecture.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_stephens_church_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saint Stephens Church sits beside the Mattaponi River in central King and Queen County, a location that shaped early colonial settlement patterns.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_stephens_church_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The parish originated from a 1683 petition by local inhabitants in what was then part of New Kent County, reflecting early Tidewater settlement.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_stephens_church_virginia",
      "category": "history",
      "quality": "good"
    }
