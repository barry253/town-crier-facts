  "facts": [
    {
      "id": 1,
      "text": "Hulme’s name comes from Old Norse holmr, meaning a small island or marshland, hinting at early Norse settlers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wikishire.co.uk/wiki/Hulme",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 16th‑century Hulme Hall, now a private home, showcases the area’s Tudor architecture and long‑standing manor heritage.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townandvillageguide.com/Staffordshire/Hulme.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Musician and TV presenter John Robb still calls Hulme home, keeping the village’s creative spirit alive.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hulme",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2007, the “Temple 2000” sculpture by George Wyllie was unveiled in Hulme Park, celebrating the site of the former Royce factory.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hulme",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hulme Hall’s 16th‑century architecture offers a glimpse into the village’s medieval past, long before industrialization reshaped the area.",
