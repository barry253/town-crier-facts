      ],
      "source": "https://www.townandvillageguide.com/Staffordshire/Hulme.html"
    },
    {
      "id": 3,
      "text": "Musician and TV presenter John Robb still calls Hulme home, keeping the village’s creative spirit alive.",
      "sourceSentenceIds": [
        1
      ],
