  "facts": [
    {
      "id": 1,
      "text": "Mount Perry was laid out in 1828, long before Ohio’s statehood, marking it as one of the earliest planned communities in Perry County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Perry%2C_Ohio"
    },
    {
      "id": 2,
      "text": "A post office has operated in Mount Perry since 1843, making it one of the county’s oldest continuous postal services.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Perry%2C_Ohio"
    },
    {
      "id": 3,
      "text": "The community sits at 39°52′43″N 82°13′12″W, about 900 feet above sea level in the Appalachian foothills.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_perry_ohio"
    },
    {
      "id": 4,
      "text": "Mount Perry’s name honors Commodore Oliver Hazard Perry, whose 1813 Lake Erie victory led to the county’s naming in 1818.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_perry_ohio"
    },
    {
      "id": 5,
      "text": "Madison Township, where Mount Perry lies, was one of Perry County’s original townships, settled around 1800 by pioneers like William Dusenberry.",
      "sourceSentenceIds": [
        1,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/mount_perry_ohio"
    },
    {
      "id": 6,
      "text": "The area’s humid continental climate brings warm summers averaging 83°F and snowy winters dropping to 23°F, with about 41 inches of yearly rain.",
