  "facts": [
    {
      "id": 1,
      "text": "Dunbarton was named after Scotland’s Dumbartonshire, the homeland of settler Archibald Stark.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunbarton%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Originally called Gorham's-town, the settlement became the town of Dunbarton when it was incorporated in 1765.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunbarton%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1791 stone enclosure in Dunbarton still stands as a relic of colonial livestock management.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://localnh.com/towns/dunbarton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Remnants of William Stinson’s mills, including stacked boulder foundations, are visible from a wooden footbridge in the town.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://localnh.com/towns/dunbarton",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Dunbarton claims to host New England’s geographic center, a point calculated by Boston University in 2008.",
