  "facts": [
    {
      "id": 1,
      "text": "Beaverton was first settled by lumbermen around 1863 and was originally called Grand Forks after the Tobacco and Cedar rivers meet.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaverton%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed to Beaverton when Donald Gunn Ross & Sons lumber company founded it in 1890, bringing a Scottish‑named community to Michigan.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaverton%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beaverton became a railroad stop on the Toledo‑Ludington line of the Pere Marquette Railroad, helping it grow into a lumber hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaverton%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1891 Donald Ross was appointed the first postmaster, marking the start of official postal service in the new city.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaverton%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Beaverton proudly calls itself the Plastic Thermoforming Capital of the World, a title earned during the late 20th‑century plastics boom.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://beavertonmi.org/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Beaverton Historical Society, founded in 2006, preserves the town’s past and runs a museum in downtown that showcases local artifacts.",
      "sourceSentenceIds": [
        2,
        13,
        14
      ],
