  "facts": [
    {
      "id": 1,
      "text": "Kadoka was established in 1906 and was originally known as Willard.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.kadokasd.com/?SEC=CDA435EC-4F67-412F-86C7-93001AE39D6A"
    },
    {
      "id": 2,
      "text": "The name Kadoka comes from a Sioux word meaning hole in the wall, referring to the nearby Badlands.",
      "sourceSentenceIds": [
        1,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.kadokasd.com/?SEC=CDA435EC-4F67-412F-86C7-93001AE39D6A"
    },
    {
      "id": 3,
      "text": "Kadoka serves as the county seat of Jackson County, a designation it received in 1915.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kadoka%2C_South_Dakota"
    },
    {
      "id": 4,
      "text": "The town's museum is located in the building that formerly served as the train station.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kadoka%2C_South_Dakota"
    },
    {
      "id": 5,
      "text": "Kadoka began its development in 1906 when the Chicago, Milwaukee, St. Paul and Pacific Railroad extended to the area.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kadoka%2C_South_Dakota"
    },
    {
      "id": 6,
      "text": "The city established its first public library and built a city auditorium in 1962.",
