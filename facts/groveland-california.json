  "facts": [
    {
      "id": 1,
      "text": "Groveland began as a gold rush town, later became a farming community, then hosted Hetch Hetchy water project crews with a railroad yard and hospital.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Groveland%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Iron Door Saloon, built of granite in 1852, survived as a store, post office, and saloon before becoming the town’s oldest drinking spot.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Groveland%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Groveland’s historic hotel, the Groveland Hotel, sits just steps from the Iron Door and has hosted travelers since the 19th century.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/groveland/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name once was “Garrotte,” reflecting a swift justice system that used a large oak tree to execute offenders.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visittuolumne.com/groveland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Groveland serves as a gateway to Yosemite National Park, drawing visitors for over 170 years thanks to its historic Gold Rush roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/groveland/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Groveland Yosemite Gateway Museum showcases Gold Rush artifacts and stories of the indigenous Me-Wuk people, offering a deep dive into local history.",
      "sourceSentenceIds": [
        9
