    },
    {
      "id": 2,
      "text": "Greensboro Bend was once a sparsely settled cedar swamp until the arrival of the railroad in 1872 spurred rapid industrial growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/greensboro_bend_vermont"
    },
    {
      "id": 3,
      "text": "Greensboro Bend sits in the Lamoille River valley and benefits from a microclimate that is cooler and more sheltered than surrounding areas.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/greensboro_bend_vermont"
    },
    {
      "id": 4,
      "text": "The Greensboro Bend United Methodist Church has hosted an annual Game Supper since 1923.",
