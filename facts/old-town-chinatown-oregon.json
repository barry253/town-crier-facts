  "facts": [
    {
      "id": 1,
      "text": "Old Town Chinatown is the official Chinatown of northwest Portland, Oregon.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Chinatown",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood includes the Portland Skidmore/Old Town Historic District, a National Historic Landmark declared in 1977.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Chinatown",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Portland Chinatown Museum opened in 2018, showcasing over 200 previously unseen historical objects about Chinese Portlanders.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portlandchinatownmuseum.org/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum’s permanent exhibit, Beyond the Gate, was created from donated OHS photographs and became a landmark feature after its 2018 grand opening.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portlandchinatownmuseum.org/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Town Chinatown borders the Japanese American Historical Plaza and the Oregon Nikkei Legacy Center, reminders of the former Japantown.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Chinatown",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Roseland Theater, a historic concert venue, sits in Old Town Chinatown and hosts shows that echo the neighborhood’s cultural diversity.",
      "sourceSentenceIds": [
        19
