  "facts": [
    {
      "id": 1,
      "text": "Peru earned its name from the town’s sweeping Adirondack views and farmlands that reminded early settlers of Peru in South America.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Battle of Valcour Island, fought on Lake Champlain in 1776, took place in eastern Peru and was a pivotal Revolutionary War skirmish.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Peru was formed in 1792 from parts of Plattsburgh and Willsboro, creating a new town in Clinton County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1838, Peru ceded land to create the towns of Au Sable and Black Brook.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Peru’s eastern edge borders Lake Champlain, with the lake’s center marking the state line with Vermont.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The empty Heyworth/Mason building on Mason Hill Road is the only surviving remnant of a once-busy mill and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
