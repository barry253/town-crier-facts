  "facts": [
    {
      "id": 1,
      "text": "Hawthorne was named after a lumberman, rancher, and law‑enforcement friend of Yerington, who founded the town in 1880.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawthorne%2C_Nevada"
    },
    {
      "id": 2,
      "text": "The town’s first train arrived April 14, 1881, carrying buyers for new lots, marking the start of its railroad era.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawthorne%2C_Nevada"
    },
    {
      "id": 3,
      "text": "Hawthorne became the county seat of Mineral County in 1911, after the county was created that same year.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawthorne%2C_Nevada"
    },
    {
      "id": 4,
      "text": "The Mineral County Museum, located at 400 Tenth Street, showcases the region’s gold‑mine and boom‑town history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mineralcountymuseum.com/"
    },
    {
      "id": 5,
      "text": "Hawthorne sits almost entirely inside the Hawthorne Army Depot, a massive military installation that surrounds the town.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hawthorne%2C_Nevada"
    },
    {
      "id": 6,
      "text": "Route 95 runs through Hawthorne, connecting it 71 miles north to Fallon and 103 miles southeast to Tonopah.",
