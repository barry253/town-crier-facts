      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888, Kerr, known as “The Father of Flag Day,” founded the American Flag Day Association in Yeadon and led it for fifty years.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
