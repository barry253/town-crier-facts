  "facts": [
    {
      "id": 1,
      "text": "After World II, the Excursion Inlet terminal was dismantled and its materials shipped to rebuild Alaskan towns like Hoonah.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/excursion-inlet/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1946, Excursion Inlet’s military infrastructure was repurposed elsewhere, turning abandoned structures into new community buildings.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/excursion-inlet/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Excursion Inlet began as an Huna Tlingit settlement founded around 1750 when glaciers pushed into Icy Strait.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Excursion_Inlet%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s buildings were designed purely for function, reflecting Alaska’s harsh climate rather than European styles.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/excursion-inlet/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Excursion Inlet’s deep, storm‑protected bay made it a strategic harbor for large vessels before the war.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/excursion-inlet/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A fishing cannery has operated in Excursion Inlet since 1891, and the 1918 plant still runs today.",
