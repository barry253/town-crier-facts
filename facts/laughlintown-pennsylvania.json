  "facts": [
    {
      "id": 1,
      "text": "Laughlintown was founded in 1797 as East Liberty and renamed in the early 1800s to honor founder Robert Laughlin.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/laughlintown_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1785 the Pennsylvania legislature authorized the State Road, later called the Pennsylvania Road, which ran through Laughlintown and linked Pittsburgh to Philadelphia.",
      "sourceSentenceIds": [
        17,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/laughlintown_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Compass Inn, now a National Register museum, was one of six inns serving travelers in Laughlintown during the early nineteenth century.",
      "sourceSentenceIds": [
        6,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Laughlintown%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the Pennsylvania Railroad opened in the 1850s, it bypassed Laughlintown, causing the town’s stagecoach business to decline.",
      "sourceSentenceIds": [
        9,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.compassinn.org/history-of-laughlintown",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Laughlintown sits at the foot of Laurel Hill, the steepest ridge in the Laurel Mountain Range, making it a natural rest stop for westbound travelers.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.compassinn.org/history-of-laughlintown",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Laughlintown keeps a low‑key charm, anchored by the Compass Inn Museum and the Ligonier Valley Historical Society, while hosting local businesses like The Original Pie Shoppe.",
      "sourceSentenceIds": [
        13
      ],
