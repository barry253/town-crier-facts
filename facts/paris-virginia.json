  "facts": [
    {
      "id": 1,
      "text": "Paris, Virginia, was named in 1819 to honor Marquis de Lafayette's 1814 tour of the United States after the War of 1812.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paris%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Paris Historic District, listed on the Virginia Landmarks Register in 2006 and the National Register in 2007, preserves 34 1810–1850 Federal‑style buildings.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/paris_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Manassas Gap Railroad routed south in 1852, Paris was bypassed, preserving its architecture but causing commercial decline.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-0222/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before European arrival, the area that became Paris was part of the Manahoac Siouan‑speaking confederacy’s northern Piedmont territory.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/paris_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The old Ashby Hotel tavern, once the town’s main street hub, was destroyed in 1939 by a runaway truck.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paris%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original 1830 brick Old Meetinghouse served multiple denominations, later became an African‑American school, and now houses private residences.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paris%2C_Virginia",
