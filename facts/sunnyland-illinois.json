  "facts": [
    {
      "id": 1,
      "text": "Sunnyland sits on the north side of U.S. Route 30, a corridor that runs southeast 5 miles to downtown Joliet and northwest 1.5 miles to I‑55.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunnyland%2C_Illinois",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 2,
      "text": "The community lies in the northwest part of Tazewell County, bordered to the west by Joliet and to the south and east by Crest Hill.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunnyland%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Although small, Sunnyland shares its name with communities in Florida, Georgia, Ohio, and Pennsylvania, a fact noted in regional gazetteers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/il/sunnyland-xx-tazewell-profile.htm",
      "category": "other",
      "quality": "poor"
    },
    {
      "id": 4,
      "text": "Sunnyland is part of Tazewell County, Illinois, a county that historically developed around agriculture and early railroad lines.",
