  "facts": [
    {
      "id": 1,
      "text": "Lemont Furnace grew around an iron furnace named Lemont, French for \"the mountain,\" built at Chestnut Ridge's base.",
      "sourceSentenceIds": [
        1,
        2,
        11,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://coalcampusa.com/westpa/connellsville/lemont/lemont.htm"
    },
    {
      "id": 2,
      "text": "In 1871, the Lemont Furnace Company was founded, and by 1877 over 100 coke ovens were built to feed the local iron furnace.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://coalcampusa.com/westpa/connellsville/lemont/lemont.htm"
    },
    {
      "id": 3,
      "text": "The town became a coal patch town, supplying coke to nearby mines and serving immigrant workers in the late 1800s and early 1900s.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lemont_furnace_pennsylvania"
    },
    {
      "id": 4,
      "text": "Lemont Furnace sits 3 miles northeast of Uniontown and about 60 miles southeast of Pittsburgh, within the Pittsburgh metro area.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lemont_Furnace%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Penn State Fayette’s Eberly Campus lies just 2 miles north, linking the community to higher education.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lemont_Furnace%2C_Pennsylvania"
