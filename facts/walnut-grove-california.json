      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walnut_Grove%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Walnut Grove Buddhist Church, founded in 1926, served over 100 members before World War II.",
