  "facts": [
    {
      "id": 1,
      "text": "Menominee was named after the Menominee tribe, whose name means \"wild rice\" gathered along the riverbanks.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Menominee%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Milwaukee Road began passenger service to Menominee station in 1903, but dropped ridership by 1920 and abandoned it in 1927.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Menominee%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the early 1900s, Menominee’s economy shifted from lumber to sugar when the Menominee River Sugar Company built a beet sugar plant, keeping the city alive.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://michigan4you.com/menominee-michigan-history-1900-1950/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city once hosted a world‑leading wicker furniture factory, Lloyd’s, which shipped baby buggies worldwide and employed hundreds.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://michigan4you.com/menominee-michigan-history-1900-1950/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Menominee’s streetcar system, started as horse‑drawn cars, was electrified in the late 19th century, linking it with neighboring Marinette.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://michigan4you.com/menominee-michigan-history-1900-1950/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Menominee Railroad Depot, built in 1903, sits at 219 West Fourth Avenue and once served both freight and passengers.",
