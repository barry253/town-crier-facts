  "facts": [
    {
      "id": 1,
      "text": "Blackwell was originally called James or Jamestown in 1906 before being renamed after an Orient Railroad stockholder named Blackwell.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/txcountyblackwell.htm"
    },
    {
      "id": 2,
      "text": "The city sits at latitude 32.0868 and longitude –100.3176, right in the heart of Nolan County, Texas.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texas.hometownlocator.com/tx/coke/blackwell.cfm"
    },
    {
      "id": 3,
      "text": "Blackwell’s formal boundaries cover just 0.59 square miles, all land, with no water areas inside the city limits.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texas.hometownlocator.com/tx/coke/blackwell.cfm"
    },
    {
      "id": 4,
      "text": "Although the core of Blackwell lies in Nolan County, its municipal limits also extend into neighboring Coke County.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texas.hometownlocator.com/tx/coke/blackwell.cfm"
    },
    {
      "id": 5,
      "text": "The town observes Central Standard Time, shifting to Central Daylight Time in the summer months.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texas.hometownlocator.com/tx/coke/blackwell.cfm"
    },
    {
      "id": 6,
      "text": "Blackwell is part of the Blackwell‑Nolan Division, a regional grouping within Nolan County that shares administrative services.",
      "sourceSentenceIds": [
