  "facts": [
    {
      "id": 1,
      "text": "Graysville was named after its founder, Joe Gray, who opened the first general store and woolen mill in the mid‑1800s.",
      "sourceSentenceIds": [
        1,
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Graysville%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The post office at Graysville opened on August 23, 1849, becoming the town’s first official link to the wider world.",
      "sourceSentenceIds": [
        8,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Graysville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Graysville sits along State Road 63, about seven miles northwest of Sullivan, near the Wabash River’s gentle banks.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/graysville_indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Early settlers clustered near Turman Creek, building log cabins and a 1816 blockhouse before spreading farms along the road by the 1840s.",
      "sourceSentenceIds": [
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/graysville_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Methodist church sprang up in the 1850s, followed by a Presbyterian church in 1871, reflecting Graysville’s growing religious life.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/graysville_indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, the Graysville Guards formed a home‑guard company in 1863, later joining the Indiana Legion.",
      "sourceSentenceIds": [
