  "facts": [
    {
      "id": 1,
      "text": "Frederick got its name from either Frederick II of Prussia or early settler Philipp Friedrich Antes, who opened an inn in 1722.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frederick_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew along the historic Great Road, now Pennsylvania Route 73, linking it to colonial trade routes.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frederick_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Frederick sits in the Perkiomen Creek watershed, where the creek borders Upper Frederick Township and shapes local floodplains.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/frederick_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 20th‑century flood sparked the revitalization that led to Frederick’s historic district designation.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://itourfrederick.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 50‑minute walking tour narrates Frederick’s evolution from 1720 to today, featuring over 200 archival photos.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://itourfrederick.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1919 Upper and Lower Frederick Townships split to better manage growth after the original township formed in 1731.",
      "sourceSentenceIds": [
        16
