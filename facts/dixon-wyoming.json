  "facts": [
    {
      "id": 1,
      "text": "Dixon is named for Bob Dixon, an early white trapper who arrived in the region alongside Jim Baker.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixon%2C_Wyoming"
    },
    {
      "id": 2,
      "text": "Dixon sits in the Little Snake River valley at the foothills of the Sierra Madre Range.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dixon%2C_Wyoming"
    },
    {
      "id": 3,
      "text": "The town of Dixon is known for hosting the annual Little Snake River Valley Rodeo.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wyomingcarboncounty.com/places-to-visit/dixon"
    },
    {
      "id": 4,
      "text": "Dixon Town Hall is listed on the National Register of Historic Places and was originally built in 1911 as a bank.",
      "sourceSentenceIds": [
