  "facts": [
    {
      "id": 1,
      "text": "Barnesville was founded as a railroad town with a watering depot for the Nesquehoning Railroad, later served by the Nesquehoning and Mahanoy Railroad and Lehigh & Susquehanna Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "John Faust first settled Barnesville in 1806, and his family built the first hotel in 1854, sparking the village’s early growth.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnesville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Barnesville hosted two historic amusement parks: Lakeside Park opened in 1880 with a lake and roller‑coaster, and Lakewood Park followed in 1925.",
      "sourceSentenceIds": [
        22,
        23,
        24,
        25,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Barnesville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1960s, Lakeside Park became a dance venue for the Jordan Brothers, while Lakewood hosted the Bavarian Summer Festival for fifteen years.",
      "sourceSentenceIds": [
        29,
        30
      ],
