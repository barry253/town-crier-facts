  "facts": [
    {
      "id": 1,
      "text": "Alma takes its name from the Battle of the Alma, a 1854 conflict that shaped the town’s identity.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alma%2C_Quebec",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The present town of Alma was created in 1962 when four villages—Isle‑Maligne, Naudville, Riverbend, and St‑Joseph d’Alma—merged.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/alma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1920s and 1930s, Alma grew into an industrial hub with a hydro‑electric plant, a paper mill, and an Alcan aluminum smelter that still operate.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alma%2C_Quebec",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alma sits on the southeast shore of Lac Saint‑Jean where the lake empties into the Saguenay River, about 175 km north of Quebec City.",
      "sourceSentenceIds": [
        11,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alma%2C_Quebec",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city hosts the Véloroute des Bleuets, a famed biking circuit that winds through valleys and rivers surrounding Lac Saint‑Jean.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.bonjourquebec.com/en-ca/where-to-go/regions-of-quebec/saguenay-lac-saint-jean/alma",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alma’s sandy beaches along Lac Saint‑Jean attract visitors looking for a relaxed lakeside escape amid the region’s diverse cultural life.",
      "sourceSentenceIds": [
        21
