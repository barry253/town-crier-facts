  "facts": [
    {
      "id": 1,
      "text": "Collinston grew when two intersecting Missouri Pacific Railroad lines crossed the town, turning it into a key cotton and timber transport hub.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/collinston_louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before 1844, Collinston was part of Ouachita Parish, but the new Morehouse Parish split off from Ouachita and Carroll parishes.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/collinston_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits near Bayou Bartholomew, a significant waterway that shapes local agriculture and hydrology.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/collinston_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1700s, the area that is now Collinston was part of the Spanish colony of Louisiana after France ceded the territory to Spain.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/collinston_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original city hall, built in 1928 at 4628 Main Street, now serves as a museum preserving Collinston's history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
