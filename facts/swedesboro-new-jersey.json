  "facts": [
    {
      "id": 1,
      "text": "Swedesboro was originally called Raccoon, named after the Narraticon Lenape word, before settlers renamed it in 1765.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swedesboro%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Trinity “Old Swedes” Church, founded in 1703, is the oldest church in Gloucester County and the third oldest Swedish Lutheran church in the U.S.",
      "sourceSentenceIds": [
        13,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Swedesboro%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Van Leer Log Cabin, once a trading post and later an Underground Railroad station, now sits in New Sweden Park.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Swedesboro%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Swedesboro’s Mortonson‑Van Leer Log Cabin, built by Måns Mortenson in the 17th century, is among the area’s oldest surviving structures.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.islands.com/2150369/swedesboro-new-jersey-outside-philadelphia-quaint-town-charming-architecture-walkable-downtown-local-eats/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s historic district includes four National Register sites, plus the Richardson Avenue School, a former segregated Black school now a heritage landmark.",
