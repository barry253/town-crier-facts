  "facts": [
    {
      "id": 1,
      "text": "Ashland took its name from Henry Clay’s Kentucky estate, the home of the famed “Sage of Ashland.”.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ashlandil.com/about1-c11ei",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Petersburg and Tonica railroad was surveyed through Cass County in 1857, bringing the first settlers to Ashland.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ashlandil.com/about1-c11ei",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1871 the Baltimore & Ohio line ran from Beardstown to Springfield through Ashland, opening a new era of growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ashlandil.com/about1-c11ei",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1915 Ashland boasted four churches, two banks, a high school, a newspaper, and a bustling mix of shops and services.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ashlandil.com/about1-c11ei",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ashland is the youngest village in Cass County, laid out by Richard Yates and others on land owned by Beggs and Crowe.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ashlandil.com/about1-c11ei",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original town plan featured 144 blocks plus public squares, a layout that still frames the village’s streets today.",
      "sourceSentenceIds": [
