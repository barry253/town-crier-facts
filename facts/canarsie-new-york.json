  "facts": [
    {
      "id": 1,
      "text": "Canarsie's name comes from the Canarsees, the Native Americans who first called the waters Canarsie.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://brooklyneagle.com/323861/canarsie-history/"
    },
    {
      "id": 2,
      "text": "Dutch settlers founded Achtervelt in 1636, buying 15,000 acres around Jamaica Bay.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canarsie%2C_Brooklyn"
    },
    {
      "id": 3,
      "text": "Coastal lands around Jamaica Bay, including present‑day Canarsie, were originally settled by the Canarsie Indians.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canarsie%2C_Brooklyn"
    },
    {
      "id": 4,
      "text": "In 1866 a railroad began ferrying passengers to Rockaway Beach, turning Canarsie into a summer resort.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canarsie%2C_Brooklyn"
    },
    {
      "id": 5,
      "text": "By 1867 Canarsie Landing handled ten daily round trips, drawing vacationers to stay for a few hours.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Canarsie%2C_Brooklyn"
    },
    {
      "id": 6,
      "text": "Canarsie Indian leader Penhawitz signed three land agreements with Dutch settlers between 1636 and 1667, ceding much land.",
