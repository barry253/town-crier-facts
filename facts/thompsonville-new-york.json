  "facts": [
    {
      "id": 1,
      "text": "Thompson was named after William A. Thompson, an early settler who served as the first judge of Sullivan County.",
      "sourceSentenceIds": [
        2,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 2,
      "text": "The first European settlers arrived in 1749, creating a settlement near Dutch Pond that would become the town’s nucleus.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 3,
      "text": "Thompson was officially established in 1803 from Mamakating, and in 1826 part of its land was taken from Fallsburg.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thompson%2C_New_York"
    },
    {
      "id": 4,
      "text": "Kutsher’s began in 1907 as a summer boarding farm and evolved into one of the Catskills’ most prominent resorts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thompsontogether.com/history/"
    },
    {
      "id": 5,
      "text": "A canal once traversed Thompsonville, but it was abandoned in 1899; the lake and surrounding land became a private community in 1940.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thompsontogether.com/history/"
    },
    {
      "id": 6,
      "text": "The Anshei Glen Wild Synagogue and Glen Wild Methodist Church are both listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
