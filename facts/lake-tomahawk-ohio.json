  "facts": [
    {
      "id": 1,
      "text": "Lake Tomahawk was created in 1966 by American Realty Service Corporation as a private planned community around a man‑made reservoir.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tomahawk%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 150‑acre spring‑fed lake sits within 630 acres of residential and scenic property, offering a 750‑foot sandy beach and playground.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tomahawk%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 35‑foot average depth and a 65‑foot maximum at the dam make the lake deep enough for swimming, boating, and fishing.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tomahawk%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Six docking areas with 26 slips and a marina that includes a boat‑launching ramp and gasoline pump serve lake users.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tomahawk%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The community’s nine‑member board, elected in thirds each year, governs Lake Tomahawk and maintains a private security force that patrols the lake.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tomahawk%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Tomahawk receives about 37 inches of rain annually, enjoys 162 sunny days, and averages a July high of 84°F, giving it a mild summer climate.",
