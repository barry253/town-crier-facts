  "facts": [
    {
      "id": 1,
      "text": "Weir, Mississippi was founded in 1870 by Confederate Colonel John Weir, who built a water‑powered sawmill and gristmill that gave the town its name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/weir_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Yockanookany River borders Weir to the north, a tributary of the Pearl River that has shaped local flooding patterns.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/weir_mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Weir’s early mills powered cotton agriculture, anchoring the town’s growth amid southwestern Choctaw County’s late‑19th‑century cotton boom.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/weir_mississippi",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Weir incorporated on February 16, 1884, formalizing its status as a municipality after years of informal settlement.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/weir_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A violent tornado struck Weir on April 24, 2010, causing significant damage and leaving a lasting memory among residents.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/weir_mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The John Weir House, recognized by a state historical marker in 2013, stands as a tangible reminder of the town’s founding era.",
