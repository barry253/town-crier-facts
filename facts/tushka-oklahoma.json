    },
    {
      "id": 3,
      "text": "Tushka was known as Lewis in 1905, named after the town's first postmaster, Charles Lewis.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TU024"
    },
    {
      "id": 4,
      "text": "Tushka first incorporated in 1915, disincorporated after fifteen years, and then incorporated again in 1968.",
      "sourceSentenceIds": [
        19,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tushka%2C_Oklahoma"
    },
    {
