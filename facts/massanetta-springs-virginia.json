  "facts": [
    {
      "id": 1,
      "text": "Massanetta Springs began as Taylor’s Springs, a Methodist camp meeting site in 1816.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/082-0509/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1848 Evan Henton turned the springs into a resort, adding a hotel and bathhouses by 1910.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/082-0509/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Landscape architect Charles Gillette redesigned the site in 1923, creating curvilinear roads and a picturesque hillside cottage setting.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tclf.org/landscapes/massanetta-springs",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 900‑seat amphitheater, built for pageants, sits beside a contemporary springhouse and the historic hotel at the center of the layout.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tclf.org/landscapes/massanetta-springs",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "From 1963 to 1989, Massanetta Springs operated as a year‑round Presbyterian conference center before reopening in 1991.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tclf.org/landscapes/massanetta-springs",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The district was added to the National Register of Historic Places in 2005, recognizing its unique blend of religious, recreational, and architectural history.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
