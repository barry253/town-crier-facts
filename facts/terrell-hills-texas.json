  "facts": [
    {
      "id": 1,
      "text": "Terrell Hills takes its name from Frederick Terrell, a local bank president who promoted the area as a residential addition in the late 1920s.",
      "sourceSentenceIds": [
        3,
        4,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.terrell-hills.com/our-city/terrell-hills-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Development of the community began in 1919 when Terrell sold 22.5 acres to the Terrell Hills Community association.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrell_Hills%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community incorporated as a municipality in 1939 after two decades of private association management.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrell_Hills%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1945, Terrell Hills successfully sued to block an annexation attempt by the City of San Antonio, preserving its independence.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrell_Hills%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Terrell Hills sits just five miles northeast of downtown San Antonio, nestled between Alamo Heights and Fort Sam Houston.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Terrell_Hills%2C_Texas",
