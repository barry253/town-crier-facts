  "facts": [
    {
      "id": 1,
      "text": "McLean was laid out on June 22, 1855 by Franklin Price, a Pennsylvania native and brother‑in‑law of Bloomington developer Kersey Fell.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLean%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s original design remains almost unchanged, with streets aligned north‑south and east‑west and a railroad bisecting the square.",
      "sourceSentenceIds": [
        6,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLean%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A widened rectangular area beside the tracks, called “Depot Grounds,” was set aside for the train depot and remains a historic feature.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLean%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The triangle of land northwest of the tracks was set aside as public property and is still used as a park today.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLean%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McLean’s first business was a blacksmith shop, followed by a warehouse built by Dillon, marking the start of local commerce.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McLean%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village is home to the Dixie Travel Plaza, a notable roadside stop on historic Route 66.",
      "sourceSentenceIds": [
        20
