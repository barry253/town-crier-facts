  "facts": [
    {
      "id": 1,
      "text": "Van Wert is named for Isaac Van Wart, one of the captors of Major John André during the American Revolutionary War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Wert%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on land that was once part of the Black Swamp, a vast wetland that early settlers had to drain to farm.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Wert%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Van Wert houses the Brumback Library, the first public library in the United States and one of the nation’s best‑ranked libraries.",
      "sourceSentenceIds": [
        13,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Wert%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1902, the city has celebrated its peony heritage with the annual Van Wert Peony Festival, drawing visitors to its fragrant blooms.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Van_Wert%2C_Ohio",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Marsh Hotel, now a landmark, once welcomed travelers by train and stands as a reminder of the town’s prosperous past.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/ohio-midwest-town-destination/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Main Street’s brick and stone buildings compete for attention, yet together they create a harmonious small‑town symphony that defines Van Wert’s character.",
      "sourceSentenceIds": [
        7,
        11
      ],
