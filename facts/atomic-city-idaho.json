  "facts": [
    {
      "id": 1,
      "text": "Atomic City was called Midway until 1950 because it sits halfway between Blackfoot and Arco.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worldatlas.com/cities/atomic-city-america-s-forgotten-nuclear-town-58548.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "EBR‑1, the world’s first breeder reactor, lit the first usable electricity on December 20, 1951, lighting four 200‑watt bulbs.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worldatlas.com/cities/atomic-city-america-s-forgotten-nuclear-town-58548.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "On July 17, 1955, BORAX‑III powered Arco for about an hour, making it the first community worldwide to run entirely on nuclear electricity.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worldatlas.com/cities/atomic-city-america-s-forgotten-nuclear-town-58548.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The SL‑1 reactor, just a few miles from Atomic City, exploded on January 3, 1961, becoming the only fatal nuclear reactor accident in U.S. history.",
      "sourceSentenceIds": [
        12,
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worldatlas.com/cities/atomic-city-america-s-forgotten-nuclear-town-58548.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1949, the federal government set up the National Reactor Testing Station in the desert near Atomic City, which later became the Idaho National Laboratory.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.worldatlas.com/cities/atomic-city-america-s-forgotten-nuclear-town-58548.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Atomic City disincorporated in 2020 after residents voted to dissolve the town’s municipal charter.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Atomic_City%2C_Idaho",
      "category": "history",
      "quality": "good"
    }
