  "facts": [
    {
      "id": 1,
      "text": "Strangeways Prison was built on former Strangeways Park and Gardens, giving the area its name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HM_Prison_Manchester",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 234‑foot ventilation tower, often mistaken for a watchtower, is a local landmark that dominates the skyline.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HM_Prison_Manchester",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1990 a massive riot at Strangeways led to the Woolf Inquiry and the prison’s complete rebuild and renaming to HM Prison Manchester.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HM_Prison_Manchester",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The prison once housed a permanent gallows; its first execution was Michael Johnson in 1869, and a total of 100 hangings occurred before capital punishment ended.",
      "sourceSentenceIds": [
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HM_Prison_Manchester",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Strangeways was first recorded in 1322 as “Strangwas,” meaning a stream with a strong current in Anglo‑Saxon.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/HM_Prison_Manchester",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area now hosts the Strangeways Research Laboratory, a notable historical site for scientific study.",
