  "facts": [
    {
      "id": 1,
      "text": "Horicon was founded as a lumber mill town and railroad hub on the Rock River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.marshareachamber.com/horicon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits at the southernmost tip of the 32,000‑acre Horicon Marsh, a vast wetland.",
      "sourceSentenceIds": [
        26,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Horicon%2C_Wisconsin",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Horicon hosts the John Deere Horicon Works, where lawn and garden tractors and turf mowers are built.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horicon%2C_Wisconsin",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Horicon Historical Society’s Satterly Clark Home showcases Native American artifacts and early settler life.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://dnr.wisconsin.gov/topic/lands/WildlifeAreas/horicon/humhist.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every Mother’s Day weekend, Horicon Living History Days reenacts events from the 1600s to the Vietnam War.",
