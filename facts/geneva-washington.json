  "facts": [
    {
      "id": 1,
      "text": "The Geneva History Museum sits in the historic Prouty‑Chew House on South Main Street, preserving the town’s past from prehistory to today.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicgeneva.org/geneva-history-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Prouty‑Chew House, named for the families who once lived there, now houses Historic Geneva’s offices and museum collections.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicgeneva.org/geneva-history-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1960, the former private home was donated to Historic Geneva, turning it into a public museum that opened its doors to visitors.",
      "sourceSentenceIds": [
        14,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicgeneva.org/geneva-history-museum/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum’s exhibits trace Geneva’s growth, showcasing artifacts that span from prehistoric times through the present day.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicgeneva.org/geneva-history-museum/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The building stands on the traditional lands of the Onöndowá’ga’ people, also known as the Seneca Nation of the Great Hill.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://historicgeneva.org/geneva-history-museum/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Anyone can visit the Geneva History Museum, where Historic Geneva welcomes guests to explore the town’s rich heritage.",
