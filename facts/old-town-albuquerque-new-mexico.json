  "facts": [
    {
      "id": 1,
      "text": "Old Town Albuquerque was founded in 1706 as the original provincial capital of Santa Fe de Nuevo México.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Albuquerque",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Old Albuquerque Historical Society, founded in 1946, led a grassroots campaign that removed the unpopular WPA walls and bandstand in 1957.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Albuquerque",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A new bandstand and 16 wrought‑iron benches from Chihuahua, Mexico, were installed in the plaza after the WPA removal.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Albuquerque",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Most Old Town buildings date from 1870‑1900, but many were later remodeled to a Territorial or Pueblo Revival style during the 20th century.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Albuquerque",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The plaza’s acequia system once fed surrounding farmland; today only northern and southern lands keep the traditional irrigation.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_Albuquerque",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After Albuquerque’s Balloon Fiesta, live local entertainment is staged daily in Historic Old Town.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
