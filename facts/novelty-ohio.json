      "id": 2,
      "text": "A post office opened around 1900 beside the Cleveland & Eastern Electric Railroad station north of Russell Center, giving the area its name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
