  "facts": [
    {
      "id": 1,
      "text": "Presque Isle Harbor sits on Lake Huron and was once a key shipping hub for the Great Lakes.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://heymichigan.com/places/presque-isle-harbor/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Two historic lighthouses, the Old and New Presque Isle Lighthouses, guard the harbor and are part of a museum complex.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.presqueislelighthouses.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1905 Keeper’s House, now a museum, showcases the lives of lighthouse keepers and their families.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.presqueislelighthouses.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During summer, the New Lighthouse Park stays open year‑round, offering trails and sunrise views over Lake Huron.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.presqueislelighthouses.org/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Volunteers help preserve the lighthouses and the Keeper’s House, keeping Great Lakes maritime history alive.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.presqueislelighthouses.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The harbor’s pier lets visitors watch fishermen haul in giant catches, adding to its waterfront charm.",
