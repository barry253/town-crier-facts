  "facts": [
    {
      "id": 1,
      "text": "Mandaree was founded in 1954 as a refuge for people displaced by the rising backwaters of the Garrison Dam on the Missouri River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mandaree%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name is a portmanteau of the three tribes—Mandan, Hidatsa, and Arikara—suggested by a Catholic missionary on the reservation.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mandaree%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every third weekend in July, Mandaree hosts a nationally noted Pow‑wow that draws visitors from across the region.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mandaree%2C_North_Dakota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mandaree Singers, a tribal musical group, call the town home and perform traditional songs that celebrate the Three Affiliated Tribes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mandaree%2C_North_Dakota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mandaree sits on the Fort Berthold Indian Reservation, serving as the primary physical center of the Mandan‑Hidatsa community.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mandaree%2C_North_Dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Sakakawea Creek marks Mandaree’s southern boundary while Boggy Creek defines its northern edge, both feeding into larger river systems.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
