  "facts": [
    {
      "id": 1,
      "text": "Sparta began as Brock's Station in 1802, named for Granville Brock, before adopting its current name.",
      "sourceSentenceIds": [
        2,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparta%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sparta became a stop on the Louisville & Nashville Railroad, and CSX still runs tracks along Eagle Creek.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparta%2C_Kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eagle Creek flows past Sparta’s center, continuing west to the Kentucky River, a tributary of the Ohio.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparta%2C_Kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early Sparta’s economy hinged on milling, with Ross’s Mill and later a 19th‑century tobacco warehouse shaping the town.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparta_kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sparta Academy, chartered in 1882, represents the town’s early commitment to secondary education.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparta_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
