      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tower City’s historic Reading Railroad station was a key stop on the line that famously appeared in the board game Monopoly.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/pennsylvania_tower-city",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tower City hosts an annual Fall Festival that celebrates its Pennsylvania Dutch heritage with traditional cuisine and customs.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
