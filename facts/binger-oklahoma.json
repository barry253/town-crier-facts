  "facts": [
    {
      "id": 1,
      "text": "Binger was named for Binger Hermann, who served as the General Land Office Commissioner during the town's founding in 1901.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=BI010"
    },
    {
      "id": 2,
      "text": "Binger was established immediately after the opening of the Wichita-Caddo Reservation in August 1901 and organized by the Washita Valley Townsite Company.",
      "sourceSentenceIds": [
        14,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://townofbinger.org/about/"
    },
    {
      "id": 3,
      "text": "Binger serves as the headquarters of the Caddo Nation of Oklahoma, whose people settled in the area during the 1870s.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Binger%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Hall of Fame catcher Johnny Bench spent much of his boyhood in Binger before playing for the Cincinnati Reds.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Binger%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Binger's early economy relied on agriculture in the surrounding area, with peanuts and cotton serving as the principal crops.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Binger%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "The Enid and Anadarko Railway built a line through Binger in 1901, which was later abandoned in 1939.",
      "sourceSentenceIds": [
        17,
        29
      ],
      "sourceLabels": [
