  "facts": [
    {
      "id": 1,
      "text": "Rohrersville’s name first appeared in 1836, honoring David Rohrer whose brick home stood nearby.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s oldest community band, the Rohrersville Cornet Band, was founded by Washington McCoy in 1837 and still plays today.",
      "sourceSentenceIds": [
        1,
        3,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A marble quarry operated by William McCoy supplied stone for the village’s early buildings and helped launch the local marble industry.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rohrersville%2C_Maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1867, the Baltimore and Ohio Railroad’s Washington County Branch reached Rohrersville, sparking a Victorian‑era boom in local architecture.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rohrersville%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Kefauver Place, a historic home in Rohrersville, earned a spot on the National Register of Historic Places in 2005.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rohrersville%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village grew around a grist mill that Frederick Rohrer may have built before 1783, making it a commercial hub for Pleasant Valley farms.",
      "sourceSentenceIds": [
        16
      ],
