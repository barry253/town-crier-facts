      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was first platted by Henry Ernst in 1865, defining its lots amid growing families.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/nunica_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nunica was a key stop on the Grand Trunk Western Railroad’s Grand Haven–Detroit branch, fueling early growth.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nunica%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1935, nearly one‑third of Nunica was destroyed by fire, an event locals call the great Nunica fire.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
