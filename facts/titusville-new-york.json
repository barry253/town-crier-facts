  "facts": [
    {
      "id": 1,
      "text": "Titusville earned its name after a 1873 domino game between Colonel Henry T and Capt. Clark Rice, where the winner chose the town's name.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.titusville.org/history.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Historic Pritchard House on South Washington Ave is open for tours by appointment, offering a glimpse into Titusville’s 19th‑century life.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.titusville.org/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Titusville’s first aviation center opened in 1927 as an emergency mail landing field and later trained auxiliary pilots during World War II.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.titusville.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, the former aviation center is the Arthur Dunn Airpark, a popular spot for skydiving and private aviation enthusiasts.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.titusville.org/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A vintage Hotpoint sign, installed by Sease Electric in the 1950s, still stands prominently on the historic building at 325 South Washington Ave.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
