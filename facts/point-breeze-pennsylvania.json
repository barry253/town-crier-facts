      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Henry Clay Frick's Clayton, a 5.5‑acre estate, sits in Point Breeze and is part of the Frick Art & Historical Center.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
