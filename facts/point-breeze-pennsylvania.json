      "source": "https://en.wikipedia.org/wiki/Point_Breeze%2C_Pittsburgh",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Shady Side Academy Junior School and Environmental Charter School occupy the former Park Place School building in Point Breeze.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Breeze%2C_Pittsburgh",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Point Breeze hosts Westinghouse Park, Mellon Park, and the northern edge of Frick Park, offering ample green space.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Breeze%2C_Pittsburgh",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pulitzer Prize winner David McCullough grew up in Point Breeze, making the neighborhood a birthplace of a celebrated historian.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
