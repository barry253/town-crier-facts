  "facts": [
    {
      "id": 1,
      "text": "Oak Ridge was named for its high ridge and surrounding oak trees, a natural landmark that divides two watersheds.",
      "sourceSentenceIds": [
        15,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Ridge%2C_Missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Andrew Ramsay and Alexander Giboney first settled the area around Ramsey Creek in 1795, marking Oak Ridge’s earliest settlement.",
      "sourceSentenceIds": [
        17,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Ridge%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village organized in 1852 by John M. Wilson, who bought land at $2.50 per acre and opened a store and bar.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Ridge%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Oak Ridge’s first high school, the first in Southeast Missouri, opened November 4, 1874 in a four‑room wooden building.",
      "sourceSentenceIds": [
        21,
        11,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oak_Ridge%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Two churches built in the 1860s—Methodist and Baptist—remain central to Oak Ridge’s historic community, with a former Presbyterian church once standing.",
      "sourceSentenceIds": [
        10,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofoakridge.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Oak Ridge sits about ten miles northeast of Jackson, within the Cape Girardeau–Jackson Metropolitan Statistical Area.",
