    },
    {
      "id": 2,
      "text": "Named after Queen Isabel II, the town of Isabel Segunda was founded in 1844 by Governor Francisco Saínz.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.viequestravel.com/about-vieques/history"
    },
    {
      "id": 3,
      "text": "Vieques Bioluminescent Bay, also called Mosquito Bay, earned Guinness World Records as the brightest bay in 2006 and is a national landmark.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
