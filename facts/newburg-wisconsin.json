    },
    {
      "id": 3,
      "text": "Village founder Barton Salisbury built a dam on the river in 1848 to power his feed and saw mills.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newburg%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "One of the original mills in Newburg operated until 1903, while the other closed in 1939.",
      "sourceSentenceIds": [
