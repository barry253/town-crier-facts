      "id": 1,
      "text": "Gurdon was incorporated in 1880 and named after surveyor Gurdon Cunningham, after a Cairo and Fulton Railroad stop opened in the 1870s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
