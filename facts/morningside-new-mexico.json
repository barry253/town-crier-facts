      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Morningside experiences a semi‑arid BSk climate, with hot July highs around 95°F and January lows near 25°F.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morningside_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The flat topography fuels frequent dust storms that can reduce visibility, especially during spring and early summer.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morningside_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Occasional monsoon thunderstorms can trigger flash floods along the Pecos River, rapidly raising water levels and eroding banks.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/morningside_new_mexico",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Morningside has remained unincorporated since its founding, relying on Eddy County for services rather than forming its own government.",
