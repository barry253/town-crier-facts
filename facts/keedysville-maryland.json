  "facts": [
    {
      "id": 1,
      "text": "Keedysville grew around a grist mill on Little Antietam Creek built circa 1765, serving early German and Swiss settlers.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keedysville%2C_Maryland"
    },
    {
      "id": 2,
      "text": "Jacob Hess bought that mill in 1770, owned most of the area, and the town was once called Hess's Mill before becoming Keedysville.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keedysville%2C_Maryland"
    },
    {
      "id": 3,
      "text": "In the 1860s the B&O Railroad extended a branch from Weverton to Hagerstown, making Keedysville a busy depot midway between the two towns.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keedysville%2C_Maryland"
    },
    {
      "id": 4,
      "text": "The town’s name changed to Keedysville in the 1830s when a post office opened, avoiding confusion with another Centerville in Maryland.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keedysville%2C_Maryland"
    },
    {
      "id": 5,
      "text": "Keedysville was officially chartered as a municipality in 1872, marking its formal recognition as a town.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Keedysville%2C_Maryland"
    },
    {
      "id": 6,
      "text": "Several historic sites, including the Keedysville Historic District and Nicodemus Mill Complex, are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        5
      ],
