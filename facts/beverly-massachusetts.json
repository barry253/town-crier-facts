  "facts": [
    {
      "id": 1,
      "text": "Beverly first appeared on maps in 1626 when Roger Conant and fellow settlers from Gloucester founded the community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicbeverly.net/history-of-beverly/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1668, the settlement separated from Salem and adopted the name Beverly, after England’s Beverley in Yorkshire.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beverly%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad in 1839 brought new factories and a surge of residents to Beverly.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicbeverly.net/history-of-beverly/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1903 until the early 1970s, Beverly housed one of the nation’s largest shoe‑machinery factories.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beverly%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The John Balch House, built around 1679, is one of the oldest surviving colonial homes in Beverly.",
