  "facts": [
    {
      "id": 1,
      "text": "Chief Lake lies within the traditional territory and reservation of the Lac Courte Oreilles Band of Lake Superior Chippewa Indians.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chief_lake_wisconsin"
    },
    {
      "id": 2,
      "text": "Ojibwe hunters established a permanent settlement in the Chief Lake area by 1745 near the headwaters of the Chippewa River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chief_lake_wisconsin"
    },
    {
      "id": 3,
      "text": "Trader Michael Cadotte established the first permanent Northwest Fur Trading Company post in the vicinity of Chief Lake around 1800.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chief_lake_wisconsin"
    },
    {
      "id": 4,
      "text": "Logging peaked in the late 1800s, though operations near Chief Lake often conflicted with Ojibwe land rights under the 1854 treaty.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chief_lake_wisconsin"
    },
    {
      "id": 5,
      "text": "Chief Lake is renowned for its undeveloped shoreline and abundant fishing for walleye, musky, and northern pike.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/chief_lake_wisconsin"
    },
    {
      "id": 6,
      "text": "The landscape around Chief Lake features northern hardwoods and conifers like white pine and hemlock managed for local wildlife.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
