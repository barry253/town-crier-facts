  "facts": [
    {
      "id": 1,
      "text": "The neighborhood’s name came from early developers noticing sunlight dancing across the hills at sunrise and sunset, highlighting the area’s dramatic light shifts.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunlithillssantafeneighborhood.org/sunlit-hills-a-storied-enclave-of-light-landscape-and-legacy-in-santa-fe/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1960s, Sunlit Hills first custom homes were built on generous lots, establishing flat‑roofed adobe houses with Santa Fe‑style vigas that still define the neighborhood.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunlithillssantafeneighborhood.org/sunlit-hills-a-storied-enclave-of-light-landscape-and-legacy-in-santa-fe/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Artists and craftspeople began settling in the early 1970s, and today Sunlit Studios on Canoncito Road hosts open‑house events each October for visitors.",
      "sourceSentenceIds": [
        20,
        2,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunlithillssantafeneighborhood.org/sunlit-hills-a-storied-enclave-of-light-landscape-and-legacy-in-santa-fe/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Driving along Overlook Drive, you’ll pass a preserved stretch of old‑growth juniper that the community protects as a wildlife corridor.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sunlithillssantafeneighborhood.org/sunlit-hills-a-storied-enclave-of-light-landscape-and-legacy-in-santa-fe/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cottonwood Circle Park, opened in 1984, offers picnic tables, wildflowers, and the best view of the first snow on the Ortiz and Sangre de Cristo mountains.",
      "sourceSentenceIds": [
        21,
