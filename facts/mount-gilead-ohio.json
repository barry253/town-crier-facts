    {
      "id": 1,
      "text": "Mount Gilead was founded in 1832, eight years after European settlers first arrived in the area.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gilead%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s original public square was drawn by Judge Jacob Young in 1824 and later expanded by Henry Ustick in 1832.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gilead%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Victory Shaft World War I Monument, erected in 1919, sits in the north public square and honors the town’s highest per‑capita war bond sales.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gilead%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mount Gilead’s early economy relied on mills, a tile factory, and later the well‑known Hydraulic Press Manufacturing Company.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gilead%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s first post office operated out of Charles Webster’s cabin, where he also served as the first postmaster.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Gilead%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Four Mount Gilead properties—Levering Hall, the Morrow County Courthouse, the floral hall, and the James S. House—are listed on the National Register of Historic Places.",
