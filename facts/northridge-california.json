  "facts": [
    {
      "id": 1,
      "text": "Northridge began as the Southern Pacific depot town of Zelzah in 1910, founded by Colonel Henry Hubbard and “Bud” Wright of the Hawk Ranch.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Northridge%2C_Los_Angeles",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The post office and train depot were renamed North Los Angeles in 1929 before finally adopting the name Northridge in 1938.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cd12.lacity.gov/about/council-district-12/northridge",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Long before settlers arrived, the Tongva people—known as the “people of the earth”—called this area home for over two millennia.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Northridge%2C_Los_Angeles",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The San Fernando Valley Museum in Northridge preserves the region’s history, showcasing artifacts that trace the Valley’s shift from farmland to suburb.",
      "sourceSentenceIds": [
        19,
        22,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/san-fernando-valley-museum-northridge/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Northridge’s landscape has attracted film and television productions, thanks to its proximity to Hollywood and its varied backdrops.",
      "sourceSentenceIds": [
        10,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/san-fernando-valley-museum-northridge/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1994 earthquake that shook Northridge was originally thought to have its epicenter there, though later studies placed it just outside the city limits.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
