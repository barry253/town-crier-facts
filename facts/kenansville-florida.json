  "facts": [
    {
      "id": 1,
      "text": "Kenansville was founded in the late 1800s when the Florida East Coast Railroad’s Okeechobee spur arrived, bypassing nearby Whittier.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenansville%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Henry Flagler’s third wife, Mary Lily Kenan Flagler, who inspired the depot’s name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://floridahistoryblog.com/kenansville-is-a-tiny-town-with-a-rich-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1914 the Bank of Kenansville opened across from the depot, and a year later the Piney Woods Inn—later Heartbreak Hotel—opened.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://floridahistoryblog.com/kenansville-is-a-tiny-town-with-a-rich-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Kenansville Cemetery dates back to the town’s early days and remains a key landmark.",
