      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first rail line in the country, the Washington branch of the B&O Railroad, was built through Beltsville in 1835, making it an early rail hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
