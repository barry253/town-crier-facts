  "facts": [
    {
      "id": 1,
      "text": "Minnetrista’s roots trace back millennia, when Dakota people of the Mdewakanton band hunted and fished along Lake Minnetonka’s wooded shores.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/minnetrista_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from Dakota, where minne means 'water' and trista means 'crooked'.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minnetrista%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroad expansion in the late 19th century linked Minnetrista to Minneapolis, letting local berries reach states like Idaho.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/minnetrista_minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Farmland around Minnetrista grows corn, soybeans, hay, and supports local horse ranches.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minnetrista%2C_Minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Minnetrista includes part of Lake Minnetonka, Minnesota’s ninth‑largest lake, and several smaller lakes like Whaletail and Little Long.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minnetrista%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
