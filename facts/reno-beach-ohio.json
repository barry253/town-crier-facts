  "facts": [
    {
      "id": 1,
      "text": "Reno Beach sits in eastern Lucas County, within Jerusalem Township, just 2 miles north of Ohio State Route 2.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reno_Beach%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The community’s flood defenses began in 1902, with private dikes built until 1943 before the Army Corps stepped in.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rbhfcd.org/"
    },
    {
      "id": 3,
      "text": "In 1993, the USACE finished a 7,520‑foot levee, dubbed the Project Segment, protecting the lakeshore from waves.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rbhfcd.org/"
    },
    {
      "id": 4,
      "text": "The Howard Marsh Conservancy District, formed after the 1943 Lake Erie flood, now manages water quality and flood reduction.",
      "sourceSentenceIds": [
        10,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rbhfcd.org/"
    },
    {
      "id": 5,
      "text": "Reno Beach’s latitude and longitude are 41°39'48\"N 83°16'10\"W, placing it at 41.6634,-83.2694 on the map.",
      "sourceSentenceIds": [
        26,
