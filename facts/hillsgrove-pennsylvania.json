  "facts": [
    {
      "id": 1,
      "text": "Hillsgrove Township was originally Plunketts Creek Township when Sullivan County formed in 1847, renamed Hillsgrove by county court in 1856.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsgrove%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first known white resident, Daniel Ogden, arrived around 1786, clearing land and building a house and grist mill on Ogdensburg Creek.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillsgrove_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hillsgrove Covered Bridge, a Burr arch truss built around 1850 by Sadler Rogers, is the longest of Sullivan County’s three covered bridges and joined the National Register in 1973.",
      "sourceSentenceIds": [
        9,
        10,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsgrove%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community sits in the valley of Loyalsock Creek within the Endless Mountains, surrounded by Loyalsock State Forest.",
      "sourceSentenceIds": [
        23,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsgrove%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elevations range from about 804 feet near Loyalsock Creek to 1,909 feet on ridges, creating scenic vistas and cooler temperatures at higher altitudes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hillsgrove_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s early roads, like the 1793 Courson Road and 1800 Genesee Road, enabled lumber transport and migration, shaping Hillsgrove’s development.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
