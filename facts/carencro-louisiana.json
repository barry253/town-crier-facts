  "facts": [
    {
      "id": 1,
      "text": "Carencro’s name comes from the Cajun French word for buzzard, reflecting the large flocks of black vultures that once roosted in the cypress trees.",
      "sourceSentenceIds": [
        1,
        18,
        19
