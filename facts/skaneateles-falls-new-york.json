  "facts": [
    {
      "id": 1,
      "text": "Skaneateles means “long lake,” a name given by the Iroquois to the nearby lake that borders the town.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Skaneateles%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village of Skaneateles Falls was originally part of the Town of Marcellus, which also included today’s Mandana and Mottville.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.skaneateleshistoricalsociety.org/skaneateles-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Because the Erie Canal and railroads never reached Skaneateles, the village kept its intimate, small‑town feel well into the 20th century.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.skaneateleshistoricalsociety.org/skaneateles-history/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "In 1843 the Skaneateles Community bought a large farm and tried to run it as a utopian experiment, but it collapsed in 1846 amid internal strife.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skaneateles%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historians once claimed Skaneateles eclipsed nearby Syracuse as the leading anti‑slavery town in the region during the mid‑1800s.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
