  "facts": [
    {
      "id": 1,
      "text": "Nolanville got its name from Nolan Creek, itself named for explorer Philip Nolan.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/nolanville-tx"
    },
    {
      "id": 2,
      "text": "A post office called Noland Valley opened in 1878, and the railroad arrived in the early 1880s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/nolanville-tx"
    },
    {
      "id": 3,
      "text": "The first telephone lines in Nolanville ran along barbed wire, split into north and south lines by Nolan Creek.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nolanville%2C_Texas"
    },
    {
      "id": 4,
      "text": "The first car appeared between 1900 and 1910, but it also drew customers away to Belton and Killeen, hurting local businesses.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nolanville%2C_Texas"
    },
    {
      "id": 5,
      "text": "In 1921 a new two‑story brick school opened, and in 1938 the original part of the current school plant was added.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nolanville%2C_Texas"
    },
    {
      "id": 6,
      "text": "After a post‑war decline, Nolanville revived in the 1960s and incorporated on March 27, 1961, thanks to the school trustees.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
