  "facts": [
    {
      "id": 1,
      "text": "Founded September 8 1565 by Spanish admiral Pedro Menéndez de Avilés, Saint Augustine is the oldest continuously inhabited European settlement in the continental U.S.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Augustine%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Menéndez named the city San Agustín after the feast day of St. Augustine, whose name the settlers first saw on August 28.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Augustine%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The formal Franciscan outpost Mission Nombre de Dios, founded at the landing point, is perhaps the first mission in what would become the continental United States.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Augustine%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Castillo de San Marcos, a star‑shaped fort built of coquina, still stands as a National Historic Landmark and the oldest masonry fort in continuous use in the Americas.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Augustine%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Saint Augustine’s historic downtown features George Street, a pedestrian thoroughfare lined with over 30 historic houses and museums that celebrate the city’s colonial past.",
      "sourceSentenceIds": [
