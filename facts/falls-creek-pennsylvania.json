  "facts": [
    {
      "id": 1,
      "text": "Falls Creek was platted in 1891 and incorporated in 1900 from part of Washington Township, Jefferson County.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falls_Creek%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough straddles Jefferson and Clearfield counties, annexing a Clearfield tract in 1924 and remaining in both until 2025.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falls_Creek%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name comes from the nearby waterway, Falls Creek that winds through the hills.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falls_Creek%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 19th century, logging and sandstone quarrying powered Falls Creek’s growth, supplying stone for railroads and bridges.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pagenweb.org/~clearfield/individual%20boroughs/falls_creek.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Falls Creek remains a tight‑knit community that still celebrates its logging heritage and offers access to the PA Wilds and Elk Country.",
