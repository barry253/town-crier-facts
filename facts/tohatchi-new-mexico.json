  "facts": [
    {
      "id": 1,
      "text": "Tohatchi means \"water in rock ledge\" and \"water dug out\" in Navajo.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tohatchi%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Red Willow Valley, where Tohatchi sits, was first settled by the Hosteen Nidazzi band of the Dineh.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tohatchi.navajochapters.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Two Grey Hills Trading Post, founded shortly after the 1897 school, remains one of the few Navajo trading posts still operating.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tohatchi%2C_New_Mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tohatchi is the center for Navajo weaving of Two Grey Hills patterns, known for their intricate four‑fold symmetry.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tohatchi%2C_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first school and health station in Tohatchi were built in 1901, following the 1897 Indian school.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tohatchi.navajochapters.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Red Willow Wash, which drains the community, flows northeast toward Coyote Wash, a tributary of the Chaco River.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
