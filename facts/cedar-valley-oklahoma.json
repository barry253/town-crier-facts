  "facts": [
    {
      "id": 1,
      "text": "Cedar Valley is a town in Logan County, Oklahoma, located one mile south of the Cimarron River.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Valley%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The Town of Cedar Valley grew from a family-driven golf club into a distinctive community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofcedarvalley.com/history"
    },
    {
      "id": 3,
      "text": "Developer Duffy Martin constructed the Cedar Valley Golf Club between 1973 and 1974 in rural Logan County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Valley%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Architect Floyd Farley laid out the golf courses while the Martin family guided the planting of greens and carving of ponds.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofcedarvalley.com/history"
    },
    {
      "id": 5,
      "text": "The Cedar Valley Golf Club officially opened on September 20, 1974, and remains managed by the Martin family today.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofcedarvalley.com/history"
    },
    {
      "id": 6,
      "text": "Cedar Valley is built around the privately owned golf club and its associated housing development.",
      "sourceSentenceIds": [
        24
