      "id": 1,
      "text": "Sullivan City was named after Captain Ed Sullivan, a World War veteran who owned a ranch in the area.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
