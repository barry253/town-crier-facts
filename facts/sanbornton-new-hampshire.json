  "facts": [
    {
      "id": 1,
      "text": "In 1748, colonial Governor Benning Wentworth granted the area that is now Sanbornton to John Sanborn and 59 others from nearby towns.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sanbornton%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before adopting its current name, the settlement was originally called Crotchtown.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sanbornton%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Founded in 1952, the Sanbornton Historical Society catalogs and preserves local history, now housed in the town’s historic Lane Tavern.",
      "sourceSentenceIds": [
        3,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sanborntonhistoricalsociety.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lane Tavern building, now the society’s headquarters, also serves as a venue available for rent during special events.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sanborntonhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sanbornton lies between the Pemigewasset and Winnipesaukee rivers, with Salmon Brook draining the landscape toward the Pemigewasset.",
      "sourceSentenceIds": [
        26
      ],
