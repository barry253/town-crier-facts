  "facts": [
    {
      "id": 1,
      "text": "North Vancouver began as Moodyville, a sawmill town founded in 1863 that grew into the largest settlement on Burrard Inlet.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/North-Vancouver",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Sewell Prescott Moody bought the failing mill in 1865, renamed it Burrard Inlet Lumber Mills, and turned it into a community with hotel and the inlet's first school.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Vancouver_(city)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arthur Heywood‑Lonsdale financed Moodyville investments in 1882 through Lonsdale Estates, linking the town to a prominent Vancouver land developer.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Vancouver_(city)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Second Narrows Bridge collapsed into Burrard Inlet on June 17, 1958, marking one of British Columbia's worst engineering disasters.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://monova.ca/education/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2014, North Vancouver officially rebranded its historic waterfront as “The Shipyards,” turning the area into a public gathering spot.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
