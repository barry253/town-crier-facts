  "facts": [
    {
      "id": 1,
      "text": "Kaneville was named after Elias Kane, the first Secretary of State of Illinois, and the village adopted the name in the mid‑1800s.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.wisdomlib.org/cities/kaneville-183423",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first permanent settlers, Amos and Amanda Minor, built their home on Perry Road in 1836, marking the start of Kaneville’s community.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofkaneville.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kaneville grew around the stage‑coach furrows that connected Batavia to Dixon and the trail from Chicago to Galena.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofkaneville.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1960s the Ravlin subdivision doubled the village’s size, expanding its residential footprint.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofkaneville.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s core spans roughly one square mile centered on Main Street and Harter Road, where historic shops and churches still stand.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofkaneville.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kaneville’s quiet rural character sits just 12 miles northwest of Aurora, keeping it close to Chicago while preserving a peaceful atmosphere.",
      "sourceSentenceIds": [
        16
      ],
