  "facts": [
    {
      "id": 1,
      "text": "A 1954 book by Helen Almy West, \"A History of Hamilton Township,\" documents the earliest days of the municipality and is now a rare collector’s item.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hamiltonnj.com/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1756 George May built a shipyard and trading post near Babcock Creek, giving the area its first commercial foothold.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hamiltonhistorical.org/historic-timeline",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The West Jersey and Atlantic Railroad reached Mays Landing in 1880, linking the town to the growing rail network of New Jersey.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hamiltonhistorical.org/historic-timeline",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Mays Landing Water Power Company, founded in 1903, once employed the town’s largest workforce and still houses the Hamilton Historical Society today.",
      "sourceSentenceIds": [
        18
