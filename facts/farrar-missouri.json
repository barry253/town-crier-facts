    },
    {
      "id": 3,
      "text": "The original settlement was called Salem, centered on a Lutheran church built in 1859.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farrar%2C_Missouri"
    },
    {
      "id": 4,
      "text": "In 1890, R.P. Farrar opened the Farrar General Store, then rode to Jefferson City to secure a post office.",
      "sourceSentenceIds": [
