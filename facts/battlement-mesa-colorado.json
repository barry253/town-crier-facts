  "facts": [
    {
      "id": 1,
      "text": "Battlement Mesa is a flat‑topped basalt mesa whose cliff line looks like castle battlements, giving it a crenellated profile.",
      "sourceSentenceIds": [
        1,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveldojo.com/battlement-mesa/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Seven man‑made lakes, the Battlement Reservoirs, line the west side of the mesa and were built in the late 1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.fs.usda.gov/r02/whiteriver/recreation/battlement-mesa-area",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The mesa’s distinctive skyline is a landmark visible from Interstate 70 and the Colorado River corridor.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.traveldojo.com/battlement-mesa/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Battlement Mesa Schoolhouse, built in 1897 and expanded in 1907, now sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
