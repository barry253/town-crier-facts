  "facts": [
    {
      "id": 1,
      "text": "St. Elmo was founded in 1871, originally called Howard's Point before adopting its current name.",
      "sourceSentenceIds": [
        19,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elmo%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A north–south railroad was planned for the area in 1882, but the town was bypassed until an east–west line linked it to Vandalia.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elmo%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The St. Elmo Historical Society, a volunteer nonprofit, was established in 1992 to preserve the town’s artifacts and historic buildings.",
      "sourceSentenceIds": [
        1,
        8,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/8705",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Smith Aviation Field opened in 1926 on the west side of town and became a hub for stunt flying, wing walking, and parachute jumping.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elmo%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Famed aviator Charles Lindbergh was a regular visitor to the town’s aviation field during its heyday.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Elmo%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s total area is just 1.51 square miles, with nearly all of it being land and only a tiny fraction water.",
