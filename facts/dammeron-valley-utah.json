      "id": 1,
      "text": "Brothers John and William Pulsipher named Dammeron Valley in 1862 while driving church cattle and horses in search of better forage lands.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dammeron_valley_utah"
    },
    {
      "id": 2,
      "text": "Mormon pioneers established a short-lived settlement in Dammeron Valley around 1859 before abandoning it due to the challenges of frontier life.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dammeron_valley_utah"
    },
    {
      "id": 3,
      "text": "Dammeron Valley abuts the Red Cliffs National Conservation Area, providing residents and visitors with access to hiking and wildlife viewing.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dammeron_valley_utah"
    },
    {
      "id": 4,
      "text": "Low light pollution and secluded surroundings make the night skies in Dammeron Valley ideal for stargazing.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dammeron_valley_utah"
    },
    {
      "id": 5,
      "text": "Dammeron Valley features a semi-arid high desert climate with hot, dry summers and mild winters with occasional snowfall.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dammeron_valley_utah"
    },
    {
      "id": 6,
      "text": "Modern growth in Dammeron Valley began in the mid-twentieth century, starting with the first recorded subdivision in May 1976.",
