  "facts": [
    {
      "id": 1,
      "text": "Algoma is located on Lake Michigan at the mouth of the Ahnapee River, about thirty miles east of Green Bay.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Algoma%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The city was founded in 1834 by Joseph McCormick and was originally known as the Ahnapee settlement.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Algoma%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Algoma's name may come from an Indian term meaning park of flowers, while the Menominee language calls the town snowshoe.",
      "sourceSentenceIds": [
        6,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Algoma%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Immigrants from Germany, Bohemia, Scandinavia, and Belgium settled in the community during the mid-nineteenth century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Algoma%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The arrival of the Ahnapee and Western Railway in 1892 connected Algoma with the rest of the nation's rail system.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Algoma%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Early industry in Algoma included a sawmill and a furniture factory that eventually transitioned to making high-quality commercial doors.",
