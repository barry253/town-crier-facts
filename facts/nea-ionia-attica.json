  "facts": [
    {
      "id": 1,
      "text": "Nea Ionia takes its name from the ancient Ionia of Anatolia, where most of its 1920s refugees originally came.",
      "sourceSentenceIds": [
        20,
        5,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nea_Ionia"
    },
    {
      "id": 2,
      "text": "Before refugees arrived in 1922, the area that is now Nea Ionia was mainly undeveloped pasture on Athens’ northern plain.",
      "sourceSentenceIds": [
        12,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Nea_Ionia"
    },
    {
      "id": 3,
      "text": "Carpet weaving became the town’s economic backbone, as refugees brought their traditional skills to Athens and opened thriving workshops.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nea_Ionia"
    },
    {
      "id": 4,
      "text": "Nea Ionia is served by three Line 1 metro stations—Nea Ionia, Pefkakia, and Perissos—linking it directly to central Athens.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nea_Ionia"
    },
    {
      "id": 5,
      "text": "The suburb has produced celebrated singers like Stelios Kazantzidis and Maria Farantouri, both icons of Greek popular music.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nea_Ionia"
    },
    {
      "id": 6,
      "text": "Its interwar refugee housing blends neoclassical symmetry with modernist touches, a rare architectural legacy of Greece’s 20th‑century resettlement.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
