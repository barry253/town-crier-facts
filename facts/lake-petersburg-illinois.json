    },
    {
      "id": 3,
      "text": "Petersburg was founded in 1833 by George Warburton and Peter Lukins, friends of Abraham Lincoln.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://petersburgil.org/petersburg-history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Abraham Lincoln surveyed the town in 1835‑1836, and many New Salem residents moved to Petersburg in 1840.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://petersburgil.org/petersburg-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Edgar Lee Masters, author of Spoon River Anthology, lived in Petersburg for eleven years and his house is now the Masters Memorial Museum.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://petersburgil.org/petersburg-history",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town preserves Victorian‑era homes and even some original cobblestone streets on its bluffs.",
