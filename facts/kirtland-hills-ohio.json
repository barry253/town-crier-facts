  "facts": [
    {
      "id": 1,
      "text": "Kirtland Hills was founded by Harry Wheelock King who hired Frederick Law Olmsted to design the village layout in 1922.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kirtlandhills.org/for-residents/history/"
    },
    {
      "id": 2,
      "text": "The village’s name honors Dr. John Kirtland, a prominent early settler whose family owned the land that became Kirtland Hills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kirtlandhills.org/for-residents/history/"
    },
    {
      "id": 3,
      "text": "Little Mountain, rising 1,266 feet, dominates the village’s skyline and hosts the Holden Arboretum’s Children’s Schoolhouse Nature Park.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirtland_Hills%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The original Episcopal chapel, The Church of the Transfiguration, once stood atop Little Mountain before moving to its current location.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kirtlandhills.org/for-residents/history/"
    },
    {
      "id": 5,
      "text": "Kirtland Hills hosts three historic churches, each with a unique story, reflecting the village’s diverse religious heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kirtlandhills.org/for-residents/history/"
    },
    {
      "id": 6,
      "text": "The village’s first year‑round services began in 1972, expanding from seasonal worship that had started earlier.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kirtlandhills.org/for-residents/history/"
