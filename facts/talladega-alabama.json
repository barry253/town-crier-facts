  "facts": [
    {
      "id": 1,
      "text": "The name Talladega comes from the Muscogee word meaning 'border town,' reflecting its position on the historic frontier.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
