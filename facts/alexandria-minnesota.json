  "facts": [
    {
      "id": 1,
      "text": "Alexandria was founded in 1858, the same year Minnesota became a state, and was named after brothers Alexander and William Kinkead from Maryland.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.alexandriamn.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The giant Viking statue, originally built for the 1964 New York World’s Fair, now stands at the north end of downtown on Lake Agnes shore.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexandria%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1898, Swedish immigrant Olof Ohman discovered a greywacke stone in an aspen tree root in Kensington, 15 miles southwest of Alexandria, which became the Kensington Rune Stone.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alexandriamn.org/history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The railroad’s arrival turned Alexandria into a popular vacation spot, thanks to abundant fish and game, a fact that still holds today.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.alexandriamn.org/history.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alexandria hosts an annual Vikingland Band Festival parade marching championship, celebrating its Viking heritage each year.",
      "sourceSentenceIds": [
        16
