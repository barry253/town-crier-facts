  "facts": [
    {
      "id": 1,
      "text": "Topaz was named by Rickey after the quaking aspen trees that turn a striking topaz color in autumn.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topaz%2C_California"
    },
    {
      "id": 2,
      "text": "It sits as the northernmost community in Mono County, right on the California–Nevada border.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topaz%2C_California"
    },
    {
      "id": 3,
      "text": "U.S. Route 395 cuts through Topaz, linking the town south to Bridgeport and north to Carson City.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topaz%2C_California"
    },
    {
      "id": 4,
      "text": "The West Walker River, which flows north into Nevada, drains the Topaz basin and feeds Topaz Lake.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Topaz%2C_California"
    },
    {
      "id": 5,
      "text": "Topaz Lake is famed for its nine‑month trout fishing season, drawing anglers who chase prize‑winning trout.",
      "sourceSentenceIds": [
        24
