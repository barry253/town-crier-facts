  "facts": [
    {
      "id": 1,
      "text": "Arab was founded by Stephen Tuttle Thompson in 1840 and originally called Thompson's Village.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/arab/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name came from a postal error in 1882, misspelling Arad Thompson as Arab.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arab%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arab sits atop Brindlee Mountain at 1,100 feet, on the Tennessee Valley Divide.",
      "sourceSentenceIds": [
        26,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arab%2C_Alabama",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "coordinates"
    },
    {
      "id": 4,
      "text": "The Arab Historic Village, opened in 1991, showcases ten buildings from the late 1800s to the 1940s.",
      "sourceSentenceIds": [
        12,
        11
      ],
      "sourceLabels": [
