    {
      "id": 1,
      "text": "Elijah Wall, a South Carolina settler, founded Putnam Hall in 1849, marking the town’s first permanent home.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Putnam_Hall%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits at the crossroads of State Road 100 and State Road 26, a key junction in northern Florida.",
      "sourceSentenceIds": [
        8,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Putnam_Hall%2C_Florida",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 3,
      "text": "Wall’s son, John P. Wall, served six terms as Putnam County’s first state legislator while living in the town.",
      "sourceSentenceIds": [
        10,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Putnam_Hall%2C_Florida",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1800s, Ley established the Putnam Hall Seminary, educating regional students until 1909.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/putnam_hall_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before the railroad arrived, Elijah Wall ran a sawmill and secured the right‑of‑way for the Florida Southern Railway through Putnam Hall.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/putnam_hall_florida",
      "category": "history",
      "quality": "good"
    },
    {
