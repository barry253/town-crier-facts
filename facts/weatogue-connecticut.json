  "facts": [
    {
      "id": 1,
      "text": "Weatogue, a historic locality on the Housatonic River, sits just south of the Massachusetts border near Bartholomew’s Cobble.",
      "sourceSentenceIds": [
        22,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nativeamericantrail.org/visit/driving-tour/weatogue-and-weatogue-road/"
    },
    {
      "id": 2,
      "text": "Archaeological digs reveal that Native Americans settled in Weatogue for at least 7,000 years before Europeans arrived.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nativeamericantrail.org/visit/driving-tour/weatogue-and-weatogue-road/"
    },
    {
      "id": 3,
      "text": "Weatogue Road likely evolved from an ancient Indian trail that led northward to the settlement near Bartholomew’s Cobble.",
      "sourceSentenceIds": [
        25,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nativeamericantrail.org/visit/driving-tour/weatogue-and-weatogue-road/"
    },
    {
      "id": 4,
      "text": "Before 1740, the Mohican people in Weatogue maintained trade ties with a handful of Dutch settlers from New York Colony.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nativeamericantrail.org/visit/driving-tour/weatogue-and-weatogue-road/"
    },
    {
      "id": 5,
      "text": "After Salisbury’s 1741 incorporation, the Mohican community was pressured to sell their lands but kept ownership of Weatogue.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nativeamericantrail.org/visit/driving-tour/weatogue-and-weatogue-road/"
    },
    {
      "id": 6,
      "text": "Weatogue’s original settlement lies at the junction of US 202 (Hopmeadow Street) with Canal Street and Stratton Brook Road.",
      "sourceSentenceIds": [
