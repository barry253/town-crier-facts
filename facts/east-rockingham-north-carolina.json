      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Downtown East Rockingham is being transformed under a ten‑year plan called “Shaping Our Future: 2023,” aiming to breathe new life into historic streets.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
