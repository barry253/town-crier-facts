      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clintonville_(Columbus%2C_Ohio)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Park of Roses in Whetstone Park hosts an annual Rose Festival and Sunday concerts by Columbus brass bands each summer.",
