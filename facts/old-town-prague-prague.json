  "facts": [
    {
      "id": 1,
      "text": "In 1348, Charles IV founded the University of Prague, making Old Town a cradle of medieval scholarship.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_(Prague)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Old Town’s medieval walls once encircled the city, their moat now hidden beneath streets like Revoluční and Národní.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_(Prague)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Town Hall, rebuilt in 1338 from a patrician house, still stands as a testament to 14th‑century civic pride.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_(Prague)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1992, the historic centre of Old Town was inscribed on UNESCO’s World Heritage List, recognising its architectural legacy.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Prague",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Charles Bridge, linking Old Town to the Lesser Town across the Vltava, has been a vital artery since the 14th century.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Old_Town_(Prague)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Old Town Square hosts the famous Astronomical Clock, a medieval timepiece that draws crowds every hour with its moving figures.",
      "sourceSentenceIds": [
        23
