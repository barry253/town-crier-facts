  "facts": [
    {
      "id": 1,
      "text": "Union Valley, founded in the 1860s, peaked in 1892 with 300 residents, three general stores, and a bustling district around Harriet Smith Beaty’s 1872 log schoolhouse.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/union-valley-texas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad bypassed Union Valley in the late 1880s and again in 1906, leaving only 25 residents by the 1980s.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/union-valley-texas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historical markers on FM 1681 honor Union Valley’s past, including the 1877 schoolhouse that served multiple community functions.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/union-valley-texas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Union Valley sits on Farm Road 1681, twenty‑two miles northeast of Floresville in eastern Wilson County.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/union-tx-wilson-county",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Harriet Smith Beaty’s log schoolhouse doubled as a school, church, and community center, reflecting Union Valley’s resourcefulness before its decline.",
