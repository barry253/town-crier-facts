      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.briggslibrary.org/content/south-point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A public library branch of Briggs Lawrence County Public Library serves South Point, linking the community to regional resources.",
      "sourceSentenceIds": [
        9
