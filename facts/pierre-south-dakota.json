  "facts": [
    {
      "id": 1,
      "text": "Founded in 1880 as the western terminus of the Chicago and North Western Railway, Pierre was named after fur trader Pierre Chouteau Jr.",
      "sourceSentenceIds": [
        1,
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.britannica.com/place/Pierre-South-Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pierre became South Dakota’s capital in 1889, chosen for its geographic centrality, and remained after elections in 1890 and 1904.",
      "sourceSentenceIds": [
        2,
        7,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://pierre.org/visit-pierre-south-dakota/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city sits on the east bank of the Missouri River opposite historic Fort Pierre, a former trading post that grew into a community.",
      "sourceSentenceIds": [
        5,
        11,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pierre%2C_South_Dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pierre’s riverside setting is dramatic, perched on rough bluffs overlooking the Missouri River.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pierre%2C_South_Dakota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pierre hosts the Flaming Fountain veterans’ memorial and the Cultural Heritage Center, the headquarters of the South Dakota State Historical Society.",
      "sourceSentenceIds": [
        17
