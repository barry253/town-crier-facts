      ],
      "source": "https://en.wikipedia.org/wiki/Wallace%2C_Idaho",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Oasis Bordello Museum preserves a former brothel, offering tours of the upstairs as it was when the women left.",
