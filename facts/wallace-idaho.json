      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wallace%2C_Idaho",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wallace has been the world's largest silver producer for over a century, making it the richest mining town and the town on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitnorthidaho.com/community/wallace-idaho/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Northern Pacific depot, now a railroad museum on Sixth and Pine, is listed on the National Register of Historic Places.",
