  "facts": [
    {
      "id": 1,
      "text": "Hobson City was named after Richmond Pearson Hobson, a hero of the Spanish‑American War.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofhobsoncity.com/about/"
    },
    {
      "id": 2,
      "text": "When it was founded in 1899, Hobson City became Alabama’s only town governed entirely by African Americans.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/hobson-city/"
    },
    {
      "id": 3,
      "text": "Hobson City’s first school, the Hobson City and Oxford Academy, opened in 1905.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/hobson-city/"
    },
    {
      "id": 4,
      "text": "Hobson City, founded in 1899, remains Alabama’s oldest black municipality, a testament to early African‑American self‑governance.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://townofhobsoncity.com/about/"
    },
    {
      "id": 5,
      "text": "The Chief Ladiga Trail, one of the nation’s longest paved bike paths, winds through Hobson City’s scenic hills.",
