  "facts": [
    {
      "id": 1,
      "text": "Silas was founded in the late 1800s and named after early settler Silas Shoemaker, who became the town’s first postmaster in 1880.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silas_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1911 the Alabama, Tennessee, and Northern Railroad cut through Silas, shifting the town’s center toward the tracks and sparking timber and cotton commerce.",
      "sourceSentenceIds": [
        10,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/silas/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A garment factory opened in 1950 in Silas, employing up to 200 workers at its peak.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/silas/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Silas Elementary School Building, erected in 1936, served students until 2005 before becoming a historic landmark.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silas_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Silas Community House, a preserved early‑20th‑century residence, was repurposed in 2001 as a community center.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/silas_alabama",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "On March 17, 2021, an EF2 tornado struck Silas, damaging trees and inflicting minor damage to outbuildings.",
