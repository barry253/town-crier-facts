  "facts": [
    {
      "id": 1,
      "text": "Garden City was founded in 1869 by Alexander Turney Stewart, one of the first planned communities in the United States.",
      "sourceSentenceIds": [
        9,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.longislandguide.com/visit/garden-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Garden City founder Alexander Turney Stewart built the Central Railroad of Long Island, giving the village its own rail line from Long Island City to the east.",
      "sourceSentenceIds": [
        11,
        12,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After Garden City founder A.T. Stewart died in 1876, his widow Cornelia erected the Cathedral of the Incarnation, a Gothic Revival church built as his memorial.",
      "sourceSentenceIds": [
        4,
        5,
        6,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.gardencityny.net/228/Village-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Garden City’s Waldorf School opened in 1947 as one of the first Waldorf schools in the U.S., originally part of Adelphi University.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Garden_City%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The name ‘Garden City’ reflects founder A.T. Stewart’s vision of a green, tree-lined community, realized through wide avenues and a 30-acre park.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gardencityny.net/228/Village-History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Cradle of Aviation Museum in Garden City showcases Long Island’s deep connection to aviation history.",
      "sourceSentenceIds": [
