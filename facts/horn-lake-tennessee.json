  "facts": [
    {
      "id": 1,
      "text": "Horn Lake got its name from a former ox‑bow lake that once lay three miles west, a stranded riverbed that looks like a cow horn.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horn_Lake%2C_Mississippi",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the Mississippi and Tennessee Railroad in 1856, with a depot in Horn Lake, sparked the town’s early growth by linking it to regional trade routes.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horn_Lake%2C_Mississippi",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Horn Lake is home to the American Contract Bridge League headquarters, a national hub that hosts a Hall of Fame, museum, and library for the game.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Horn_Lake%2C_Mississippi",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Elvis Presley once rode horses on the Circle G Ranch near Horn Lake, and the site is now slated to become a tourist attraction that preserves that history.",
      "sourceSentenceIds": [
        4,
        15,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.desototimes.com/news/6-5-billion-tourist-attraction-proposed-in-horn-lake/article_56563375-d6c7-4afc-ac05-4365cd247b3d.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Baron Storm plans a $6.5 billion development that will include a 100,000‑seat stadium comparable to SoFi Stadium, capable of hosting everything from NFL games to international rugby.",
      "sourceSentenceIds": [
        1,
        4,
        19
      ],
