      "id": 1,
      "text": "Arroyo Grande’s downtown Village corridor hosts five museums and a historic reference library that showcase artifacts from early settlers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Arroyo_Grande%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Paulding History House, built in 1889, remains one of only two homes in town ever inhabited by the same families.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitarroyogrande.org/peek-into-a-g-s-history-at-local-museums/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Swinging Bridge, first erected in 1875 by the Short family, was restored in May 2024 to preserve its historic charm.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arroyo_Grande%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Barn Museum annex houses antique vehicles and agricultural artifacts that tell the story of South County’s farming past.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitarroyogrande.org/peek-into-a-g-s-history-at-local-museums/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Arroyo Grande’s Recreation Services Department earned “Best Place to Work” and “Best Summer Camp” titles in The Tribune’s Best of the Central Coast contest.",
