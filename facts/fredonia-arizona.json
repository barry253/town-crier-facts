  "facts": [
    {
      "id": 1,
      "text": "Fredonia was founded in 1885, its name blending the Latin word for freedom with Columbia to honor early settlers’ patriotic hopes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/high-country-forest-communities/fredonia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew from a single irrigation ditch and adobe home, building itself from the soil up rather than from mining or railroads.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/high-country-forest-communities/fredonia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fredonia sits high on Arizona’s northern plateau, overlooking the Grand Staircase and serving as the gateway to the North Rim of the Grand Canyon.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fredonia%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic dam built by five entrepreneurs in the late 1800s turned the area into irrigated farmland, sparking the town’s early growth.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fredoniaaz.gov/history-of-fredonia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The local historical society preserves pioneer-era buildings, LDS meetinghouses, and historic cemeteries, keeping Fredonia’s early architecture alive.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://azpaths.com/towns-and-cities/high-country-forest-communities/fredonia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before settlers arrived, the Anasazi civilization flourished here, reaching a cultural peak around 1300 A.D. before moving southward.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
