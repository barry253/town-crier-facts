    },
    {
      "id": 2,
      "text": "The borough lies on the north side of the Susquehanna River, bordered east by Berwick, west by South Centre Township, and north by Briar Creek Township.",
      "sourceSentenceIds": [
        7,
        8,
        29,
        30
