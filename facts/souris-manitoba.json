      ],
      "source": "https://en.wikipedia.org/wiki/Souris%2C_Manitoba",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s longest historic cable‑stayed footbridge, the 177‑meter Swinging Bridge, spans the Souris River.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Souris%2C_Manitoba",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Swinging Bridge was built in 1904 and replaced in 2013 after flood damage.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Souris%2C_Manitoba",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early settlers arrived in 1880 when Captain Gilbert Wood and family chose Plum Creek for a mill.",
      "sourceSentenceIds": [
        24,
        25,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Souris%2C_Manitoba",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hillcrest Museum preserves artifacts from early prairie life, Aboriginal collections, and the town’s war contributions.",
