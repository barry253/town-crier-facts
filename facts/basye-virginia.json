  "facts": [
    {
      "id": 1,
      "text": "Basye takes its name from Martha Basye, the wife of William Brice who opened the town’s first resort.",
      "sourceSentenceIds": [
        1,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Basye%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1909, William Brice opened Bryce’s Hillside Cottages and Mineral Baths, the seed of today’s Bryce Resort.",
      "sourceSentenceIds": [
        22,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://explorebasye.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The early resort featured hillside cottages, a dining hall that grew its own food, and mineral baths that drew city dwellers.",
      "sourceSentenceIds": [
        13,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Basye%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In December 1965, Pete Brice opened ski slopes with artificial snowmaking, turning Basye into a winter destination.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://explorebasye.com/history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A Basye family cemetery remains near a golf‑course hole at Bryce Resort, a living reminder of the town’s founders.",
      "sourceSentenceIds": [
