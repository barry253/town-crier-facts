  "facts": [
    {
      "id": 1,
      "text": "Linoma Beach got its name because the resort sat halfway between Lincoln and Omaha.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://omahaexploration.com/2023/10/30/linoma-beach/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The resort was built on a former sand and gravel quarry owned by Lyman‑Richey until 1915.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://omahaexploration.com/2023/10/30/linoma-beach/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The abandoned sand pits were converted into lakes fed by an underground spring.",
      "sourceSentenceIds": [
        2,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://omahaexploration.com/2023/10/30/linoma-beach/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2003, the resort and its lighthouse were added to the National Register of Historic Places.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://omahaexploration.com/2023/10/30/linoma-beach/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The lighthouse’s base once served as a gas station before becoming a tourist attraction.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Linoma_Beach",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A platform and lights were built to entice the Chicago, Burlington and Quincy Railroad to stop at Linoma.",
