      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Upplands_V%C3%A4sby",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Optimus factory, founded in 1908, operated until 1983 before moving to Småland; the company still exists as Optimus International AB.",
      "sourceSentenceIds": [
        4,
        22
