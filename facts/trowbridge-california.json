  "facts": [
    {
      "id": 1,
      "text": "Trowbridge Island earned its name from Charles Trowbridge, a New Yorker who owned the Silver Islet Mine in the 1800s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bayviewmagazine.com/article/2024/06/100-years-trowbridge"
    },
    {
      "id": 2,
      "text": "The Trowbridge Light Station, a 35‑ft concrete tower, was erected in 1919 and still shines over Lake Superior today.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bayviewmagazine.com/article/2024/06/100-years-trowbridge"
    },
    {
      "id": 3,
      "text": "In 1906 the SS Theano struck Trowbridge Island’s reef, a collision that underscored the need for reliable navigation aids.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bayviewmagazine.com/article/2024/06/100-years-trowbridge"
    },
    {
      "id": 4,
      "text": "The island rose from glacial melt over thousands of years, becoming a prominent ridge that once marked the largest lake in the world.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bayviewmagazine.com/article/2024/06/100-years-trowbridge"
    },
    {
      "id": 5,
      "text": "Even today, the lighthouse’s original optics remain in place, a rare glimpse into early 20th‑century maritime technology.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bayviewmagazine.com/article/2024/06/100-years-trowbridge"
    },
    {
      "id": 6,
      "text": "Trowbridge’s 80‑foot‑high ridge sits on an eight‑acre island, making it a visible beacon for ships entering Thunder Bay.",
      "sourceSentenceIds": [
        29
      ],
