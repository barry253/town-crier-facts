  "facts": [
    {
      "id": 1,
      "text": "Jonesville, founded in 1811 as Martinsborough, is the oldest town in Yadkin County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Revolutionary and Civil Wars, Jonesville served as a military out‑post and is now preserving that legacy in its historic Bicentennial Park.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s Mineral Springs Park hosts a Tri‑County Veterans’ Memorial listing over 3,000 names of soldiers from pre‑Revolutionary conflicts to today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1980, Governor Jim Hunt honored Jonesville as a “Governor’s Community of Excellence” for its economic development.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Jonesville sits on the south bank of the Yadkin River, just below Daniel Boone’s hunting trails in the Brushy Mountains foothills.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town is a gateway to the Blue Ridge Mountains and the Yadkin Valley wine region, with more than a dozen wineries within 15 miles.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jonesville%2C_North_Carolina",
