  "facts": [
    {
      "id": 1,
      "text": "Breaks earned its name from the 'break' in Pine Mountain, a range that stretches across the Kentucky‑Virginia border.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Breaks%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At the Visitor Center, a historic museum, a moonshine still, and the Counts’ Family cabin showcase local heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.breakspark.com/breaksparkinfo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Breaks is an outdoor adventurer’s paradise, offering 25 miles of hiking, biking, horseback riding, and fishing all year round.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explorescottcountyva.org/state-parks/breaks-interstate-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 725‑foot swinging bridge, slated to open next year, will become the longest of its kind in the country.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explorescottcountyva.org/state-parks/breaks-interstate-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "When finished, the bridge will link Virginia’s Appalachian Trail with Kentucky’s Pine Mountain Trail and a section of the TransAmerica Bike Trail.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explorescottcountyva.org/state-parks/breaks-interstate-park/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Breaks Lodge houses 76 rooms, including a two‑room suite equipped with a kitchenette, cookware, and dishes.",
