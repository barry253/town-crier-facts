      "id": 1,
      "text": "Union Springs was named for the mineral springs that attracted early settlers and the Cayuga Nation.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Springs%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village incorporated in 1848, becoming a formal community after the Cayuga returned their lands.",
      "sourceSentenceIds": [
        13,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Springs%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Peter Yawger House, a historic home, earned a spot on the National Register of Historic Places in 2004.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Springs%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Several other buildings, including the Almeron Durkee House and Chase House, were listed on the National Register in 2005.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Springs%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Union Springs sits on the east shore of Cayuga Lake, just north of Frontenac Island, the Finger Lakes' only naturally occurring island.",
      "sourceSentenceIds": [
        21,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Springs%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village hosts Union Springs Academy, a Seventh‑day Adventist boarding school that has educated generations since its founding.",
