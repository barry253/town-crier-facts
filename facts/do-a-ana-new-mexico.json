  "facts": [
    {
      "id": 1,
      "text": "Doña Ana takes its name from Doña Ana Robledo, who died there in 1680 while fleeing the Pueblo Revolt.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Do%C3%B1a_Ana%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1843, Doña Ana is the oldest permanent Hispano settlement in southern New Mexico.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/articles/000/new-mexico-dona-ana-village-historic-district.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Twenty‑seven buildings in Doña Ana’s historic two‑block core still stand as they were built in 1843.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/articles/000/new-mexico-dona-ana-village-historic-district.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The railroad’s arrival in the 1880s ended El Camino Real’s trade and cut Doña Ana’s commercial prospects.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/articles/000/new-mexico-dona-ana-village-historic-district.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cristo Rey Street follows the historic El Camino Real de Tierra Adentro route through Doña Ana’s village center.",
