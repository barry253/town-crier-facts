  "facts": [
    {
      "id": 1,
      "text": "Ravine takes its name from the surrounding ravine-like topography of this low-lying valley in Schuylkill County.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ravine_pennsylvania"
    },
    {
      "id": 2,
      "text": "Early settlers in Ravine included German immigrants who cleared land for homesteads and timber operations starting around 1790.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ravine_pennsylvania"
    },
    {
      "id": 3,
      "text": "The industrial growth of Ravine was closely tied to the anthracite coal mining boom during the late 19th century.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ravine_pennsylvania"
    },
    {
      "id": 4,
      "text": "Ravine lies within the Southern Anthracite Coal Field, where sedimentary layers of sandstone and shale shape the undulating landforms.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ravine_pennsylvania"
    },
    {
      "id": 5,
      "text": "The local environment of Ravine is predominantly rural and forested, featuring Appalachian oak forests and mixed hardwoods.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/ravine_pennsylvania"
    },
    {
      "id": 6,
      "text": "Surface waters in Ravine drain toward the Susquehanna River basin and are influenced by the Swatara Creek watershed.",
      "sourceSentenceIds": [
