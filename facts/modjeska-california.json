  "facts": [
    {
      "id": 1,
      "text": "Modjeska takes its name from Helena Modjeska, a Polish actress who settled in the canyon in the late 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Modjeska_Canyon%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pleasants Stone House, built in the 1870s, has been restored and is now open to the public for the first time in park history.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ocgov.com/press/oc-parks-completes-restoration-historic-pleasants-stone-house-modjeska-canyon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arden, Helena Modjeska’s home from 1888 to 1906, is a National Historic Landmark.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Modjeska_Canyon%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1990, Arden became one of only two Orange County sites to earn National Historic Landmark status.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ocgov.com/press/oc-parks-completes-restoration-historic-pleasants-stone-house-modjeska-canyon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The canyon first appears in historical records in 1769 when Governor Portola celebrated Saint Anne’s feast day.",
