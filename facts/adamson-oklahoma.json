  "facts": [
    {
      "id": 1,
      "text": "Adamson is a ghost town in Pittsburg County that has since been largely engulfed by Eufaula Lake.",
      "sourceSentenceIds": [
        22,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Adamson%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town was named for Peter Adamson, a mine owner who founded the Adamson Coal Company.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Adamson%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Adamson grew into a thriving industrial hub with fifteen coal mines, four of which were major producers.",
      "sourceSentenceIds": [
        17,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/adamson_oklahoma"
    },
    {
      "id": 4,
      "text": "Rock Island and Katy railroads both built spurs to ship coal from Adamson during its mining heyday.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Adamson%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Modern remnants of Adamson include a small cemetery and a monument to deceased miners preserved amid the abandonment.",
      "sourceSentenceIds": [
