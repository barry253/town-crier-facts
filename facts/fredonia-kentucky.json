  "facts": [
    {
      "id": 1,
      "text": "Fredonia was founded in 1835 as a voting precinct midway between stagecoach stops at Princeton and Salem, then renamed in 1837 after founder Harvey W.’s daughter.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887 the Ohio Valley Railroad ran just half a mile west of Fredonia, linking the town to the regional rail network.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.ky.gov/markers/fredonia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1890s-era Fredonia Cumberland Presbyterian Church, a historic landmark listed on the National Register of Historic Places, stands as a testament to the town’s heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fredonia’s surroundings are shaped by the nearby Pennyrile State Forest, whose diverse flora and fauna influence the local ecology.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_kentucky",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s economy remains rooted in agriculture, with small businesses thriving alongside farms that benefit from fertile soils and reliable moisture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fredonia_kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fredonia lies within Kentucky’s Western Coal Field physiographic province, a region known for its coal deposits and rolling landscapes of Pennsylvanian sedimentary rocks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
