      "quality": "good"
    },
    {
      "id": 3,
      "text": "Diamond Ridge Road snakes across the ridge's 5‑mile top, linking feeder roads on either side.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Diamond_Ridge%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Homer Demonstration Forest, an arboretum on the ridge's slopes, hosts self‑guided trails and the Homestead Trail that climbs to Crossman Ridge.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Diamond_Ridge%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Diamond Creek State Recreation Area offers day‑use only access; its steep road forbids vehicles over 25 feet and camping is prohibited.",
      "sourceSentenceIds": [
        26,
