  "facts": [
    {
      "id": 1,
      "text": "Tuckahoe earned the nickname “the marble capital of the world” after quarrying along the Bronx River drove its growth in the 19th and early 20th centuries.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tuckahoehistorycommittee.com/landmarks",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s first marble quarry opened in 1812, founded by Masterson who leveraged his wealth to launch Tuckahoe’s marble industry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tuckahoe_(village)%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tuckahoe Train Station, built in 1901 by the New York Central Railroad and designed by Reed & Stem, now serves as a key commuter stop and historic landmark.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tuckahoehistorycommittee.com/landmarks",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original water‑powered cotton mill, constructed around 1812–1814, remains one of the last surviving industrial buildings and now operates as a restaurant.",
      "sourceSentenceIds": [
        11,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tuckahoehistorycommittee.com/landmarks",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shiloh Baptist Church, founded in 1913, stands at 15 Marble Place and reflects the early 20th‑century religious life of Tuckahoe.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tuckahoehistorycommittee.com/landmarks",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Washington Hotel, built in 1883 by quarry superintendent Samuel Fee, is one of Tuckahoe’s most notable historic buildings on Main Street.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tuckahoehistorycommittee.com/landmarks",
      "category": "landmark",
      "quality": "good"
    }
