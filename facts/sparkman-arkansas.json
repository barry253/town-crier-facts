  "facts": [
    {
      "id": 1,
      "text": "Sparkman was founded in 1892 as a lumber mill town by Lemuel 'Pete' Sparkman, with a post office opening in 1893 and about 150 residents by 1899.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparkman_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named after its founder, Lemuel 'Pete' Sparkman, and was officially incorporated on January 15, 1915, becoming the fifth incorporated city in Dallas County.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparkman%2C_Arkansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After timber resources dwindled, Sparkman moved to a new site near the Malvern and Camden Railroad between 1911 and 1913, sparking a revival.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparkman_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first newspaper, the Sparkman News, was founded by Burdine and began publishing in 1915, marking the town's first local press.",
      "sourceSentenceIds": [
        5,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sparkman_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sparkman’s first school was a two‑story building that opened with 132 students, reflecting the town’s early commitment to education.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparkman%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Country music stars Bonnie Brown and Jim Ed Brown hail from Sparkman, linking the town to the genre’s rich heritage.",
