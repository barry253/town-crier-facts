  "facts": [
    {
      "id": 1,
      "text": "Spokane began as Spokane Plantation, a cotton plantation established in Concordia Parish during the antebellum era along the Mississippi River delta.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spokane_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Conner family, originally from South Carolina, moved into Louisiana in the 1840s and bought Spokane to exploit the fertile alluvial soils for cotton.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spokane_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Spokane sits on the southwestern shore of Lake St., a 2,200‑acre oxbow lake formed by a former Mississippi River meander.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spokane_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 1850s, Spokane’s cotton production relied on a network of brokerage firms in New Orleans and levee maintenance to curb flooding.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/spokane_louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s humid subtropical climate brings long, hot summers with highs often above 92°F and mild winters averaging around 39°F.",
