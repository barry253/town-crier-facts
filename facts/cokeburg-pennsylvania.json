  "facts": [
    {
      "id": 1,
      "text": "Ellsworth Coal Company built Cokeburg in 1900, constructing 127 miner houses, a supply store, a saloon, and three boarding houses by 1906.",
      "sourceSentenceIds": [
        22,
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cokeburgboro.com/history/"
    },
    {
      "id": 2,
      "text": "Cokeburg’s original name was Shaft Four, later officially known as Cokeburg Mine 53 and Mine 54, after the two shafts sunk in 1900.",
      "sourceSentenceIds": [
        23,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cokeburgboro.com/history/"
    },
    {
      "id": 3,
      "text": "The first coal mined in 1902 was processed into coke and shipped out by rail, marking the town’s early industrial boom.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cokeburgboro.com/history/"
    },
    {
      "id": 4,
      "text": "Since 1950, Cokeburg has been part of the Pittsburgh metropolitan area, linking it to the region’s broader economic history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cokeburg%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The final episode of the TV series Quantum Leap was set in Cokeburg, chosen because it was the childhood home of the show’s creator.",
      "sourceSentenceIds": [
