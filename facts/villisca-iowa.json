  "facts": [
    {
      "id": 1,
      "text": "Villisca was named after a Native American word meaning 'pretty place' or 'pleasant view' when it was founded as a railroad settlement in 1858.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Villisca,_Iowa"
    },
    {
      "id": 2,
      "text": "Before becoming Villisca, the area was called The Forks, a small settlement positioned between the Middle and West Nodaway Rivers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Villisca,_Iowa"
    },
    {
      "id": 3,
      "text": "The Villisca Historical Society, founded in 2006, preserves the town’s heritage with over 80,000 pages of historic newspapers.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/villisca-historical-society/"
    },
    {
      "id": 4,
      "text": "Villisca houses Iowa’s only publicly funded armory, built in 1912, which remains the state’s longest‑operating military facility.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://communityhistoryarchives.com/places/villisca-historical-society/"
    },
    {
      "id": 5,
      "text": "Through its partnership with Advantage Archives, the Villisca Historical Society offers free, remote access to its extensive Community History Archive.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
