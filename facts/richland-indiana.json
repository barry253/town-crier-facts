  "facts": [
    {
      "id": 1,
      "text": "Richland Township, the eighth of Madison County's fourteen, was officially formed on March 4, 1834.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.in.gov/townships/richland48/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1860s the community was known as Lake City before adopting the name Richland in 1921 for its fertile soil.",
      "sourceSentenceIds": [
        2,
        27,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofrichland.net/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "John Purcell opened a woolen factory near a carding machine, producing and selling woolen goods to the growing community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.in.gov/townships/richland48/about/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The planned Indiana Central Canal spurred speculation that led John Beal and Hiram Louder to found Prosperity nearby.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.in.gov/townships/richland48/about/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "When the canal was abandoned in 1839, most residents left and the nearby town of Pittsborough disappeared.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.in.gov/townships/richland48/about/history/",
