  "facts": [
    {
      "id": 1,
      "text": "Johnson City was founded in 1879 and named for early settler James Polk Johnson, who donated land on the Pedernales River.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Johnson_City%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890 the county seat of Blanco County moved to Johnson City, making it the administrative heart of the region.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Johnson_City%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s first electric power arrived in the 1930s, thanks to legislation sponsored by Lyndon B. Johnson, a relative of the founder.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/johnson-city-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Johnson National Historical Park, operated by the National Park Service, sits about 12 miles west of the town and preserves the legacy of President Lyndon B. Johnson.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Johnson_City%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Routes 281 and 290 intersect near the center of Johnson City, a junction that has long served as a local crossroads.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Johnson_City%2C_Texas",
