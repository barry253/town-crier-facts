  "facts": [
    {
      "id": 1,
      "text": "Clarks, Louisiana began in 1903 as a company town built by the Louisiana Central Lumber Company to support its sawmill operations.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clarks_louisiana"
    },
    {
      "id": 2,
      "text": "The Oasis, a circa‑1905 building, originally housed the post office, barber shop, confectionery‑drugstore, and a lodge hall.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofclarksla.org/"
    },
    {
      "id": 3,
      "text": "After the Louisiana Central Lumber Company mill closed on February 20, 1953, Clarks shifted from company control to independent ownership.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clarks_louisiana"
    },
    {
      "id": 4,
      "text": "In 1937, Clarks earned the title of Louisiana’s cleanest town, a distinction noted in local history.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofclarksla.org/"
    },
    {
      "id": 5,
      "text": "The Oasis building was nominated to the National Register of Historic Places in 1989, preserving its lumber‑era heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clarks_louisiana"
    },
    {
      "id": 6,
      "text": "Clarks sits southwest of Caldwell Parish’s center, with U.S. Route 165 running along its eastern edge.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarks%2C_Louisiana"
    }
  ]
}
