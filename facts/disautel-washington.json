  "facts": [
    {
      "id": 1,
      "text": "Disautel was founded in 1919, just 15 miles east of Omak along what is now Washington State Route 155.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Disautel%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once housed the headquarters of the Biles‑Coleman Logging Company, a major timber player of the era.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Disautel%2C_Washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the sawmill shut down at the start of the Great Depression, Disautel’s population dwindled dramatically.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Disautel%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, travelers spot the ghost town’s crumbling ruins along Route 155, relics of the early 1900s timber boom.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/disautel-washington-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Disautel served as a hub for Biles‑Coleman until the Great Depression, when lumber output fell from 7.3 billion to 2.2 billion feet annually.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/disautel-washington-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s remaining foundations today offer a tangible glimpse into the Pacific Northwest’s rich logging heritage and boom‑and‑bust past.",
      "sourceSentenceIds": [
        13
