  "facts": [
    {
      "id": 1,
      "text": "Winterhaven sits on the Colorado River, marking California's southeasternmost border with Arizona and Mexico.",
      "sourceSentenceIds": [
        15,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winterhaven%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town originated as Karmack, with a post office opened in 1916 that closed in 1921 before reopening in 1934.",
      "sourceSentenceIds": [
        5,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Winterhaven,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A former Army post once guarded emigrants during the Yuma War, and the site is now a California Historical Landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Winterhaven,_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Winterhaven hosts the Valley of the Names, a series of WWII-era geoglyphs etched by military personnel into the desert.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Winterhaven,_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Old Plank Road, once a route across the Imperial Sand Dunes, still traces part of Winterhaven's early automobile history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Winterhaven,_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area was long inhabited by the Quechan people, whose traditional territory spanned the lower Colorado River valley.",
