      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened December 14, 1905, cementing its name after the early settler who secured it.",
      "sourceSentenceIds": [
        18,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Drake%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1905 inn built by Frank Bartholf served travelers on the road from Loveland to Estes Park.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/drake_colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Drake sits at 6,162 feet amid steep canyon walls, making it a gateway to Rocky Mountain National Park.",
      "sourceSentenceIds": [
