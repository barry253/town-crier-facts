    },
    {
      "id": 2,
      "text": "In the 1730s Thomas Fairfax built Greenway Court manor here, a major landowner of the Shenandoah Valley.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
