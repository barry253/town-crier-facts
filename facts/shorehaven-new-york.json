  "facts": [
    {
      "id": 1,
      "text": "Shorehaven’s name traces back to the mid‑18th‑century Whaley family, British immigrants whose settlement gave the lake its original name.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shorehaven_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Whaley Lake, the county’s largest, stretches 2.5 miles north‑south and half a mile wide, once called Whaley Pond before a 19th‑century dam enlarged it.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shorehaven_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1870s, the Central New England Railroad ran along Shorehaven’s eastern shore, helping ship iron ore to nearby mills.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shorehaven_new_york",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1940s, New York City’s Sanitation Department converted train cars into cottages on a 1,100‑acre tract, creating Sanita Hills Camp before donating it to the Boy Scouts.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shorehaven_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, the nonprofit Shorehaven Civic Association manages three beaches, a marina, and other communal spots, blending year‑round homes with vacationers.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shorehaven_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Whaley Lake drains north through Whaley Lake Stream into Fishkill Creek, a southwestward tributary that feeds the Hudson River.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shorehaven%2C_New_York",
