  "facts": [
    {
      "id": 1,
      "text": "Dunnsville earned its name from the early Dunn family, who patented fertile lands in the late 17th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dunnsville_virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Rappahannock Industrial Academy, once a landmark of education and equality, is remembered today by a roadside historical marker in Dunnsville.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kids.kiddle.co/Dunnsville,_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bathurst, Hundley Hall, and Hoskins Country Store in Dunnsville are listed on the Virginia Landmarks Register and the National Register of Historic Places.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dunnsville_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dunnsville sits near the Rappahannock River, whose tidal influence reaches the Chesapeake Bay about 35 miles downstream.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dunnsville_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Angel Visit Baptist Church, founded in 1866 by formerly enslaved African Americans, remains one of the oldest continuously operating African‑American congregations in Essex County.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dunnsville_virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s soil, a sandy loam from marine sediments, supports agriculture when amended, reflecting the Middle Peninsula’s fertile coastal plain.",
