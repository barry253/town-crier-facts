    {
      "id": 1,
      "text": "Sapelo Island lies about sixty miles south of Savannah, in the center of Georgia’s barrier island chain.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/sapelo-island/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The island’s human history stretches back at least 4,500 years, with archaeological digs revealing a long Native American presence.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/sapelo-island/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sapelo is home to Hog Hammock, the last known Gullah community, preserving a unique African‑American coastal culture.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sapelo_Island",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The island is a National Estuarine Research Reserve, protecting its tidal wetlands and serving as a living laboratory for scientists.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/sapelo-island/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Visitors must obtain a permit from state tourism authorities to access Sapelo, reflecting its protected status.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sapelo_Island",
