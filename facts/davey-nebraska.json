      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A Pony Express station operated in Davey as early as 1871, long before the town was officially established.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
