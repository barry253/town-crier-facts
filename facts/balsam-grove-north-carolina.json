      ],
      "source": "https://en.wikipedia.org/wiki/Balsam_Grove%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name came from a grove of balsam firs that grew on land owned by William Galloway, where the first post office opened in 1821.",
      "sourceSentenceIds": [
        4,
        19
      ],
      "sourceLabels": [
