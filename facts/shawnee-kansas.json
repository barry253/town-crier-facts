      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Methodist Mission in Shawnee spanned 2,000 acres and housed 16 buildings where thousands of Indians learned farming and trades until 1862.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
