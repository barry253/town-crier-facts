      "quality": "good"
    },
    {
      "id": 2,
      "text": "Frederica was incorporated in 1826, briefly repealed in 1855, and reincorporated a decade later in 1865.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
