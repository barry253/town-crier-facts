  "facts": [
    {
      "id": 1,
      "text": "Dayton’s Thomas Marshall House, built in 1868, was the first National Register property in Armstrong County and now houses the local history museum.",
      "sourceSentenceIds": [
        1,
        4,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dayton%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Dayton became a borough in 1873, originating from Wayne Township, with its first cabin erected around 1823 and a post office opening in 1850.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dayton_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town was named for Revolutionary War hero Anthony Wayne, whose campaigns skirted the area that later became Dayton.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dayton_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2025, Dayton added the Soldiers’ Orphans’ Home to the Civil War Trails, directing visitors to the Marshall House for veteran history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dayton_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Dayton’s annual fair, founded in 1880 by an early settler’s wife, still features livestock shows and crop judging, honoring its agricultural roots.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dayton_pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1905 Normal School building survived a 1970s renovation thanks to local advocacy, preserving Dayton’s educational heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/dayton_pennsylvania",
