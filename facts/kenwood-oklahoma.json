  "facts": [
    {
      "id": 1,
      "text": "Kenwood emerged as a lumber boomtown around 1913 when entrepreneurs acquired timber rights in the heavily forested area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kenwood_oklahoma"
    },
    {
      "id": 2,
      "text": "The name Kenwood comes from a blend of William Kennedy's surname and the National Hardwood Company's operations.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/kenwood_oklahoma"
    },
    {
      "id": 3,
      "text": "Kenwood straddles the border of two counties, with the eastern half in Delaware County and the western half in Mayes County.",
      "sourceSentenceIds": [
        7,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/kenwood_oklahoma"
    },
    {
      "id": 4,
      "text": "A railroad spur from the Kansas, Oklahoma and Gulf Railway once helped transport lumber products like railroad ties from Kenwood.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kenwood_oklahoma"
    },
    {
      "id": 5,
      "text": "Saline Creek drains the community of Kenwood, flowing west to join the Neosho River in Lake Hudson.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kenwood%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "Kenwood once had its own post office, which first opened on May 25, 1922.",
