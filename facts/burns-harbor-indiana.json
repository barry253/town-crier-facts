      ],
      "source": "https://en.wikipedia.org/wiki/Burns_Harbor%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town of Burns Harbor was officially founded in 1966, making it one of the newest communities in Porter County.",
      "sourceSentenceIds": [
