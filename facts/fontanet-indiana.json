  "facts": [
    {
      "id": 1,
      "text": "Fontanet began in 1870 as Fountain Station, a railroad stop that grew around a post office.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fontanet_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1881 the town adopted the name Fontanet after the post office had briefly been called Hunter in 1877.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/fontanet_indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the 1890s Fontanet supported a modest mining community of about 300 residents, complete with a general store and coal mining operations.",
      "sourceSentenceIds": [
        1,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/fontanet_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every August, Fontanet hosts the Bean Dinner Festival, a tradition that began as a Civil War veterans’ picnic in 1890.",
      "sourceSentenceIds": [
        9,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://visitindiana.in.gov/blog/post/fontanet-tiny-town-blew-up/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "On October 15, 1907, a DuPont powder mill explosion shattered the town, killing dozens and sending shock waves over 200 miles.",
      "sourceSentenceIds": [
        14,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/fontanet_indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nestled in the Wabash River Valley, Fontanet experiences a humid continental climate with hot summers and cold winters.",
