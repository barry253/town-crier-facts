  "facts": [
    {
      "id": 1,
      "text": "El Toro began life as Aliso City, but the U.S. Post Office rejected the name because it sounded too close to Alviso.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.orangecountyhistory.org/wp/?page_id=175",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Marine Corps Air Station El Toro, once a bustling military hub, closed its gates in 1999 and later became a community space.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Forest%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Heritage Hill Historical Park preserves Orange County’s oldest buildings, including the 1863 Jose Serrano Adobe and El Toro’s first schoolhouse.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Forest%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1888, the Santa Fe Railroad ran through the area, officially christening the settlement El Toro for the first time.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.orangecountyhistory.org/wp/?page_id=175",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A 1909 transaction turned a local general store into the Three‑A Store, a landmark that still echoes the town’s early commerce.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ochistoryland.com/eltoropo",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dwight Whiting founded an English colony in 1884, laying the groundwork for El Toro’s community spirit and agricultural roots.",
      "sourceSentenceIds": [
        14
