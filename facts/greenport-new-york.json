  "facts": [
    {
      "id": 1,
      "text": "Greenport once thrived as a whaling hub, sending over a hundred whaling voyages from its strategic wharves between the 1790s and Civil War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eastlongisland.com/greenport/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name evolved from Greenhill to Greenport when it incorporated in 1838, reflecting its growing maritime identity.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.eastlongisland.com/greenport/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Greenport’s Long Island Rail Road station, now a museum, marks the eastern terminus of the Main Line and once served as a bustling freight hub.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenport%2C_Suffolk_County%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Frederick Church’s Olana estate, perched on Hudson River cliffs, sits within Greenport and showcases 19th‑century landscape artistry.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofgreenportny.gov/home/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During Prohibition, Greenport’s waterfront speakeasies and rum‑running routes made the village a notorious hotspot for bootleggers.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenport%2C_Suffolk_County%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Greenport Village Historic District, added to the National Register in 1986, preserves a tapestry of colonial and maritime architecture.",
      "sourceSentenceIds": [
        22
      ],
