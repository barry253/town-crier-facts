  "facts": [
    {
      "id": 1,
      "text": "New Llano got its name when 200 members of the whites‑only Llano del Rio Cooperative Colony from California moved there in 1917, renaming the former sawmill town Stables.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Llano%2C_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The colony tried to be self‑sufficient, owning a newspaper, broom factory, sawmill, ice plant, and sheet‑metal factory.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Llano%2C_Louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Residents enjoyed six months of paid maternity leave, goat‑milk diet, and comprehensive medical care, resulting in zero deaths during the 1918 influenza outbreak.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_llano_louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "New Llano remained the longest‑lived non‑religious communal settlement in U.S. history until its collapse in the late 1930s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_llano_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Water scarcity and legal disputes over irrigation in California’s Mojave Desert forced the Llano del Rio colony to relocate to Louisiana by 1917.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/new_llano_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The colony’s board bought the abandoned Gulf‑Anderson Lumber Company mill town of Stables, placing the community along the Kansas City Southern railroad.",
      "sourceSentenceIds": [
        15,
        11
      ],
      "sourceLabels": [
        "Web source 2",
