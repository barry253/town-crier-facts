      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas_Flat%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Douglas Flat was a roaring mining camp in the early 1850s, producing $130,000 in gold by 1857.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglas_Flat%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Most long‑term settlers came from Wales and Italy, while early farmers were from the eastern United States.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
