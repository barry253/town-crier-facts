  "facts": [
    {
      "id": 1,
      "text": "Bel Air was founded in 1782 on land granted to Daniel Scott and became Harford County’s seat the same year.",
      "sourceSentenceIds": [
        15,
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name evolved from “Belle Aire” to the current spelling after the Civil War, dropping the extra “e” in the early 20th century.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Maryland and Pennsylvania Railroad, known as the Ma & Pa, ran through Bel Air until 1958, and its former track is now a popular walking trail.",
      "sourceSentenceIds": [
        5,
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bel Air’s original layout consisted of just 42 lots along Main Street, centered around the courthouse and county jail.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bel_Air%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s incorporation was officially recorded in 1874, formalizing its status as a municipal entity.",
