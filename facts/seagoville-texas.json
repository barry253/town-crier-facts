  "facts": [
    {
      "id": 1,
      "text": "Seagoville got its name in 1910 when the U.S. Post Office changed Seago to Seagoville to avoid confusion with Sego.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
