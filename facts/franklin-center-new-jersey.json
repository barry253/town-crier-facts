  "facts": [
    {
      "id": 1,
      "text": "Franklin Park was originally called Six Mile Run, named after the tributary of the Millstone River that flows through the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s, Franklin Park boasted a wagon factory, blacksmith, wheelwright, butcher, hay scales, ice house, school, general store, and about 110 residents.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "From 1714 to 1737, Franklin Park hosted Somerset County’s first courthouse and jail before a fire moved the seat to Millstone.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Franklin_Park%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gifford’s Tavern, where John Quincy Adams and Andrew Jackson once stopped, was replaced in 1874 by the 26‑room Beekman’s Hotel, which burned down in 1929.",
      "sourceSentenceIds": [
        14,
        15
      ],
