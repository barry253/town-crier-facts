  "facts": [
    {
      "id": 1,
      "text": "Benge takes its name from Frank H. Benge, a rancher who donated the land that became the town site.",
      "sourceSentenceIds": [
        4,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Benge,_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1859‑built Mullan Military Road cut through Benge, and wagon ruts can still be seen near the First Benge School.",
      "sourceSentenceIds": [
        3,
        11,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/benge_washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Spokane, Portland and Seattle Railway surveyed a line in 1907, it passed directly through the Benge ranch, sparking the town’s birth.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/benge_washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because Benge is unincorporated, it has no city government and is governed directly by Adams County.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/Benge,_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The Mullan Road, finished in 1862 for $280,000, linked the Missouri River to the Columbia River across the Rockies.",
