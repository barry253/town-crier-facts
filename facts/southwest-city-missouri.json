  "facts": [
    {
      "id": 1,
      "text": "Southwest City was formally platted in 1870 and named for its position in the extreme southwest corner of McDonald County and Missouri.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits near the tripoint where Missouri, Arkansas, and Oklahoma meet, making it a historic crossroads for frontier traders and cattlemen.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers in the 1840s, including LaMance and Burton McGhee, established homesteads along Honey Creek, sparking the community’s growth.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1846 a general store opened in the valley, turning the settlement into a hub for travelers near the Indian Territory border.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Southwest_City%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Sanborn Fire Insurance Maps of Southwest City, dating from 1894 to 1914, provide detailed views of downtown businesses and landmarks.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-southwest-city-missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Sanborn maps show footprints of hotels, schools, and industrial buildings, offering a direct window into how the town once looked.",
      "sourceSentenceIds": [
        11
