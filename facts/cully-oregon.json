  "facts": [
    {
      "id": 1,
      "text": "Cully’s name comes from English stonemason Thomas Cully, who built the first chimney for settler Francis Pettygrove and later a brick commercial building in 1884.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/cully_portland_oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlers, Chinookan peoples lived along the Columbia and Willamette Rivers for thousands of years, making Cully part of a rich indigenous heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cully_portland_oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cully’s 25‑acre Thomas Cully Park was created on a former landfill and now hosts sports fields, community gardens, and the historic Thomas Cully Park Community Garden.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/cully_portland_oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area that is now Cully was annexed into Portland in 1985 after decades as a post‑World War II suburb with affordable housing.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cully_portland_oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cully’s wetlands and shallow ponds preserve ecological diversity, reflecting a blend of urban development and natural habitats shaped by historic sediment deposition.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
