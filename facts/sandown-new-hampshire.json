      "id": 1,
      "text": "Sandown was incorporated in 1756 by Colonial Governor Benning Wentworth after separating from Kingston.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
