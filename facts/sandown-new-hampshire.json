      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the picturesque Sandown on the Isle of Wight.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandown%2C_New_Hampshire",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1874 Nashua & Rochester Railroad depot, now a museum, sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sandownnhdepot.org/history/town-of-sandown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original Sandown Meeting House, built in 1774 by Reverend Josiah Cotton, still stands and is on the National Register.",
      "sourceSentenceIds": [
        21,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandown%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hoyt Hill, the town’s highest point, rises to 505 feet near the southwestern corner.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandown%2C_New_Hampshire",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Phillips Pond and Showell Pond drain north into the Exeter River, part of the Great Bay watershed.",
