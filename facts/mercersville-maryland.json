  "facts": [
    {
      "id": 1,
      "text": "Mercersville, now called Taylor's Landing, sits on the Potomac River where the historic Chesapeake & Ohio Canal meets the river.",
      "sourceSentenceIds": [
        3,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visithagerstown.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Charles F. Mercer, the first president of the C&O Canal Company.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercersville%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "An ancient iron ring on the riverbed at Taylor's Landing is rumored to be a relic from the Patomack Company’s early port days.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercersville%2C_Maryland",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In 1838 a court ordered a new road, referring to the area as “Zook’s Landing,” linking it to the earlier Patomack Company port.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mercersville%2C_Maryland",
      "category": "history",
      "quality": "good",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Potomac River at Taylor's Landing hosts visible ancient native stone “fish pots,” evidence of long‑standing fishing traditions.",
      "sourceSentenceIds": [
        19
