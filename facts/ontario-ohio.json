  "facts": [
    {
      "id": 1,
      "text": "Ontario was founded in 1834 by Hiram Cook and platted in December 1834 as a settlement in Springfield Township near Mansfield.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ontario%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was named after Ontario County, New York, the native place of its founder.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ontario%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1863 the Atlantic and Great Western Railroad, later the Erie mainline, reached Ontario and built a station, but the line was largely abandoned in the 20th century.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ontario%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of General Motors and the Richland Mall marked a shift of commerce from Mansfield to Ontario, turning the city into a suburban hub.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
