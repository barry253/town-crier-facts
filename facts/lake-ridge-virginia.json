  "facts": [
    {
      "id": 1,
      "text": "Lake Ridge began in the late 1960s when Sorensen Construction Corporation started building the area now known as East Lake Ridge.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ridge%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community grew rapidly throughout the 1970s and 1980s, expanding from about 3,350 homes in 1983 to roughly 6,600 by 1990.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ridge%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lake Ridge Parks and Recreation was formed in 1972 as the homeowners association that helped shape the neighborhood’s community life.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ridge%2C_Virginia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1969, the first five developments had begun, named Thousand Oaks, The Point, Plantation Harbor, The Village of Lake Ridge, and The Hamlet.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ridge%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake Ridge as it is now was completed in the late 1990s with the completion of Ridgeleigh, a large subdivision that added many new homes.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Ridge%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Ridge has about 7,700 housing units spread across more than 70 subdivisions and nine condominium complexes, reflecting its suburban character.",
      "sourceSentenceIds": [
