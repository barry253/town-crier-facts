  "facts": [
    {
      "id": 1,
      "text": "Lockington was first called Locksport because its early settlers lived beside the canal locks that once powered the village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockington%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Around 1830 a flour mill sprang up on Loramie Creek, following an earlier abandoned sawmill that had once processed timber.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageoflockington.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Miami and Erie Canal’s five locks lifted water 60 feet over Loramie Creek via an aqueduct, a remarkable engineering achievement.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockington%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lockington officially incorporated on September 9, 1857, with the state recording the charter on January 4, 1858.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockington%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2019, the Ohio Historical Records Advisory Board awarded Lockington a grant to inventory and improve access to its historical documents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockington%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today the original canal locks are preserved as the Lockington Locks Historical Area, a living reminder of the village’s waterway past.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
