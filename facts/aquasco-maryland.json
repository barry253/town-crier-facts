    },
    {
      "id": 2,
      "text": "A stop on the Underground Railroad lies just northeast of Aquasco’s main street, according to a local resident.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://today.umd.edu/trail-through-history-053d05b9-2b78-4e84-bb74-377651a01992"
    },
    {
      "id": 3,
      "text": "Aquasco received its name from the Wood family, early settlers who first claimed the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aquasco%2C_Maryland"
    },
    {
      "id": 4,
      "text": "Villa De Sales, a historic farm dating to about 1877, sits on Aquasco’s riverfront and reflects 19th‑century agriculture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
