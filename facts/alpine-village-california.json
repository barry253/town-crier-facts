  "facts": [
    {
      "id": 1,
      "text": "When it was designated in 2020, Alpine Village became the first legacy business in unincorporated Los Angeles County to be named a historic landmark.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.laconservancy.org/learn/historic-places/alpine-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Alpine was California’s leading producer of honey in the late 1800s, a gold that sweetened the town during the Gold Rush era.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sandiegomagazine.com/guides/the-locals-guide-to-visiting-alpine-ca/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alpine was home to Broadway star William Dalton, known as Julian Eltinge, who earned a fortune playing women’s roles in the 1920s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sandiegomagazine.com/guides/the-locals-guide-to-visiting-alpine-ca/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alpine sits 2,000 feet above sea level, surrounded by national forest land and two reservations, just 30 miles east of downtown San Diego.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sandiegomagazine.com/guides/the-locals-guide-to-visiting-alpine-ca/",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "In the 1850s, Alpine became a stopover on the “Jackass Mail,” Southern California’s first regular postal route.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sandiegomagazine.com/guides/the-locals-guide-to-visiting-alpine-ca/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Her 1896 home now houses the Alpine Historical Society Museum in Alpine, California.",
      "sourceSentenceIds": [
