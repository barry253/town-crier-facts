      ],
      "source": "https://newjersey.wiki/a/Barnegat_Lighthouse",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Barnegat Lighthouse stands 172 feet tall and serves as a vital navigational aid for vessels along the Atlantic Ocean.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
