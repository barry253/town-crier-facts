  "facts": [
    {
      "id": 1,
      "text": "Zürichberg rises to 679 m, overlooking Lake Zürich and lying just east of the city center.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrichberg"
    },
    {
      "id": 2,
      "text": "The Dolderbahn rack railway climbs the hill, while Zürich tram route 6 and the Rigiblick funicular reach its upper slopes.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrichberg"
    },
    {
      "id": 3,
      "text": "Zürichberg hosts both the city zoo and FIFA’s headquarters, making it a unique blend of sport and wildlife.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrichberg"
    },
    {
      "id": 4,
      "text": "Grand mansions line the hill’s roads, and the area is also home to upscale restaurants and hotels.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Z%C3%BCrichberg"
    },
    {
      "id": 5,
      "text": "The upper part of Zürichberg is mostly woodland and a popular spot for hiking and picnicking.",
      "sourceSentenceIds": [
