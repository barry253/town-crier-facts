  "facts": [
    {
      "id": 1,
      "text": "Covington was named for U.S. Army Brigadier General Leonard Covington, a War of 1812 hero.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
