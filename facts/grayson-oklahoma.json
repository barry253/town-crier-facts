  "facts": [
    {
      "id": 1,
      "text": "Grayson was originally known as Wildcat before being renamed in honor of Muscogee Creek Chief George W. Grayson.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Grayson%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Grayson was established in the early twentieth century as one of more than fifty all-Black towns in Oklahoma.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/grayson_oklahoma"
    },
    {
      "id": 3,
      "text": "The historic Grayson Jail is a small stone structure built in 1900 and listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        14,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Grayson%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Grayson is included in Oklahoma's Civil Rights Trail to connect historic Black towns through signage and tourism infrastructure.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
