  "facts": [
    {
      "id": 1,
      "text": "El Cajon’s name comes from Rancho El Cajón, named for the box‑shaped valley that surrounds the city, earning it the nickname “the Box”.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Cajon%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The El Cajon Valley was originally inhabited by the Kumeyaay people before settlers arrived in the late 1800s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fencingelcajon.com/el-cajon-ca/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The old Knox House, once a two‑story hotel, now serves as the El Cajon Historical Society’s museum and community hub.",
      "sourceSentenceIds": [
        11,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elcajonhistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The East County Performing Arts Center, a renowned concert venue, hosts musicians and Broadway productions right in downtown El Cajon.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fencingelcajon.com/el-cajon-ca/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since the 1990s, El Cajon has welcomed immigrants from Iraq and the former Yugoslavia, adding to its cultural mosaic.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fencingelcajon.com/el-cajon-ca/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former El Cajon Speedway, once the fastest 3/8‑mile paved oval in the West, now operates as a historic museum with its original entrance sign.",
      "sourceSentenceIds": [
