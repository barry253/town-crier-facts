  "facts": [
    {
      "id": 1,
      "text": "Founded in 1875 by Michigan Methodists, Bay View began as a camp meeting that blended science, culture, and religion.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_View_Association",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1886 Bay View adopted a Chautauqua program, turning the camp into a hub for education and entertainment.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_View_Association",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Campus, once Tabernacle Park, remains the community’s center, where the original “God’s first temple” once stood.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_View_Association",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1987 Bay View has been a National Historic Landmark district, celebrated as a premier example of Methodist camp meeting and Chautauqua.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_View_Association",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic grounds feature 444 Victorian cottages, two inns, and expansive gardens that draw visitors throughout the year.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bayviewassociation.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2017 Bay View offered more than sixty classes, from art and literature to culinary skills, keeping its lifelong learning tradition alive.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bay_View_Association",
      "category": "culture",
      "quality": "good"
    }
