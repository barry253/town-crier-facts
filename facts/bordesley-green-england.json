  "facts": [
    {
      "id": 1,
      "text": "Bordesley Green’s name comes from a medieval manor once owned by Bordesley Abbey, with early records dating back to 1285.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://birminghamuk.com/2026/01/09/bordesley-green/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area evolved from open fields and market gardens into a dense industrial hub, feeding Birmingham’s reputation as the “workshop of the world”.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://birminghamuk.com/2026/01/09/bordesley-green/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The National Telephone Company’s depot on Fordrough Lane became one of Birmingham’s three major GPO factories, producing manual telephony equipment and later contributing to the Colossus computer used in WWII.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bordesley_Green",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During World War II, the GPO factory on Fordrough Lane was hit by German bombing raids in 1940, reflecting the district’s strategic importance.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bordesley_Green",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bordesley Green Allotments, a 25‑acre site, hosts the Bordesley Green Forest garden and once staged the Birmingham Annual Gardening Show in 2012.",
