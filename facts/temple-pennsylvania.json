  "facts": [
    {
      "id": 1,
      "text": "Temple earned its name from a 19th‑century inn called Solomon’s Temple, whose bright sign drew travelers to the crossroads of five roads.",
      "sourceSentenceIds": [
        10,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goreadingberks.com/temple-pa-muhlenberg-township/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original Solomon’s Temple hotel, built in 1853, still stands today as a hotel and restaurant, making it the oldest building in the village.",
      "sourceSentenceIds": [
        18,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goreadingberks.com/temple-pa-muhlenberg-township/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Muhlenberg Township, where Temple sits, was formed in 1851 from Alsace Township after settlers moved in during the mid‑1700s.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/temple_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Temple’s early economy grew around iron manufacturing, highlighted by the Temple Iron Company that produced 800 tons of pig iron weekly at its peak.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://goreadingberks.com/temple-pa-muhlenberg-township/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Schuylkill Canal and later railroads turned Temple into a transportation hub, linking it to Philadelphia and fueling regional trade in the 1800s.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/temple_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1999 Temple disincorporated, ending its status as an independent borough after 77 years of self‑governance.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Temple%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    }
