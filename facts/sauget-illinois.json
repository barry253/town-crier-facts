      "quality": "good"
    },
    {
      "id": 3,
      "text": "Sauget hosts the National Building Arts Center, a preservationist organization holding one of the largest collections of architectural and industrial elements in the U.S.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
