  "facts": [
    {
      "id": 1,
      "text": "Annadale got its name around 1860, honoring Anna Seguine, a French Huguenot descendant who helped settle Staten Island’s South Shore.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annadale%2C_Staten_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s railroad station, built in the 1860s, shifted Annadale from rural isolation to a commuter hub.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/annadale_staten_island",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1929, Spanish immigrants founded the Spanish Camp along Annadale’s shoreline, creating a brief but colorful seaside enclave.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annadale%2C_Staten_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Verrazzano‑Narrows Bridge’s 1964 opening brought a wave of Brooklyn and Manhattan residents, sparking a suburban boom in Annadale.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/annadale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Annadale Road, the neighborhood’s historic spine, runs from the train station through a village‑like core of shops and cafés.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/annadale",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area that is now Arden Heights was once part of Annadale’s northwestern section, later recognized as a distinct neighborhood.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
