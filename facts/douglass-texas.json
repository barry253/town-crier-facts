  "facts": [
    {
      "id": 1,
      "text": "Douglass sits on the historic Old San Antonio Road, four miles east of the Angelina River and fourteen miles west of Nacogdoches.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/douglass-tx"
    },
    {
      "id": 2,
      "text": "The community was first settled around 1829, shortly after the Republic of Texas was founded.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/douglass-tx"
    },
    {
      "id": 3,
      "text": "Douglass derives its name from Kelsey Harris Douglass, a prominent early settler who ran several businesses there.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/douglass-tx"
    },
    {
      "id": 4,
      "text": "A Republic of Texas post office opened in 1835, followed by a U.S. post office in 1846, making it a communication hub.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/douglass-tx"
    },
    {
      "id": 5,
      "text": "By 1836 the town featured a stagecoach inn owned by John R., serving travelers on the old road.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/douglass-tx"
    },
    {
      "id": 6,
      "text": "Early 20th century saw a teachers' school operating for two years, reflecting the town’s commitment to education.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/douglass-tx"
