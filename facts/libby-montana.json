  "facts": [
    {
      "id": 1,
      "text": "Libby earned its name in the 1880s when miner Stephen Allen christened the town after his daughter, Elizabeth, nicknamed Libby.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflibby.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Libby sits where Libby Creek meets the Kootenai River, a spot that shaped its early industry.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Libby%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Great Depression, the Civilian Conservation Corps built the original bridge over Libby Creek, a historic landmark still admired.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Libby%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Libby's roots run deep in mining and timber, industries that drove its growth from the late 1800s onward.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityoflibby.com/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Summer visitors can explore the Heritage Museum, which chronicles Libby's mining past and the surrounding region's history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://travelmontananow.com/libby-montana-guide-things-to-do/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Nestled in the Kootenai National Forest, Libby lies between the Cabinet Mountains to the south and the Purcell Mountains to the north.",
