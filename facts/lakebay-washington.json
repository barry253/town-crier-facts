  "facts": [
    {
      "id": 1,
      "text": "Lakebay was named in 1871 by the William Creviston family after nearby Bay Lake, reflecting its close proximity.",
      "sourceSentenceIds": [
        2,
        3,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lakebay_washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy relied on a sawmill built in 1875 by Norwegian immigrant Lorenz, powering boat construction for the Mosquito Fleet.",
      "sourceSentenceIds": [
        19,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lakebay_washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lakebay’s Mosquito Fleet steamboats ferried goods, mail, and passengers to Seattle and Tacoma, making the community a vital maritime hub.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.keypeninsulamuseum.org/key-communities/lakebay/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1882 Henry Tiedeman opened Lakebay’s first post office and served as its inaugural postmaster, anchoring the town’s communication network.",
      "sourceSentenceIds": [
        16,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.keypeninsulamuseum.org/key-communities/lakebay/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Lakebay Cemetery, established early in the town’s history, contains graves of settlers, business people, and the first white child born on the peninsula.",
      "sourceSentenceIds": [
        15,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.keypeninsulamuseum.org/key-communities/lakebay/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lakebay sits at the head of Mayo Cove on the east side of the Key Peninsula, about one mile south of Home, overlooking Puget Sound.",
      "sourceSentenceIds": [
        11,
