      ],
      "source": "https://en.wikipedia.org/wiki/Mont_Clare%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic ford called Jacobs’ ford once crossed the Schuylkill River near Mont Clare, giving the village its early settlement spot.",
      "sourceSentenceIds": [
        26,
        24
      ],
      "sourceLabels": [
        "Web source 1",
