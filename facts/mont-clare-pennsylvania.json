      ],
      "source": "https://kids.kiddle.co/Mont_Clare,_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village sits on a bluff overlooking the Schuylkill River, expanding northeast along Bridge Street, the main artery of the town.",
      "sourceSentenceIds": [
