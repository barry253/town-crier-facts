      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1880s Pennsylvania Schuylkill Valley Railroad built a station in Mont Clare, cementing its role as a rail hub between Philadelphia and Reading.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
