      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village takes its name from Jim Gandy, an early settler who donated the land for the town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gandy%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gandy once held the title of Logan County's largest town until a Union Pacific spur line bypassed it in 1913, favoring Stapleton.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gandy%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The county seat moved from Gandy to Stapleton after a 1929 election, ending Gandy's 44-year tenure.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
