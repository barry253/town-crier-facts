  "facts": [
    {
      "id": 1,
      "text": "Belltown takes its name from William Nathaniel Bell, whose land claim became the neighborhood.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belltown%2C_Seattle",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Olympic Sculpture Park, an 9‑acre free public garden, sits on Belltown’s waterfront and is unwalled, unlike most U.S. parks.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belltown%2C_Seattle",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1922 the Pathe Building opened as Seattle’s first film‑industry structure, sparking the “Film Row” era that lasted into the 1960s.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belltown%2C_Seattle",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Friends of Historic Belltown has championed landmark nominations for buildings like the Franklin Apartments and the White Garage, protecting the area’s heritage.",
      "sourceSentenceIds": [
        11,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://friendsofhistoricbelltown.org/wp/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Belltown’s downtown location made it a hub for workers, artists, and musicians, a mix that continues to define its vibrant culture.",
      "sourceSentenceIds": [
        2
