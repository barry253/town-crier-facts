  "facts": [
    {
      "id": 1,
      "text": "San Miguel County, where the town sits, was created by the Republic of Mexico in 1844 and became one of New Mexico's nine original counties in 1852.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sanmiguel.nmgenweb.us/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1880, the railroad built a 240‑room Montezuma Hot Springs Hotel in San Miguel, turning the town into a regional resort destination.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://sanmiguel.nmgenweb.us/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community lies at the junction of state routes 28 and 192, making it a crossroads for travelers heading east or west.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Miguel%2C_New_Mexico",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Students from San Miguel attend either Gadsden High School or Alta Vista Early College High School, reflecting the county's educational options.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Miguel%2C_New_Mexico",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "San Miguel County's terrain ranges from 11,800‑foot peaks in the Sangre de Cristo Mountains to flat plains below 4,000 feet, offering diverse landscapes.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/regions/northeast/san-miguel-county-attractions/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Canadian River, flowing through San Miguel County, has been dammed to form Conchas Reservoir, a popular spot for fishing and boating.",
      "sourceSentenceIds": [
        16
      ],
