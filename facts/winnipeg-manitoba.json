      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was founded in 1812 by Selkirk settlers of the Red River Colony and officially incorporated as Winnipeg in 1873.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
