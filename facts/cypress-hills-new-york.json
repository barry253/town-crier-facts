  "facts": [
    {
      "id": 1,
      "text": "Cypress Hills Cemetery opened in 1851 as New York City’s first non‑sectarian cemetery, a response to 19th‑century public health concerns.",
      "sourceSentenceIds": [
        17,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cypress_Hills_Cemetery",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1862 a northwest section became Cypress Hills National Cemetery, burying 3,425 Union soldiers and 478 Confederates from the Civil War.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cypress_Hills_Cemetery",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1983 founding of the Cypress Hills Local Development Corporation turned a struggling neighborhood into a national model for community‑led revitalization.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/cypress-hills",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "German, Irish, and Italian immigrants settled Cypress Hills in the late 1800s, drawn by cheap lots and nearby factory jobs.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/cypress-hills",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before railroads, the area was rural farmland owned by Dutch and English families, later transformed by the Long Island Rail Road’s Great Eastern line.",
      "sourceSentenceIds": [
        9,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://brooklyneagle.com/326218/cypress-hills-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1998 a scandal revealed part of the cemetery was built on unstable landfill, leading to a Supreme Court ruling that graves had to be moved.",
      "sourceSentenceIds": [
        29,
