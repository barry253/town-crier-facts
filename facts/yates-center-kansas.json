  "facts": [
    {
      "id": 1,
      "text": "Yates Center was founded in August 1875, becoming the first Kansas town chosen as a county seat before any house existed.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Yates_Center%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It was named for Abner Yates, who donated land for the courthouse, churches, a park, and lots for the first two children.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yates_Center%2C_Kansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Yates Center is the only Kansas town born to be a county seat, selected before any building or resident appeared.",
      "sourceSentenceIds": [
        7,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Yates_Center%2C_Kansas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "Over thirty historic buildings cluster around Courthouse Square, forming the Yates Center Courthouse Square Historic District.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Yates_Center%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The climate features hot, humid summers and mild to cool winters, typical of the region.",
      "sourceSentenceIds": [
        9
