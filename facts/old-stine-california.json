  "facts": [
    {
      "id": 1,
      "text": "Old Stine sits inside Columbia State Historic Park, a living Gold Rush town that feels more authentic than any Hollywood backlot.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/historic-california-state-park/"
    },
    {
      "id": 2,
      "text": "The Wells Fargo building stands as a sentinel to Gold Rush history, while a stagecoach waits for travelers ready to step back in time.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/historic-california-state-park/"
    },
    {
      "id": 3,
      "text": "Businesses here aren’t just for show; they’re functional establishments practicing trades the old-fashioned way.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/historic-california-state-park/"
    },
    {
      "id": 4,
      "text": "After a day of gold panning, Old Stine’s eateries offer more than sustenance—they provide culinary time travel with dishes that taste like history.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/historic-california-state-park/"
    },
    {
      "id": 5,
      "text": "The wooden sidewalks creak underfoot, echoing the weight of history and the actual footsteps of nineteenth‑century miners.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/historic-california-state-park/"
    },
    {
      "id": 6,
      "text": "The scent of beeswax mingles with pine‑tinged mountain air, creating an olfactory experience that no scented candle from the mall could replicate.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://familydestinationsguide.com/historic-california-state-park/"
    }
  ]
