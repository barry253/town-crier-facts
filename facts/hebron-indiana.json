  "facts": [
    {
      "id": 1,
      "text": "Hebron’s Stagecoach Inn, built in 1863, now serves as a museum honoring local veterans and preserving the town’s heritage.",
      "sourceSentenceIds": [
        7,
        15,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pocomuse.org/hebron",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Panhandle Depot, a 60‑by‑14‑foot frame station, once linked Hebron to Chicago and now stands as a tangible link to railroad history.",
      "sourceSentenceIds": [
        6,
        4,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pocomuse.org/hebron",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hebron’s first frame house, the saltbox‑styled McCune Tavern, was constructed in 1849 and marked the town’s transition from log cabins to permanent homes.",
      "sourceSentenceIds": [
        20,
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pocomuse.org/hebron",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name honors a local church; Blain of the Hebron Church petitioned for a post office named after his church.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebron%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hebron was laid out in 1841 on a prairie that stretched 2.5 miles long and 0.75 miles wide, where early settlers crossed two roads.",
      "sourceSentenceIds": [
        27,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebron%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
