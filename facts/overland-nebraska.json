  "facts": [
    {
      "id": 1,
      "text": "Overland’s name comes from the 1860s Overland Stage Line, which set up relay stations like Prairie Camp across Hamilton County.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/overland_nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Burlington & Missouri River Railroad reached Hamilton County in 1879, turning Overland into a key grain‑shipping station.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/overland_nebraska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the Homestead Act opened Nebraska’s prairie in 1862, settlers claimed land in 1866, laying Overland’s rural roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/overland_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Overland’s post office opened in April 1895, becoming the community’s first formal hub for mail and supplies.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/overland_nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Overland experiences a humid continental climate, with July highs around 87°F and January lows near 14°F, and roughly 30 inches of yearly rain.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
