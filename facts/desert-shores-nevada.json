  "facts": [
    {
      "id": 1,
      "text": "Pyramid Lake, Nevada, sits 40 miles northeast of Reno and is the geographic sink of the Truckee River basin.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pyramid_Lake_(Nevada)",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The lake’s turquoise tufa formations inspired its name; the word “Frémont” comes from the pyramid‑shaped rock formations.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pyramid_Lake_(Nevada)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pyramid Lake is the largest remnant of ancient Lake Lahontan, an inland sea that once covered western Nevada.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pyramid_Lake_(Nevada)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indigenous Paiute people have fished the lake’s native trout species for centuries, and the area still hosts archaeological tools and mummified bodies.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pyramid_Lake_(Nevada)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2011 the Paiute Tribe closed the lake’s north and east shores to protect sacred sites, a decision still respected by visitors.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pyramid_Lake_(Nevada)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The lake once doubled as a stand‑in for the Sea of Galilee in the 1965 film “The Greatest Story Ever Told.”.",
      "sourceSentenceIds": [
        5
      ],
