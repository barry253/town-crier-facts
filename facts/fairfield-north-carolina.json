  "facts": [
    {
      "id": 1,
      "text": "Founded in the early 19th century, Fairfield—originally Wickham—grew when David Carter Jr. reclaimed swampy land and the Fairfield Canal Company was chartered in 1840.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairfield_hyde_county_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settlers, the Mattamuskeet (Machapunga) tribe of Algonquian speakers lived along Lake Mattamuskeet near Fairfield.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fairfield_hyde_county_north_carolina",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Fairfield Canal linked the village to the Alligator River and Albemarle Sound, enabling farmers to ship corn, pork, and sweet potatoes to northern markets.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fairfield_historic_district_fairfield_north_carolina",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the Intracoastal Waterway opened in 1928 and the Fairfield Bridge was built in 1939, the canal fell into disuse and the town quieted.",
      "sourceSentenceIds": [
        7,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/fairfield_historic_district_fairfield_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fairfield’s historic district showcases Italianate and Gothic Revival styles, crafted by local builders such as Cason Emery Swindell from 19th‑century pattern books.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairfield_historic_district_fairfield_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fairfield sits on the northern shore of Lake Mattamuskeet, North Carolina’s largest natural lake, amid the flat coastal plain of eastern Hyde County.",
      "sourceSentenceIds": [
        13
