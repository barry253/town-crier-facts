  "facts": [
    {
      "id": 1,
      "text": "Alanreed earned its name from railroad managers Alan and Reed, whose partnership helped lay out the townsite in 1900.",
      "sourceSentenceIds": [
        1,
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Alanreed%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1902 the post office moved from Eldridge and was renamed Alanreed.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/alanreed-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Route 66 once ran straight through Alanreed, with 1930s paving still visible south of the town today.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/alanreed.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1930s and 40s, service stations and hotels sprang up on 3rd Street, making Alanreed the last stop before the Jericho Gap.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.theroute-66.com/alanreed.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 2001 Alanreed had about fifty-two residents, a Baptist church, a gas station, a motel, a gift shop, and a post office.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/alanreed-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Loop 271 through Alanreed follows a former alignment of historic U.S. Route 66.",
