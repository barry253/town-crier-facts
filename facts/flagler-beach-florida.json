  "facts": [
    {
      "id": 1,
      "text": "Flagler Beach takes its name from Henry Flagler, the oil magnate who built railroads that turned East Florida into a vacation hotspot.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flagler_Beach%2C_Florida"
    },
    {
      "id": 2,
      "text": "The Flagler Beach Historical Museum’s permanent collection is devoted entirely to Florida history, spanning from prehistoric bones to Space Age artifacts.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flagler_Beach%2C_Florida"
    },
    {
      "id": 3,
      "text": "Museum displays include Orange Period pottery and arrowheads uncovered in Flagler County, artifacts that date back to 2000 BCE.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flagler_Beach%2C_Florida"
    },
    {
      "id": 4,
      "text": "Guided historic tours are available at the Flagler Beach Historical Museum, letting visitors walk through the town’s past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitflagler.com/things-to-do/history-heritage/"
    },
    {
      "id": 5,
      "text": "Travelers can follow a custom cellphone tour along historic A1A or stroll through historic downtown Bunnell on the western edge of Flagler.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitflagler.com/things-to-do/history-heritage/"
    },
