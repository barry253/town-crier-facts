  "facts": [
    {
      "id": 1,
      "text": "Lake Santee was built in the 1960s as a housing development centered on a reservoir of the same name.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Santee%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The reservoir covers about 1,200 acres after parts were sold, making it one of Indiana's largest private lakes.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lake-santee.com/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 2,000,000‑gallon water reservoir was added later, supported by 28 miles of water lines and a water tower built by Layne/Northern.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lake-santee.com/history/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Early road access was dirt; by spring 1964 crews from Kentucky hauled stone and later chip‑sealed Santee Drive to connect the community.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lake-santee.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "When most lots were sold in 1966, American Realty offered owners the right to take over the lake, leading to a community‑run water utility.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lake-santee.com/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lake Santee sits 13 miles northeast of Greensburg and 12 miles northwest of Batesville in southeastern Indiana.",
      "sourceSentenceIds": [
        5,
