  "facts": [
    {
      "id": 1,
      "text": "Varennes was founded in 1672 by René Gaultier, grandfather of Saint Marguerite d'Youville.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ville.varennes.qc.ca/la-ville/information/histoire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the seigneurial lands granted to René Gaultier by intendant Jean Talon in 1672.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Varennes%2C_Quebec",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1972, the parish and village of Varennes merged to become the city we know today.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ville.varennes.qc.ca/la-ville/information/histoire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Varennes sits on the Saint‑Laurent River, about 24 kilometres from downtown Montreal.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Varennes%2C_Quebec",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The city blends modernity with history, offering contemporary infrastructure alongside historic sites along the river.",
