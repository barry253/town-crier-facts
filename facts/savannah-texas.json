  "facts": [
    {
      "id": 1,
      "text": "Savannah, Texas was named after Savannah, Georgia, reflecting the origins of many of its early settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/savannah-tx-red-river-county",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the railroad chose a northern route in the 1870s, the nearby town of Walker Station grew while Savannah began to decline.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/savannah-tx-red-river-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Savannah in 1846, with Andrew Jackson Titus appointed as its first postmaster.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/savannah-tx-red-river-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The modern community began as a master‑planned residential development launched by Huffines Communities during the late 1990s suburban boom.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/savannah_texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Developers modeled Savannah’s layout on the historic charm of Savannah, Georgia, aiming for interconnected neighborhoods and green spaces.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/savannah_texas",
      "category": "other",
