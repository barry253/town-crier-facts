  "facts": [
    {
      "id": 1,
      "text": "Bands of the Menominee and Ojibwa tribes originally inhabited the land that would become Knowlton, relying on the river for travel.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://knowltonmosineeneighborhood.org/roots-along-the-river-exploring-the-heritage-and-history-of-knowlton-mosinee-s-storied-neighborhood/"
    },
    {
      "id": 2,
      "text": "Knowlton takes its name from Thomas Knowlton, an influential railroad engineer who helped chart the tracks through Marathon County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://knowltonmosineeneighborhood.org/roots-along-the-river-exploring-the-heritage-and-history-of-knowlton-mosinee-s-storied-neighborhood/"
    },
    {
      "id": 3,
      "text": "The Knowlton Post Office became a community anchor and fostered local growth after it was established in 1879.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://knowltonmosineeneighborhood.org/roots-along-the-river-exploring-the-heritage-and-history-of-knowlton-mosinee-s-storied-neighborhood/"
    },
    {
      "id": 4,
      "text": "The Knowlton House, built in the 1880s, once served as the residence for the town's first postmaster.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://knowltonmosineeneighborhood.org/roots-along-the-river-exploring-the-heritage-and-history-of-knowlton-mosinee-s-storied-neighborhood/"
    },
