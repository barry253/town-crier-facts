      ],
      "source": "https://en.wikipedia.org/wiki/Crofton%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Prehistoric hunters left remains in the Crofton area dating back to 1010 B.C., showing the region’s ancient roots.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
