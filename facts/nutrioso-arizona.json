  "facts": [
    {
      "id": 1,
      "text": "Nutrioso’s name comes from the Spanish word “nutria,” meaning otter, a term explorers used for beavers too, as noted by Escalante in 1776.",
      "sourceSentenceIds": [
        5,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nutrioso%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Escalante described a stream called Rio de las Nutrias where he believed beavers lived, noting its permanent pools and running water.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nutrioso%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A fort was erected in Nutrioso in 1880 to protect settlers, and a post office opened three years later, helping the community grow.",
      "sourceSentenceIds": [
        7,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nutrioso%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mormon families moved to Nutrioso in the late 19th century, a migration that significantly boosted the town’s population and development.",
