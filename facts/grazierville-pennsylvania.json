  "facts": [
    {
      "id": 1,
      "text": "Grazierville began as Kratzer, a village born around John Kratzer’s 1835 bloomery forge that ran until 1880.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grazierville_pennsylvania"
    },
    {
      "id": 2,
      "text": "The Pennsylvania Railroad’s main line reached Grazierville in the 1850s, turning the farming outpost into a bustling rail hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grazierville_pennsylvania"
    },
    {
      "id": 3,
      "text": "An electric trolley ran through Grazierville from 1891 until 1954, offering a brief but lively alternative to trains.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grazierville_pennsylvania"
    },
    {
      "id": 4,
      "text": "Nestled at about 938 feet, Grazierville sits in the rolling foothills of the Appalachian Mountains.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grazierville_pennsylvania"
    },
    {
      "id": 5,
      "text": "Grazierville experiences a warm‑summer humid continental climate, with cold, snowy winters and warm, humid summers.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/grazierville_pennsylvania"
    },
    {
      "id": 6,
      "text": "Grazierville’s early growth was tied to Blair County’s 19th‑century iron industry, a key driver of regional development.",
