  "facts": [
    {
      "id": 1,
      "text": "Vallonia began as a French‑American outpost along the Muscatatuck and White Rivers, drawing about 90 families by 1810.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vallonia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name derives from the French settlement that evolved into Fort Vallonia, a key frontier fortification in the late 1700s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vallonia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the War of 1812, two companies of Indiana Rangers were stationed at Fort Vallonia to guard against Native American attacks.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vallonia%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Major John Tipton assumed command of the fort after learning of the Rangers’ conduct, instituting routine drills for the stationed companies.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vallonia%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today a replica of the original fort stands, and the community hosts Fort Vallonia Days each October, drawing up to 30,000 visitors.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/vallonia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Fort Vallonia Museum, open on festival weekends, displays artifacts that chronicle the town’s early history and frontier life.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
