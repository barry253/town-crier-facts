  "facts": [
    {
      "id": 1,
      "text": "Chadron was first named O'Linn for founder Fannie O'Linn who built a community at the confluence of White River and Chadron Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chadron%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1884 the town was formally established when the Fremont, Elkhorn, and Missouri Valley Railroad was constructed through the area from Omaha, en route to Wyoming.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chadron%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Museum of the Fur Trade sits near Chadron at the site of the American Fur Company's former Bordeaux Trading Post.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chadron%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chadron hosts an 11‑story high‑rise on the campus of Chadron State College, the tallest building in the Nebraska Panhandle.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chadron%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
