  "facts": [
    {
      "id": 1,
      "text": "Mason Neck is a peninsula jutting into the Potomac River, surrounded by Belmont Bay, Pohick Bay, and Gunston Cove.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason_Neck%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "George Mason’s 1750s mansion Gunston Hall, the birthplace of the Virginia Declaration of Rights, sits on Mason Neck.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://brainvoyage.blog/mason-neck-va-guide",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1969 residents and conservation groups secured the Elizabeth Hartwell Mason Neck National Wildlife Refuge to protect bald eagles.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason_Neck%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The refuge now hosts over 211 bird species, including great blue herons, Canada geese, and ospreys.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason_Neck%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the 19th century, logging of mature pine and hardwood shaped the peninsula’s landscape before forests regenerated.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mason_Neck%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic Pohick Church on Mason Neck was frequented by George Washington and later served as a Civil War hospital.",
