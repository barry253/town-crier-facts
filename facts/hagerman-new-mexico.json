  "facts": [
    {
      "id": 1,
      "text": "Hagerman was founded in 1893 when the Pecos Valley Town Company, incorporated in 1889, chose its site along the Pecos River.",
      "sourceSentenceIds": [
        6,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.hagermanforward.com/about-us/community-history"
    },
    {
      "id": 2,
      "text": "James John Hagerman, the railroad builder from Eddy to Roswell, became president of the Pecos Valley Town Company and selected the town’s location.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hagermanforward.com/about-us/community-history"
    },
    {
      "id": 3,
      "text": "Hagerman sits about two miles west of the Pecos River, nestled between the junction of the Felix and Pecos Rivers.",
      "sourceSentenceIds": [
        18,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hagerman%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "The original Hagerman school building, erected in the late 1800s, still serves the town’s elementary, middle, and high schools.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hagerman%2C_New_Mexico"
    },
    {
      "id": 5,
      "text": "New Mexico State Road 2 runs through Hagerman, forming a vital north‑south route across Chaves County.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hagerman%2C_New_Mexico"
    },
    {
      "id": 6,
      "text": "The town site occupies the southeast quarter of Section 10, Township 14, south of Range 26 east of the New Mexico Principal Meridian.",
