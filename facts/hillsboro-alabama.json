  "facts": [
    {
      "id": 1,
      "text": "Hillsboro began as Gilmersville, named after the Gilmer family, before adopting its current name in 1891.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/hillsboro/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the railroad ran through the area in the 1860s, Hillsboro relocated to sit directly on the tracks.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hillsboro%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Local resident William Gilmer secured a contract to supply trains with wood and built a sawmill beside the tracks, sparking the town’s growth.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/hillsboro/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Thomas Holland House in Hillsboro, listed on both the Alabama and National Registers of Historic Places, reflects the town’s ante‑bellum heritage.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/hillsboro/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pond Spring, the historic General Joe Wheeler Home, sits just west of Hillsboro and offers a glimpse into the region’s Civil War past.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
