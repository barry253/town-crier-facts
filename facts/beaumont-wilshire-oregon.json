  "facts": [
    {
      "id": 1,
      "text": "Beaumont‑Wilshire sits on Alameda Ridge, offering sweeping views of downtown Portland, the Willamette River, and the Cascades.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont-Wilshire%2C_Portland%2C_Oregon",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood split into Beaumont south of NE Fremont and Wilshire north, yet they joined forces in 1910 to form the Beaumont‑Wilshire Neighborhood Association.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont-Wilshire%2C_Portland%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beaumont School opened in 1914; its brick building, finished in 1926, still stands as a local landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont-Wilshire%2C_Portland%2C_Oregon",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area was first platted as part of the Rose City Park subdivision in 1907, originally called the Crook Tract in 1890.",
      "sourceSentenceIds": [
        4,
        27,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont-Wilshire%2C_Portland%2C_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1911 concrete sidewalks appeared south of NE Fremont, and streets were paved a few years later, marking early modern infrastructure.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beaumont-Wilshire%2C_Portland%2C_Oregon",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "A historic walk on May 30, 2026 highlighted Beaumont’s “beautiful mountain” name, its streetcar route, and a wealthy family’s compound for seven children.",
