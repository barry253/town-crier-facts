  "facts": [
    {
      "id": 1,
      "text": "Kotzebue was originally called Kikiktagruk, meaning \"almost an island,\" and served as a trading hub where rivers converged.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kikiktagruk.com/shareholders/village-profile/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name honors Otto von Kotzebue, a Baltic German explorer who charted the sound while hunting the Northwest Passage in 1818.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kotzebue%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kotzebue hosts the Maniilaq Association, a tribally‑operated health and social services organization part of the Alaska Native Tribal Health Consortium.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kotzebue%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1897, a reindeer station was established, later becoming the city’s first permanent settlement and a key point for Russian fur traders.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Kotzebue",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Noatak, Selawik, and Kobuk Rivers empty into Kotzebue Sound, making the town a historic transportation center for inland communities.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kotzebue%2C_Alaska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kotzebue Air Force Station, completed in 1958, operated a radar site until 1983, reflecting Cold War military presence in the Arctic.",
      "sourceSentenceIds": [
