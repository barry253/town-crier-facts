    },
    {
      "id": 2,
      "text": "The East Broad Top Railroad cut through Three Springs in 1874, and its tracks remain owned by the railroad though unused since 1956.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
