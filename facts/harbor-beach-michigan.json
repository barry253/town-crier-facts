  "facts": [
    {
      "id": 1,
      "text": "Harbor Beach began in 1838 when two lumbermen built a sawmill on the shore of Lake Huron.",
      "sourceSentenceIds": [
        7,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.harborbeach.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The settlement was renamed Barnettsville in 1855, then Sand Beach, before adopting the name Harbor Beach in 1899.",
      "sourceSentenceIds": [
        2,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harbor_Beach%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Harbor Beach boasts the world’s largest man‑made freshwater harbor, a marvel of 19th‑century engineering.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harbor_Beach%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pointe Aux Barques Lighthouse and Keepers Museum on Lighthouse Road offers a vivid look at local maritime history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thumbcoast.org/area-info/our-communities/harbor-beach/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every summer the Harbor Beach Maritime Festival lights up the harbor with a fireworks display that ranks as the area’s biggest.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thumbcoast.org/area-info/our-communities/harbor-beach/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The open‑air Farmers Market, held at Frank Murphy Museum, opens daily at 2 p.m. and showcases local produce and crafts.",
      "sourceSentenceIds": [
