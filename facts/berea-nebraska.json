      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1923 Berea supported a depot, grain elevator, blacksmith shop, post office, school, filling station, garage, lumberyard, cream station, and Farmers Union store.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
