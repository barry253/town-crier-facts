  "facts": [
    {
      "id": 1,
      "text": "Peru's early economy boomed with a canning factory, cider plant, ice plant, box factory, brickyard, and flour mill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.perune.gov/ourroots"
    },
    {
      "id": 2,
      "text": "In 1857, settlers founded Peru down the hill from Mount Vernon, right on the Missouri River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_Nebraska"
    },
    {
      "id": 3,
      "text": "The Burlington and Missouri River Railroad arrived in Peru the same year it was founded, 1857.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.perune.gov/ourroots"
    },
    {
      "id": 4,
      "text": "In 1861 a Methodist school called Mount Vernon Academy opened, and by 1867 it became Nebraska’s first normal school, now Peru State College.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_Nebraska"
    },
    {
      "id": 5,
      "text": "Floods in the 1860s shifted the Missouri River almost a mile away from Peru, reshaping the town’s geography.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Peru%2C_Nebraska"
    },
    {
      "id": 6,
      "text": "Before settlers, the area that is now Peru was originally inhabited by the Otoe Indians.",
