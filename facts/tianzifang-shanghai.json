  "facts": [
    {
      "id": 1,
      "text": "Tianzifang grew from a 1933 Shikumen block that once housed ordinary residents before artists moved in the late 20th century.",
      "sourceSentenceIds": [
        23,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tianzifang"
    },
    {
      "id": 2,
      "text": "The name “Tianzifang” comes from painter Huang Yongyu honoring the ancient artist Tian Zifang, a Warring States period figure.",
      "sourceSentenceIds": [
        3,
        15,
        22,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://english.shanghai.gov.cn/en-ScenicSpots/20250220/07accc0710864d548ccc1edf621c353f.html"
    },
    {
      "id": 3,
      "text": "Before redevelopment, the area was Shanghai’s industrial cradle, hosting more than ten small factories and handicraft workshops.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-ScenicSpots/20250220/07accc0710864d548ccc1edf621c353f.html"
    },
    {
      "id": 4,
      "text": "Early 20th‑century factories still line Tianzifang’s alleys, preserved as a living window into Shanghai’s industrial past.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://english.shanghai.gov.cn/en-ScenicSpots/20250220/07accc0710864d548ccc1edf621c353f.html"
    },
    {
      "id": 5,
      "text": "Artists, business owners, and residents joined forces in the 2010s to preserve the original Shikumen architecture and stop redevelopment.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.chinahighlights.com/shanghai/attraction/tianzifang.htm"
    },
    {
      "id": 6,
      "text": "Tianzifang lies just a short walk north of Dapuqiao Metro Station on Line 9, making it easily reachable by public transit.",
      "sourceSentenceIds": [
        12,
        13
      ],
