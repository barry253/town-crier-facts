  "facts": [
    {
      "id": 1,
      "text": "Madera Ranchos grew around a 54‑mile lumber flume built in 1876 that carried logs from the Sierra Nevada into the San Joaquin Valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madera.gov/parks-community-services/history-of-madera/"
    },
    {
      "id": 2,
      "text": "The town’s name, Madera, comes from the Spanish word for lumber, reflecting its early logging roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madera.gov/parks-community-services/history-of-madera/"
    },
    {
      "id": 3,
      "text": "By 1910, Madera Ranchos supported both animal husbandry and crop cultivation, diversifying its economy beyond timber.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madera.gov/parks-community-services/history-of-madera/"
    },
    {
      "id": 4,
      "text": "The Miller & Lux cattle operations were a major employer, using local crops for feed and shaping the region’s agricultural profile.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madera.gov/parks-community-services/history-of-madera/"
    },
    {
      "id": 5,
      "text": "Madera County was officially created in 1893, with Madera Ranchos becoming the county seat three years later in 1896.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.madera.gov/parks-community-services/history-of-madera/"
    },
    {
      "id": 6,
      "text": "In 1912, Yosemite Avenue was “paved” by spreading oil over dirt to control dust, a practical solution before asphalt arrived.",
