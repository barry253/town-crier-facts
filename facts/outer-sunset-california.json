  "facts": [
    {
      "id": 1,
      "text": "Outer Sunset began as sand dunes and farmland, largely uninhabited until the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        2,
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://sanfrancisco.wiki/a/Outer_Sunset",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1909 streets were renamed to avoid mail confusion; 1st Avenue became Arguello Boulevard and 49th Avenue became La Playa Street.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s avenues were numbered 1st through 49th, with 13th Avenue uniquely called Funston Avenue after Frederick Funston.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Outer Sunset’s climate is cooler and more humid than downtown, thanks to Pacific fog and the ocean breeze that rolls in from the west.",
      "sourceSentenceIds": [
        10,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://sanfrancisco.wiki/a/Outer_Sunset",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area once called “Outside Lands” was covered by dunes; after the 1906 earthquake, development surged, building tract homes into the sand.",
      "sourceSentenceIds": [
        19,
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sunset_District%2C_San_Francisco",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lands End north of Ocean Beach offers rugged trails and historic sites, extending Outer Sunset’s coastal character into a natural playground.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
