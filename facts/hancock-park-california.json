  "facts": [
    {
      "id": 1,
      "text": "Hancock Park takes its name from developer George Allan Hancock, who subdivided the area in the 1920s.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_Park%2C_Los_Angeles",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hancock family donated the land that became the park in 1916 to preserve the nearby La Brea tar pits.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_Park%2C_Los_Angeles",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1948 Nat King Cole became the first African‑American family to purchase a Tudor mansion in Hancock Park.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_Park%2C_Los_Angeles",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A Historic Preservation Overlay Zone protects Hancock Park, keeping its early‑20th‑century period‑revival homes intact.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hancock_Park%2C_Los_Angeles",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Architects of the era built palatial two‑story homes in Tudor, Spanish Colonial, Mediterranean, and other revival styles across the neighborhood.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://planning.lacity.gov/preservation-design/overlays/hancock-park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents opposed a Metro Rail extension through Hancock Park, leading to a ban on the line and keeping the neighborhood free of a station.",
