  "facts": [
    {
      "id": 1,
      "text": "Clyde Park was founded in the 1870s as Sunnyside by Texas cattlemen who were attracted to the area for grazing.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clyde_Park%2C_Montana"
    },
    {
      "id": 2,
      "text": "The town may have been named for a local rancher named Clyde Durand or for a Clydesdale horse imported from England.",
      "sourceSentenceIds": [
        5,
        11,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Clyde_Park%2C_Montana"
    },
    {
      "id": 3,
      "text": "Clyde Park is located in the Shields River valley and is home to the G Bar M dude ranch.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clyde_Park%2C_Montana"
    },
    {
      "id": 4,
      "text": "The historic Shiplet Ranch features barns dating back to the 1870s and a livestock brand shaped like Montana.",
      "sourceSentenceIds": [
        8,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clyde_Park%2C_Montana"
    },
    {
      "id": 5,
      "text": "Clyde Park celebrates its pioneer history every year during the Old Settler's Days festival, featuring an art show and parade.",
      "sourceSentenceIds": [
        9,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clyde_Park%2C_Montana"
    },
    {
      "id": 6,
      "text": "The Northern Pacific Railway established a branch line to the town in 1909, leading to its incorporation in 1912.",
