  "facts": [
    {
      "id": 1,
      "text": "Fayetteville was founded in 1822 as the seat of newly formed Fayette County, organized from land ceded by the Creek under a treaty during Indian removal.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Both the town and county are named after the French Marquis de Lafayette, who aided George Washington and visited Georgia in 1825.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Fayetteville%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original Fayette County Courthouse, built in 1825, is Georgia's oldest courthouse and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/fayetteville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of the railroad in 1888, later called the Atlanta and Florida line, sparked a post‑Civil War recovery in Fayetteville.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/fayetteville/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Margaret Mitchell Library, built in 1948, serves as the headquarters of the Fayette County Historical Society and honors the author of “Gone with the Wind.”.",
      "sourceSentenceIds": [
