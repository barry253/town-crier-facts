  "facts": [
    {
      "id": 1,
      "text": "Brookville’s Hillwood mansion, a 70‑room estate on 178 acres, was built by cereal magnate Marjorie Post and financier Edward Hutton.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.villageofbrookville.gov/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Brookville Church, founded by 17th‑century Dutch settlers, still stands as one of America’s oldest congregations.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1931, local estate owners united to incorporate Brookville, aiming to curb unwanted residential and commercial growth.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Brookville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Planting Fields Arboretum, once William Robertson Coe’s estate, now spans 300 acres of gardens and historic buildings.",
      "sourceSentenceIds": [
        23,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/brookville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brookville’s winding roads and grand estates earned it a spot on Long Island’s historic Gold Coast, home to Gilded Age families.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.longislandguide.com/visit/brookville/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Templeton estate in Brookville later served as a filming location for Dudley Moore’s 1980 comedy Arthur.",
