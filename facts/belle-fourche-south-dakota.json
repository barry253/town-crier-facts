  "facts": [
    {
      "id": 1,
      "text": "Belle Fourche’s name, meaning “beautiful fork,” comes from French explorers who noted the confluence of the Belle Fourche, Redwater Rivers and Hay Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Fourche%2C_South_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cattle barons and the railroad needed a loading spot, so Seth Bullock founded Belle Fourche, turning it into a key cattle‑shipping hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Belle_Fourche%2C_South_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city sits where the Redwater and Belle Fourche rivers meet, just north of the Wyoming border and about 60 miles northwest of Rapid City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Belle-Fourche",
