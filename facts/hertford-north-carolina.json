  "facts": [
    {
      "id": 1,
      "text": "Hertford was chartered in 1758 and named after North Carolina governor’s patron, the Earl of Hertford.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitncne.com/historic-hertford/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s oldest known brick structure, the Newbold‑White House, dates back to 1730 and is the oldest brick building in North Carolina.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hertford%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic swing bridge with S‑shaped approaches still spans the Perquimans River, a modern replacement of the original floating bridge.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hertford%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hertford’s historic district includes landmarks like the Church of the Holy Trinity and the Newbold‑White House, all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hertford%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2000, Hertford earned recognition as a North Carolina Main Street Community, highlighting its preserved downtown charm.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitncne.com/historic-hertford/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s founding in 1669 began as a land grant known as Phelps Point before evolving into the county seat of Perquimans County.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
