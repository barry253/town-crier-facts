    },
    {
      "id": 2,
      "text": "Harrisville was named for James Harris, who served as the community's first postmaster when the post office opened in March 1851.",
      "sourceSentenceIds": [
        2,
        3,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
