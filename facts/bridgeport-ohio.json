  "facts": [
    {
      "id": 1,
      "text": "Bridgeport was originally called Canton and was laid out in 1806 by Colonel Ebenezer Zane.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The village’s name comes from a bridge built near the town in the 1810s that crossed the Ohio River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Bridgeport sits across the Ohio River from Wheeling, West Virginia, and is linked by two bridges to Wheeling Island.",
      "sourceSentenceIds": [
        20,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Olympic wrestler Bobby Douglas and Hall of Fame basketball star John Havlicek hail from Bridgeport, highlighting its sports legacy.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://belmontcountytourism.info/bridgeport/"
    },
    {
      "id": 5,
      "text": "The town flourished as an industrial hub in its early days, with mills, factories, and warehouses supporting regional growth.",
      "sourceSentenceIds": [
        8
      ],
