      "id": 1,
      "text": "Bridgeport was originally called Canton and was laid out in 1806 by Colonel Ebenezer Zane.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name comes from a bridge built near the town in the 1810s that crossed the Ohio River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bridgeport sits across the Ohio River from Wheeling, West Virginia, and is linked by two bridges to Wheeling Island.",
      "sourceSentenceIds": [
        20,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bridgeport%2C_Ohio",
