      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kypseli's urban boom began in the 1930s with Bauhaus and Art Deco apartment blocks that still line Fokionos Negri Street.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
