      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1937 municipal market on Fokionos Negri Street was inaugurated by dictator Ioannis Metaxas.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kypseli%2C_Athens",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A new generation of artists now fills converted ground‑floor apartments, turning old Bauhaus facades into creative hubs.",
