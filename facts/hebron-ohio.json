  "facts": [
    {
      "id": 1,
      "text": "Hebron was laid out in 1827 by John Smith and became a key link in the Ohio Canal System.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hebronvillage.org/history"
    },
    {
      "id": 2,
      "text": "In 1834 Hebron was established as the sixth town in Licking County and sits on the historic National Road.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.hebronvillage.org/history"
    },
    {
      "id": 3,
      "text": "The completion of the National Trail turned Hebron into a bustling stop for stagecoaches, prairie schooners, and horseback riders, some staying at the Myers Hotel.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hebronvillage.org/history"
    },
    {
      "id": 4,
      "text": "The Ohio Electric Interurban Cars arrived in the early 1900s, bringing prosperity for over three decades before the line faded.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hebronvillage.org/history"
    },
    {
      "id": 5,
      "text": "Hebron’s library is a branch of the Licking County Library System, serving as a community hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hebron%2C_Ohio"
    },
    {
      "id": 6,
      "text": "The village proudly brands itself as the “Historic Crossroads of Ohio,” a slogan that echoes its long‑standing role as a transportation hub.",
      "sourceSentenceIds": [
