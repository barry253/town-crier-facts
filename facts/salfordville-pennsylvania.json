    {
      "id": 1,
      "text": "Salfordville sits at the intersection of Old Skippack Road and Wolford Road/Bergey Road.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/PA/Montgomery_County/Upper_Salford_Township/Salfordville.html"
    },
    {
      "id": 2,
      "text": "The village was founded in 1727 as part of the original Salford Township.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uppersalfordtownship.com/early-history/"
    },
    {
      "id": 3,
      "text": "When the railroad arrived in 1868, Salfordville grew around an old inn, thriving without rail or trolley.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://uppersalfordtownship.com/early-history/"
    },
    {
      "id": 4,
      "text": "A 300‑year‑old Christopher Dock White Oak once stood here; after a storm it was replanted with a bronze plaque.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/PA/Montgomery_County/Upper_Salford_Township/Salfordville.html"
    },
    {
      "id": 5,
      "text": "Salfordville was a bustling 18th‑century market for livestock and farm goods.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.livingplaces.com/PA/Montgomery_County/Upper_Salford_Township/Salfordville.html"
    },
    {
      "id": 6,
      "text": "The village’s name changed to Mechanicsville before becoming Salfordville.",
