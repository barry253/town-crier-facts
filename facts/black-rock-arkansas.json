  "facts": [
    {
      "id": 1,
      "text": "Black Rock, Arkansas, sprang into existence in 1884 when the Kansas City, Fort Scott, and Gulf Railroad arrived, turning a quiet riverside spot into a timber boomtown.",
      "sourceSentenceIds": [
        11,
        12,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/black_rock_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1897 a pearl rush along the Black River sparked the Black Rock Pearl Button Company, the South’s first factory to turn mussel shells into clothing buttons.",
      "sourceSentenceIds": [
        5,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/black_rock_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1890 Black Rock boasted ten sawmills, shingle mills, planing mills, a furniture factory, a handle factory, and a wagon factory, all powered by local hardwood forests.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/black_rock_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After World War II, synthetic plastics replaced mussel‑shell buttons, causing Black Rock’s last button factory to close in 1954.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/black_rock_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic Sanborn Fire Insurance Maps from 1904, 1908, and 1914 give a detailed window into Black Rock’s downtown layout and businesses.",
