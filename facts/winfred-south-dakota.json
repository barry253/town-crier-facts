  "facts": [
    {
      "id": 1,
      "text": "Winfred was established in 1882 as a planned community during the Great Dakota Boom to attract settlers to the fertile prairies.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/winfred_south_dakota"
    },
    {
      "id": 2,
      "text": "Early settlers arrived in Winfred via immigrant trains from Wisconsin and Iowa, drawn by the region's rich black loam soils.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/winfred_south_dakota"
    },
    {
      "id": 3,
      "text": "Winfred's early economy thrived on wheat, flax, and oats, with sheep and cattle production also bolstering local prosperity in the 1880s.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/winfred_south_dakota"
    },
    {
      "id": 4,
      "text": "The Congregational Church served as a central community institution in Winfred, hosting events that fostered social cohesion among residents.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/winfred_south_dakota"
    },
    {
      "id": 5,
      "text": "Winfred was formally incorporated as a town in 1902 before eventually becoming unincorporated in 1995.",
      "sourceSentenceIds": [
        22,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/winfred_south_dakota"
    },
    {
      "id": 6,
      "text": "Lake Winfred is a natural water body located just northeast of the center of town.",
