      "id": 1,
      "text": "Paxton was founded in 1859 as Prospect City and renamed after Sir Joseph Paxton, architect of the Crystal Palace.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxton%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 80‑foot brick water tower, built in 1887, still stands and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxton%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Paxton Carnegie Library, a 1903 copper‑domed building, has served as a temple to knowledge for over a century.",
      "sourceSentenceIds": [
        3,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxton%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1905 the Paxton Chautauqua began in Pells Park, drawing musicians and speakers from across the U.S. until 1930.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxton%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ford County Courthouse, erected in 1906, features WPA murals painted during the 1930s.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paxton%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
