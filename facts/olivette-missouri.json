  "facts": [
    {
      "id": 1,
      "text": "Olivette’s name means “olive grove,” a nod to the Spanish word oliva and Latin olivae, reflecting the town’s early agricultural roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/olivette-45564",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city was officially incorporated in 1930 when the communities of Central, Tower Hill, Olive, and Stratmann merged into one.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Olivette%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Olivette’s first brick schoolhouse, built in the early 1900s, marked the town’s transition from a farming community to a growing suburb.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Olivette%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A water reservoir finished in 1926 at Brock’s Pond supplied the town and later became the centerpiece of the surrounding Stacy Park.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Olivette%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stacy Park, formed around the reservoir, is now Olivette’s largest park and a popular spot for family outings and community events.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Olivette%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Olivette City Hall, erected in the mid‑20th century, remains a historic landmark that has served the community for decades.",
      "sourceSentenceIds": [
