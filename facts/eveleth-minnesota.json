  "facts": [
    {
      "id": 1,
      "text": "Eveleth was named after Erwin Eveleth, a prominent timber company employee who helped develop the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eveleth%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was platted on April 22, 1893, about a mile southwest of its current site on land that later became the Adams‑Spruce Mine.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eveleth%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Iron ore was discovered beneath Eveleth in 1895, and the town’s first post office opened the same year.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eveleth%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Eveleth hosts the United States Hockey Hall of Fame, honoring the region’s rich hockey heritage.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eveleth%2C_Minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Downtown Eveleth proudly displays the world’s largest hockey stick, a landmark that attracts hockey fans.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.evelethheritage.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1984 independent drama Wildrose was filmed largely in Eveleth, showcasing the town’s rugged mining backdrop.",
