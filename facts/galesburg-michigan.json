      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Inside the museum, visitors see vintage farming equipment, historic photographs, and artifacts that trace the area’s rural past.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museumsdatabase.com/museums/view/15245",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Galesburg lies on the north side of the Kalamazoo River, about ten miles east of Battle Creek and ten miles west of Kalamazoo.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Galesburg%2C_Michigan",
