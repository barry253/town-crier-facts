      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Galesburg Historical Society and Museum sits in the former city hall and fire station, a restored historic building downtown.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
