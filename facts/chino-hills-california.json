      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chino Hills became a Butterfield Overland Mail stagecoach station in 1858, linking Southern California to the east.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
