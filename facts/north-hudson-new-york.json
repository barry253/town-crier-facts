      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Hudson%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early settlers arrived in the early 1800s, clearing land for potato farming along Blue Ridge Road.",
      "sourceSentenceIds": [
        7,
        9
      ],
