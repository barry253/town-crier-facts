      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The community’s name reflects its location near the tributary Dwaas Kill, which feeds wetlands and floodplains along the western edge of the CDP.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clifton_knolls_mill_creek_new_york",
