      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Historically, the area was part of the ancestral lands of the Mohawk and Mohican peoples, members of the Iroquois Confederacy and Algonquian language groups.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
