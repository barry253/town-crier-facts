  "facts": [
    {
      "id": 1,
      "text": "Sandwich was founded in 1855 when Almon Gage donated land for a depot on the Chicago, Burlington & Quincy Railroad.",
      "sourceSentenceIds": [
        2,
        15,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sandwich,_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was briefly called Newark Station before being renamed Sandwich in 1856 by John Wentworth, who named it after his hometown in New Hampshire.",
      "sourceSentenceIds": [
        21,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sandwich,_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic 1879 City Hall and Opera House in Sandwich, listed on the National Register in 1979, was restored in 1986 and still hosts events.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sandwich,_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sandwich’s annual Fair, originally a livestock show, was canceled only once in 2020 due to COVID‑19, marking the first interruption in its history.",
      "sourceSentenceIds": [
        16,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Sandwich%2C_Illinois",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Plano Molding Company, a long‑standing manufacturer in Sandwich, produces molded plastic furniture and tackle boxes, reflecting the city’s enduring manufacturing heritage.",
      "sourceSentenceIds": [
        23
      ],
