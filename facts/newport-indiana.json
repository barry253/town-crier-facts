      "id": 1,
      "text": "Newport sits where the Little Vermilion and Wabash rivers meet, a spot that helped make it a key river town in early Indiana.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
