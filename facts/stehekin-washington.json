  "facts": [
    {
      "id": 1,
      "text": "Stehekin means \"the way through\" in Salishan, named by Native Americans for its rare pass through the North Cascades.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stehekin%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bill Buzzard homesteaded the Buckner Orchard in 1889, building a log cabin that still stands today as a living piece of Stehekin’s pioneer history.",
      "sourceSentenceIds": [
        5,
        6,
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakechelan.com/area/stehekin/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gold seekers in the 1880s sparked a small rush, and by the 1890s a road linked the original dock to mining camps, though extensions stalled after 1949.",
      "sourceSentenceIds": [
        16,
        17,
        18,
        19,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stehekin%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stehekin has faced several forest fires—1993, 2006, 2015, and the 2024 Pioneer Fire—yet the town reopened in August 2024 with no buildings lost.",
      "sourceSentenceIds": [
        24,
        25,
        27,
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stehekin%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nestled at Lake Chelan’s northwest tip, Stehekin lies inside the Lake Chelan National Recreation Area managed by the National Park Service.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stehekin%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "To the northwest, the Glacier Peak Wilderness Area rises, offering rugged peaks that frame Stehekin’s dramatic landscape.",
