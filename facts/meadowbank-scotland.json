      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meadowbank_Stadium",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Edinburgh City football club returned to Meadowbank in 2016 after a decade away, rejoining the Scottish Professional Football League.",
      "sourceSentenceIds": [
