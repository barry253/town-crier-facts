      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meadowbank_Stadium",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before redevelopment, Meadowbank Stadium held 5,000 spectators, but its single stand now seats only 500.",
      "sourceSentenceIds": [
