  "facts": [
    {
      "id": 1,
      "text": "The name 'Indian Hill' emerged in the early 1800s, reflecting the area's Native American heritage.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Hill%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Native American tribes such as the Shawnee, Miami, and Delaware once hunted and fished in the area that is now Indian Hill.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Hill%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Many of the village's roads follow the paths of early Native American trails, preserving the historical significance of the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Hill%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indian Hill’s administration building sits where the Swing Line train once ran between downtown Cincinnati and Ramona Station.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Hill%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1924, four Cincinnati businessmen formed the Camargo Realty Company to turn the rolling country into a planned rural settlement.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Hill%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
