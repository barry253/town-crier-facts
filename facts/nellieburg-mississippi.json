  "facts": [
    {
      "id": 1,
      "text": "Nellieburg was founded in 1872 as a railroad stop on the Mobile and Ohio Railroad, named after Nellie Vick, the daughter of an early settler.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/mississippi_nellieburg",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town once hosted the “Doodlebug,” a slow passenger train nicknamed the “mud and misery local,” stopping at Nellieburg and several nearby rural communities.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/nellieburg_mississippi",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The eastern edge of Nellieburg borders Okatibbee Creek, a south‑flowing tributary of the Chickasawhay River that feeds the Pascagoula River watershed.",
      "sourceSentenceIds": [
        3,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/nellieburg_mississippi",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Daily sunrise in Nellieburg occurs at 7:23 a.m., while sunset falls at 6:42 p.m., giving the town an 11‑hour‑19‑minute daylight span.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/mississippi_nellieburg",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "In the late 19th century, Nellieburg emerged as a rural settlement during the broader pioneer expansion that followed Lauderdale County’s formation.",
