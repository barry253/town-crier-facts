  "facts": [
    {
      "id": 1,
      "text": "Savanna was named after the open prairie south of town, reflecting its landscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.savanna-il.us/savanna-history"
    },
    {
      "id": 2,
      "text": "In 1839 Savanna became the first county seat of newly formed Carroll County before the title moved to Mount Carroll.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.savanna-il.us/savanna-history"
    },
    {
      "id": 3,
      "text": "The town’s newspaper history began in 1854 when Charles Allen and Smith Atkins founded The Register.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.savanna-il.us/savanna-history"
    },
    {
      "id": 4,
      "text": "Savanna was once a bustling hub for river commerce and railroads, a legacy still visible in its streets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.exploresavanna.com/"
    },
    {
      "id": 5,
      "text": "In 1885 Frank Greenleaf founded The Savanna Journal, the county’s only Democratic newspaper, later becoming the Savanna Daily Journal.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
