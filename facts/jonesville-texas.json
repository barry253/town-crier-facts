  "facts": [
    {
      "id": 1,
      "text": "Founded as Border in the mid‑1840s because of its proximity to Louisiana, Jonesville began life as a frontier trading post.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/jonesville-tx-harrison-county"
    },
    {
      "id": 2,
      "text": "The town was renamed Jonesville after William Jones, who opened the first store in the community.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/jonesville-tx-harrison-county"
    },
    {
      "id": 3,
      "text": "In 1868 the settlement moved a mile south to sit on the then‑new Southern Pacific Railroad line.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/jonesville-tx-harrison-county"
    },
    {
      "id": 4,
      "text": "The former Concord community merged into Jonesville, and by 1988 only a cemetery and a historical marker marked its old site.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/jonesville-tx-harrison-county"
    },
    {
      "id": 5,
      "text": "A Masonic lodge was built on land donated by Spencer C., adding a historic social hub to the town.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/jonesville-tx-harrison-county"
