  "facts": [
    {
      "id": 1,
      "text": "Deer, Arkansas, was founded in 1898 by families like the Adams, Jones, and Taylor, and its name comes from a beloved pet deer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlement, the area that is now Deer was part of the Osage Nation’s hunting grounds, used for seasonal hunting and trade.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Deer sits at 2,096 feet, giving it a humid subtropical climate that feels cooler than most of Arkansas.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Buffalo National River, a 135‑mile undammed waterway, runs through Newton County just south of Deer, offering scenic recreation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Deer’s economy included a Joe Cowell family cannery, reflecting the community’s self‑sufficient farming and timber roots.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, Deer’s region saw guerrilla fighting and bushwhacking, with Union forces burning nearby Jasper in 1863.",
      "sourceSentenceIds": [
