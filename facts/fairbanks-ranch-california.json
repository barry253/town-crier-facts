  "facts": [
    {
      "id": 1,
      "text": "Fairbanks Ranch was originally built by Juan Lorenzo Bandini, and his daughter's bed and rocking chair still sit in the house.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hauntedplaces.org/fairbanks-ranch-ca/"
    },
    {
      "id": 2,
      "text": "Fairbanks Ranch borders Rancho Santa Fe to the northwest, Rancho Santa Fe Farms to the south, and Black Mountain Ranch to the east.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairbanks_Ranch%2C_California"
    },
    {
      "id": 3,
      "text": "The San Dieguito River and Lusardi Creek, with the Lusardi Creek County Preserve, lie to the north of Fairbanks Ranch.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairbanks_Ranch%2C_California"
    },
    {
      "id": 4,
      "text": "Fairbanks Ranch covers 5.1 square miles, almost all land, with a tiny 0.09% water area.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairbanks_Ranch%2C_California"
    },
    {
      "id": 5,
      "text": "Fairbanks Ranch observes Pacific Time and switches to daylight saving time like the rest of California.",
