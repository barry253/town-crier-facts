    {
      "id": 1,
      "text": "Rosh HaAyin’s name comes from the Yarkon River’s source, with 'Rosh' meaning head and 'Ayin' meaning spring.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
