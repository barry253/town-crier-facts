  "facts": [
    {
      "id": 1,
      "text": "Gangnam literally means 'south of the Han River,' a name that dates back to the early Joseon period.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gangnam_District",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bongeunsa Temple, founded during the Unified Silla era, still stands as a quiet witness to Seoul's ancient past.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gangnam_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seonjeongneung, the Joseon dynasty royal tombs, are preserved as national treasures and offer a glimpse into Korea's regal history.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gangnam_District",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Until the early 1980s Gangnam was Seoul's least developed area, but rapid growth over three decades turned it into a symbol of wealth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gangnam_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The COEX complex houses Korea's largest underground shopping mall and the Starfield Library, a glass atrium that draws visitors worldwide.",
