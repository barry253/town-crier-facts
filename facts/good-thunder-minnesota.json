  "facts": [
    {
      "id": 1,
      "text": "Good Thunder earned its name from Chief Good Thunder, a Dakota leader who opposed the 1862 war, and a nearby Winnebago chief.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/good_thunder_minnesota"
    },
    {
      "id": 2,
      "text": "Good Thunder sprang to life in 1870 when the railroad turned the Maple River ford into a bustling agricultural hub.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/good_thunder_minnesota"
    },
    {
      "id": 3,
      "text": "A mural by artist Ta‑Coumba Aiken, painted on a downtown wall, celebrates Good Thunder’s history and its “Village for the Arts” spirit.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/good_thunder_minnesota"
    },
    {
      "id": 4,
      "text": "Good Thunder protects its heritage with a local ordinance and a Historic Preservation Commission that safeguards historic buildings.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/good_thunder_minnesota"
    },
    {
      "id": 5,
      "text": "Good Thunder sits along the Maple River, a tributary that feeds into Minnesota’s larger river system.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Good_Thunder%2C_Minnesota"
    },
    {
      "id": 6,
      "text": "After mid‑century decline, Good Thunder revived its downtown with public art murals that now define its cultural identity.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/good_thunder_minnesota"
