  "facts": [
    {
      "id": 1,
      "text": "Lake Tapps was created in 1911 by Puget Sound Power & Light for hydroelectric power, stopping generation in 2004.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tapps",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The reservoir’s name comes from the nearby community of Tapps Island, itself linked to the Puyallup word “t'aps” meaning water.",
      "sourceSentenceIds": [
        12,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://discoveroutdoors.com/history/history-of-lake-tapps/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A diversion dam on the White River feeds water into Lake Tapps via a flume, then returns it downstream about 20 miles later.",
      "sourceSentenceIds": [
        26,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tapps",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Tapps covers roughly 4.5 square miles and boasts 45 miles of shoreline with many inlets, peninsulas, and islands.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tapps",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "In 2004 the lake was sold to the Cascade Water Alliance, a group of King County municipalities that now supply drinking water to 350,000 residents.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Tapps",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Agreements with the Muckleshoot and Puyallup Tribes keep instream flows for fish, preserving the lake’s aquatic life.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
