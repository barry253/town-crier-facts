    },
    {
      "id": 2,
      "text": "Oakmont’s name originates from a black oak tree on the Allegheny River bank mentioned in the original deed.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakmont%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The Kerr Memorial Museum, built in 1898, once housed the prominent Kerr family home.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oakmont%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Oakmont’s Carnegie Library, opened in 1899, was the tenth library funded by Andrew Carnegie in the U.S.",
