  "facts": [
    {
      "id": 1,
      "text": "Brimhall Nizhoni’s trading post, founded around 1900, served as a hub for Navajo herders exchanging wool and livestock.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brimhall_nizhoni_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Coyote Canyon Chapter House, a key community center, sits in Brimhall Nizhoni, reflecting the area’s Navajo heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brimhall_nizhoni_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Coyote Wash runs through the community, feeding into the Chaco River and ultimately the Colorado River watershed.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brimhall_Nizhoni%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The landscape is dominated by piñon‑juniper woodlands at mid‑elevations, with sagebrush and grasses lower down.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brimhall_nizhoni_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area averages 12 inches of precipitation annually, mostly from summer monsoons, and experiences temperatures from 15°F to 88°F.",
