  "facts": [
    {
      "id": 1,
      "text": "Anthem was founded as a master‑planned community by Del Webb in 1998 at the foothills north of Phoenix.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anthem%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on 5,856 acres at the base of Daisy Mountain and Gavilan Peak, giving it a higher elevation and cooler climate than downtown Phoenix.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anthem%2C_Arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Anthem’s community park spans 63 acres and includes an amphitheater, lakes, and a train, offering year‑round family activities.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anthem%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Anthem Community Center now boasts 14 outdoor concrete pickleball courts, the first dedicated pickleball facility in the Phoenix area.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anthem%2C_Arizona",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Anthem was originally codenamed “Project Dylan” during its planning phase, a nod to Bob Dylan that reflected the developers’ ambition for a lasting legacy.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://facts.net/history/culture/27-facts-about-anthem/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The CDP portion of Anthem covers 7.9 square miles, while the surrounding New River CDP borders it on three sides, keeping Anthem largely surrounded by open space.",
