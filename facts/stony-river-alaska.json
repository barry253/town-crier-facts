  "facts": [
    {
      "id": 1,
      "text": "Stony River earned its name in 1908 when U.S. Geological Survey geologist Arthur Gibson Maddren noted the river’s many water‑worn stones.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stony_river_alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Stony River originates at Stony Glacier in the Revelation Mountains of the Alaska Range, near Mount Mausolus, at an elevation of about 4,340 ft.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stony_river_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stony River village is the modern contact point between Yup'ik Eskimo and three distinct Athabaskan peoples: Deg Hit'an, Dena'ina, and Upper Kuskokwim.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stony_River%2C_Alaska",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Navigable by shallow‑draft boats for much of its length, the Stony River provides essential access to remote areas, with settlements like Stony River Village along its banks.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/stony_river_alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The river corridor features narrow bands of white spruce and hardwood timber, high‑value moose winter range, and important fish spawning grounds.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
