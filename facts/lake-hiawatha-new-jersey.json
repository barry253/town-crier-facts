  "facts": [
    {
      "id": 1,
      "text": "Lake Hiawatha’s name comes from Longfellow’s 1855 poem \"The Song of Hiawatha,\" reflecting 19th‑century literary influence.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_hiawatha_new_jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community began as a summer retreat around an artificial lake built as a reservoir, evolving into a year‑round residential neighborhood.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_hiawatha_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before Europeans, the Lenni‑Lenape people used the area that is now Lake Hiawatha as part of their northern New Jersey territory.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_hiawatha_new_jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Hiawatha sits within Lenapehoking, the traditional lands of the Munsee subtribe of the Lenape.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_Hiawatha%2C_New_Jersey",
