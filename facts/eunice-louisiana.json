  "facts": [
    {
      "id": 1,
      "text": "Eunice was founded in 1894 when developer C.C. Duson auctioned 150 lots, naming the town after his wife Eunice Pharr Duson.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cajuntravel.com/destinations/eunice/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Prairie Acadian Cultural Center in downtown Eunice tells the story of the Acadian people, now called Cajuns, and is part of the Jean Lafitte National Historic Park.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://cajuntravel.com/destinations/eunice/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1997, the Cajun Music Hall of Fame and Museum opened in Eunice, cementing the town’s reputation as a hub for Cajun music.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eunice%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every March, Eunice hosts the World Championship Crawfish Étouffée Cook-Off, drawing chefs and food lovers to the town’s vibrant culinary scene.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cajuntravel.com/destinations/eunice/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s celebrated Mardi Gras tradition, the Courir de Mardi Gras, features residents racing through streets in costume, a unique Cajun celebration.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cajuntravel.com/destinations/eunice/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "C.C. Duson, who also founded Crowley, persuaded the Southern Pacific Railroad to extend a branch line to Eunice, linking the town to regional trade.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
