      ],
      "source": "https://www.titusville.com/652/History-of-Titusville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was originally called Sand Point; a post office opened in 1859 but closed months later.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Titusville%2C_Florida",
      "category": "history",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Henry Flagler built a Florida East Coast Railroad station in Titusville in 1892, linking the city to the coast.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Titusville%2C_Florida",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city earned the nickname “The City of Churches” during a period of rapid church construction.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
