  "facts": [
    {
      "id": 1,
      "text": "Volo Bog was originally called the Sayer Bog, named after dairy farmer George Sayer who owned the land.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dnr.illinois.gov/parks/about/park.volobog.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before becoming a bog, the area was a deep 50‑acre lake with steep banks and poor drainage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dnr.illinois.gov/parks/about/park.volobog.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Three years after its designation, Volo Bog was registered as a National Natural Landmark by the U.S. Department of the Interior.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dnr.illinois.gov/parks/about/park.volobog.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village of Volo was officially incorporated on April 26, 1993, after decades of informal settlement.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Volo%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Volo is home to the Volo Auto Museum, a 75‑acre attraction that blends automotive history with pop‑culture exhibits.",
      "sourceSentenceIds": [
        20,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Volo%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cyrus Mark, the first president of the Illinois Nature Conservancy, led the effort to purchase Volo Bog for preservation.",
      "sourceSentenceIds": [
        21
      ],
