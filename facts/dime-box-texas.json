  "facts": [
    {
      "id": 1,
      "text": "Dime Box earned its name after the Southern Pacific Railroad built a line three miles southeast in 1913, prompting the town to relocate and rename itself.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Dime_Box%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original settlement became known as Old Dime Box, while the new community that sprang up beside the tracks was simply called Dime Box.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dime_Box%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dime Box sits on Farm Road 141, twelve miles northeast of Giddings in eastern Lee County, Texas.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/dime-box-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The town’s climate is humid subtropical, with hot, humid summers and mild to cool winters that spread precipitation evenly throughout the year.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dime_Box%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "In the early 20th century, frequent confusion between Brown's Mill and nearby Brownsville led residents to officially rename the town Dime Box.",
      "sourceSentenceIds": [
