  "facts": [
    {
      "id": 1,
      "text": "Elka Park began as a German‑American summer retreat founded in 1889 by members of New York City’s Liederkranz Club.",
      "sourceSentenceIds": [
        1,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.elkaparkclub.com/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name “Elka” comes from the German letters for “L” and “K,” honoring the club’s origins.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.elkaparkclub.com/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Between 1890 and 1896, 21 cottages were built, and today 17 original homes still stand in the hamlet.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.elkaparkclub.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original clubhouse burned in the 1950s and was rebuilt in a modest mid‑century style with eight lodge rooms for guests.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.elkaparkclub.com/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Elka Park’s club calendar runs from early May through mid‑October, offering a full slate of social events each season.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.elkaparkclub.com/history",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The hamlet lies 2.8 miles south‑southwest of Tannersville in Greene County, New York.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
