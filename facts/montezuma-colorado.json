  "facts": [
    {
      "id": 1,
      "text": "Montezuma was founded in 1865 after silver was found near Argentine Pass, sparking a boom that grew the town to 743 residents by 1881.",
      "sourceSentenceIds": [
        4,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Montezuma,_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Moctezuma II, the Aztec emperor, reflecting 19th‑century American fascination with Mesoamerican history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Montezuma,_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Montezuma’s historic core survives in unpaved streets lined with late‑19th‑century buildings, including a schoolhouse now a Colorado Historical Site.",
      "sourceSentenceIds": [
        1,
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Montezuma%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1958 Christmas fire destroyed the Summit House, one of the town’s original hotels, illustrating the community’s vulnerability to fire.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montezuma%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The paved road from Keystone climbs through forested peaks and ends at a sign marking Montezuma’s entrance, a route favored by backcountry skiers and hikers.",
      "sourceSentenceIds": [
        15,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montezuma%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "At 10,200 feet, Montezuma is one of only a handful of incorporated U.S. towns above 10,000 feet, offering a rare high‑altitude living experience.",
      "sourceSentenceIds": [
        30
