  "facts": [
    {
      "id": 1,
      "text": "Netarts is a small community situated at the mouth of Netarts Bay, just south of Oceanside.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visittheoregoncoast.com/cities/netarts/"
    },
    {
      "id": 2,
      "text": "In the language of the local Tillamook tribe, Netarts means near the water, the big water, or many waters.",
      "sourceSentenceIds": [
        21,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://visittheoregoncoast.com/cities/netarts/"
    },
    {
      "id": 3,
      "text": "Netarts is separated from the Pacific Ocean by a long, club-shaped stretch of forested sand called Netarts Spit.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visittheoregoncoast.com/cities/netarts/"
    },
    {
      "id": 4,
      "text": "The area around Netarts was once the earliest settlement site of the Tillamook Indians.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visittheoregoncoast.com/cities/netarts/"
    },
    {
      "id": 5,
      "text": "Netarts Bay is a seven-mile-long saltwater bay famous for clamming and popular for crabbing.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visittheoregoncoast.com/cities/netarts/"
    },
    {
      "id": 6,
      "text": "Netarts originally extended from Cape Lookout to Cape Meares.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://netartsbaytoday.org/History.html"
    }
  ]
