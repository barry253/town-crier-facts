  "facts": [
    {
      "id": 1,
      "text": "Palm City was founded in 1912 by developer Charles Chillingworth, a pioneer who helped shape early Florida development.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockinhranch.farm/uncategorized/visit-palm-city-30-historic-facts-about-palm-city-florida/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original name, Palm City Farms, reflected its early agricultural roots that still influence its wide open spaces today.",
      "sourceSentenceIds": [
        5,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockinhranch.farm/uncategorized/visit-palm-city-30-historic-facts-about-palm-city-florida/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1948 the Palm City Women’s Club was founded, becoming a cornerstone of community service and local events.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockinhranch.farm/uncategorized/visit-palm-city-30-historic-facts-about-palm-city-florida/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic citrus groves once covered large portions of Palm City, and some of those groves are still visible today.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://rockinhranch.farm/uncategorized/visit-palm-city-30-historic-facts-about-palm-city-florida/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Palm City’s equestrian culture thrives today, a legacy of its historic farms that shaped the community’s character.",
      "sourceSentenceIds": [
        6
