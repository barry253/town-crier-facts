    {
      "id": 2,
      "text": "The Confederated Tribes of Siletz Indians became the first tribe in Oregon to regain federal recognition after termination in 1977.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://theoregoncoastguide.com/siletz-oregon/"
    },
    {
      "id": 3,
      "text": "The Confederated Tribes of Siletz Indians consists of more than 30 bands with ancestral homelands from Northern California to Southern Washington.",
      "sourceSentenceIds": [
        5
