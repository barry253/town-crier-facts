      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890, Openshaw was incorporated into Manchester, ending its status as a separate Lancashire township.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Openshaw",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area once hosted a massive government munitions factory and railway yards that closed after World War I.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Openshaw",
      "category": "history",
      "quality": "poor",
      "qualityReason": "unverified=['smith']"
    },
    {
      "id": 4,
      "text": "Openshaw was a hotbed of early socialist activity; Keir Hardie spoke at the 1910 Openshaw Socialists meeting.",
      "sourceSentenceIds": [
        19
