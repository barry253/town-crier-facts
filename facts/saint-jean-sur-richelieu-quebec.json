  "facts": [
    {
      "id": 1,
      "text": "Saint‑Jean‑sur‑Richelieu was founded in 1666 when the French Carignan‑Salières Regiment built Fort Saint‑Jean on the Richelieu River.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Jean-sur-Richelieu",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first railway line in British North America connected Saint‑Jean‑sur‑Richelieu with La Prairie in 1836, making it a key transport hub.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Jean-sur-Richelieu",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every August, Saint‑Jean‑sur‑Richelieu hosts the International Balloon Festival, where hundreds of hot‑air balloons fill the sky for thousands of visitors.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Jean-sur-Richelieu",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city straddles both banks of the Richelieu River; a canal lock near downtown turns into a skating rink in winter and a cycling path in summer.",
      "sourceSentenceIds": [
        17,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Jean-sur-Richelieu",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 20‑kilometre Chambly Canal runs north along the west bank, providing modern freight passage to Chambly and the St. Lawrence region.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint-Jean-sur-Richelieu",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Vieux‑Saint‑Jean, the historic downtown, is lined with locally owned bars, restaurants, and shops on Richelieu and Champlain streets.",
