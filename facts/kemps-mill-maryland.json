      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kemp_Mill%2C_Maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Home to the largest Orthodox Jewish community between Baltimore and Miami, Kemps Mill hosts more than half a dozen synagogues.",
