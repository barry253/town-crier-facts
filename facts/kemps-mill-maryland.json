      "id": 1,
      "text": "Evan Thomas, a Quaker minister, founded the original Thomas’ Mill in 1745, turning the area into a modest saw and grist mill community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
