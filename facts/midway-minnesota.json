  "facts": [
    {
      "id": 1,
      "text": "Midway Township was homesteaded in 1862 and early settlers camped near Indian villages.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnmidwaytownshipslc.gov/?SEC=09627EA3-14D2-4C1C-BE2E-973621BD5718"
    },
    {
      "id": 2,
      "text": "The forest around Midway was virgin and fish were abundant in the 19th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnmidwaytownshipslc.gov/?SEC=09627EA3-14D2-4C1C-BE2E-973621BD5718"
    },
    {
      "id": 3,
      "text": "On November 6, 1894, land east of Midway became Proctor, and on July 7, 1896, Midway seceded from Fond Du Lac.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnmidwaytownshipslc.gov/?SEC=09627EA3-14D2-4C1C-BE2E-973621BD5718"
    },
    {
      "id": 4,
      "text": "In 1870, only eight families lived in Midway, split evenly between Finnish and Swedish heritage.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnmidwaytownshipslc.gov/?SEC=09627EA3-14D2-4C1C-BE2E-973621BD5718"
    },
    {
      "id": 5,
      "text": "Midway Township was honored as Township of the Year in 2012 by the state of Minnesota.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mnmidwaytownshipslc.gov/?SEC=09627EA3-14D2-4C1C-BE2E-973621BD5718"
    },
    {
      "id": 6,
      "text": "Midway sits at latitude 47.317 and longitude -95.7838 in Mahnomen County, northwestern Minnesota.",
