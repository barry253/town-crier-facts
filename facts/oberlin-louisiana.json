      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oberlin%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oberlin has a humid subtropical climate with long, hot summers and short, mild winters.",
