  "facts": [
    {
      "id": 1,
      "text": "Mount Dennis got its name from Loyalist shipbuilder John Dennis and his family who owned a Humber boatyard in the early 1800s.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Dennis",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1913 Kodak Canada moved its factory to Eglinton and Weston, creating the industrial hub known as Kodak Heights that employed most locals until 2005.",
      "sourceSentenceIds": [
        2,
        3,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Dennis",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The former Kodak power plant burned 500 tonnes of coal daily before closing in 2006, after which air quality improved dramatically.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Dennis",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mount Dennis’ library, 60 years old, reopened in 2013 after renovations, serving as a community hub.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Dennis",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2014 a public art piece called Nyctophilia appeared at Weston Road and Dennis Avenue, part of revitalization projects.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Dennis",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mount Dennis station will become the westernmost terminus of Line 5 Eglinton and a GO Transit stop when it opens, linking the neighbourhood to downtown.",
      "sourceSentenceIds": [
