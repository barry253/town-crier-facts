  "facts": [
    {
      "id": 1,
      "text": "Nelson Lagoon sits on a narrow sand spit that separates the lagoon from the Bering Sea on the northern coast of the Alaska Peninsula.",
      "sourceSentenceIds": [
        10,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Lagoon%2C_Alaska"
    },
    {
      "id": 2,
      "text": "The lagoon was named in 1882 for Edward William Nelson, a naturalist and explorer who traveled the region for several decades.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Lagoon%2C_Alaska"
    },
    {
      "id": 3,
      "text": "Nelson Lagoon is the only Aleut settlement located on the Bering Sea shore.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Lagoon%2C_Alaska"
    },
    {
      "id": 4,
      "text": "Historically, the area of Nelson Lagoon was used as an Unangan summer fish camp during the fishing season.",
      "sourceSentenceIds": [
        1,
        7,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Lagoon%2C_Alaska"
    },
    {
      "id": 5,
      "text": "Scandinavian fishermen operated a salmon salting facility here from 1906 to 1917, and many local residents still have partial Scandinavian ancestry.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nelson_Lagoon%2C_Alaska"
    },
    {
      "id": 6,
      "text": "A permanent settlement was established at Nelson Lagoon around 1960, making it the youngest of the Borough communities.",
