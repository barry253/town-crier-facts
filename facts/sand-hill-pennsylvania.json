  "facts": [
    {
      "id": 1,
      "text": "Sand Hill’s name literally describes a sandy rise, a feature early settlers used to spot the small elevation in the rolling terrain.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/sand-hill-126449",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s only landmark is the abandoned quarry locals call “The Deep Cut,” a relic of the area’s early industrial past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/sand-hill-126449",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Pennsylvania Route 343, known locally as North 7th Street, cuts through Sand Hill and once carried the defunct Reading Line train whistle.",
      "sourceSentenceIds": [
        10,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Sand_Hill%2C_Pennsylvania",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Sand Hill sits on the north side of the Lebanon Valley, its slopes giving the community a distinct hilltop feel.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sand_Hill%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Streams in the area drain south to Brandywine Creek, which feeds into Quittapahilla Creek, shaping the local watershed.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sand_Hill%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community includes the neighborhoods of Sand Hill, Sunset, and Reinohlsville, each reflecting the town’s modest growth.",
