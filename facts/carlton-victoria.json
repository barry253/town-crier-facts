      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carlton%2C_Victoria",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before European settlement, the lightly forested bushland that is now Carlton was home to the Wurundjeri people of the Woi‑wurrung language group.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
