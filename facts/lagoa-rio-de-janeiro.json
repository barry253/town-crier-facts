      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The lagoon links to the Atlantic Ocean through a canal named after Portuguese officer Rodrigo de Freitas de Carvalho.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
