      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lagoa borders Ipanema, Leblon, Copacabana, Gávea, Jardim Botânico, and Humaitá, making it a central Rio enclave.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
