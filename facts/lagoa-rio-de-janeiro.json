      ],
      "source": "https://www.gototravelguides.net/rio/attractions/lagoa-rodrigo-de-freitas-lagoon",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "In 1808 Emperor Dom João XVI established the Royal Gunpowder Factory on the lagoon’s shore.",
      "sourceSentenceIds": [
