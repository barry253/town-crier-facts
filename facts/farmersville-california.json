      ],
      "source": "https://en.wikipedia.org/wiki/Farmersville%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The old wooden store burned in 1951, was replaced by a Texaco station, and later converted into a Beacon station.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
