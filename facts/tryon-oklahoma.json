  "facts": [
    {
      "id": 1,
      "text": "Tryon is a town in Lincoln County, Oklahoma, known in the Iowa-Oto language as Ahéri Chína^iñe, meaning on-hill town little.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tryon%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The community of Tryon is named after an early pioneer landowner whose holdings influenced the naming of the town.",
      "sourceSentenceIds": [
        8,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Tryon%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Missouri, Kansas and Texas Railway arrived in 1902, helping to establish the town of Tryon.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/tryon_oklahoma"
    },
    {
      "id": 4,
      "text": "The Farmers and Merchants Bank in Tryon was founded in 1903 and became the target of several robberies.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TR016"
    },
    {
      "id": 5,
      "text": "Early settlers in Tryon faced challenges including soil infertility, frequent droughts, and economic instability during the early 1900s.",
