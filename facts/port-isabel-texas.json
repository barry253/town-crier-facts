    {
      "id": 1,
      "text": "Port Isabel’s oldest landmark, the lighthouse built in 1853, still stands as a reminder of the town’s early maritime watchtower.",
      "sourceSentenceIds": [
        10,
        9
      ],
      "sourceLabels": [
        "Web source 1",
