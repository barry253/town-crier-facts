  "facts": [
    {
      "id": 1,
      "text": "Bastrop was founded at a strategic Colorado River crossing of the Old San Antonio Road in 1804, where Spanish soldiers built a fort called Puesta del Colorado.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bastrop%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1832, land commissioner José Miguel de Arciniega officially named the town Bastrop, honoring a Dutch commoner who had emigrated to Texas.",
      "sourceSentenceIds": [
        8,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bastrop-texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bastrop’s historic core was laid out on Mexican town plans with a central square that never materialized, giving the city a unique grid layout.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bastrop-texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lake Bastrop, a 906‑acre reservoir on Spicer Creek, was created in 1964 and now offers boating and fishing just north of town.",
