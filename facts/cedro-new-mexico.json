  "facts": [
    {
      "id": 1,
      "text": "Cedro’s roots trace back to the late 19th century when families such as the Griegos settled under the Carnué Land Grant, farming and herding in the East Mountains.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedro_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s heart lies in Cedro Canyon, at the northern edge of the Manzano Mountains, southeast of Albuquerque.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedro%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "At 7,247 feet, Cedro enjoys a semi‑arid climate with cold winters, mild summers, about 18 inches of rain—mostly summer monsoons—and roughly 44 inches of snow each winter.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedro_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cedro Creek begins in the Manzano Mountains, winds northwest through the canyon, and joins Tijeras Arroyo.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedro_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before Europeans arrived, the Cedro Creek watershed served as a travel corridor for Anasazi peoples, marked by pictographs and petroglyphs.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cedro_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Dense ponderosa pine and scrub oak fuels make Cedro vulnerable to wildfires that spread uphill, prompting conservation in the nearby Cibola National Forest to restore natural fire regimes.",
      "sourceSentenceIds": [
        18,
