    },
    {
      "id": 2,
      "text": "William Stephen Hamilton, the son of Alexander Hamilton, founded a lead ore mine here known as Hamilton's Diggings.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiota%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Fort Hamilton was erected at the site of Hamilton's Diggings during the Black Hawk War of 1832.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiota%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Wiota was one of the earliest Norwegian settlements in the United States, established by immigrants from Chicago in 1841.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiota%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The East Wiota Lutheran Church, dedicated in 1852, is the oldest continually running Norwegian Lutheran church in America.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wiota%2C_Wisconsin"
    },
    {
