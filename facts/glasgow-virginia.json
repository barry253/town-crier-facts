  "facts": [
    {
      "id": 1,
      "text": "Glasgow was named for Joseph Glasgow, son of Arthur, in 1768 when settlers arrived.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glasgow%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1848 Charles Hess Locher founded the James River Cement Works at Balcony Falls.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://glasgowvirginia.org/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Locher also founded Locher Clay Products Company, producing brick from an abandoned factory.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://glasgowvirginia.org/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1881 two railroads converged in Glasgow, making it a transportation hub.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://glasgowvirginia.org/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Balcony Falls Dam was removed in 1973 due to flooding concerns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/223-0003/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Glasgow sits at the confluence of the James and Maury Rivers, about six miles east of Natural Bridge.",
