      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Orson Hyde renamed Mormon Station to Genoa in 1855, after the Italian city, pronounced \"juh-NO-ah\".",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Web source 2"
