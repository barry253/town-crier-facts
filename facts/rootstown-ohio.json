  "facts": [
    {
      "id": 1,
      "text": "Rootstown takes its name from Ephraim Root, a Connecticut lawyer who helped found the Connecticut Land Company.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Rootstown_Township%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The township officially formed in 1810 after separating from Franklin Township, marking its first civil organization.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rootstown_Township%2C_Ohio"
    },
    {
      "id": 3,
      "text": "In 1866 the Central and Pacific Railroad cut through Rootstown, connecting the area to broader trade routes.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rootstown_Township%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Peter of the Fields Catholic Church opened in 1868, adding a new spiritual home to the growing community.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rootstown_Township%2C_Ohio"
    },
    {
      "id": 5,
      "text": "Electricity reached Rootstown in 1921, and street lights illuminated the town by 1949.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rootstown_Township%2C_Ohio"
    },
    {
