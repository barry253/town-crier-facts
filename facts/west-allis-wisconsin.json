  "facts": [
    {
      "id": 1,
      "text": "West Allis takes its name from the Allis Company, a major Milwaukee-area manufacturer that later became Allis‑Chalmers.",
      "sourceSentenceIds": [
        17,
        18,
        19,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Allis%2C_Wisconsin",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 1902 Allis‑Chalmers plant built west of the original factory turned the area into the Village of West Allis in 1906.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Allis%2C_Wisconsin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Chicago and North Western Railway reached the area in 1880, calling its station North Greenfield, and the name changed to West Allis in 1887.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Allis%2C_Wisconsin",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The West Allis Historical Society Museum preserves the town’s past and opens Tuesdays from 7‑9 p.m.",
      "sourceSentenceIds": [
        1,
        4,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westallishistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic Log Cabin Schoolhouse in West Allis lets visitors experience what a school day was like in the 1800s.",
