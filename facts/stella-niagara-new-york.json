  "facts": [
    {
      "id": 1,
      "text": "Stella Niagara is a hamlet along the Niagara River, 7.3 miles north of Niagara Falls.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stella_Niagara%2C_New_York",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Sisters of St. Francis of Penance and Christian Charity founded the community in 1835, bringing education and faith to the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stella-niagara.com/stella-advantage/stella-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Stella Niagara Preserve spans 29 acres with over a quarter-mile of shoreline, the largest undeveloped stretch along the entire Niagara River.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wnylc.org/stella-niagara-preserve",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Preserve is a nationally designated Peace Site and part of the Niagara County Historic Trail, highlighting its ecological and historical importance.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wnylc.org/stella-niagara-preserve",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stella Niagara Education Park, a Montessori‑to‑8th‑grade school, opened in 1971 after the Sisters obtained a charter from the New York State Board of Regents.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://stella-niagara.com/stella-advantage/stella-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original March Estate, purchased by the Sisters in 1907, became the first Motherhouse on the banks of the Niagara River.",
