    },
    {
      "id": 2,
      "text": "Founded in 1903, the town was originally platted as North and South Latham on opposite sides of the Washita River.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
