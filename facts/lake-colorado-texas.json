  "facts": [
    {
      "id": 1,
      "text": "Lake Colorado City is an artificial lake on Morgan Creek, located four miles southwest of Colorado City in central Mitchell County.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 2,
      "text": "Construction of the lake began in 1948 and was completed in September 1949 by general contractor Harry Campbell.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 3,
      "text": "When the lake’s water level drops, water is pumped from Champion Creek Reservoir to keep the lake at a satisfactory level.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lake-colorado-city"
    },
    {
      "id": 4,
      "text": "Lake Colorado City covers 1,618 acres, making it a sizable impoundment of Morgan Creek.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tpwd.texas.gov/state-parks/lake-colorado-city"
    },
    {
      "id": 5,
      "text": "Anglers at the lake mainly target largemouth bass, channel catfish, and sunfish.",
      "sourceSentenceIds": [
