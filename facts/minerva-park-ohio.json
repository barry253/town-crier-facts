  "facts": [
    {
      "id": 1,
      "text": "Minerva Park began as a trolley park, opening its amusement rides on July 13, 1895.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minerva_Park%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The park’s name honors Minerva Shipherd, wife of railway president John Shipherd.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wosu.org/news/2019-09-02/curious-cbus-how-minerva-park-went-from-failed-amusement-to-quaint-neighborhood"
    },
    {
      "id": 3,
      "text": "Visitors once rode a roller coaster, toured a small zoo, and swam in a lake before the park closed in 1902.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minerva_Park%2C_Ohio"
    },
    {
      "id": 4,
      "text": "After the park shut down, the empty grounds became a graveyard for discarded streetcars.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minerva_Park%2C_Ohio"
    },
    {
      "id": 5,
      "text": "The area stayed vacant until 1927, when developers began building the residential subdivision that would become the village.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minerva_Park%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Minerva Park officially incorporated as a village in 1940, solidifying its status within Franklin County.",
      "sourceSentenceIds": [
        20
