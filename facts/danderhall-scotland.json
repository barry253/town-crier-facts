  "facts": [
    {
      "id": 1,
      "text": "Danderhall grew from a 19th‑century mining village during the Midlothian coalfield boom.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-kingdom/scotland_danderhall"
    },
    {
      "id": 2,
      "text": "The local colliery opened in 1898 and shut in 1966, marking the end of an era.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danderhall"
    },
    {
      "id": 3,
      "text": "The village name comes from Scots “Dander’s Ha”, meaning wanderer’s hall, hinting at a historic traveler’s stop.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-kingdom/scotland_danderhall"
    },
    {
      "id": 4,
      "text": "Danderhall’s community hub, opened in 2021, replaced the old library, school and community centre, keeping the village’s social heart alive.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scottish-places.info/towns/townfirst1570.html"
    },
    {
      "id": 5,
      "text": "Woolmet Hill, just east of Danderhall, was the backdrop of the 1594 Raid of Leith, where Bothwell’s forces surprised King James VI’s troops.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danderhall"
    },
    {
      "id": 6,
      "text": "Danderhall sits on the A7 within the Edinburgh City Bypass, yet its council housing now largely belongs to private owners, reflecting post‑industrial change.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
