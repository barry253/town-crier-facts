  "facts": [
    {
      "id": 1,
      "text": "Red Feather Lakes grew from a ranching and timber settlement into a recreational village after 1925 when the YMCA built a camp.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Feather_Lakes%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village hosts 12 named lakes, including Parvin, Dowdy, and the eponymous Red Feather Lake, all cataloged by the Red Feather Historical Society.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Feather_Lakes%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1923 the Red Feather Mountain Lakes Association incorporated, sparking the first organized recreational development of the area.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitredfeatherlakes.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early trails that became roads were hauled by tie hacks who transported railroad ties to Tie Siding, Wyoming for the transcontinental railroad.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Feather_Lakes%2C_Colorado",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic cabin museum operated by the Red Feather Historical Society preserves detailed local history and is open to visitors.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Feather_Lakes%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Cache La Poudre–North Park Scenic Byway winds through the village, offering a drive that showcases the surrounding Roosevelt National Forest.",
