  "facts": [
    {
      "id": 1,
      "text": "Ravenswood began in 1868 when the Ravenswood Land Company bought 194 acres of farmland.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ravenswoodchicago.org/neighborhood/ravenswood-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1888 local pharmacist Wallace Calvin Abbott founded Abbott Laboratories in Ravenswood, a company that still bears his name.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://ravenswoodchicago.org/neighborhood/ravenswood-history/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Deagan building, a brick landmark, stands as a symbol of Ravenswood’s manufacturing past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ravenswoodchicago.org/neighborhood/ravenswood-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Northwestern Elevated Railroad, now the CTA Brown Line, opened in the early 1900s and reshaped Ravenswood’s growth.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://searchandhelp.com/exploring-ravenswood-history-a-guide-to-the-chicago-area/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ravenswood’s streets are famous for their mature trees and well‑preserved architecture spanning several decades.",
      "sourceSentenceIds": [
        4,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://searchandhelp.com/exploring-ravenswood-history-a-guide-to-the-chicago-area/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ravenswood Elementary School, founded in 1873 as Sulzer Street School, serves the neighborhood to this day.",
