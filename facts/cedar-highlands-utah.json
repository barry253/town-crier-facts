  "facts": [
    {
      "id": 1,
      "text": "Cedar Highlands began in 1981 as a private development consisting of cabins managed by a homeowners association.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Highlands%2C_Utah"
    },
    {
      "id": 2,
      "text": "Cedar Highlands is a subdivision located east of Cedar City in Iron County, Utah.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Highlands%2C_Utah"
    },
    {
      "id": 3,
      "text": "Cedar Highlands was the first town incorporated after the state changed the process to be overseen by the Lieutenant Governor.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Highlands%2C_Utah"
    },
    {
      "id": 4,
      "text": "Because the community had no government buildings, the foundational swearing in of leaders took place at Southern Utah University.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Highlands%2C_Utah"
    },
    {
      "id": 5,
      "text": "Residents of Cedar Highlands voted to disband the town and revert to unincorporated status in May 2020.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Highlands%2C_Utah"
    },
    {
      "id": 6,
      "text": "The State of Utah issued a formal Certificate of Dissolution for Cedar Highlands on October 10, 2020.",
      "sourceSentenceIds": [
        20
