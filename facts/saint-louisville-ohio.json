  "facts": [
    {
      "id": 1,
      "text": "Saint Louisville was originally called Lewisville, named after Lautzenheiser's son Lewis, before changing its spelling to avoid confusion with another Ohio town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Pittsburgh, Fort Wayne and Chicago Railway reached Saint Louisville in 1852, sparking a boom that outpaced nearby Harrisburg.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Saint Louisville’s historic downtown district stretches roughly from Chapel Street to Center Court, featuring landmarks like Saint Louis Catholic Church built in 1870.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s first public street lights—twelve oil burners—illuminated downtown for Christmas 1884, marking a milestone in local modernization.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A public water system was installed in 1894, followed by a sewage system in 1910, laying the groundwork for Saint Louisville’s modern infrastructure.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Ohio",
      "category": "history",
      "quality": "good"
    }
