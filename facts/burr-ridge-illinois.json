      ],
      "source": "https://ippl.info/learn-research/local-history?view=article&id=1866&catid=86",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Flag Creek, a tributary of the Des Plaines River, meanders through Burr Ridge, adding a natural waterway to the village’s landscape.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
