  "facts": [
    {
      "id": 1,
      "text": "Egypt, Texas was founded in 1822 as Mercer’s Crossing, a ferry crossing on the Colorado River.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/egypt-texas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During a severe drought, the settlement supplied corn to neighboring towns and was renamed Egypt, a biblical reference to abundance.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/egypt-texas-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town once boasted a 2,222‑acre Egypt Plantation that grew cotton and sugarcane, making it a regional agricultural hub.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/egypt-texas-ghost-town/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Egypt’s growth stalled when the Cane Belt Railroad bypassed it in 1901, leaving the town isolated and eventually abandoned.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/egypt-tx-wharton-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, the historic cemetery with unique bell‑shaped markers stands as the most striking reminder of the once‑thriving community.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/egypt-texas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The ruins of the old Egypt Plantation and scattered building foundations still mark where the bustling pioneer town once stood.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/egypt-texas-ghost-town/",
      "category": "landmark",
      "quality": "good"
    }
