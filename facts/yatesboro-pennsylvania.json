  "facts": [
    {
      "id": 1,
      "text": "Yatesboro was founded in March 1899 as a planned company town by the Rochester & Pittsburgh Coal & Iron Company, built on former farmland.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/yatesboro_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew to over 250 company‑owned houses, a store, a hotel, a school, and churches, drawing immigrants from Italy, Scotland, Sweden, Poland, and Czechoslovakia.",
      "sourceSentenceIds": [
        4,
        23,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yatesboro_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad station on the Rural Valley line connected Yatesboro to the regional mining network, enabling shipment of over 825,000 tons of coal annually by 1913.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yatesboro_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mary, Mother of God Catholic Church, founded in 1904 on land donated by the coal company, became a cultural hub and produced several ordained priests.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/yatesboro_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1947, Yatesboro was one of seventeen company towns sold by the Rochester & Pittsburgh Coal & Iron Company as part of a larger divestiture.",
      "sourceSentenceIds": [
        17
      ],
