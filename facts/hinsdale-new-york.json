  "facts": [
    {
      "id": 1,
      "text": "Hinsdale was named after Hinsdale, New Hampshire, the birthplace of the town’s founder’s mother.",
      "sourceSentenceIds": [
        1,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hinsdale%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits at the junction of Oil and Ischua Creeks and once hosted the Erie Railroad, Buffalo‑NY‑Philadelphia Railroad, and Genesee Valley Canal.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicpath.com/history/hinsdale",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1825 a post office opened, and by the 1870s the village boasted two churches, two hotels, five general stores, and a cheese factory.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicpath.com/history/hinsdale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The hamlet of Scott’s Corners, just north of the village, once housed a saw mill dating to 1814 and a school founded in 1818.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://historicpath.com/history/hinsdale",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Southern Tier Expressway (I‑86/NY 17) cuts across Hinsdale, while NY 16 runs parallel, giving the town a historic transport corridor.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
