      "id": 1,
      "text": "Blackfalds got its name in 1903 when Walter Waghorn’s post office name was changed to honor a Scottish hamlet called Blackfalds.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
