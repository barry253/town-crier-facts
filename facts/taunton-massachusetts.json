  "facts": [
    {
      "id": 1,
      "text": "Founded in 1637 by Plymouth Colony members, Taunton is one of the oldest towns in the U.S.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Taunton%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned the nickname 'Silver City' after 19th‑century silversmiths like Reed & Barton produced medals for the 1996 Olympics and silverware for the White House.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taunton%2C_Massachusetts",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Taunton’s historic downtown features Church Green, where the First Parish Church—now a Unitarian Universalist church—was founded in 1637, before the town itself.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taunton%2C_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1880s Russian Jewish immigrants settled here, leading to the founding of Congregation Agudath Achim in 1911.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taunton%2C_Massachusetts",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Mason Machine Works, established by William Mason, built textile machinery and steam locomotives, making Taunton a key industrial hub in the 1800s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taunton%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Taunton’s railroad arrival turned it into a transportation hub, a role it still plays due to its central location in southeastern Massachusetts.",
      "sourceSentenceIds": [
