      "id": 1,
      "text": "Naponee takes its name from Napanee, Ontario, the hometown of a Canadian Civil War veteran who bought land along the Republican River.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naponee%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Burlington Railroad reached Naponee in 1879, bringing the first rail service to the village.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naponee%2C_Nebraska",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Naponee’s first post office opened in 1871, establishing the town’s early communication link.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naponee%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village officially incorporated on November 30, 1909, formalizing its local government.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naponee%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Great Depression, Naponee endured severe dust storms and a 1935 Republican River flood that devastated the area.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naponee%2C_Nebraska",
      "category": "history",
      "quality": "good"
