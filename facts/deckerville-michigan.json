  "facts": [
    {
      "id": 1,
      "text": "Deckerville was named after Charles Decker, a local settler who started a lumber business in 1870.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Deckerville%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village became a station on the Pere Marquette Railroad, helping it grow.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://deckerville.us/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early industries included lumbering, fur trading, woolen and flax mills, brick making, a sauerkraut factory, and once cheese making thrived.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://deckerville.us/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Charles Decker’s son, Martin, served as the first postmaster when the village was founded in 1870.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://deckerville.us/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Deckerville was platted in 1870 and officially incorporated as a village in 1893.",
      "sourceSentenceIds": [
        7,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Deckerville%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Forest fires in 1871 and 1881 cleared the Thumb area, turning it into a productive farming region that benefited Deckerville.",
