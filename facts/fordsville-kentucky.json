      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fordsville_kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "National Office Furniture, a Kimball International unit, and Dunaway Timber Company are Fordsville’s primary employers.",
