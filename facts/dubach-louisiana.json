      ],
      "source": "https://www.achp.gov/preserve-america/community/dubach-louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic home, built by the lumber company founder, still stands and is on the National Register of Historic Places.",
