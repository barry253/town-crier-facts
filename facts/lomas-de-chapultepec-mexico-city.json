  "facts": [
    {
      "id": 1,
      "text": "Lomas de Chapultepec began in the 1920s as Chapultepec Heights, when developers bought 687 hectares for roughly one cent per square meter.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lomas_de_Chapultepec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1922, architect José Luis Cuevas Pietrasanta planned the neighborhood in a Garden City style, featuring winding streets and gardened boulevards.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lomas_de_Chapultepec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The name changed to Lomas de Chapultepec in 1924 after authorities banned foreign words in advertising.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lomas_de_Chapultepec",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area now hosts some of Mexico City's largest mansions, many built during the Mexican Miracle and still standing.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lomas_de_Chapultepec",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early settlers were young professionals and the new business class fleeing the Revolution, creating an upper‑class enclave.",
      "sourceSentenceIds": [
        22,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lomas_de_Chapultepec",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today the colonia borders commercial zones and houses several embassies, reflecting its modern affluent character.",
