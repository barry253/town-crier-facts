  "facts": [
    {
      "id": 1,
      "text": "Revloc was founded in 1917 as a coal patch town to house workers of the nearby mine.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Revloc%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Revloc mine began producing coal in 1918 and was linked to the Cambria & Indiana Railroad, shipping coal to wider markets.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/revloc_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Revloc’s 83‑acre historic district, with 225 resources, was listed on the National Register of Historic Places in 1995 for its industrial history and vernacular architecture.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/revloc_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s name is a reverse spelling of neighboring Colver, reflecting local naming quirks.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Revloc%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Acid mine drainage from abandoned operations has historically polluted nearby South Branch Blacklick Creek, producing discharges up to 100 times more acidic than typical.",
