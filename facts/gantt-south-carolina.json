  "facts": [
    {
      "id": 1,
      "text": "Gantt was named after James Gantt, a prominent local businessman and landowner who helped develop the area during the early 1900s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/south-carolina_gantt"
    },
    {
      "id": 2,
      "text": "Gantt was established in the early 20th century as a mill village for the Poinsett Lumber and Manufacturing Company.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/south-carolina_gantt"
    },
    {
      "id": 3,
      "text": "The Poinsett Lumber and Manufacturing Company once operated one of the largest hardwood mills in the world right here in Gantt.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/south-carolina_gantt"
    },
    {
      "id": 4,
      "text": "Gantt's economy was historically driven by the textile and lumber industries, with the Poinsett Mill employing generations of local residents.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/south-carolina_gantt"
    },
    {
      "id": 5,
      "text": "Gantt is located in west-central Greenville County and serves as a suburb of the city of Greenville.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gantt%2C_South_Carolina"
    },
    {
      "id": 6,
      "text": "Gantt is bordered to the northeast by the city of Greenville and to the northwest by unincorporated Dunean.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gantt%2C_South_Carolina"
