      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Villages%2C_Florida",
      "category": "economy",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "A 1968 federal law banning mail‑order real‑estate sales forced Schwartz and partner Al Tarrson to stop the practice.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Villages%2C_Florida",
      "category": "history",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "By the early 1990s the Villages boasted more than 8,000 residents, three golf courses, and a Winn‑Dixie supermarket.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Villages%2C_Florida",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fictitious historical markers and architectural details are used to create a nostalgic atmosphere for residents.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/The_Villages%2C_Florida",
      "category": "culture",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
