    {
      "id": 1,
      "text": "Sheridan began as Petersburg in 1873 when Peter Magnus platted the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.sheridan.co.us/147/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887 Isaac McBroom laid out Sheridan Junction, later merged with Petersburg.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.sheridan.co.us/147/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town officially incorporated in 1890, combining Petersburg and Sheridan Junction into Sheridan.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.sheridan.co.us/147/History",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sheridan sits on the historic Santa Fe Trail, once a key route south of Denver.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ci.sheridan.co.us/147/History",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s name honors General Philip Sheridan, who established Fort Logan nearby.",
