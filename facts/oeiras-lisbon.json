  "facts": [
    {
      "id": 1,
      "text": "Oeiras was founded in 1759 by the Marquis of Pombal, a reward from King Joseph I for rebuilding Lisbon after the 1755 earthquake.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oeiras%2C_Portugal"
    },
    {
      "id": 2,
      "text": "The Barcarena Gunpowder Factory, now a cultural site, once supplied arms that helped expand Portugal’s eastern territories.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oeiras%2C_Portugal"
    },
    {
      "id": 3,
      "text": "In 1770, Oeiras hosted Portugal’s first agricultural and industrial fair, sparking new customs houses and factories.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oeiras%2C_Portugal"
    },
    {
      "id": 4,
      "text": "The Museu da Pólvora Negra inside the old Gunpowder Factory preserves the history of Portugal’s explosive industry.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitportugal.com/en/NR/exeres/DCB924F5-1135-4BC6-A154-D73016F411B4"
    },
    {
      "id": 5,
      "text": "Chipidea, Portugal’s first semiconductor company founded in 1997 in Oeiras, was acquired by MIPS Technologies in 2007.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Oeiras%2C_Portugal"
    },
    {
      "id": 6,
      "text": "Oeiras boasts gardens like the Poets' Park, the Palace of the Marquis of Pombal, and the Royal Estate of Caxias, blending beauty with innovation.",
      "sourceSentenceIds": [
        5
      ],
