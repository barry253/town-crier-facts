      ],
      "source": "https://www.edgewaterco.gov/living-here/welcome-to-edgewater/edgewater-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1954 move of radio station KFEL to Edgewater turned it into KIMN, broadcasting from town for three decades.",
      "sourceSentenceIds": [
