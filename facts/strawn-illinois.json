  "facts": [
    {
      "id": 1,
      "text": "Strawn was laid out on June 6, 1873, by David Strawn, a wealthy landowner who had moved from Ohio.",
      "sourceSentenceIds": [
        13,
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawn%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was platted the same year the Chicago & Paducah Railroad—now part of the Wabash system—ran through the area.",
      "sourceSentenceIds": [
        7,
        6,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://genealogytrails.com/ill/livingston/community_strawn_history.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Strawn’s original design featured a public square, a rarity for Illinois towns built in the 1870s.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawn%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "To attract settlers, every alternate lot was offered free, provided the house met size standards and was finished quickly.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Strawn%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first post office opened in 1873, and the first shipment into town was a barrel of meat for a boarding house.",
