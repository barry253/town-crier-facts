  "facts": [
    {
      "id": 1,
      "text": "Cambria’s name, chosen in 1869, comes from the Latin word for Wales, reflecting the influence of a Welsh shopkeeper who named his storefront “Cambria.”.",
      "sourceSentenceIds": [
        3,
        25,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambria%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cambria’s historic East Village houses the Cambria Historical Museum, which opened in the former Guthrie‑Bianchini House, one of the town’s oldest homes.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cambria%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Piedras Blancas Lighthouse, built in 1872, still displays a first‑order Fresnel lens crafted in France and now loaned to the Cambria Lions Club.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcambriaca.com/history-of-cambria/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Local cuisine is famous for olallieberry pie, a specialty that draws diners to Linn’s Restaurant, while Robin’s Restaurant has served eclectic global dishes in a historic adobe for over three decades.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/cambria/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Chumash people once called the area tsɨtkawayu, meaning “place of the horses,” highlighting the region’s ancient indigenous heritage.",
