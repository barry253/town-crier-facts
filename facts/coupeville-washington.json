  "facts": [
    {
      "id": 1,
      "text": "Coupeville was laid out in the 1850s by Captain Thomas Coupe, after whom the town is named.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coupeville%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Penn Cove, where the historic Coupeville Wharf stretches along the waterfront and hosts Washington’s longest‑running farmers market.",
      "sourceSentenceIds": [
        13,
        15,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ebeysreserve.com/downtown-coupeville",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A self‑guided walking tour maps 65 historic sites, including the Island County Historical Museum that chronicles Indigenous peoples and early settlers.",
      "sourceSentenceIds": [
        5,
        3,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ebeysreserve.com/downtown-coupeville",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ebey’s Landing National Historical Reserve, established in 1978, protects the first and only National Historical Reserve in the nation and surrounds Coupeville.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ebeysreserve.com/downtown-coupeville",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1911, Lovejoy expanded ferry service from Coupeville, founding the Island Transportation Company that operated steamers to Port Townsend.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://townofcoupeville.org/town-in/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Coupeville’s climate is drier than much of western Washington, lying in the rain shadow of the Olympic Mountains.",
      "sourceSentenceIds": [
        9
