  "facts": [
    {
      "id": 1,
      "text": "Markham was named for Charles H. Markham, a 19th‑century Illinois Central Railroad president who helped shape the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Markham%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1860, German immigrant Lawrence Roesner settled on the northwestern corner of Markham, bringing six pine seedlings from the Black Forest.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.cityofmarkham.net/183/History",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The lone survivor of those six pines became the city’s symbol, and a replacement tree was planted in 1986 after the original died.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Markham%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Markham’s prairie lands earned National Natural Landmark status in 1988, preserving four distinct prairie preserves within the city limits.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Markham%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early pioneers crossed Markham’s prairie at the southern tip of Lake Michigan, making it a historic crossroads for settlers moving westward.",
      "sourceSentenceIds": [
        14
      ],
