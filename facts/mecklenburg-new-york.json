  "facts": [
    {
      "id": 1,
      "text": "Mecklenburg, New York, takes its name from the town of Hector, itself named after a Greek myth character.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hector%2C_New_York"
    },
    {
      "id": 2,
      "text": "The area first saw settlers around 1790, with the first permanent resident arriving in 1791.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hector%2C_New_York"
    },
    {
      "id": 3,
      "text": "Hector split from Cayuga County in 1802, later joined Seneca, Tompkins, and finally settled in Schuyler County by 1854.",
      "sourceSentenceIds": [
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hector%2C_New_York"
    },
    {
      "id": 4,
      "text": "Both the First Presbyterian Church of Hector and the Logan Methodist Church earned spots on the National Register of Historic Places in 2001.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hector%2C_New_York"
    },
    {
      "id": 5,
      "text": "Mecklenburg borders Tompkins to the east, Seneca to the north, and Yates to the west, with Seneca Lake marking its western edge.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hector%2C_New_York"
    },
    {
      "id": 6,
      "text": "New York State Routes 227 and 228 cross at Perry City, the town’s northeastern hub.",
