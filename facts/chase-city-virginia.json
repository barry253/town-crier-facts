  "facts": [
    {
      "id": 1,
      "text": "Chase City was incorporated in 1873 and named for Salmon P. Chase, former U.S. Treasury Secretary.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chase_City%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Atlantic, Richmond, and Danville Railroad reached Chase City in 1883, turning it into a transportation hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://maccallummore.org/pages/discover-chase-citys-historic-landmarks",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "MacCallum More Gardens, once a historic plantation, now hosts gardens and a museum that showcases local heritage.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://visitmeckva.com/towns/chase-city/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Chase City’s historic downtown along Main Street features buildings that date back to the 1830s, offering a 19th‑century architectural glimpse.",
      "sourceSentenceIds": [
        7,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://maccallummore.org/pages/discover-chase-citys-historic-landmarks",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Thyne Memorial Institute preserves the history of African American education in Mecklenburg County, a key chapter in the region’s past.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitmeckva.com/towns/chase-city/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Chase City High School, MacCallum More, and Hudgins House Historic District, and Shadow Lawn are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
