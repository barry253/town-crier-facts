  "facts": [
    {
      "id": 1,
      "text": "Napier Field began as an Army Air Forces Training Center at the start of WWII.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://napierfield.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The airfield was named after Edward Napier, Alabama's first aviator killed in service in 1923.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/napier-field/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the war, the field was deactivated in 1945 and turned over to Dothan and Houston County, which sold its share to the city.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/napier-field/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The former air base stayed dormant until the early 1960s when private investors upgraded it with jet runways and new buildings.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/napier-field/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Napier Field incorporated as a town in September 1968, evolving from the former air base into a civilian community.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/napier-field/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A branch of Wallace Community College now serves the town, reflecting its educational development.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/napier-field/",
