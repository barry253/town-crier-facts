  "facts": [
    {
      "id": 1,
      "text": "Point Pleasant sits on both sides of Tohickon Creek where it meets the Delaware River, the creek marking the township boundary.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Pleasant%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "Long before settlers, the Lenape Indians fished the Delaware River near Point Pleasant, making it a vital food source.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Pleasant%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "During the canal era, Point Pleasant was a resting spot for canalmen on the Delaware Division and a stop for the Doylestown‑Frenchtown‑New York stage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Pleasant%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Since 1989, a major water pump at Point Pleasant draws Delaware River water to feed the Bradshaw and Lake Galena reservoirs.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Pleasant%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Point Pleasant Historic District, along with three covered bridges, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Point_Pleasant%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Pennsylvania Route 32 runs through Point Pleasant, linking the community directly to New Hope to the south.",
      "sourceSentenceIds": [
        16
