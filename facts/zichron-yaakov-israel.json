  "facts": [
    {
      "id": 1,
      "text": "Zichron Yaakov was founded in 1882 by 100 Romanian pioneers of the Hibbat Zion movement, who bought two plots 5 km apart.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zikhron_Ya'akov"
    },
    {
      "id": 2,
      "text": "The town was renamed in honor of Baron Edmond James de Rothschild’s father, James Mayer de Rothschild, whose Hebrew name is Ya'akov.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zikhron_Ya'akov"
    },
    {
      "id": 3,
      "text": "In 1885 Rothschild helped establish Israel’s first winery, Carmel Winery, in Zichron Yaakov, along with a bottling factory.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zikhron_Ya'akov"
    },
    {
      "id": 4,
      "text": "The town’s main street, Derekh HaYayin, is called “Path of the Wine” and hosts coffeehouses and boutique shops selling local crafts.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zikhron_Ya'akov"
    },
    {
      "id": 5,
      "text": "The Ohel Ya'akov Synagogue, commissioned by the Baron, opened in 1886 and still holds daily services.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zikhron_Ya'akov"
    },
    {
      "id": 6,
      "text": "The memorial gardens, founded in memory of Baron Edmond de Rothschild, are the most visited part of the town’s park.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://your-friends-in-israel.com/destination/zichron-yaakov/"
    }
  ]
}
