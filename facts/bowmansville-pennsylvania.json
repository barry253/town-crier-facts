  "facts": [
    {
      "id": 1,
      "text": "Bowmansville takes its name from early settler Samuel Bowman.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowmansville%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Bowmansville Roller Mill, built in 1846, now operates as a living museum and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11,
        12,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unchartedlancaster.com/2026/03/19/bowmansville-roller-mill-a-living-monument-to-lancasters-milling-heritage/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A waterwheel powered by Muddy Creek turns the mill’s machinery, echoing the rhythm of the creek that drains the town.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bowmansville%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Inventor Oliver Evans helped make Bowmansville a 19th‑century milling hub, earning the town a reputation for state‑of‑the‑art technology.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unchartedlancaster.com/2026/03/19/bowmansville-roller-mill-a-living-monument-to-lancasters-milling-heritage/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Pennsylvania Route 625, locally called Reading Road, slices through Bowmansville’s center, linking it 12 miles north to Reading and 7 miles south to East Earl.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
