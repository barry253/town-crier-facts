  "facts": [
    {
      "id": 1,
      "text": "Quincy was founded in 1853 when the New Albany Railroad crossed Brush Creek, prompting workers to build homes nearby.",
      "sourceSentenceIds": [
        7,
        8,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quincy%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name was Quincy, but a post office conflict forced the Owen County settlement to keep the name while a nearby Jay County town was renamed Dunkirk.",
      "sourceSentenceIds": [
        1,
        2,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quincy%2C_Indiana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "A historic picnic began in 1870, drawing 200 people, and continued annually until 1972, becoming one of Indiana’s largest community events.",
      "sourceSentenceIds": [
        28,
        30,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quincy%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1873 fire started accidentally on November 3, destroying several key stores and lodges, yet the town rebuilt and continued thriving.",
      "sourceSentenceIds": [
        21,
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quincy%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Quincy sits just south of County Road 1150N, north of Spencer, the county seat of Owen County.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Quincy%2C_Indiana",
