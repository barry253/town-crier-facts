  "facts": [
    {
      "id": 1,
      "text": "Gwanaksan Mountain dominates the skyline of Gwanak-gu, rising to 1,030 meters and offering panoramic views of Seoul.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gwanak_District",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Gwanak-gu houses Seoul National University, Korea’s oldest and most prestigious university, whose campus buzzes with youthful energy.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.realk.kr/destination/seoul/gwanak-gu/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nakseongdae Park sits atop Gwanak Mountain and hosts the annual Nakseongdae Indeungje memorial ceremony honoring the famed Joseon scholar.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.realk.kr/destination/seoul/gwanak-gu/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Gwanaksan Ecological Park provides a green escape where hikers can explore trails that weave through ancient pine forests and limestone cliffs.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.realk.kr/destination/seoul/gwanak-gu/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The former Belgian Consulate Office in Gwanak-gu now serves as a cultural venue, preserving early 20th‑century architecture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.realk.kr/destination/seoul/gwanak-gu/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Gwanak Road (Gwanak-ro) and Sillim Road form the main artery for commuters, linking the district to Seoul’s central business district.",
