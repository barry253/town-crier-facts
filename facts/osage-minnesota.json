  "facts": [
    {
      "id": 1,
      "text": "Back in the late 1800s, a single Carsonville township split, with the eastern half renamed Osage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.osagetownshipmn.org/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Osage Township was officially established in May 1891, marking its formal recognition.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.osagetownshipmn.org/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first special meeting to organize the Town of Osage set the stage for local governance.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.osagetownshipmn.org/about-us",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "In its early days, Osage boasted churches, a creamery, hardware store, post office, grocery, hotel, lumber yard, and a manufacturing company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.osagetownshipmn.org/communityhistory",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Straight and Shell Rivers meander southeastward through Osage, shaping its landscape and waterways.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.osagetownshipmn.org/about-us",
      "category": "nature",
      "quality": "good"
    },
    {
