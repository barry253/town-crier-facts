  "facts": [
    {
      "id": 1,
      "text": "Morrisania takes its name from the 2,000‑acre Morris family manor that once covered most of the Bronx.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morrisania%2C_Bronx"
    },
    {
      "id": 2,
      "text": "The New York and Harlem Railroad crossed the area in 1841, opening the Bronx to Manhattan commuters.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/morrisania"
    },
    {
      "id": 3,
      "text": "When the subway reached Morrisania in 1904, tenement buildings replaced single‑family houses, reshaping the neighborhood’s skyline.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morrisania%2C_Bronx"
    },
    {
      "id": 4,
      "text": "Disinvestment, arson, and abandonment peaked in the 1970s, making Morrisania one of the South Bronx’s most devastated areas.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/morrisania"
    },
    {
      "id": 5,
      "text": "Community development corporations like Banana Kelly and Phipps Houses led a 21st‑century effort to rebuild affordable housing in Morrisania.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/morrisania"
    },
    {
      "id": 6,
      "text": "The Carnegie‑funded Morrisania Library opened in 1908 at 610 East 169th Street, serving as a cultural hub for decades.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
