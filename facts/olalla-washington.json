  "facts": [
    {
      "id": 1,
      "text": "Olalla’s name comes from the Chinook Jargon word “olallie,” meaning berries, a nod to the area’s historic berry abundance.",
      "sourceSentenceIds": [
        8,
        12,
        14,
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Olalla,_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 19th and early 20th centuries, Olalla was a bustling Mosquito Fleet port, ferrying goods and people until the 1930s.",
      "sourceSentenceIds": [
        9,
        11,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Olalla,_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Nelson Pioneer Home, built in 1913, now sits on the National Register of Historic Places, showcasing early settler life.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Olalla,_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Beautiful Downtown Olalla exhibit opened May 21 at Olalla Bay Market, inviting visitors to explore the town’s rich history.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.iloveolalla.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Olalla once rivaled Port Orchard in size, once matching the county seat before its growth slowed.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Olalla%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Olalla’s waterfront on Olalla Bay historically linked the community to Puget Sound via steamship services.",
