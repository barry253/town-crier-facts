  "facts": [
    {
      "id": 1,
      "text": "Kawkawlin’s name comes from the Ojibwe word ogaakaaning, meaning \"place of pike,\" a nod to the river’s historic fish abundance.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kawkawlin_Township%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At one point, Kawkawlin housed a dynamite factory whose 1898 explosion remains one of the town’s most dramatic moments.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2026/04/24/history-of-kawkawlin-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Jackson, Lansing & Saginaw Railroad reached Kawkawlin in 1871, shifting the town’s economy from river to rail.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2026/04/24/history-of-kawkawlin-michigan/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kawkawlin began in 1844 when a sawmill sprang up on the riverbank, setting the course for the township’s growth.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2026/04/24/history-of-kawkawlin-michigan/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An early 1900s bridge over the Kawkawlin River became a key link in the region’s transportation network.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thumbwind.com/2026/04/24/history-of-kawkawlin-michigan/",
      "category": "landmark",
      "quality": "good"
    },
    {
