  "facts": [
    {
      "id": 1,
      "text": "Water View sits on the Rappahannock River, just 6.4 miles north‑northwest of Urbanna, where the river’s tides shape the low‑lying landscape.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Water_View%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "Water View’s history dates back to the Rappahannock Indian Tribe, part of the Powhatan Confederacy, who first inhabited the area before European arrival.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/water_view_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1608, Captain John Smith’s expedition first charted the Chesapeake Bay near what is now Water View, where a stingray bite was treated with local herbal remedies.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/water_view_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The surrounding marshes support vital wildlife, serving as nurseries for menhaden and blue crabs and breeding grounds for prothonotary warblers and bald eagles.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/water_view_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A post office operated in Water View until March 8, 2008, marking the end of a long‑standing local institution.",
      "sourceSentenceIds": [
