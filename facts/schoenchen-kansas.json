  "facts": [
    {
      "id": 1,
      "text": "Volga German settlers founded Schoenchen in April 1877 following a dispute over the proposed relocation of nearby Liebenthal.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schoenchen%2C_Kansas"
    },
    {
      "id": 2,
      "text": "Schoenchen was originally named San Antonio before being renamed after one of the villages the settlers left behind in Russia.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schoenchen%2C_Kansas"
    },
    {
      "id": 3,
      "text": "Schoenchen lies on the south bank of the Smoky Hill River in the Smoky Hills region of the Great Plains.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schoenchen%2C_Kansas"
    },
    {
      "id": 4,
      "text": "The community's first stone church was built in 1880 but abandoned after heavy rain caused the foundation to settle badly.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://legendsofkansas.com/schoenchen-kansas/"
    },
    {
      "id": 5,
      "text": "St. Anthony Catholic Church was built in 1901 as a permanent replacement for the town's first church.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schoenchen%2C_Kansas"
    },
    {
      "id": 6,
      "text": "The confluence of the Smoky Hill River and its tributary, Lookout Hollow, sits immediately northwest of Schoenchen.",
      "sourceSentenceIds": [
        4
      ],
