      "id": 1,
      "text": "Fessenden was founded in 1893 when the Minneapolis, St. Paul and Pacific Railway reached the town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fessenden%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors former Surveyor General Fessenden, who mapped the surrounding county.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fessenden%2C_North_Dakota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1894 the county seat moved to Fessenden from Sykeston, prompting construction of the Wells County Courthouse the next year.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fessenden%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fessenden’s historic downtown, once lined with factories, hotels, and churches, is still visible on old Sanborn maps.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-fessenden-north-dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Wells County Fair, held annually in Fessenden, has been a community staple since the town’s founding.",
