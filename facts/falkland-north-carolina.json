  "facts": [
    {
      "id": 1,
      "text": "The town’s name probably comes from a tavern George Faulkner ran in 1779, though the exact origin remains uncertain.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digital.lib.ecu.edu/ncpi/view/22906",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Falkland’s historic district, along with the Spencer Harris House and Dupree‑Moore Farm, earned spots on the National Register of Historic Places.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falkland%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Located west of Greenville, Falkland is part of the Greenville Metropolitan Area and sits within North Carolina’s Inner Banks region.",
      "sourceSentenceIds": [
        7,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Falkland%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The Williams family were the first to settle near what is now Falkland in 1727, laying the town’s early foundation.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://digital.lib.ecu.edu/ncpi/view/22906",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Falkland’s town hall offers phone, email, and in‑person services, with hours posted for residents and visitors alike.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.citydirectory.us/town-falkland.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Although Falkland lacks a passport office, nearby options include East Carolina University International House and several regional post offices.",
