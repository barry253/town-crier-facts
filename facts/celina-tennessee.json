  "facts": [
    {
      "id": 1,
      "text": "Celina was founded in the 19th century and named after Celina Fisk, daughter of pioneer Moses Fisk.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Celina%2C_Tennessee"
    },
    {
      "id": 2,
      "text": "The town originally sat where the Cumberland and Obey Rivers met, but the Obey was dammed to form Dale Hollow Lake, moving Celina downstream.",
      "sourceSentenceIds": [
        6,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.claycotnmuseum.com/historic-downtown"
    },
    {
      "id": 3,
      "text": "Celina is the county seat of Clay County, a county that honors Kentucky statesman Henry Clay.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.claycotnmuseum.com/historic-downtown"
    },
    {
      "id": 4,
      "text": "In the late 1800s, Celina thrived as a logging hub, with timber floated down the Obey River to the town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Celina%2C_Tennessee"
    },
    {
      "id": 5,
      "text": "The historic downtown features a courthouse that has stood since the town’s early days.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitclaycountytn.com/celina-tn/"
    },
    {
      "id": 6,
      "text": "Celina’s elevation places it in a broad valley surrounded by rugged hills of the eastern Highland Rim.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Celina%2C_Tennessee"
