  "facts": [
    {
      "id": 1,
      "text": "Irvington began with William and Elizabeth Irving's 1851 Donation Land Claim, laying the groundwork for the neighborhood.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.irvingtonpdx.com/"
    },
    {
      "id": 2,
      "text": "Streets were laid in 1887, and residential lots began selling in 1891.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.irvingtonpdx.com/"
    },
    {
      "id": 3,
      "text": "Irvington boasts the largest intact collection of Queen Anne, Arts and Crafts, and Colonial Revival homes in Portland and Oregon.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.irvingtonpdx.com/"
    },
    {
      "id": 4,
      "text": "In 2010, Irvington was added to the National Register of Historic Places as the Irvington Historic District.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_Portland%2C_Oregon"
    },
    {
      "id": 5,
      "text": "In December 2014, a committee proposed removing 34 blocks from Irvington's historic district boundaries.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington%2C_Portland%2C_Oregon"
    },
    {
      "id": 6,
      "text": "Since 1966, the Irvington Community Association has hosted a popular Home Tour each spring to showcase historic homes.",
      "sourceSentenceIds": [
        18,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.irvingtonpdx.com/"
