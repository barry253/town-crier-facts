      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During steam era, Dunsmuir had a major Central Pacific yard where extra locomotives were added to help trains climb the grade.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
