  "facts": [
    {
      "id": 1,
      "text": "Dunsmuir earned a spot on Union Pacific’s Train Town USA Registry thanks to its long railroad history, drawing rail fans to see trains and visit the depot museum.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/dunsmuir/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During steam era, Dunsmuir had a major Central Pacific yard where extra locomotives were added to help trains climb the grade.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunsmuir%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic downtown lets visitors step back into the 1920s and 1930s, preserving an authentic look that earned the town a National Register of Historic Places listing.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dunsmuir%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Amtrak’s Coast Starlight stops daily at Dunsmuir’s station, located on one of the town’s two commercial streets in the historic district.",
      "sourceSentenceIds": [
        30
