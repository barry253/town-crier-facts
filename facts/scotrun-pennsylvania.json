    },
    {
      "id": 2,
      "text": "In 1840 Downing and Company founded Scotrun, building a tannery that processed hides from local hemlock and oak bark.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
