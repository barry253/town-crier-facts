  "facts": [
    {
      "id": 1,
      "text": "Tremembé’s name comes from the Tupinambá word meaning “murmuring waters,” a nod to the local rivers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/brazil/sao-paulo_tremembe",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Every year the city celebrates the Festa do Divino Espírito Santo, a festival that blends colonial and Afro‑Brazilian traditions.",
      "sourceSentenceIds": [
        2,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/brazil/sao-paulo_tremembe",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The area is a key producer of citrus fruits and sugarcane, feeding São Paulo’s agrarian economy.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.trawellino.com/destinations/brazil/sao-paulo_tremembe",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Tremembé sits on the edge of the Serra da Cantareira, a mountain range known for its lush forests and waterfalls.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trememb%C3%A9_(district_of_S%C3%A3o_Paulo)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Igreja Matriz de Nossa Senhora da Conceição, built in the 19th century, showcases colonial‑era architecture in the town.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
