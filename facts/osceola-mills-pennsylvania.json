  "facts": [
    {
      "id": 1,
      "text": "Osceola Mills was laid out in 1857 and incorporated as a borough in 1864.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.clearfield.pagenweb.org/individual%20boroughs/ocseola_mills.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the banks of Moshannon Creek, four miles south of Philipsburg and six miles east of Houtzdale.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.clearfield.pagenweb.org/individual%20boroughs/ocseola_mills.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The Tyrone & Clearfield Railroad reached Osceola Mills in 1863, opening for business on Jan 1, 1864, making it a rail junction.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.clearfield.pagenweb.org/individual%20boroughs/ocseola_mills.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A devastating fire on May 20, 1875 nearly destroyed the town, but residents rebuilt into a more beautiful community.",
      "sourceSentenceIds": [
        30,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.clearfield.pagenweb.org/individual%20boroughs/ocseola_mills.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Osceola Mills Community Historical Foundation, founded in 1987, preserves local history and runs a museum at 601 Lingle Street.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lumberheritage.org/resources/historical-societies/osceola-mills-community-historical-society/",
