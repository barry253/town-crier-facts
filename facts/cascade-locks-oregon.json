  "facts": [
    {
      "id": 1,
      "text": "Cascade Locks got its name from a set of locks built to improve navigation past the Cascades Rapids of the Columbia River.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cascade_Locks%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The Oregon Pony, built in 1862 to carry passengers past the rapids, was the first steam engine west of the Mississippi.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cascadelocks.com/history/"
    },
    {
      "id": 3,
      "text": "Cascade Locks is the largest city directly on the Pacific Crest Trail and serves as the trail's lowest point.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cascade_Locks%2C_Oregon"
    },
    {
      "id": 4,
      "text": "The Bridge of the Gods is a toll bridge that connects Cascade Locks to Washington State across the Columbia River.",
      "sourceSentenceIds": [
        8,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cascade_Locks%2C_Oregon"
    },
    {
      "id": 5,
      "text": "Repeated floods carved the deep canyon of the Columbia River Gorge through the Cascade Mountain Range about 14,000 years ago.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cascadelocks.com/history/"
    },
    {
      "id": 6,
      "text": "The original locks in Cascade Locks were completed in 1896 but were later submerged in 1938 by the Bonneville Lock and Dam.",
