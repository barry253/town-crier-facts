  "facts": [
    {
      "id": 1,
      "text": "Kincaid takes its name from a prominent Scotch-Irish family who were among the earliest settlers in Fayette County.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/kincaid_west_virginia"
    },
    {
      "id": 2,
      "text": "James Kincaid and his wife Mary Tritt Kincaid established the community after moving west from Greenbrier County in 1807.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kincaid%2C_West_Virginia"
    },
    {
      "id": 3,
      "text": "The community of Kincaid was officially established in 1878.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kincaid%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "Kincaid historically revolved around coal mining and agriculture, with the local economy later diversifying into services.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/kincaid_west_virginia"
    },
    {
      "id": 5,
      "text": "The Loup Creek Colliery provided electric current to customers in Kincaid and nearby Page by 1918.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kincaid%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "The Norfolk Southern Railway line passes through Kincaid, though it currently has no passenger service or station.",
      "sourceSentenceIds": [
