  "facts": [
    {
      "id": 1,
      "text": "Roslyn got its name from the rose gardens that once bloomed there, after the area was first called Hillside.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roslyn%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 18th‑century Roslyn Grist Mill, once a bustling grain‑grinding hub, now stands as a well‑preserved historic landmark.",
      "sourceSentenceIds": [
        4,
        9,
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://touristplaces.guide/top-10-must-visit-tourist-places-in-roslyn/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Since 1953, the Bryant Library’s Local History Collection has gathered photographs, manuscripts, and artifacts that chronicle Roslyn’s past.",
      "sourceSentenceIds": [
        2,
        3,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://bryantlibrary.org/local-history/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roslyn’s current train station, part of SEPTA’s Warminster Line, replaced the original in the late 1970s and sits at Susquehanna and Easton Roads.",
      "sourceSentenceIds": [
        6,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roslyn%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first rail link to Roslyn arrived in 1872 when the North East Pennsylvania Railroad built a line through the town.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Roslyn%2C_Pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Flower Hill Institute, located in Roslyn, was founded to nurture artistic growth and foster community engagement.",
