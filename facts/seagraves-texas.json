    },
    {
      "id": 2,
      "text": "When the Santa Fe Railroad extended to Lubbock in 1917, Seagraves became a key cattle‑shipping center for the surrounding region.",
      "sourceSentenceIds": [
        9,
        11,
        20
      ],
      "sourceLabels": [
