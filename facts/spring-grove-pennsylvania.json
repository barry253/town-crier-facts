  "facts": [
    {
      "id": 1,
      "text": "Spring Grove was laid out in 1747 on Codorus Creek by a surveyor for the Penns.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Grove%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a natural spring that supplied fresh water to early settlers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://facts.net/world/cities/25-facts-about-spring-grove-pennsylvania/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Iron manufacturing began in the 1770s when a forge called “Spring Forge” was built near the creek.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Grove%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1882 residents petitioned for borough status, and incorporation was granted the same year.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spring_Grove%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Hoke House, built in the 18th century, remains one of the oldest buildings in Spring Grove.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
