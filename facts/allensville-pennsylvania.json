  "facts": [
    {
      "id": 1,
      "text": "Allensville grew thanks to a mix of local industry, transportation links, and community spirit, each shaping its unique character.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kishacoquillasvalleyhistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Kennedy home in Allensville once served as the General Wayne Hotel, a stagecoach stop, tavern, polling place, doctor’s office, post office, and ice cream parlor.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kishacoquillasvalleyhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1991, the Kishacoquillas Valley Historical Society moved into the 1838 Marion Kennedy King house at Main and Water Streets in Allensville.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kishacoquillasvalleyhistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The society collects artifacts reflecting Amish, Mennonite, Scots-Irish, and German heritage that once thrived in Allensville.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kishacoquillasvalleyhistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Visitors can tour the museum and barn during regular hours or by appointment, exploring Allensville’s preserved history.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kishacoquillasvalleyhistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The society invites families, schools, and organizations to schedule tours and learn about Allensville’s rich past.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://kishacoquillasvalleyhistoricalsociety.org/",
