  "facts": [
    {
      "id": 1,
      "text": "Glenfield was incorporated as the borough of Camden on December 4 1875, then renamed Glenfield a month later by court decree.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glenfield_pennsylvania"
    },
    {
      "id": 2,
      "text": "The town’s roots trace back to the 1850s when the Kilbuck Railroad Station served as a bustling hub for river trade.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glenfield_pennsylvania"
    },
    {
      "id": 3,
      "text": "Between 1868 and 1872, homes sprang up along the Ohio River, reflecting families drawn to river‑based livelihoods.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/glenfield_pennsylvania"
    },
    {
      "id": 4,
      "text": "Glenfield sits directly on the Ohio River, just northwest of Pittsburgh, and faces Neville Island across the main channel.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenfield%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The borough borders Aleppo Township to the north, Kilbuck Township to the east, and Haysville to the west.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Glenfield%2C_Pennsylvania"
