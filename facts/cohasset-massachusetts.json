    },
    {
      "id": 2,
      "text": "English settlers first arrived in 1670, dividing shares among Hingham landowners like Daniel Cushing and Reverend Peter Hobart.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohasset%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "After 1803, Cohasset became an exclave of Norfolk County, isolated from the rest of the county.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cohasset%2C_Massachusetts"
    },
    {
      "id": 4,
      "text": "The 1807 Pleasant Beach lifeboat station, staffed by volunteer crews, has guarded Cohasset’s shoreline for over two centuries.",
      "sourceSentenceIds": [
        12
      ],
