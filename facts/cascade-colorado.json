  "facts": [
    {
      "id": 1,
      "text": "Cascade was founded in 1886 by the Cascade Town and Improvement Company, which helped build the Pikes Peak Carriage Road.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cascade%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the many waterfalls that cascade through the canyon, not from any literary work.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cascade%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eliza Marriott Hewlett, a New York native, moved to Cascade in the 1880s and was one of the first families to settle there before it was officially a town.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cascade%2C_Colorado",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad depot, dining hall, and water tank appeared in Cascade in 1888, turning the town into a bustling stop for the Colorado Midland Railway.",
      "sourceSentenceIds": [
        10,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cascade%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cascade once hosted three grand hotels, including the Cascade Canyon House and Hotel Ramona, which catered to tourists until the 1920s.",
      "sourceSentenceIds": [
        24
