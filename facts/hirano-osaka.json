  "facts": [
    {
      "id": 1,
      "text": "Hirano‑ku is one of Osaka's 24 wards, located southeast of the city.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hirano-ku%2C_Osaka"
    },
    {
      "id": 2,
      "text": "The Yamato River runs through Hirano's southern edge, while the Hirano River once formed a moat protecting the town in the Sengoku period.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hirano-ku%2C_Osaka"
    },
    {
      "id": 3,
      "text": "During the Sengoku period, Hirano and neighboring Sakai formed the Hirano–Sakai Alliance to preserve autonomy against daimyō like Oda Nobunaga.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hirano-ku%2C_Osaka"
    },
    {
      "id": 4,
      "text": "The name Hirano likely comes from reclaimed marshlands turning flat fields, reflected in the kanji 平野 meaning 'flat field'.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hirano-ku%2C_Osaka"
    },
    {
      "id": 5,
      "text": "The Tanimachi Line of Osaka Metro, built in 1980 after the Nankai Hirano Line was abolished, runs through Hirano Station.",
      "sourceSentenceIds": [
        6,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hirano-ku%2C_Osaka"
    },
    {
      "id": 6,
      "text": "Hirano was once a self‑governing town with seven merchant families called Shichimyoke, giving it a distinct commercial heritage.",
      "sourceSentenceIds": [
        19
      ],
