  "facts": [
    {
      "id": 1,
      "text": "Sodaville takes its name from the nearby Soda Springs mineral springs discovered by settler Reuben P. Coyle in 1848.",
      "sourceSentenceIds": [
        9,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sodaville_oregon"
    },
    {
      "id": 2,
      "text": "By the 1880s, Sodaville featured a diverse array of businesses, including five hotels, a furniture factory, and a sawmill.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sodaville_oregon"
    },
    {
      "id": 3,
      "text": "The short-lived Sodaville Railroad Company once operated in the community during the late nineteenth century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sodaville_oregon"
    },
    {
      "id": 4,
      "text": "Mineral Springs College was established in Sodaville in 1892 during the town's early development.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sodaville_oregon"
    },
    {
      "id": 5,
      "text": "Sodaville's early history includes a role in Oregon's constitutional conventions and the establishment of Baptist congregations in 1848.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sodaville_oregon"
    },
    {
      "id": 6,
      "text": "The original Country Store in Sodaville is now city-owned and planned for refurbishment as a community center.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/sodaville_oregon"
    }
  ]
