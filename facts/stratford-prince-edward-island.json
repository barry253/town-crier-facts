  "facts": [
    {
      "id": 1,
      "text": "Stratford was formed in 1995 by amalgamating Bunbury, Cross Roads, Keppoch-Kinlock, and Southport.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Prince_Edward_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on a peninsula formed by Hillsborough River estuary, Charlottetown Harbour, and Hillsborough Bay.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Prince_Edward_Island",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stratford’s name comes from Stratford Road, a 4 km suburban road linking Bunbury via Southport with Cross Roads.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Prince_Edward_Island",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historically, a ferry operated across the Hillsborough River from Ferry Point in Southport to Charlottetown waterfront in the 1820s.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Prince_Edward_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was once called “the Ferry” before becoming Southport, reflecting its role as a river crossing.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Prince_Edward_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Stratford’s development began as a farming community but grew as a key transport link between Charlottetown and Georgetown’s ice‑free port.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Prince_Edward_Island",
      "category": "history",
      "quality": "good"
    }
