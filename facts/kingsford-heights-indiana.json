  "facts": [
    {
      "id": 1,
      "text": "Kingsford Heights began as Victory City, a federal village built in 1942 for workers at the Kingsbury Ordnance Plant.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsford_Heights%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around the 1940 Kingsbury Ordnance Plant, a key munitions facility that served WWII and the Korean War.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsford_Heights%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the war, residents bought the government land and incorporated the town, keeping local services alive.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsford_Heights%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kingsford Heights houses a branch of the LaPorte County Public Library, serving the community’s reading needs.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsford_Heights%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Unlike many federal projects, the town was designed mainly with single‑family homes rather than multi‑unit dwellings.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsford_Heights%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original plan called for 3,000 homes, businesses, schools, and parks, but development slowed after the ordnance plant closed.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kingsford_Heights%2C_Indiana",
      "category": "history",
      "quality": "good"
    }
