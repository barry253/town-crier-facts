  "facts": [
    {
      "id": 1,
      "text": "Little Mountain is named after a monadnock, an isolated ridge that resisted erosion while the surrounding Piedmont terrain wore away.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/little_mountain_historic_district"
    },
    {
      "id": 2,
      "text": "German-speaking immigrants from Pennsylvania and Virginia first settled the Little Mountain area in the mid-eighteenth century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/little_mountain_historic_district"
    },
    {
      "id": 3,
      "text": "The town of Little Mountain was founded in 1890 around a depot for the Columbia, Newberry, and Laurens Railroad.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/little_mountain_historic_district"
    },
    {
      "id": 4,
      "text": "Noah Boland is considered the father of Little Mountain, having donated land for the town's early school building.",
      "sourceSentenceIds": [
        25,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Mountain%2C_South_Carolina"
    },
    {
      "id": 5,
      "text": "Little Mountain was originally part of Lexington County until the current border with Newberry County was established in 1917.",
