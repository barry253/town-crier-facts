    {
      "id": 1,
      "text": "Hotevilla was first settled by the “hostiles,” a group of Hopi people expelled from nearby Oraibi in 1906.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hotevilla-Bacavi%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1911 the U.S. Army seized Hotevilla children and sent them to boarding schools after years of resistance.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hotevilla-Bacavi%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Later attempts to reintegrate displaced residents split the settlement, creating Bacavi, which later merged back with Hotevilla.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hotevilla-Bacavi%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hotevilla sits at 6,310 feet above sea level, roughly one and a half miles high.",
