  "facts": [
    {
      "id": 1,
      "text": "Hotevilla was first settled by the “hostiles,” a group of Hopi people expelled from nearby Oraibi in 1906.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hotevilla-Bacavi%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1911 the U.S. Army seized Hotevilla children and sent them to boarding schools after years of resistance.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hotevilla-Bacavi%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Later attempts to reintegrate displaced residents split the settlement, creating Bacavi, which later merged back with Hotevilla.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hotevilla-Bacavi%2C_Arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The settlement was established in 1906, the same year the Hopi split that led to its founding.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://roadsidethoughts.com/az/hotevilla-bacavi-xx-navajo-profile.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hotevilla lies within the Hopi Nation on Third Mesa, a prominent plateau in northern Arizona.",
