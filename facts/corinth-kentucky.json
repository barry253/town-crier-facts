  "facts": [
    {
      "id": 1,
      "text": "Corinth's roots trace back to the late 1820s when the Corinth Christian Church was organized, marking the first identifiable community in the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://corinth.ky.gov/Pages/history.aspx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1868, Corinth established its first post office, formalizing the town’s presence after more than a decade of informal settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://corinth.ky.gov/Pages/history.aspx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s charter in 1878 uniquely allowed its corporate limits to extend beyond Grant County into neighboring Scott County, a rare feature.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://corinth.ky.gov/Pages/history.aspx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Corinth’s name likely derives from the early church, a common practice of naming towns after their founding religious institutions.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://corinth.ky.gov/Pages/history.aspx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1878, the Kentucky State Legislature incorporated Corinth and simultaneously chartered the Corinth Academy, establishing the town’s first formal school.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://corinth.ky.gov/Pages/history.aspx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Corinth’s basketball team captured the 1930 Kentucky State Championship and earned third place nationally in Chicago, a proud moment in local sports history.",
