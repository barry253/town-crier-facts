  "facts": [
    {
      "id": 1,
      "text": "Stockville was founded in 1872, a year after early settlers began arriving in the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockville%2C_Nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s name, Stockville, comes from the livestock that ranchers raised in the surrounding plains.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockville%2C_Nebraska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1870, a band of former hostiles—the Whistler band of Cut‑off Oglala—settled near here, living in peace with early settlers for several years.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mynehistory.com/items/show/222",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stockville serves as the county seat of Frontier County, hosting the local courthouse and administrative offices.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockville%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s only commercial spot is a modest post office beside the courthouse, reflecting its quiet, rural character.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockville%2C_Nebraska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "That same year, white cattlemen started settling near Medicine Creek, marking the beginning of ranching in the area.",
