  "facts": [
    {
      "id": 1,
      "text": "Downers Grove was founded in 1832 by Pierce Downer, a farmer who traveled to Illinois from Rutland, New York, but was originally from Vermont.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downers_Grove%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Downers Grove was named for a lush grove of old‑growth bur oak trees surrounding the village, which stood out from the local savanna landscape.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downers_Grove%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Both the Lyman and Blodgett homes are of cultural significance, as they were both built by abolitionist families and served as former stops on the Underground Railroad.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Downers_Grove%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Downers Grove Museum and Historical Society present the Historic Home Program, aiming to preserve the village’s homes and educate the community about research and preservation.",
