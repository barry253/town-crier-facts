      "id": 1,
      "text": "Guilford was founded around 1856 in the heart of Nodaway County, Missouri.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilford%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was named to honor the Battle of Guilford Court House, a Revolutionary War clash.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilford%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Guilford sits just east of the Platte River, only about half a mile from the waterway.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Guilford%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The town’s high school, serving grades 7‑12, was located in nearby Barnard until all grades moved there in May 2013, closing the local school.",
