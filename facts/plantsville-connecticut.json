  "facts": [
    {
      "id": 1,
      "text": "Originally called \"Pearl's Corners,\" the village grew in the early 1800s around a horn‑comb factory, a dry‑goods store, and a tavern.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plantsville_connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The New Haven and Northampton Railroad arrived in the 1870s, and a post office opened, cementing Plantsville’s identity as an independent village.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plantsville_connecticut",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Quinnipiac River winds through Plantsville west of Route 10, shaping local drainage and supporting riparian habitats.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plantsville_connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A carriage‑bolt factory on the Quinnipiac River sparked growth, and the village was renamed Plantsville in honor of its founders.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plantsville_connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "An 1884 Sanborn Fire Insurance Map of Plantsville provides a detailed snapshot of the town’s layout during the late 19th century.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-plantsville-connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Timothy Higgins opened a tannery in 1823, and Solomon Stow’s tin‑shaping factory, later Peck, Stow & Wilcox, employed over 850 workers by 1900.",
      "sourceSentenceIds": [
