  "facts": [
    {
      "id": 1,
      "text": "Irvington was founded in 1870 by Sylvester Johnson and Jacob Julian as a suburban town of Indianapolis.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington_Historic_District_(Indianapolis)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood is named after Washington Irving, author of Rip Van Winkle and The Legend of Sleepy Hollow.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitindy.com/neighborhoods/irvington/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Irvington’s annual Halloween Festival, founded in 1947, brings together residents, organizations, and businesses to celebrate heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington_Historic_District_(Indianapolis)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Irving Theatre, built in 1913 as a nickelodeon, now seats over 700 and attracts touring bands.",
      "sourceSentenceIds": [
        15,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Irvington_Historic_District_(Indianapolis)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Irvington Historical Society, housed in the Bona Thompson Memorial Center, preserves and exhibits the neighborhood’s history and art.",
      "sourceSentenceIds": [
        16,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.irvingtonhistory.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Irvington Historic District, listed on the National Register in 1973, is the only house on the Indianapolis East Side available to the public.",
      "sourceSentenceIds": [
        25,
