  "facts": [
    {
      "id": 1,
      "text": "Wilson Bridge, built in 1819, is one of only two original National Road bridges still standing in Maryland.",
      "sourceSentenceIds": [
        24,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://industrialscenery.blogspot.com/2026/03/18191984-national-pike-and-1936-us-40.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After flood damage in 1972, the bridge was restored and now anchors a county park with picnic tables and historical markers.",
      "sourceSentenceIds": [
        27,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://industrialscenery.blogspot.com/2026/03/18191984-national-pike-and-1936-us-40.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1936 US‑40 bridge over the Conococheague River stretches 370 feet long with a 102‑foot main span.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://industrialscenery.blogspot.com/2026/03/18191984-national-pike-and-1936-us-40.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Conococheague Institute offers an open‑air living‑history museum that lets visitors relive colonial life in western Maryland.",
      "sourceSentenceIds": [
        5,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dcnewsnow.com/news/local-news/maryland/washington-county/conococheague-institute-relives-life-on-the-frontier-in-western-maryland/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Walking over the older Wilson Bridge gives a unique view, but the higher Route 40 bridge offers a better perspective of the river below.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://industrialscenery.blogspot.com/2026/03/18191984-national-pike-and-1936-us-40.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Conococheague River, which the bridges cross, has been a vital waterway for the region since the 18th‑century settlement of the area.",
