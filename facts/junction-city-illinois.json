  "facts": [
    {
      "id": 1,
      "text": "Junction City earned its name from the southern railroad junction where Illinois Central lines split, prompting rapid housing for mine workers and European immigrants.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/junction_city_illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first European‑American settlers arrived in the late 1820s, clearing timber and building log cabins as they claimed land in what is now Junction City.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/junction_city_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912 Junction City incorporated after a 1908 coal shaft opened, revealing a 560‑foot vein that made it Marion County’s top producer by 1915.",
      "sourceSentenceIds": [
        23,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/junction_city_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The same mining operations uncovered the county’s first oil well in 1908, drilling 578 feet deep, though it never became commercially viable.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/junction_city_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Junction City remains a modest residential community, its identity still shaped by its coal‑mining past and proximity to Salem.",
      "sourceSentenceIds": [
        5
      ],
