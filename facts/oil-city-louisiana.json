  "facts": [
    {
      "id": 1,
      "text": "Oil City sits on Caddo Lake and began as a flag stop on the Kansas City Southern Railroad in the late 19th century.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oil_city_louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now Oil City was once part of the Caddo Native American territory, whose settlements near Caddo Lake called it T’soto.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oil_city_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the late 19th century, Oil City grew into a hunting and fishing outpost centered on the Ananias Club, a private group jokingly named after the biblical Ananias.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/oil_city_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first productive oil strike in the Caddo‑Pine Island field came in 1905 when the Savage‑Morrical well was struck, sparking a rush of prospectors.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
