  "facts": [
    {
      "id": 1,
      "text": "Habikino sits in the Kawachi Plain, surrounded by Ikoma, Kongō, Katsuragi Mountains and Mount Nijō.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Habikino",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city earned the nickname Minami-Osaka, a nod to its location just south of Osaka city center.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Habikino",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ancient kofun burial mounds pepper Habikino, some dating back to the Kofun period and linked to early emperors.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Habikino",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Habikino’s history of yakiniku dates back about 140 years, making it a renowned meat‑cooking hub in Kansai.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
