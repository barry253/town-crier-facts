      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Skipwith takes its name from the Skipwith family, English baronets who arrived in Virginia during the 1650s Cromwell era and settled locally in the mid‑1700s.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
