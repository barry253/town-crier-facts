  "facts": [
    {
      "id": 1,
      "text": "Lake City was incorporated in 1859 and renamed from Alligator to honor the many nearby lakes like DeSoto, Alligator, Watertown, Harper.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.florida-backroads-travel.com/lake-city-florida.html"
    },
    {
      "id": 2,
      "text": "After the Civil War, Lake City grew into a railroad hub; tracks from Florida Railroad, Seaboard Air Line, Georgia Southern, Atlantic Coast Line crossed there.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.florida-backroads-travel.com/lake-city-florida.html"
    },
    {
      "id": 3,
      "text": "The town hosted the Battle of Olustee in 1864, the largest Civil War battle in Florida, just east of Lake City.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_City%2C_Florida"
    },
    {
      "id": 4,
      "text": "In 1907, former Florida Agricultural College land became Columbia College, a Baptist college, marking Lake City's early higher‑education effort.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_City%2C_Florida"
    },
    {
      "id": 5,
      "text": "Lake City was a scheduled stop on Amtrak's Sunset Limited from 1993 until Hurricane Katrina cut service in 2005.",
