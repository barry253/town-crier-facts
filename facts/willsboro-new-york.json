  "facts": [
    {
      "id": 1,
      "text": "Willsboro was originally called Milltown for a sawmill on the Bouquet River, then renamed after founder William Gilliland shortly after the Revolution.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willsboro%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s paper mill once supplied wood pulp for paper production, shaping its economy until the 1960s decline.",
      "sourceSentenceIds": [
        6,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willsboro%2C_New_York",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Edgewater Farm, a historic estate, earned a spot on the National Register of Historic Places in 1988.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willsboro%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Adsit Cabin, built by a Revolutionary War veteran, is one of the country’s oldest surviving log cabins and a living history site.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.adirondacksusa.com/find-your-place/lake-champlain/willsboro",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1930, philanthropist Paine donated a $150,000 library to Willsboro in memory of his mother, a landmark Neoclassical building.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willsboro%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Willsboro sits on Lake Champlain’s shore, making it the oldest lake town in the region founded in 1799.",
