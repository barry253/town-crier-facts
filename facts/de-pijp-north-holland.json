  "facts": [
    {
      "id": 1,
      "text": "De Pijp means \"The Pipe\" and likely refers to its long, narrow streets that funnel people toward central Amsterdam.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Pijp",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood grew around the Heineken Brewery, founded in 1864, whose brewing scent lingered until production stopped in 1988.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/De_Pijp",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "De Pijp's streets are named after Dutch painters such as Jan Steen, Frans Hals, Ruysdael and Vincent van Gogh, reflecting its artistic heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Pijp",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 2018 opening of De Pijp metro station beneath Ferdinand Bolstraat shifted commuters from trams to the underground, boosting citywide public transport use by 4%.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/De_Pijp",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area was once farmland outside Amsterdam’s medieval borders; rapid expansion in the 1870s brought industrial workers and shaped its working‑class character.",
      "sourceSentenceIds": [
        8
      ],
