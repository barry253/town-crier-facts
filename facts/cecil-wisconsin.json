  "facts": [
    {
      "id": 1,
      "text": "Cecil was founded around 1849 by the logging industry and was originally known as the Head of the Lake.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villageofcecil.com/"
    },
    {
      "id": 2,
      "text": "The village was renamed Cecil in 1884 to honor Cecil Leavitt, a railroad worker who helped complete the local rail line.",
      "sourceSentenceIds": [
        1,
        2,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cecil_wisconsin"
    },
    {
      "id": 3,
      "text": "Cecil remains the only incorporated village located on Shawano Lake.",
      "sourceSentenceIds": [
        27,
        29
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.villageofcecil.com/"
    },
    {
      "id": 4,
      "text": "Early settlers floated Wisconsin pine logs across Shawano Lake and down the Wolf River to sawmills in Oshkosh.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cecil_wisconsin"
    },
    {
      "id": 5,
      "text": "Ice harvesting in Cecil Bay served as a second major industry, with some ice shipping as far as Milwaukee.",
      "sourceSentenceIds": [
        23,
        24,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.villageofcecil.com/"
    },
    {
      "id": 6,
      "text": "The Washington Hotel was built in 1885 for summer tourists and later featured Bavarian décor.",
