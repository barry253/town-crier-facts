  "facts": [
    {
      "id": 1,
      "text": "Prattsburgh, New York was formed from the town of Pulteney in 1813, marking its establishment in the early 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prattsburgh%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is named after early settler Joel Pratt, who arrived around 1799 to purchase land in the area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prattsburgh%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Prattsburgh was once home to the Franklin Institute, which was described as 'old' around 1812.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prattsburgh%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The hamlet of Prattsburgh was incorporated as a village in 1848 but abandoned its village status in 1972.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prattsburgh%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Prattsburgh was served by the Kanona & Prattsburgh Railroad, which operated from 1889 to 1961, connecting to the Erie Railroad.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prattsburgh%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Notable figures from Prattsburgh include Narcissa Whitman, a missionary who became one of the first women to cross the continental divide.",
