  "facts": [
    {
      "id": 1,
      "text": "Warsaw adopted its current name in 1864 after a popular vote, choosing to honor a New York town that many settlers had come from.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warsaw_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area that is now settled by European Americans in the early 1850s, with Peter Bush staking a claim along Cannon Lake in 1853.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warsaw_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Warsaw sits on the western shore of Cannon Lake, which lies immediately to the east and serves as a significant water boundary for the community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warsaw_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Warsaw experiences a humid continental climate, with cold, snowy winters and warm, humid summers, and average annual precipitation around 30 inches.",
      "sourceSentenceIds": [
        24,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warsaw_minnesota",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "A trading post operated near Warsaw as early as the 1820s–1830s under Alexander Faribault, and by 1855 a hotel and saloon were established.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/warsaw_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before European arrival, the Wahpekute band of the Dakota people inhabited the region, using Cannon Lake and its tributaries for fishing, hunting, and farming.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
