  "facts": [
    {
      "id": 1,
      "text": "Tribeca, short for Triangle Below Canal, grew from a 19th‑century farm into a textile hub before becoming a haven for artists in the 1960s.",
      "sourceSentenceIds": [
        16,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribeca",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name, coined in the early 1970s, reflects its triangular shape bounded by Broadway, Canal, Lispenard, and Church Streets.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribeca",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1978, the Mudd Club opened on White Street, turning Tribeca into a crucible for punk, new wave, and conceptual art.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityneighborhoods.nyc/tribeca",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Robert De Niro and Jane Rosenthal revived the area in the 1990s, co‑producing the TV series TriBeCa and founding the Tribeca Film Festival in 2002.",
      "sourceSentenceIds": [
        4,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribeca",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Loft conversions turned former warehouses into luxury condos, while historic cast‑iron buildings by architects like Griffith Thomas and Henry Fernbach still line the streets.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
