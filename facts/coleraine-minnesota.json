  "facts": [
    {
      "id": 1,
      "text": "Coleraine was named after Thomas Cole, president of the Oliver Iron Mining Company, and was founded under the supervision of Greenway.",
      "sourceSentenceIds": [
        3,
        13
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.colerainemn.gov/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early growth was driven by iron ore extraction from the Mesabi Range, with steam shovels and trains removing ore in the early 1900s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.colerainemn.gov/history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Carnegie library, a school, and a village hall were built as part of the town’s early public buildings.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.colerainemn.gov/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Coleraine post office has been operating since 1906, marking the town’s long‑standing community services.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coleraine%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Coleraine embraces its mining heritage and offers abundant fishing, hunting, and outdoor adventure opportunities.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.colerainemn.gov/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Greenway, a Yale‑educated Rough Rider and close friend of Teddy Roosevelt, oversaw Coleraine’s early development.",
