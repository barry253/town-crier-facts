  "facts": [
    {
      "id": 1,
      "text": "Kikuyu takes its name from the Kikuyu people, Kenya’s largest ethnic group, whose ancestral lands surround Mount Kenya.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.kupi.com/en-ae/explore/kenya/kikuyu",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around a Scottish missionary school, quickly becoming an educational hub for the surrounding highlands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en-ae/explore/kenya/kikuyu",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Kikuyu’s railway station sits on the historic line that once linked Mombasa to Uganda, a key trade route in colonial Kenya.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en-ae/explore/kenya/kikuyu",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Kikuyu language, written in a Latin alphabet that omits f, l, p, q, s, v, x, and z, is spoken throughout Nairobi and nearby counties.",
      "sourceSentenceIds": [
        21,
        22,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kikuyu_language",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mount Kenya, called Kĩrĩmanyaga by the Kikuyu, marks the western edge of the town’s traditional homeland.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kikuyu_language",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Kikuyu’s history includes a council of elders who governed by age class, a practice that shaped its early social structure.",
