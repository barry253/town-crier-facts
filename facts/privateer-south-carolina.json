  "facts": [
    {
      "id": 1,
      "text": "Privateer originated in the late eighteenth century as a settlement of mixed Native American and European ancestry migrating from North Carolina.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/privateer_south_carolina"
    },
    {
      "id": 2,
      "text": "Founding families like the Chavis and Gibbs established farms on the fertile lands of Privateer around 1805.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/privateer_south_carolina"
    },
    {
      "id": 3,
      "text": "The Bethesda Baptist Church, founded in 1866, served as a central institution for worship and social cohesion in Privateer.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/privateer_south_carolina"
    },
    {
      "id": 4,
      "text": "Privateer settlers once navigated discrimination as a third race while contributing to the agricultural development of Sumter County.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/privateer_south_carolina"
    },
    {
      "id": 5,
      "text": "Proximity to the Congaree-Wateree River basin supports periodic flooding that enriches the soil fertility in the Privateer region.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/privateer_south_carolina"
    },
    {
      "id": 6,
      "text": "The establishment of Shaw Air Force Base in 1941 accelerated growth and introduced suburban housing to the Privateer area.",
