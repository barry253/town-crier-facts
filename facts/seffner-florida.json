      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Seffner Civic Center, built early 20th century, still hosts a basketball court, picnic tables, and a playground for locals.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
