  "facts": [
    {
      "id": 1,
      "text": "Geff, officially Jeffersonville, got its name from the railroad in the 19th century to avoid confusion with Jeffersonville, Indiana.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeffersonville%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Locally, residents spell the village Geff, and that spelling appears on road signs, the U.S. Post Office, and many official documents.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeffersonville%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "‘Geff’ is pronounced just like ‘Jeff’, so when you drive through, you’ll hear locals say ‘Jeff’ for the town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeffersonville%2C_Illinois",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Back in the day, brothers Burton and William Hawk ran a sawmill near Geff and Fairfield, supplying lumber to the growing community.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jeffersonville%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Geff sits in Wayne County, Illinois, a rural region that has maintained its small‑town character through the decades.",
