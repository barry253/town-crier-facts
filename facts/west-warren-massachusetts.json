  "facts": [
    {
      "id": 1,
      "text": "On March 13, 1834, West Warren was renamed Warren in honor of General Joseph Warren, who fell at Bunker Hill.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenerpasture.com/Places/Details/698",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before European settlement, the Nipmuc people established the Quaboag village along the river that now borders West Warren.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_warren_massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "West Warren’s mid‑1800s boom began with cotton mills in 1844, spurring dam construction, factories, and worker housing that still shape the village.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_warren_massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Western Railroad arrived in 1839, accelerating West Warren’s textile industry and linking the town to regional markets.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_warren_massachusetts",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Quaboag River runs through West Warren, feeding the Wrights Complex Lower Dam that regulates water for the historic mill area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_warren_massachusetts",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Revolutionary War, General Henry Knox marched through West Warren in winter 1775‑76, carrying artillery to aid George Washington.",
      "sourceSentenceIds": [
