      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The New York Central Railroad reached Old Field in 1888, switching from horse‑drawn to steam power before passenger service ended in 1965.",
      "sourceSentenceIds": [
