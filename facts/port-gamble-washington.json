  "facts": [
    {
      "id": 1,
      "text": "Port Gamble was founded as a company town by Josiah Keller, William Talbot, and Andrew Pope's Puget Mill Company in 1853.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Gamble%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Gamble Bay, which Commodore Wilkes named in 1842 during his expedition.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Gamble%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Pope & Talbot sawmill operated on Gamble Bay for 142 years, closing only in December 1995.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.portgamble.com/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Port Gamble was declared a National Historic Landmark District in 1966, recognized as one of the best-preserved western lumber towns.",
      "sourceSentenceIds": [
        5,
        7,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Gamble%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Port Gamble Historical Museum chronicles how the mill shaped the community and hosts the town’s walking tour pamphlets.",
      "sourceSentenceIds": [
        6,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Port_Gamble%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s picturesque streets feature New England–style houses lined with maple and elm trees, a rare architectural touch for the Pacific Northwest.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
