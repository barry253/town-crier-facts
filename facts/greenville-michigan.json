  "facts": [
    {
      "id": 1,
      "text": "Greenville was founded by John Green in 1844 and officially platted in 1853, becoming a station on the Detroit–Grand Rapids railroad.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Greenville%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The town grew into a factory hub; the Tower Motor Truck Company, founded 1874, built trucks and later a military glider named the Fighting Falcon.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2026/01/21/history-of-greenville-michigan/"
    },
    {
      "id": 3,
      "text": "During World War II, Greenville factories funded a D‑Day glider, and the town’s industrial output helped the war effort.",
      "sourceSentenceIds": [
        19,
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2026/01/21/history-of-greenville-michigan/"
    },
    {
      "id": 4,
      "text": "The Flat River Historical Museum, opened 1972, sits where John Green’s original sawmill and dam once stood on the riverbank.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
