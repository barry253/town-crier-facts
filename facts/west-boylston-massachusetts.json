  "facts": [
    {
      "id": 1,
      "text": "West Boylston Historical Society was founded in 1972 to keep alive the town’s early history and its people.",
      "sourceSentenceIds": [
        2,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wbhistory.org/"
    },
    {
      "id": 2,
      "text": "The Society helped preserve the Old Stone Church, the Bigelow Tavern Historic District, and the Jacob Winn Barn, among other landmarks.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://wbhistory.org/"
    },
    {
      "id": 3,
      "text": "A horse trough built in 1808 still stands in West Boylston’s common, a rare relic from the early 19th century.",
      "sourceSentenceIds": [
        5,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thebostondaybook.com/historical-places-in-west-boylston/"
    },
    {
      "id": 4,
      "text": "The town’s public library building was added to the National Register of Historic Places in 2016.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Boylston%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "Before becoming its own town in 1855, West Boylston was part of Lancaster, Shrewsbury, Boylston, Holden, and Sterling.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Boylston%2C_Massachusetts"
    },
    {
      "id": 6,
      "text": "The Old Stone Church remains as a reminder of the homes and jobs lost when the town’s reservoir was built.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Boylston%2C_Massachusetts"
