  "facts": [
    {
      "id": 1,
      "text": "Mikado began as a lumber town; its post office opened February 14, 1906 and closed February 15, 1911.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alchetron.com/Mikado-Township%2C-Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Daniel Bruce built a hotel for lumbermen in 1886, founding the community that later became Mikado.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alchetron.com/Mikado-Township%2C-Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name came after the post office rejected \"Bruceville\" and chose the township’s name instead.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://alchetron.com/Mikado-Township%2C-Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic schoolhouse in Mikado now serves as a museum and is listed as an Alcona County Historic Site.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mikado%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Lincoln branch of the Detroit and Mackinac Railway once stopped in Mikado, with a post office established May 11, 1886.",
