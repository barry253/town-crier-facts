  "facts": [
    {
      "id": 1,
      "text": "Wychwood Park was named after Wychwood Forest in Oxfordshire by painter Marmaduke Matthews, who founded the artists' colony in the 1890s.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.wychwoodparkhistoricalsociety.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s central park surrounds a pond created by damming Taddle Creek, one of the few visible ravines in Toronto.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wychwood_Park",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Arthur Edwin Whatmough designed the park’s tennis courts and many Arts‑and‑Crafts homes that line the tree‑lined streets.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wychwood_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 2008, the former TTC streetcar maintenance facility north of the park was converted into the Wychwood Barns community hub with a farmers’ market.",
      "sourceSentenceIds": [
        23,
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wychwood_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wychwood Park remains a private community; residents pay for roads and amenities through an executive council that dates back to its 1909 incorporation.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wychwood_Park",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The neighborhood’s first house was built in 1874 by Matthews, who hoped to create an artists’ colony that still attracts creatives today.",
      "sourceSentenceIds": [
