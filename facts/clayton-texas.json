  "facts": [
    {
      "id": 1,
      "text": "Clayton, Texas is an unincorporated community in Panola County, first settled around 1845 by Georgia native Jacob Cariker.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayton%2C_Texas"
    },
    {
      "id": 2,
      "text": "Jacob Cariker built a house two miles southwest of Reed's Settlement, one of Panola County's earliest communities.",
      "sourceSentenceIds": [
        18,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayton%2C_Texas"
    },
    {
      "id": 3,
      "text": "A post office opened in 1874, naming the town after Clayton, Alabama, where several early settlers originated.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayton%2C_Texas"
    },
    {
      "id": 4,
      "text": "Clayton was officially defined and organized in February 1907, solidifying its status within Panola County.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayton%2C_Texas"
    },
    {
      "id": 5,
      "text": "Margie Neal, the first woman elected to the Texas State Senate, was born near Clayton in 1875.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clayton%2C_Texas"
    },
    {
      "id": 6,
      "text": "Clayton sits at 32°05′54″N 94°28′30″W, placing it just north of the Red River and south of the Ouachita Mountains.",
