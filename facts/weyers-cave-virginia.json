  "facts": [
    {
      "id": 1,
      "text": "Weyers Cave got its name from Bernard Weyer who first found the caves that later became Grand Caverns.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://weyerscave.net/"
    },
    {
      "id": 2,
      "text": "The town hosts the first chapter of the Future Farmers of Virginia founded in 1927, a precursor to the National FFA.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weyers_Cave%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Horeb Presbyterian Church, built in 1855, stands as a prominent 19th‑century religious landmark in Weyers Cave.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.landingsweyerscave.com/exploring-the-historic-sites-of-weyers-cave-virginia/"
    },
    {
      "id": 4,
      "text": "The Shenandoah Valley Railroad once linked Weyers Cave to the rest of the state, and the old train depot still marks that era.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.landingsweyerscave.com/exploring-the-historic-sites-of-weyers-cave-virginia/"
    },
    {
      "id": 5,
      "text": "The West View Schoolhouse and Weyers Cave School are listed on the National Register of Historic Places, preserving the town’s educational heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Weyers_Cave%2C_Virginia"
    },
    {
