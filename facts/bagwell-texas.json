  "facts": [
    {
      "id": 1,
      "text": "Bagwell was named after Milas Bagwell, a local tannery and blacksmith shop owner who helped establish the town in the 1870s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bagwell-tx",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Texas and Pacific Railway reached Bagwell in 1875–76, turning the town into a key rail stop for the region.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bagwell-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s growth slowed after U.S. Route 82 bypassed it, leading to a decline in businesses by the 1960s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bagwell%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bagwell sits at the intersection of Farm to Market Roads 2120 and 2573, seven miles northwest of Clarksville in Red River County.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/bagwell-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Bagwell remains an unincorporated community, preserving its small-town character while reflecting its historic roots.",
