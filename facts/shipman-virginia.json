  "facts": [
    {
      "id": 1,
      "text": "Shipman grew around the 1859 arrival of the Orange & Alexandria Railroad’s Nelson Station depot, turning the village into a regional trade hub.",
      "sourceSentenceIds": [
        5,
        12
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shipman_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Shipman Historic District, about 100 acres, was added to the Virginia Landmarks Register and the National Register of Historic Places in 2025.",
      "sourceSentenceIds": [
        8,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shipman_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shipman’s streets still host a mix of 19th‑century stores, two former hotels, a post office, and three churches that served the surrounding rural community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/062-5312/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nero Creek runs through Shipman’s eastern side, while the nearby Rockfish River feeds the larger James River watershed.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/shipman_virginia",
      "category": "nature",
      "quality": "good",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Shipman’s climate is humid subtropical, averaging 55°F year‑long with hot, humid summers and mild winters that sometimes bring light snowfall.",
      "sourceSentenceIds": [
        24,
