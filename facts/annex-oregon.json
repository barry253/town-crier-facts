  "facts": [
    {
      "id": 1,
      "text": "Annex emerged during the late nineteenth century as irrigation developments turned arid lands into productive farmland along the Snake River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/annex_oregon"
    },
    {
      "id": 2,
      "text": "Annex sits on the south bank of the Snake River in a high desert landscape at an elevation of 2,103 feet.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/annex_oregon"
    },
    {
      "id": 3,
      "text": "The Annex School District was formally organized in January 1895 to serve the growing number of local farming families.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/annex_oregon"
    },
    {
      "id": 4,
      "text": "Annex operates the Annex Charter School, which received a new building in 1967.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Annex%2C_Oregon"
    },
    {
      "id": 5,
      "text": "The local economy in Annex emphasizes agriculture and small-scale operations supported by the fertile Snake River Valley.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/annex_oregon"
    },
    {
      "id": 6,
      "text": "Semi-arid high desert weather in Annex brings hot summers and cold winters with annual precipitation averaging just over 11 inches.",
      "sourceSentenceIds": [
