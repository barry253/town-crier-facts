      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "First settler Judah Barnes built a house near present East Road and East Main Street in 1798.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofturin.gov/about-the-village/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Turin once boasted a bustling downtown with a brick block, gristmills, and landmarks like the Hold house, Hart house, and Woolworth Inn.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://villageofturin.gov/about-the-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town was established in 1800 from the town of Mexico in Oswego County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turin%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Part of Turin was used to create the town of Martinsburg in 1803, and again in 1819.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Turin%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The eastern town line is defined by the Black River, and part of the town sits on the Tug Hill Plateau.",
