  "facts": [
    {
      "id": 1,
      "text": "Hickory Hills takes its name from the oak‑hickory forests that blanket the area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_hills_pennsylvania"
    },
    {
      "id": 2,
      "text": "The community sits on the Glaciated Pocono Plateau, where glacial kettles and thin till soils shape the land.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_hills_pennsylvania"
    },
    {
      "id": 3,
      "text": "Average temperatures hover around 49°F, but January lows dip to about 15°F, while July highs reach 79°F.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_hills_pennsylvania"
    },
    {
      "id": 4,
      "text": "Once a coal‑mining and logging hub, Hickory Hills now offers a quiet, residential lifestyle for its older residents.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_hills_pennsylvania"
    },
    {
      "id": 5,
      "text": "Elevations range from roughly 1,000 to 1,400 feet, giving the area a mix of ridges and shallow valleys.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_hills_pennsylvania"
    },
    {
      "id": 6,
      "text": "Local wetlands, often headwater swamps on poorly drained fragipan soils, add hydrological diversity despite past mining impacts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hickory_hills_pennsylvania"
    }
  ]
