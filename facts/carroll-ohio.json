  "facts": [
    {
      "id": 1,
      "text": "Carroll was named after Charles Carroll of Carrollton, the last surviving signer of the Declaration of Independence.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carroll%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Carroll was laid out in 1829 at the junction of the Ohio and Hocking Canals, where the canals met at an angle that laid the streets “on bias.”.",
      "sourceSentenceIds": [
        13,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Carroll%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "William Tong’s house on High Street was the first building erected in Carroll, marking the village’s first permanent structure.",
      "sourceSentenceIds": [
        8,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ci.carroll.oh.us/History-of-Carroll-Ohio.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "An early log building appeared around 1830 but burned down in the mid‑1800s, leaving only the memory of the town’s first timber structure.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ci.carroll.oh.us/History-of-Carroll-Ohio.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The village’s first businesses served only the surrounding farming community, as no major crossroads or railroad ever reached Carroll.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ci.carroll.oh.us/History-of-Carroll-Ohio.html"
