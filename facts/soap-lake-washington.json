      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1933, the U.S. Veterans Administration sent nine veterans to Soap Lake for a special project treating Buerger’s disease.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
