      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "When the Grand Coulee Dam was built, irrigation canals brought new life into Soap Lake, reviving its once-dwindling tourist trade.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
