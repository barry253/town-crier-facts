    },
    {
      "id": 2,
      "text": "In 1855, Oren Burbank Cheney and Benjamin Bates founded Bates College, making Lewiston an educational hub.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewiston%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The city’s first fire company formed in 1849, and a municipal electric plant followed, showing early industrial progress.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
