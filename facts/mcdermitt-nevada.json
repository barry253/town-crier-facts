      ],
      "source": "https://en.wikipedia.org/wiki/McDermitt%2C_Nevada_and_Oregon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fort McDermit was built to protect the stagecoach route from Virginia City through Winnemucca to Silver City.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McDermitt%2C_Nevada_and_Oregon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The White Horse Inn, a historic landmark on the state line, once served as a saloon, hotel, and reportedly a brothel.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
