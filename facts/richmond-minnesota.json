  "facts": [
    {
      "id": 1,
      "text": "Richmond first appeared on maps as Torah in 1890 because another Minnesota town already used the name Richmond, but locals reclaimed the original name in 1909.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The same year Richmond incorporated, a Great Northern Railway station was built, linking the town to the wider rail network.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Richmond sits on the Horseshoe Chain of Lakes, a cluster of more than a dozen lakes along the Sauk River, with Horseshoe Lake the largest.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town lies in Granite Country, where granite outcrops have been mined for over a century and twenty quarries dot the landscape.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 1900s, Richmond built a village hall with a stage that hosted concerts, plays, and band performances for the community.",
      "sourceSentenceIds": [
