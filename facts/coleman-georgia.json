  "facts": [
    {
      "id": 1,
      "text": "Coleman, Georgia, was founded in the late 19th century by Andy Coleman, who donated the land that became the town site.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/coleman_georgia"
    },
    {
      "id": 2,
      "text": "The town’s first depot, built in the 1880s, drew farmers, merchants, and railroad workers, turning Coleman into a small trading hub.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coleman_georgia"
    },
    {
      "id": 3,
      "text": "During the Great Depression, falling cotton prices and boll weevil infestations devastated Coleman’s agricultural base, leading to farm abandonments.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coleman_georgia"
    },
    {
      "id": 4,
      "text": "Coleman lies within Georgia’s Black Belt, an area known for its dark, fertile soils that supported the region’s cotton industry.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/coleman_georgia"
    },
    {
      "id": 5,
      "text": "The town’s municipal government was dissolved in 2007, after which all local services and taxes were transferred to Randolph County authorities.",
