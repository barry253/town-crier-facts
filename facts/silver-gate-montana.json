  "facts": [
    {
      "id": 1,
      "text": "Silver Gate was founded in 1932 by John L. Taylor, a North Carolina native raised in Park and Gallatin counties, who partnered with J.",
      "sourceSentenceIds": [
        1,
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128393",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name reflects its gateway position at Yellowstone’s northeast entrance and the silvery sheen of the surrounding mountains.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128393",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Silver Gate sits at 7,390 feet above sea level, perched on the Montana–Wyoming border at Yellowstone’s northeast entrance.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128393",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The valley of Soda Butte Creek, where Silver Gate lies, feeds the Yellowstone River watershed through its confluence with the L. River.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Silver_Gate%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Local building codes in the original townsite required frontier architecture and log construction, giving the community a distinctly rustic feel.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128393",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Before 2010, Silver Gate was part of the Cooke City–Silver Gate census‑designated place, but it now stands as a separate community.",
      "sourceSentenceIds": [
        7
