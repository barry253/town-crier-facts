      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During the Civil War, Confederate cavalry clashed at the Battle of James City on October 10, 1863, near present‑day Leon.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
