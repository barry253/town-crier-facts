      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1881 the Michigan Central Railroad built a depot in St. Helen, sparking a boom that linked the town to the wider lumber trade.",
      "sourceSentenceIds": [
        3,
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
