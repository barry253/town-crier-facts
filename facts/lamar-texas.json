  "facts": [
    {
      "id": 1,
      "text": "Lamar was founded in 1839 at Lookout Point, a rival to Aransas City across the channel at Live Oak Point.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lamar-tx-aransas-county",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Mirabeau B., a friend of the founder who helped establish the community.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lamar-tx-aransas-county",
      "category": "etymology",
      "quality": "poor",
      "qualityReason": "dropped_surname_no_wiki_source"
    },
    {
      "id": 3,
      "text": "The earliest cemetery in the territory, set aside by Byrne, is now a historical landmark in Lamar.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lamar-tx-aransas-county",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Only the ruins of a few old homes and the Catholic chapel Stella Maris remain as a reminder of Lamar’s early settlers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lamar-tx-aransas-county",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lamar County, where the town sits, was formed by the Republic of Texas on December 17, 1840, and organized the following year.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lamar_County%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The burial ground that once served pioneer settlers of the Lamar community is now a preserved historical site.",
      "sourceSentenceIds": [
        14
