  "facts": [
    {
      "id": 1,
      "text": "Cooksburg is an unincorporated community in Clarion and Forest counties, Pennsylvania.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cooksburg%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 2,
      "text": "The town sits on the north bank of the Clarion River at the Pennsylvania Route 36 bridge, 12.3 miles northeast of Clarion.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cooksburg%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "John Cook settled near the Clarion River in 1828, starting a logging career that left the area’s white pines and hemlocks untouched.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/pennsylvania-wilds/cooksburg/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cook built a sawmill and, in the late 1830s, floated lumber down the Clarion River in flatboats, sparking the town’s growth.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/northwestern-pennsylvania/forest/cooksburg",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Andrew Cook expanded the family business into three sawmills, a flouring mill, a planing mill, a store, and a boarding house for employees.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/northwestern-pennsylvania/forest/cooksburg",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Cook Sons Company continued transporting lumber down the Clarion River to the Allegheny River until the sawmill closed in 1910.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pittsburghmuseums.org/northwestern-pennsylvania/forest/cooksburg",
      "category": "economy",
      "quality": "good"
    }
