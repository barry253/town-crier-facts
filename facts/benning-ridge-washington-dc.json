  "facts": [
    {
      "id": 1,
      "text": "Benning Ridge is a residential neighborhood in Southeast DC bounded by Fort Chaplin Park, Southern Avenue, Benning Road, and Ridge Road SE.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Benning_Ridge",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name honors John A. Benning, a 19th‑century landowner whose estate once covered much of the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://austinkgraff.com/d-c-ward-7-neighborhood-guides/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Benning Ridge hosts a 1942 Art Deco theater that once housed the city’s second‑largest movie screen.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://austinkgraff.com/d-c-ward-7-neighborhood-guides/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1990, 100‑foot mural by Mattison behind 3919 Benning Rd NE honors Black heroes.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://austinkgraff.com/d-c-ward-7-neighborhood-guides/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fort Chaplin Park’s trail connects to Fort Dupont Park, one of DC’s largest parks.",
