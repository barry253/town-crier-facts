  "facts": [
    {
      "id": 1,
      "text": "Caldwell was founded in 1856 and named after pioneer Matthew Caldwell, a key figure in early Texas settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/caldwell-tx"
    },
    {
      "id": 2,
      "text": "The town sits northwest of Burleson County’s center, right along the historic Old San Antonio Road.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/caldwell-tx"
    },
    {
      "id": 3,
      "text": "Caldwell serves as the county seat of Burleson County, hosting the main courthouse and administrative offices.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Texas"
    },
    {
      "id": 4,
      "text": "It is part of the Bryan‑College Station metropolitan area, linking it to Texas’s growing research and education hub.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caldwell%2C_Texas"
    },
    {
      "id": 5,
      "text": "Although passenger trains stopped running, Caldwell remains a stop for two major freight railroads and Central Freight Lines.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/caldwell-tx"
    },
    {
      "id": 6,
      "text": "During Reconstruction, a company of State Police was stationed in Caldwell, reflecting its strategic importance at the time.",
      "sourceSentenceIds": [
