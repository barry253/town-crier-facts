  "facts": [
    {
      "id": 1,
      "text": "Lane was laid out in 1903 and named in honor of T.W. Paul.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lane%2C_South_Dakota"
    },
    {
      "id": 2,
      "text": "The town of Lane originated as a planned settlement in Jerauld County, which was primarily dedicated to agriculture.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lane_south_dakota"
    },
    {
      "id": 3,
      "text": "The Chicago, Milwaukee, and St. Paul Railroad completed its line through Lane by September 1903, facilitating the transport of goods.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lane_south_dakota"
    },
    {
      "id": 4,
      "text": "Lane features flat to gently rolling plains shaped by glacial processes that left behind drift deposits in the landscape.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lane_south_dakota"
    },
    {
      "id": 5,
      "text": "The Zion Emmanuel Lutheran Church was built between 1909 and 1910 and later became the Lane Community Hall and Museum.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/lane_south_dakota"
    },
    {
      "id": 6,
      "text": "The Lane Community Hall and Museum was listed on the National Register of Historic Places in October 2023.",
