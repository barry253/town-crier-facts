  "facts": [
    {
      "id": 1,
      "text": "Dikeman found gold on Otter Creek on December 25, 1908, sparking the founding of Flat City the next summer.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flat%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Flat became a frontier boomtown when a railroad linked it to Iditarod, swelling its population to about 6,000 by 1914.",
      "sourceSentenceIds": [
        5,
        6,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/flat-alaska-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Flat’s airstrip turned the town into a major transport hub, connecting remote southwestern Alaska to Fairbanks and Anchorage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/flat-alaska-ghost-town/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In July 1933, Wiley Post’s Lockheed Vega nosed over in Flat; locals helped right the plane, and a replacement propeller was brought by Joe Crosson.",
      "sourceSentenceIds": [
        20,
        21,
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flat%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Flat’s post office, which served the community until 2000, finally closed in January 2004.",
      "sourceSentenceIds": [
        10,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Flat%2C_Alaska",
      "category": "landmark",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Today, Flat is a ghost town with only collapsed ruins and no residents, leaving just three abandoned housing units.",
