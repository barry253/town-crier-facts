      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Friant lies along the San Joaquin River, at the base of Friant Dam and Millerton Lake.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
