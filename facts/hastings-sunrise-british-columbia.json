  "facts": [
    {
      "id": 1,
      "text": "Hastings‑Sunrise takes its name from Admiral George Fowler Hastings, honored after his 1866–1869 visit to the area.",
      "sourceSentenceIds": [
        3,
        4,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hastings%E2%80%93Sunrise",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s, Hastings‑Sunrise began as one of Vancouver’s earliest trading posts and transportation hubs.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vancouver.page/place/hastings-sunrise-neighbourhood-vancouver/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The first ferry between Burrard Inlet and Victoria launched from Hastings‑Sunrise, making it a key maritime link.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hastings%E2%80%93Sunrise",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, Hastings‑Sunrise attracts young professionals, artists, and a growing community of immigrants from China and Southeast Asia.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hastings%E2%80%93Sunrise",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Pacific National Exhibition began in 1910 after local residents lobbied for a wholesome community event, shaping the area’s culture.",
