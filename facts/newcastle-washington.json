  "facts": [
    {
      "id": 1,
      "text": "Newcastle was founded in 1869, originally called New Castle, and its name was chosen to echo the idiom “Coals to Newcastle.”.",
      "sourceSentenceIds": [
        9,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newcastle%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first railroad, the Seattle and Walla Walla line, reached Newcastle in 1878, making it King County’s earliest rail link to Seattle.",
      "sourceSentenceIds": [
        17,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newcastle%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Coal mined in Newcastle powered Seattle’s growth, with trains delivering fuel to the Port of Seattle and sparking the city’s early industrial boom.",
      "sourceSentenceIds": [
        15,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newcastle%2C_Washington",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Baima House, built in the 1870s and listed on the National Register in 1979, now anchors Heritage Park, a museum celebrating the town’s mining heritage.",
      "sourceSentenceIds": [
        26,
        25,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.newcastlewahistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Newcastle Historical Society, founded by Pam Lee and others, has documented the town’s hidden history, publishing works like *The Coals of Newcastle* in 2020.",
      "sourceSentenceIds": [
        5,
        6,
        23
      ],
