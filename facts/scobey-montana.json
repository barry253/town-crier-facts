  "facts": [
    {
      "id": 1,
      "text": "Scobey was named in 1901 by rancher Mansfield Daniels after his friend Major Charles Richardson Anderson Scobey, a cattleman and former Montana Territory legislator.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scobey%2C_Montana"
    },
    {
      "id": 2,
      "text": "In 1913 the Great Northern Railway bypassed the original settlement, prompting most residents to relocate 1.5 miles west to a new site.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128374"
    },
    {
      "id": 3,
      "text": "Scobey once held the title of the largest primary grain shipping point in the world during the 1910s homestead boom.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scobey%2C_Montana"
    },
    {
      "id": 4,
      "text": "The town’s library, the Daniels County Library, sits in the historic county seat of Scobey.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scobey%2C_Montana"
    },
    {
      "id": 5,
      "text": "Two radio stations broadcast from Scobey: KCGM with country music and KNPS, a religious channel.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scobey%2C_Montana"
    },
    {
      "id": 6,
      "text": "Scobey’s elevation is 2,469 feet, giving it a semi‑arid climate with long, cold winters and short, hot summers.",
