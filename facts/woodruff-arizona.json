  "facts": [
    {
      "id": 1,
      "text": "Woodruff was founded in 1876 by LDS members led by Nathan Tenney as Tenney's Camp, part of Mormon colonization along Little Colorado River.",
      "sourceSentenceIds": [
        2,
        15,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodruff_arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1878 the settlement was renamed Woodruff in honor of Wilford Woodruff, the fourth LDS president.",
      "sourceSentenceIds": [
        3,
        1
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/woodruff_arizona",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The community sits on upland terrain near the Little Colorado River, avoiding active floodplains while still influenced by the river.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodruff_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Annual precipitation averages about 10 inches, mostly during July‑September monsoon thunderstorms that bring brief but intense rains.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woodruff_arizona",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woodruff is located 10.5 miles southeast of Holbrook, placing it within the Colorado Plateau’s remote, rural setting.",
