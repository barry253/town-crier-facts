    },
    {
      "id": 2,
      "text": "Bold murals lining Pawcatuck’s streets vividly illustrate the town’s rich history, turning the village into an open‑air gallery.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ctinsider.com/connecticutmagazine/explore/article/pawcatuck-travel-weekend-getaway-shopping-ct-20322028.php"
    },
    {
      "id": 3,
      "text": "A mural shows an Eastern Pequot canoeing down the Pawcatuck River, highlighting the river’s colonial role.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.ctinsider.com/connecticutmagazine/explore/article/pawcatuck-travel-weekend-getaway-shopping-ct-20322028.php"
    },
    {
      "id": 4,
      "text": "The Pawcatuck River historically powered a network of textile mills, shaping the village’s industrial heritage for generations.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
