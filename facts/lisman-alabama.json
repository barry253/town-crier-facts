  "facts": [
    {
      "id": 1,
      "text": "Lisman was named after Frederick Lisman, a New York investor who funded the railroad and insisted a town be named for him.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/lisman/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before Lisman existed, the Allen family owned an 8,000‑acre plantation that dominated the region.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/lisman/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1962, Lisman residents sued the county over voter registration, and in 1966 Martin Luther King Jr. led a rally there.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisman%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before becoming Lisman, the area was called Thompkinsville, named after John Wesley Pennington.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/lisman/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Allen plantation home still stands, and the property once included a schoolhouse, grist mill, cotton mill, and gin company.",
