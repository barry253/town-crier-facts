      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the Revolutionary War, Onancock Creek was the site of the last naval action of the war, where Whaley’s flagship Protector was captured.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
