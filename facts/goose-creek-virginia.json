      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During June 1863, Confederate cavalry under JEB Stuart clashed with Union forces near the bridge in the Battle of Upperville, just before Gettysburg.",
      "sourceSentenceIds": [
