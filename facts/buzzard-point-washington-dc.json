  "facts": [
    {
      "id": 1,
      "text": "Buzzard Point was originally called Turkey Buzzard Point in 1673 on Augustine Herman's map.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buzzard_Point",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1790s the peninsula became Young's Point after landowner Notley Young before being renamed Buzzard Point.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buzzard_Point",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "George Washington selected the site for a military redoubt in 1791, leading to the establishment of the Washington Arsenal.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buzzard_Point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Washington Arsenal at Buzzard Point tested early breechloaders, the Spencer carbine, and the Gatling gun.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buzzard_Point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By the early 1960s the Naval Gun Factory closed, prompting planners to envision a new industrial future for the area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buzzard_Point",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Buzzard Point lies just a short drive from Nationals Park and the Navy Yard metro stations, making it a convenient spot for commuters.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
