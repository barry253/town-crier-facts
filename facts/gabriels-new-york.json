  "facts": [
    {
      "id": 1,
      "text": "Gabriels takes its name from Henry Gabriels, a Belgian‑born bishop who helped shape the region’s early history.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gabriels%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The hamlet grew around the Gabriels Sanatorium, a tuberculosis cure center opened in 1897 by the Sisters of Mercy.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gabriels%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A train depot on the Adirondack Division made Gabriels the commercial hub for the town of Brighton in the early 1900s.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gabriels%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1961 the New York Central abandoned the Adirondack Division stretch from Malone Junction to Gabriels, ending a key rail link.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gabriels%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Gabriels still serves as Brighton’s commercial center, hosting a post office, small shops, a Catholic church, and farms.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gabriels%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Department of Corrections’ Camp Gabriels operated on the former sanatorium site until its closure in 2009.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Gabriels%2C_New_York",
