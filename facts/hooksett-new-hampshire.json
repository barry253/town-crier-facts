  "facts": [
    {
      "id": 1,
      "text": "Hooksett’s Robie’s Country Store, a National Historic Landmark, has welcomed presidential candidates during every New Hampshire primary since the 1970s.",
      "sourceSentenceIds": [
        2,
        18,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hooksett%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Hooksett Historical Society’s archives, now housed in the public library, offer a window into the town’s past through photographs, documents, and oral histories.",
      "sourceSentenceIds": [
        3,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://hooksetthistory.wordpress.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every spring, the Hooksett Heritage Commission hosts open houses at historic sites like Arah Prescott Library, Head Chapel, and Robie’s Country Store.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.achp.gov/index.php/preserve-america/community/hooksett-new-hampshire",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hooksett sits neatly between Manchester, New Hampshire’s largest city, and the state capital, Concord, making it a quiet commuter town with historic charm.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hooksett%2C_New_Hampshire",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "A postcard from the early 1900s captures Hooksett’s railroad trestle over the Merrimack River, a reminder of the town’s once‑busy rail era.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hooksetthistory.wordpress.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Hooksett Historical Society meets on the fourth Thursday of the month in September, October, March, April, May, and June to share local stories.",
