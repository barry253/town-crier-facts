  "facts": [
    {
      "id": 1,
      "text": "The Victorian Arcade, once called the Digbeth Arcade, opened its doors in 1897, adding a splash of late‑Victorian charm to Walsall’s town centre.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walsall",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Queen Mary's Grammar School, founded in 1554, still wears the Tudor Rose and a sheaf of arrows as its emblem, a nod to the queen’s own heritage.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walsall",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Walsall’s first cinema began showing films in 1908, but post‑war television boom eventually led to the closure of all local theatres.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walsall",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Barr Beacon rises to the highest point eastward from the UK’s mainland until the Ural Mountains, making it a unique geographic landmark in Walsall.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walsall",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Matthew’s Church, originally dedicated to All Saints, still houses a 13th‑century inner crypt that survived the town’s many redevelopment waves.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://go.walsall.gov.uk/walsall-libraries/lichfield-street-hub/walsall-archives-services/research-resources/walsall-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1966, Walsall expanded its boundaries to include most of Darlaston and Willenhall, then later joined the newly formed West Midlands county.",
