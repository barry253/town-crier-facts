      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The Mesa Verde Travel Authority promotes the area's history and culture, encouraging visitors to learn about Ancestral Puebloans.",
      "sourceSentenceIds": [
