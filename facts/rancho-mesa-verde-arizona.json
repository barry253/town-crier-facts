  "facts": [
    {
      "id": 1,
      "text": "Rancho Mesa Verde sits near Mesa Verde National Park, where over 600 cliff dwellings built by Ancestral Puebloans between 600‑1300 AD remain.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mesaverde.com/about-mesa-verde/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Ancestral Puebloans abandoned the cliff dwellings around 1300 AD, likely due to drought, overpopulation, and warfare.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mesaverde.com/about-mesa-verde/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2023, visitors to Mesa Verde National Park spent $59.5 million in nearby communities, supporting 776 jobs and $75.6 million in revenue.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/meve/learn/news/tourism-and-economy.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Students in Rancho Mesa Verde attend Somerton High School, the local zoned high school.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rancho_Mesa_Verde%2C_Arizona",
