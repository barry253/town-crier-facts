  "facts": [
    {
      "id": 1,
      "text": "North Attleborough's oldest house dates to the 17th century and was built as a fortified structure to protect settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebostondaybook.com/historical-places-in-north-attleborough/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1780, French settler Lazarus Periera started a brass forge that sparked the town's industrial era.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Attleborough%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town once hosted a network of grist and sawmills along the Ten Mile River, later replaced by cotton spinning mills.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Attleborough%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ira Richards Co.'s Factory, a historic textile mill, still stands as a reminder of North Attleborough's manufacturing past.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenerpasture.com/Places/Details/527",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Balfour Company, a jewelry firm that employed many residents, played a key role in the town's economic history.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Attleborough%2C_Massachusetts",
      "category": "economy",
      "quality": "good"
    },
    {
