      "id": 1,
      "text": "Breckenridge sprang to life in 1872 when the Pere Marquette Railroad built a station through the area.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
