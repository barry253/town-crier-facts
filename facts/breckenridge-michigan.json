  "facts": [
    {
      "id": 1,
      "text": "Breckenridge sprang to life in 1872 when the Pere Marquette Railroad built a station through the area.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Breckenridge%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The station quickly turned Breckenridge into a major shipping point for timber products like hoops, staves, and lumber.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.breckenridgemi.com/home/our-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1870s, Hood and Peterman opened the town’s first stave mill, marking the start of its lumber industry.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.breckenridgemi.com/home/our-history/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1900, Breckenridge’s economy shifted to farming, with sugar beet factories sprouting across the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.breckenridgemi.com/home/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Breckenridge officially became a village in 1908, solidifying its community structure.",
