  "facts": [
    {
      "id": 1,
      "text": "Nakano became a special ward on March 15 1947 after Allied occupation reforms reshaped Tokyo’s administration.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nakano%2C_Tokyo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ward’s origins trace back to October 1 1932, when the towns of Nogata and Nakano merged into Tokyo City.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nakano%2C_Tokyo",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nakano Broadway, a five‑minute walk north of Nakano Station, opened in 1966 during Japan’s post‑war boom and now houses iconic manga shops like Mandarake.",
      "sourceSentenceIds": [
        6,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.gotokyo.org/en/destinations/western-tokyo/nakano/index.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dubbed the “holy land” of subculture, Nakano attracts collectors to stores such as Lashinbang, which sell a vast array of anime and manga merchandise.",
      "sourceSentenceIds": [
        7,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://matcha-jp.com/en/mcm24223",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nakano Station, the hub for JR Chuo, Sobu, and Tokyo Metro Tozai lines, opened in 1961, making the ward a key transit node.",
      "sourceSentenceIds": [
        29,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nakano%2C_Tokyo",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Chūō Main Line, which today runs through Nakano, originally included a station here on its route from Shinjuku to Hachioji.",
      "sourceSentenceIds": [
        8
      ],
