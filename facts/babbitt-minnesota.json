  "facts": [
    {
      "id": 1,
      "text": "Babbitt, Minnesota, takes its name from Judge Kurnal R., a prominent figure in the region's early history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Babbitt%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city grew out of the formation of a taconite mine built by Armco and Republic Steel starting in 1944.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Babbitt%2C_Minnesota",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The company town was built near the eastern edge of the Mesabi Iron Range.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Babbitt%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early in 1920, construction began on the plant, railroad, and townsite that would become Babbitt.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakesnwoods.com/BabbittHistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Babbitt plant was abandoned, 245 employees left for other jobs, and the mining town became a ghost town by the fall of 1924.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakesnwoods.com/BabbittHistory.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "When the plant closed, Pleasant View and West Babbitt were abandoned, and workers moved to the hilltop Babbitt townsite.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
