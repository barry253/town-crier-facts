    {
      "id": 1,
      "text": "Clearview sits on the west side of State Route 9 where it meets 180th Street SE, right in the heart of Snohomish County.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
