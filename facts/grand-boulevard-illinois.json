  "facts": [
    {
      "id": 1,
      "text": "Grand Boulevard earned its name from the wide avenue that once ran through the area, now renamed Martin Luther King Jr. Boulevard.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.bronzecommhub.com/blog/Grand-Boulevard-(Bronzeville)-Chicagos-Historic-South-Side-Gem",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood was annexed to Chicago in 1889, transitioning from Hyde Park Township to become part of the city’s South Side.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bronzecommhub.com/blog/Grand-Boulevard-(Bronzeville)-Chicagos-Historic-South-Side-Gem",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1919 Chicago Race Riot, Grand Boulevard became a frontline where Black residents defended their homes and businesses from attacks.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bronzecommhub.com/blog/Grand-Boulevard-(Bronzeville)-Chicagos-Historic-South-Side-Gem",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Harold Washington Cultural Center on Grand Boulevard honors Chicago’s first Black mayor and serves as a hub for performing arts.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bronzecommhub.com/blog/Grand-Boulevard-(Bronzeville)-Chicagos-Historic-South-Side-Gem",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Green Line’s 43rd Street station sits on Grand Boulevard, linking the neighborhood to downtown Chicago via rapid transit.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Boulevard%2C_Chicago",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Grand Boulevard’s revitalization in recent decades includes historic preservation projects and new housing developments that aim to keep long‑time residents in the community.",
