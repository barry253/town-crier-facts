  "facts": [
    {
      "id": 1,
      "text": "Longville was founded in 1906 when Long‑Bell Lumber Company chose a site in southwestern Beauregard Parish to build the state‑largest sawmill.",
      "sourceSentenceIds": [
        16,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.beauregardtourism.com/longville.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The sawmill was steam‑driven, cutting 350,000 board feet of Long‑Leaf Yellow Pine per ten‑hour shift.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ralonghistoricalsociety.org/longville%2C-louisiana",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Longville was a closed town; all businesses were owned and operated by Long‑Bell.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ralonghistoricalsociety.org/longville%2C-louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A school was built in 1908 to serve families of the lumber company.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauregardtourism.com/longville.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s entertainment center was the Dixie Theater, showing silent films and later popular westerns on Friday nights.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauregardtourism.com/longville.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 60‑room Southern Hotel was the most impressive structure built in Beauregard Parish during the sawmill era.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.beauregardtourism.com/longville.html",
