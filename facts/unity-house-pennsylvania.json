      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "An abandoned railroad tunnel, locally called Witches' Tunnel, cuts through Unity Township on a dismantled Pennsylvania Railroad spur that once served coal mines.",
      "sourceSentenceIds": [
        1,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
