  "facts": [
    {
      "id": 1,
      "text": "LaSalle named after French explorer René-Robert Cavelier de La Salle.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaSalle%2C_Quebec",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s symbol is a four‑story windmill built in 1816, the Fleming Mill, still standing on the Lachine Canal.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaSalle%2C_Quebec",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before becoming a municipality in 1912, the area was part of the parish of Saints‑Anges‑de‑la‑Chine during the French regime.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaSalle%2C_Quebec",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1820s, the Lachine Canal was constructed to bypass the rapids that once forced boats to be portaged along Chemin LaSalle.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/LaSalle%2C_Quebec",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "LaSalle was merged into Montreal on January 1, 2002, joining several other island municipalities.",
      "sourceSentenceIds": [
        18
      ],
