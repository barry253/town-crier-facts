      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "President Clinton selected Playa Vista in 1998 as one of six national PATH pilot communities, making it one of the most tech‑savvy neighborhoods ever planned.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
