  "facts": [
    {
      "id": 1,
      "text": "Montbello was annexed in 1965, absorbing the 2,932‑acre Miller ranch, the largest land grab Denver had seen at that time.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/montbello-neighborhood-history"
    },
    {
      "id": 2,
      "text": "The neighborhood’s name comes from Italian “Monte Bello” meaning beautiful mountain, inspired by views of Mount Evans and Longs Peak.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Montbello%2C_Denver"
    },
    {
      "id": 3,
      "text": "Early developers built a “city within a city” with 1,770 acres for homes, 800 for commerce, and space for churches, parks, and schools.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/montbello-neighborhood-history"
    },
    {
      "id": 4,
      "text": "A railroad caboose once marked the entrance to Montbello from I‑170 and Havana Street, a quirky roadside reminder of the area’s past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/montbello-neighborhood-history"
    },
    {
      "id": 5,
      "text": "Montbello’s growth began after WWII when Denver faced a housing crisis; developers like Perl‑Mack constructed the first homes in the 1950s.",
      "sourceSentenceIds": [
        3,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montbello%2C_Denver"
    },
    {
      "id": 6,
      "text": "The neighborhood’s early infrastructure included a fire station, park, bank, and church by the late 1960s, laying the groundwork for community life.",
