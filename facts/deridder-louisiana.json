      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Visitors can tour the historic Gothic Jail on weekdays, a preserved 19th‑century structure that once held prisoners in DeRidder.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
