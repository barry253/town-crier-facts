  "facts": [
    {
      "id": 1,
      "text": "Saint Peter began as Frogtown in 1825, growing to about 100 people by 1835 with stores, a blacksmith, and a tavern.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_peter_illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Phillip Luster built the first horse‑powered saw and grist mill in 1820‑21, sparking early industry in the township.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_peter_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "German settlers arriving in the 1860s turned the rich black soil into productive wheat, corn, and hay farms.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_peter_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village sits between tributaries of Hickory and Richland Creeks, with timbered hills to the north and flat grasslands to the south.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/st_peter_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Illinois Route 185 threads through Saint Peter, leading 17 miles northwest to Vandalia and 6.5 miles southeast to Farina.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Peter%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Saint Peter covers just 0.52 square miles, all land, making it a compact rural community.",
