  "facts": [
    {
      "id": 1,
      "text": "Cokedale began as a tent colony in 1899 before the American Smelting and Refining Company founded it in 1906.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.9news.com/article/travel/destinations/colorado-adventures/9adventures-history-cokedale-colorado/73-e9a71ed5-8e96-4ae9-914a-c2d741b14102"
    },
    {
      "id": 2,
      "text": "The town’s coke ovens produced 800 tons of coke daily while the mine churned 1,500 tons of coal each day.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/colorado/cokedale/"
    },
    {
      "id": 3,
      "text": "Mining operations ran for 40 years, yielding over a million tons of coal before the mine shut down in 1947.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/colorado/cokedale/"
    },
    {
      "id": 4,
      "text": "After the mine closed, residents bought their homes and incorporated Cokedale in March 1948, preserving the community spirit.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/colorado/cokedale/"
    },
    {
      "id": 5,
      "text": "In 1984 Cokedale was added to the National Register of Historic Places, recognizing its well‑preserved mining heritage.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/colorado/cokedale/"
    },
    {
      "id": 6,
      "text": "Cokedale’s post office operated from December 26, 1906, until October 28, 1997, marking the town’s long‑standing communication link.",
      "sourceSentenceIds": [
        17
      ],
