  "facts": [
    {
      "id": 1,
      "text": "Knoxville was founded in 1823 as the seat of newly formed Crawford County.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knoxville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name origin is unclear; some historians say it honors Hugh Knox, a stagecoach operator, while others cite General Henry Knox.",
      "sourceSentenceIds": [
        7,
        8,
        17,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thegagenweb.com/gacrawfo/Cities/robertaknoxville.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888 the Knoxville Journal was founded, and that same year a railroad bypassed Knoxville, prompting residents to shift to nearby Roberta.",
      "sourceSentenceIds": [
        9,
        23,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Knoxville%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Knoxville’s old jail, built in 1832, now houses the Crawford County Historical Society museum.",
      "sourceSentenceIds": [
        4,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.thegagenweb.com/gacrawfo/Cities/robertaknoxville.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Crawford County Courthouse, completed in 1831, still stands today and is listed on the National Register of Historic Places.",
