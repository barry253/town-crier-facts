  "facts": [
    {
      "id": 1,
      "text": "Founded in 1835 or 1836 by Pleasant and Ephraim Gray as an Indian trading post, Huntsville was named after Huntsville, Alabama, the Gray family’s former home.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/huntsville-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1879 Sam Houston Normal Institute opened in Huntsville, becoming the first teacher‑training institution in Texas and later evolving into Sam Houston State University.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/huntsville-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bishop Ward Normal and Collegiate Institute for Negroes opened in 1883, offering coeducational training for African‑American students during a brief seven‑year run.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/huntsville-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "As early as 1856 Huntsville citizens plotted a railroad line to connect with the Houston and Texas Central Railway, but the project never materialized.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/huntsville-tx",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Huntsville’s downtown hosts a 70‑foot statue honoring Sam Houston, a prominent landmark that rises above the historic streets.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Huntsville%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city sits within the Sam Houston National Forest, where towering pines create a natural backdrop for visitors and locals alike.",
      "sourceSentenceIds": [
        11
      ],
