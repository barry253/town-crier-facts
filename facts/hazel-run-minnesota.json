  "facts": [
    {
      "id": 1,
      "text": "Hazel Run was platted in September 1884, following the arrival of the Minneapolis and St. Paul Railroad.",
      "sourceSentenceIds": [
        15,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hazel_run_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hazel Run takes its name from a nearby creek that feeds into the Minnesota River.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lakesnwoods.com/HazelRun.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1910 fire destroyed much of Hazel Run’s business district, prompting a rebuilding era that still shapes the town’s quiet, agrarian feel.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hazel_run_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hazel Run’s post office operated from 1884 until 1992, serving the community for over a century.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hazel_Run%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hazel Run incorporated as a village in 1902 and became an independent city in 1918, separating from the township.",
