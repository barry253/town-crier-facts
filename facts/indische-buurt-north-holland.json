  "facts": [
    {
      "id": 1,
      "text": "The Indische Buurt’s streets are named after islands and other places from the former Dutch East Indies, giving the neighborhood its distinctive name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indische_Buurt",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Developed east of the Oosterpark on reclaimed polder land, the Indische Buurt grew to house factory, shipyard, and industry workers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/indische_buurt",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Muiderpoort Station opened in 1939, breaking the Indische Buurt’s isolation behind the railway that once separated it from the rest of Amsterdam.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Indische_Buurt",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Javastraat hosts a lively market where halal vendors and international eateries reflect the neighborhood’s multicultural heritage.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/indische_buurt",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 2010 renewal of Timorplein introduced a new cultural hub with a theater, hostel, and conference rooms, reshaping the area’s social scene.",
