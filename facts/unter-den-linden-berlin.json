  "facts": [
    {
      "id": 1,
      "text": "Unter den Linden began as a 16th‑century bridle path for Prussian royalty, later turned into the boulevard we know today.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://berlinhoponhopoff.com/unter-den-linden/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The avenue gets its name from the linden trees that once lined the median and now grace the sidewalks.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Unter_den_Linden",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Stretching almost a mile east‑west, Unter den Linden links the Berlin Palace with the Brandenburg Gate.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unter_den_Linden",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Friedrichstraße and Wilhelmstrasse intersect Unter den Linden at Mehringplatz, a historic crossroads in the city.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unter_den_Linden",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Parts of Berlin’s post‑Thirty‑Years’ War fortress were absorbed into the boulevard, visible near Opernplatz and Bebelplatz.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Unter_den_Linden",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Along Unter den Linden stands the 1851 equestrian statue of Frederick II the Great and the historic Humboldt University.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/topic/Unter-den-Linden",
      "category": "landmark",
      "quality": "good"
