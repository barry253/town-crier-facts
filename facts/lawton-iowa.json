  "facts": [
    {
      "id": 1,
      "text": "Lawton was renamed after Joseph Law, who claimed naming rights from the railroad in 1901.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lawtoniowa.com/additional-information"
    },
    {
      "id": 2,
      "text": "Before becoming Lawton, the town was originally called Truxton, reflecting early settlers' hopes for a thriving community.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lawtoniowa.com/additional-information"
    },
    {
      "id": 3,
      "text": "Lawton contracts with the Woodbury County Library, whose main branch sits in Moville, just eight miles east.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lawtoniowa.com/additional-information"
    },
    {
      "id": 4,
      "text": "One of Iowa's few bookmobiles serves Lawton, bringing library resources directly to residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.lawtoniowa.com/additional-information"
    },
    {
      "id": 5,
      "text": "Lawton lies seven miles east of Sioux City along U.S. Route 20, amid rolling fertile farmland.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lawton%2C_Iowa"
    },
    {
      "id": 6,
      "text": "Lawton functions as a bedroom community for Sioux City, offering a quiet rural lifestyle within commuting distance.",
