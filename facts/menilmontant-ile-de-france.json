  "facts": [
    {
      "id": 1,
      "text": "Ménilmontant sits on a hill 108 m high, part of Paris's seven historic hills, giving it a commanding view.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/M%C3%A9nilmontant"
    },
    {
      "id": 2,
      "text": "The area began as a medieval hamlet called Mesnil Mautemps, meaning “manor of ill weather,” recorded in a 1224 charter.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/M%C3%A9nilmontant"
    },
    {
      "id": 3,
      "text": "In the 16th century, the Menilmontant brook was channeled into the Grand Égout, Paris's first major sewer system.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Menilmontant_brook"
    },
    {
      "id": 4,
      "text": "The brook, first mentioned in a 629 charter by King Dagobert I, once flowed from Place de la République to the Seine.",
      "sourceSentenceIds": [
        12,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Menilmontant_brook"
    },
    {
      "id": 5,
      "text": "Ménilmontant was annexed to Paris in 1860 during Haussmann’s renovation, shifting from a rural village to an urban quarter.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/M%C3%A9nilmontant"
    },
    {
      "id": 6,
      "text": "The neighborhood’s working‑class roots attracted waves of immigrants, shaping its multicultural character seen today.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/M%C3%A9nilmontant"
