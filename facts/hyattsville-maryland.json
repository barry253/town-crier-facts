  "facts": [
    {
      "id": 1,
      "text": "Hyattsville was founded in 1886, and its historic district contains nearly 1,000 buildings ranging from Victorian homes to Arts and Crafts shops.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hyattsville.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Washington–Baltimore Turnpike opened in 1812, and the B&O Railroad arrived in 1835, turning Hyattsville into a key rail and road hub.",
      "sourceSentenceIds": [
        8,
        14,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyattsville%2C_Maryland",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1908 the Carter Motor Car Corporation built a factory in Hyattsville, producing a hand‑built twin‑engine automobile that was a rarity of its time.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hyattsville.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hyattsville’s historic arcade now houses the Pyramid Atlantic Art Center, a nonprofit that supports local artists in a former commercial building.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyattsville%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s preservation efforts began in the late 1970s, leading to the 1982 National Register listing of the Hyattsville Historic District.",
      "sourceSentenceIds": [
