  "facts": [
    {
      "id": 1,
      "text": "Mosheim was originally called 'Blue Springs' after a spring that flows through the town, settled around 1800.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosheim%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Johann Lorenz von Mosheim, a German Lutheran theologian, after a college founded there in 1872.",
      "sourceSentenceIds": [
        3,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosheim%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mosheim Schoolhouse, now a museum, preserves the town’s educational heritage and stands as a historic landmark.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://greenevilletnfamilypaving.com/exploring-mosheim-tennessee-a-quaint-southern-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Civil War Battle of Blue Springs took place near Mosheim on October 10, 1863, and the town reenacted it yearly until 2008.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosheim%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mosheim sits on the base and southern slopes of Big Ridge, with Mosheim Branch flowing into Little Chucky Creek.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mosheim%2C_Tennessee",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tennessee State Route 348 connects Mosheim with Midway and the rural parts of western Greene County, making it a local artery.",
      "sourceSentenceIds": [
        21
