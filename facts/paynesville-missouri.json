  "facts": [
    {
      "id": 1,
      "text": "Paynesville was founded in 1856, named after early settler E.E. Payne who helped lay out the original town site.",
      "sourceSentenceIds": [
        4,
        17,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.paynesvillearea.com/community/histsociety/50years080900.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town celebrated its first Fourth of July in 1858, even after a heavy frost destroyed the rye crop that same year.",
      "sourceSentenceIds": [
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.paynesvillearea.com/community/histsociety/50years080900.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroad arrival in 1880 spurred the creation of “New Paynesville,” a separate village that later merged with the original town.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.paynesvillearea.com/community/histsociety/50years080900.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Paynesville Historical Society, founded by the local Lion’s Club on October 23, 1969, preserves the town’s artifacts and history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://paynesvillehistorical.org/about-us",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paynesville’s museum hosts a Kids Camp that offers summer history programs for local children.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://paynesvillehistorical.org/about-us",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Between 1856 and 1907, Paynesville expanded from 120 acres to 420 acres, reflecting steady growth over five decades.",
