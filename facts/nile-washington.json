  "facts": [
    {
      "id": 1,
      "text": "Nile earned its name in the 1890s when settlers likened the valley’s lush fertility to Egypt’s Nile River.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Nile%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "James Beck, William Markel, and Henry Sedge were the pioneering families who laid out the community in the mid‑1890s.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nile%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Henry Sedge, born in Ohio in 1855, moved west and helped build Nile’s early irrigation, turning the valley into productive farmland.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nile%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sedge Ridge, a local landmark, stands as a tribute to Henry Sedge and his role in founding the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nile%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Forest Service rangers established a ranger station at Nile Creek, laying groundwork for Eastern Cascades forest management.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nile%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The flat area along Nile Creek, noted by historian Gretta Gossett, remains a quiet reminder of the valley’s agricultural roots.",
