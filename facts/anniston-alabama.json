  "facts": [
    {
      "id": 1,
      "text": "Founded in 1872 by Samuel Noble and Alfred Tyler as a private iron company town, Anniston opened to the public in 1883.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://annistonal.gov/about-anniston/"
    },
    {
      "id": 2,
      "text": "Originally called Woodstock, the town renamed itself Anniston in 1873 to honor Annie Tyler after discovering another Woodstock already existed.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Anniston%2C_Alabama"
    },
    {
      "id": 3,
      "text": "In 1961, a mob bombed a Freedom Riders bus in Anniston, thrusting the city into the national Civil Rights spotlight.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anniston%2C_Alabama"
    },
    {
      "id": 4,
      "text": "President Obama designated the Freedom Riders National Monument at the Anniston site in January 2017, honoring the 1961 tragedy.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anniston%2C_Alabama"
    },
    {
      "id": 5,
      "text": "Anniston houses the Anniston Museum of Natural History and the Berman Museum of World History, preserving regional stories.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Anniston%2C_Alabama"
    },
    {
      "id": 6,
      "text": "Since 1993, the Spirit of Anniston Main Street Program has revitalized downtown, restoring Noble Street’s historic storefronts.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
