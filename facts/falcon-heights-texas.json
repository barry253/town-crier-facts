  "facts": [
    {
      "id": 1,
      "text": "Falcon Heights sprang to life in 1954 when the Falcon Dam was finished, turning the site of the historic Holy Trinity Catholic mission into a new community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/falcon-heights-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits beside the International Falcon Reservoir, where the Falcon Dam’s spillway creates a scenic waterway that connects to Mexico’s Nueva Ciudad Guerrero.",
      "sourceSentenceIds": [
        15,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Falcon_Heights%2C_Texas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 75‑acre Starr County Recreation Park in Falcon Heights offers camping and picnicking, a rare green space in this tight‑knit community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/falcon-heights-tx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "When the dam was completed, the original town area shrank to just 0.1 square miles, all land, making it one of Texas’s smallest incorporated places.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Falcon_Heights%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The town’s name honors the nearby Falcon Dam, a key infrastructure project that helped shape the region’s agricultural and recreational development.",
