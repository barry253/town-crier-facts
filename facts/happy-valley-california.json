      ],
      "source": "https://www.calaverashistory.org/happy-valley",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In September 1848, French miners from the ship Noveau Perseverent worked near Mokelumne Hill, a nearby mining hub.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
