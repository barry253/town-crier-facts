  "facts": [
    {
      "id": 1,
      "text": "Piney was established in 1824 as the head town for the first wave of relocated Cherokee people known as the Old Settlers.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piney%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Piney served as the informal capital and council seat of the Cherokee Nation-West from 1824 to 1828.",
      "sourceSentenceIds": [
        3,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://unitedstatesghosttowns.com/piney-oklahoma-ghost-town/"
    },
    {
      "id": 3,
      "text": "The town of Piney was located on the lands of Lovely's Purchase, straddling the line between Arkansas and the Indian Territory.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Piney%2C_Oklahoma"
    },
    {
      "id": 4,
      "text": "Early family names such as the Adairs, Wrights, and Twists are tied to the history of the original settlement at Piney.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/plan-ghost-town-road-trip-piney-oklahoma/"
    },
    {
      "id": 5,
      "text": "Piney is now considered a ghost town where historical reenactments help bring the Old Settler era into focus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/plan-ghost-town-road-trip-piney-oklahoma/"
    },
    {
      "id": 6,
      "text": "Abandoned mines and underground mining infrastructure remain at Piney as remnants of the area's economic history.",
