  "facts": [
    {
      "id": 1,
      "text": "Goodyear began as a cotton plantation bought by the Goodyear Tire and Rubber Company in 1917 to meet wartime rubber demands.",
      "sourceSentenceIds": [
        1,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.goodyearlivinglocal.com/blog/goodyears-transformation-a-history-of-our-thriving-community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially incorporated in 1946, then renamed Goodyear, and by that time already had 151 homes, a barber shop, and a grocery store.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.goodyearlivinglocal.com/blog/goodyears-transformation-a-history-of-our-thriving-community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1950s, three floods struck Goodyear, but the community rebuilt stronger and never again suffered a major natural disaster.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.goodyearlivinglocal.com/blog/goodyears-transformation-a-history-of-our-thriving-community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The construction of Interstate 10 in the 1960s and 70s turned Goodyear from a quiet farming area into a growing suburban hub near Phoenix.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.goodyearlivinglocal.com/blog/goodyears-transformation-a-history-of-our-thriving-community",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Goodyear’s economy blends healthcare, logistics, retail, and manufacturing, with new opportunities emerging every day.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.goodyearlivinglocal.com/blog/goodyears-transformation-a-history-of-our-thriving-community",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city maintains a commitment to sustainable development, aiming to keep a high quality of life while supporting local businesses and expanding infrastructure.",
      "sourceSentenceIds": [
        24,
        25
      ],
