  "facts": [
    {
      "id": 1,
      "text": "North Middletown was incorporated in 1818; the prefix \"North\" was added to avoid confusion with another Middletown in Kentucky.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Middletown%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s landscape features gently rolling hills and phosphatic limestone soils, supporting thoroughbred horse breeding, cattle, sheep, and bourbon production from over 100 historic distilleries.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_middletown_kentucky",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 18th century, European-American settlers began arriving in the area that would become North Middletown, amid tensions with Native American tribes using the land for hunting.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_middletown_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Lexington and Eastern railroad reached Bourbon County in the 1880s, enabling local tobacco and livestock to be shipped to Lexington and beyond, boosting the region’s economy.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_middletown_kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Martin’s Station, a pioneer outpost near present-day Paris, was captured in 1780 by British Captain Henry Bird and allied Native American warriors, taking over 400 settlers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_middletown_kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A post office has operated in North Middletown since 1819, marking the town’s long-standing role as a local hub.",
      "sourceSentenceIds": [
        12
