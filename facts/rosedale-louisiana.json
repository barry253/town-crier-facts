  "facts": [
    {
      "id": 1,
      "text": "Rosedale got its name in 1815 when English pioneers spotted abundant wild Cherokee roses, inspiring the village’s floral nickname.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rosedale_louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1859 the Louisiana Central Railroad opened a depot in Rosedale, running three trains a week that hauled sugarcane and passengers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rosedale_louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bayou Grosse Tete cuts through Rosedale’s center, its winding path historically serving as a vital waterway for trade and travel.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rosedale_louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Rosedale was officially incorporated in 1955, a milestone that spurred the development of essential infrastructure and modern services.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rosedale_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1997 the village earned the Louisiana Municipal Association’s Community Achievement Award for outstanding improvements in basic services.",
