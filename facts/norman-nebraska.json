      "id": 1,
      "text": "Norman was platted on September 7, 1887, and named after brothers John and Carl Norman who owned the original 80‑acre town site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norman_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around a station on the Burlington and Missouri River Railroad, which spurred early agricultural and commercial activity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norman_nebraska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today, the village’s economy centers on farming and manufacturing, reflecting its rural roots and small‑town character.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norman_nebraska",
      "category": "economy",
      "quality": "good"
    },
    {
