  "facts": [
    {
      "id": 1,
      "text": "Norman was platted on September 7, 1887, and named after brothers John and Carl Norman who owned the original 80‑acre town site.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norman_nebraska"
    },
    {
      "id": 2,
      "text": "The village grew around a station on the Burlington and Missouri River Railroad, which spurred early agricultural and commercial activity.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norman_nebraska"
    },
    {
      "id": 3,
      "text": "Today, the village’s economy centers on farming and manufacturing, reflecting its rural roots and small‑town character.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/norman_nebraska"
    },
    {
      "id": 4,
      "text": "Norman is part of the Kearney, Nebraska Micropolitan Statistical Area, linking it to the regional hub of Kearney.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Norman%2C_Nebraska"
    },
    {
      "id": 5,
      "text": "The village’s town hall serves as the local authority for construction permits and code enforcement, a role highlighted by the city clerk’s office.",
