  "facts": [
    {
      "id": 1,
      "text": "Springfield was founded in 1793 as the county seat, named for the many natural springs that supplied early settlers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Springfield,_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town is the birthplace of Abraham Lincoln’s grandfather, who settled nearby in 1782, linking Springfield to the president’s family roots.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Springfield,_Kentucky",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Lincoln Homestead State Park preserves the cabin of Abraham Lincoln’s ancestor and a pioneer grist mill, a key landmark in the town.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Springfield,_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Washington County Courthouse, built in 1816, showcases Federal‑style architecture and stands on Main Street as a centerpiece of Springfield’s historic core.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Springfield,_Kentucky",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Located along the historic Wilderness Trace, Springfield sits about 15 miles east of Bardstown and 25 miles west of Danville, placing it in Kentucky’s Inner Bluegrass.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
