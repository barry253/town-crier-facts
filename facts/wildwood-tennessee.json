      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wildwood%2C_Tennessee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wildwood’s early history is intertwined with the broader development of the Smoky Mountain foothills, rather than a distinct record.",
      "sourceSentenceIds": [
        1
