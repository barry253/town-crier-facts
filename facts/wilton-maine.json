    {
      "id": 1,
      "text": "Abraham Butterfield paid the cost of incorporation in 1803 to name Wilton after his former residence.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton%2C_Maine"
    },
    {
      "id": 2,
      "text": "Wilton hosts Maine's first cotton mill, started in 1810 by Solomon Adams.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton%2C_Maine"
    },
    {
      "id": 3,
      "text": "Bass shoes, worn by Charles Lindbergh and Admiral Byrd, were made exclusively in Wilton for over a century until 1998.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton%2C_Maine"
    },
    {
      "id": 4,
      "text": "Wilton housed the first toothpick manufacturing mill in Maine, with the Walker Woolen Mill converted to a toothpick mill in 1881.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton%2C_Maine"
    },
    {
      "id": 5,
      "text": "Goodspeed Memorial Library and Bass Boarding House in Wilton are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wilton%2C_Maine"
    },
    {
      "id": 6,
      "text": "Wilton sits beside Wilson Pond, a former mill town now primarily a recreation area, and the pond drains via Wilson Stream into the Sandy River.",
