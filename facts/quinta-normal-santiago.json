  "facts": [
    {
      "id": 1,
      "text": "Quinta Normal Park was founded in 1842 as a scientific experimentation center and later became a botanical garden, one of the first in South America.",
      "sourceSentenceIds": [
        5,
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santiagoturismo.cl/en/parque-quinta-normal-2/"
    },
    {
      "id": 2,
      "text": "The park covers about 40 hectares and earned Nature Sanctuary status in 1976 because of its diverse plant species.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.santiagoturismo.cl/en/parque-quinta-normal-2/"
    },
    {
      "id": 3,
      "text": "A network of museums inside the park includes the Railroad Museum, Museum of Natural History, and Museum of Science and Technology.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santiagoturismo.cl/en/parque-quinta-normal-2/"
    },
    {
      "id": 4,
      "text": "The park’s main entrance sits on Avenida Matucana, where the Santiago Metro’s Quinta Normal station provides easy access.",
      "sourceSentenceIds": [
        3,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.santiagoturismo.cl/en/parque-quinta-normal-2/"
    },
    {
      "id": 5,
      "text": "In 2013, Travel + Leisure named Quinta Normal one of the world’s most beautiful parks, highlighting its cultural events and lagoon.",
      "sourceSentenceIds": [
        21,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.santiagoturismo.cl/en/parque-quinta-normal-2/"
    },
    {
      "id": 6,
      "text": "Designed by French naturalist Claudio Gay, the park was originally called Quinta Normal de Agricultura, reflecting its role in acclimating foreign trees.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
