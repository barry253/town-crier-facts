      "id": 1,
      "text": "Glencoe was founded by William Henry Coe, a Connecticut pioneer who moved south in 1874 for health reasons.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glencoe_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 19th century, Glencoe became a railroad stop between Blue Spring and New Smyrna Beach, linking it to regional trade.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glencoe_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Glencoe‑Geiger Cemetery preserves the town’s pioneer heritage, marking the resting place of early settlers.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glencoe_florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A one‑room schoolhouse opened in 1887, serving grades 1‑8 and signaling Glencoe’s move toward structured education.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/glencoe_florida",
      "category": "history",
      "quality": "good"
    },
    {
