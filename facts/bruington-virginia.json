      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bruington Baptist Church, founded in 1790, anchors the crossroads settlement and was led by Reverend Robert Baylor Semple until 1831.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Web source 2",
