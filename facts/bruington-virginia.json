  "facts": [
    {
      "id": 2,
      "text": "The Bruington Rural Historic District covers 2,918 acres and was added to the Virginia Landmarks Register in 2018 and the National Register of Historic Places in 2019.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bruington_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bruington Baptist Church, founded in 1790, anchors the crossroads settlement and was led by Reverend Robert Baylor Semple until 1831.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bruington_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Captain Whittaker Campbell established the Brewington plantation in the mid‑18th century, operating a subsistence farm that listed 5–10 enslaved tithables in 1782‑86.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bruington_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bruington’s proximity to the Rappahannock River creates fertile soils and wetlands that support deer, turkey, and diverse bird species.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bruington_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the Civil War, many Bruington farmers joined the Grange to learn new farming practices, reflecting a shift in labor and commerce.",
