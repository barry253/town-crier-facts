  "facts": [
    {
      "id": 1,
      "text": "Harwinton’s name blends Hartford and Windsor, plus the suffix –ton, meaning town, a nod to its early colonial roots.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harwinton%2C_Connecticut",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was incorporated as an independent entity in October 1737, after settlers first arrived in January 1730.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Harwinton%2C_Connecticut",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Agriculture shaped Harwinton’s early economy, with farms spurring related industries that kept the town thriving for centuries.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.harwinton.gov/214/Harwinton-History",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A local philanthropist’s trust funded the town’s first library, establishing a lasting center for learning and community gathering.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.harwinton.gov/214/Harwinton-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Harwinton Historical Society restored a one‑room schoolhouse and barn museum, now used to showcase early life and artifacts.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.harwinton.gov/214/Harwinton-History",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The southeastern part of Harwinton hosts the Roraback Wildlife Area, offering trails and reservoirs for outdoor enthusiasts.",
