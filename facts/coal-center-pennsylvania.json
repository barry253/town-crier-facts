  "facts": [
    {
      "id": 1,
      "text": "Coal Center began as Greenfield in 1814, was incorporated in 1834, and adopted its coal‑centered name in 1883 after the mining boom.",
      "sourceSentenceIds": [
        13,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coal_Center%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough sits on the Monongahela River, directly across from Newell, and has been part of the Pittsburgh metropolitan area since 1950.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coal_Center%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old coal‑mining buildings and riverfront structures still line the streets, echoing the town’s industrial past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://pennsylvaniainfo.blog/coal-center-pennsylvania-hidden-gems",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Coal Center’s compact size is offset by its rich western Pennsylvania heritage and easy access to the Monongahela River for recreation.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://monrivertowns.com/towns/coal-center/",
      "category": "culture",
      "quality": "good"
    },
    {
