  "facts": [
    {
      "id": 1,
      "text": "Nanuet got its name in 1856 when Munsee Chief Nannawitt’s original designation, Clarkstown, was changed at James De Clark’s suggestion.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nanuetchamber.com/about-nanuet/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The New Jersey & New York Railroad arrived in Nanuet in 1869, later becoming the Pascack Valley Line that still serves the town.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nanuet%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Shops at Nanuet, an outdoor mall opened in 1969 and rebranded in 2013, is operated by Simon Property Group.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nanuet%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nanuet station ranks as the second‑to‑last stop on New Jersey Transit’s Pascack Valley Line, connecting to Hoboken Terminal.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nanuet%2C_New_York",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "As the third‑largest hamlet in Clarkstown, Nanuet sits north of Pearl River, south of New City, east of Spring Valley, and west of West Nyack.",
