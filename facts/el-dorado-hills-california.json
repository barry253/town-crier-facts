  "facts": [
    {
      "id": 1,
      "text": "El Dorado Hills was conceived by Sacramento developer Alan Lindsey in the late 1950s and officially incorporated as a master‑planned community in the early 1960s.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.californiahistorian.com/el_dorado_hills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name echoes the California Gold Rush, where gold washed down the South Fork of the American River into the area that is now El Dorado Hills.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Dorado_Hills%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Portions of two Pony Express routes from 1860‑61 still exist as modern streets in El Dorado Hills, linking the town to its frontier past.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Dorado_Hills%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original master plan, drafted by architect Victor Gruen, envisioned a network of residential “villages” surrounded by open space and an 18‑hole golf course.",
      "sourceSentenceIds": [
        21,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/El_Dorado_Hills%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "El Dorado Hills hosts the historic Mormon Tavern, built in 1849, which once served as a hotel, restaurant, saloon, dance hall and Pony Express exchange station.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
