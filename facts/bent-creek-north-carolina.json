  "facts": [
    {
      "id": 1,
      "text": "Bent Creek is an unincorporated community in southwestern Buncombe County defined by its proximity to protected forest land, established residential neighborhoods, and direct access to Asheville’s southwest corridors.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebestofbuncombe.com/bent-creek-nc",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community developed alongside one of the largest protected forest areas in Buncombe County, creating a place where homes sit on wooded lots and conservation land is preserved.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebestofbuncombe.com/bent-creek-nc",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bent Creek’s low‑density development and strong emphasis on land preservation keep the area quiet and residential, with minimal commercial zoning.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thebestofbuncombe.com/bent-creek-nc",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Bent Creek is a census‑designated place that has no governmental functions, reflecting its status as a statistical entity rather than a legal municipality.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
