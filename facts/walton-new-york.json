  "facts": [
    {
      "id": 1,
      "text": "Walton was formed in 1797, carved out of the older town of Franklin, marking its official birth in the late 18th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walton_(town)%2C_New_York"
    },
    {
      "id": 2,
      "text": "The town proudly calls itself the \"Scarecrow Capital of the World,\" a quirky title that reflects its long‑standing agricultural heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walton_(town)%2C_New_York"
    },
    {
      "id": 3,
      "text": "Settlers first arrived in 1785, establishing the original village that would later become the heart of Walton.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walton_(town)%2C_New_York"
    },
    {
      "id": 4,
      "text": "Walton sits on both sides of the West Branch Delaware River, a waterway that has shaped its landscape and history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walton_(town)%2C_New_York"
    },
    {
      "id": 5,
      "text": "Before the late 1700s, the Lenape Nation used these lands as hunting grounds, long before European settlers arrived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofwaltonny.gov/about/history/"
    },
    {
      "id": 6,
      "text": "The village of Walton lies within the town’s borders, serving as the central hub for local residents and visitors alike.",
