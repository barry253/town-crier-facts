      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mountain House Creek flows from south of Altamont Pass, crossing under I‑580 before meeting Mountain House Road at the historic Alameda County stop.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
