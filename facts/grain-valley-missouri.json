  "facts": [
    {
      "id": 1,
      "text": "Grain Valley sprang up in 1878 when former Pink Hill and Stoney Point residents moved west after the Chicago‑Alton Railroad cut through the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
