  "facts": [
    {
      "id": 1,
      "text": "Brice Prairie is named after pioneer farmers Alexander and Lucy Brice, who settled in the area in 1855.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brice_Prairie%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Alexander Brice, one of the area's early settlers, was a United States veteran of the War of 1812.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brice_Prairie%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "Brice Prairie sits on the east bank of the Mississippi River waterway system, bordering Lake Onalaska and the Black River.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brice_Prairie%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Great River State Bike Trail runs through Brice Prairie, alongside the Midway Railroad Prairie State Natural Area.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brice_Prairie%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Brice Prairie hosts an outdoor music festival called Rockin' the Prairie every fourth Saturday in August.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brice_Prairie%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Upper Brice Prairie Landing and Mosey Landing provide water access to the Mississippi River and Lake Onalaska.",
