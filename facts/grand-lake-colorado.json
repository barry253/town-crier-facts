  "facts": [
    {
      "id": 1,
      "text": "Grand Lake began as an outfitting point for the mining towns of Lulu City, Teller City, and Gaskill before becoming the western gateway to Rocky Mountain National Park.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Lake%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "At 8,369 feet high, Grand Lake earned its name from the largest natural lake in Colorado that sits on its shore.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Lake%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Grand Lake Area Historical Society bought the only pre‑20th‑century log hotel in town in 1973 and turned it into a museum.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Lake%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Grand Lake served as Grand County’s seat of government from 1882 until 1888.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Lake%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Kauffman House, a rustic log hotel built in 1892, operated until 1946 and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grand_Lake%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Grand Lake marks the western entrance to Rocky Mountain National Park, surrounded by the park on three sides.",
