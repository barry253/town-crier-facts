  "facts": [
    {
      "id": 1,
      "text": "Indian Wells began as a Cahuilla village around a hand‑dug well noted in 1823 expedition diaries.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Indian_Wells,_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1870 County Well became the valley’s main water source for four decades, supporting Bradshaw Stages and later Wells Fargo.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Indian_Wells,_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After Bradshaw Stages abandoned the route in 1875, Wells Fargo reactivated it in 1876 as the Southern Pacific Railroad expanded.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Indian_Wells%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indian Wells incorporated in 1967, a vote that set a California record for voter turnout.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofindianwells.org/our-city/about/visiting-the-desert/history-of-indian-wells",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city annexed 387 acres in the late 1990s, allowing major tennis facilities to relocate from local resorts.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Indian_Wells,_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The Indian Wells Masters, held at the Indian Wells Tennis Garden, ranks as the world’s sixth‑largest tennis tournament.",
