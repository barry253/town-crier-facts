  "facts": [
    {
      "id": 1,
      "text": "Unionville first settled 50 years before the Revolution, but it only adopted its name in the early 1820s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.unionvilleny.org/Site/Home.html"
    },
    {
      "id": 2,
      "text": "The village sits snugly between NY Route 284 and the Appalachian Trail on Orange County’s southwestern edge.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.unionvilleny.org/Site/Home.html"
    },
    {
      "id": 3,
      "text": "After 48 years of growth, Unionville officially incorporated on August 22, 1871.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.unionvilleny.org/Site/Home.html"
    },
    {
      "id": 4,
      "text": "Once a bustling hub for Minisink’s dairy industry, Unionville was bypassed by mid‑20th‑century transportation booms.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.unionvilleny.org/Site/Home.html"
    },
    {
      "id": 5,
      "text": "Today the village thrives as a quiet bedroom community, offering a peaceful retreat close to larger commercial centers.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.unionvilleny.org/Site/Home.html"
    },
    {
      "id": 6,
      "text": "Unionville shares a common border with the Town of Wantage in northwestern New Jersey.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
