  "facts": [
    {
      "id": 1,
      "text": "Dublin was officially incorporated as a borough in 1912 after earlier attempts in 1832 and 1841 failed to establish it as a township.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dublin%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened on April 18, 1827, with Newton Rowland as postmaster, before mail was delivered from Doylestown and Hilltown.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dublin%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dublin sits on Route 313, a historic crossroads between Doylestown and Quakertown that has guided travelers for centuries.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dublinborough.org/history.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three properties in Dublin are designated Bucks Historic Sites by the Heritage Conservancy, highlighting the town’s rich architectural legacy.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://dublinborough.org/history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Buck House, a National Historic Landmark, now serves as a museum showcasing Dublin’s local history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitbuckscounty.com/towns-main-streets/dublin-sellersville-perkasie/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former 1930s gas station, The Station, has been transformed into a food hall offering wood‑fired pizza, Mexican cuisine, and local brews.",
