  "facts": [
    {
      "id": 1,
      "text": "Selawik comes from the Inupiaq word 'siiḷivik', meaning 'place of sheefish', reflecting the area's rich fishing heritage.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Selawik%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Russian explorer Lavrenty Zagoskin first recorded the settlement as 'Chilivik' between 1842 and 1844.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/selawik/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indigenous people historically built semi‑subterranean sod houses in Selawik to retain heat, though only archaeological evidence remains today.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/selawik/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Selawik formally incorporated as a city in 1963, marking its transition from a traditional settlement to an organized municipality.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Selawik%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today Selawik has grown across the Selawik River onto three banks, connected by bridges that link the community.",
