  "facts": [
    {
      "id": 1,
      "text": "Charlottenburg was founded as a town in 1705 and named after Queen Sophia Charlotte of Hanover.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlottenburg",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The largest surviving royal palace in Berlin, Charlottenburg Palace, sits in the district and houses adjacent museums.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlottenburg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Kaiser Wilhelm Memorial Church on Breitscheidplatz, built in 1895 and rebuilt in 1961, is a landmark in Charlottenburg.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlottenburg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Charlottenburg’s historic core, the former village green of Alt Lietzow, lies on the southern shore of the Spree River.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlottenburg",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Museum Berggruen, a modern art museum in the former Gardes du Corps barracks at Charlottenburg Palace, attracts visitors.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Charlottenburg",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Charlottenburg was incorporated into Greater Berlin in 1920, ending its status as an independent city.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
