  "facts": [
    {
      "id": 1,
      "text": "Long before Europeans arrived in the 16th century, the Timucua people inhabited the area that is now Liberty Triangle, Florida.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_triangle_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Liberty Triangle sits within the Withlacoochee River watershed, supporting habitats for wading birds and amphibians.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_triangle_florida",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Through the mid‑20th century, Liberty Triangle remained a rural landscape of small farms, timber, citrus, and railroad‑linked trade.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_triangle_florida",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "State Road 200 borders Liberty Triangle to the west, Interstate 75 to the east, and the Cross Florida Greenway lies to its south.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_triangle_florida",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Liberty Triangle enjoys a humid subtropical climate, with July highs around 91°F and January lows near 42°F.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/liberty_triangle_florida",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "Despite an average elevation of about 66 feet, Liberty Triangle faces flash flooding during intense storms, especially near low‑lying wetlands.",
      "sourceSentenceIds": [
        28,
