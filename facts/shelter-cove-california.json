      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, abundant tanbark trees made Shelter Cove a thriving timber hub, but by the 1920s the forest was gone.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
