  "facts": [
    {
      "id": 1,
      "text": "Downtown Newton’s historic core is anchored by the 1924 Catawba County Courthouse, now home to the History Museum of Catawba County.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.downtownnewton.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Newton serves as the county seat of Catawba County, a role it has held since the town’s early days.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newton%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Established in 1845 and incorporated a decade later in 1855, Newton grew from a modest settlement into a thriving city.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newton%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Downtown Newton welcomes visitors as a gateway to the foothills of the Blue Ridge Mountains, where arts and entrepreneurship flourish.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.downtownnewton.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Catawba County Museum of History, housed in the historic Stout building, showcases the region’s rich heritage.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Newton%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Geographically, Newton sits at the heart of Catawba County, making it a natural hub for the surrounding communities.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
