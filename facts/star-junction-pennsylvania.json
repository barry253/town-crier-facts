      "id": 1,
      "text": "Star Junction was founded in 1893 as the terminus of the Washington Run Railroad.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Star_Junction%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Star Junction once housed a coal mining center with beehive ovens for coke manufacture and a foundry.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Star_Junction%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1922, 4,500 miners walked out, marking a major labor unrest event.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Star_Junction%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The company store and mines are gone, but the patch of company houses still remains and houses many residents.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Star_Junction%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Star Junction lies on Pennsylvania Route 51, 2 miles north to Perryopolis and 13 miles south to Uniontown.",
