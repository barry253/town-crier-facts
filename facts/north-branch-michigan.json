  "facts": [
    {
      "id": 1,
      "text": "North Branch was renamed from Beachville in 1878 to honor the north branch of the Flint River that winds through town.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/07/11/history-of-north-branch-michigan/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s oldest bank, built in 1885 and rebuilt in 1906, is a Renaissance Revival building and a Michigan State Historic Site.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/07/11/history-of-north-branch-michigan/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Two major fires in the early 20th century reshaped North Branch’s downtown, prompting rebuilding that still echoes in its historic streets.",
      "sourceSentenceIds": [
        7,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Branch%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Orr Historical Museum, housed in a former bank building, showcases rare photographs and artifacts that bring North Branch’s resilient past to life.",
      "sourceSentenceIds": [
        6,
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/07/11/history-of-north-branch-michigan/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Grand Trunk Railroad’s station once served as the town’s main artery, linking North Branch to regional trade and travel.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://thumbwind.com/2025/07/11/history-of-north-branch-michigan/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Huron Street, originally the main east‑west thoroughfare, anchors the village’s layout and remains the heart of local commerce.",
      "sourceSentenceIds": [
        5,
