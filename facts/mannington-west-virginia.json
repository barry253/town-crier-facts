  "facts": [
    {
      "id": 1,
      "text": "Mannington was renamed in 1856 after Charles Manning, a civil engineer for the B&O Railroad.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mannington%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The town’s early name was Forks of Buffalo, later Koon Town, before adopting Mannington.",
      "sourceSentenceIds": [
        8,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wvencyclopedia.org/entries/1437"
    },
    {
      "id": 3,
      "text": "During the Civil War, Confederate forces burned two B&O bridges near Mannington, sparking Virginia’s invasion.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/mannington-west-virginia"
    },
    {
      "id": 4,
      "text": "The Wilson School, built in 1919, now houses the West Augusta Historical Society Museum.",
