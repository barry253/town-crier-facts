  "facts": [
    {
      "id": 1,
      "text": "Wells Tannery got its name from a steam‑powered tannery built in 1855 by Lyon and Patterson, using local hemlock bark.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wells_tannery_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lumbering was an early industry, and a short‑lived logging railroad once ran from Wells Valley to the Broad Top Coal Field.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.huntingdondailynews.com/news/echoes/tracing-roots-of-the-rural-community-of-wells-tannery/article_b3d31af5-71f6-5af4-ac22-743e591fce2f.html",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wells Valley was part of the unsettled frontier during Pennsylvania’s proprietary period, with land grants issued in the mid‑18th century to spur settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wells_tannery_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "State Game Lands 53 and 128 surround the area, protecting over 7,000 acres of forest and wildlife like white‑tailed deer and wild turkeys.",
