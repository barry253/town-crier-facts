      "id": 1,
      "text": "Novinger was founded in 1878 by John C., who filed the town plat and opened the first coal mine in 1883.",
      "sourceSentenceIds": [
        1,
        3,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
