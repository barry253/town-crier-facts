      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Maricopa Peak, Goat Hill, and Mount Suppoa rise to 2,523, 2,526, and 2,690 feet respectively, forming the range’s highest points.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
