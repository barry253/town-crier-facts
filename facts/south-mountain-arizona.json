      ],
      "source": "https://en.wikipedia.org/wiki/South_Mountains_(Arizona)",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The summit of Mount Suppoa hosts more than 30 communications towers, including those of ABC, CBS, FOX and NBC.",
      "sourceSentenceIds": [
