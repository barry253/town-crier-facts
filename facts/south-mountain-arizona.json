      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "South Mountain Park and Preserve spans over 16,000 acres, making it the second largest municipal park in Arizona and the 13th largest worldwide.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
