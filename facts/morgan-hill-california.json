  "facts": [
    {
      "id": 1,
      "text": "Morgan Hill’s oldest winery, Malaguerra, opened in 1869 and still operates today as the oldest extant winery in Santa Clara Valley.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morgan_Hill%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1875, bandit Tiburcio Vásquez robbed the 21‑Mile House, and the nearby Vásquez Oak still stands in his honor.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morgan_Hill%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name comes from Hiram Morgan Hill, who in 1845 acquired the land as Rancho Ojo del Agua de la Coche.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morgan_Hill%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Morgan Hill enjoys a mild Mediterranean climate, thanks to the moderating influence of the Pacific Ocean.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morgan_Hill%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city sits inside the Santa Clara Valley AVA, a designated American Viticultural Area that includes wineries from Saratoga to Gilroy.",
