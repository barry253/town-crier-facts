  "facts": [
    {
      "id": 1,
      "text": "Avon's original name, Kinnakeet, comes from an Algonquin word meaning \"that which is mixed,\" reflecting the early blend of Native tribes and English settlers.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.outerbanks.org/plan-your-trip/explore/towns-and-villages/avon/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Little Kinnakeet Life‑Saving Station, built in 1874, served as a Coast Guard outpost until 1954 and now sits within the Cape Hatteras National Seashore.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avon%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Avon sits on Hatteras Island, bordered east by the Atlantic Ocean and west by Pamlico Sound, making it a true barrier island community.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Avon%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cedar and live oak trees around Avon supplied the timber that powered the village’s historic boat‑building industry from colonial times through the post‑Civil War era.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.outerbanks.org/plan-your-trip/explore/towns-and-villages/avon/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just north of Avon, the Cape Hatteras Lighthouse stands as a sentinel on the Outer Banks, guarding the coast for more than a century.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
