    {
      "id": 1,
      "text": "Mescalero was originally called Blazer's Mill and was the site of a famous gunfight during the Lincoln County War.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mescalero%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Mescalero Apache Tribe’s name comes from the mescal plant they gathered and ate, a staple that sustained them in good times and bad.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mescaleroapachetribe.com/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The tribe’s history is marked by expert guerrilla warfare and skilled horsemen, traits that earned them a reputation across the Southwest.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mescaleroapachetribe.com/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Mescalero hosts the Inn of the Mountain Gods Resort & Casino and Ski Apache Ski Resort, both operated by the tribe on reservation land.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mescaleroapachetribe.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The reservation’s mountainous terrain offers outdoor adventures, including winter slopes at Ski Apache, drawing enthusiasts to the area.",
