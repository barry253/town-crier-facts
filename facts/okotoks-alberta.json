  "facts": [
    {
      "id": 1,
      "text": "Okotoks takes its name from the Blackfoot word 'ohkotok', meaning rock, a nod to the giant glacial erratic that sits nearby.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Okotoks"
    },
    {
      "id": 2,
      "text": "Before rail, Okotoks was a busy river crossing on the Macleod Trail, where stagecoaches stopped at two houses for travelers.",
      "sourceSentenceIds": [
        17,
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Okotoks"
    },
    {
      "id": 3,
      "text": "In 2005, the Sheep River flooded much of Okotoks’ downtown, briefly submerging shops and parks along the riverbank.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Okotoks"
    },
    {
      "id": 4,
      "text": "Today, Okotoks serves as a bedroom community for Calgary, drawing commuters who enjoy the town’s historic charm.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Okotoks"
    },
    {
      "id": 5,
      "text": "Visitors can explore the Okotoks Art Gallery at the Station and the Museum at Heritage House, both housed in historic buildings.",
