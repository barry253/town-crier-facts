      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hemet%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hemet has earned Tree City USA status for 20 consecutive years, underscoring its dedication to local forests.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hemet%2C_California",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Hemet Maze Stone, a prehistoric petroglyph carved into a large boulder, is a unique landmark in the city.",
