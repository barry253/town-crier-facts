  "facts": [
    {
      "id": 1,
      "text": "Tribbey is a town in Pottawatomie County, Oklahoma, and was named for Alpheus M. Tribbey.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tribbey%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Alpheus M. Tribbey staked a claim here when several tribal lands opened for settlement on September 22, 1891.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TR012"
    },
    {
      "id": 3,
      "text": "Tribbey served as a shipping center for cotton until the market declined in the early 1920s due to boll weevils.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TR012"
    },
    {
      "id": 4,
      "text": "Service Pipeline built a pumping station in Tribbey in 1919, which was later replaced by an electronic system in 1961.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TR012"
    },
    {
      "id": 5,
      "text": "The Santa Fe Depot in Tribbey was built in 1905 and later housed Sandmans' Café and Gas Station.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=TR012"
    },
    {
      "id": 6,
      "text": "Tribbey is an old community that appeared on a Rand McNally map of the county as early as 1911.",
      "sourceSentenceIds": [
        19
      ],
