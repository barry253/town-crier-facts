  "facts": [
    {
      "id": 1,
      "text": "Hubbard was named after Nehemiah Hubbard, Jr., a Connecticut Land Company agent who helped settle the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubbard%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first settlers arrived in 1801 when Samuel Tylee, also from Middletown, Connecticut, cleared the forest for farming.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubbard%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in Hubbard in 1826, marking the town’s emergence as a local hub.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubbard%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1861, coal and iron mining spurred rapid growth, turning Hubbard from a small village into an industrial community.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubbard%2C_Ohio",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hubbard sits within the Youngstown–Warren metropolitan area, making it a suburb of the larger Rust Belt region.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubbard%2C_Ohio",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The city originated from Hubbard Township, itself carved out of the Connecticut Western Reserve in the early 1800s.",
      "sourceSentenceIds": [
        4
