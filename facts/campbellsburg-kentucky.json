      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Louisville, Cincinnati and Lexington Railroad’s arrival in 1869 split the town into Old Campbellsburg and a new settlement east of the original.",
      "sourceSentenceIds": [
        7,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbellsburg%2C_Kentucky",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Campbellsburg is a home rule‑class city in Henry County, giving it local governance autonomy.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Campbellsburg%2C_Kentucky",
