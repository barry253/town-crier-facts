  "facts": [
    {
      "id": 1,
      "text": "New Richmond was founded on the Ohio River in September 1814 by Revolutionary War hero Jacob Light, who named it after his hometown of Richmond, Virginia.",
      "sourceSentenceIds": [
        1,
        25
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://newrichmond.org/history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1817 the Ohio General Assembly moved Clermont County’s seat to New Richmond, but a courthouse never materialized there, and the seat was later relocated to Batavia.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Richmond%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "New Richmond once boasted a thriving river trade, with steamboats bringing commerce and the village becoming known as Cincinnati’s garden for its abundant produce.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://discoverclermont.com/things-to-do/historic-sites/history-museum-passport/historic-new-richmond/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village played a key role in the Underground Railroad, serving as a hotbed of abolitionist activity across the Ohio River from Kentucky.",
      "sourceSentenceIds": [
        11,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://newrichmond.org/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Richmond is home to the world’s only Cardboard Boat Museum, celebrating the annual RiverDays Festival’s famous cardboard boat regatta.",
      "sourceSentenceIds": [
        17,
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://discoverclermont.com/things-to-do/historic-sites/history-museum-passport/historic-new-richmond/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Ross Gowdy House Museum in New Richmond preserves the life of a 19th‑century pioneer who helped shape the village’s early industrial boom.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
