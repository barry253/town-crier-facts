  "facts": [
    {
      "id": 1,
      "text": "Paju sits just south of the 38th parallel, overlooking the Imjin River and the DMZ, making it a frontline city in Korean history.",
      "sourceSentenceIds": [
        20,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paju",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Imjingak Peace Park, located at 164 Imjingak-ro, was built to honor the hope for peace and reunification after the Korean War.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://interestingkorea.com/must-do-things-in-paju-a-natural-cultural-and-historic-treasure-of-south-korea/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dorasan Station, opened in 2002 as the northernmost South Korean railway station, sits on the Gyeongui Line and offers a glimpse of the future of Korean reunification.",
      "sourceSentenceIds": [
        13,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Paju",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Heyri Art Valley, a cultural hub in Paju, hosts galleries, museums, and a unique book café, attracting artists and visitors alike.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.namu.wiki/w/%ED%8C%8C%EC%A3%BC%EC%8B%9C/%EA%B4%80%EA%B4%91",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Paju Book City, a dedicated literary complex, houses thousands of publishing houses and is a cornerstone of South Korea’s book industry.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.namu.wiki/w/%ED%8C%8C%EC%A3%BC%EC%8B%9C/%EA%B4%80%EA%B4%91",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1997, Paju transitioned from a county to a city, reflecting its rapid growth and strategic importance near Seoul.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
