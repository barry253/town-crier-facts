  "facts": [
    {
      "id": 1,
      "text": "Cataula’s name comes from the Muscogee word kitali, meaning \"withered mulberry\".",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cataula%2C_Georgia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Georgia’s first narrow‑gauge railroad, the North & South Railroad, crossed Cataula in 1870, sparking a brief boom.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vanishinggeorgia.com/category/harris-county-ga/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1958 historical marker at Kingsboro notes that the town is just three miles from Cataula.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.georgiahistory.com/ghmi_marker_updated/kingsboro-cataula/",
