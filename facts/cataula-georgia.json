      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 4,
      "text": "The two‑story building on Main Street was once a Woodmen of the World Lodge before becoming Cataula’s old post office.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vanishinggeorgia.com/category/harris-county-ga/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clowers Methodist Church, originally called Providence, was built of logs by Thomas Clowers in 1829.",
