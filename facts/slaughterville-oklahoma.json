  "facts": [
    {
      "id": 1,
      "text": "Slaughterville was named after a grocery store run by James Slaughter in the early twentieth century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slaughterville%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The site of Slaughterville was located in the Unassigned Lands of Indian Territory before the Land Run of 1889.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slaughterville%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Slaughterville incorporated as a town in 1970 to avoid being annexed by the nearby cities of Norman, Noble, or Lexington.",
      "sourceSentenceIds": [
        8,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.town.slaughterville.ok.us/1222/History-of-Slaughterville"
    },
    {
      "id": 4,
      "text": "Much of the area around Slaughterville is wooded and offers a natural scenic outdoor appeal to residents and visitors.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slaughterville%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "Slaughterville has retained a rural type of land use, consisting mostly of homes on large acreages.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Slaughterville%2C_Oklahoma"
    },
    {
      "id": 6,
      "text": "The first building in the Slaughterville area was erected in 1889, the same year the land opened for settlement.",
