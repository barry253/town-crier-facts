      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Aztec Mill, built in 1864 by Lucien Maxwell, now houses the Old Mill Museum run by the Cimarron Historical Society.",
      "sourceSentenceIds": [
        24,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
