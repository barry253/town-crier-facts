    {
      "id": 1,
      "text": "Arlington Heights was incorporated in 1889, originally called Arlington before adding Heights to avoid duplication with another Ohio town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ahohio.org/government/our-history.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s historic museum sits on a campus that preserves the Müller and Banta Houses, a Coach House, and a former Soda Pop Factory.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ahpd.org/arlington-heights-historical-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Arlington School, built in 1932, was a fully equipped facility that cost about $19,000 at the time.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ahohio.org/government/our-history.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Faith Community Church, founded in 1937, added a long‑standing spiritual home to the village’s early 20th‑century growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ahohio.org/government/our-history.html",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Arlington Heights Historical Museum’s mission is to inspire curiosity and connection by showcasing local history in a dynamic, engaging space.",
