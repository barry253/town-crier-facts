      ],
      "source": "https://hiddensandiego.com/things-to-do/places/harmony-grove",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before becoming a residential community, the area supported two egg ranches, a dairy, avocado and citrus groves, and an abandoned rock quarry.",
      "sourceSentenceIds": [
