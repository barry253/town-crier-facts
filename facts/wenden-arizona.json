      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Wenden hosts the 675‑mile Arizona Peace Trail, the largest off‑highway vehicle loop in the U.S., winding through surrounding desert.",
      "sourceSentenceIds": [
        18
