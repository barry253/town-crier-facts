  "facts": [
    {
      "id": 1,
      "text": "Founded in 1818 where the Dan and Roanoke Rivers meet, Clarksville grew around a strategic river confluence.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/192-0121/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from founder Clark Royster, who established the settlement in the early 19th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clarksville is Virginia’s only lakeside town, perched on the shores of Buggs Island Lake, also known as Kerr Lake.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Clarksville Historic District, the town’s core, earned National Register status in 2002 for its well-preserved 18th‑to‑20th‑century architecture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/192-0121/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the early 20th century, the Roanoke Valley Railroad linked Clarksville to Manson, North Carolina, boosting regional trade.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Virginia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Each July, the Virginia Lake Festival attracts roughly 80,000 visitors to Clarksville’s lakefront, culminating in a fireworks finale.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
