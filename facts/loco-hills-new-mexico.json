  "facts": [
    {
      "id": 1,
      "text": "The name 'Loco Hills' comes from Spanish 'loco', meaning 'crazy', a nod to the shifting low sand dunes that define the area.",
      "sourceSentenceIds": [
        1,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loco_hills_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Loco Hills sits on the Mescalero Plain, a gently undulating expanse of wind‑deposited sands and low dunes that stabilize the desert landscape.",
      "sourceSentenceIds": [
        20,
        21,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loco_hills_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The climate is semi‑arid, with hot summers, mild winters, and about 14 inches of rain each year, mostly from summer thunderstorms.",
      "sourceSentenceIds": [
        2,
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loco_hills_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Loco Hills oil field, discovered in 1939, initially produced 560 barrels per day and by 1976 had yielded over 41 million barrels.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loco_hills_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Oil and gas dominate the local economy, employing more than half of the 61 residents and supporting ancillary services like lodging and food.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/loco_hills_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After cattle drives in 1866, early settlers began ranching and farming on the Pecos Valley grasslands, despite isolation and occasional conflicts.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
