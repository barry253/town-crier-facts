  "facts": [
    {
      "id": 1,
      "text": "Founded in 1829 and named for settler Raymond Robinson, the town grew into a judicial hub crowned by its Greek Revival courthouse built between 1857 and 1859.",
      "sourceSentenceIds": [
        1,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Raymond,_Mississippi"
    },
    {
      "id": 2,
      "text": "The Hinds County Courthouse, still in use today, exemplifies Greek Revival architecture and has served Raymond’s legal needs since its completion in 1859.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raymond%2C_Mississippi"
    },
    {
      "id": 3,
      "text": "Raymond earned its city charter on December 15, 1830, becoming one of Mississippi’s two county seats alongside Jackson.",
      "sourceSentenceIds": [
        17,
        25
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/Raymond,_Mississippi"
    },
    {
      "id": 4,
      "text": "The town sits on a ridge a mile from the county’s center, chosen to avoid the flooding that plagued the original low‑lying site.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raymond%2C_Mississippi"
    },
    {
      "id": 5,
      "text": "Raymond hosts the main campus of Hinds Community College, linking the town to regional higher education.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Raymond%2C_Mississippi"
    },
    {
      "id": 6,
      "text": "Governor John Bell Williams, who led Mississippi from 1968 to 1972, was born in Raymond.",
      "sourceSentenceIds": [
        16
      ],
