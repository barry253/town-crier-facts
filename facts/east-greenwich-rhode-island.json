  "facts": [
    {
      "id": 1,
      "text": "East Greenwich was founded in October 1677 by the General Assembly to secure land claims against Connecticut and the Narragansett Proprietors.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Greenwich%2C_Rhode_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Greenwich County, Kent, England, and it was once called “Green Town.”.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.mainstreeteg.org/eg-history/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1686 the town briefly became Dedford before reverting to East Greenwich in 1689.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Greenwich%2C_Rhode_Island",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic courthouse, now the town hall, is one of Rhode Island’s few surviving Federal‑Georgian buildings and is listed on the National Register.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.eastgreenwichri.gov/195/About-East-Greenwich",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The East Greenwich Free Library, built of Coventry granite and dedicated in 1915, houses special collections on Rhode Island history and genealogy.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/East_Greenwich%2C_Rhode_Island",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1741 the western three‑quarters of the town split off to form West Greenwich, leaving East Greenwich as the remaining quarter.",
      "sourceSentenceIds": [
        20,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
