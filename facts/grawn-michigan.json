  "facts": [
    {
      "id": 1,
      "text": "Grawn began as Blackwood in the 1870s, founded by James Blackwood who platted the town in Blair Township.",
      "sourceSentenceIds": [
        4,
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Grawn%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago and West Michigan Railway arrived in 1890, and the station was christened Grawn Station, later shortened to Grawn when the post office opened.",
      "sourceSentenceIds": [
        1,
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Grawn%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Grawn’s name honors professor Charles Grawn, a former superintendent of Central Michigan Normal School and later Traverse City Area Public Schools.",
      "sourceSentenceIds": [
        13,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Grawn%2C_Michigan",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "By 1905 potatoes had become Grawn’s main crop, making the village a notable potato producer in the region.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grawn%2C_Michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 2020s the old Grawn hotel, once a bustling business hub, still stands at the end of State and Brooks streets, a relic of the town’s heyday.",
      "sourceSentenceIds": [
        10
      ],
