      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Batchtown%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Grand Army of the Republic set up a post in Batchtown, and the first Methodist Church was established.",
      "sourceSentenceIds": [
