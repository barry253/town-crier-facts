      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "William Batchelder ran a corn mill in Batchtown, later converting it into a flour mill.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Batchtown%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened in 1879, solidifying Batchtown's official name and encouraging growth.",
      "sourceSentenceIds": [
        10
