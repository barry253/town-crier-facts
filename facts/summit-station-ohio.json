  "facts": [
    {
      "id": 1,
      "text": "Summit Station hosted Ohio’s longest‑running lesbian bar, operating from 1980 to 2008.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.columbusmonthly.com/story/lifestyle/around-town/2023/06/07/long-running-columbus-lesbian-bar-summit-station-gains-a-historical-marker/70300160007/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 2023, a historical marker was dedicated outside the former Summit Station at 2210 Summit St on June 10.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.columbusmonthly.com/story/lifestyle/around-town/2023/06/07/long-running-columbus-lesbian-bar-summit-station-gains-a-historical-marker/70300160007/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The marker is the first LGBTQ+ historical marker in Columbus and the third statewide.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.columbusmonthly.com/story/lifestyle/around-town/2023/06/07/long-running-columbus-lesbian-bar-summit-station-gains-a-historical-marker/70300160007/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The marker project received a $250,000 federal grant to identify ten more LGBTQ+ sites in Ohio.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.columbusmonthly.com/story/lifestyle/around-town/2023/06/07/long-running-columbus-lesbian-bar-summit-station-gains-a-historical-marker/70300160007/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Singleton and Julia Applegate spearheaded the marker effort, researching the bar’s history and lobbying city officials.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.columbusmonthly.com/story/lifestyle/around-town/2023/06/07/long-running-columbus-lesbian-bar-summit-station-gains-a-historical-marker/70300160007/",
      "category": "people",
      "quality": "good"
