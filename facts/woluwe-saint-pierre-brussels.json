  "facts": [
    {
      "id": 1,
      "text": "Woluwe-Saint-Pierre first appears as \"Wolewe\" in a 1117 charter from Forest.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woluwe-Saint-Pierre"
    },
    {
      "id": 2,
      "text": "The hamlet and its farms were once dependencies of the Park Abbey near Leuven.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woluwe-Saint-Pierre"
    },
    {
      "id": 3,
      "text": "Safety and prosperity returned under Archdukes Albert VII and Isabella at the start of the 17th century.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woluwe-Saint-Pierre"
    },
    {
      "id": 4,
      "text": "The first grand alley linking Tervuren to Brussels, called the \"Street of the Duke\", dates from that period.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woluwe-Saint-Pierre"
    },
    {
      "id": 5,
      "text": "Between 1880 and 1910, Avenue de Tervueren, a new train track, Stoclet Palace, and Woluwe Park were built.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woluwe-Saint-Pierre"
    },
    {
      "id": 6,
      "text": "The main church, Saint Peter, was erected in 1755 on the site of an older building, funded by Forest Abbey.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Woluwe-Saint-Pierre"
    }
  ]
