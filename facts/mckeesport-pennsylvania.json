  "facts": [
    {
      "id": 1,
      "text": "McKeesport’s name comes from founder John McKee and the word “port,” reflecting its historic role as a river trade hub.",
      "sourceSentenceIds": [
        4,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.wisdomlib.org/cities/mckeesport-26888",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits where the Monongahela and Youghiogheny Rivers meet, a spot that shaped its early growth and still offers scenic riverfronts.",
      "sourceSentenceIds": [
        7,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/McKeesport%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1976, a massive blaze known as the “Famous Fire” gutted downtown McKeesport, leaving only rubble where former landmarks once stood.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McKeesport%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "McKeesport was a powerhouse of steel production, earning a reputation as a vital industrial center during the 20th century.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/mckeesport-26888",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The McKeesport Regional History & Heritage Center preserves the city’s past and hosts events that celebrate local culture.",
      "sourceSentenceIds": [
        20
      ],
