  "facts": [
    {
      "id": 1,
      "text": "Wahiawa’s name means “place of the wa people,” a nod to the ancient Hawaiian community that once settled the area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wahiaw%C4%81%2C_Hawaii",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Lake Wilson, also called Wahiawa Reservoir, surrounds the town on three sides and is one of the few lakes on Oʻahu.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wahiaw%C4%81%2C_Hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Wahiawa Public Library, founded in 1935, is the oldest library on Oʻahu and holds rare, out‑of‑print books unique to the island.",
      "sourceSentenceIds": [
        19,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://library.leeward.hawaii.edu/c.php?g=1031927&p=9727722",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Schofield Barracks and Wheeler Army Airfield, both U.S. Army installations, sit just north of Wahiawa and have shaped the town’s growth for decades.",
      "sourceSentenceIds": [
        20,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://library.leeward.hawaii.edu/c.php?g=1031927&p=9727722",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Dole Plantation, a former pineapple empire, opened in 1901 and was a major employer in Wahiawa until 1991.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://library.leeward.hawaii.edu/c.php?g=1031927&p=9727722",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Wahiawa Community & Business Association, founded in 1935, works to empower local businesses and enrich daily experiences for residents.",
