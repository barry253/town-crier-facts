  "facts": [
    {
      "id": 1,
      "text": "Mayo, Maryland takes its name from Commodore Isaac Mayo, a naval hero who served in the Mexican–American War.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayo%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Commodore Mayo’s historic home, Gresham, still stands in Mayo and was listed on the National Register of Historic Places in 1990.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayo%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Offshore from Mayo, the Thomas Point Lighthouse marks the mouth of the South River and has guided ships since the 19th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mayo.md.us/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mayo beach once drew weekend crowds, becoming a popular resort before the rise of modern vacation spots.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayo%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mayo sits on a peninsula between the South River to the northeast and the Rhode River to the southwest, both tidal arms of Chesapeake Bay.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mayo%2C_Maryland",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The 2010 census defined Mayo’s boundaries to include the former Selby-on-the-Bay community, expanding the CDP’s area.",
