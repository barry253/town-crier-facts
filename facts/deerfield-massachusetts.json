  "facts": [
    {
      "id": 1,
      "text": "Historic Deerfield is a National Historic Landmark district with eleven house museums and a regional museum.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deerfield%2C_Massachusetts"
    },
    {
      "id": 2,
      "text": "The town hosts the Flynt Center of Early New England Life, showcasing period houses and textile galleries.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://deerfieldattractions.com/historic-deerfield/"
    },
    {
      "id": 3,
      "text": "Founded in 1952, the museum preserves 12 historic houses, most on their original homesites, dating from 1730-1850.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://savingplaces.org/places/historic-deerfield"
    },
    {
      "id": 4,
      "text": "Deerfield includes South Deerfield and Old Deerfield villages, home to the Pocumtuck Valley Memorial Association and Historic Deerfield.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deerfield%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "The town’s early history was marked by intertribal warfare and Anglo‑French Indian skirmishes, making it a focal point of frontier conflict.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deerfield%2C_Massachusetts"
    },
    {
      "id": 6,
      "text": "Historic Deerfield’s collections document America’s material culture, from decorative arts to early furniture, helping visitors understand the past.",
