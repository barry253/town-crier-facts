  "facts": [
    {
      "id": 1,
      "text": "Channahon’s name comes from a Potawatomi phrase meaning “meeting of the waters,” echoing its river confluence.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channahon%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Three rivers—Des Plaines, Kankakee, and DuPage—merge in Channahon to form the Illinois River, a historic navigation hub.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Channahon%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the Illinois and Michigan Canal opened in 1836, Channahon hosted two of its locks, cementing the village’s early waterway importance.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channahon%2C_Illinois",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Village of Channahon first incorporated in 1896, dissolved in 1908 after a bridge failure, and was reincorporated in 1961.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channahon%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Channahon’s rapid industrial growth in the late 20th century brought a Mobil refinery, petrochemical plants, and major distribution centers to the area.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channahon%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Three Rivers Public Library’s local history collection, housed in the Minooka Branch, preserves over 300 Channahon documents and photographs.",
      "sourceSentenceIds": [
        8,
        12
      ],
