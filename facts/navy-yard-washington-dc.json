  "facts": [
    {
      "id": 1,
      "text": "Washington Navy Yard was founded in 1799 as the nation's first naval shipbuilding facility.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://navyyarddc.org/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "During World War II the Yard employed 26,000 workers across 132 buildings, making it the largest naval ordnance plant worldwide.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://navyyarddc.org/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Latrobe Gate, the Yard’s main entrance, hides a history of shipbuilding and ordnance that surprised many visitors.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dcmilitary.com/at_ease/celebrating-250-years-of-the-u-s-navy-through-the-history-of-the-washington-navy/article_aab2eb49-af4c-4fe1-979d-39705bc32120.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After weapons production ended in 1961, the Yard was redesignated the Washington Navy Yard in 1964 and began converting factory buildings into offices.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://navyyarddc.org/about",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Anacostia River ran through the Yard and served as a testing area for weapons built before and during the Civil War.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dcmilitary.com/at_ease/celebrating-250-years-of-the-u-s-navy-through-the-history-of-the-washington-navy/article_aab2eb49-af4c-4fe1-979d-39705bc32120.html",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Navy Yard neighborhood is one of Washington, DC’s oldest industrial corridors, now a dense, walkable community with luxury apartments, restaurants, and waterfront parks.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
