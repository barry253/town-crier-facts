      "id": 1,
      "text": "Grafton was founded in 1832 by James Mason, making it the oldest city in Jersey County.",
      "sourceSentenceIds": [
        3,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city sits at the confluence of the Illinois and Mississippi Rivers, a spot once protected by a blockhouse built in 1812.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Limestone quarried in Grafton supplied stone for the famous Eads Bridge over the Mississippi in St. Louis.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Edward Amburg History Museum on River Road showcases Grafton's early industry, including a historic powder mill and boat building.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.cityofgraftonil.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Grafton's Old Boatworks, once a PT boat shop, now hosts antique stalls each fourth weekend from May to October.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grafton%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
