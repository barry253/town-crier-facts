  "facts": [
    {
      "id": 1,
      "text": "Sugar Hill got its name from a 19th‑century sugar shipment that spilled on a hill, giving the town its quirky nickname.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.exploregwinnett.org/cities/sugar-hill/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially became the City of Sugar Hill in 1939 after a charter by the Georgia state assembly.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Hill%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Across from The Eagle Theatre on West Broad Street, the Sugar Hill Art Gallery & History Museum showcases classic and contemporary works.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://cityofsugarhill.com/sugar-hill-art-gallery-history-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Unlike most nearby cities, Sugar Hill runs its own natural‑gas system through the Sugar Hill Gas Department.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sugar_Hill%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nestled in northern Gwinnett, Sugar Hill sits just south of Lake Lanier and the foothills of the North Georgia mountains.",
      "sourceSentenceIds": [
