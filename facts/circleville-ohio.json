      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its original circular layout built around a Hopewell earthwork.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Circleville%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1837 the Ohio General Assembly approved changing Circleville’s circle into a grid, but the circle remains a landmark.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Circleville%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Gregg‑Crites Octagon House, built in the 1850s, is one of Ohio’s rare octagonal homes and sits on the National Register.",
