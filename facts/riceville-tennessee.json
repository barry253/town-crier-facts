        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Riceville%2C_Tennessee",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Riceville is closer to the small towns of Athens and Calhoun, offering a quiet escape from larger cities.",
      "sourceSentenceIds": [
