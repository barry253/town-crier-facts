    },
    {
      "id": 2,
      "text": "The town lies midway between Knoxville and Chattanooga, a convenient spot for travelers heading south.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
