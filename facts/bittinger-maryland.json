  "facts": [
    {
      "id": 1,
      "text": "Bittinger was founded by Henry Bittinger, a German descendant who became the area’s first permanent settler around 1810.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bittinger_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s first post office opened in 1885 with Josiah Bittinger as postmaster, marking a growth to about ten homes, a general store, and a cheese‑making facility.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bittinger_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buckel’s Store, built circa 1900, was once claimed as the smallest operational post office in the United States and remains a historic landmark.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bittinger_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bittinger sits at 2,690 feet on the Appalachian Plateau, just west of Savage River State Forest, where hikers and anglers enjoy the surrounding highland scenery.",
      "sourceSentenceIds": [
        12,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bittinger%2C_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Winters in Bittinger bring an average of 109 inches of snow, a result of orographic lift from the nearby Allegheny Mountains.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bittinger_maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The original land that became Bittinger was part of military lots granted to Revolutionary War veterans, including General William Smallwood.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
