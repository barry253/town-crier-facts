  "facts": [
    {
      "id": 1,
      "text": "Neylandville began as an all‑black settlement when James Brigham bought his and his family's freedom from planter Robert Neyland.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/neylandville-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on Farm Road 2874, about ten miles northeast of Greenville in Hunt County.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/neylandville-tx",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In the 1880s residents formed a farmers’ co‑op that built a general store, cotton gin, wheat drill, and wheat‑harvesting machine.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/neylandville-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Neylandville is the nearest town to Greenville that permits alcohol sales, hosting one liquor store and one beer‑and‑wine shop.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/neylandville-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s name honors the Neyland family, whose land ownership dates back to the early 19th century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/neylandville-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Neylandville lies northeast of Hunt County’s center, placing it in the county’s northeastern quadrant.",
      "sourceSentenceIds": [
        19
