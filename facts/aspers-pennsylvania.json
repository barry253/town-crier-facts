      "id": 1,
      "text": "Aspers, once called Bendersville Station, was renamed in 1884 after Frederick Asper, a local landowner who helped bring the Gettysburg‑Harrisburg Railroad through the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aspers_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A 1919 cannery in Aspers later joined the Mott group, helping Adams County lead Pennsylvania’s apple‑processing industry.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aspers_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Aspers sits on South Mountain’s eastern slopes, a rural hub famed for apple production and processing.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/aspers_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
