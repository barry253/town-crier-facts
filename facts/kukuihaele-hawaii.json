  "facts": [
    {
      "id": 1,
      "text": "Kukuihaele, meaning 'Traveling light,' was once home to the healing god Kamakanuiahailono, the great eye messenger.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://vacations.hawaiilife.com/big-island-area-info/kukuihaele",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Perched about 730 feet above sea level, Kukuihaele sits on steep cliffs that drop sharply into Waipio Bay.",
      "sourceSentenceIds": [
        7,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kukuihaele%2C_Hawaii",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ancient Hawaiians called Kukuihaele 'the land of many heiau,' where priest Kamakanui'ahailono trained healers.",
      "sourceSentenceIds": [
        19,
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kukuihaele%2C_Hawaii",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Kukuihaele hosts the original Hawaiian stand of cinchona trees, planted by David McHattie Forbes in the early 1900s.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kukuihaele%2C_Hawaii",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1848 Māhele, Kukuihaele became a sugar cane hub under the Pacific Sugar Mill, later part of the Hāmākua Sugar Company until 1994.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/kukuihaele_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The former Kukuihaele School, operating from the 1880s to 1965, now serves as a 5‑acre park with sports fields and walking paths.",
