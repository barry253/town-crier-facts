  "facts": [
    {
      "id": 1,
      "text": "Park Hill earned its name from Missouri native Joel Estes, who founded the community in 1859 while it was still part of the Nebraska Territory.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estes_Park%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1916 the Estes Valley Library opened, thanks to the Estes Park Women’s Club, becoming a cornerstone of local learning.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Estes_Park%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Baron Allois Gullaume Engine von Winckler laid out the original Park Hill development in 1887 on 32 acres he owned in northeast Denver.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/park-hill-neighborhood-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Racial tensions over Park Hill’s street layout mirrored Denver’s broader struggle with segregated public schools in the early 20th century.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://history.denverlibrary.org/neighborhood-history-guide/park-hill-neighborhood-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every summer, the park bandstand in Park Hill hosts a free City Park Jazz concert series that draws music lovers from across the region.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lifestyledenver.com/neighborhoods/park-hill-neighborhood/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Park Hill sits along the Big Thompson River, overlooking Lake Estes and the historic Olympus Dam, a reminder of the town’s early water management.",
      "sourceSentenceIds": [
        22,
        23
      ],
