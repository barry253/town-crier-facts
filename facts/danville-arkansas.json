  "facts": [
    {
      "id": 1,
      "text": "Danville got its name from a steamboat that once sailed the Petit Jean River in the 1840s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danville%2C_Arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in west‑central Arkansas, right where the Ozark and Ouachita Mountains meet.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://danvillear.gov/history/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Danville is one of two county seats for Yell County, sharing the role with Dardanelle.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danville%2C_Arkansas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Commissioners chose the site in 1840, and the city was officially laid out in December 1841 by Briggs, Williams, and Morse.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danville%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A log courthouse was built in Danville in 1844, then replaced by a frame building by 1850.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Danville%2C_Arkansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The many creeks around Danville once powered a network of water‑mill factories that dotted the area.",
      "sourceSentenceIds": [
