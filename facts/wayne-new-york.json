  "facts": [
    {
      "id": 1,
      "text": "Wayne takes its name from Revolutionary War hero General Anthony Wayne, who inspired the town’s founders in 1808.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayne%2C_New_York"
    },
    {
      "id": 2,
      "text": "European settlers first arrived around 1791, and the town officially formed as Frederickstown in 1796 before becoming Wayne.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayne%2C_New_York"
    },
    {
      "id": 3,
      "text": "The historic Keuka Hotel, opened in 1895 on Lake Keuka’s shore, once hosted musicians and guests for decades.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayne%2C_New_York"
    },
    {
      "id": 4,
      "text": "Wayne native Jonathan Goble, a Marine who served with Commodore Perry, is credited with inventing the rickshaw in 1859 to aid his wife in Tokyo.",
      "sourceSentenceIds": [
        14,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayne%2C_New_York"
    },
    {
      "id": 5,
      "text": "Pianist Hoagy Carmichael performed at the Keuka Hotel in the 1920s, and legend says he wrote “Stardust” there.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wayne%2C_New_York"
    },
    {
      "id": 6,
      "text": "Wayne borders Yates and Schuyler counties and sits on the southeastern shore of Keuka Lake, offering scenic waterfront views.",
