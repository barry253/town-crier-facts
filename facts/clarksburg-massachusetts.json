  "facts": [
    {
      "id": 1,
      "text": "Clarksburg was first settled in 1764, officially incorporated in 1798, and its early settlers included Captain Matthew Ketchum and Colonel William Bullock.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksburg%2C_Massachusetts"
    },
    {
      "id": 2,
      "text": "Nicholas Clark gave the town its name after a child's birth, making him the namesake.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksburg%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "The town’s early economy grew around mills on waterways, including a cashmere mill and gunpowder mills during the Civil War.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksburg%2C_Massachusetts"
    },
    {
      "id": 4,
      "text": "A 1869 mill explosion halted industrial activity, prompting the town to stop that industry.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksburg%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "The Natural Bridge of New England, a unique geological wonder, sits in Clarksburg and attracts history enthusiasts.",
      "sourceSentenceIds": [
