  "facts": [
    {
      "id": 1,
      "text": "Catlett was originally called Colvin's Station, then Catlett Station, before settling on Catlett.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Catlett%2C_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around the Orange and Alexandria Railroad laid through in 1852, becoming a key mail and telegraph hub.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5162/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Catlett Historic District was listed on the National Register of Historic Places in 2008, preserving its late‑19th to mid‑20th‑century architecture.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Catlett%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits west of the Prince William County line, with Virginia State Route 28 running through it toward Manassas.",
      "sourceSentenceIds": [
        13,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Catlett%2C_Virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "Cedar Run, a tributary of the Occoquan River, forms Catlett’s western and southern edge, flowing southeast to the Potomac.",
