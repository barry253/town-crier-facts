      ],
      "source": "https://en.wikipedia.org/wiki/Palmyra%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In July 1863, Confederate General John Hunt Morgan camped in Palmyra after the Battle of Corydon, ransoming businesses and seizing horses.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palmyra%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Palmyra was officially incorporated in 1906, marking its formal municipal status.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palmyra%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Palmyra houses a branch of the Harrison County Public Library, serving local residents.",
