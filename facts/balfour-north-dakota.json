  "facts": [
    {
      "id": 1,
      "text": "Balfour sprang to life in 1898 when the Soo Line Railroad pushed its tracks through the prairie, naming the town after British statesman Arthur Balfour.",
      "sourceSentenceIds": [
        1,
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/balfour_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Balfour Lutheran Church, once a community landmark, held its last service around 2011 before closing.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/balfour_north_dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Soo Line not only built Balfour but also sold lots and encouraged homesteaders, turning the prairie into a bustling grain‑shipping hub.",
      "sourceSentenceIds": [
        11,
        15,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/balfour_north_dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Royal Elevator, erected in 1902, became Balfour’s main grain‑storage and shipping center for wheat and barley.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/balfour_north_dakota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today Balfour feels like a near‑ghost town, with vacant buildings such as an abandoned school, former jail, and shuttered bank.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
