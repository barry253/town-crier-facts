  "facts": [
    {
      "id": 1,
      "text": "Lelia Lake sprang up in the late 1880s along the Fort Worth and Denver City Railway, its name honoring the founder’s sister.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lelia_Lake%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s original name, Lelia, came from Lelia Payne, the founder’s sister‑in‑law, before “Lake” was added in 1906.",
      "sourceSentenceIds": [
        2,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lelia-lake-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened in December 1906, and the word Lake was appended to distinguish it from Lela in Wheeler County.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lelia-lake-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first school began in 1894, marking the community’s early commitment to education.",
      "sourceSentenceIds": [
        21,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lelia_Lake%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1915 Lelia Lake boasted two banks, two gins, a lumberyard, a barbershop, a physician, and several stores.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/lelia-lake-tx",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Historically, the town served as a hub for grain traffic and was renowned for its watermelon crops.",
      "sourceSentenceIds": [
