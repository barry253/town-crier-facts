  "facts": [
    {
      "id": 1,
      "text": "North Little Rock was founded on April 18, 1871, originally called Argenta, Arkansas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Little_Rock%2C_Arkansas"
    },
    {
      "id": 2,
      "text": "The name Argenta came from a hotel built there in the late 1850s, and the town later adopted the name North Little Rock.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/North-Little-Rock"
    },
    {
      "id": 3,
      "text": "In 1890, Little Rock annexed Argenta, but the community regained independence in 1901 as the town of North Little Rock.",
      "sourceSentenceIds": [
        3,
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/North-Little-Rock"
    },
    {
      "id": 4,
      "text": "Dickey‑Stephens Park in downtown hosts the Arkansas Travelers minor‑league baseball team, a local sports staple.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/North_Little_Rock%2C_Arkansas"
    },
    {
      "id": 5,
      "text": "Simmons Bank Arena, opened in 2015, serves as the region’s main entertainment venue for concerts and events.",
