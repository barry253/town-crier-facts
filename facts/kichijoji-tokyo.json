  "facts": [
    {
      "id": 1,
      "text": "Kichijoji takes its name from a temple that burned in 1657, after which the area was renamed for the former shrine.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kichij%C5%8Dji"
    },
    {
      "id": 2,
      "text": "Inokashira Park, south of Kichijoji Station, is the source of the Kanda River and a favorite spot for spring cherry‑blossom viewing.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kichij%C5%8Dji"
    },
    {
      "id": 3,
      "text": "JR Sobu, Chuo, and Keio‑Inokashira lines all stop at Kichijoji Station, making it a key rail hub.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/destinations/western-tokyo/kichijoji/index.html"
    },
    {
      "id": 4,
      "text": "Venture north of the station and you’ll find Harmonica Yokocho, a maze of alleys lined with bars and eateries that buzz at night.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/destinations/western-tokyo/kichijoji/index.html"
    },
    {
      "id": 5,
      "text": "The Kichijoji Odeon, a movie theater with over forty years of history, still screens films in a classic setting.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/destinations/western-tokyo/kichijoji/index.html"
    },
    {
      "id": 6,
      "text": "A short fifteen‑minute walk from Kichijoji Station leads to the Ghibli Museum, a popular spot for anime fans.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.gotokyo.org/en/destinations/western-tokyo/kichijoji/index.html"
    }
  ],
