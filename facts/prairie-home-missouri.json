  "facts": [
    {
      "id": 1,
      "text": "Prairie Home was laid out in 1874 around the Prairie Home Institute, a school built earlier in the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_Home%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from its scenic setting on a prairie, a detail noted by early settlers.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_Home%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Located along Missouri Route 87 at the junction with routes J and EE, Prairie Home sits 13 miles southeast of Boonville.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Prairie_Home%2C_Missouri",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Just two miles south along Schaaf Creek lies the Prairie Home Conservation Area, an upland mix of oldfields, grasslands, and woodlands.",
      "sourceSentenceIds": [
        14,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
