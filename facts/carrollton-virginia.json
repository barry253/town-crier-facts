      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Carrollton sits just west of the James River Bridge, directly across from Newport News.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrollton%2C_Virginia",
