      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "A former Nike anti‑aircraft missile base, now a park, marks Carrollton’s Cold War history.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.wikivoyage.org/wiki/Carrollton_(Virginia)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original Carroll family home, once a country store, now sits at Reynolds and Norsworthy Drives and has deteriorated.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carrollton%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Carroll's Shop, a surviving 19th‑century commercial building, is one of the few historic structures left in town.",
