  "facts": [
    {
      "id": 1,
      "text": "Cartersville sprang to life on December 16, 1790 when Virginia’s General Assembly chartered a 27‑acre ferry site owned by John Woodson.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cartersville_historic_district",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 1822 Cartersville Bridge opened over the James River, turning the town into a bustling antebellum transport hub.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cartersville_historic_district",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1993, Cartersville Historic District earned spots on both the Virginia Landmarks Register and the NRHP.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cartersville_historic_district",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Cartersville’s streets showcase vernacular homes from the 1700s to the early 1900s, preserving a rare river‑town aesthetic.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/024-0126/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The James River and Kanawha Canal ran along Cartersville’s north shore, boosting commerce before the railroad bypassed it.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cartersville_historic_district",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cartersville enjoys a humid subtropical climate, marked by warm summers and steady year‑round rainfall.",
      "sourceSentenceIds": [
        12
      ],
