  "facts": [
    {
      "id": 1,
      "text": "Marble Hill got its name from a nearby marble quarry that supplied the town's early industry.",
      "sourceSentenceIds": [
        1,
        2,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Marblehill%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The railroad arrived in 1883, turning Marble Hill into a key shipping point for marble that ended up in Washington, D.C. monuments.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://jasperpickenscountyga.com/marble-hill-georgia/"
    },
    {
      "id": 3,
      "text": "Samuel Tate founded the Georgia Marble Company in 1884, making Marble Hill a hub for high‑quality marble production.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marblehill_georgia"
    },
    {
      "id": 4,
      "text": "Before settlers, Cherokee and earlier peoples quarried North Georgia marble here for centuries.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://jasperpickenscountyga.com/marble-hill-georgia/"
    },
    {
      "id": 5,
      "text": "Marble Hill sits in the Long Swamp valley, a quiet gateway to the Appalachian foothills where marble deposits shape the landscape.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/marblehill_georgia"
    },
    {
      "id": 6,
      "text": "A post office opened in Marble Hill in 1889, marking the town’s growing permanence.",
