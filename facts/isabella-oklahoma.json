  "facts": [
    {
      "id": 1,
      "text": "Isabella traces its origins to the Cherokee Outlet Land Run of September 16, 1893, when settlers raced to claim 160-acre homesteads.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isabella_oklahoma"
    },
    {
      "id": 2,
      "text": "The Isabella post office was established on August 15, 1904, providing essential mail services to isolated settlers in the region.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isabella_oklahoma"
    },
    {
      "id": 3,
      "text": "Isabella is situated within the Osage Plains physiographic region of the Great Plains.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isabella_oklahoma"
    },
    {
      "id": 4,
      "text": "Early agricultural operations in Isabella focused on wheat, corn, and livestock amid the challenging terrain of the Red Bed Plains.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isabella_oklahoma"
    },
    {
      "id": 5,
      "text": "Railroads like the Enid and Anadarko Railway arrived in the early 1900s, facilitating the transportation of goods and people to Isabella.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/isabella_oklahoma"
    },
    {
      "id": 6,
      "text": "Isabella remains an unincorporated community and is located entirely within a rural area.",
