  "facts": [
    {
      "id": 1,
      "text": "The name Tracadie comes from the Mi'kmaq word Telagadik, meaning a camping place.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tracadienb.ca/en/town-hall/history-of-tracadie",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tracadie‑Sheila formed in 1992 by merging the former Town of Tracadie and Village of Sheila.",
      "sourceSentenceIds": [
        5,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://tracadienb.ca/en/town-hall/history-of-tracadie",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "CN Rail once served Tracadie, but the freight line was abandoned in the 1980s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tracadie-Sheila",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Located on the Acadian Peninsula, Tracadie‑Sheila boasts sandy beaches, with Val‑Comeau Provincial Park as the most popular.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tracadie-Sheila",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Tracadie‑Sheila is the hometown of Wilfred Le Bouthillier, winner of Quebec’s 2003 Star Académie.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tracadie-Sheila",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tourism provides a seasonal boost, especially in June, July, and August, drawing visitors mainly from Quebec.",
