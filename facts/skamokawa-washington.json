  "facts": [
    {
      "id": 1,
      "text": "Skamokawa means “smoke on the water,” named for the fog that rolls down the valleys onto the Columbia River.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Skamokawa%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the banks of the Columbia River and is accessed by Washington State Route 4.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skamokawa%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The first American trading post appeared near Skamokawa in 1844, marking the start of permanent settlement.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Skamokawa%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1860s pioneers from around the world settled here, drawn by timber, salmon, and the chance to farm the fertile riverbanks.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lewisandclark.travel/listing/skamokawa-river-life-center/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Skamokawa River Life Center, housed in the historic Central Schoolhouse, showcases photographs and displays of the town’s logging and river‑fishing heritage.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lewisandclark.travel/listing/skamokawa-river-life-center/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Skamokawa was designated a National Historic District in 1976, preserving its unique 19th‑century character.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
