  "facts": [
    {
      "id": 1,
      "text": "Carlos Botelho founded the Aclimação Garden in 1892, inspired by Paris's Jardin d'Acclimatation, and it once housed São Paulo's first zoo.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aclima%C3%A7%C3%A3o_Park",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park opened on September 16, 1939, covering 112,000 square meters, and later expanded to 118,787 square meters today.",
      "sourceSentenceIds": [
        9,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aclima%C3%A7%C3%A3o_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Aclimação Park earned protected status in 1986 when Condephaat listed it as a heritage area after a decade of resident activism.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aclima%C3%A7%C3%A3o_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The lake inside the park holds about 70,000 cubic meters of water and has survived multiple breaches, with repairs completed in 2010.",
      "sourceSentenceIds": [
        12,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aclima%C3%A7%C3%A3o_Park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The park features a Japanese garden with a water mirror, a bocce court, and a 1,500‑meter jogging track, offering diverse recreation options.",
      "sourceSentenceIds": [
        12,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aclima%C3%A7%C3%A3o_Park",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Aclimação Park hosts over 111 bird species, including the southern lapwing and the rufous‑bellied thrush, making it a hotspot for birdwatchers.",
      "sourceSentenceIds": [
        13,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Aclima%C3%A7%C3%A3o_Park",
      "category": "nature",
      "quality": "good"
    }
