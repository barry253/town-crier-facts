  "facts": [
    {
      "id": 1,
      "text": "Stratford was named after Stratford‑upon‑Avon, England, when the Rural Land Improvement Company renamed the village in the 1880s.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough officially formed on February 13, 1925, carved out of Clementon Township by seven new municipalities.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The earliest settlers clustered around the White Horse Tavern in the 1740s, giving rise to the small village of White Horse that still exists today.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The only surviving building from that early village is the Stratford Quaker Store, a quiet reminder of the town’s colonial past.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stratford hosts the Rowan‑Virtua School of Osteopathic Medicine, one of the few medical schools located in a small New Jersey borough.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hollywood talk‑show host Kelly Ripa and WNBA star Tamika Catchings both grew up in Stratford, bringing national fame to the borough.",
      "sourceSentenceIds": [
        1
      ],
