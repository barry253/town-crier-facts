  "facts": [
    {
      "id": 1,
      "text": "Walnut Grove was named for a grove of black walnut trees near the original town site.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Walnut_Grove%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "Walnut Grove's settlement began in 1870 along Plum Creek, attracted by fertile land after the Homestead Act.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Walnut_Grove,_Minnesota"
    },
    {
      "id": 3,
      "text": "The Chicago & North Western Railroad arrived in 1872, enabling grain and livestock shipments and spurring local agriculture.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Walnut_Grove,_Minnesota"
    },
    {
      "id": 4,
      "text": "Walnut Grove served as the setting for Laura Ingalls Wilder's semi‑autobiographical novel On the Banks of Plum Creek.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Walnut_Grove,_Minnesota"
    },
    {
      "id": 5,
      "text": "The Laura Ingalls Wilder Museum opened in 1975, showcasing artifacts from the Ingalls era and a replica dugout.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Walnut_Grove,_Minnesota"
    },
    {
      "id": 6,
      "text": "Walnut Grove was platted in 1874, then officially incorporated in 1879, marking its formal town status.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
