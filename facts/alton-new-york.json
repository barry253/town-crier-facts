  "facts": [
    {
      "id": 1,
      "text": "Alton is a hamlet in the Town of Sodus, Wayne County, New York.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alton%2C_New_York"
    },
    {
      "id": 2,
      "text": "Located about six miles southeast of Sodus village, Alton grew in the early nineteenth century as agriculture pushed west after the Revolutionary War.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alton%2C_New_York"
    },
    {
      "id": 3,
      "text": "Alton sits south of Lake Ontario’s shoreline along the historic Ridge Road corridor, a former glacial edge from the last ice sheet.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alton%2C_New_York"
    },
    {
      "id": 4,
      "text": "The former Shaker farm, later known as Alasa Farms, sits just northeast of the hamlet and was listed on the National Register of Historic Places in 2009.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alton%2C_New_York"
    },
    {
      "id": 5,
      "text": "Historic Sanborn Fire Insurance Maps reveal Alton’s old downtown, labeling businesses, schools, and hotels, making them a direct window into the town’s past.",
      "sourceSentenceIds": [
        11,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-alton-new-york"
    },
    {
      "id": 6,
      "text": "A single 1911 Sanborn map of Alton shows the entire town’s footprint, useful for researchers and modelers alike.",
