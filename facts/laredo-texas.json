  "facts": [
    {
      "id": 1,
      "text": "Founded in 1755, Laredo grew from a village to the capital of the short‑lived Republic of the Rio Grande and now stands as the largest inland port on the Mexican border.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laredo%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Spanish colonial settlement was named Villa de San Agustín de Laredo after Laredo, Cantabria, Spain, honoring Saint Augustine of Hippo.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laredo%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When the U.S. rejected a petition for statehood, many settlers crossed the river into Mexico and founded Nuevo Laredo.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laredo%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1974, the Laredo Public Library moved to the historic Bruni Plaza in downtown Laredo, preserving a key cultural landmark.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Laredo%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Each July, Laredo hosts the Laredo International Sister Cities Festival, a celebration that began in 2003 and showcases cross‑border culture.",
      "sourceSentenceIds": [
