  "facts": [
    {
      "id": 1,
      "text": "Kykotsmovi, spelled Kiqötsmovi in Hopi, translates to 'mound of ruined houses' today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 2,
      "text": "The village sprang up in 1906 after a dispute in Oraibi over how to engage missionaries and federal agents.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 3,
      "text": "Hopi settlers from Old Oraibi established Kykotsmovi near a spring at the base of Third Mesa.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 4,
      "text": "Kykotsmovi serves as the seat of the Hopi Reservation’s tribal government, a sovereign nation in northeastern Arizona.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 5,
      "text": "The village hosts a single school, Hopi Day School, alongside a store, post office, and community building.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kykotsmovi_Village%2C_Arizona"
    },
    {
      "id": 6,
      "text": "Kykotsmovi is one of twelve villages that make up Third Mesa, sharing the mesa with Hotvela, Paaqavi, Munqapi, and Orayvi.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
