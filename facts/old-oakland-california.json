      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Cafe Gabriela, founded in 2010 by Penny Baldado, a formerly undocumented queer entrepreneur, offers a vibrant menu in Old Oakland.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
