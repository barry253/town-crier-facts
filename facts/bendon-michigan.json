  "facts": [
    {
      "id": 1,
      "text": "Bendon grew around a sawmill that opened in 1888, turning the tiny settlement into a logging hub.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bendon_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s first post office opened on April 24, 1888, with Albert Kent, a local farmer, as its inaugural postmaster.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bendon%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A Chicago and West Michigan Railway station was built beside the sawmill, linking Bendon to Grand Rapids and Traverse City.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bendon_michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "On June 30, 1892, the post office and the town were renamed Bendon, a name that stuck through the 20th century.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Bendon%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bendon sits in eastern Benzie County, just a few miles from the Grand Traverse County line, surrounded by forested hills.",
