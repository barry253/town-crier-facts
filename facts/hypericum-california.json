  "facts": [
    {
      "id": 1,
      "text": "Hypericum sits north of Avenue 256, about 9 miles southeast of Visalia, the county seat.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hypericum%2C_California"
    },
    {
      "id": 2,
      "text": "The community, once called \"Dog-town,\" grew as a modest agricultural settlement with little documented founding date.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hypericum_california"
    },
    {
      "id": 3,
      "text": "Yokuts groups settled the Hypericum area about 7,000 years ago, hunting, gathering, and fishing in the Tulare Lake basin.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hypericum_california"
    },
    {
      "id": 4,
      "text": "The region’s flat, gently sloping terrain and well‑drained Nord Fine Sandy Loam soils make it ideal for irrigated agriculture fed by the Kaweah River system.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hypericum_california"
    },
    {
      "id": 5,
      "text": "Hypericum experiences a Mediterranean climate with hot, dry summers and cool, wet winters, averaging 10–12 inches of rain mostly from November to April.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hypericum_california"
    },
    {
      "id": 6,
      "text": "The community faces moderate seismic risk and poor regional air quality, with dust from nearby traffic and Valley fever risk due to dusty soils.",
      "sourceSentenceIds": [
        8,
