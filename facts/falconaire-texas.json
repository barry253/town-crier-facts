    },
    {
      "id": 2,
      "text": "Falconaire sits in the arid landscape of the Rio Grande Valley near Falcon Lake and Falcon Dam.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/falconaire_texas"
    },
    {
      "id": 3,
      "text": "The Rio Grande River forms the international boundary with Mexico approximately two miles south of Falconaire.",
