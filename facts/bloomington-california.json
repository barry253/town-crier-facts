  "facts": [
    {
      "id": 1,
      "text": "Bloomington began in 1887 when the Semi‑Tropic Land and Water Company laid out the town’s first plots.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomington%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1907, the Riverside Portland Cement Company built a large plant near Crestmore Quarries and added a railroad to serve workers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomington%2C_California",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bloomington hosts a Union Pacific hump yard, a key freight sorting facility on the Alhambra Subdivision.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomington%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Although Amtrak’s Sunset Limited runs through Bloomington, the nearest station is in Fontana, miles away.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomington%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "In 2007, the Bloomington Incorporation Committee applied again for city status, but the commission denied the required deposit extension.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bloomington%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The original settlement, called Crestmore, lay between Locust and Larch Avenues, just south of Jurupa Avenue.",
