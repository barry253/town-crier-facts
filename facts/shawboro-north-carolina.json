  "facts": [
    {
      "id": 1,
      "text": "Shawboro was renamed around 1884 after Confederate Colonel Henry Marchmore Shaw, who once owned the nearby Belville estate.",
      "sourceSentenceIds": [
        1,
        15,
        20
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/shawboro_north_carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic core includes the 1812 Culong house, a rare example of Federal‑style architecture built from local cypress and brick.",
      "sourceSentenceIds": [
        4,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/shawboro_north_carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The New Providence Baptist Church, founded in 1862, helped spur Shawboro’s growth during the late‑19th‑century agricultural boom.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shawboro_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Indiantown Creek, which borders Shawboro, once hosted the McKnight Shipyard—North Carolina’s largest 18th‑century vessel‑launching facility.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/shawboro_north_carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Shawboro’s soil is dominated by Norfolk sandy loams, making the area ideal for crops like corn, potatoes, and soybeans after proper liming.",
      "sourceSentenceIds": [
        28
      ],
