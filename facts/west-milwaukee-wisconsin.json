  "facts": [
    {
      "id": 1,
      "text": "West Milwaukee became a village in 1906 after previously being part of the towns of Wauwatosa and Greenfield.",
      "sourceSentenceIds": [
        5,
        11
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.westmilwaukee.org/community/about-us/history/"
    },
    {
      "id": 2,
      "text": "Industrial leaders incorporated West Milwaukee in 1906 as a deliberate strategy to maintain low taxes for local businesses.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Milwaukee%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Chicago, Milwaukee and St. Paul Railway shaped the area by establishing significant shops, roundhouses, and switching yards.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Milwaukee%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Early West Milwaukee featured a variety of landmarks, including a pickle factory, a gravel pit, and a twenty-eight room mansion.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.westmilwaukee.org/community/about-us/history/"
    },
    {
      "id": 5,
      "text": "Residential areas in West Milwaukee developed around massive industrial facilities, creating a distinct working-class community.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Milwaukee%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "West Milwaukee sustains itself today through a high property tax base provided by a dense concentration of industrial properties.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Milwaukee%2C_Wisconsin"
    }
