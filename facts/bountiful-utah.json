  "facts": [
    {
      "id": 1,
      "text": "Bountiful was settled on September 27, 1847, by Perrigrine Sessions and his family.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bountiful%2C_Utah"
    },
    {
      "id": 2,
      "text": "Before 1855, the area was called Sessions Settlement and North Canyon Ward, then renamed Bountiful for its gardening reputation and a Book of Mormon city.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bountiful%2C_Utah"
    },
    {
      "id": 3,
      "text": "Bountiful is Utah's second settlement after Salt Lake City.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bountiful%2C_Utah"
    },
    {
      "id": 4,
      "text": "Every July, Bountiful hosts Handcart Days, a volunteer‑driven celebration of pioneer history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bountiful%2C_Utah"
    },
    {
      "id": 5,
      "text": "The city grew rapidly in the 1940s‑60s, becoming Davis County's largest until Layton surpassed it in 1985.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bountiful%2C_Utah"
    },
    {
      "id": 6,
      "text": "The Bountiful Utah Temple, dedicated in 1995, stands beside the historic 1862 Tabernacle.",
