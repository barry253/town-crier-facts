      ],
      "source": "https://en.wikipedia.org/wiki/Columbia%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "Somerset Place State Historic Site, an antebellum plantation dating to 1785, opened as a state site in 1969 near Columbia.",
      "sourceSentenceIds": [
        9,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Columbia%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "Columbia lies on the eastern shore of the Scuppernong River in northern Tyrrell County, part of North Carolina’s Inner Banks.",
      "sourceSentenceIds": [
        11,
        5
      ],
      "sourceLabels": [
        "Web source 1",
