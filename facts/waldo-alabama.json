  "facts": [
    {
      "id": 1,
      "text": "Waldo emerged in the mid‑1840s around a grist mill and foundry founded by the Riddle family on Talladega Creek, becoming the town’s first economic hub.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/waldo_alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 115‑foot Waldo Covered Bridge, built in 1858, is the second‑oldest covered bridge in Alabama and still stands, though slowly decaying.",
      "sourceSentenceIds": [
        8,
        12,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/waldo/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original mill site has served as a coffin factory, town hall, and restaurant over the years, but is currently unoccupied.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/waldo/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1850s, a gold mine called Riddle’s Hole was discovered, prompting the community to build the covered bridge for access across Talladega Creek.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/waldo/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Creek War of 1813‑1814 shaped early land use in Talladega County, influencing settlement patterns around Waldo.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
