  "facts": [
    {
      "id": 1,
      "text": "Colebrook was incorporated in 1779 and named after the Devon village of Colebrooke, though the exact reason for the tribute has been lost to time.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ct.one/towns/colebrook",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s Algonquin State Forest sits in its center, offering miles of hiking and wildlife viewing right in the heart of Colebrook.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colebrook%2C_Connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The West Branch Reservoir, fed by the Colebrook River, supplies water to the surrounding region and is a popular spot for fishing and kayaking.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Colebrook%2C_Connecticut",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A historic dirt road in Colebrook was recently reopened after a committee reviewed best practices to protect it from heavy rainfall, preserving a scenic route.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofcolebrook.org/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The Colebrook Historical Society hosts an annual summer exhibit; its 2026 show, “Honoring Colebrook Veterans,” will open with refreshments on June 13.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
