  "facts": [
    {
      "id": 1,
      "text": "Warrensburg was originally called \"The Bridge\" because a bridge over the Schroon River connected settlers to the Adirondacks.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrensburg%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors James Warren, an early settler, not the county’s namesake General Joseph Warren.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warrensburg%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad spur from Thurman Station followed the Schroon River to Warrensburg, boosting raw material import and goods export.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrensburgheritagetrail.org/a-brief-history-of-warrensburg.html",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1813, James Warren drowned returning from an election, an event that marked the town’s early history.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrensburgheritagetrail.org/a-brief-history-of-warrensburg.html",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Richards Library, gifted in 1911 by Warren descendants, remains a historic community landmark.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.warrensburgheritagetrail.org/a-brief-history-of-warrensburg.html",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Warrensburg lies within the Adirondack Park, designated in 1894, preserving its wild forest heritage.",
