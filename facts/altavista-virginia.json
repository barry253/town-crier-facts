  "facts": [
    {
      "id": 1,
      "text": "Altavista began as Lane's Siding in 1907, a company town built by the Lane brothers to house workers for the Virginian Railway.",
      "sourceSentenceIds": [
        3,
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Altavista%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Within a year of its founding, the town boasted a $100,000 machine shop, a $20,000 foundry, and a $30,000 hotel nearing completion.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altavista%2C_Virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Lane Company, which later became the town’s namesake, was renamed in 1922 and expanded into furniture manufacturing by the mid‑20th century.",
      "sourceSentenceIds": [
        6,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Altavista%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Altavista received its first post office charter in 1912, marking the town’s formal entry into the national postal network.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/162-5005/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before European settlement, the area that is now Altavista was a Saponi tribal town known as “Sapon Town,” connected by paths that later guided colonists.",
      "sourceSentenceIds": [
        17,
