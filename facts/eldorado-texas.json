  "facts": [
    {
      "id": 1,
      "text": "Eldorado became the county seat of Schleicher County when the county was organized in 1901.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/eldorado-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named Eldorado by surveyor Silliman, who opened a store and offered free lots to attract settlers.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/eldorado-tx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1878 state grant promised a railroad to Eldorado, but the Houston East and West Texas Railway never laid track, and the company went into receivership in 1912.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/eldorado-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Eldorado’s historic downtown blends preserved traditions with modern city services, keeping the town’s unique character alive.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.eldorado-texas.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Visitors can tour the Schleicher County Courthouse, learn local history at the Eldorado Museum, or explore ranchlands surrounding the town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
