  "facts": [
    {
      "id": 1,
      "text": "Florence was named after Samuel Crawford’s daughter, Miss Florence Crawford of Topeka, when the town site was platted in 1870.",
      "sourceSentenceIds": [
        10,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.florenceks.com/text/city/city_history.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Florence Town Company chose a site where the Atchison, Topeka and Santa Fe Railroad would cross the Cottonwood River, sparking the town’s birth.",
      "sourceSentenceIds": [
        1,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.florenceks.com/text/city/city_history.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Because Florence sits at the Cottonwood River and Doyle Creek confluence, its first recorded flood hit in 1877 and floods have plagued the town ever since.",
      "sourceSentenceIds": [
        13,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://legendsofkansas.com/florence-kansas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Florence boasts five National Register of Historic Places sites, including the 1881 Doyle Place and the historic Fred Harvey House.",
