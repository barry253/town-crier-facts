      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town still hosts a preserved railroad depot that dates back to its early 1900s origins as a stop on the Oregon Short Line.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
