      "id": 1,
      "text": "Skwentna’s first European exploration began during the 1897–1898 Klondike Gold Rush, when prospectors prompted systematic surveys of the largely unknown area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
