  "facts": [
    {
      "id": 1,
      "text": "The Clear Lake region has been home to Pomo peoples for at least 12,000 years, with the Xa‑Ben‑Na‑Po Band among the earliest groups.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clearlake_park_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Mount Konocti, a 4,299‑foot volcanic dome east of the lake, was a sacred landmark for the Pomo, who used its obsidian for tools.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clearlake_park_california",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clearlake Park began as a subdivision in 1922, its boundaries first recorded in the townsite map filed that August in Lake County Records.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clearlake_park_california",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Clear Lake, estimated at nearly 500,000 years old, keeps regional water levels steady through its deep basin and limited outflow, protecting surrounding wetlands.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clearlake_park_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The now‑extinct Clear Lake splittail (Pogonichthys ciscoides) once thrived in the lake, highlighting the watershed’s historic biodiversity.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/clearlake_park_california",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Clear Lake Aquatic Website chronicles human impacts on the lake, offering a 20th‑century history of environmental changes.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
