    },
    {
      "id": 2,
      "text": "Brigham Young predicted in 1867 that towns would eventually be established in both the east and west parts of Goshen Valley.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genolaut.gov/about-us/"
    },
    {
      "id": 3,
      "text": "The Strawberry Reclamation Project eventually fulfilled Brigham Young's prophecy by bringing irrigation water to the east side of the valley.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://genolaut.gov/about-us/"
    },
    {
      "id": 4,
      "text": "Early colonists noted a horse-raising ranch named Stewart existed north of Warm Springs as early as 1856.",
