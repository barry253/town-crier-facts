      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Fontibón is the ninth locality of Bogotá, located in the city’s western sector.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fontib%C3%B3n",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The name Fontibón derives from the Muisca cacique Huintiva, meaning “powerful cacique” in Muysccubun.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fontib%C3%B3n",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before Spanish conquest, Fontibón belonged to the southern Muisca Confederation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fontib%C3%B3n",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1956 Fontibón merged with Bogotá, losing its status as an associate town.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fontib%C3%B3n",
      "category": "history",
      "quality": "good"
    },
