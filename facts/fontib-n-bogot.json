  "facts": [
    {
      "id": 1,
      "text": "Fontibón was the gate to Bogotá, founded by conquistador Gonzalo Jiménez de Quesada.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
