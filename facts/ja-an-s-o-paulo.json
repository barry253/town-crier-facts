  "facts": [
    {
      "id": 1,
      "text": "Jaçanã got its name from a river bird, the wattled jacana, in 1930.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ja%C3%A7an%C3%A3_(district_of_S%C3%A3o_Paulo)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1949, Jaçanã hosted São Paulo's first major film studio, the Cinematographic Company Maristela, which employed about 150 people per film.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Ja%C3%A7an%C3%A3_(district_of_S%C3%A3o_Paulo)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The district was once called Uroguapira in 1870 because locals believed gold existed there, a rumor that later shortened to Guapira.",
      "sourceSentenceIds": [
        10,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ja%C3%A7an%C3%A3_(district_of_S%C3%A3o_Paulo)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jaçanã became nationally known when Adoniran Barbosa immortalized it in the song “Trem das Onze,” inspired by the old Cantareira railway.",
      "sourceSentenceIds": [
        13,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ja%C3%A7an%C3%A3_(district_of_S%C3%A3o_Paulo)",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Cantareira Park, the largest native urban forest in the world, stretches into Jaçanã, offering a vast green corridor.",
      "sourceSentenceIds": [
        9
