  "facts": [
    {
      "id": 1,
      "text": "Spencer was named after the then‑acting governor of Massachusetts, Spencer Phips, in the 18th century.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencer%2C_Massachusetts"
    },
    {
      "id": 2,
      "text": "In 1888‑1889, David Prouty, Richard Sugden, Luther Hill and Nathaniel Myrick gifted Spencer a new high school, library, public park and fair grounds.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencer%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "The Spencer public library opened its doors in 1870, becoming a cornerstone of local learning.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencer%2C_Massachusetts"
    },
    {
      "id": 4,
      "text": "Inventor William Howe of Spencer built a pioneering wooden truss bridge, while his brother Tyler Howe patented the first spring bed.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencer%2C_Massachusetts"
    },
    {
      "id": 5,
      "text": "At its industrial peak, Spencer housed eleven factories and twenty‑six wire‑drawing buildings, a testament to its manufacturing boom.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Spencer%2C_Massachusetts"
    },
    {
      "id": 6,
      "text": "After years in town hall, the Spencer Historical Museum relocated to the mezzanine of the Richard Sugden Library in 1889.",
      "sourceSentenceIds": [
        30
      ],
