  "facts": [
    {
      "id": 1,
      "text": "Millican‑Ogden hosts several vintage homes, including the historic Ogden Hotel now called the Victory Centre.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millicanogden.com/community-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Jack Setters Arena indoor ice rink, built in 1974, honors a volunteer who shaped Calgary’s minor hockey scene.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millicanogden.com/community-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Millican’s name honors the Millican family, early 1900s homesteaders who settled the area.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://calgarycommunities.com/ca_neighbourhood/millican/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community’s annex, originally dressing rooms for an outdoor skating rink, now houses MOCA offices and an after‑school program.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.millicanogden.com/community-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Millican‑Ogden is one of Calgary’s oldest communities, with a history dating back to the early 20th century.",
      "sourceSentenceIds": [
        8
