  "facts": [
    {
      "id": 1,
      "text": "Stone Mountain is the largest exposed granite mass in the world, located in DeKalb County about ten miles northeast of downtown Atlanta.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/stone-mountain/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village at the mountain’s base began as Rock Mountain, became New Gibraltar in 1839, and was renamed Stone Mountain by legislature in 1847.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://stonemountainhistoricsociety.org/about-our-village/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A railroad depot built in the 1830s and 1840s made the town a shipping hub for granite, connecting Atlanta and other cities.",
      "sourceSentenceIds": [
        24,
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://stonemountainhistoricsociety.org/about-our-village/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Wells‑Brown House, an elegant 1870s neoclassical residence, now houses the Stone Mountain Historical Society.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stone_Mountain%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2017 the Southern Poverty Law Center described Stone Mountain as “the largest shrine to white supremacy in the history of the world.”.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/geography-environment/stone-mountain/",
