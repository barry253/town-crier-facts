  "facts": [
    {
      "id": 1,
      "text": "The Palais Garnier opera house, a neo‑Baroque masterpiece, boasts a grand staircase, dazzling chandeliers, and a rich history that dates back to the 19th century.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.parisrental.com/blog/living-better-in-paris/exploring-the-9th-arrondissement-of-paris-a-blend-of-history-culture-and-modern-vibes"
    },
    {
      "id": 2,
      "text": "Galeries Lafayette, founded in 1893, is famed for its stunning glass dome that offers panoramic views of Paris and a luxury shopping experience.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.parisrental.com/blog/living-better-in-paris/exploring-the-9th-arrondissement-of-paris-a-blend-of-history-culture-and-modern-vibes"
    },
    {
      "id": 3,
      "text": "Passage Jouffroy, opened in 1846, features an elegant glass roof and ornate ironwork, evoking the nostalgic atmosphere of 19th‑century Paris.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://en.parisrental.com/blog/living-better-in-paris/exploring-the-9th-arrondissement-of-paris-a-blend-of-history-culture-and-modern-vibes"
    },
    {
      "id": 4,
      "text": "Two historic churches grace the 9th: Saint‑Louis‑d'Antin, built in the 18th century, and Notre‑Dame‑de‑Lorette, completed in the 19th century.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/9th_arrondissement_of_Paris"
    },
    {
      "id": 5,
      "text": "Known as Opéra, the 9th arrondissement sits on the right bank of the Seine, overlooking the city’s historic heart.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/9th_arrondissement_of_Paris"
    },
    {
      "id": 6,
      "text": "The 9th hosts famed venues like the Olympia, Folies Bergère, and Théâtre Mogador, making it a hub for music and theatre.",
      "sourceSentenceIds": [
        20
      ],
