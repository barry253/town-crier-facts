      "id": 1,
      "text": "Mar Vista began as part of the 14,000‑acre Rancho La Ballona, a Mexican land grant awarded in 1839.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
