  "facts": [
    {
      "id": 1,
      "text": "South Shore, nicknamed the “village in the city,” sits along Chicago’s southern lakefront and has been a cultural hub since the 19th century.",
      "sourceSentenceIds": [
        4,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Shore%2C_Chicago"
    },
    {
      "id": 2,
      "text": "The neighborhood’s roots trace back to Algonquian peoples like the Mascouten and Miami before white settlers reshaped it in the 1800s.",
      "sourceSentenceIds": [
        8,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Shore%2C_Chicago"
    },
    {
      "id": 3,
      "text": "Jackson Park Highlands, at South Shore’s northern edge, showcases 19th‑century architecture in American Foursquare, Colonial Revival, and Renaissance Revival styles.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Shore%2C_Chicago"
    },
    {
      "id": 4,
      "text": "Legendary blues guitarist Bo Diddley called South Shore home, adding to its musical legacy.",
      "sourceSentenceIds": [
        9,
        15
      ],
      "sourceLabels": [
