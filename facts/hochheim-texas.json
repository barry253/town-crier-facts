  "facts": [
    {
      "id": 1,
      "text": "Hochheim was founded in the 1850s by German immigrant Valentine Hoch, a native of Alsace‑Lorraine, who contracted for a homesite before arriving.",
      "sourceSentenceIds": [
        3,
        5,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/hochheim-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name means “Hoch’s Home,” reflecting its origin as a hilltop homestead.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hochheim_texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Valentine Hoch’s 1856 stone house, built from Guadalupe River rocks, once served as an unofficial stagecoach inn for travelers.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hochheim_texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A railroad once ran through Hochheim, linking it to neighboring cities and boosting early commerce.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hochheim%2C_Texas",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hochheim earned a Texas Historical Medallion, honoring its preserved German‑immigrant heritage for its recognition of.",
      "sourceSentenceIds": [
        8,
        10,
        22
      ],
