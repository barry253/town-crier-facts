  "facts": [
    {
      "id": 1,
      "text": "Lacombe was once home to a diverse mix of businesses, including a coffin factory, a cigar factory, and a pine oil plant.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sttammanylibrary.org/blogs/post/history-at-a-glance-lacombe-gateway-to-the-big-branch-marsh-and-wildlife-refuge/"
    },
    {
      "id": 2,
      "text": "Lacombe served as the site for the Battle of Lake Pontchartrain, the only naval battle of the American Revolution involving British, American, and Spanish forces.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sttammanylibrary.org/blogs/post/history-at-a-glance-lacombe-gateway-to-the-big-branch-marsh-and-wildlife-refuge/"
    },
    {
      "id": 3,
      "text": "The Acolapissa and Choctaw tribes lived in the dense pines and marshy bayous of Lacombe before the first Europeans settled the area.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sttammanylibrary.org/blogs/post/history-at-a-glance-lacombe-gateway-to-the-big-branch-marsh-and-wildlife-refuge/"
    },
    {
      "id": 4,
      "text": "One theory suggests Lacombe was named after a Frenchman who traveled by schooner to supply charcoal to the colony of New Orleans.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sttammanylibrary.org/blogs/post/history-at-a-glance-lacombe-gateway-to-the-big-branch-marsh-and-wildlife-refuge/"
    },
    {
      "id": 5,
      "text": "Another theory claims Lacombe comes from the Choctaw word for the local bayou, which means squeezing.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
