      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Electricity arrived in Camp Nelson in 1951, electrifying the community after decades of isolation.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Nelson%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 1976 to 1979 the Civil War Re‑Enactment Society staged skirmishes in Nelson Meadow, echoing the town’s early frontier spirit.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
