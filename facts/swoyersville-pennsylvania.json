  "facts": [
    {
      "id": 1,
      "text": "Swoyersville was named after John Henry Swoyer, an early coal operator in the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pagenweb.org/~luzerne/patk/swoy1.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough incorporated in 1888 after originally being part of Kingston Township chartered by the Susquehanna Company in 1790.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pagenweb.org/~luzerne/patk/swoy1.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Coal mining dominated the town until the 1950s, with mines ceasing after the Knox Mine Disaster, yet work continued on Main Street into the 1960s.",
      "sourceSentenceIds": [
        21,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swoyersville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first coal shipment from the Maltby Colliery left Kingston Township via the Lackawanna and Bloomsburg Railroad in April 1858.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://pagenweb.org/~luzerne/patk/swoy1.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A massive coal ash pile, as tall as a 17‑story building, sits in the town surrounded by homes.",
