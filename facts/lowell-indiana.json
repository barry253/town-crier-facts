        2,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lowell.net/category/subcategory.php?categoryid=8",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Halsted named the new village Lowell after the New England town whose mills mirrored his own.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lowell.net/category/subcategory.php?categoryid=8",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lowell received its town charter on June 27, 1868, officially becoming an incorporated municipality.",
