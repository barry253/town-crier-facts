      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has been operating in Eddyville since 1869, keeping the village connected for over a century.",
      "sourceSentenceIds": [
        9,
        23
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Eddyville%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Eddyville was incorporated as a village in 1883, formalizing its status after more than fifteen years of settlement.",
      "sourceSentenceIds": [
        10,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
