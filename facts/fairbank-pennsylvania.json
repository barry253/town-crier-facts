    {
      "id": 1,
      "text": "Fairbank sits on land once traversed by Lenape and Iroquois hunters, traders, and migrants before European settlers arrived.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
