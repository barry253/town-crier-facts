  "facts": [
    {
      "id": 1,
      "text": "Whitlash owes its name to a typographical error that turned the original spelling 'Whiplash' into the town’s current name.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/127913",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened in 1892, originally applied as 'Whiplash,' but the returned application read 'Whitlash,' cementing the new spelling.",
      "sourceSentenceIds": [
        10,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitlash%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Access to Whitlash is limited to an unpaved road, giving it a remote, off‑highway feel.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitlash%2C_Montana",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The nearby Sweet Grass Hills, especially the East Butte, are historic landmarks sacred to American Indians for hunting, battle, and navigation.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whitlash%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Customs operated out of Whitlash from 1933 until 1969, when the facility moved to the actual border crossing.",
