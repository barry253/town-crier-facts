  "facts": [
    {
      "id": 1,
      "text": "In 1849, Irish miners renamed the settlement after their Iowa hometown, turning a Gold Rush camp into a bustling river town.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/camanche-california-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Camanche quickly became a key supply hub for prospectors, with water channeled through ditches like Lancha Plana and Poverty Bar to power mining operations.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/camanche_village_california",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the late 1860s, dwindling gold left Camanche a ghost town, and the 1960s dam project flooded the site beneath Camanche Reservoir.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/camanche-california-ghost-town/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A plaque at South Camanche Shore Park marks the town’s history, honoring the 254‑year legacy of the once‑thriving mining community.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://unitedstatesghosttowns.com/camanche-california-ghost-town/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Seasonal water levels rise with winter inflows from Pardee Reservoir, often filling the reservoir by spring, then dropping below half capacity during dry summers.",
