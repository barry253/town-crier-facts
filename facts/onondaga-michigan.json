  "facts": [
    {
      "id": 1,
      "text": "Onondaga, Michigan takes its name from the Iroquois nation of Onondaga, historically based in New York.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onondaga%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Michigan Central Railroad reached Onondaga in 1870, the town blossomed with new settlers and businesses.",
      "sourceSentenceIds": [
        6,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Onondaga%2C_Michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Oliver Booth, the town’s first settler from New York, arrived in 1834 and later became its first recorded death.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://99wfmk.com/onondagamichigan/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The First Congregational Church of Onondaga, built in 1877, remains a landmark of the town’s early religious life.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Onondaga%2C_Michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Onondaga Historical Society Museum lets visitors step back in time and explore the town’s rich past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://michiganinsider.blog/onondaga-mi-hidden-attractions",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A half‑mile east on Oak Road, the historic cemetery offers a quiet glimpse into Onondaga’s early residents.",
