    },
    {
      "id": 2,
      "text": "The community sits along Georgia State Route 99, 6.5 miles north‑northeast of Darien.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meridian%2C_Georgia",
