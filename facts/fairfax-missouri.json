      "id": 1,
      "text": "Fairfax, Missouri sprang to life in 1881 when the Tarkio Valley Railroad opened a 24.5‑mile branch through Atchison County.",
      "sourceSentenceIds": [
        1,
        8,
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairfax_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name changed from the proposed “Whiteson” to Fairfax shortly after its platting, honoring a local resident.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairfax_missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Fairfax Branch Library, part of the Atchison County Library system, keeps the town’s public reading tradition alive.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfax%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office has served Fairfax continuously since 1881, marking the town’s long‑standing communication link.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fairfax%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
