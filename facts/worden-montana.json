  "facts": [
    {
      "id": 1,
      "text": "Worden began as a Northern Pacific Railroad station called Clermont in 1882, renamed Worden in 1907 to honor Senator Thomas Dixon’s wife Frances.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/worden_montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on land once part of the Crow Indian Reservation and was mapped out in 1907 as part of the federal Huntley Project.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Worden%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Volga German immigrants founded Worden, bringing a German Congregational Church that remains a cultural landmark.",
      "sourceSentenceIds": [
        7,
        23
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/worden_montana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Pompey’s Pillar, a 150‑foot sandstone outcrop, rises just east of town along the Yellowstone River.",
