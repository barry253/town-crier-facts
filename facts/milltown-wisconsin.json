  "facts": [
    {
      "id": 1,
      "text": "Patrick Lillis named Milltown after the Irish village of his birth, which he felt the territory reminded him of.",
      "sourceSentenceIds": [
        1,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofmilltownwi.gov/history/"
    },
    {
      "id": 2,
      "text": "Patrick Lillis, an immigrant from Ireland, first made a claim on the land where Milltown now stands in 1856.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofmilltownwi.gov/history/"
    },
    {
      "id": 3,
      "text": "James and John Rogers are recognized as the first settlers of Milltown.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofmilltownwi.gov/history/"
    },
    {
      "id": 4,
      "text": "The Roman Catholic Church was organized in Milltown in 1864.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofmilltownwi.gov/history/"
    },
    {
      "id": 5,
      "text": "Railroad lines for the Soo Line were laid through Milltown in October 1901 and completed the following year.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
