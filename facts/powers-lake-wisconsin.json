  "facts": [
    {
      "id": 1,
      "text": "Powers Lake was originally called Lakeville and then Nippersink before being named after early settler and postmaster James B. Powers.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powers_Lake%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Powers Lake is an inland lake spanning 459 acres with a maximum depth of 33 feet.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://districtofpowerslake.com/lake-history-facts"
    },
    {
      "id": 3,
      "text": "Fishermen from Chicago helped develop the north shore of Powers Lake during the 1890s as recreational interest in the area grew.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powers_Lake%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Ice companies mined the south shores of Powers Lake in the 1890s, eventually establishing five different ice houses.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Powers_Lake%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "The Chicago Railway expanded agricultural opportunities for Powers Lake farmers in the 1870s by sending three trains a day to Chicago.",
      "sourceSentenceIds": [
