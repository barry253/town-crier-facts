  "facts": [
    {
      "id": 1,
      "text": "World Golf Village’s King & Bear course is the only golf course ever co‑designed by Arnold Palmer and Jack Nicklaus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.caddiehq.com/resources/what-is-world-golf-village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Walk of Champions and a large lake remain as legacy attractions, preserving the village’s historic roots.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.caddiehq.com/resources/what-is-world-golf-village",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 6,300‑acre site was approved in the 1990s as a Development of Regional Impact, shaping the village’s growth.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/World_Golf_Village",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Besides King & Bear, the Slammer & Squire course pays tribute to Sam Snead and Gene Sarazen, offering a unique short‑game challenge.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.golfwgv.com/about",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s origins trace back to a joint Golf Hall of Fame plan by the PGA Tour and LPGA, aiming to unite the sport’s history.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
