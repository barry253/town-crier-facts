      "id": 1,
      "text": "Saratoga was founded as McCarthysville in 1851 when Martin McCarthy built a toll road to Santa Clara Valley.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saratoga%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1865 the town adopted the name Saratoga after its springs matched those of Saratoga Springs, New York.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.saratoga.ca.us/271/History",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Miller‑Melone Ranch, the last prune ranch home, was listed on the National Register in 1993.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saratoga%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Villa Montalvo, Mountain Winery, and Hakone Gardens showcase Saratoga’s wineries, restaurants, and historic gardens.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saratoga%2C_California",
