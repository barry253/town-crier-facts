    },
    {
      "id": 3,
      "text": "Mormon pioneers began settling the West Mountain area in the mid-1800s, led by early arrivals George and Eliza Rust.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_mountain_utah_county_utah"
    },
    {
      "id": 4,
      "text": "Irrigation water from the Strawberry project enabled agricultural expansion and farming in West Mountain starting in 1916.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/west_mountain_utah_county_utah"
    },
    {
      "id": 5,
      "text": "West Mountain stands as a distinct ridge, disconnected from the main Wasatch Range due to ancient faulting and crustal extension.",
      "sourceSentenceIds": [
        22,
        30
