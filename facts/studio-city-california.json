      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original studio lot, now Radford Studio Center, remains a working production facility but is closed to public tours.",
      "sourceSentenceIds": [
        5,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
