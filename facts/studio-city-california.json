      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Studio City sits within the Santa Monica Mountains Conservancy, offering hiking trails and scenic vistas managed by the Mountains Recreation & Conservation Authority.",
      "sourceSentenceIds": [
