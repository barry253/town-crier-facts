  "facts": [
    {
      "id": 1,
      "text": "Brooke County was carved out of Ohio County in 1797 and named for Governor Robert Brooke, who served Virginia from 1794 to 1796.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brooke_County%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town of Brooke grew around a mid‑19th‑century crossroads owned by John Taliaferro Brooke, a landowner who ran a farm and grist mill there.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brooke_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Andrew Chapel United Methodist Church, built in 1845 and rebuilt in 1904, stands as a testament to the area’s long‑standing Methodist heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brooke_virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1921 Jethro Kloss opened a health‑food factory in Brooke, producing NUTO and authoring the herbal guide Back to Eden, sparking the organic movement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brooke_virginia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Brooke’s landscape features gently rolling hills, tidal marshes along Aquia Creek, and thin Coastal Plain sediments that create a varied topography shaped by fault‑line scarps.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brooke_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the Civil War, Brooke’s proximity to Aquia Landing made it a key Confederate logistics node where the railroad linked steamboats to Richmond.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
