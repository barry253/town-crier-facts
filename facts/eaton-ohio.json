  "facts": [
    {
      "id": 1,
      "text": "Eaton was founded and platted in 1806 by William Bruce, marking the town’s first official layout.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eaton%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s streets—Barron, Decatur, Israel, Wadsworth, and Somers—were named for heroes of the First and Second Barbary Wars.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eaton%2C_Ohio",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1846 Eaton’s population reached 1,000 as the community grew around the junction of two major turnpikes.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eaton%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Whispering Oak, a living landmark, was preserved thanks to Cotner and Price, who received city recognition.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofeaton.org/1/Home",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Crystal Lake and Seven Mile Creek flow through Eaton, offering residents and visitors a touch of natural beauty.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Eaton%2C_Ohio",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Eaton serves as the county seat of Preble County and lies roughly 24 miles west of Dayton.",
      "sourceSentenceIds": [
