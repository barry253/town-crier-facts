  "facts": [
    {
      "id": 1,
      "text": "Royal, Illinois is a tiny village where grain elevators sit at the crossroads of a railroad and County Road 20.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://villageofroyal.com/history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village’s John Lutheran Church was literally moved into town brick by brick, a project that began nearly a century ago.",
      "sourceSentenceIds": [
        6,
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Royal%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After the church’s relocation, the congregation rebuilt a new Community Building from the salvaged bricks, finishing it the year after Royal’s centennial.",
      "sourceSentenceIds": [
        14,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Royal%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the John Lutheran Church still welcomes about 831 members, with an average attendance of 200 people at services.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Royal%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Community Building, built from the church’s reclaimed bricks, remains a venue for local events and gatherings, sometimes for as little as $85.00 for a small group.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Royal%2C_Illinois",
      "category": "landmark",
      "quality": "good"
    }
