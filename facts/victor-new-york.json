  "facts": [
    {
      "id": 1,
      "text": "Victor is named after Claudius Victor Boughton, a War of 1812 hero who became an Erie Canal contractor in 1822.",
      "sourceSentenceIds": [
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.townofvictorny.gov/396/Historian-Articles"
    },
    {
      "id": 2,
      "text": "Ganondagan State Historic Site, also called Boughton Hill, preserves a Seneca village that flourished more than 300 years ago.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://destinationvictorny.com/tourism-attractions"
    },
    {
      "id": 3,
      "text": "The Seneca Art & Culture Center, opened in 2015 on the Ganondagan grounds, showcases Haudenosaunee heritage through art and oral history.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Victor%2C_New_York"
    },
    {
      "id": 4,
      "text": "Friends of the Railroad, founded in 2008, has organized 56 family‑fun train excursions with the Finger Lakes Railway, most of which sold out.",
      "sourceSentenceIds": [
