  "facts": [
    {
      "id": 1,
      "text": "Enola’s early name, Fredrick’s Lick, comes from a natural salt lick near Cadron Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.faulknerhistory.org/communities/enola/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first settlers were four Wyler brothers who lived in a small hut on the East Cadron.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.faulknerhistory.org/communities/enola/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jonathan Hardin, a principal founder, arrived in 1837 and set up a farm on a hill west of Fredrick’s Lick.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.faulknerhistory.org/communities/enola/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hardin owned a coal mine and blacksmith shop, and his two‑story house doubled as an inn and tavern at a key crossroads.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.faulknerhistory.org/communities/enola/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Folktales claim Hardin buried his fortune beneath a large tree near his home.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.faulknerhistory.org/communities/enola/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "In the late 1840s, a log building at Siloam Springs became the first Mount Zion Baptist Church and schoolhouse.",
      "sourceSentenceIds": [
        30
      ],
