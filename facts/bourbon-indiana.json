  "facts": [
    {
      "id": 1,
      "text": "Bourbon took its name from Bourbon Township, itself named after Bourbon County, Kentucky, where many early settlers came from.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourbon%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was laid out in 1853 in anticipation of the railroad, which arrived in 1856 and spurred a lumber boom.",
      "sourceSentenceIds": [
        3,
        7,
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourbon%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bourbon’s Community Building‑Gymnasium earned a spot on the National Register of Historic Places in 2015, preserving its 19th‑century heritage.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bourbon%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bourbon Cornet Band, founded in 1866, reflects the town’s long‑standing musical tradition.",
