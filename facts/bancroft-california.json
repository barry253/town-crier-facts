    {
      "id": 1,
      "text": "Bancroft Ranch House, once Hubert Howe Bancroft’s home, is now a National Historic Landmark in Bancroft.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubert_Howe_Bancroft",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Bancroft’s parents ran a station on the Underground Railroad, making the family home a secret refuge for escaped slaves.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubert_Howe_Bancroft",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bancroft dreamed of a 39‑volume history covering the Pacific coast from Central America to Alaska.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubert_Howe_Bancroft",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "A fire at Bancroft & Company destroyed the original sheets of seven volumes of that ambitious history.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubert_Howe_Bancroft",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Though he never earned a college degree, Bancroft received an honorary Master of Arts from Yale in 1875 for his work on Native races.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hubert_Howe_Bancroft",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "Bancroft devoted himself entirely to writing after amassing a vast library of historical material and abandoning business.",
