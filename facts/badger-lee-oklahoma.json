    {
      "id": 2,
      "text": "The Kansas and Arkansas Valley Railway brought tracks through the region between 1888 and 1890, encouraging early agricultural development.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/badger_lee_oklahoma"
    },
    {
      "id": 3,
      "text": "Badger Lee features a humid subtropical climate with hot, humid summers and mild winters influenced by the Gulf of Mexico.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/badger_lee_oklahoma"
    },
    {
      "id": 4,
      "text": "All residents of Badger Lee lived in the same house as the previous year, indicating very minimal mobility in the community.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/badger_lee_oklahoma"
    },
    {
      "id": 5,
      "text": "Badger Lee relocated to its present site in Sequoyah County during the mid-twentieth century to adapt to changing rural needs.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/badger_lee_oklahoma"
    },
    {
      "id": 6,
      "text": "The Cookson Hills Electric Cooperative extended power lines to Badger Lee in 1948, enabling mechanized farming and household appliances.",
