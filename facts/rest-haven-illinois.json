      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Agricultural growth in Rest Haven accelerated after 19th‑century railroads expanded through Kendall County, linking farms to larger markets.",
      "sourceSentenceIds": [
        1
