  "facts": [
    {
      "id": 1,
      "text": "Historic Fort Stockton, founded in 1858 as Camp Stockton, guarded the San Antonio‑to‑El Paso mail route and cattle drives.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://bigbendtimes.com/2025/01/09/yes-theres-a-fort-in-fort-stockton-explore-the-history-of-historic-fort-stockton/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort’s original buildings, including Officers’ Row and the Guardhouse, were rebuilt to show 19th‑century frontier life.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://bigbendtimes.com/2025/01/09/yes-theres-a-fort-in-fort-stockton-explore-the-history-of-historic-fort-stockton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buffalo Soldiers of the 9th Cavalry garrisoned Fort Stockton, making it a key military post during the Indian Wars.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historicfortstockton.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stockton Bend, formerly Brazos Bend, was incorporated in May 2004 and sits on both sides of the Brazos River where it forms Lake Granbury.",
      "sourceSentenceIds": [
        6,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockton_Bend%2C_Texas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "The city’s name changed to Stockton Bend in 2024, reflecting its location on the river’s dramatic bend.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stockton_Bend%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Fort Stockton Historical Society now manages the fort, opening it to visitors who can explore the restored Guardhouse and Parade Grounds.",
