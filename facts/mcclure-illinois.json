  "facts": [
    {
      "id": 1,
      "text": "McClure was first settled in 1811 and was originally called Clear Creek Landing before the post office opened in 1836.",
      "sourceSentenceIds": [
        13,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McClure%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village’s name changed to McClure in 1895 when the postmaster renamed the office to avoid confusion with Wheaton, Illinois.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McClure%2C_Illinois"
    },
    {
      "id": 3,
      "text": "The McClure family’s historic house is listed on the National Register of Historic Places, a rare honor for a small Illinois village.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McClure%2C_Illinois"
    },
    {
      "id": 4,
      "text": "McClure became an incorporated village only in 2004, long after its early 19th‑century roots.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McClure%2C_Illinois"
    },
    {
      "id": 5,
      "text": "Today McClure is part of the Cape Girardeau–Jackson Metropolitan Statistical Area, linking it to a larger regional community.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McClure%2C_Illinois"
    },
    {
      "id": 6,
      "text": "The village’s early settlers, including the McClure family, were prominent local farmers who raised seven children together.",
