  "facts": [
    {
      "id": 1,
      "text": "Bergmannstraße earned its name from Marie Luise Bergmann, a landowner who owned property around the street.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.berlin.de/en/attractions-and-sights/3560259-3104052-bergmannstrasse.en.html",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Holy Trinity Church, a Baroque Protestant church, opened in August 1739 and was the newest Protestant building in Berlin for a century.",
      "sourceSentenceIds": [
        2,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holy_Trinity_Church%2C_Berlin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Its architect, Christian August Naumann, designed the church as a circular building with a 22‑meter dome and a lantern bell tower.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holy_Trinity_Church%2C_Berlin",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During Napoleon’s occupation, the church served as a barracks, while theologian Friedrich Schleiermacher preached there from 1809 to 1834.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holy_Trinity_Church%2C_Berlin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The church was destroyed by bombing in November 1943, and its ruins later housed a Nazi Party bunker used for interrogations in 1945.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holy_Trinity_Church%2C_Berlin",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "After the war, the congregation continued services in a rectory on Wilhelmstraße until at least the 1970s, keeping the parish alive despite the church’s loss.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Holy_Trinity_Church%2C_Berlin",
      "category": "history",
      "quality": "good"
    }
