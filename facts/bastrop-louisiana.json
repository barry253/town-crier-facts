      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Great Mississippi Flood of 1927, Bastrop hosted a relief camp that sheltered thousands of refugees.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bastrop%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "World War II saw Bastrop host a German prisoner‑of‑war camp, a little‑known chapter of its history.",
      "sourceSentenceIds": [
