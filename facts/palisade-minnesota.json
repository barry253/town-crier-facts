  "facts": [
    {
      "id": 1,
      "text": "Palisade earned its name from a Soo Line Railroad official who noted the high embankments flanking the Mississippi River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palisade%2C_Minnesota"
    },
    {
      "id": 2,
      "text": "The town became an independent village on July 7, 1922, and split from Logan Township on September 19 of the same year.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Palisade.htm"
    },
    {
      "id": 3,
      "text": "Palisade’s first post office opened in 1910, long before the town’s official incorporation.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lakesnwoods.com/Palisade.htm"
    },
    {
      "id": 4,
      "text": "The Mississippi River cuts through Palisade, giving the town a scenic waterway that runs through its center.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Palisade%2C_Minnesota"
    },
    {
      "id": 5,
      "text": "Main Street in Palisade is also known as Aitkin County Road 3, a key local thoroughfare.",
      "sourceSentenceIds": [
