  "facts": [
    {
      "id": 1,
      "text": "Founded in 1872 by the Central Pacific Railroad, Fresno grew into an agricultural hub thanks to the fertile San Joaquin Valley soil and sunny climate.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
