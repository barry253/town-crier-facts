      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Atchison, Topeka and Santa Fe Railway reached the area in 1880, San Acacia became a key siding and station stop.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
