  "facts": [
    {
      "id": 1,
      "text": "Hastings, founded in 1889, was named for Daniel Hartman Hastings, who later served as Pennsylvania’s governor from 1895 to 1899.",
      "sourceSentenceIds": [
        1,
        2,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.hastingsborough.com/history"
    },
    {
      "id": 2,
      "text": "The Pennsylvania Railroad was extended from LaJose to Hastings in the late 1880s, opening the town to efficient coal shipment.",
      "sourceSentenceIds": [
        3,
        10,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.hastingsborough.com/history"
    },
    {
      "id": 3,
      "text": "Hastings became an official borough on December 4, 1894, formalizing its municipal governance after years of rapid growth.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.hastingsborough.com/history"
    },
    {
      "id": 4,
      "text": "The borough sits in the valley of Brubaker Run, a tributary that feeds Chest Creek and the West Branch Susquehanna River.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hastings%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "Today Hastings emphasizes community services and historical preservation, tackling past water supply issues and public health epidemics.",
