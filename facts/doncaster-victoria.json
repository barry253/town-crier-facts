    },
    {
      "id": 2,
      "text": "Although early settlers were German, the town’s name shifted from Waldau to the more familiar Doncaster, a change that stuck.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
