  "facts": [
    {
      "id": 1,
      "text": "LaBarque Creek takes its name from Jean Baptiste LaBarque, a French fur trader who settled there in the late 1700s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/missouri_labarque-creek",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "LaBarque Creek hosts 36 native fish species, making it the most diverse tributary of the Meramec River.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mdc.mo.gov/discover-nature/places/natural-areas/labarque-creek",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Birdwatchers will spot over 40 breeding species and plant enthusiasts will see more than 400 native plants in the area.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mdc.mo.gov/discover-nature/places/natural-areas/labarque-creek",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The hills around LaBarque Creek feature desert‑like sandstone glades with prickly‑pear cactus beside moist box canyons that once hosted Ice Age plants.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mdc.mo.gov/discover-nature/places/natural-areas/labarque-creek",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Conservation staff restore the glades and woodlands using prescribed fire and thinning to preserve native habitats.",
