  "facts": [
    {
      "id": 1,
      "text": "Washington, Louisiana, founded in 1720 as a French trading post on Bayou Courtableau, is the state’s third‑oldest settlement.",
      "sourceSentenceIds": [
        1,
        5,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofwashingtonla.net/historical-landmarks-1",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Steamboats once raced up Bayou Teche to Washington, but a tight bend at the port made turning impossible, creating a historic bottleneck.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every year, Washington celebrates the Washington Catfish Festival, a lively event that evolved from the town’s former Festival du Courtableau.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington%2C_Louisiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Old Steamboat Warehouse on Bayou Courtableau, just upstream from the turnaround, reminds us of the steamboat era that ended with the railroad in the late 1800s.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.townofwashingtonla.net/our-history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Washington was officially incorporated in 1835, adopting its current name after evolving from the post of Opelousas.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Washington%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "About 80 percent of Washington’s historic homes and businesses are listed on the National Historic Registry, preserving a 19th‑century Louisiana atmosphere.",
      "sourceSentenceIds": [
        13,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://townofwashingtonla.net/historical-landmarks-1",
      "category": "landmark",
      "quality": "good"
    }
