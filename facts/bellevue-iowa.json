    {
      "id": 1,
      "text": "Bellevue’s name comes from French 'belle vue', meaning 'beautiful view', reflecting its scenic Mississippi River vistas.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.bellevueia.gov/for_visitors/index.php",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Peter Dutell built the first hotel, the Bellevue House, in 1836, the same year the town was founded.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellevue%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 19th century, hundreds of river steamboats docked at a grand staircase that connected Riverfront Park to the riverbank, ferrying passengers and goods.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellevue%2C_Iowa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The east–west railroad that once ran through Bellevue closed in the 1930s, leaving only a north–south line owned by Canadian Pacific Railway.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellevue%2C_Iowa",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The 1840 Bellevue War left the town with a tarnished reputation, slowing settlement for years afterward.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bellevue%2C_Iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bellevue sits in a valley carved by two large bluffs, with the Mississippi River forming its eastern border.",
