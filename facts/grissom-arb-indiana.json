  "facts": [
    {
      "id": 1,
      "text": "Grissom Arb began as Naval Reserve Air Base Peru in 1942, training Navy, Marine, and Coast Guard pilots during World War II.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grissom_Air_Reserve_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1968 the installation was renamed Grissom Air Force Base to honor Virgil I. “Gus” Grissom, an Indiana astronaut who perished on the Apollo 1 fire.",
      "sourceSentenceIds": [
        2,
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Grissom_Air_Reserve_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 9,928‑foot railroad spur once linked Grissom Arb to the Pennsylvania Railroad, easing supply deliveries during its early years.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grissom_Air_Reserve_Base",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1991 Base Realignment and Closure decision downsized the site to an Air Force Reserve installation, and it became Grissom Air Reserve Base in 1994.",
      "sourceSentenceIds": [
        6,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Grissom_Air_Reserve_Base",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During the war, the base’s training facilities included 25‑foot high platforms that simulated aircraft carrier decks for lifeboat and abandon‑ship drills.",
      "sourceSentenceIds": [
        22,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/grissom-air-museum-peru-indiana/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 6,
      "text": "Grissom Arb’s history reflects a shift from Navy training to Air Force reserve operations, mirroring broader U.S. military realignment after WWII.",
      "sourceSentenceIds": [
