  "facts": [
    {
      "id": 1,
      "text": "Hydro was founded on August 6, 1901, when the Wichita and Caddo Reservation opened for settlement.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HY001"
    },
    {
      "id": 2,
      "text": "Originally called Caddo, the town was renamed Hydro in 1901 to honor its plentiful well water.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hydro%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "The Hydro Harvest Festival is reportedly the longest running free fair in the state of Oklahoma.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HY001"
    },
    {
      "id": 4,
      "text": "Lucille's, also known as the Provine Service Station, was listed in the National Register of Historic Places in 1997.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=HY001"
    },
    {
      "id": 5,
      "text": "Natural features in the area are known as the Caddo Mounds, Antelope Buttes, and Hydro Mounds.",
