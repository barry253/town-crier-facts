      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town is part of the Bloomington Metropolitan Area, linking it to a larger regional community.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/town-lyons-indiana.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
