  "facts": [
    {
      "id": 1,
      "text": "Schulenburg sprang in 1873 when the Galveston, Harrisburg and San Antonio Railway cut through the area, naming the town after land donor Louis Schulenburg.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/schulenburg-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic depot sits on land once owned by Louis Schulenburg, the same man whose name lives on the town.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schulenburg%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Schulenburg Historical Museum, opened by John and Karen Wolters, preserves artifacts in two historic buildings and offers free admission.",
      "sourceSentenceIds": [
        5,
        26
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://schulenburghistoricalmuseum.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Polka music pulses through Schulenburg’s streets, home to the Gold Chain Bohemian Band and the Texas Polka Music Museum.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/schulenburg-tx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Schulenburg Sticker, a newspaper founded by German immigrant Ernst Goeth, has been printed continuously since 1894.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Schulenburg%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Two nearby 1842 settlements, Lyons and High Hill, merged into Schulenburg, giving the town its early roots.",
