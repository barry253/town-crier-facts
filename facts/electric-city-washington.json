  "facts": [
    {
      "id": 1,
      "text": "Electric City earned its name from the nearby Grand Coulee Dam, one of the world's largest hydroelectric plants.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1934, Electric City sprang up to house workers building the Grand Coulee Dam.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "President Roosevelt stopped in Electric City during his 1934 tour of the dam site, and by August that year 500 lots were platted.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A post office opened in June 1935, followed by a school a year later, marking the town’s early growth.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Electric City sits near the northern end of the Grand Coulee, southwest of the dam and linked by State Route 155.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Electric_City%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "July highs average 88°F while January lows dip to 21°F, reflecting the sharp continental swings east of the Cascades.",
