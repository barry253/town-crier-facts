    {
      "id": 1,
      "text": "Kimball Junction takes its name from William Henry Kimball, who opened a stagecoach stop that became the town’s first gathering place.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
