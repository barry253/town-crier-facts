  "facts": [
    {
      "id": 1,
      "text": "Mount Sterling was laid out in 1828 by John J. Smith on a bluff overlooking Deer Creek.",
      "sourceSentenceIds": [
        4,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://mtsterling.org/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was officially recorded at the London courthouse on June 26, 1829, and named after its founder’s hometown.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://mtsterling.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office opened on June 8, 1830, with Rowland Wilson as the first postmaster, before closing a year later.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Sterling%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1884 the Columbus and Midland Railway built a line through Mount Sterling, establishing a station that boosted local trade.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mtsterling.org/history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s first public library opened in 1910, following earlier municipal efforts like installing electric lighting in the 1890s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mtsterling.org/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The old town hall, a local landmark, burned in November 1983, marking the end of an era for the community.",
