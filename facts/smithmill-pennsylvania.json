  "facts": [
    {
      "id": 1,
      "text": "Smithmill, also called Janesville, is an unincorporated community in Gulich Township, Clearfield County, Pennsylvania.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Janesville%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "It sits at the intersection of state routes 253, 453, and 729, just 2.9 miles south-southwest of Ramey.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Janesville%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "The cornerstone of Clearfield County’s courthouse was laid on June 4, 1860, and the building was completed in 1862 during the Civil War.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitclearfieldcounty.org/historical_sites"
    },
    {
      "id": 4,
      "text": "The first courthouse, built around 1814, served the county for 46 years before the current structure was erected.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitclearfieldcounty.org/historical_sites"
    },
    {
      "id": 5,
      "text": "Clearfield County Courthouse is listed on the National Register of Historic Places, recognizing its architectural and historical significance.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitclearfieldcounty.org/historical_sites"
    },
    {
      "id": 6,
      "text": "The town’s first county jail, a log structure built between 1820 and 1841, remains one of Smithmill’s oldest buildings.",
      "sourceSentenceIds": [
        9
