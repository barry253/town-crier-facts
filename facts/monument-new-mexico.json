      "id": 1,
      "text": "Monument got its name from a vital spring marked by a cowboy‑built rock mound, a key water source in the Llano Estacado.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
