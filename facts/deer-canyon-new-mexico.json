  "facts": [
    {
      "id": 1,
      "text": "Deer Canyon Preserve is a 5,187‑acre conservation easement donated in 2012 to the New Mexico Land Conservancy, protecting open space, wildlife corridors, and scenic views.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_canyon_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Deer Canyon sits atop Chupadera Mesa, a prominent geologic feature known for expansive plateaus and incised drainages.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_canyon_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The CDP lies at the base of 400‑foot cliffs that rise to the southeast, giving the area a rugged topography.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Deer_Canyon%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The CDP covers almost 8 square miles of piñon‑juniper woodlands and grasslands, with no water bodies, typical of arid high‑desert terrain.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_canyon_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Summers bring daytime highs in the upper 80s to low 90s, while winters average lows around 20°F and about 14 inches of snowfall annually.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/deer_canyon_new_mexico",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "The community’s development began in 2005 as a master‑planned conservation community by developer Jim Winder, blending homes with environmental protection.",
