  "facts": [
    {
      "id": 1,
      "text": "Beccaria Township was carved from Clearfield County in 1807 and named after Cesare Beccaria, the Italian Enlightenment thinker.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://glendalevalley.org/beccaria-township-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township surrounds the boroughs of Coalport, Glen Hope, and Irvona, while bordering the borough of Glen Hope on three sides.",
      "sourceSentenceIds": [
        10,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://glendalevalley.org/beccaria-township-history/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Clearfield Creek, a tributary of the West Branch Susquehanna River, winds through Beccaria from south to north.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beccaria_Township%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1790s, Revolutionary War veteran Capt. Keagy founded the Mount Pleasant Baptist Church and later built a schoolhouse in the township.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://glendalevalley.org/beccaria-township-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A small section of Pennsylvania State Game Lands Number 60 lies along Beccaria’s eastern border, north of the township’s center.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Beccaria_Township%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The southeastern tip of Beccaria sits where Muddy Run meets the Cambria–Clearfield county line, marking the township’s extreme point.",
      "sourceSentenceIds": [
        25
