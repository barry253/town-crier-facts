  "facts": [
    {
      "id": 1,
      "text": "Kipnuk means a 'bend' referring to the bend in the Kugkaktlik River where it is situated.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kipnuk%2C_Alaska"
    },
    {
      "id": 2,
      "text": "The climate here is subarctic, characterized by maritime influences that bring cool summers and cold, snowy winters, shaping the rugged landscape that surrounds the settlement.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kipnuk"
    },
    {
      "id": 3,
      "text": "Kipnuk evolved from a seasonal hunters’ camp into a permanent village with a post office and school in the early 20th century.",
      "sourceSentenceIds": [
        26,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kipnuk/history"
    },
    {
      "id": 4,
      "text": "Early residents built semi‑subterranean sod houses using sod, driftwood, and animal skins, a hallmark of Arctic functionalism.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kipnuk/history"
    },
    {
      "id": 5,
      "text": "The community is predominantly inhabited by Central Yup'ik people, and the history of Kipnuk is rich with traditions that have survived for generations.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kipnuk"
    },
    {
      "id": 6,
      "text": "Kipnuk sits on the Kugkaktlik River, a tributary of the Bering Sea, providing vital water transport routes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/kipnuk/history"
    }
  ]
