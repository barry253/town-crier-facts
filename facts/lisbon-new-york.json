    },
    {
      "id": 2,
      "text": "Lisbon was named after Lisburn, a town in northern Ireland, rather than Portugal’s capital.",
      "sourceSentenceIds": [
        2,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_New_York"
    },
    {
      "id": 3,
      "text": "Lisbon became the first town in Lawrence County when it was formed in 1801, before the county itself existed.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_New_York"
    },
    {
      "id": 4,
      "text": "Lisbon Town Hall, the United Presbyterian Church, and the Hepburn Library are all listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lisbon%2C_New_York"
    },
    {
      "id": 5,
      "text": "The first European‑American settlers arrived around 1789, many coming from New England to purchase land.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
