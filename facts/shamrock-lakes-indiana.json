      "id": 1,
      "text": "Shamrock Lakes earned national attention when USA Today highlighted it as one of only five U.S. places named after Ireland’s shamrock emblem.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
