      "id": 1,
      "text": "Ulen was named after industrialist Henry Ulen, whose legacy lives on in the town’s history.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ulen%2C_Indiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town officially incorporated in 1929, just five years after the Ulen Country Club opened its doors in 1924.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ulen%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Ulen’s historic district earned a spot on the National Register of Historic Places in 2015, preserving its early 20th‑century charm.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ulen%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Henry Ulen, a Boone County contractor, founded several construction firms in the early 1900s before passing in 1963.",
