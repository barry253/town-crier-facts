      "id": 1,
      "text": "Nikolaevsk was founded in 1968 by five Russian Old Believer families who left Oregon to preserve their ancient faith, naming the town after Saint Nicholas.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
