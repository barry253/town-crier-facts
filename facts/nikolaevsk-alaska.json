      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before settling in Alaska, the Old Believers lived near Harbin, China, and São Paulo, Brazil, before arriving in the United States.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
