  "facts": [
    {
      "id": 1,
      "text": "Old Mission was founded in 1839 by Presbyterian missionaries Peter Dougherty and John Fleming to serve the Ojibwe and Odawa tribes.",
      "sourceSentenceIds": [
        1,
        3,
        5,
        30
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/old_mission_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened in 1851 as Grand Traverse and was renamed Old Mission in 1869 to honor its missionary heritage.",
      "sourceSentenceIds": [
        2,
        4,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/old_mission_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1852 Dougherty planted the first cherry trees on the peninsula, launching the region’s now-famous cherry industry.",
      "sourceSentenceIds": [
        24,
        27
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/old_mission_michigan",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1842 Dougherty Mission House and 1856 Hessler Log House, both on the National Register, preserve the town’s early history.",
      "sourceSentenceIds": [
        16,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/old_mission_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Old Mission Point Lighthouse, built in 1869, stands as a Michigan State Historic Site overlooking Grand Traverse Bay.",
      "sourceSentenceIds": [
        17,
        14
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/old_mission_michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Limestone-rich soils and Lake Michigan’s moderating climate make the peninsula ideal for vineyards, now hosting over a dozen wineries.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/old_mission_michigan",
      "category": "nature",
      "quality": "good"
    }
