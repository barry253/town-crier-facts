      "id": 1,
      "text": "Liberty is the county seat of Union County, founded in the early 1800s, with a post office operating since 1824.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
