  "facts": [
    {
      "id": 1,
      "text": "Cavendish was likely named after William Cavendish, the fourth Duke of Devonshire.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
