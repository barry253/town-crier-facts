  "facts": [
    {
      "id": 1,
      "text": "Caledonia was founded in 1819 by Scotsman Alexander Craighead, who named it after Scotland, Latin Caledonia.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://missourilife.com/visit-caledonia-missouri-2/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s oldest house, Craighead House, still stands and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://missourilife.com/visit-caledonia-missouri-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every summer, Caledonia hosts Front Porch Pickin’, where local shops and restaurants play live music on their porches.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://missourilife.com/visit-caledonia-missouri-2/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Battle of Pilot Knob Historic Site, a short drive from Caledonia, preserves the Civil War battle that shaped the region.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://missourilife.com/visit-caledonia-missouri-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Goose Creek runs through the village, and just a mile northeast lies Spring Glen Lake, a local spot for fishing and picnics.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caledonia%2C_Missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Caledonia’s historic district, including the Tyro Masonic Lodge, is the oldest continuously operating lodge in Missouri.",
      "sourceSentenceIds": [
