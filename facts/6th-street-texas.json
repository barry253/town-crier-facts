  "facts": [
    {
      "id": 1,
      "text": "Sixth Street was once called Pecan Street, part of Austin's tree‑named east–west grid, a naming scheme still used for north–south streets.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sixth_Street_(Austin)",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The arrival of the railroad in 1871 boosted Sixth Street, drawing prestigious businesses to the area near the depot.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sixth_Street_(Austin)",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1887 a 80‑foot bridge over Shoal Creek was built to match Sixth Street’s width; the West Sixth Street Bridge still stands and is on the National Register.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sixth_Street_(Austin)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ritz, a historic theater on 320 East 6th Street, opened in 1929 and has hosted movies, music, comedy, and now a comedy club.",
      "sourceSentenceIds": [
        8,
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sixth_Street_(Austin)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Scarbrough Building, an eight‑story brick skyscraper at 6th and Congress, was Austin’s first modern skyscraper built in 1909 and still bears its classic marquee.",
