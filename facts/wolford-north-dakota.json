  "facts": [
    {
      "id": 1,
      "text": "Wolford was originally called Orkney, honoring Scottish homesteaders, before a Great Northern Railroad agent renamed it in 1905.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wolford_north_dakota"
    },
    {
      "id": 2,
      "text": "Wolford lies near the drainage basin of the Souris River, also known as the Mouse River, which influences the regional hydrology.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wolford_north_dakota"
    },
    {
      "id": 3,
      "text": "Wolford's sole public school, Wolford Public School, closed its doors in 2019, ending a long local educational tradition.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wolford%2C_North_Dakota"
    },
    {
      "id": 4,
      "text": "Early Wolford settlers faced health risks like diphtheria due to isolation, relying on mutual aid before medical facilities arrived.",
