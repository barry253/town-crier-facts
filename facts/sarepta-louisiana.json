  "facts": [
    {
      "id": 1,
      "text": "Sarepta grew around the Old Sarepta Baptist Church, built in 1868 and named for Sarepta Carter, who donated a Bible to the congregation.",
      "sourceSentenceIds": [
        2,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sarepta,_Louisiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Louisiana and Arkansas Railroad reached Sarepta in 1898, boosting market access and encouraging new homesteads along its line.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sarepta,_Louisiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Allen built the first general store half a mile from the church near an old hickory tree, a landmark that helped early settlers trade.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sarepta,_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Sarepta was incorporated as a village on July 1, 1955.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sarepta,_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early settlers like William S. Denman and James M. Moore purchased land in the 1848‑1850s, laying the groundwork for a farming community.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
