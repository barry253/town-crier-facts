      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The town grew up around a station on the East Line and Red River Railroad, built through western Morris County in the late 1870s.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cason-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cason was named after its founder’s father, J. Cason, honoring his legacy.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cason-tx",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Many early businesses moved from the nearby community of Snow Hill, just three miles north.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cason-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The post office, originally in Snow Hill, was relocated to Cason in 1878, marking a key moment in the town’s development.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cason-tx",
      "category": "history",
      "quality": "good"
    },
    {
