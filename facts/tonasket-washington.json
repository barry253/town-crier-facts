  "facts": [
    {
      "id": 1,
      "text": "Tonasket takes its name from Chief Tonasket, a prominent Okanogan leader who rose to grand chief after the 1846 Oregon Treaty.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tonasket%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was officially incorporated on December 16, 1927, after being platted in 1910 and operating a post office since 1901.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tonasket%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tonasket sits on the eastern bank of the Okanogan River, flanked by Siwash Creek to the north and Bonaparte Creek to the south.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tonasket%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Walter Brattain, a native of the area, shared the 1956 Nobel Prize for Physics for inventing the transistor while working at Bell Labs.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tonasket%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every summer, the Okanogan Family Barter Faire brings thousands of visitors to trade handmade goods, vintage clothing, and local produce in Tonasket.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tonasket%2C_Washington",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Tonasket experiences a dry-summer continental climate, with hot, dry summers and cold, snowy winters typical of north-central Washington.",
      "sourceSentenceIds": [
        17
