  "facts": [
    {
      "id": 1,
      "text": "Granite Quarry got its name in 1902 when the post office renamed itself after the local granite industry.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite_Quarry%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s oldest building, the Old Stone House, was built in 1766 by German immigrant Michael Braun and now serves as a museum.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitrowancountync.com/places-to-visit/granite-quarry/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every summer, Granite Quarry hosts GermanFest, a cultural celebration that showcases the town’s German heritage with food, music, and crafts.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitrowancountync.com/places-to-visit/granite-quarry/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Michael Braun House and Granite Quarry School are listed on the National Register of Historic Places, highlighting the town’s historic architecture.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite_Quarry%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town hall, originally built in 1963 by Gemgas, later became the municipal building after the town purchased it.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Granite_Quarry%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Granite Quarry’s roots trace back to a 19th‑century granite quarry that supplied stone for buildings across the region.",
      "sourceSentenceIds": [
