  "facts": [
    {
      "id": 1,
      "text": "Dansville was founded by Samuel Crossman in 1844 and officially platted by his son Daniel in 1857, naming the village after himself.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dansville%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The village’s first post office opened in 1846 in southern Ingham Township and later moved to Dansville, where Daniel Crossman became postmaster in 1855.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dansville%2C_Michigan"
    },
    {
      "id": 3,
      "text": "The Union Hotel, built in 1856‑57 by David D. Weston, was Dansville’s first hotel and remains a historic landmark.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dansville%2C_Michigan"
    },
    {
      "id": 4,
      "text": "In 1870 the Jackson‑Lansing‑Saginaw railroad bypassed Dansville, steering regional traffic south through Mason instead.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dansville%2C_Michigan"
    },
    {
      "id": 5,
      "text": "Today Dansville’s economy centers on agriculture and small businesses, with research and production supporting local farms.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dansville%2C_Michigan"
    },
    {
      "id": 6,
      "text": "The village sits along M‑36 in Ingham Township, about 22 miles southeast of Lansing, placing it within the state’s central corridor.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dansville%2C_Michigan"
    }
  ]
