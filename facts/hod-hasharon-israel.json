      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Archaeologists uncovered a 1,300‑year‑old olive‑oil press in Hod HaSharon, evidence of ancient commercial production.",
      "sourceSentenceIds": [
