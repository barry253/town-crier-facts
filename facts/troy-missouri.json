  "facts": [
    {
      "id": 1,
      "text": "Troy was named after either Troy, New York or Troy, Vermont, according to local historian Mrs. Guinn and scholar Andy Brown.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s historic Woods Fort park was donated in 1819 by founders Deacon Cottle and Zadock Woods, making it one of the oldest public parks in Missouri.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aboutstlouis.com/local/communities/troy-missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Troy’s Old Jail and Museum, preserved by the Lincoln County Historical Society, still stands in the heart of town as a reminder of 19th‑century life.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://aboutstlouis.com/local/communities/troy-missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Fort Cap au Gris, a War of 1812 fortification built in 1814, sits just outside Troy and marks the area’s early military significance.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Downtown Troy Historic District, listed on the National Register of Historic Places in 2013, showcases Late Victorian architecture from 1832 to 1966.",
      "sourceSentenceIds": [
        4,
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Troy%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mercy Hospital Lincoln, opened in 1953 under the Hill‑Burton Act, remains the primary healthcare facility serving Troy and surrounding counties.",
      "sourceSentenceIds": [
