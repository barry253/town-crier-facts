  "facts": [
    {
      "id": 1,
      "text": "Douglass Hills was incorporated in 1973, turning former farmland into subdivisions originally called Douglass Place.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Douglass_Hills%2C_Kentucky"
    },
    {
      "id": 2,
      "text": "Though founded in 1973, the area’s history reaches back to the Civil War, with a marker noting the 1862 Perryville Prelude battle.",
      "sourceSentenceIds": [
        1,
        9,
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wave3.com/2023/10/08/city-douglass-hill-spends-50th-anniversary-highlighting-historical-roots/"
    },
    {
      "id": 3,
      "text": "The city’s name honors James J. Douglass, a landowner whose property formed much of the original town.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wave3.com/2023/10/08/city-douglass-hill-spends-50th-anniversary-highlighting-historical-roots/"
    },
    {
      "id": 4,
      "text": "During its 50th‑anniversary celebrations, organizers chose a 1970s theme to honor the year of incorporation and highlight historical roots.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wave3.com/2023/10/08/city-douglass-hill-spends-50th-anniversary-highlighting-historical-roots/"
    },
    {
      "id": 5,
      "text": "Douglass Hills celebrates its Civil War heritage and also highlights connections to Churchill Downs, Whiskey Row, and Olympic swimming.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wave3.com/2023/10/08/city-douglass-hill-spends-50th-anniversary-highlighting-historical-roots/"
    },
    {
