      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roxie sits at the crossroads of the Louisville, New Orleans and Texas Railway and the Yazoo and Mississippi Valley Railroad.",
      "sourceSentenceIds": [
