  "facts": [
    {
      "id": 1,
      "text": "Nahcotta was named after Chief Nahcati, a local Chinook leader who lived along the western shore of Shoalwater Bay.",
      "sourceSentenceIds": [
        1,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://opwa.com/Nahcotta/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened in 1889 and operated until February 27, 2021, when it closed after funding was denied.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nahcotta%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A narrow‑gauge railroad ran from Ilwaco up the Long Beach Peninsula to Nahcotta, reaching the town in 1889 and operating until 1930.",
      "sourceSentenceIds": [
        8,
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Nahcotta%2C_Washington",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the late 1800s, settlers built a few homes and businesses where Nahcotta now stands, but most gathered in nearby Oysterville for work.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://opwa.com/Nahcotta/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area that became Nahcotta was once a thriving oyster‑harvesting hub, with ships docking at Shoalwater Bay’s channel close to the town’s future site.",
      "sourceSentenceIds": [
        28
