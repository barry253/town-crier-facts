  "facts": [
    {
      "id": 1,
      "text": "Brunswick was laid out in 1836 by Reverend James Keyte, an English Methodist minister, who also built the Florence Hotel in 1838.",
      "sourceSentenceIds": [
        29,
        18
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brunswick_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits where the Missouri and Grand Rivers meet, a spot first noted by Lewis and Clark in 1804 as ideal for settlement.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brunswick_missouri",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1867 a railroad reached Brunswick after a decade of war, shifting trade from steamboats to rail.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brunswick%2C_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Brunswick is home to the Missouri Farmers Association, founded there in 1914 by local farmers, later becoming a major agricultural cooperative.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brunswick_missouri",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Florence Hotel, built by Keyte, still stands as one of Brunswick’s oldest 19th‑century landmarks.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/brunswick_missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
