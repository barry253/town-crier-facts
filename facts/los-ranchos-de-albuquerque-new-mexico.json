  "facts": [
    {
      "id": 1,
      "text": "Los Ranchos de Albuquerque’s lot layout still shows the historic linea or tripa pattern, a design that dates back to early Spanish settlement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newmexico.org/places-to-visit/regions/central/los-ranchos-de-albuquerque/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After World War II, a flood of new residents pushed Albuquerque to consider annexing Los Ranchos, prompting locals to incorporate in 1955.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Los_Ranchos_de_Albuquerque%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits on land that has been inhabited for at least 2,500 years, with archaeological sites dating back to 10,000 B.C.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.losranchosnm.gov/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Los Ranchos was historically an agricultural settlement, surrounded on three sides by Albuquerque yet retaining wide‑spaced homes and dense vegetation.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.losranchosnm.gov/about-us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Repeated floods in 1874, 1891, and 1904 devastated the original village, turning much of the surrounding land alkaline and unusable.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Los_Ranchos_de_Albuquerque%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "During the 1930s, Albuquerque families moved north, buying abandoned adobe homes in Los Ranchos and later building new houses designed by Santa Fe architect John Gaw Meem.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Los_Ranchos_de_Albuquerque%2C_New_Mexico",
