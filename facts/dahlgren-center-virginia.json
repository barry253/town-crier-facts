  "facts": [
    {
      "id": 1,
      "text": "Dahlgren Center was founded on Oct 16 1918 when the first 7‑inch gun fired, marking its official start.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Surface_Warfare_Center_Dahlgren_Division",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The site honors Rear Admiral John Adolphus Dahlgren, dubbed the “father of modern naval ordnance.”.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Surface_Warfare_Center_Dahlgren_Division",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "NSWCDD, the main tenant, pioneered the Norden Bombsight used on B‑17s and B‑24s during WWII.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Surface_Warfare_Center_Dahlgren_Division",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The proving ground was chosen for its long, straight Potomac River stretch, ideal for testing large naval guns.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Naval_Surface_Warfare_Center_Dahlgren_Division",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A museum opened in 2013, the Dahlgren Heritage Museum, showcasing naval artifacts and local history.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dahlgrenmuseum.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The base’s original name, Lower Station, Dahlgren Naval Proving Ground, reflected its role as an extension of Maryland’s Indian Head proving ground.",
      "sourceSentenceIds": [
        15
