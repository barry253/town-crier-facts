  "facts": [
    {
      "id": 1,
      "text": "Louvale was originally called Antioch and was renamed in 1886 when the Little SAM Railroad reached the area.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louvale%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The Antioch Primitive Baptist Church, founded in 1832, sits beside the historic Antioch Institute school built in the 1850s.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louvale%2C_Georgia"
    },
    {
      "id": 3,
      "text": "Louvale Church Row, a cluster of buildings from the 1850s to early 1900s, was listed on the National Register of Historic Places in 1986.",
      "sourceSentenceIds": [
        5,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louvale%2C_Georgia"
    },
    {
      "id": 4,
      "text": "The community became an official town in 1893, allowing it to establish its own local rules.",
      "sourceSentenceIds": [
        16,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louvale%2C_Georgia"
    },
    {
      "id": 5,
      "text": "Louvale High School operated there until 1928, after which upper grades moved to Lumpkin, while the elementary school stayed until 1942.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louvale%2C_Georgia"
    },
    {
      "id": 6,
      "text": "The town lies 8.7 miles north of Lumpkin along U.S. Route 27 in Stewart County, Georgia.",
