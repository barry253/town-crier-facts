  "facts": [
    {
      "id": 1,
      "text": "Plumas‑Eureka State Park was founded in 1959, preserving the region’s gold‑rush heritage.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://plumascounty.org/get-outside/places-to-visit/plumas-eureka-state-park/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park sits at the foot of Eureka Peak, once called Gold Mountain, a nod to the area’s mining past.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://plumascounty.org/get-outside/places-to-visit/plumas-eureka-state-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Visitors can tour the Mohawk Stamp Mill, Bushman five‑stamp mill, and Moriarty House, all relics of 19th‑century mining life.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/?page_id=507",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The museum, originally a miner’s bunkhouse from 1906, now serves as the park’s visitor center and history exhibit.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.parks.ca.gov/?page_id=507",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Eureka Ski Bowl hosted the first recorded downhill ski race in the Western Hemisphere, a milestone for winter sports.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://plumascounty.org/get-outside/places-to-visit/plumas-eureka-state-park/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Plumas Ski Club runs the Historic Longboard Ski Revival Series, keeping the legendary longboard races alive each winter.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
