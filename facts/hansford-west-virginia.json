    {
      "id": 1,
      "text": "Hansford was originally known as Paintcreek before being renamed for a prominent local family of early settlers.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hansford%2C_West_Virginia"
    },
    {
      "id": 2,
      "text": "The Hansford House is a Federal-style brick building listed on the National Register of Historic Places since 1984.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hansford_west_virginia"
    },
    {
      "id": 3,
      "text": "Hansford is situated along the banks of the Kanawha River, where the Paint Creek tributary joins the main waterway.",
      "sourceSentenceIds": [
        12,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hansford_west_virginia"
    },
    {
      "id": 4,
      "text": "Major John Hansford, a key figure in the area's development, was a large landowner and member of the Virginia General Assembly.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hansford_west_virginia"
    },
    {
      "id": 5,
      "text": "The community's oldest surviving structure was built in 1824 along the historic James River and Kanawha Turnpike.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hansford_west_virginia"
    },
    {
      "id": 6,
      "text": "Coal mining and river-based industries shaped the growth of Hansford from a modest riverside settlement into an industrial hub.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hansford_west_virginia"
