  "facts": [
    {
      "id": 1,
      "text": "Goldvein is an unincorporated hamlet in Fauquier County, Virginia, located along US Route 17 about 16 miles northwest of Fredericksburg.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Goldvein%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The town hosts the Gold Mining Camp Museum at Monroe Park, the only Virginia museum solely dedicated to gold mining history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fauquiercounty.gov/government/departments-h-z/parks-and-recreation/parks/gold-mining-camp-museum"
    },
    {
      "id": 3,
      "text": "Monroe Park was designated the official state gold mining interpretive center in 1991, highlighting the region’s historic 18 gold mines.",
      "sourceSentenceIds": [
        30,
        7
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://statesymbolsusa.org/place/virginia/museum-or-theater-state-theater-or-museum/monroe-park"
    },
    {
      "id": 4,
      "text": "The museum’s three buildings recreate a 1930s mine, complete with sluice and gold‑panning demonstrations held daily at 2 pm.",
      "sourceSentenceIds": [
        12,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fauquiercounty.gov/government/departments-h-z/parks-and-recreation/parks/gold-mining-camp-museum"
    },
    {
      "id": 5,
      "text": "In 2019, the museum received a National Endowment for the Humanities Preservation Assistance Grant to improve artifact storage and emergency planning.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.fauquiercounty.gov/government/departments-h-z/parks-and-recreation/parks/gold-mining-camp-museum"
    },
    {
      "id": 6,
      "text": "Hornet balls once crushed ore for gold mining in the late 1800s and early 1900s, a quirky piece of local mining lore.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://statesymbolsusa.org/place/virginia/museum-or-theater-state-theater-or-museum/monroe-park"
    }
  ]
