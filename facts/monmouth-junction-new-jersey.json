  "facts": [
    {
      "id": 1,
      "text": "Monmouth Junction sprang to life as the meeting point of three rail lines: the Pennsylvania Railroad’s New York division, Rocky Hill, and the Jamesburg‑Freehold branch.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://southbrunswicknj.gov/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Nestled in southwestern Middlesex County, Monmouth Junction sits just west of the county seat, New Brunswick, and 17 miles southeast of Trenton.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monmouth_Junction%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The community’s western edge is marked by a short stretch of Route 1, a historic corridor that once carried early travelers across New Jersey.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monmouth_Junction%2C_New_Jersey",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 4,
      "text": "Covering 4.38 square miles, the CDP is almost entirely land, with only 0.57% water—just a sliver of small streams.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Monmouth_Junction%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "Water from Monmouth Junction drains southwest into Heathcote Brook and Devils Brook, both tributaries of the Millstone River in the Raritan watershed.",
