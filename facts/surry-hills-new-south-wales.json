  "facts": [
    {
      "id": 1,
      "text": "Surry Hills takes its name from Surrey Hills in England, after early settler Major Joseph Foveaux’s 1790s farm.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Surry_Hills",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb’s first land grants were made in the 1790s, with Foveaux receiving 105 acres that became Surry Hills Farm.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Surry_Hills",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "After World II, Surry Hills welcomed waves of Greek, Portuguese and Italian immigrants, reshaping its cultural fabric.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Surry_Hills",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 19th century, brickmaking and industry powered Surry Hills, drawing migrant workers to its factory‑filled streets.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wikiaustralia.com/destination/surry-hills/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Central Station, opened in 1906, sits on Surry Hills’ western edge and remains the largest hub on Sydney’s train network.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Surry_Hills",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Artist Brett Whiteley once lived and worked in Surry Hills; his former studio is now a public gallery celebrating his legacy.",
      "sourceSentenceIds": [
        1
      ],
