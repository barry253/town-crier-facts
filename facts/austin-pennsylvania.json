  "facts": [
    {
      "id": 1,
      "text": "Edward Oramel Austin founded the borough in 1856 after moving to Freeman Run and building a village that grew into one of Potter County’s largest towns.",
      "sourceSentenceIds": [
        9,
        10,
        11,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Austin%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The Bayless Dam, built in 1909, was Pennsylvania’s largest concrete gravity dam until its catastrophic failure in 1911 killed 78 people.",
      "sourceSentenceIds": [
        21,
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Austin%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Every July, Austin hosts Dam Stock, a classic‑rock festival that projects lights onto the concrete remains of the old dam for a unique backdrop.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paroute6.com/heritage-communities/austin-pa/"
    },
    {
      "id": 4,
      "text": "The former dam site now functions as a memorial park with hiking trails, scenic overlooks, and wildlife from the PA Wilds.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://paroute6.com/heritage-communities/austin-pa/"
    },
    {
      "id": 5,
      "text": "After the 1911 flood, residents rebuilt the town under the slogan “the town too tough to die.”.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Austin%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "Edward Oramel Austin, a Civil War veteran, named the town after himself and devoted his life to its development.",
      "sourceSentenceIds": [
