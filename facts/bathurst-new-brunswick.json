  "facts": [
    {
      "id": 1,
      "text": "Bathurst was renamed in 1828 after Henry Bathurst, 3rd Earl Bathurst, the British Secretary of State for the Colonies.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bathurst%2C_New_Brunswick",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original French settlement founded in 1619 was called Nepisiguit before becoming Bathurst.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Bathurst-New-Brunswick",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1832, a brick courthouse, jail, post office, and over 30 homes appeared, marking rapid growth from a few houses in 1828.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bathurst%2C_New_Brunswick",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Bathurst High School, founded in 1926, replaced an older grammar school that had outgrown its St. Andrew premises.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bathurst%2C_New_Brunswick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Nepisiguit Centennial Museum/Cultural Centre, established in 1967, was designated a local historic place in 2005.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bathurst%2C_New_Brunswick",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Bathurst sits on the Canadian National railway line, linking it to the national network.",
