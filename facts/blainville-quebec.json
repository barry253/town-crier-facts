  "facts": [
    {
      "id": 1,
      "text": "Blainville was named after Jean‑Baptiste Céloron de Blainville, the third lord of the seigneurie.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Blainville%2C_Quebec"
    },
    {
      "id": 2,
      "text": "The town sits at the foot of the Laurentian Mountains, 35 kilometres northwest of downtown Montreal.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blainville%2C_Quebec"
    },
    {
      "id": 3,
      "text": "In 1683, Louis de Buade de Frontenac granted the territory that is now Blainville to elite seigneurs to promote New France.",
      "sourceSentenceIds": [
        5,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.comeexplorecanada.com/quebec/blainville"
    },
    {
      "id": 4,
      "text": "Blainville co‑hosted the 2009 Quebec Winter Games alongside Rosemère and Sainte‑Thérèse.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blainville%2C_Quebec"
    },
    {
      "id": 5,
      "text": "The local brewery Les Brasseurs du Nord, makers of Boréale beer, is located in Blainville.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blainville%2C_Quebec"
    },
    {
      "id": 6,
      "text": "In 1968, the parish of Sainte‑Thérèse‑de‑Blainville split, creating the town of Blainville from mostly undeveloped land.",
      "sourceSentenceIds": [
        13
      ],
