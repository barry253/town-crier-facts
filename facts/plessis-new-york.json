  "facts": [
    {
      "id": 1,
      "text": "Plessis takes its name from a French town and locals call it Flat Rock because of exposed Potsdam sandstone cliffs.",
      "sourceSentenceIds": [
        3,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plessis_new_york",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village first appeared in 1817 when James Le Ray de Chaumont built a grist mill on Plessis Creek, sparking early settlement.",
      "sourceSentenceIds": [
        10,
        16,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plessis_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1820, Lull and Walton opened Plessis’s first general store, and a year later a schoolhouse opened, marking the town’s early civic growth.",
      "sourceSentenceIds": [
        11,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plessis_new_york",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Plessis Creek supplied water and power for the mill and attracted pioneers, making it the lifeblood of the early community.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plessis_new_york",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The first Union church in Plessis was erected in 1833, a joint effort by Presbyterians, Methodists, and Baptists that fostered interdenominational worship.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/plessis_new_york",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the late 19th century, Plessis had become a modest economic hub with multiple general stores, a tannery, and several craft shops, reflecting diversified trade.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
