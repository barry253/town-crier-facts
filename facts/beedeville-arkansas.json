  "facts": [
    {
      "id": 1,
      "text": "Beedeville got its name in 1910 when the post office moved to the Beede family store, likely honoring William Beede or his son Fletcher.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beedeville_arkansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first settler, a Beede, arrived around 1866 and organized the area’s inaugural public school in 1880.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beedeville_arkansas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Beedeville sits on flat, low‑lying land in the Cache River valley, a region that has historically flooded during heavy rains.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beedeville_arkansas",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Early 1900s saw four sawmills in Beedeville, but as timber dwindled, the town shifted to rice and soybean farming on the fertile bottomlands.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beedeville_arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the past, the Cache River was a vital transportation corridor, moving goods through the region’s lowlands.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/beedeville_arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Beedeville was officially incorporated on November 7, 1963, marking its formal recognition as a town.",
      "sourceSentenceIds": [
        21
      ],
