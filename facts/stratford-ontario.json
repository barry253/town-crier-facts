  "facts": [
    {
      "id": 1,
      "text": "Stratford was named after Stratford‑upon‑Avon, England, when Thomas Mercer Jones renamed the village in 1832.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Ontario",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first hotel, the Shakespeare Hotel, opened beside the Avon River in 1832, marking the start of Stratford’s hospitality scene.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1953, the Stratford Shakespeare Festival premiered with Alec Guinness starring in Richard III, launching an annual summer theatre tradition.",
      "sourceSentenceIds": [
        11,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Ontario",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Festival Theatre, built in 1957, and the Avon Theatre, acquired in 1964, host the festival’s productions each summer.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Stratford-Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stratford’s railway history is highlighted by the former Canadian National Railways station, now a Federal Heritage building since 1993.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Ontario",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s first public library opened in 1903, funded by Andrew Carnegie, reflecting Stratford’s early commitment to learning.",
      "sourceSentenceIds": [
        27
