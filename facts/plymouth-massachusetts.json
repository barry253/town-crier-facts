  "facts": [
    {
      "id": 1,
      "text": "Plymouth was founded by Pilgrims, Separatists from the Church of England, who first lived in the Netherlands before settling in North America.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
