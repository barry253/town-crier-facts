  "facts": [
    {
      "id": 1,
      "text": "Placitas traces its roots to a 1767 Spanish land grant that gave 21 families a foothold in the San Antonio de las Huertas area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Placitas%2C_Sandoval_County%2C_New_Mexico"
    },
    {
      "id": 2,
      "text": "The village’s name, Las Placitas, first appeared in the 1830s when settlers arrived after the land grant.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Placitas%2C_Sandoval_County%2C_New_Mexico"
    },
    {
      "id": 3,
      "text": "In 1894, the Las Placitas Presbyterian Church opened, becoming one of the town’s oldest standing buildings.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Placitas%2C_Sandoval_County%2C_New_Mexico"
    },
    {
      "id": 4,
      "text": "The historic village lies at the foot of Sandia Peak, with adobe homes and the San Antonio de Padua Mission reflecting its 18th‑century heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lasacequiasdeplacitas.com/historic-village-placitas"
    },
    {
      "id": 5,
      "text": "Artists and writers have long been drawn to Placitas, calling it a “magical” place that inspired poets, sculptors, and authors.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lasacequiasdeplacitas.com/historic-village-placitas"
    },
    {
      "id": 6,
      "text": "Placitas sits between Albuquerque and Santa Fe, offering a blend of nature, history, and community that locals cherish.",
