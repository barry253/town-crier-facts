  "facts": [
    {
      "id": 1,
      "text": "Traphill is a rural community in northeastern Wilkes County, North Carolina, nestled in the foothills of the Blue Ridge Mountains.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Traphill%2C_North_Carolina",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a 19th‑century wild‑turkey trap invented by a local named Blackburn, whose “rail‑pen” became famous.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Traphill%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the Civil War, Traphill residents were staunch Union supporters, even marching into Wilkesboro in 1863 to raise a Union flag at the courthouse.",
      "sourceSentenceIds": [
        1,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Traphill%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After the war, the community became a haven for Confederate deserters, outlaws, and escaped Union prisoners, who were helped by locals to evade authorities.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Traphill%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1920s and 1930s, Traphill produced over a million gallons of moonshine a year, earning the nickname “cutthroat ridge” for disputes between distillers and lawmen.",
      "sourceSentenceIds": [
        19,
        20,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Traphill%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Today, Traphill remains a quiet farming area, with the Holbrook Farm and Traphill Historic District listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Traphill%2C_North_Carolina",
