  "facts": [
    {
      "id": 1,
      "text": "Nespelem sits on the east side of the Nespelem River, a few miles above where it meets the Columbia.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/23229",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Nespelem people, whose word means “prairie” in their Interior Salish language.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/23229",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Chief Moses and Chief Joseph, famed Nez Perce leaders, spent their final years in Nespelem after moving there in the 1880s.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/23229",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In December 1885, Chief Joseph and his Wallowa band relocated from Oklahoma to Nespelem following the 1877 Nez Perce War.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/23229",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The construction of Grand Coulee Dam in the 1930s spurred growth, leading Nespelem to incorporate on April 15, 1935.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/23229",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Non‑Native miners began opening mines in the 1890s, and homestead claims started in 1915, bringing settlers to the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
