  "facts": [
    {
      "id": 1,
      "text": "Hassell was named in honor of Elder Sylvester Hassell, a Primitive Baptist churchman, historian, and educator from the late 19th and early 20th centuries.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.martinncchamber.com/hassell/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits on the Atlantic Coastal Plain and drains north toward Conoho Creek, an east‑flowing tributary of the Roanoke River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hassell%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hassell lies on the Scotland Neck‑Kinston branch of the Seaboard Coast Line Railroad, roughly halfway between Oak City and Parmele.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.martinncchamber.com/hassell/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Founded in the 20th century, Hassell is Martin County’s second youngest town and one of only two towns established after 1900.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.martinncchamber.com/hassell/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town is part of the coastal plain region, a flat, low‑lying area that stretches across northeastern North Carolina.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.citydirectory.us/town-hassell.html",
      "category": "nature",
      "quality": "good"
    },
