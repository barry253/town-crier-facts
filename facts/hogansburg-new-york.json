  "facts": [
    {
      "id": 1,
      "text": "Hogansburg is named for Michael Hogan, an Irish ship captain who grew wealthy in the East India trade.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hogansburg%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hogan returned to the U.S. in 1805 with his Indian wife, buying 20,000 acres north of Adirondack Park, including the Town of Bombay.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Hogansburg%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hogan leased Hogansburg from the Mohawk in 1817 and built a grist mill there in 1818.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hogansburg%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A dam on the Regis River near Hogansburg blocked migratory fish, but the Mohawk dismantled it in 2016, freeing over 250 miles of river.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hogansburg%2C_New_York",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hogansburg sits on NY 37 near the Canadian‑US border at the St. Regis River confluence.",
      "sourceSentenceIds": [
