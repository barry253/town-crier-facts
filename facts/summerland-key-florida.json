  "facts": [
    {
      "id": 1,
      "text": "Summerland Key was developed by Henry Hudgins starting in 1948, turning a tropical wilderness into an upscale residential neighborhood.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerland_Key",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hudgins built the island’s first stilt house, pioneering elevated construction that later became a Keys building code requirement.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerland_Key",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The island’s airstrip, created by Hudgins and Toppino, once served as a landing strip flanked by homes and canals.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerland_Key",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Folk legend Fred Neil, who wrote “Everybody’s Talkin’,” made Summerland Key his final home until his death in 2001.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Summerland_Key",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Summerland Key sits at sea level, making it highly vulnerable to tidal surges and storm surges.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/summerland_key",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 6,
      "text": "The Brinton Environmental Center on the island serves as a field station for Mote Marine Laboratory, linking the Keys to marine research.",
