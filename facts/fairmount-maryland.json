      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The Upper Fairmount Historic District, listed in 1993, showcases rural homes dating from the early 19th to early 20th centuries.",
      "sourceSentenceIds": [
        20,
        26
      ],
      "sourceLabels": [
        "Web source 1"
