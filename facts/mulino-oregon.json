  "facts": [
    {
      "id": 1,
      "text": "Mulino was originally known as Howards Mill after a flour mill was built in the community in 1851.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulino%2C_Oregon"
    },
    {
      "id": 2,
      "text": "The name Mulino is a corruption of the Spanish word for mill, chosen to avoid confusion with nearby Molalla.",
      "sourceSentenceIds": [
        2,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulino%2C_Oregon"
    },
    {
      "id": 3,
      "text": "Howard's Gristmill in Mulino was added to the National Register of Historic Places in 1981.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulino%2C_Oregon"
    },
    {
      "id": 4,
      "text": "A plaque identifies the local mill as the oldest industrial building still standing in Oregon.",
      "sourceSentenceIds": [
        9,
