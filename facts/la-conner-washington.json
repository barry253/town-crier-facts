      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "La Conner sits on the Swinomish Channel, a safe harbor that once drew ships to its delta location.",
      "sourceSentenceIds": [
        12,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Conner%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Rainbow Bridge, a steel arch, links La Conner to the Swinomish Indian Reservation across Fidalgo Island.",
      "sourceSentenceIds": [
        18,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Conner%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic district known as “the Hill” is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
