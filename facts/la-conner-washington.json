      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Louisa Ann Conner, with the “La” reflecting her initials.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
