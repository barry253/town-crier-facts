  "facts": [
    {
      "id": 1,
      "text": "Stewart County was created in 1803 from Montgomery County and named for Duncan Stewart, an early settler and state legislator.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stewart_County%2C_Tennessee",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Battle of Fort Donelson in 1862 took place here, giving the Union its first major victory and leading to the surrender of nearly 13,000 troops.",
      "sourceSentenceIds": [
        3,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://finenaturalist.blog/stewart-tn-county-guide",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Stewart County Historical Museum in Dover showcases rotating exhibits on the county’s Civil War history and early settlement.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.stewartcountychamberofcommerce.com/stewart-county",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The county seat, Dover, anchors the region with the historic Stewart County Courthouse and serves as the heart of local governance.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://finenaturalist.blog/stewart-tn-county-guide",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Stewart County lies along the Cumberland and Tennessee Rivers, making it a gateway to the Land Between the Lakes National Recreation Area.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://finenaturalist.blog/stewart-tn-county-guide",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The 1850 Homeplace living history farm offers visitors a glimpse into 19th‑century farm life and is a popular educational site.",
