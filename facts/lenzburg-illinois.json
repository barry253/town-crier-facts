  "facts": [
    {
      "id": 1,
      "text": "Lenzburg’s name comes from the Germanic suffix “‑burg,” meaning fortress or town, hinting that early settlers wanted to echo a European hometown.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/lenzburg-141619",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Early settlers were mainly German and Swiss‑German immigrants who brought farming traditions that shaped the village’s slow growth.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/lenzburg-141619",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village’s rolling hills sit within the Mississippi River watershed, a landscape that historically supported its agricultural roots.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/lenzburg-141619",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Lenzburg keeps its small‑town feel, offering residents a quiet, rural lifestyle that feels like a step back in time.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/lenzburg-141619",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "Community spirit thrives in Lenzburg, where local events celebrate its heritage and bring neighbors together each year.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/lenzburg-141619",
