  "facts": [
    {
      "id": 1,
      "text": "Albert Gallatin founded New Geneva in 1797, naming it after his hometown of Geneva, Switzerland.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_geneva_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The New Geneva Glass Works, started in 1797, was the first glass factory west of the Allegheny Mountains.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_geneva_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "New Geneva’s Historic District, with 35 buildings, was added to the National Register in 1996 for its commercial and architectural heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_geneva_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A ferry linked New Geneva to Greensboro across the Monongahela until the 1950s, making river trade vital.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_geneva_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s original 1797 street grid—Ferry, County, Ford, Dug, and Front—remains intact today.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/new_geneva_pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "New Geneva sits on the east bank where Georges Creek meets the Monongahela, about 2.4 mi from Point Marion.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
