  "facts": [
    {
      "id": 1,
      "text": "St Lucia sits on a peninsula bounded by the Brisbane River on three sides, with the St Lucia Reach to the north and Cemetery Reach to the east.",
      "sourceSentenceIds": [
        16,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St_Lucia%2C_Queensland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The University of Queensland dominates the eastern third of St Lucia, its campus and residential colleges covering most of the suburb.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St_Lucia%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Eleanor Schonell Bridge, a dedicated bus, pedestrian and bicycle bridge, links St Lucia’s UQ campus to Dutton Park and carries buses from the southern suburbs and CBD.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St_Lucia%2C_Queensland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "St Lucia’s name originated from a sugar plantation established in the 1860s, later subdivided for housing in 1883.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St_Lucia%2C_Queensland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Three creeks—Toowong, Carmody and Sandy—flow through St Lucia, each emptying into the Brisbane River at different points.",
      "sourceSentenceIds": [
        26,
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St_Lucia%2C_Queensland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The suburb’s southern edge hosts the St Lucia Golf Links, a popular course for locals and visitors alike.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
