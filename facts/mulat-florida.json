  "facts": [
    {
      "id": 1,
      "text": "Mulat is believed to be the oldest settlement in Santa Rosa County, first inhabited by the Santa Rosa‑Swift Creek people in the 4th century.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulat%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Beltran Suchet, the first European settler in 1818, who had children with a slave on Mulatto Bayou.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulat%2C_Florida",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Captain John Gardner established a shipyard on Mulatto Bayou in the late 1820s, and a sawmill was built there in the 1850s.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulat%2C_Florida"
    },
    {
      "id": 4,
      "text": "A ferry to Ferry Pass and a road to Arcadia Mill were established in 1854, but the town was burned by Confederates on March 12, 1862.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulat%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A trestle bridge to Mulat was built in 1882, connecting Escambia and Santa Rosa counties.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulat%2C_Florida"
    },
    {
      "id": 6,
      "text": "The post office operated from 1892 until 1953, serving the community for 61 years.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mulat%2C_Florida"
