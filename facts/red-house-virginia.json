  "facts": [
    {
      "id": 1,
      "text": "Red House’s post office, founded on September 26 1840, remains in operation today for over 180 years.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_House%2C_West_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community’s name may come from a red house that once stood on the site or from nearby red rock formations.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_House%2C_West_Virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1813 Martin Hancock erected a tavern on the site of his earlier cabin, making Red House a key stop on the old south road to the West.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ruralrust.com/rusty-and-rural-red-house-virginia/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A growing Amish community now calls Red House home, so keep an eye out for slow‑moving buggies while driving through.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://ruralrust.com/rusty-and-rural-red-house-virginia/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Red House is split into two distinct areas: Proper along WV 62 beside the Kanawha River, and Hill along WV 34 in the surrounding hills.",
