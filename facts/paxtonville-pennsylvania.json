      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Sunbury and Lewistown Railroad linked Paxtonville to those cities, and daily passenger trains stopped at its station near the creek in the 1870s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
