  "facts": [
    {
      "id": 1,
      "text": "Pasadena Hills grew during the 1880s citrus boom, centered around a lake once called Lake Buddy, named after a pet bull from an 1830s cattle drive.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pasadena_hills_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The area’s history stretches back thousands of years, with Native Americans using local agate coral for tools before Seminole villages like Toadchudka appeared in the 1780s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pasadena_hills_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railroads sparked settlement in the late 1880s when the Orange Belt Railway—later part of the Atlantic Coast Line—made Pasadena a key station in Pasco County.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pasadena_hills_florida",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1926 Florida land‑boom collapse halted speculative building near Pasadena Hills, leaving abandoned lots and halted construction after the 1926 hurricane and 1929 fruit fly crisis.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/pasadena_hills_florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A devastating freeze in 1894–95 destroyed citrus groves, causing nearby settlements such as Earnestville and Freedtown to be abandoned by the early 1900s.",
      "sourceSentenceIds": [
        26
