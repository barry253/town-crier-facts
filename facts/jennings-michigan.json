  "facts": [
    {
      "id": 1,
      "text": "Jennings began in 1883 as the Mitchell lumber town, then renamed in 1890 after politician William Jennings Bryan to avoid confusion with another Michigan Mitchell.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Jennings%2C_Michigan"
    },
    {
      "id": 2,
      "text": "The town served as the terminus of the Missaukee spur of the Grand Rapids and Indiana Railroad, with a key junction at Round Lake.",
      "sourceSentenceIds": [
        2,
        13,
        15
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Jennings%2C_Michigan"
    },
    {
      "id": 3,
      "text": "Jennings’ mills processed vast white pine and hardwood, while a nearby chemical plant produced wood alcohol, charcoal, and acetate of lime.",
      "sourceSentenceIds": [
        11,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jennings_michigan"
    },
    {
      "id": 4,
      "text": "In the 1920s, about 70 Victorian homes were physically moved ten miles to Cadillac, a move that drew national attention.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/jennings_michigan"
    },
    {
      "id": 5,
      "text": "Finnish settlers left their mark with old farmhouses that still feature traditional saunas beside the fields.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://unitedstatesghosttowns.com/jennings-michigan-ghost-town/"
    },
    {
      "id": 6,
      "text": "Today Jennings is often called Michigan’s largest ghost town, its streets now echo with scattered Victorian homes and a lone historic church.",
