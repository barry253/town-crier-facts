  "facts": [
    {
      "id": 1,
      "text": "Millington was originally platted as Lanesville in 1860, then renamed Millington in 1872 after early settlers and a creek named for mills.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://millingtonvillage.org/index.php/community",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first school opened in 1856, followed by a post office in 1857, and a sawmill in 1859, laying the village’s early infrastructure.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/millington_michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1873 the Detroit & Bay City Railroad ran through Millington, turning the village into a hub for exporting grain, potatoes, livestock, lumber, and pine shingles.",
      "sourceSentenceIds": [
        5,
        9,
        10
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1",
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/millington_michigan",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Millington’s quiet, community‑oriented character is preserved by the Millington‑Arbela Historical Society, which showcases the town’s rural heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/millington_michigan",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Art Clokey, creator of Gumby, grew up visiting family in Millington, crediting those childhood trips for inspiring his famous clay‑animation series.",
      "sourceSentenceIds": [
        14
