  "facts": [
    {
      "id": 1,
      "text": "Kalaeloa, whose Hawaiian name means 'long point,' got its nickname from Captain Henry Barber’s 1796 shipwreck on the nearby coral shoal.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
