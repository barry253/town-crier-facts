    {
      "id": 1,
      "text": "Camp Verde is the oldest community in the Verde Valley, founded in the 1860s.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.campverde.az.gov/community/history.php"
    },
    {
      "id": 2,
      "text": "The Verde River, one of Arizona’s last free‑flowing rivers, creates a mile‑wide greenbelt that defines Camp Verde’s landscape.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visitcampverde.com/"
    },
    {
      "id": 3,
      "text": "Fort Verde State Historic Park, located in downtown, preserves the 1863 military fort that guarded the valley’s early settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Verde%2C_Arizona"
    },
    {
      "id": 4,
      "text": "Every July, downtown hosts Corn Fest on the third Saturday, a celebration organized by local growers Hauser and Hauser Farms.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Verde%2C_Arizona"
    },
    {
      "id": 5,
      "text": "The town sits within the Verde River valley, just south of the Mogollon Rim that borders the Colorado Plateau.",
      "sourceSentenceIds": [
        15,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Camp_Verde%2C_Arizona"
    },
    {
      "id": 6,
      "text": "Camp Verde’s historic downtown, only a mile from I‑17, houses a museum, the Verde Valley Archaeology Center, and the Visitor Center.",
