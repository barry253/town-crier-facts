  "facts": [
    {
      "id": 1,
      "text": "Founded 1850, incorporated 1860 as Brashear City, renamed 1876 for Charles Morgan, railroad magnate who made it a western terminus.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Morgan-City",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Charles Morgan dredged the Atchafalaya Bay Channel, turning Morgan City into a deep‑water port that could accommodate ocean‑going vessels.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmc.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1917, Morgan City’s swamps served as the jungle backdrop for the first Tarzan film starring Elmo Lincoln.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofmc.com/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town sits on the Atchafalaya River where it meets the Intracoastal Waterway, a lifeline that shaped its culture and character.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morgan_City%2C_Louisiana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Historic churches such as Sacred Heart Catholic, Trinity Episcopal, and Pharr Chapel were built during the late 19th century, reflecting the city’s growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morgan_City%2C_Louisiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Morgan City earned the nickname “right in the middle of everywhere” for its central location between Lafayette, Baton Rouge, and New Orleans.",
