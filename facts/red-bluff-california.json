  "facts": [
    {
      "id": 1,
      "text": "Red Bluff was originally called Leodocia, renamed in 1854 for the reddish sand and low bluffs that give the town its name.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Red-Bluff",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town flourished as a river landing for miners heading to the Trinity gold fields before becoming a temporary terminus for the Southern Pacific Railroad.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Bluff%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Red Bluff sits on the upper Sacramento River, bisected by Interstate 5, and lies 131 miles north of Sacramento.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Red_Bluff%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The city became the county seat of Tehama County in 1857, cementing its role as the region’s administrative hub.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.britannica.com/place/Red-Bluff",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A historic Chinatown District was officially established in Red Bluff on October 29, 2022, highlighting the city’s multicultural roots.",
