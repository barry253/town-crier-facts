  "facts": [
    {
      "id": 1,
      "text": "South Dennis once boasted a covered bridge spanning Dennis Creek, a historic landmark that linked the community to its early maritime roots.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museum.dennistwp.org/south-dennis-2/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s gristmill shut its doors in the early 1890s, the same era the Sea Coast Railroad Company built a line through North and South Dennisville.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museum.dennistwp.org/south-dennis-2/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By the late 1920s, the landing and its wharves had largely disappeared, leaving only a line of abandoned piers for local fishermen.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://museum.dennistwp.org/south-dennis-2/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Dennis Township remained a dry town until 2001, when voters approved a referendum that allowed liquor sales and earned the township $1.1 million.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dennis_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The township was officially incorporated on March 1, 1827, carved out of Upper Township by an act of the New Jersey Legislature.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dennis_Township%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "South Dennis is part of the South Jersey region and the larger Philadelphia‑Wilmington‑Camden combined statistical area, linking it to the Delaware Valley.",
      "sourceSentenceIds": [
        11
      ],
