      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Pennsylvania Route 272 runs through Swartzville, connecting the town to Adamstown in the northeast and Ephrata in the southwest.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swartzville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Swartzville’s western side drains into Stony Run, a tributary of Cocalico Creek, while the east side feeds Little Muddy Creek, both joining the Susquehanna watershed.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
