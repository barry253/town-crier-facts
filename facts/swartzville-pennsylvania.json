  "facts": [
    {
      "id": 1,
      "text": "Swartzville’s name comes from the German surname Swartz, reflecting the early settlers’ heritage in this part of Pennsylvania.",
      "sourceSentenceIds": [
        1,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/swartzville-79214",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits in northeastern Lancaster County, just east of the borough of Adamstown and west of the Pennsylvania Turnpike.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swartzville%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Pennsylvania Route 272 runs through Swartzville, connecting the town to Adamstown in the northeast and Ephrata in the southwest.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swartzville%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Swartzville’s western side drains into Stony Run, a tributary of Cocalico Creek, while the east side feeds Little Muddy Creek, both joining the Susquehanna watershed.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Swartzville%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The area’s geology is part of the Appalachian Mountains, offering fertile valleys that have supported local agriculture for generations.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/swartzville-79214",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Residents experience a classic four‑season climate, with warm, humid summers and cold, snowy winters typical of central Pennsylvania.",
