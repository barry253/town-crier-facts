      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits in northeastern Lancaster County, just east of the borough of Adamstown and west of the Pennsylvania Turnpike.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
