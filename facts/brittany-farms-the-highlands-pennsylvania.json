    {
      "id": 1,
      "text": "Brittany Farms-The Highlands traces its name back to 1682 when William Penn sold the land to the Free Society of Traders, who called it 'New Britain'.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brittany_farms_the_highlands_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Welsh settlers arriving between 1700 and 1715 made the area their home, drawn by affordable land and Quaker‑influenced religious freedom.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brittany_farms_the_highlands_pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Simon Butler built the first grist mill near Pine Run in 1720, becoming a prominent landowner and Baptist advocate.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brittany_farms_the_highlands_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1850s completion of the North Pennsylvania Railroad and later trolley lines in 1896 linked the township to urban markets, sparking early non‑agricultural growth.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/brittany_farms_the_highlands_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
