  "facts": [
    {
      "id": 1,
      "text": "Ray City grew around a gristmill built in 1863 by Thomas M. Ray and General Levi J. Knight.",
      "sourceSentenceIds": [
        18,
        19,
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://raycityga.gov/aboutus/"
    },
    {
      "id": 2,
      "text": "In 1909 the settlement incorporated as Rays Mill, then renamed Ray City in 1915 to honor Thomas M. Ray.",
      "sourceSentenceIds": [
        22,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://raycityga.gov/aboutus/"
    },
    {
      "id": 3,
      "text": "Beaverdam Creek flows through Ray City, joining Batterbee Branch to form Cat Creek, a Withlacoochee tributary.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ray_City%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Georgia State Route 129 slices through Ray City, linking it north to Nashville and east to Lakeland.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ray_City%2C_Georgia"
    },
    {
      "id": 5,
      "text": "Ray’s Mill Pond, a historic landmark, hosts community events where neighbors gather and traditions endure.",
      "sourceSentenceIds": [
