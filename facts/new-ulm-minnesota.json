    {
      "id": 1,
      "text": "New Ulm was founded in 1854 by the German Land Company of Chicago, bringing a slice of German heritage to Minnesota.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Ulm%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "New Ulm was named after the German city of Ulm in Baden-Württemberg, reflecting its founders’ heritage.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Ulm%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "New Ulm sits on a triangle of land where the Minnesota and Cottonwood Rivers meet.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Ulm%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Hermann Monument in New Ulm rises 102 feet, a proud symbol of the town’s German heritage.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
