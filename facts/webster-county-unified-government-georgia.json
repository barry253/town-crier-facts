      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cotton once dominated Webster County’s farms, but the boll weevil forced a shift to peanuts, corn and wheat in the early twentieth century.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
