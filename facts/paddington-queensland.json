  "facts": [
    {
      "id": 1,
      "text": "Paddington was named after Mr B Clay's farm, which he called after his London birthplace of Paddington.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_Queensland"
    },
    {
      "id": 2,
      "text": "The suburb sits on Cook's Hill, part of a historic group that includes Ithaca War Memorial, Paddington Substation, and Ithaca Embankments.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_Queensland"
    },
    {
      "id": 3,
      "text": "Paddington grew around water holes fed by Ithaca Creek, which now largely lies in the neighbouring suburb of Red Hill.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_Queensland"
    },
    {
      "id": 4,
      "text": "The former Paddington Tram Depot, destroyed by fire in 1962, once served as a key transport hub for the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_Queensland"
    },
    {
      "id": 5,
      "text": "A factory built on Caxton Street in 1930 later reopened in 1976 as the Spaghetti Emporium, complete with a giant boot on its roof.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Paddington%2C_Queensland"
    },
    {
      "id": 6,
      "text": "The shop that opened in 1888 as Ashton's Butchers later became the State Butchery, illustrating Paddington's early commercial roots.",
      "sourceSentenceIds": [
        13
