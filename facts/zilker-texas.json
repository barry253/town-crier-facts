  "facts": [
    {
      "id": 1,
      "text": "In 1934, the city officially named it Zilker Metropolitan Park in honor of Andrew Jackson Zilker.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.austininformer.com/austin-informer/zilkerparkhistory",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 350 acres that became Zilker Park were donated to the city in stages by businessman Andrew Zilker.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.austintexas.org/austin-insider-blog/blog/post/historic-zilker-park-south-austin/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Barton Springs Pool, located in Zilker Park, hosts the Zilker Holiday Tree and Trail of Lights as well as the Austin City Limits Music Festival.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Zilker%2C_Austin%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Great Depression, federally‑funded projects enhanced the park’s natural beauty, and since 1934 it has become one of Austin’s most cherished public spaces.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.austintexas.org/austin-insider-blog/blog/post/historic-zilker-park-south-austin/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The springs’ history can be dated back thousands of years, as Native tribes found them to be a great spot to rest.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.austintexas.org/austin-insider-blog/blog/post/historic-zilker-park-south-austin/",
      "category": "history",
      "quality": "good"
    },
    {
