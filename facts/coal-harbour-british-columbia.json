  "facts": [
    {
      "id": 1,
      "text": "Coal Harbour earned its name from a modest coal mine founded in 1883 that never turned a profit.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coal_Harbour_(Vancouver_Island)"
    },
    {
      "id": 2,
      "text": "During World War II, the Royal Canadian Air Force stationed seaplane patrols here, with Canso flying boats based at the harbour.",
      "sourceSentenceIds": [
        17,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coal_Harbour_(Vancouver_Island)"
    },
    {
      "id": 3,
      "text": "After the war, Coal Harbour became British Columbia’s last whaling station, processing whales until its closure in 1967.",
      "sourceSentenceIds": [
        6,
        16,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Coal_Harbour_(Vancouver_Island)"
    },
    {
      "id": 4,
      "text": "A private individual maintains a free museum inside the original Canso hangar, showcasing seaplane and whaling artifacts.",
      "sourceSentenceIds": [
        9,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Coal_Harbour_(Vancouver_Island)"
    },
    {
      "id": 5,
      "text": "The main hangar also houses a 6‑metre blue‑whale jawbone, the largest ever found, a reminder of the town’s whaling past.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
