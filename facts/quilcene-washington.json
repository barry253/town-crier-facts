  "facts": [
    {
      "id": 1,
      "text": "Quilcene’s name comes from the Twana word meaning “salt‑water people,” a tribal group that lived on the bay.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
