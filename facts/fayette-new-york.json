      ],
      "source": "https://en.wikipedia.org/wiki/Fayette%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Both the Christ Evangelical and Reformed Church and the William Hoster House are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
