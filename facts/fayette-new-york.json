      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 5,
      "text": "The town’s northern line follows the Seneca River, part of the Cayuga‑Seneca Canal that links to the Erie Canal system.",
      "sourceSentenceIds": [
