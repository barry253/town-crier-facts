  "facts": [
    {
      "id": 1,
      "text": "Waverly began as Waverly Mills, a settlement formed when a dam, sawmill, and grist mill were built in 1856 at Little Waverly Lake's outlet.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waverly%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad company platted Waverly Station on its land in the southwest quarter of Section 33, and regular trains began operating there in 1868.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Waverly%2C_Minnesota",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Waverly Station was incorporated as a village in 1881 and renamed Waverly in 1885, dropping the “Station” suffix.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waverly%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Waverly Village Hall, built in 1939, earned a spot on the National Register of Historic Places for its architectural significance.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Waverly%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Despite a bank panic, financial crash, and grasshopper infestations in its early years, Waverly Mills managed to survive and grow.",
      "sourceSentenceIds": [
        15
      ],
