  "facts": [
    {
      "id": 1,
      "text": "Ayden began when farmer William Henry Harris asked the Atlantic Coast Line Railroad to build a depot in 1891, sparking the town's founding.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ayden%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was incorporated as \"Ayden\" on February 3, 1891, after the depot drew settlers and businesses.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ayden%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1947, the Skylight Inn Barbecue opened, and its third‑generation pitmaster Sam Jones now runs it, making it a regional barbecue staple.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitgreenvillenc.com/plan/cities-and-towns/ayden/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Ayden hosts an annual Kings of Q Barbecue Festival each May, honoring the founders of the town’s famous BBQ joints.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.visitgreenvillenc.com/plan/cities-and-towns/ayden/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ayden Historic District was listed on the National Register of Historic Places in 1994, preserving its 19th‑century architecture.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ayden%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s name honors Civil War Major General Bryan Grimes, whose family owned the land where the depot was built.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
