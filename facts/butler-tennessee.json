  "facts": [
    {
      "id": 1,
      "text": "Butler was originally called Smith’s Mill, named after the 1820 gristmill on Roan Creek.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.johnsoncountytnchamber.org/towns/butler/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1942 the Tennessee Valley Authority began building Watauga Dam, creating Watauga Lake that eventually flooded the original town.",
      "sourceSentenceIds": [
        14,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Butler%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The original town, now called Old Butler, was intentionally flooded and is known as “the town that wouldn’t drown.”.",
      "sourceSentenceIds": [
        27,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Butler%2C_Tennessee",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Butler Museum showcases the town’s relocation to higher ground and the effort to preserve its history.",
      "sourceSentenceIds": [
        7,
        12,
        13
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.museumofbutlertn.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Butler is the only incorporated town ever inundated by a TVA reservoir.",
      "sourceSentenceIds": [
