      "id": 1,
      "text": "Valley Forge National Historical Park is the historic site of the Continental Army’s 1777‑78 winter encampment under General George Washington.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/vafo/learn/historyculture/index.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The park’s landscapes, structures, and artifacts are tangible links to one of America’s most defining events.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nps.gov/vafo/learn/historyculture/index.htm",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 90‑minute guided trolley tour takes visitors from the renovated Visitor Center to the park’s main attractions.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.valleyforge.org/things-to-do/valley-forge-park/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "The 3,500‑acre park lets guests travel back over 200 years, where soldiers built hundreds of log cabins during their six‑month stay.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.valleyforge.org/things-to-do/valley-forge-park/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Valley Forge Christian Church, located in the community, is the largest church in Carter County.",
