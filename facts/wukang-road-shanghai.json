      "id": 1,
      "text": "Wukang Road earned its current name in 1943, after Wukang County in Zhejiang, though locals still remember its original French Concession title.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
