    {
      "id": 1,
      "text": "Mendota is the first city founded in Minnesota, established around the same time as Fort Snelling.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendota%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits where the Mississippi and Minnesota rivers meet, a spot highlighted in its historic crest.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendota%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Sibley Historic Site in Mendota houses two of Minnesota’s earliest stone buildings, including Henry Hastings Sibley’s house from the 1830s.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendota%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Dupuis House, built in 1854, was the first red‑brick home in Mendota and served a large Dakota mixed‑blood family.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendota%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mendota’s name comes from a mispronounced Dakota word, bdóte, meaning the center of the world in Dakota tradition.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mendota%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Mendota Mdewakanton Dakota Tribal Community, a non‑federally recognized group, has lived in the area since the late 19th‑century congressional acts.",
