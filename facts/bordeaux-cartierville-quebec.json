  "facts": [
    {
      "id": 1,
      "text": "Cartierville earned its name from Sir George‑Étienne Cartier and was officially declared a village in 1906.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ahuntsic-Cartierville",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Before 1906, the area now called Bordeaux‑Cartierville was known as Saint‑Joseph de Bordeaux.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ahuntsic-Cartierville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "New Bordeaux split from the independent village of Cartierville to become its own municipality in 1898.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ahuntsic-Cartierville",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three Orange‑line Metro stations—Ahuntsic, Henri‑Bourassa, and Sauvé—serve the borough’s north‑eastern corner in Montreal.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ahuntsic-Cartierville",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Visitation Church in Ahuntsic, built in the 18th century, is one of Montreal’s oldest churches and a protected historical monument.",
