    {
      "id": 1,
      "text": "In 1840, Saint Mother Theodore Guerin and companions arrived from France, founding the Sisters of Providence of Saint Mary‑of‑the‑Woods.",
      "sourceSentenceIds": [
        17,
        18,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Mary-of-the-Woods%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first St. Mary‑of‑the‑Woods College, opened in 1840, is the oldest Catholic women’s college in the United States.",
      "sourceSentenceIds": [
        28,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.discoverindianahistory.org/items/show/320",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1912 the community was renamed Saint Mary Of The Woods, a change that still marks its identity today.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Mary-of-the-Woods%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s grounds include the motherhouse of the Sisters of Providence, a historic complex that still houses the college.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Saint_Mary-of-the-Woods%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 2015 the college expanded its mission to admit men while preserving its heritage as a women’s college.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.smwc.edu/about/history/",
      "category": "culture",
      "quality": "good"
    },
    {
