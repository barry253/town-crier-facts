  "facts": [
    {
      "id": 1,
      "text": "Exira was named after Exira Eckman, the daughter of Judge John Eckman, who promised to buy a lot if the town adopted her name.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/exira_iowa",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded on June 15, 1857, Exira is the oldest town in Audubon County, with lots auctioned along the East Nishnabotna River.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/exira_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Exira served as Audubon County's first seat until 1879, when it lost to Audubon by a single vote amid railroad politics.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/exira_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Since 1861, Exira has hosted uninterrupted Fourth of July parades and fireworks that attract thousands each year.",
      "sourceSentenceIds": [
        12,
        21,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/exira_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Exira’s public school, completed in 1959, serves the community’s educational needs and has grown to accommodate modern curricula.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Exira%2C_Iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Agriculture and agribusiness remain the backbone of Exira’s economy, reflecting the region’s fertile farmland.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
