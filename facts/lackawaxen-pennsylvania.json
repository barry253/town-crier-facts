  "facts": [
    {
      "id": 1,
      "text": "Lackawaxen Township was founded in 1798, marking the early settlement of what would become Pike County's northernmost community.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pikehistorical.org/lackawaxen-township",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The name Lackawaxen comes from an Indian word meaning “Swift Waters,” reflecting the river that runs through the township.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pikehistorical.org/lackawaxen-township",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village sits where the Delaware and Lackawaxen Rivers meet, with the Delaware forming the state line with New York.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lackawaxen%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Roebling Bridge, built in 182, is the oldest surviving wire‑suspension bridge in the United States, a testament to 19th‑century engineering.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pikehistorical.org/lackawaxen-township",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Zane Grey Museum, once the author’s home, now preserves his legacy and offers a glimpse into early 20th‑century American literature.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.pikehistorical.org/lackawaxen-township",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "As Pike County’s largest township, Lackawaxen stretches from the Delaware River eastward, encompassing a diverse mix of forests and waterways.",
      "sourceSentenceIds": [
        13
