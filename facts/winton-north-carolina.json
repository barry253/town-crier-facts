  "facts": [
    {
      "id": 1,
      "text": "Winton was originally called Cotton's Ferry, named after Alexander Cotton who ran a ferry there in the 1740s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winton%2C_North_Carolina"
    },
    {
      "id": 2,
      "text": "In the mid‑1760s Benjamin Wynns donated 150 acres, and the town was laid out as Winton, the county seat of Hertford.",
      "sourceSentenceIds": [
        21,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winton%2C_North_Carolina"
    },
    {
      "id": 3,
      "text": "The original courthouse burned in 1830, a loss that reshaped the town’s early civic life.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winton%2C_North_Carolina"
    },
    {
      "id": 4,
      "text": "David Anderson Owen built North Carolina’s only tobacco factory in Winton in 1881, partnering with Washington Duke.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.carolana.com/NC/Towns/Winton_NC.html"
    },
    {
      "id": 5,
      "text": "Gray Gables, a massive three‑story Queen Anne house, stands in Winton and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.carolana.com/NC/Towns/Winton_NC.html"
    },
    {
      "id": 6,
      "text": "The Chowan River has shaped Winton’s history, influencing fishing, transportation, and the town’s daily life for centuries.",
