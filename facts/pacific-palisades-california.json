      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Old Santa Monica Forestry Station, a California Historic Landmark (No.840), was designated on March 20, 1970, preserving early forest management history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
