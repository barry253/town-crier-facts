      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Pacific Palisades Historical Society, founded in 1972, has archived over 3,000 photos housed at Santa Monica Public Library and transferred the Marquez Family Collection to Huntington Library.",
      "sourceSentenceIds": [
        24,
        25
      ],
