  "facts": [
    {
      "id": 1,
      "text": "Whiting is situated at the confluence of the Plover River and the Wisconsin River in central Wisconsin.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whiting_wisconsin"
    },
    {
      "id": 2,
      "text": "Industrial activity in Whiting began in 1852 with a sawmill constructed by Luther Hanchett and Amos Courtwright.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whiting_wisconsin"
    },
    {
      "id": 3,
      "text": "Originally platted as McDill Village in 1873, the village was incorporated in 1947 and renamed to honor George A. Whiting.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whiting_wisconsin"
    },
    {
      "id": 4,
      "text": "George A. Whiting founded the Whiting-Plover Paper Company in 1893, establishing a long legacy of papermaking in the local economy.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/whiting_wisconsin"
    },
    {
      "id": 5,
      "text": "Whiting is home to Neenah Paper Inc., continuing the area's long history of industrial production.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Whiting%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "Repurposed mill lands in Whiting now support community spaces and the Paper Mill Trail.",
