  "facts": [
    {
      "id": 1,
      "text": "Ashford takes its name from a massive ash tree that stood beside a ford in a local creek.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/ashford/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In March 1888, the Alabama Midland Railway erected a Victorian depot in Ashford, turning the town into a key waystation.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashford%2C_Alabama",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "When a 1915 fire razed most of Ashford, the historic depot was the sole building that survived.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashford%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A preservation committee led by Jimmy Burgess secured a grant in the 1980s to install a new roof on the depot.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ashford%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The depot building itself is listed on both the National Register of Historic Places and the Alabama Register of Landmarks and Heritage.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/ashford/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ashford High School’s mascot is the Yellow Jackets, affectionately called Buzz by students and locals.",
