      ],
      "source": "https://en.wikipedia.org/wiki/Whitaker%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Whitaker sits on the Monongahela River, just 3 miles upriver from Pittsburgh.",
      "sourceSentenceIds": [
        7
      ],
