      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Whitaker was incorporated on January 4, 1904, from part of former Mifflin Township.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
