      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Simón Bolívar’s troops camped at the Hacienda of Aranda in 1814 during Colombia’s fight for independence.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
