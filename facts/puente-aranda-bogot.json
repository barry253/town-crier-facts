      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The original hacienda was owned by Don Jorge Aranda and was founded in 1537 by oidor Francisco de Anuncibay.",
      "sourceSentenceIds": [
        8,
        18
      ],
      "sourceLabels": [
        "Web source 2",
