  "facts": [
    {
      "id": 1,
      "text": "Timber Lakes is a private gated community nestled in the mountains east of Heber City.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Timber_Lakes%2C_Utah"
    },
    {
      "id": 2,
      "text": "Developer Veigh Cummings purchased the land in 1970 to create a recreational mountain community of off-grid retreats.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/timber_lakes_utah"
    },
    {
      "id": 3,
      "text": "Established in 1971, Timber Lakes features about one thousand dwellings set within a mountainous landscape of diverse wildlife.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/timber_lakes_utah"
    },
    {
      "id": 4,
      "text": "The Timber Lakes area was used for logging and ranching in the late nineteenth century to support the growing Heber Valley.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/timber_lakes_utah"
    },
    {
      "id": 5,
      "text": "High-elevation terrain and dense forests within the Uinta National Forest once limited this region to seasonal or transient activities.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/timber_lakes_utah"
    },
    {
      "id": 6,
      "text": "In 1998, a large portion of the property was sold to The Church of Jesus Christ of Latter-day Saints for a youth camp.",
