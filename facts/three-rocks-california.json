  "facts": [
    {
      "id": 1,
      "text": "Three Rocks was founded in 1954 by Raymond Minnite, a Utah native who saw potential in the area.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Rocks%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from three large boulders that stand where the Sierra Madre range meets the sky, once called the Joaquin Rocks.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Three_Rocks%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Once a bustling oil boomtown, Three Rocks now resembles a modern‑day ghost town with abandoned buildings and nature reclaiming the streets.",
      "sourceSentenceIds": [
        6,
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scientificmagz.blog/three-rocks-ca-ghost-town",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Three Rocks grew around the nearby Kettleman Hills Oil Field, a key driver of its early economic boom.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.scientificmagz.blog/three-rocks-ca-ghost-town",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, the town’s remaining structures—once a school and general store—serve as quiet reminders of its former glory.",
