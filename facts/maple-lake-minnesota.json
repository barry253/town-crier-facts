      "id": 1,
      "text": "Maple Lake's history began in the mid-1850s after the government revoked the Winnebago treaty and opened Wright County to settlers.",
      "sourceSentenceIds": [
        7,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
