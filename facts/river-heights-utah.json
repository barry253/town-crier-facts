  "facts": [
    {
      "id": 1,
      "text": "River Heights was originally called Dry Town because water was difficult to reach on the bench above the Logan River.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://openroadguide.com/marker/river-heights"
    },
    {
      "id": 2,
      "text": "The town of River Heights was not formally incorporated until 1934, fifty years after the first families arrived.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://openroadguide.com/marker/river-heights"
    },
    {
      "id": 3,
      "text": "Early pioneers found it impossible to cross the Logan River due to thick willows and numerous beaver dams.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://riverheights.gov/river-heights-city-history/"
    },
    {
      "id": 4,
      "text": "Much of the land in River Heights was originally owned by the Central Pacific Railroad.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://riverheights.gov/river-heights-city-history/"
    },
    {
      "id": 5,
      "text": "River Heights sits at the foot of the Wasatch Range and overlooks the peaceful Logan River and Cache Valley.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://riverheights.gov/river-heights-city-history/"
    },
    {
      "id": 6,
      "text": "River Heights was one of the last settlements established in Cache County, slowly emerging from the sage and rocks.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
