  "facts": [
    {
      "id": 1,
      "text": "Lebec takes its name from French trapper Peter Lebeck, who was killed by a grizzly in 1837 at the site that later became Fort Tejon.",
      "sourceSentenceIds": [
        3,
        4,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebec%2C_California"
    },
    {
      "id": 2,
      "text": "Nestled in Castac Valley between the San Emigdio and Tehachapi Mountains, Lebec sits at 3,481 feet above sea level.",
      "sourceSentenceIds": [
        14,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebec%2C_California"
    },
    {
      "id": 3,
      "text": "Lebec once hosted the grand Spanish Colonial Revival Lebec Hotel, built in 1921, which attracted Hollywood executives and movie stars before World War II.",
      "sourceSentenceIds": [
        27,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebec%2C_California"
    },
    {
      "id": 4,
      "text": "The town’s first post office opened in 1895, having been transferred there from nearby Tejon.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lebec%2C_California"
    },
    {
      "id": 5,
      "text": "Discovery of the Taft oil fields in the early 20th century marked a major economic boom for Lebec.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ridgeroutemuseum.org/welcome-to-lebec/"
    },
    {
      "id": 6,
      "text": "The 1857 Fort Tejon earthquake caused extensive damage to the nearby military fort, a landmark that once guarded the area.",
      "sourceSentenceIds": [
