  "facts": [
    {
      "id": 1,
      "text": "Vermillion Township was named for the Vermillion River, whose Dakota name translates to the river's current name.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://lakesnwoods.com/Vermillion.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Vermillion's early growth surged when the Hastings and Dakota Railroad arrived in 1866, opening the area to farmers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vermillion_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Vermillion River meanders through the town, shaping its landscape and providing a natural corridor for wildlife.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Vermillion%2C_Minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Vermillion’s valley shapes local topography, creating narrow floodplains, wetlands, and upland prairies that transition into riparian zones along the riverbanks.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vermillion_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Vermillion preserves its historic Main Street and rural charm, keeping the town a peaceful suburb amid Minnesota’s fastest-growing counties.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/vermillion_minnesota",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Below the Mississippi bottomland, the Vermillion River splits into two streams that form the Vermillion Slough.",
