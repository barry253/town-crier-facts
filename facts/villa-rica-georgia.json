  "facts": [
    {
      "id": 1,
      "text": "Villa Rica was founded in 1826 when farmers and gold miners from Pennsylvania, New Jersey and Delaware settled in the area then called Hixtown.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.villarica.org/living/about/history.php"
    },
    {
      "id": 2,
      "text": "The Pine Mountain Gold Museum at Stockmar Park, opened in 2008, is the city’s first Gold Strike museum and sits on a historic landmark.",
      "sourceSentenceIds": [
        1,
        10,
        24
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.villarica.org/living/about/history.php"
    },
    {
      "id": 3,
      "text": "In 1882 the arrival of the railroad merged Hixtown and Cheevestown into the new city of Villa Rica.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Villa_Rica%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Villa Rica’s first United Methodist Church, a log cabin built in 1830, was the city’s earliest church building.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Villa_Rica%2C_Georgia"
    },
    {
      "id": 5,
      "text": "The Dorough Round Barn and Farm was added to the National Register of Historic Places in 1980, preserving a unique 19th‑century agricultural structure.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
