  "facts": [
    {
      "id": 1,
      "text": "Dilliner takes its name from the Dilliner family, German pioneers who founded the town in Dunkard Township.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dilliner_pennsylvania"
    },
    {
      "id": 2,
      "text": "The community lies along the Monongahela River and Pennsylvania Route 88, just 1.7 miles northwest of Point Marion.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dilliner%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "Dilliner developed around bituminous coal mining on the Pittsburgh seam during the early twentieth century.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dilliner_pennsylvania"
    },
    {
      "id": 4,
      "text": "Coal companies built uniform “cookie‑cutter” houses to accommodate laborers, turning the area from agrarian roots into an industrial outpost.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dilliner_pennsylvania"
    },
    {
      "id": 5,
      "text": "With elevations averaging around 1,000 feet, the landscape has historically supported both agriculture and coal mining.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/dilliner_pennsylvania"
    },
    {
      "id": 6,
      "text": "Dunkard Creek converges with the Monongahela River about 1.5 miles north of Dilliner, supplying water but also posing flood risks during heavy rain.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
