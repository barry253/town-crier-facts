      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1885, Lithium Baptist Church was organized, followed by St. John the Evangelist Catholic Church in 1896, reflecting early religious diversity.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
