      "id": 1,
      "text": "After a contest, residents chose the name Intercession City, inspired by their constant prayers, replacing the original Interocean City.",
      "sourceSentenceIds": [
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
