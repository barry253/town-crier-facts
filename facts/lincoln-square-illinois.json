  "facts": [
    {
      "id": 1,
      "text": "Lincoln Square was officially named on August 27, 1853, in an unusual ceremony.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s iconic mural, “A Touch of Europe: Memories of Germany,” celebrates German heritage with scenes of the Rhine, Bavarian villages, and the Alps.",
      "sourceSentenceIds": [
        3,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://voices.uchicago.edu/findingchicago/2023/08/23/finding-chicago-the-lost-and-found-of-lincoln-square-community/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Abraham Lincoln helped plat the town and served as counsel for the Chicago & Mississippi Railroad before the town was named after him.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lincoln%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area’s history dates back to the 1850s and 1860s when farmers turned prairie into farmland that later became Lincoln Square.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lincolnsquare.org/cultural-information",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lincoln Square’s streets are lined with murals and public art that invite residents to stroll and experience the neighborhood’s rich cultural tapestry.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lincolnsquare.org/cultural-information",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The neighborhood evolved into a vibrant, multicultural community, as highlighted in local guides that trace its development over time.",
      "sourceSentenceIds": [
        16
