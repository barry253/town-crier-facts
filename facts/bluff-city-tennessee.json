  "facts": [
    {
      "id": 1,
      "text": "Bluff City began as Choate’s Ford, a shallow Holston River crossing that Native Americans and early settlers used.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bluff_city_tennessee"
    },
    {
      "id": 2,
      "text": "The town was renamed Union after the East Tennessee, Virginia and Georgia Railroad built a bridge there, reflecting pro-Union sentiment.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bluff_city_tennessee"
    },
    {
      "id": 3,
      "text": "During the Civil War, Union was briefly called Zollicoffer after Confederate General Felix Zollicoffer, then reverted after his death.",
      "sourceSentenceIds": [
        5,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/bluff_city_tennessee"
    },
    {
      "id": 4,
      "text": "The name Bluff City, adopted July 1, 1887, honors the river bluffs overlooking the Holston that dominate the skyline.",
      "sourceSentenceIds": [
        1,
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bluff_city_tennessee"
    },
    {
      "id": 5,
      "text": "Bluff City sits within the Tri‑Cities metropolitan area, part of the larger Johnson City‑Kingsport‑Bristol combined statistical area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bluff_City%2C_Tennessee"
    }
  ]
