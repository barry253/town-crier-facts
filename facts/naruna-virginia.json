  "facts": [
    {
      "id": 1,
      "text": "Naruna’s name comes from a Native American word of unknown meaning, likely tied to Siouan-speaking tribes such as the Monacan.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/naruna_virginia",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the late 1800s, the Lynchburg and Durham Railroad built a line through Naruna, later leased to Norfolk and Western, turning the town into a train stop.",
      "sourceSentenceIds": [
        1,
        9,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/naruna_virginia",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Naruna sits near the Staunton River, a tributary of the Roanoke, whose alluvial valley supplies fertile soils for local farms.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/naruna_virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Naruna experiences a humid subtropical climate, with hot July highs around 88°F and mild winters that can drop to 28°F, averaging 45 inches of rain yearly.",
      "sourceSentenceIds": [
        4,
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/naruna_virginia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 5,
      "text": "European settlers first arrived in the 1730s, establishing Scotch‑Irish outposts near Hat Creek as part of Virginia’s broader Piedmont expansion.",
      "sourceSentenceIds": [
        28,
        29,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/naruna_virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1917, the Norfolk and Western operated Naruna’s station, shipping timber and produce from surrounding pine forests and farms.",
