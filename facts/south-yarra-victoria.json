  "facts": [
    {
      "id": 1,
      "text": "South Yarra was originally inhabited by the Yalukit‑willam clan of the Boonwurrung people who called the area Terneet, the meaning of which has been lost.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Yarra",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Jam Factory, a former factory converted into an upmarket shopping centre and cinemas, stands as a major landmark in South Yarra.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Yarra",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Prahran Market, located in South Yarra, is one of Melbourne’s most popular and historic fresh‑produce markets.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Yarra",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "South Yarra’s main shopping corridor runs along Toorak Road and Chapel Street, where trendy boutiques, restaurants, nightclubs and café culture thrive.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Yarra",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "South Yarra station, on the Pakenham, Cranbourne, Frankston and Sandringham lines, opened in 1874 and helped spur the suburb’s rapid growth.",
      "sourceSentenceIds": [
        25,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/South_Yarra",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Melbourne High School, with its 1930s Gothic main building, is a local landmark and one of the suburb’s heritage‑registered buildings.",
      "sourceSentenceIds": [
