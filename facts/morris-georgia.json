    {
      "id": 1,
      "text": "Morris, Georgia was likely named after James Morris, the son of an early railroad agent.",
      "sourceSentenceIds": [
        1,
        4,
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
