  "facts": [
    {
      "id": 1,
      "text": "Forest Hills earned its name from early settlers who noted the dense forest of ash, basswood, beech, elm, cherry, oak, maple, and walnut trees that crowned the hills.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://opennet.us/cchs/forest/forest.htm",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Back in its early days, Forest Hills hosted a cheese factory, post office, blacksmith shop, ashery, Woodman Hall, and a general country store.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://opennet.us/cchs/forest/forest.htm",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Riley Dexter, the first white child buried in Clinton County, is remembered in Forest Hills history despite the tree that once stood there.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://opennet.us/cchs/forest/forest.htm",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of automobiles, airplanes, radio, television, and electricity sparked joyous 'aha' moments among Forest Hills residents.",
      "sourceSentenceIds": [
        11
