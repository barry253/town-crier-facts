  "facts": [
    {
      "id": 1,
      "text": "Jasper was originally called Fitzhugh, named after a Grand Trunk vice president, when the railway divisional point opened in 1911.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town adopted the name Jasper after the nearby fur trade post, linking it to early North West Company history.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Jasper House, a 1813 fur trade outpost, lay 35 km north of today’s town and was part of the York Factory Express route.",
      "sourceSentenceIds": [
        6,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jasper sits where the Athabasca and Miette Rivers meet, a spot that helped shape its early settlement.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1913 the townsite was surveyed, and by 1916 an internment camp operated briefly at Dominion Park during WWI.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By 1931 road access from Edmonton made Jasper a commercial hub for the surrounding national park.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jasper%2C_Alberta",
