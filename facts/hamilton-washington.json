  "facts": [
    {
      "id": 1,
      "text": "Hamilton was first settled in 1877 by William Hamilton and was officially incorporated on March 19, 1891.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railroad reached Hamilton in 1890, causing houses to face north toward the tracks instead of south toward the river.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofhamiltonwa.com/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s public development authority was created in 2004 to relocate residents, a move completed with Forterra’s help in 2018.",
      "sourceSentenceIds": [
        10,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 4,
      "text": "Hamilton sits within the Skagit River floodway, with major floods recorded in 2003, 2006, 2017, and 2021.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Washington",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 2021 flood, the local post office closed and mail is now forwarded from the Concrete post office 13 miles away.",
      "sourceSentenceIds": [
        16,
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamilton%2C_Washington",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Martin Smith, an early settler from Iowa, arrived in 1875 and helped establish the community that became Hamilton.",
