  "facts": [
    {
      "id": 1,
      "text": "New Bern was founded in October 1710 by Palatines and Swiss led by Christoph von Graffenried.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Bern%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name honors Bern, the Swiss region from which many settlers came.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Bern%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "New Bern sits where the Neuse and Trent Rivers meet, just upriver from Pamlico Sound.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Bern%2C_North_Carolina",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After Raleigh became capital in 1792, New Bern rebuilt its economy by expanding trade to the Caribbean and New England.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Bern%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic New Bern Firemen's Museum and NC History Center showcase the city’s rich past, including its role as a Union contraband camp.",
      "sourceSentenceIds": [
