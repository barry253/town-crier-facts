      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the valley of Soda Butte Creek, which flows southwest into Wyoming and joins the Lamar River in Yellowstone National Park.",
      "sourceSentenceIds": [
        10,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
