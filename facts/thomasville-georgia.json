  "facts": [
    {
      "id": 1,
      "text": "Thomasville was founded in 1825 as the seat of the newly formed Thomas County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomasville%2C_Georgia"
    },
    {
      "id": 2,
      "text": "The town was named after Major General Jett Thomas, a War of 1812 patriot who helped build Milledgeville’s Old State Capitol.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thomasville.org/our-history"
    },
    {
      "id": 3,
      "text": "In the late 1800s Thomasville became known as the “Winter Resort of the South,” drawing northerners for its pine‑scented air and health retreats.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thomasville.org/our-history"
    },
    {
      "id": 4,
      "text": "The historic Flipper’s Ditch, a former railroad water stop, still operates and is a landmark since 1977.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thomasville.org/our-history"
    },
    {
      "id": 5,
      "text": "Actress Joanne Woodward, Oscar winner for “The Three Faces of Eve,” was born in Thomasville in 1930.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thomasville.org/our-history"
    },
    {
      "id": 6,
      "text": "The Thomasville Center for the Arts, the Jack Hadley Black History Museum, and Pebble Hill Plantation form a trio of cultural sites that celebrate the town’s diverse heritage.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Thomasville%2C_Georgia"
    }
