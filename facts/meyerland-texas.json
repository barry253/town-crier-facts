  "facts": [
    {
      "id": 1,
      "text": "Meyerland takes its name from the Meyer family, who once owned 6,000 acres of land in southwest Houston.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meyerland%2C_Houston"
    },
    {
      "id": 2,
      "text": "Three generations of the Meyer family were instrumental in turning the former rice fields into the neighborhood we know today.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://meyerland.net/about/the-history-of-meyerland/"
    },
    {
      "id": 3,
      "text": "Before development, Meyerland was a patch of rice fields leased to farmers and cattlemen for many years.",
      "sourceSentenceIds": [
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meyerland%2C_Houston"
    },
    {
      "id": 4,
      "text": "Meyerland sits at the heart of Houston’s Jewish community, hosting the Jewish Community Center and several historic synagogues.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meyerland%2C_Houston"
    },
    {
      "id": 5,
      "text": "The 2017 Hurricane Harvey flood exposed Meyerland’s vulnerability, sparking mega‑scale projects like Project Brays to move homes out of the 100‑year floodplain.",
      "sourceSentenceIds": [
        22,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Meyerland%2C_Houston"
    },
    {
      "id": 6,
      "text": "Today, luxury homes over a million dollars rise several feet above the base flood elevation, reflecting the area’s high‑end redevelopment.",
