  "facts": [
    {
      "id": 1,
      "text": "Founded in 1906 by Heinrich Friedrich Dangberg Jr., Minden takes its name from a German town near his father's birthplace.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minden%2C_Nevada"
    },
    {
      "id": 2,
      "text": "For over a century, Minden sounded a sundown siren at 6 p.m., a relic of a 1917 ordinance that once forced Washoe Indians out of town.",
      "sourceSentenceIds": [
        5,
        21,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minden%2C_Nevada"
    },
    {
      "id": 3,
      "text": "Today visitors can tour the historic Dangberg Ranch, where the town’s founders once built their homes and businesses.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitcarsonvalley.org/minden-nevada/"
    },
    {
      "id": 4,
      "text": "Since 1916, Minden has served as the seat of Douglas County, anchoring the region’s civic life.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minden%2C_Nevada"
    },
    {
      "id": 5,
      "text": "Carson Valley’s Minden is renowned among pilots as one of the world’s premier gliding spots, with flights exceeding 990 miles.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Minden%2C_Nevada"
    },
    {
      "id": 6,
      "text": "The Western Nevada College Douglas campus, located in Minden, offers higher education opportunities to the local community.",
      "sourceSentenceIds": [
        18
