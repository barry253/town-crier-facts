  "facts": [
    {
      "id": 1,
      "text": "Flute Springs takes its name from local springs that emerge from the hilly landscape and feed into nearby Mud Creek.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flute_springs_oklahoma"
    },
    {
      "id": 2,
      "text": "Cherokee families established the basis of local culture in Flute Springs after their forced relocation from the southeastern United States.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flute_springs_oklahoma"
    },
    {
      "id": 3,
      "text": "Flute Springs lies along the historic route associated with the Cherokee Trail of Tears in the foothills of the Ozark Mountains.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flute_springs_oklahoma"
    },
    {
      "id": 4,
      "text": "The Flute Springs Cemetery contains historic graves of Cherokee families displaced during the forced relocation of the 1830s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flute_springs_oklahoma"
    },
    {
      "id": 5,
      "text": "Land allotments between 1900 and 1920 facilitated homesteading for both Native allottees and white settlers throughout Flute Springs.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/flute_springs_oklahoma"
    },
    {
      "id": 6,
      "text": "Flute Springs experiences a humid subtropical climate with hot, humid summers and mild winters.",
      "sourceSentenceIds": [
        29
