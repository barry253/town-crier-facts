  "facts": [
    {
      "id": 1,
      "text": "Knob Lick sits in the Ozarks of southern Saint Francois County, Missouri, just east of U.S. Route 67.",
      "sourceSentenceIds": [
        3,
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knob_Lick%2C_Missouri",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The town’s name comes from a nearby summit called a “knob” and a natural salt lick that attracted wildlife.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Knob_Lick%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the late 1800s, the Iron Mountain Railway opened granite quarries that turned Knob Lick into a bustling mining hub.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.semorailroads.com/product/9978911/knob-lick-a-history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today, a 80‑acre conservation area on the summit offers a granite glade, picnic spots, and a closed fire lookout tower.",
      "sourceSentenceIds": [
