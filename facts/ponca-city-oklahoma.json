  "facts": [
    {
      "id": 1,
      "text": "Ponca City takes its name from the Ponca tribe, many of whom were moved from Nebraska to Oklahoma between 1877 and 1880.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponca_City%2C_Oklahoma",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Oil pioneer William G. Marland struck the first successful well in 1911 and built Ponca City’s refinery in 1918, shaping the town’s economy.",
      "sourceSentenceIds": [
        7,
        10,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponca_City%2C_Oklahoma",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The historic Marland Mansion and the Standing Bear Pioneer Woman Museum both sit on the National Register of Historic Places in Ponca City.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponca_City%2C_Oklahoma",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In September 2024 the National Park Service declared Ponca City and Kay County a World War II Heritage City for its wartime contributions.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ponca_City%2C_Oklahoma",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Conoco Museum chronicles the town’s oil boom while Standing Bear Park honors the Native American heritage of the area.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.travelok.com/at/Ponca_City",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ponca City offers outdoor fun with Lake Ponca’s walking trails, disc‑golf courses, and a vibrant downtown that hosts festivals year‑round.",
      "sourceSentenceIds": [
        18,
