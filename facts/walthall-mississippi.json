      "quality": "good"
    },
    {
      "id": 2,
      "text": "Walthall County’s economy grew from cotton farming to cattle ranching over time.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/walthall-county/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "More than half of Walthall County’s 3,400 farms were run by tenant farmers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippiencyclopedia.org/entries/walthall-county/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Walthall farmers began with dairy cattle, then shifted to corn, swine, and cotton.",
      "sourceSentenceIds": [
        24
