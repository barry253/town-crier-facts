  "facts": [
    {
      "id": 1,
      "text": "Country Club got its name from a Westchester golf club founded in 1881 that burned down in 1922, sparking the sale of its land for homes.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Country_Club,_Bronx",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Long before streets were paved, the Lenape Siwanoy band had called the area now known as Country Club home since around 1000 A.D.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Country_Club,_Bronx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Our Lady of the Assumption Parish, founded in 1928, became a spiritual and social hub, hosting processions and feasts that still echo today.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/country-club",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Country Club Civic Association, formed mid‑century, successfully fought high‑rise projects and pushed for neighborhood improvements.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/country-club",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Just north of Country Club lies Pelham Bay Park, New York City’s largest public park, which includes the popular Orchard Beach.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Country_Club%2C_Bronx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The late‑19th‑century Pelham Bay and City Island Railroad made the area a seaside retreat for wealthy New Yorkers.",
      "sourceSentenceIds": [
        4
