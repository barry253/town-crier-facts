  "facts": [
    {
      "id": 1,
      "text": "Alexis began as Alexandria Station in 1870 when the railroad reached the spot, giving the village its original name.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexis%2C_Illinois",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was renamed Alexis after Grand Duke Alexis visited the area, a nod to the visiting dignitary.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexis%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Alexis straddles the Warren–Mercer county line, with about four north–south blocks in Warren and two in Mercer.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexis%2C_Illinois",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "Water from the village feeds Middle Henderson Creek, a westward tributary that eventually joins the Mississippi River south of Oquawka.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexis%2C_Illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The village’s biggest employer is Alexis Fire Equipment, a manufacturer of fire engines and related gear.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alexis%2C_Illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Alexis sits roughly fourteen miles northeast of Monmouth, the Warren County seat, and nineteen miles southeast of Aledo, the Mercer County seat.",
      "sourceSentenceIds": [
        17
      ],
