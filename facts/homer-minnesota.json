  "facts": [
    {
      "id": 1,
      "text": "Homer, Minnesota was platted in 1855 by fur trader Willard Bunnell, who named the town after his hometown of Homer, New York.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/homer_minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Willard Bunnell House, built in the 1850s, is Minnesota's first permanent house south of Saint Paul and now serves as a historic house museum.",
      "sourceSentenceIds": [
        5,
        7,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Homer%2C_Minnesota",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Homer sits on the west bank of the Mississippi River, where early settlers used the river for trade and transportation of goods.",
      "sourceSentenceIds": [
        8,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/homer_minnesota",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Amtrak’s Empire Builder runs through Homer on BNSF tracks, but the train never stops in the town.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Homer%2C_Minnesota",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "In the late 1840s, Willard Bunnell received permission from Dakota Chief Wapasha III to build a log cabin on the Mississippi, first permanent settlement south of Saint Paul.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/homer_minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Homer experiences a humid continental climate, with average annual temperatures around 47°F, July highs near 83°F, and January lows dropping to 9°F.",
