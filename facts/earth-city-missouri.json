  "facts": [
    {
      "id": 1,
      "text": "Earth City was originally planned in 1970 by Linclay Corporation as a self‑contained community on 1,300 acres with residential, retail, office, and industrial components.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Earth_City,_Missouri",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The project faced financial challenges, leading to a sale in 1974 and foreclosure by Ford Motor Credit in 1977.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Earth_City,_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Earth City spans about 1,360 acres and houses roughly 5 million square feet of built space, hosting Fortune 500 companies across logistics, services, and production.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Earth_City,_Missouri",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The development includes a 500‑year flood levee and is protected by robust infrastructure, including access to Interstate 270 and Missouri Route 370.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Earth_City,_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Earth City’s location on the Missouri River makes it a key hub for regional transport, with the river serving as a major waterway for shipping.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Earth_City,_Missouri",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area covers approximately 1.794 square miles of land and 0.331 square miles of water, largely influenced by its adjacency to the Missouri River.",
