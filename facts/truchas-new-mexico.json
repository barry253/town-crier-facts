  "facts": [
    {
      "id": 1,
      "text": "Truchas was founded in 1754 when Spanish Governor Tomás Vélez Cachupín issued a land grant to expand settlement on the northern frontier.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Truchas,_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village sits on a high shoulder of the Sangre de Cristo Mountains, roughly 8,000 feet above sea level.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Truchas%2C_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Truchas experiences a semi‑arid highland climate, with cold winters and mild summers thanks to its 8,050‑foot elevation.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Truchas,_New_Mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original land grant aimed to protect the nearby town of Santa Cruz from raids by Ute, Apache, and Comanche tribes.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Truchas%2C_New_Mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the 1970s artists flocked to Truchas, and the 1988 film 'The Milagro Beanfield War' was shot there, sparking a thriving arts scene.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Truchas,_New_Mexico",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Truchas is Spanish for 'trout,' a nod to the trout that once thrived in its nearby rivers.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Truchas%2C_New_Mexico",
