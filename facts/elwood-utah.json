  "facts": [
    {
      "id": 1,
      "text": "Elwood is located in the Bear River Valley, with the Bear River and Malad River forming its eastern and western borders.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elwood%2C_Utah"
    },
    {
      "id": 2,
      "text": "Allen C. Hunsaker is known as the founding father of Elwood, which was previously called Fairview and Manila.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elwoodtown.gov/history-of-elwood"
    },
    {
      "id": 3,
      "text": "The area around Elwood was originally covered with a lush growth of native grasses before it became farmland.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elwoodtown.gov/history-of-elwood"
    },
    {
      "id": 4,
      "text": "Elwood incorporated in 1933 to establish a culinary water system, which took until 1950 to be fully completed.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elwoodtown.gov/history-of-elwood"
    },
    {
      "id": 5,
      "text": "Field corn became a popular crop in Elwood for both silage and grain after the local sugar factory closed.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elwoodtown.gov/history-of-elwood"
    },
    {
      "id": 6,
      "text": "Early settlers in Elwood often worked their homesteads during the summer and returned to Bear River City for the winter.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://elwoodtown.gov/history-of-elwood"
    }
  ]
