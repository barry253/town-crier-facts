  "facts": [
    {
      "id": 1,
      "text": "Orangevale started as the 1844 Rancho San Juan Mexican land grant, later called Orange Vale Colony.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orangevale%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the orange groves planted by the colonization company that first settled the area.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.orangevalechamber.com/orangevale-history-1",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Gentle rolling hills once covered with oak trees and Maidu trails attracted cattlemen who arrived on the new transcontinental railroad.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.orangevalechamber.com/orangevale-history-1",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Orangevale History Museum chronicles the town’s journey from citrus colony to thriving suburb, showcasing artifacts from both eras.",
      "sourceSentenceIds": [
        10,
        11,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wonderfulmuseums.com/museum/orangevale-history-museum/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Orangevale’s historic center earned a designation as a Point of Historical Interest by the California State Historical Resources Commission.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.orangevalechamber.com/orangevale-history-1",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community sits about 25 miles northeast of Sacramento, offering panoramic views of the Sierra Nevada foothills.",
      "sourceSentenceIds": [
        22,
