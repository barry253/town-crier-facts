  "facts": [
    {
      "id": 1,
      "text": "Clappertown sits in the heart of Morrisons Cove, a valley carved by Piney Creek that feeds into the Susquehanna River watershed.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clappertown%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The community’s name comes from the Clapper family, early settlers who farmed the limestone‑rich soil of the valley in the late 1700s.",
      "sourceSentenceIds": [
        2,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clappertown_pennsylvania"
    },
    {
      "id": 3,
      "text": "Lock Mountain rises just west of Clappertown, reaching 2,007 feet and framing the valley with a dramatic Appalachian ridge.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Clappertown%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Clappertown’s roots trace back to the mid‑18th century when settlers pushed into the fertile valleys after the French and Indian War ended hostilities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clappertown_pennsylvania"
    },
    {
      "id": 5,
      "text": "The town’s geography is part of the ridge‑and‑valley province, where parallel ridges and valleys were shaped by tectonic folding and erosion.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/clappertown_pennsylvania"
    },
    {
      "id": 6,
      "text": "Huston Township, where Clappertown lies, was first settled in 1770 and only joined Blair County when the county was formed in 1846.",
