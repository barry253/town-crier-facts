  "facts": [
    {
      "id": 1,
      "text": "Cleo Springs was originally known as Cleo and established its first post office on March 21, 1894.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cleo_Springs%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "Legend says Cleo Springs was named for Cle-oh-i-to-mo, an American Indian maiden who lived here when Coronado passed through in 1541.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CL011"
    },
    {
      "id": 3,
      "text": "The Choctaw Northern Railroad arrived in Cleo Springs in 1902, connecting the town to a line running toward the Kansas border.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CL011"
    },
    {
      "id": 4,
      "text": "During the mid-1940s and 1950s, Cleo Springs featured numerous blacksmiths, gasoline stations, and automobile repair garages.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CL011"
    },
    {
      "id": 5,
      "text": "The Cleo Springs Sod House, located just north of town, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=CL011"
    },
    {
      "id": 6,
      "text": "Cleo Springs is located in northern Major County, about ten miles north of the county seat in Fairview.",
