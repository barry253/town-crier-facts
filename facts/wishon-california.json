  "facts": [
    {
      "id": 1,
      "text": "Wishon began as a railroad town in 1923, serving as the mountain terminus for the Minarets and Western Railroad.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wishon%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The 53‑mile line ran from the western end of Bass Lake Dam to Pinedale, carrying logs to a large mill in the valley.",
      "sourceSentenceIds": [
        7,
        8,
        12,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wishon%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wishon’s name honors Emory Wishon, a pioneer in hydroelectric power who helped develop Bass Lake’s water‑powered plant.",
      "sourceSentenceIds": [
        5,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wishon%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "For a brief period in the 1930s, passengers could ride the train from Wishon to Pinedale, a rare passenger service on a logging line.",
      "sourceSentenceIds": [
        10,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wishon%2C_California",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The original settlement now lies beneath Bass Lake, as the reservoir’s expansion flooded the town’s streets and buildings.",
      "sourceSentenceIds": [
        19,
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wishon%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Wishon’s post office, established in 1923, remained in operation until 1986, outlasting the Sugar Pine Lumber Company’s eight‑year run.",
      "sourceSentenceIds": [
        21,
        25
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Wishon%2C_California",
