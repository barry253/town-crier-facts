  "facts": [
    {
      "id": 1,
      "text": "Panna Maria, meaning \"Virgin Mary\" in Polish, was founded on Christmas Eve 1854 when settlers celebrated midnight Mass under a huge oak.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://faroutmagazine.co.uk/panna-maria-a-small-piece-of-poland-in-rural-texas/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosts the first permanent Polish settlement in the U.S., where the 1858 St. Joseph’s School became the nation’s first Polish‑language school.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://faroutmagazine.co.uk/panna-maria-a-small-piece-of-poland-in-rural-texas/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1877 Immaculate Conception Church sits beside a sprawling oak that still marks the original meeting spot of the founders.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://texastimetravel.com/cities/panna-maria/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Father Leopold Moczygemba, a Franciscan missionary from Upper Silesia, recruited the settlers in 1852 and sent letters that sparked the migration.",
      "sourceSentenceIds": [
        10,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Panna_Maria%2C_Texas",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Panna Maria’s historic district is listed on the National Register of Historic Places, preserving its 19th‑century architecture.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Panna_Maria%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s Silesian dialect survives in local speech, a rare linguistic relic of 19th‑century Polish immigrants.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
