      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1874, Harris Hamlin’s son, Judge Butler Hamlin Sr., and his wife Sallina erected an elegant Victorian home that still stands today.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.waynehistorypa.com/places/id/98",
      "category": "landmark",
      "quality": "good"
    },
    {
