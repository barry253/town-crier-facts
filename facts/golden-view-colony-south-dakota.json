  "facts": [
    {
      "id": 1,
      "text": "Golden View Colony was established in 2013 as a division from the Cedar Grove Hutterite Colony in Platte, South Dakota.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_view_colony_south_dakota"
    },
    {
      "id": 2,
      "text": "Golden View Colony belongs to the Schmiedeleut Group 2 tradition of Anabaptist communal living, emphasizing shared labor and pacifism.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_view_colony_south_dakota"
    },
    {
      "id": 3,
      "text": "The community at Golden View Colony focuses on agriculture, including hog farming, grain production, and direct-to-consumer meat sales.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_view_colony_south_dakota"
    },
    {
      "id": 4,
      "text": "Golden View Colony is situated on the flat to gently rolling prairie terrain typical of southeastern South Dakota's glacial till plains.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_view_colony_south_dakota"
    },
    {
      "id": 5,
      "text": "Golden View Colony experiences a humid continental climate with cold, snowy winters and warm, humid summers.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/golden_view_colony_south_dakota"
    },
    {
      "id": 6,
      "text": "Modern expansions at Golden View Colony include a large 2,400-sow hog barn constructed around 2021.",
