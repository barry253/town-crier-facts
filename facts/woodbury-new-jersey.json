  "facts": [
    {
      "id": 1,
      "text": "Woodbury was founded in 1683 by the Wood family from Bury, England, after Henry Wood escaped religious persecution at age 80.",
      "sourceSentenceIds": [
        1,
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Woodbury_Heights%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Woodbury Friends Meeting House, built in 1715 and expanded in 1785, stands as one of the town’s oldest religious structures.",
      "sourceSentenceIds": [
        5,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://philadelphiaencyclopedia.org/locations/woodbury-new-jersey/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rail service returned to Woodbury in 1854 when the West Jersey Railroad restored tracks, linking the town to the rest of South Jersey.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://philadelphiaencyclopedia.org/locations/woodbury-new-jersey/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At the dawn of the twentieth century, Woodbury’s glass industry thrived, with the Woodbury Bottle Works producing a significant portion of the state’s glass.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://philadelphiaencyclopedia.org/locations/woodbury-new-jersey/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Margaret Regional School, a Pre‑K to 8 Catholic elementary school, opened its doors in 1963 under the Diocese of Camden.",
