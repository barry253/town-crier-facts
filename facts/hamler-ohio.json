  "facts": [
    {
      "id": 1,
      "text": "Hamler takes its name from pioneer John Hamler, the village’s first settler and landowner.",
      "sourceSentenceIds": [
        3,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamler%2C_Ohio"
    },
    {
      "id": 2,
      "text": "John Hamler arrived in 1846, clearing forests and swamps to turn the area into farmland.",
      "sourceSentenceIds": [
        4,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hamler_ohio"
    },
    {
      "id": 3,
      "text": "The Baltimore & Ohio Railroad reached Hamler in 1869, sparking rapid settlement and land sales.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hamler_ohio"
    },
    {
      "id": 4,
      "text": "By the late 1880s, Hamler boasted a stave factory, brick school, churches, stores, a hotel, and social lodges.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/hamler_ohio"
    },
    {
      "id": 5,
      "text": "Every summer, Hamler hosts a festival featuring German polka bands, dancing, and traditional food.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hamler%2C_Ohio"
    },
    {
      "id": 6,
      "text": "The original town plan set aside 5⅓ acres for a depot, with 75 lots south and 96 north of the tracks.",
      "sourceSentenceIds": [
