  "facts": [
    {
      "id": 1,
      "text": "Sumerduck’s name comes from the summer flocks of ducks that once gathered there.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sumerduck%2C_Virginia"
    },
    {
      "id": 2,
      "text": "The Sumerduck Historic District earned a spot on the National Register of Historic Places in 2009.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sumerduck%2C_Virginia"
    },
    {
      "id": 3,
      "text": "That district showcases a remarkably intact collection of late‑19th‑ and early‑20th‑century buildings that capture every key aspect of the village’s modest history.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5164/"
    },
    {
      "id": 4,
      "text": "At its heart, Sumerduck still hosts two churches, a school, the historic Henry Broadus Jones Store, and the Sumerduck Trading Company.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.dhr.virginia.gov/historic-registers/030-5164/"
    },
    {
      "id": 5,
      "text": "Visitors can explore the nearby C.F. Phelps Wildlife Management Area, with several entrances off the main VA Route 651.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sumerduck%2C_Virginia"
    },
    {
      "id": 6,
      "text": "The village also boasts a craft cidery, a family‑run winery, and a well‑known antiques shop.",
      "sourceSentenceIds": [
        9
