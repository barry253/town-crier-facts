  "facts": [
    {
      "id": 1,
      "text": "Tilton was incorporated in 1869 and named after Nathaniel Tilton, a Revolutionary War veteran whose great‑grandson Charles helped shape the town.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tilton%2C_New_Hampshire",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic bridge, built in 1763, earned a place on the National Register for its innovative truss design and still carries Main Street traffic.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nhmagazine.com/touring-tilton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Tilton School’s former mansion, built in 1861, now houses the Lucian Hunt Library, preserving the town’s 19th‑century heritage.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tilton%2C_New_Hampshire",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Tilton Historical Society curates the town’s story, offering research links and volunteer opportunities to keep local history alive.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tiltonhistoricalsociety.com/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A replica of Rome’s Arch of Titus, the 1881 Tilton Arch stands on a hilltop, commemorating the town’s founders and their ancestors.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nhmagazine.com/touring-tilton/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Charles Tilton, who profited from the California gold rush, donated the bridge and many statues, leaving a lasting artistic legacy in Tilton.",
      "sourceSentenceIds": [
        2
