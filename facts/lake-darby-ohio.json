      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Lake Darby lies in western Franklin County, mainly within Prairie Township with small portions extending into Brown Township.",
      "sourceSentenceIds": [
        7,
