  "facts": [
    {
      "id": 1,
      "text": "Arkansaw was founded in the early 1850s at a crossing of Arkansaw Creek, a tributary of the Eau Galle River.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arkansaw%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "Arkansaw Creek was named in honor of the Arkansas River.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arkansaw%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The community of Arkansaw served as the county seat of Pepin County from 1881 to 1886.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arkansaw%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Arkansaw was initially built around lumbering, with its first sawmill opening in 1852.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Arkansaw%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Arkansaw Creek provided the water power necessary to operate the early mills and factories in the area.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.townofwaterville.com/history.php"
    },
    {
      "id": 6,
      "text": "Today, the course of the creek runs through Arkansaw Creek Park.",
