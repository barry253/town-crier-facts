    },
    {
      "id": 2,
      "text": "James Alexander helped found Union by offering twenty-five acres of land for a courthouse shortly after Monroe County was created.",
      "sourceSentenceIds": [
        7,
        18
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
