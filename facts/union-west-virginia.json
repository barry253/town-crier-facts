    },
    {
      "id": 3,
      "text": "Union's growth was fueled by its location on stagecoach lines and the presence of several nearby mineral spring resorts.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union%2C_West_Virginia"
    },
    {
      "id": 4,
      "text": "The Union Historic District was placed on the National Register of Historic Places in 1990 to preserve its historic streetscape.",
      "sourceSentenceIds": [
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Union%2C_West_Virginia"
    },
    {
      "id": 5,
      "text": "Union retains much of its historic architecture from the antebellum period when the local resort industry was thriving.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Union%2C_West_Virginia"
    },
    {
      "id": 6,
      "text": "The present Monroe County Courthouse in Union was built in 1881 and displays the Romanesque style of the late nineteenth century.",
