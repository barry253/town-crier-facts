  "facts": [
    {
      "id": 1,
      "text": "Richmond, founded in 1737, became Virginia’s capital in 1780 and was named after the English town of Richmond near London, echoing its founder’s hometown.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1849, Henry 'Box' Brown was shipped in a small box from Richmond to Philadelphia, a daring move that highlighted the city’s role in the Underground Railroad.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Second Presbyterian Church, founded in 1845, was Richmond’s first Gothic building and gas‑lit church, where Stonewall Jackson once worshiped.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Downtown Richmond houses the Library of Virginia, the state’s oldest public library, and the Valentine Richmond History Center, a treasure trove of local archives.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Richmond%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Tredegar Iron Works, once the largest Confederate arms factory, forged the armor plating that clad the CSS Virginia, the first ironclad warship.",
      "sourceSentenceIds": [
