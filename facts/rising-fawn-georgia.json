      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Alabama Great Southern Railroad arrived in 1870, turning Rising Fawn into a bustling rail hub until the station closed and was demolished in 1932.",
      "sourceSentenceIds": [
        7,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
