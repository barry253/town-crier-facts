  "facts": [
    {
      "id": 1,
      "text": "Queens Village was founded as Little Plains in the 1640s by early settlers.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Queens_Village%2C_Queens",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1923 the Long Island Railroad added 'Village' to its station name to avoid confusion, giving the neighborhood its current name.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Queens_Village%2C_Queens",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The neighborhood’s name evolved from Brushville, a farming crossroads, when residents rebranded it in the late 19th century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/queens-village",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Bell House, a Victorian residence built in 1891, stands as a preserved example of 19th‑century architecture.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.simplyqueens.com/queens-village/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Queens Village Civic Association, founded in 1923, became one of the borough’s earliest civic groups, championing zoning, schools, and parks.",
