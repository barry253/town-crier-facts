  "facts": [
    {
      "id": 1,
      "text": "Picacho Peak, rising 1,500 feet, has guided travelers for millennia thanks to its distinctive shape.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://azstateparks.com/picacho/explore/park-history"
    },
    {
      "id": 2,
      "text": "The Anza expedition camped near Picacho Peak on October 29, 1775, marking the first recorded European visit to the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.nps.gov/places/picacho-peak-cerro-de-tacca.htm"
    },
    {
      "id": 3,
      "text": "During the Civil War, Confederate and Union scouts clashed at Picacho Pass on April 15, 1862, making it the largest Civil War skirmish in Arizona.",
      "sourceSentenceIds": [
        4,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://azstateparks.com/picacho/explore/park-history"
    },
    {
      "id": 4,
      "text": "Picacho Peak State Park opened on May 30, 1968, after a 1963 feasibility study and land purchases totaling 2,760 acres.",
      "sourceSentenceIds": [
        8,
        25,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://azstateparks.com/picacho/explore/park-history"
    },
    {
      "id": 5,
      "text": "The park’s spring wildflowers, especially Mexican Gold Poppies, create a vivid tapestry when winter rains arrive.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://azstateparks.com/picacho/explore/park-history"
    },
    {
      "id": 6,
      "text": "Picacho’s name comes from Spanish for “peak,” reflecting the prominence of the nearby Picacho Mountains.",
