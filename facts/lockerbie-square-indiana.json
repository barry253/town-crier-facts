  "facts": [
    {
      "id": 1,
      "text": "Lockerbie Square was originally platted between 1847 and 1850 by Jannett Smith Lockerbie McOuat, named after her father George Murray Lockerbie.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockerbie_Square_Historic_District",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s cobblestone Lockerbie Street runs through its core, anchoring the James Whitcomb Riley Museum Home, once the poet’s residence.",
      "sourceSentenceIds": [
        5,
        17,
        30
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://lockerbiesquareneighborhood.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1960s, preservationists saved the district, making it Indianapolis’ first historic district and sparking a citywide restoration movement.",
      "sourceSentenceIds": [
        20,
        27
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockerbie_Square_Historic_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historic Landmarks Foundation of Indiana restored the area using techniques modeled after Columbus’s German Village, earning a “New Construction Award” for a 20th‑century home.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockerbie_Square_Historic_District",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lockerbie Square sits just ¾ mile from Monument Circle, making it one of Indianapolis’ earliest walkable suburbs.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockerbie_Square_Historic_District",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "The district showcases Federal, Italianate, and Queen Anne architecture, with buildings dating from 1855 to 1930.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
