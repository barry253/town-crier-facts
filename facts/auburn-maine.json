  "facts": [
    {
      "id": 1,
      "text": "Auburn was incorporated as a city on February 22, 1869, becoming the first in Maine to adopt a council‑manager government.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Maine",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1835, the first shoe‑manufacturing factory system began in Auburn, and by 1917 a single plant produced 75% of the world’s white canvas shoes.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Maine",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Androscoggin River powered Auburn’s early mills, and the 1823 bridge to Lewiston helped the town grow into a mill hub.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Maine",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Two bronze water sculptures—Falls Fountain and Shoe Fountain—decorate Auburn’s downtown, honoring the river and its shoe‑making heritage.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Maine",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Auburn’s name comes from the village Auburn mentioned in Oliver Goldsmith’s 1770 poem “The Deserted Village.”.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Auburn%2C_Maine",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic Knight House Museum, built in 1796, is the oldest frame house downtown and once housed a hand‑work shoe shop.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
