  "facts": [
    {
      "id": 1,
      "text": "Roosevelt began in 1936 as Jersey Homesteads, a New Deal experiment for Jewish garment workers combining collective farming and manufacturing.",
      "sourceSentenceIds": [
        15,
        4
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.fundforroosevelt.org/about-roosevelt",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1945 residents renamed the town Roosevelt after President Franklin D. Roosevelt, honoring the New Deal leader who inspired its founding.",
      "sourceSentenceIds": [
        28,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Roosevelt%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Roosevelt is the only New Jersey town listed on the National Register of Historic Places in its entirety, preserving its 1930s layout.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://livingnewdeal.org/sites/city-of-roosevelt-roosevelt-nj/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s design features a walkable grid surrounded by wetlands, woodlands, and farmland, a rare greenbelt plan for a 1930s community.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 2"
      ],
      "source": "https://www.fundforroosevelt.org/about-roosevelt",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A former garment factory now houses a Ben Shahn mural, a reminder of the town’s original textile industry and artistic heritage.",
      "sourceSentenceIds": [
        14,
        1
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://livingnewdeal.org/sites/city-of-roosevelt-roosevelt-nj/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Though the factory and farm never prospered, Roosevelt’s cooperative grocery and meat market survived into the 1940s, keeping the community alive.",
      "sourceSentenceIds": [
        11,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
