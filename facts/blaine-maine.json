    },
    {
      "id": 2,
      "text": "The bell that hangs in Blaine Grange Hall was cast in 1875 by William Blake & Co. and is cared for by the Central Aroostook Historical Society.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
