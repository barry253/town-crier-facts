  "facts": [
    {
      "id": 1,
      "text": "Brockway was named after the three Brockway brothers who homesteaded along the Redwater River in 1910.",
      "sourceSentenceIds": [
        1,
        13
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Brockway%2C_Montana"
    },
    {
      "id": 2,
      "text": "The town hosts the Brockway Dairy Day Rodeo, established in 1918 and still the biggest day of the year.",
      "sourceSentenceIds": [
        3,
        12,
        19
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Brockway%2C_Montana"
    },
    {
      "id": 3,
      "text": "The Northern Pacific Railway’s Redwater branch reached Brockway in 1928, turning it into the nation’s top livestock shipping point by 1934.",
      "sourceSentenceIds": [
        5,
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Brockway%2C_Montana"
    },
    {
      "id": 4,
      "text": "A post office opened in Brockway in 1913, reflecting the settlement’s growing importance.",
      "sourceSentenceIds": [
        4,
        15
      ],
      "sourceLabels": [
