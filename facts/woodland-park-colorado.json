      "quality": "good"
    },
    {
      "id": 2,
      "text": "Woodland Park grew into a key stop on the Colorado Midland Railway, thanks to its closeness to Cripple Creek and local lodging.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
