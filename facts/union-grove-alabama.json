  "facts": [
    {
      "id": 1,
      "text": "Union Grove earned its name when Union troops camped there during the Civil War, turning the former Parches Cove into the town we know today.",
      "sourceSentenceIds": [
        1,
        8,
        9
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/union-grove/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Perched 1,027 feet above sea level, Union Grove sits on Brindley Mountain near the southwest edge of the Appalachian Plateau.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Union_Grove%2C_Alabama",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town officially incorporated in 1962, marking its transition from a rural community to an incorporated municipality.",
