  "facts": [
    {
      "id": 1,
      "text": "Willowick’s name means “willow grove” or “place of willows,” reflecting the many willow trees that once lined its waterways.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/willowick-31522"
    },
    {
      "id": 2,
      "text": "Willowick sits on the shores of Lake Erie, offering residents a scenic waterfront in Lake County, Ohio.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Willowick%2C_Ohio"
    },
    {
      "id": 3,
      "text": "In 1955, Willowick residents repurposed the old Country Club on Lakeshore Boulevard to create their first public library.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofwillowick.com/cityhall/page/history-willowick"
    },
    {
      "id": 4,
      "text": "The new Willowick Library building opened its doors in 1962, marking a milestone in the town’s commitment to learning.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofwillowick.com/cityhall/page/history-willowick"
    },
    {
      "id": 5,
      "text": "Lakeshore Boulevard began as an Indian trail used by natives to trade with tribes as far west as Flint, Michigan.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofwillowick.com/cityhall/page/history-willowick"
    },
    {
      "id": 6,
      "text": "Willowick was originally part of Washington County, then joined Jefferson County when it was formed in 1797.",
