  "facts": [
    {
      "id": 1,
      "text": "Bradley traces its origins to the late 1880s within the Chickasaw Nation in Indian Territory.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bradley_oklahoma"
    },
    {
      "id": 2,
      "text": "The town of Bradley was named after brothers William S. Bradley, who were prominent settlers and stockmen in the area.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bradley_oklahoma"
    },
    {
      "id": 3,
      "text": "The original townsite of Bradley was established in 1903 on land donated by Ada and Charles Goode.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bradley_oklahoma"
    },
    {
      "id": 4,
      "text": "Public school began in the Bradley community on December 9, 1907.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=BR001"
    },
    {
      "id": 5,
      "text": "The Rock Island Railroad served Bradley from 1907 until 1942, when the tracks were removed for World War Two efforts.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/bradley_oklahoma"
    },
    {
      "id": 6,
      "text": "The area around Bradley includes the Jewett Site, a prehistoric Caddo Nation camp located along the Washita River.",
