      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name originated from a misread handwritten note; James Everett intended “Fox Valley,” but postal officials in Washington misinterpreted it as “Fort Valley.”.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
