  "facts": [
    {
      "id": 1,
      "text": "Pleasant Grove was originally called Battle Creek after a 1849 skirmish between Mormon settlers and Ute Indians.",
      "sourceSentenceIds": [
        1,
        4,
        26,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Grove%2C_Utah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1855 the settlement grew to 623 people and was officially incorporated as a town.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Grove%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A fort with two‑to‑three‑foot walls and six‑foot height was built during the Walker Indian War, covering sixteen city blocks.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pleasant_Grove%2C_Utah",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Several historic buildings, like a granary, log cabin, and corral, were moved to Pioneer Park and now interpret the town’s early life.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.achp.gov/preserve-america/community/pleasant-grove-utah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year the Heritage Festival celebrates Pleasant Grove’s history with bus tours of historic sites.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.achp.gov/preserve-america/community/pleasant-grove-utah",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Portions of the 1994 TV series The Stand were filmed in Pleasant Grove, giving the town a spot in pop‑culture history.",
