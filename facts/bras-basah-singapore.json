  "facts": [
    {
      "id": 1,
      "text": "Bras Basah means \"wet rice\" in Malay, a nod to its historic role in the rice trade.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bras_Basah",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The precinct houses Singapore’s first specialised pre‑tertiary art school, the School of the Arts, founded in 2000.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bras_Basah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bras Basah MRT station, designed by WOHA, earned the World Architecture Festival’s Best Transport Building award in 2009.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bras_Basah",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area blends colonial churches, temples and modern art buildings, including the Armenian Church and the National Library.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.heritage.sg/brasbasahbugis/who-we-are/welcome-to-bras-basah-bugis",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Since 2008, the Singapore Night Festival has lit up Bras Basah with cross‑disciplinary performances, drawing millions each August.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.heritage.sg/brasbasahbugis/who-we-are/welcome-to-bras-basah-bugis",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The historic river Sungei Beras Bassa once flowed through the precinct, now highlighted in festival activations.",
      "sourceSentenceIds": [
