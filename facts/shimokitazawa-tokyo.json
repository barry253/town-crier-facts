  "facts": [
    {
      "id": 1,
      "text": "Shimokitazawa first appeared as a farming village in 1912, with villagers trading goods in Shibuya.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shimokitazawa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its narrow, winding streets trace back to the area’s farming roots before cars became common.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shimokitazawa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shimokitazawa Station opened in 1927, and the Keio Inokashira Line linked it in 1933, sparking rapid growth.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Shimokitazawa",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "After surviving the 1921 Great Kantō Earthquake, Shimokitazawa evolved into a center for independent music, theater, comedy, and film.",
      "sourceSentenceIds": [
        3,
        16
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.japan.travel/en/spot/2108/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The neighborhood boasts one of Tokyo’s largest concentrations of thrift stores, a hallmark of its alternative culture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.japan.travel/en/spot/2108/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 2013, the Odakyu Line tracks were moved underground, creating new entrances and doubling tracks as part of redevelopment.",
