  "facts": [
    {
      "id": 1,
      "text": "Fort Garland was founded in June 1858 as a U.S. Army post to protect settlers from the Ute people in the San Luis Valley.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Garland%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The fort closed in 1883 after the Utes were confined to reservations, ending its 25‑year military role.",
      "sourceSentenceIds": [
        8,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Garland%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Today the Fort Garland Museum preserves original fort buildings and artifacts, offering a window into that frontier era.",
      "sourceSentenceIds": [
        6,
        18,
        19
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://www.uncovercolorado.com/towns/fort-garland/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town hosts an annual Band Jam Music Festival that draws local, regional, and internationally recognized musicians.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Garland%2C_Colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fort Garland sits at 7,943 feet on U.S. highways, earning the nickname “Gateway to the San Luis Valley” as the first town west of La Veta Pass.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fort_Garland%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The surrounding area features the Los Caminos Antiguos scenic byway, a 129‑mile route through southern Colorado into New Mexico.",
      "sourceSentenceIds": [
        13
      ],
