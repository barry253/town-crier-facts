  "facts": [
    {
      "id": 1,
      "text": "Reading, a prominent settler, named the Trinity River after mistakenly believing it connected to Trinidad Bay, drawing from outdated Spanish maps.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trinity_village_california"
    },
    {
      "id": 2,
      "text": "Reading's gold discovery drew thousands of immigrants, including about 3,000 Chinese laborers, forever altering the Trinity River's landscape.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://visittrinity.com/history/"
    },
    {
      "id": 3,
      "text": "Trinity Village lies within the traditional territories of the Hupa and Tsnungwe tribes, part of the broader Yurok‑Hupa cultural landscape.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trinity_village_california"
    },
    {
      "id": 4,
      "text": "The Hupa historically relied on salmon from the lower Trinity River for sustenance, economy, and spiritual practices.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trinity_village_california"
    },
    {
      "id": 5,
      "text": "Trinity Village experiences a Mediterranean climate with oceanic influences, featuring warm, dry summers and cool, wet winters.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/trinity_village_california"
    },
    {
      "id": 6,
      "text": "Trinity Village sits at an elevation of 1,289 feet (393 meters) above sea level.",
      "sourceSentenceIds": [
        20
      ],
