  "facts": [
    {
      "id": 1,
      "text": "Rohrersville Station grew around a grist mill possibly before 1783 founded by Frederick Rohrer, a French emigrant who arrived 1766.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village name first appeared in 1836 honoring David Rohrer, whose brick home stood nearby, and the area quickly became a trading hub for Pleasant Valley farms.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1820s, Rohrersville Station developed as a linear village along what was formerly Maryland Route 67, serving as a 19th‑century trading center for surrounding farms.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A mid‑19th‑century marble quarry nearby spurred limited industry, complementing the town’s grain, fruit, and dairy economy.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Rohrersville Cornet Band, founded in 1837 by Washington McCoy, provided brass music at community events, reflecting the era’s brass band movement.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s historic district, recognized by the Maryland Historical Trust, preserves log homes, mills, and farms cleared from forested land by families such as the Botelers and Grimms.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/rohrersville_maryland",
      "category": "landmark",
      "quality": "good"
    }
  ],
