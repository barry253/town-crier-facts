      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "European colonists first settled the area in 1668 after the Taunton North Purchase, marking Norton’s earliest legal settlement.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
