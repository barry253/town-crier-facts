      ],
      "source": "https://grokipedia.com/page/Norton,_Massachusetts",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "From 2014 to 2018, Norton hosted the Dell Technologies Championship, a PGA Tour event played each Labor Day weekend at TPC Boston.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
