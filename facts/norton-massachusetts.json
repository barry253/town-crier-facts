      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Norton’s town common, built shortly after incorporation, remains the historic heart of the village of Norton Center.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
