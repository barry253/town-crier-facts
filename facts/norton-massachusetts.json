      ],
      "source": "https://en.wikipedia.org/wiki/Norton%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Wheaton College, founded in 1834 as a women’s seminary, now coeducational, sits in Norton and shapes the town’s cultural scene.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
