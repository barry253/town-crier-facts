  "facts": [
    {
      "id": 1,
      "text": "Belgrade’s post office began as Crow Lake in 1871 before the railroad arrived, then changed its name to Belgrade in 1886.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
