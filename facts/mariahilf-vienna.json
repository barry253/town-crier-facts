  "facts": [
    {
      "id": 1,
      "text": "Mariahilf earned its name in 1428 when a chapel was dedicated to Mary, turning the area into “Mary’s help.”.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariahilf",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The once horse‑drawn carriage lane that became Mariahilfer Straße is now Vienna’s busiest shopping street, stretching from the Gürtel to the river valley.",
      "sourceSentenceIds": [
        6,
        22
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.searchandstay.com/destinations/post/exploring-the-history-of-mariahilf-wien-austria-landmarks-and-stories",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Along Mariahilfer Straße, the historic Phonographic Vienna Museum showcases the evolution of the phonograph, while the nearby Glass Museum preserves Vienna’s glass‑making heritage.",
      "sourceSentenceIds": [
        9,
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariahilf",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The district’s borders are defined by Mariahilfer Straße to the north, the Vienna River valley to the south, and the Gürtel beltway to the west.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariahilf",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Mariahilf’s location on the old road to Schönbrunn Palace made it a key stop for travelers heading to the imperial summer residence.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mariahilf",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The area’s first settlements appeared around the Roman roads in the 10th century, but significant growth began only after the 1683 Turkish siege.",
      "sourceSentenceIds": [
        24,
