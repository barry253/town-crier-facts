  "facts": [
    {
      "id": 1,
      "text": "Midland City sits in southeastern Dale County, Alabama, and is part of the Ozark Micropolitan Statistical Area.",
      "sourceSentenceIds": [
        3,
        4,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_City%2C_Alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The town borders Napier Field to the east, Dothan to the southeast, and Pinckard to the west.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_City%2C_Alabama",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "U.S. Route 231 cuts through Midland City, linking it 13 miles northwest to Ozark and 9 miles southeast to Dothan.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_City%2C_Alabama",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Alabama State Route 134 runs through the town center, heading east 10 miles to Headland and west 7 miles to Newton via Pinckard.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Midland_City%2C_Alabama",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Midland City offers historic sites, museums, outdoor recreation, and shopping for everyone.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://citywiseguide.com/alabama/midland-city.html",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
