  "facts": [
    {
      "id": 1,
      "text": "Grassflat got its name from the vast expanses of grassy fields that once surrounded the area.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/pa/grassflat/"
    },
    {
      "id": 2,
      "text": "Grassflat emerged in the mid-19th century as a small farming community drawn by fertile soils and proximity to Moshannon Creek.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://nearbylens.com/cities/usa/pa/grassflat/"
    },
    {
      "id": 3,
      "text": "The community later became a hub for coal mining and lumber operations during its industrial peak in the early 20th century.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/grassflat_pennsylvania"
    },
    {
      "id": 4,
      "text": "Remnants of the former Beech Creek Railroad and old logging roads still etch irregular paths across the hillsides of Grassflat.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/grassflat_pennsylvania"
    },
    {
      "id": 5,
      "text": "Grassflat celebrates its local heritage every year with a community festival known as Grassflat Days.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nearbylens.com/cities/usa/pa/grassflat/"
    },
    {
      "id": 6,
      "text": "A historic one-room schoolhouse from the town's early days now serves as a museum showcasing the history of Grassflat.",
      "sourceSentenceIds": [
        10
