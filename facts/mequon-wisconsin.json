  "facts": [
    {
      "id": 1,
      "text": "Mequon’s name comes from the Menomonee tribe that originally inhabited the area.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://mequon.net/history/"
    },
    {
      "id": 2,
      "text": "In 1839, German Old Lutherans founded the Freistadt community, now a western Mequon neighborhood, and built the first Lutheran congregation in Wisconsin.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Mequon%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "The Trinity Lutheran Church, erected in 1840, was the first log‑cabin church in the town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mequon%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The Isham Day House, now a postal museum, sits on the west bank of the Milwaukee River and was built in 1839.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mequon%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Mequon’s historic farmsteads from the 1840s and 1850s still stand and are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mequon%2C_Wisconsin"
    },
    {
      "id": 6,
      "text": "The Union Pacific Railroad line runs parallel to Interstate 43, a relic of the town’s early rail connections.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mequon%2C_Wisconsin"
    }
  ]
}
