    },
    {
      "id": 2,
      "text": "The Governor Warner Mansion, built in 1867, now serves as a museum and stands as a historic landmark in Farmington.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://citytowner.com/farmington-mi-fun-facts/"
    },
    {
      "id": 3,
      "text": "Farmington’s Civic Theater, erected in 1940, is one of Michigan’s last single‑screen movie theaters still in operation.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 2"
