  "facts": [
    {
      "id": 1,
      "text": "Nicholson, once called Cooper, switched its name in 1876 after a railroad fuel stop, with the post office officially adopting Nicholson in 1882.",
      "sourceSentenceIds": [
        1,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nicholson-ga.com/?page_id=63",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After its 1907 incorporation, Nicholson endured severe Depression-era devastation, leaving it largely a farming community by the 1930s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nicholson-ga.com/?page_id=63",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Every year, Nicholson celebrates its beloved Daisy Festival, a quirky tradition that draws locals and visitors alike.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Nicholson%2C_Georgia",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Nicholson Water Authority, founded in 1965, provided the town its first reliable municipal water system.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nicholson-ga.com/?page_id=63",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nicholson opened its first public library in 1975, later relocating to the Harold S. Swindle Public Library building in 1990.",
      "sourceSentenceIds": [
        13,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://nicholson-ga.com/?page_id=63",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The city sits atop a ridge that drains west and east into tributaries of the North Oconee River, shaping its landscape.",
