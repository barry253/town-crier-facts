  "facts": [
    {
      "id": 1,
      "text": "Ojo Encino means \"Oak Springs\" in Spanish, while the Navajo call it Tse’chizhi’ Bito’, reflecting the spring guarded by a cottonwood tree.",
      "sourceSentenceIds": [
        9,
        28
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://ojoencino.navajochapters.org/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Ojo Encino sits atop the Continental Divide at about 7,000 feet, on a barren, sandy plateau.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ojo_encino_new_mexico",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Ojo Encino was formally established in 1951 on the eastern border of the Navajo Reservation after negotiations between local Navajo landowners and the Bureau of Indian Affairs.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ojo_encino_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Ojo Encino Chapter was recognized in June 1957 and later achieved Local Governance Act certification on March 6, 2012.",
      "sourceSentenceIds": [
        16,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://ojoencino.navajochapters.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In the late 20th century, Ojo Encino gained running water, electricity, Navajo Housing Authority homes, a clinic, and other infrastructure, reshaping the community.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/ojo_encino_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Seven petroleum pipelines cross Ojo Encino’s land, generating rights‑of‑way fees that support the local economy.",
