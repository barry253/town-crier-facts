      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community lies near the Levisa Fork of the Big Sandy River, which shapes the local topography through its drainage patterns.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
