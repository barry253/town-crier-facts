    {
      "id": 1,
      "text": "Phelps sits deep in eastern Pike County, where Peter Creek cuts a narrow mountain valley close to Tug Fork country.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
