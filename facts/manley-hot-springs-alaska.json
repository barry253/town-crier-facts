      ],
      "source": "https://en.wikipedia.org/wiki/Manley_Hot_Springs%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The historic Manley Roadhouse, built in 1906, remains the community's heart, serving simple rooms and hearty meals that echo the gold‑rush era.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hotsprings.co/manley-hot-springs/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In summer, guests arrived by private boat from steamers on the Tanana River.",
      "sourceSentenceIds": [
        18
      ],
