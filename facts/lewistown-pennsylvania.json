      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough sits on the Juniata River, 61 miles northwest of Harrisburg.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewistown%2C_Pennsylvania",
