      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "Lewistown’s downtown hosts the historic courthouse, Embassy Theatre, McCoy House, and Stone Arch Bridge.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitpa.com/explore/regions/alleghenies/lewistown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Embass Theatre, McCoy House, Mifflin County Courthouse, Montgomery Ward Building, and Wollner Building are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewistown%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Early growth spurred by the Pennsylvania Canal and later railroads turned Lewistown into a regional transport hub.",
      "sourceSentenceIds": [
        5,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lewistown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Lewistown became the county seat of Mifflin County in 1789, replacing the Village of Ohesson.",
