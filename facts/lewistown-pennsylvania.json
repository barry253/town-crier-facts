      "id": 1,
      "text": "Lewistown was incorporated in 1795 and named for William Lewis, a Quaker ironmaster.",
      "sourceSentenceIds": [
        3,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
