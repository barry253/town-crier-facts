  "facts": [
    {
      "id": 1,
      "text": "Simms takes its name from Simms Creek, a stream named after two woodcutting brothers that joins the Sun River just west of town.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simms%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After President Roosevelt signed the 1902 Reclamation Act, the 1906 Sun River Irrigation Project turned Simms into a thriving grain and hay hub.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simms%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Nestled in the Sun River valley, Simms sits on a low spot surrounded by buttes and benches, a landscape that shaped its early settlement.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simms%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town experiences a semi‑arid climate, classified as BSk under the Köppen system, giving it dry summers and cold winters.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Simms%2C_Montana",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Once a cattlemen’s town, Simms has shifted to a farming community, with agriculture now dominating the local economy.",
