  "facts": [
    {
      "id": 1,
      "text": "Lafox got its name when the original Kane County post office moved from present‑day Geneva to the town, changing from Kane Station to La Fox.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/La_Fox%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first wave of Lafox development began in 1854 when the Galena and Chicago Union Railroad built a line through the area, turning the town into a railroad hub.",
      "sourceSentenceIds": [
        13,
        14,
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lafox.us/history-of-la-fox/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lemuel Potter opened a cheese factory in 1869 that later became a creamery, but the building collapsed under heavy snow in 1979.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://lafox.us/history-of-la-fox/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1868 Potter and Barker Grain Elevator, noted for its porthole windows, still stands and is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
