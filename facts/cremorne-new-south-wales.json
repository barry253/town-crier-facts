  "facts": [
    {
      "id": 1,
      "text": "Cremorne takes its name from London’s Cremorne Gardens, which in turn comes from the Old Irish words meaning ‘boundary’ or ‘chieftain’.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cremorne%2C_New_South_Wales",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The railway to Brighton bisected Cremorne in 1857 and briefly included a Cremorne station at Balmain St to service the Gardens.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cremorne.org.au/cremorne-beginnings/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cremorne features the historic Hayden Orpheum Picture Palace, a 1935 cinema designed by G. Kenworthy and built by Angelo Virgona.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cremorne%2C_New_South_Wales",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Immediately adjacent to the suburb, to the south, is the small residential suburb of Cremorne Point.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cremorne%2C_New_South_Wales",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Before the First Fleet, the area now known as Cremorne was inhabited by the Cammeraygal group of the Kuringgai Aboriginal nation, one of the largest in Sydney.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cremorne%2C_New_South_Wales",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Cremorne’s commercial heart lies along Military Road, centered around the historic Cremorne Hotel and a cluster of shops and restaurants.",
      "sourceSentenceIds": [
        20,
        22
      ],
      "sourceLabels": [
