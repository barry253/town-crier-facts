  "facts": [
    {
      "id": 1,
      "text": "Punaluʻu means 'spring diver,' a name born from ancient free‑diving practices that gathered freshwater during droughts.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/black_sands_hawaii",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Black sand at Punaluʻu forms when basaltic lava rushes into the ocean, cools, and shatters into dark grains.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.punaluubeach.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hawaiian culture regards Punaluʻu’s black sand as sacred, symbolizing the powerful bond between land and sea.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.punaluubeach.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Punaluʻu serves as a critical nesting ground where endangered green and hawksbill turtles bask on its sands.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.punaluubeach.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Three tsunamis—in 1868, 1960, and 1975—reshaped Punaluʻu’s shoreline, highlighting the area’s volcanic‑oceanic forces.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/black_sands_hawaii",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Punaluʻu experiences a tropical savanna climate, staying warm year‑round with a distinct wet season yet remaining drier than the island’s windward side.",
      "sourceSentenceIds": [
        29
