  "facts": [
    {
      "id": 1,
      "text": "Union Lake is a 465‑acre natural lake that straddles Commerce and West Bloomfield townships in Oakland County’s Huron River watershed.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/union_lake_michigan"
    },
    {
      "id": 2,
      "text": "Its 7‑mile shoreline is almost entirely lined with residential homes, armored banks, and numerous docks.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/union_lake_michigan"
    },
    {
      "id": 3,
      "text": "Water from Green Lake feeds Union Lake from the southeast, while Hayes Lake Creek drains it to the southwest.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/union_lake_michigan"
    },
    {
      "id": 4,
      "text": "The first permanent European settlement near Union Lake began in 1825 when Abram Walrod built a log cabin on section 10 of Commerce Township.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/union_lake_michigan"
    },
    {
      "id": 5,
      "text": "Before Europeans arrived, the Potawatomi, Ojibwa, and Ottawa tribes used the Union Lake area for hunting, fishing, and seasonal travel.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/union_lake_michigan"
    },
    {
      "id": 6,
      "text": "Union Lake’s community lies adjacent to the lake’s northern shore, serving as a residential enclave within Oakland County.",
