  "facts": [
    {
      "id": 1,
      "text": "Flowery Branch’s original Cherokee name, Anaguluskee, means “flowers on the branch” in the local language.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/flowery-branch/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1874, Flowery Branch sprang up as a railroad stop on the new Atlanta‑Charlotte line.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.flowerybranchga.org/community/history.php",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1985, Flowery Branch’s Main Street earned national and state historic‑place status for its 19th‑century buildings, including the train depot.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.georgiaencyclopedia.org/articles/counties-cities-neighborhoods/flowery-branch/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Nestled on Lake Lanier, Flowery Branch boasts one of Georgia’s only historic downtowns that sit right on a lake.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
