  "facts": [
    {
      "id": 1,
      "text": "Taylor Mill was incorporated in 1956, making it one of Northern Kentucky's youngest cities and a planned suburban community for Cincinnati workers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/kentucky_taylor-mill",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city takes its name from a gristmill operated in the early 1800s by James Taylor Jr., founder of Newport.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taylor_Mill%2C_Kentucky",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1810, James Taylor purchased the land from Jacob Fowler, and the road from present‑day Covington to the mill became Taylor's Mill Road.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taylor_Mill%2C_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Settlement began in the late 1790s, just a few years after Kentucky joined the Union in 1792, laying the groundwork for Taylor Mill.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/Taylor_Mill,_Kentucky",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Every year, Taylor Mill hosts Heritage Day, a festival that showcases local crafts and exhibits celebrating the town's rural roots.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.trawellino.com/destinations/united-states/kentucky_taylor-mill",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1959, Taylor Mill annexed the neighboring city of Sunny Acres to resolve confusion caused by a Maverick TV episode titled 'Shady Deal at Sunny Acres'.",
      "sourceSentenceIds": [
        9
