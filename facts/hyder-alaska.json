  "facts": [
    {
      "id": 1,
      "text": "Hyder earned its name from Frederick Hyder, a Canadian mining engineer who envisioned a bright future for the area.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyder%2C_Alaska",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1914, Hyder—then Portland City—served as the main port, supply point, and post office for miners heading into the nearby mines.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://stewart-tourism.com/about/hyder/history-2",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s two bars, The Sealaska Bar and The First and Last Chance Bar, began as saloons during the mining boom and have operated continuously ever since.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://alaskanpanhandle.com/hyder/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At the border crossing, a playful sign mimics Berlin’s Checkpoint Charlie, declaring 'You are leaving the American Sector' in three languages.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyder%2C_Alaska",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Hyder sits at the head of the Portland Canal, a 130‑mile fjord that forms part of the Alaska–British Columbia border.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hyder%2C_Alaska",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Hyder was the starting point of the 2014 coast‑to‑coast Scooter Cannonball Run, a race that finished in New Orleans.",
      "sourceSentenceIds": [
        5
      ],
