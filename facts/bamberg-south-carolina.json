  "facts": [
    {
      "id": 1,
      "text": "Bamberg is named after Major William Seaborn Bamberg, who arrived in the community during the 1840s.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
