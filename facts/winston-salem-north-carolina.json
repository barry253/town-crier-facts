  "facts": [
    {
      "id": 1,
      "text": "Winston‑Salem earned its name in 1851 when the town was renamed after Revolutionary War hero Joseph Winston, replacing its original name Salem.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winston-Salem%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Old Salem, a Moravian settlement founded in 1766, now serves as a living museum where visitors can see 18th‑century life recreated.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winston-Salem%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Dubbed the Twin City for its dual heritage and the Camel City for its tobacco past, Winston‑Salem reflects a blend of cultures.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winston-Salem%2C_North_Carolina",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Wake Forest University, founded in 1834, relocated to Winston‑Salem in 1956, bringing a major research institution to the city.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winston-Salem%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Reynolds Tobacco Company's flagship building, once the tallest south of Baltimore, earned the American Institute of Architects' best building award in its year.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Winston-Salem%2C_North_Carolina",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In Old Salem, 70 percent of the original buildings remain, and artisans still practice tinsmithing, blacksmithing, and other crafts for visitors.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
