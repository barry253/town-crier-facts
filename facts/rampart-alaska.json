  "facts": [
    {
      "id": 1,
      "text": "Rampart’s name comes from the low mountain range that the Yukon River cuts through, forming the region’s “ramparts.”.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tananachiefs.org/about/communities/rampart/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Near Rampart, the University of Alaska founded an agricultural experiment station in 1900 that tested over 90 acres of crops such as grains, legumes, vegetables, strawberries, and flowers.",
      "sourceSentenceIds": [
        5,
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.usacitiesonline.com/akcountyrampart.htm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Novelist Rex Beach moved to Rampart in 1900 during the Klondike Gold Rush, where his mining experience inspired the bestseller The Spoilers.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rampart%2C_Alaska",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In the 1950s, a proposed Rampart Dam on the Yukon River would have created the world’s largest reservoir, but popular protest halted the project.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rampart%2C_Alaska",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rampart first appeared on the 1880 U.S. census, vanished in 1890, and returned in 1900 as a mining boom town.",
      "sourceSentenceIds": [
        1,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rampart%2C_Alaska",
