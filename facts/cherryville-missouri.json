  "facts": [
    {
      "id": 1,
      "text": "Cherryville was named for the abundance of wild cherry trees that lined the Ozark foothills when George Day opened a general store in 1884.",
      "sourceSentenceIds": [
        4,
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherryville_missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office has operated in Cherryville since 1862, making it one of the oldest continuous postal sites in Crawford County.",
      "sourceSentenceIds": [
        10,
        15
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://kids.kiddle.co/Cherryville,_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town briefly incorporated as a village on October 31, 1938, but reverted to unincorporated status the same year.",
      "sourceSentenceIds": [
        7,
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherryville_missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Great Depression, the WPA built a stone school and gymnasium in Cherryville, now preserved examples of New Deal architecture.",
      "sourceSentenceIds": [
        25,
        26,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cherryville_missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Cherryville sits at the junction of Missouri Routes 19 and 49, roughly ten miles south of Steelville, near the Mark Twain National Forest.",
      "sourceSentenceIds": [
        13,
        16,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
