  "facts": [
    {
      "id": 1,
      "text": "Blackstone takes its name from Reverend William Blackstone, an early settler who helped establish the town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/blackstone-massachusetts"
    },
    {
      "id": 2,
      "text": "The Blackstone River, birthplace of the U.S. Industrial Revolution, winds along the town’s southern border.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackstone%2C_Massachusetts"
    },
    {
      "id": 3,
      "text": "Blackstone is one of six communities in the Blackstone Valley that adopted scenic roads bylaws to protect historic landscapes.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/blackstone-massachusetts"
    },
    {
      "id": 4,
      "text": "Daniels Farm, a National Register property, houses a rare 1871 cider mill and will open as a working farm for visitors.",
      "sourceSentenceIds": [
        6,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.achp.gov/preserve-america/community/blackstone-massachusetts"
    },
    {
      "id": 5,
      "text": "Settled in 1662, Blackstone became an independent town in 1845 after separating from Mendon.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Blackstone%2C_Massachusetts"
    },
    {
      "id": 6,
      "text": "Monument Square in Blackstone Village serves as the town’s historic heart, highlighted in preservation plans.",
