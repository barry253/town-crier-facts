      ],
      "source": "https://www.visitstockholm.com/see-do/attractions/district-guide-vasastan/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Former Atlas industrial factories were demolished in 1927, turning the area into residential housing.",
      "sourceSentenceIds": [
