      "id": 1,
      "text": "Chiawuli Tak means \"the barrel cactus sits\" in the O'odham language.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Chiawuli_Tak%2C_Arizona",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "It is the only town in America deliberately named after a cactus that sat down.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://benandsteve.com/2025/10/11/where-the-barrel-cactus-sits-visiting-chiawuli-tak-arizona/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 3,
      "text": "Unofficial variants like Geowic, Jeowic, or Tjeavolitak reflect phonetic differences across O'odham dialects.",
