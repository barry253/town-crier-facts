      "id": 2,
      "text": "Before Spanish ranchos appeared in the 1760s, the region was first inhabited by Coahuiltecan hunter‑gatherers.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
