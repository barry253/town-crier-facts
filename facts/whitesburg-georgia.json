      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town grew around Banning Mills, a water‑powered complex that once operated a textile mill with 5,000 spindles.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
