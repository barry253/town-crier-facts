  "facts": [
    {
      "id": 1,
      "text": "Cateechee is an unincorporated community and historic mill village in Pickens County, located along the Twelve Mile River.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cateechee_south_carolina"
    },
    {
      "id": 2,
      "text": "The community takes its name from a Cherokee maiden who reportedly rode to warn colonial settlers of an impending attack.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cateechee_south_carolina"
    },
    {
      "id": 3,
      "text": "Colonel Daniel K. Norris established Cateechee in the 1890s as a company town centered around a modern textile mill.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cateechee_south_carolina"
    },
    {
      "id": 4,
      "text": "The Cateechee Mill officially opened between 1896 and 1897, featuring 5,000 spindles and 150 looms to produce cotton cloth.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cateechee_south_carolina"
    },
    {
      "id": 5,
      "text": "By the 1930s, Cateechee housed about 850 residents in 120 mill-provided homes and included a company store and school.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cateechee_south_carolina"
    },
    {
      "id": 6,
      "text": "The mill ceased operations in 1982, leaving ruins that remain as a remnant of the site's industrial past.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cateechee_south_carolina"
