      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Cochecton Railroad Station, the oldest surviving passenger station in New York, was carefully relocated about a mile up State Route 97 in the early 1990s.",
      "sourceSentenceIds": [
