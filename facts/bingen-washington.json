      "id": 1,
      "text": "Bingen was founded in 1892 by Theodore Suksdorf, who named it after Bingen am Rhein in Germany.",
      "sourceSentenceIds": [
        10,
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Bingen%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits in the heart of the Columbia River Gorge, just 60 miles east of Portland.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.bingenwashington.org/212/History",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fort Columbia, built in the late 19th century to guard the Columbia River, now stands as a historic marker in Bingen.",
      "sourceSentenceIds": [
        15,
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-bingen/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Historic Locomotive, a preserved steam engine, reminds visitors of Bingen’s industrial past.",
      "sourceSentenceIds": [
        4,
        22
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-bingen/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Columbia River Indians Interpretive Marker in Bingen offers insights into the indigenous peoples who once lived along the river.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://beckdc.com/historical-places-in-bingen/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Joslyn House, a charming early 1900s home, has been restored and now serves as a bed & breakfast.",
