  "facts": [
    {
      "id": 1,
      "text": "Reedsville is named after Judge George Reed, who bought a section of land in the town of Maple Grove.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://reedsvillewi.gov/history/"
    },
    {
      "id": 2,
      "text": "Early residents of Reedsville included French Canadians and Menomonee Indians, followed later by settlers from Germany, Bohemia, and Ireland.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reedsville%2C_Wisconsin"
    },
    {
      "id": 3,
      "text": "In 1854, George Wimpf platted and surveyed the land to lay out a village of fifty-six blocks in Reedsville.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reedsville%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "Lumbering, sawmills, and factories were the most important businesses in Reedsville during its early days.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://reedsvillewi.gov/history/"
    },
    {
      "id": 5,
      "text": "Reedsville is a village located within Manitowoc County in the state of Wisconsin.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
