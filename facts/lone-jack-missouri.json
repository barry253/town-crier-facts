      "id": 1,
      "text": "Lone Jack earned its name from a lone black‑jack tree that once marked the town’s center.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Jack%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "On August 16, 1862, Union troops were routed in a five‑hour clash on Lone Jack’s main street.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lone_Jack%2C_Missouri",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The battlefield still hosts a cemetery where soldiers who fell in 1862 lie buried in the field.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.makeyourdayhere.com/Events-Attractions/Historic-Sites/Lone-Jack-Battlefield",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lone Jack houses Missouri’s only Civil War museum, the lone keeper of Jackson County’s wartime history.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.makeyourdayhere.com/Events-Attractions/Historic-Sites/Lone-Jack-Battlefield",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A branch of the Mid‑Continent Public Library serves Lone Jack’s residents with books and community programs.",
