  "facts": [
    {
      "id": 1,
      "text": "Black Diamond’s name comes from the Northern California mining firm that founded the town in the late 1800s.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.king5.com/article/entertainment/television/programs/evening/black-diamond-history-museum-mining/281-a2185045-93d0-422e-a154-09dbd39b24b1",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic train station, now a museum, first served the Seattle and Walla Walla Railroad in 1884 before becoming part of the Pacific Coast Railway.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_Diamond%2C_Washington",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Black Diamond grew around a coal mine owned by the Black Diamond Coal Mining Company, which shipped its low‑quality coal to San Francisco before Washington’s higher‑grade coal took over.",
      "sourceSentenceIds": [
        19,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_Diamond%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The original residents were largely former workers from Nortonville, California, who moved to Black Diamond after their local mines closed in the early 1880s.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Black_Diamond%2C_Washington",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Black Diamond’s first museum opened in 1982 and showcases colorful stories of the town’s mining past and its transformation into a modern community.",
