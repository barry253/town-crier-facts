  "facts": [
    {
      "id": 1,
      "text": "Cavanagh Communities Corporation bought the land in 1969 and named the new development Rotonda West.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotonda_West%2C_Florida",
      "category": "history",
      "quality": "good",
      "qualityReason": "vague"
    },
    {
      "id": 2,
      "text": "The area was once a cattle ranch owned by William and Alfred Vanderbilt, direct descendants of Cornelius Vanderbilt, before being sold in 1969.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotonda_West%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Rotonda West’s layout copies a World War II airfield, with four 3,000‑ft runways arranged like a wagon wheel and a circular taxiway around the edge.",
      "sourceSentenceIds": [
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotonda_West%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "At the heart of the community sits the Rotonda Community Park and Preserve, a 2.4‑km‑circumference hub that hosts a playground, tennis courts, and a walking path.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Rotonda_West%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A second project, Rotonda East, was abandoned when the Army Corps of Engineers denied a permit to drain the wetlands, preserving the natural landscape.",
      "sourceSentenceIds": [
        3
