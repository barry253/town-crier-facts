  "facts": [
    {
      "id": 1,
      "text": "Riverdale Park was founded on March 23, 1889 when Fox and Lutz formed the Riverdale Park Company, naming the town after a grand Federal‑style mansion.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverdale_Park%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By the early 1900s the town boasted 60 homes, a Presbyterian church, a schoolhouse, and a railroad station, making it a bustling community.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverdale_Park%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s name was officially changed to Riverdale Park in 1998, dropping the extra “s” that once appeared in the historic plantation’s name.",
      "sourceSentenceIds": [
        5,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverdale_Park%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Riverdale Park’s roots trace back to a 1801 plantation, where the original Riversdale house was built and later became a museum celebrating local history.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Riverdale_Park%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Founded in 1920, the town’s modern community center now hosts events like summer concerts and free memorial tours for residents and visitors alike.",
      "sourceSentenceIds": [
        6,
        26,
        25
      ],
