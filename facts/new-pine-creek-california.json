  "facts": [
    {
      "id": 1,
      "text": "New Pine Creek sits on the California‑Oregon line, but a surveying error in 1868 placed the actual border half a mile south of the 42nd parallel.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Pine_Creek%2C_California",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Because of that mistake, part of the community actually lies in Oregon, even though it’s officially a California town.",
      "sourceSentenceIds": [
        6,
        24
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Pine_Creek%2C_California",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "In 1984, California and Oregon officials discussed correcting the border error, but ultimately decided to keep New Pine Creek’s status unchanged.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Pine_Creek%2C_California",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A 1913 book noted that Pine Creek, near Goose Lake, once hosted about 300 residents, far more than today.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://kids.kiddle.co/New_Pine_Creek,_California",
