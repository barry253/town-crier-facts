  "facts": [
    {
      "id": 1,
      "text": "Artesia Wells takes its name from the artesian wells that once supplied water to early settlers.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/artesia-wells-tx"
    },
    {
      "id": 2,
      "text": "The town began as a water stop called Bart on the International‑Great Northern Railroad before irrigation opened the area to farming in the early 1900s.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/artesia-wells-tx"
    },
    {
      "id": 3,
      "text": "A post office opened in 1909, and by 1915 Artesia Wells already had a general store and a restaurant.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/artesia-wells-tx"
    },
    {
      "id": 4,
      "text": "In 1936 the population was just fifty people, a number that would decline after World War II.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/artesia-wells-tx"
    },
    {
      "id": 5,
      "text": "By the early 1970s the town had lost its school, leaving only thirty residents and a single small store.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/artesia-wells-tx"
    },
    {
      "id": 6,
      "text": "In 1988 Artesia Wells reported four businesses, a modest rebound after decades of decline.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/artesia-wells-tx"
    }
  ]
