  "facts": [
    {
      "id": 1,
      "text": "University Place got its name in the 1800s when the University of Puget Sound bought land along Grandview Drive.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Place%2C_Washington",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city officially formed on August 31, 1995, after remaining an unincorporated part of Pierce County for decades.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/University_Place%2C_Washington",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A local group founded the University Place Historical Society in 1999 to preserve the town’s early stories and artifacts.",
      "sourceSentenceIds": [
        2,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uphistoricalsociety.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The society earned a National Historical Registry designation for the Curran House, a landmark that once housed a 19th‑century apple orchard.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.uphistoricalsociety.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "University Place sits on Puget Sound, offering views of the Olympic Mountains and Mount Rainier that locals love to admire.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://cityofup.com/272/Visitors",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Chambers Bay golf course opened in 2007 and hosted the 2010 U.S. Open, bringing national attention to the town’s green‑green.",
