  "facts": [
    {
      "id": 1,
      "text": "Hilmar-Irwin was founded in 1984 by 12 dairy families, and the Hilmar Cheese Company remains the town’s most recognizable landmark.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.homes.com/local-guide/hilmar-ca/hilmar-irwin-neighborhood/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s layout splits into eastern and western halves along Lander Avenue, with historic 1920s homes on the east side and newer midcentury houses on the west.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.homes.com/local-guide/hilmar-ca/hilmar-irwin-neighborhood/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A family‑owned bakery on Main Street, the Hilmar Portuguese Bakery, serves traditional sweet bread and cookies, while its adjoining fish market offers fresh Portuguese seafood.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.homes.com/local-guide/hilmar-ca/hilmar-irwin-neighborhood/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every October, Irwin Acres hosts a pumpkin patch that features a mini haunted house, a corn maze, tractor rides, and pony rides for families.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.homes.com/local-guide/hilmar-ca/hilmar-irwin-neighborhood/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The climate brings hot, mostly dry summers and cool, wet winters, with January highs averaging 54°F and lows around 40°F.",
