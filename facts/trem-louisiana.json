      "quality": "good"
    },
    {
      "id": 2,
      "text": "Tremé is often called America’s oldest surviving black community.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Trem%C3%A9",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Congo Square, originally called Place des Nègres, was the town square where enslaved people gathered to dance each Sunday.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
