  "facts": [
    {
      "id": 1,
      "text": "Louisville began as a mining community in 1877, grew around the Welch Mine, and transitioned to a suburb after mines closed in the 1950s.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Colorado"
    },
    {
      "id": 2,
      "text": "The town was named for Louis Nawatny, a local landowner who platted his land and named it for himself.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Colorado"
    },
    {
      "id": 3,
      "text": "The historic downtown’s Steinbaugh Pavilion hosts summer Street Faire concerts, a farmers market from spring to fall, and winter skate events.",
      "sourceSentenceIds": [
        1,
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Louisville%2C_Colorado"
    },
    {
      "id": 4,
      "text": "Louisville’s historic downtown spans only five square blocks but is packed with National Register buildings like the Jacoe Store and the Austin‑Niehoff House.",
      "sourceSentenceIds": [
        13,
        16,
        17
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explore.com/2070606/louisville-colorado-city-between-denver-boulder-historic-rocky-mountains/"
    },
    {
      "id": 5,
      "text": "The Peak to Peak Scenic and Historic Byway starts near Louisville, offering a drive that hugs the Front Range and showcases the Rockies.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.explore.com/2070606/louisville-colorado-city-between-denver-boulder-historic-rocky-mountains/"
    },
    {
      "id": 6,
      "text": "During peak coal production (1907‑09), 12 mines operated in Louisville, including Acme Mine, which produced two million tons of coal from beneath the town center.",
      "sourceSentenceIds": [
        26
      ],
