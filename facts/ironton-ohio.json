  "facts": [
    {
      "id": 1,
      "text": "Ironton was founded in 1849 by John Campbell, a prominent pig iron manufacturer in the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The city’s name is a contraction of “iron town,” reflecting its long ties to iron production.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Ohio"
    },
    {
      "id": 3,
      "text": "Ironton hosts the United States’ oldest continuously running Memorial Day parade, founded in 1868.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ironton%2C_Ohio"
    },
    {
      "id": 4,
      "text": "The Norfolk and Western Railway built a downtown station in 1906 that operated into the mid‑20th century.",
      "sourceSentenceIds": [
