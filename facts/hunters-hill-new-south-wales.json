  "facts": [
    {
      "id": 1,
      "text": "Hunters Hill was founded in 1861 and is often called Australia’s oldest garden suburb.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://huntershillmuseum.org.au/a-brief-history-of-hunters-hill/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The suburb takes its name from John Hunter, the second Governor of New South Wales, who charted the area in 1788.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hunters_Hill",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Passy House on Passy Avenue, built 1855‑56 for the French Consul, still stands as a reminder of the early French influence.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://huntershillmuseum.org.au/a-brief-history-of-hunters-hill/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Hunters Hill sits on a peninsula where the Lane Cove and Parramatta Rivers meet, giving it unique harbour views.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hunters_Hill",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The historic Hunters Hill Town Hall on Alexandra Street dates back to the 19th century and remains a focal point of the community.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hunters_Hill",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The suburb’s first tennis club, founded in the 1860s, is one of Sydney’s oldest operating clubs.",
