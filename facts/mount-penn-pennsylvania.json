    {
      "id": 1,
      "text": "Mount Penn is a borough in Berks County, Pennsylvania, United States.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Penn%2C_Pennsylvania"
    },
    {
      "id": 2,
      "text": "The borough shares its name with a 1,120‑foot mountain that rises north and overlooks the city of Reading.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Penn%2C_Pennsylvania"
    },
    {
      "id": 3,
      "text": "That peak is sometimes recognized as the southern end of the Reading Prong group of mountains.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Penn%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "Mount Penn sits in a small saddle between the mountain to the north and the 900‑foot Neversink Mountain to the south.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Penn%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Mount Penn Preserve covers the slopes north of the borough, protecting local wildlife and offering hiking trails.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mount_Penn%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The borough borders Reading to the west, Lawrence to the east, and the unincorporated community of Pennside lies to the north.",
