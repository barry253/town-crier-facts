    {
      "id": 1,
      "text": "Stratford was originally the town of McGee, which was established in 1891.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Oklahoma"
    },
    {
      "id": 2,
      "text": "The town was first named Walling before the name was changed to Stratford in October 1906.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Oklahoma"
    },
    {
      "id": 3,
      "text": "Stratford's history dates back to the days of the Chickasaw Nation in Indian Territory.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.okhistory.org/publications/enc/entry?entry=ST045"
    },
    {
      "id": 4,
      "text": "Residents of McGee moved their entire community two miles south to follow the Oklahoma Central Railroad in 1906.",
      "sourceSentenceIds": [
        12,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Stratford%2C_Oklahoma"
    },
    {
      "id": 5,
      "text": "The First National Bank Building in Stratford is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
