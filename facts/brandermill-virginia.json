  "facts": [
    {
      "id": 1,
      "text": "Brandermill earned the title “The Best Planned Community in America” in 1977 from Better Homes and Gardens and the National Association of Home Builders.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandermill%2C_Virginia"
    },
    {
      "id": 2,
      "text": "Chesterfield County approved the Brandermill development in 1974, with construction kicking off the following year.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandermill%2C_Virginia"
    },
    {
      "id": 3,
      "text": "Brandermill holds the distinction of being the first planned community ever built in Chesterfield County.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandermill%2C_Virginia"
    },
    {
      "id": 4,
      "text": "The community boasts 15 miles of paved walking and cycling trails that wind around its neighborhoods.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Brandermill%2C_Virginia"
    },
    {
      "id": 5,
      "text": "The name Brandermill translates to a mill on a brook or stream, hinting at a historic mill that once stood in the area.",
      "sourceSentenceIds": [
        9
