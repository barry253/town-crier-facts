  "facts": [
    {
      "id": 1,
      "text": "Taisho ward takes its name from the Taisho Bridge, a main bridge built during the Taisho period.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taish%C5%8D-ku%2C_Osaka",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The ward is criss‑crossed by canals, so residents rely on a handful of pedestrian bridges and ferry services.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taish%C5%8D-ku%2C_Osaka",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Taisho Station sits on both the Osaka Loop Line and the Nagahori Tsurumi‑ryokuchi subway line, linking the ward to the city center.",
      "sourceSentenceIds": [
        6,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taish%C5%8D-ku%2C_Osaka",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Osaka Municipal Taisho Library, founded in 1970, serves as a cultural hub for the ward’s residents.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taish%C5%8D-ku%2C_Osaka",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "About a quarter of Taisho’s population traces its roots to Okinawa, reflected in the many Okinawan‑style shops around the ward.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Taish%C5%8D-ku%2C_Osaka",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1923 Taisho began as a seaplane base, later expanded to support Japan Air Transport flights to Tokyo’s Tachikawa Army Airfield.",
