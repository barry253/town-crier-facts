    {
      "id": 2,
      "text": "In the 1930s Allegheny County bought farm land in Snowden Township and turned it into a regional recreational area called South Park.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
