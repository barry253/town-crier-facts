  "facts": [
    {
      "id": 1,
      "text": "Bonanza sits just 21 miles south of downtown Atlanta, bordered by Irondale to the north and Lovejoy to the south.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Bonanza%2C_Georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 2,
      "text": "The community’s name echoes its early 19‑century roots, when settlers moved onto Creek lands after the 1825 Treaty of Indian Springs.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Bonanza’s growth accelerated after World War II, driven by nearby military installations and the expansion of the Atlanta metro area.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The area never incorporated; Clayton County provides all municipal services, giving Bonanza a quiet, low‑density suburban feel.",
      "sourceSentenceIds": [
        22,
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_georgia",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Railroads in the mid‑1800s shaped settlement patterns in southern Clayton County, setting the stage for Bonanza’s later development.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/bonanza_georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 2025 county moratorium on new residential projects aims to balance suburban expansion with environmental protection in Bonanza.",
      "sourceSentenceIds": [
        6
