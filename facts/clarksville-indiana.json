  "facts": [
    {
      "id": 1,
      "text": "Clarksville was founded in 1783 by George Rogers Clark at the only seasonal rapids on the Ohio River, making it the oldest town in the former Northwest Territory.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1805, the Indiana Territorial Legislature authorized a canal to bypass the Falls of the Ohio at Clarksville, a project that never materialized.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Clarksville hosts the Falls of the Ohio Fossil Site, where 386‑million‑year‑old Devonian coral reef remains are displayed in hands‑on exhibits.",
      "sourceSentenceIds": [
        8,
        15,
        16
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s historic roots include a 1778 post on an island at the head of the Falls, used by George Rogers Clark to train his regiment.",
      "sourceSentenceIds": [
        20,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Clarksville’s name honors its founder, George Rogers Clark, whose brother William later became famous as a frontiersman and explorer.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clarksville%2C_Indiana",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The town’s riverfront is being transformed into parks, housing, and restaurants, preserving its historic character while offering modern amenities.",
