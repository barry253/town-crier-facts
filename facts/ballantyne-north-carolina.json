  "facts": [
    {
      "id": 1,
      "text": "Ballantyne began as a 2,000‑acre hunting tract owned by the Harris family, later rezoned for development.",
      "sourceSentenceIds": [
        3,
        5,
        6,
        9
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballantyne_(Charlotte_neighborhood)",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Johnny Harris and brother-in-law Smoky Bissell launched Ballantyne Corporate Park in 1992, sparking one of the U.S. most successful master‑planned communities.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballantyne_(Charlotte_neighborhood)",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2017, Bissell sold Ballantyne Corporate Park to Northwood Investors for $1.2 billion, the largest real‑estate transaction in Charlotte history.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://activerain.com/blogsview/5909002/ballantyne-charlotte-nc--history--development--modern-community-life",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Four 30‑foot monuments at Johnston Road and Ballantyne Commons honor Charlotte’s strengths in transportation, technology, finance, and the human spirit.",
      "sourceSentenceIds": [
        26,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballantyne_(Charlotte_neighborhood)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Ballantyne Hotel, opened in September 2001, was designed by Bissell and now hosts luxury accommodations and community events.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Ballantyne_(Charlotte_neighborhood)",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Ballantyne’s master plan, initiated in 1991 by Johnny Harris and his brother, laid the groundwork for a master‑planned edge city on Charlotte’s southside.",
