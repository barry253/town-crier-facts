    {
      "id": 1,
      "text": "Scottsville was named after Isaac Scott, who bought 150 acres in 1790, forming the village's core.",
      "sourceSentenceIds": [
        4,
        21
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.scottsvilleny.gov/local-history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew into a canal port in the 1830s, shipping wheat, flour, and gypsum via the Genesee Valley Canal.",
      "sourceSentenceIds": [
        24,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scottsville%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Rochester Street Historic District, listed in 1973, preserves Greek Revival homes that mark Scottsville's canal‑era prosperity.",
      "sourceSentenceIds": [
        26,
        27,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Scottsville%2C_New_York",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Scottsville Free Library, a historic landmark, hosts community events and reflects the town’s commitment to learning.",
      "sourceSentenceIds": [
        1,
        13,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://roamingverse.com/explore/united-states/new-york/scottsville-NY",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before settlers, the Seneca people used the area as hunting grounds, shaping the region long before European arrival.",
      "sourceSentenceIds": [
