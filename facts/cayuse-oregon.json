  "facts": [
    {
      "id": 1,
      "text": "Cayuse takes its name from the Cayuse people, a Native American tribe historically prominent in this region of Oregon.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Cayuse%2C_Oregon"
    },
    {
      "id": 2,
      "text": "Cayuse originated as a railroad and stage station at the foot of Meacham Hill to support transportation in eastern Oregon.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cayuse_oregon"
    },
    {
      "id": 3,
      "text": "The Cayuse people were the first of the Northwest tribes to acquire horses, which they used as skilled warriors.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.historylink.org/File/10365"
    },
    {
      "id": 4,
      "text": "Regional terminology for hardy Native American horses was influenced by the linguistic and cultural heritage of the Cayuse tribe.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/cayuse_oregon"
    },
    {
      "id": 5,
      "text": "A post office served the Cayuse community for over a century, opening in 1867 and closing in 2002.",
      "sourceSentenceIds": [
        18
