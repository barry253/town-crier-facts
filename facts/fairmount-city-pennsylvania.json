  "facts": [
    {
      "id": 1,
      "text": "Fairmount City was formally laid out in 1871 as a coal‑mining town, with 66 acres purchased from John Doverspike for $4,500.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairmount_city_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s early economy began with a distillery built by Jones & Brinker, which later shifted to railroad construction and mining.",
      "sourceSentenceIds": [
        2,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairmount_city_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "By 1881, Fairmount City’s coal output reached 900 tons daily, supported by coke ovens and a company store run by the Fairmount Coal and Iron Company.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairmount_city_pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The community originated on a 400‑acre tract bought by Louis Doverspike in 1808, whose land later became the site of the town.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fairmount_city_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fairmount City’s climate is humid continental, with average January lows around 19°F and July highs near 80°F, and about 46 inches of annual precipitation.",
      "sourceSentenceIds": [
        16
      ],
