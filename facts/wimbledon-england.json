  "facts": [
    {
      "id": 1,
      "text": "Wimbledon’s All England Lawn Tennis and Croquet Club moved to its current grounds near Wimbledon Park in 1922 as the sport’s popularity exploded.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_London",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Hilcote Stables, originally founded in 1915 behind the Dog & Fox pub, were renamed Wimbledon Village Stables in 1980 after a lease change.",
      "sourceSentenceIds": [
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_London",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Laurence and Reginald Doherty captured a combined 25 Wimbledon titles and three Olympic gold medals in the early 1900s, cementing the town’s tennis heritage.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_London",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Wimbledon Local History Group, set up in 1971, preserves the town’s archives and meets monthly to encourage new research.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://wimbledonsociety.org.uk/local-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Old Central School on Camp Road, founded in 1758, served Wimbledon for over two centuries before closing in the 1960s.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Wimbledon%2C_London",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1969, Hilcote Stables were leased to Colin Crawford, marking a shift toward community use before its 1980 sale.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
