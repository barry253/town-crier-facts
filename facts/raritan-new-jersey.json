      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Naraticongs, a Lenape branch of the Iroquois, were the first people to settle the Raritan Valley.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
