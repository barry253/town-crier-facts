      "id": 1,
      "text": "Dutch settlers shortened Naraticongs to Raritan, meaning “forked river,” reflecting the area's split waterways.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
