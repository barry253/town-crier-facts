  "facts": [
    {
      "id": 1,
      "text": "Doucette sits in central Tyler County, Texas, and remains an unincorporated community.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Doucette%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town was renamed for Pete Doucette, a local rancher who helped settle the area.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/doucette-tx"
    },
    {
      "id": 3,
      "text": "A sawmill built in 1890 by Alva Carrolls sparked the first settlement, briefly called Carrolls' Switch.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/doucette-tx"
    },
    {
      "id": 4,
      "text": "In 1893 William McCready opened the first post office, becoming Doucette’s inaugural postmaster.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/doucette-tx"
    },
    {
      "id": 5,
      "text": "The Emporia Lumber Company ran the town’s main mill until 1906, making Doucette a leading East Texas lumber center.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/doucette-tx"
    },
    {
      "id": 6,
      "text": "International Paper still maintains an office and yard in Doucette, a legacy of the town’s long‑standing lumber industry.",
      "sourceSentenceIds": [
        29
      ],
