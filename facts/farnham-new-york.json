  "facts": [
    {
      "id": 1,
      "text": "Farnham takes its name from Leroy Farnham, a local landowner and merchant who helped establish the village.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farnham%2C_New_York",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1619 Andrew Windsor built almshouses that still stand on the Bishop’s Steps, a rare surviving 17th‑century structure.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://localhistories.org/a-history-of-farnham/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village incorporated in 1892, growing around the Lake Shore Railroad that linked it to Buffalo and the Erie Canal.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farnham%2C_New_York",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Farnham sits at the crossroads of New York State Route 5 and Route 249, a historic junction for regional travel.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Farnham%2C_New_York",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 5,
      "text": "Located in Erie County, Farnham lies southwest of Buffalo and north of the Pennsylvania border, overlooking Lake Erie.",
