  "facts": [
    {
      "id": 1,
      "text": "Alviso was founded in 1852 as an independent town and is now San Jose's only waterfront district.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alviso%2C_San_Jose",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town takes its name from Ignacio Alviso, a Californio ranchero and son of a de Anza expedition member.",
      "sourceSentenceIds": [
        8,
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alviso%2C_San_Jose",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Bayside Canning Company, once the nation’s third‑largest cannery, now stands as a San José historic landmark in ruins.",
      "sourceSentenceIds": [
        4,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.alvisountoldstory.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1864 the San Francisco and San José Railroad bypassed Alviso, yet the town later became a stop on the Newark line in the 1880s.",
      "sourceSentenceIds": [
        14,
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alviso%2C_San_Jose",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Alviso Mills, founded in 1853, produced up to 300 barrels of flour a day at its peak.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Alviso%2C_San_Jose",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A 2022–23 City of San José project surveys Alviso’s historic context, aiming to preserve its 19th‑century port heritage.",
      "sourceSentenceIds": [
