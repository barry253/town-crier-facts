  "facts": [
    {
      "id": 1,
      "text": "Lake Shore was designated as part of the Spanish Fork Indian Farm in 1856 to support the local Ute people through agriculture.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_shore_utah"
    },
    {
      "id": 2,
      "text": "Early settlers in Lake Shore built a fort in 1865 for protection and drilled the region's first artesian well in 1877.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_shore_utah"
    },
    {
      "id": 3,
      "text": "Lake Shore adopted its name in 1886 when it was formally organized as a religious ward due to its proximity to the lake.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_shore_utah"
    },
    {
      "id": 4,
      "text": "Benjamin Franklin Barney is recognized as a foundational figure who began clearing land in Lake Shore around 1860.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_shore_utah"
    },
    {
      "id": 5,
      "text": "Early interactions in Lake Shore involved cooperation with Ute bands, such as sharing fishing resources on Utah Lake.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_shore_utah"
    },
    {
      "id": 6,
      "text": "The economy of Lake Shore remains tied to agriculture and its rural setting near larger urban centers like Provo.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/lake_shore_utah"
    }
