  "facts": [
    {
      "id": 1,
      "text": "Thornburg began in 1899 when cousins Frank and David Thornburg subdivided family farmland into a planned suburb.",
      "sourceSentenceIds": [
        4,
        10
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://thornburgborough.org/about/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s historic district preserves the original brick and stone homes that were required to cost at least $2,500 when first built.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thornburgborough.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Thornburg Conservation Park, created in 2005 from part of the former Crafton Golf Course, offers walking trails at the town’s foot.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thornburgborough.org/about/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Chartiers Country Club, chartered in 1924 by early Thornburg residents, hosted holiday dinner dances for decades.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://thornburgborough.org/about/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Thornburg sits on the Allegheny Plateau, about 6 miles west of downtown Pittsburgh, near the confluence of the Allegheny and Monongahela rivers.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/thornburg_pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "Historical weather data show July highs around 82°F and January lows near 22°F, with summer humidity often over 70%.",
