  "facts": [
    {
      "id": 1,
      "text": "Madrone takes its name from the Spanish word for the Texas madrone tree, a native evergreen that once dotted the valley’s foothills.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madrone_new_mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1630s, Francisco de Valencia established a hacienda near the Valencia Pueblo site, supporting 46 families until the Pueblo Revolt of 1680.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madrone_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The 1948 Middle Rio Grande Project rehabilitated irrigation canals, creating 21,000 irrigable acres near Madrone and boosting regional agriculture.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madrone_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The arrival of the Atchison, Topeka and Santa Fe Railway in the 1880s spurred Anglo and Hispanic farming expansion into the Rio Grande Valley, shaping Madrone’s growth.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madrone_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Route 66 cut through Valencia County from 1926 until the late 1960s, passing near Madrone before the interstate rerouted traffic.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/madrone_new_mexico",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Madrone sits at 4,905 feet in the Middle Rio Grande floodplain, where semi‑arid conditions and monsoon storms can trigger flash floods.",
