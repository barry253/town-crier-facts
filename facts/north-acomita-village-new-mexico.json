  "facts": [
    {
      "id": 1,
      "text": "North Acomita Village’s early history began with Spanish encounters, but lasting influence started with Juan de Oñate’s 1598 expedition that imposed Spanish authority over Acoma lands.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_acomita_village_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "North Acomita Village sits in a high‑desert setting near Acoma Pueblo, also called Sky City, one of North America’s oldest continuously inhabited communities.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_acomita_village_new_mexico",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "North Acomita Village hosts the Sky City Casino Hotel, a key tribal enterprise that fuels revenue and jobs along historic Route 66.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_acomita_village_new_mexico",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "North Acomita Village sits on the Acoma Indian Reservation, where archaeological evidence shows continuous Ancestral Puebloan occupation since at least AD.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_acomita_village_new_mexico",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "North Acomita Village’s Acoma laborers hauled pine beams from 30 miles away up the 357‑foot mesa to build a hybrid Spanish‑Pueblo structure with adobe walls and bell towers.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_acomita_village_new_mexico",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "North Acomita Village has a cold desert climate, with summer highs around 32°C and winter lows near -8°C.",
