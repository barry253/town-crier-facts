  "facts": [
    {
      "id": 1,
      "text": "The village of Reeseville was named after early settler Samuel Reese by his son Adam, who surveyed and platted the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Reeseville%2C_Wisconsin"
    },
    {
      "id": 2,
      "text": "The railroad arrived in 1858, and while the depot was first called Lowell Station, it was renamed Reeseville in 1865.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vi.reeseville.wi.gov/history/"
    },
    {
      "id": 3,
      "text": "The Reese family first arrived in the area in 1844, when much of Wisconsin was still an unbroken wilderness.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://vi.reeseville.wi.gov/history/"
    },
    {
      "id": 4,
      "text": "The Reeseville Concert Band was organized in 1901 and held a benefit dance to celebrate its formation.",
      "sourceSentenceIds": [
        18
