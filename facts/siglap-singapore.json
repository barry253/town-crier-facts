  "facts": [
    {
      "id": 1,
      "text": "Siglap was founded by Tok Lasam, a Minangkabau prince from Sumatra, who settled fishermen between 1819‑1822.",
      "sourceSentenceIds": [
        10,
        1
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/siglap"
    },
    {
      "id": 2,
      "text": "The village name Siglap may come from a solar eclipse at its founding in 1821 or from the thick coconut canopy that dimmed sunlight.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.roots.gov.sg/places/places-landing/Places/landmarks/bedok-trail/siglap"
    },
    {
      "id": 3,
      "text": "In 1946 the estate was sold to the Loke family, who built a Cathay‑Keris film studio that still marks the area’s cinematic past.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.roots.gov.sg/places/places-landing/Places/landmarks/bedok-trail/siglap"
    },
    {
      "id": 4,
      "text": "Siglap’s first MRT station opened in June 2024, linking the neighbourhood to the Thomson‑East Coast Line and the wider city.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Siglap"
    },
    {
      "id": 5,
      "text": "The historic Kubur Kassim cemetery, also known as Keramat Sheikh Ali, sits in Siglap’s heart and houses many early Muslim graves.",
