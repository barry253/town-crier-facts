      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cold Spring boasts three National Register of Historic Places sites: the 1907 John Oster House, Ferdinand Peters House, and the 1912 Eugene Hermanutz House.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
