  "facts": [
    {
      "id": 1,
      "text": "McVeytown was originally called Waynesburg, settled 1762, laid out 1795, and incorporated in 1833.",
      "sourceSentenceIds": [
        8,
        4,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "McVeytown is named after John McVey, the landowner who founded the borough.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Joseph Rothrock, known as the 'Father of Pennsylvania Forestry', was born in McVeytown on April 9, 1839.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "McVeytown sits on the west bank of the Juniata River, with Mattawana Village across the river on the east bank.",
      "sourceSentenceIds": [
        7,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/McVeytown%2C_Pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "McVeytown’s annual Rothrock Fair runs September 11‑13, drawing locals to its historic celebration.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mcveytownboro.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Rothrock Community Library opens Tuesdays and Thursdays from 10 am to 7 pm, serving as a local gathering spot.",
