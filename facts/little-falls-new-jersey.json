  "facts": [
    {
      "id": 1,
      "text": "Little Falls takes its name from a waterfall on the Passaic River that once cascaded over the dam in front of Beattie Mill.",
      "sourceSentenceIds": [
        5,
        8
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Falls%2C_New_Jersey",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The township’s first European settlement began in 1711 when seven Bergen Dutch settlers started farming the area.",
      "sourceSentenceIds": [
        11,
        22
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Falls%2C_New_Jersey",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "For much of its history, the Beattie Carpet Mill was Little Falls’ largest employer, and its historic buildings are now elegant condominiums overlooking the river.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://littlefallsnj.gov/about",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Speer Homestead, built around 1785 and possibly as early as 1680, stands as one of the town’s oldest surviving structures.",
      "sourceSentenceIds": [
        10,
        29
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.littlefallshistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Little Falls station on the NJ Transit Montclair‑Boonton Line connects the township to Hoboken and New York City via Midtown Direct trains.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Falls%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1930s, comedian Jackie Gleason performed stand‑up at the Colonial Inn, a hotel and lounge that was a local landmark.",
