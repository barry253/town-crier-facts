  "facts": [
    {
      "id": 1,
      "text": "De Beque was named after Dr. de Beque who explored the area in 1884 looking for a ranch spot.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Beque%2C_Colorado",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town opened its post office on March 23, 1888 and incorporated on January 18, 1890.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Beque%2C_Colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 2001 De Beque became the only Wild Horse Sanctuary City in the West, protecting local mustangs.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Beque%2C_Colorado",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic downtown features a town hall that hosts a mustang statue commemorating the town’s horse heritage.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Beque%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "De Beque sits on a hill overlooking the Colorado River, just north of Grand Junction, with Mount Logan visible five miles to the north.",
      "sourceSentenceIds": [
        21,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/De_Beque%2C_Colorado",
      "category": "nature",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 6,
      "text": "On April 1, 2014 the town approved retail sale of recreational marijuana, the first incorporated town in Mesa County to do so.",
