    },
    {
      "id": 2,
      "text": "Larson and Stoner built a sawmill and dam for the community in 1862.",
      "sourceSentenceIds": [
        3,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.newlondonmn.net/?SEC=2A966389-4402-4E5F-BFE3-879BF1AFFB25"
    },
    {
      "id": 3,
      "text": "New London has hosted a creamery, glove factory, concrete supply, propane tank manufacturer, and printing company.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.newlondonmn.net/?SEC=2A966389-4402-4E5F-BFE3-879BF1AFFB25"
    },
    {
      "id": 4,
      "text": "New London sits in Kandiyohi County on the shores of the Middle Fork of the Crow River.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newlondonmn.net/?SEC=2A966389-4402-4E5F-BFE3-879BF1AFFB25"
    },
    {
      "id": 5,
      "text": "The discovery of the falls marked the real opening of this area for settlement.",
