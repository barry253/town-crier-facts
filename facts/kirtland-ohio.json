  "facts": [
    {
      "id": 1,
      "text": "Kirtland was named after Turhand Kirtland, a Connecticut Land Company judge who helped settle the Western Reserve.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirtland%2C_Ohio",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town hosted the first Latter Day Saint temple, completed in 1836, making it the movement's early headquarters from 1831‑1837.",
      "sourceSentenceIds": [
        16,
        26,
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirtland%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "During the 1836 Kirtland Temple dedication, attendees reported heavenly visions, a dramatic moment in early Mormon history.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirtland%2C_Ohio",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Historic Kirtland Village, opened in 2000, recreates 1830s life with replicas of a schoolhouse, sawmill, and ashery.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Kirtland%2C_Ohio",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Holden Arboretum, part of Lake Metroparks, sits on Kirtland's hilly, forested terrain and offers extensive botanical collections.",
      "sourceSentenceIds": [
