  "facts": [
    {
      "id": 1,
      "text": "Upper West Side was once called Bloomingdale, covering roughly 96th to 110th Streets.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.upperwestsidehistory.org/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Columbia University beyond 116th shaped the neighborhood’s vibe, and the Historical Society and American Museum of Natural History turned Central Park West into a boulevard of enlightenment.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/upper-west-side",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The Ansonia Hotel at 73rd and Broadway, built in 1904, was a Beaux‑Arts palace that hosted opera stars, athletes, and socialites.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/upper-west-side",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Bloomingdale branch of the New York Public Library on West 100th Street preserves the Upper West Side’s public archive of neighborhood history.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.upperwestsidehistory.org/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Free walking tours led by historian Jim Mackin guide visitors through historic Bloomingdale between 96th and 110th Streets.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.upperwestsidehistory.org/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Upper West Side has served as a backdrop for countless films and television shows.",
