  "facts": [
    {
      "id": 1,
      "text": "Little Italy originated at Mulberry Bend south of Canal, once part of Five Points, now heart of Chinatown.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nyc.eu/boroughs-of-new-york-city/manhattan/little-italy/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood once spanned Lafayette to Bowery, Kenmare to Worth, but today it is only five blocks on Mulberry north of Canal.",
      "sourceSentenceIds": [
        23,
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Little_Italy%2C_Manhattan",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "In the 20th century, Little Italy became infamous for Mafia influence, yet most residents led honest lives.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nyc.eu/boroughs-of-new-york-city/manhattan/little-italy/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Italian American Museum at 155 Mulberry Street preserves the immigrant history.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://nyc.eu/boroughs-of-new-york-city/manhattan/little-italy/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Ferrara Bakery & Cafe, family‑owned since 1892, still serves classic cannoli and espresso.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.newyorkwelcome.net/explore/what-to-see/neighborhoods/little-italy-chinatown.htm",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Patrick’s Old Cathedral at 263 Mulberry transports visitors back to the religious past of New York’s Italian community.",
