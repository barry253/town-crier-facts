      ],
      "source": "https://en.wikipedia.org/wiki/Zilwaukee%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The iconic Zilwaukee Bridge, a major steel structure over the Saginaw River, is a defining landmark of the city.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
