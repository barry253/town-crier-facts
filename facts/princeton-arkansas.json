  "facts": [
    {
      "id": 1,
      "text": "Princeton was established in 1845 as the first county seat of the newly formed Dallas County.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/princeton_arkansas"
    },
    {
      "id": 2,
      "text": "Originally named Dallastown, the settlement was renamed Princeton in November 1845 following a petition to the county court.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/princeton_arkansas"
    },
    {
      "id": 3,
      "text": "Princeton's early economy centered on cotton plantations, small farms, and pottery production starting as early as 1843.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/princeton_arkansas"
    },
    {
      "id": 4,
      "text": "The arrival of the Cotton Belt Railroad in 1882 bypassed Princeton, leading to a decline in its local prominence.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/princeton_arkansas"
    },
    {
      "id": 5,
      "text": "Princeton Cemetery is listed on the National Register of Historic Places and contains graves dating back to 1849.",
      "sourceSentenceIds": [
        2,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://grokipedia.com/page/princeton_arkansas"
    },
    {
      "id": 6,
      "text": "Historic sites in Princeton include the National Register-listed Culbertson and Bird pottery kilns.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/princeton_arkansas"
    }
  ]
