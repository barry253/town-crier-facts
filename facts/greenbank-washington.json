      "qualityReason": "location_description"
    },
    {
      "id": 3,
      "text": "The Greenbank Store, opened in 1904, still offers a deli, post office, groceries, and a restaurant on its second floor.",
      "sourceSentenceIds": [
        9,
        11
      ],
      "sourceLabels": [
        "Web source 1",
