    {
      "id": 2,
      "text": "The community took its name from the local Centenary Methodist Church, which commemorated a centenary milestone in Methodism.",
      "sourceSentenceIds": [
        2,
        18
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
