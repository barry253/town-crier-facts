    },
    {
      "id": 3,
      "text": "Centenary Methodist Church is a Greek Revival-style wooden frame building constructed in 1853 on the site of earlier camp meetings.",
      "sourceSentenceIds": [
        4,
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/centenary_south_carolina"
    },
    {
      "id": 4,
      "text": "A local post office has served the Centenary community since 1853, the same year the church was built.",
      "sourceSentenceIds": [
        6,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/centenary_south_carolina"
    },
    {
      "id": 5,
      "text": "Early European-American settlers established Centenary as an agrarian society focused on farming cotton in the Pee Dee region.",
      "sourceSentenceIds": [
        7,
        14
      ],
      "sourceLabels": [
        "Web source 1"
