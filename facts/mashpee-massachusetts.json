  "facts": [
    {
      "id": 1,
      "text": "Mashpee is the historic home of the federally recognized Mashpee Wampanoag Tribe, whose headquarters sit in the town.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mashpee%2C_Massachusetts",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s name comes from the Wampanoag word “Mâseepee,” meaning “the greater cove,” referencing Wakeby Pond.",
      "sourceSentenceIds": [
        13,
        26,
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mashpee%2C_Massachusetts",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Mashpee was officially settled in 1660, shortly after English colonists established a church there in 1658 with missionary Richard Bourne.",
      "sourceSentenceIds": [
        19,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mashpee%2C_Massachusetts",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Unlike any other Cape Cod town, Mashpee never had a railroad built into it, a unique transportation fact.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mashpee%2C_Massachusetts",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 5,
      "text": "The One Room Schoolhouse in the Community Park is a preserved slice of Mashpee’s early education history.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mashpeema.gov/1195/Discover-Mashpee",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Mashpee Commons, a New Urbanism redevelopment at Routes 28 and 151, showcases early 21st‑century urban planning on the Cape.",
      "sourceSentenceIds": [
