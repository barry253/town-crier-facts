  "facts": [
    {
      "id": 1,
      "text": "Lockhart sprang up in 1904 when the Jackson Lumber Company built a mill, turning the town into a classic company town.",
      "sourceSentenceIds": [
        1,
        22
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://encyclopediaofalabama.org/article/lockhart/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was named for Standard Oil magnate Charles Lockhart, whose financing helped build the mill and its first general store.",
      "sourceSentenceIds": [
        4,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockhart%2C_Alabama",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Many of Lockhart’s streets honor Native American tribes, reflecting the town’s grid layout modeled after northern industrial towns.",
      "sourceSentenceIds": [
        3,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockhart%2C_Alabama",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Lockhart incorporated in 1931, but the mill that powered the town shut down in 1940.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://encyclopediaofalabama.org/article/lockhart/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "At its peak, Lockhart’s mill was the largest in the United States and even supplied flooring for New York’s Waldorf‑Astoria Hotel.",
      "sourceSentenceIds": [
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lockhart%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1903 the mill became the center of a peonage scandal, where over 100 immigrant workers were held against their will in a walled compound.",
