    {
      "id": 1,
      "text": "Williamstown was first called Port Harwood by John Batman in 1835 before being renamed after King William IV.",
      "sourceSentenceIds": [
        2,
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.visitwilliamstown.com.au/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town sits at the mouth of the Yarra River where it enters Hobsons Bay, making it Melbourne’s oldest suburb.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.visitwilliamstown.com.au/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Williamstown’s Alfred Graving Dock was the first in Victoria and the third in Australia, still in use since its 19th‑century completion.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamstown%2C_Victoria",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Royal Yacht Club of Victoria moved to its current Gem Pier site in 1900, reflecting the town’s long maritime tradition.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamstown%2C_Victoria",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Williamstown’s historic Nelson Place precinct showcases large‑scale maritime industry and a themed tourism area centered on its piers.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Williamstown%2C_Victoria",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Williamstown Racing Club, founded in 1864, once ranked among Victoria’s senior thoroughbred racing clubs.",
