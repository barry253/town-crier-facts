  "facts": [
    {
      "id": 1,
      "text": "Jacob 'Jake' Rodenbaugh, a German immigrant, arrived in Nevada in 1858 and tried placer mining.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/douglas/ruhenstroth.php"
    },
    {
      "id": 2,
      "text": "In 1877, he built a station on the Bryon Toll Road to serve traffic to the nearby mines.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/douglas/ruhenstroth.php"
    },
    {
      "id": 3,
      "text": "When mining waned in the 1890s, Rodenbaugh shifted to sheep ranching while his wife Delilah kept the station running.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/douglas/ruhenstroth.php"
    },
    {
      "id": 4,
      "text": "Rodenbaugh’s charcoal business supplied mining towns in Nevada from 1870 to 1893.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/douglas/ruhenstroth.php"
    },
    {
      "id": 5,
      "text": "Ludwig 'Louis' Ruhenstroth bought the station in 1916 for $20,000, closed it in 1917, and built a two‑story brick house that cost $7,000.",
      "sourceSentenceIds": [
        6,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/douglas/ruhenstroth.php"
    },
    {
      "id": 6,
      "text": "The original Ruhenstroth home still stands today, surrounded by a subdivision that carries the family name.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.nvexpeditions.com/douglas/ruhenstroth.php"
