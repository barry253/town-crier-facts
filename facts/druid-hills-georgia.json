  "facts": [
    {
      "id": 1,
      "text": "Druid Hills was conceived by Joel Hurt and developed by Atlanta’s leading families, including Coca‑Cola founder Asa Candler.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Druid_Hills%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood’s layout, designed by Frederick Law Olmsted, features winding roads and expansive green spaces that still define its affluent character.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Druid_Hills,_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1905, Druid Hills became one of Olmsted’s last commissions, setting a model for early American suburban design.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Druid_Hills%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Callanwolde Fine Arts Center sits in a Gothic‑Tudor estate once owned by Charles Howard Candler, Asa’s son.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Druid_Hills%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Druid Hills hosts the main campus of Emory University, which moved to Atlanta in 1914 and remains a research hub.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Druid_Hills%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Druid Hills Civic Association, founded in 1939, continues to shape neighborhood life and preserve its historic architecture.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
