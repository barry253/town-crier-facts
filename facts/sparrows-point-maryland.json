  "facts": [
    {
      "id": 1,
      "text": "Sparrows Point takes its name from Thomas Sparrow Jr., a landowner who once owned the marshland that became the steel hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparrows_Point%2C_Maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1887, engineer Frederick Wood saw Sparrows Point’s marshy inlet as the perfect deep‑water port for the Pennsylvania Steel Company.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparrows_Point%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The massive Bethlehem Steel shipyard at Sparrows Point once built more steel than any other plant worldwide.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparrows_Point%2C_Maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today the former steel mill has been reborn as Tradepoint Atlantic, one of the East Coast’s largest ports.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sparrows_Point%2C_Maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Sparrows Point sits on a peninsula jutting into Baltimore Harbor, where the Patapsco River meets Chesapeake Bay.",
      "sourceSentenceIds": [
        27
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/Sparrows_Point,_Maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Baltimore’s United Railways & Electric Company ran a dedicated double‑track trolley line straight to the steel mill.",
