  "facts": [
    {
      "id": 1,
      "text": "Orefield began as Siegersville, named for Bavarian weaver John George Sieger, and was renamed in 1840 to avoid confusion with nearby Saegersville.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/orefield_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1861 the Ironton Railroad extended its Siegersville Branch to Orefield, hauling ore and sparking local industry.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/orefield_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Shankweiler’s Drive‑In Theatre, opened in 1934, remains America’s oldest operating drive‑in cinema.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Orefield%2C_Pennsylvania",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "German Palatine settlers arrived in the early 1700s, clearing land and establishing villages such as Orefield in the Lehigh Valley.",
