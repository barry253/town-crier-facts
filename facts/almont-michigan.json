  "facts": [
    {
      "id": 1,
      "text": "Almont was founded in 1833 when Daniel Black bought land for $1.25 an acre and built the first log house on Main Street.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.almontmichigan.gov/community/history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village was originally platted as Newburg in 1836 and renamed Almont in 1846.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Almont%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A narrow‑gauge branch of the Port Huron and Northwest Railroad reached Almont in 1882, but the line was never extended and was abandoned in 1942.",
      "sourceSentenceIds": [
        7,
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.almontmichigan.gov/community/history/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Almont Historical Society was re‑established in 1986 when citizens met at Roger and Christina Bailey’s home on West Street.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://almonthistoricalsociety.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "During Homecoming, current and former residents gather to celebrate Almont’s heritage and history at the village center.",
