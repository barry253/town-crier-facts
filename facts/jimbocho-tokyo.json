  "facts": [
    {
      "id": 1,
      "text": "Jimbocho earned the nickname \"Book Town\" after the 1950s surge of rare‑title shops, now hosting 176 used bookstores.",
      "sourceSentenceIds": [
        23,
        24,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jimb%C5%8Dch%C5%8D_Book_Town"
    },
    {
      "id": 2,
      "text": "Meiji University, founded 1881, sits in Jimbocho and helped spark the neighborhood’s literary boom after the Meiji Restoration.",
      "sourceSentenceIds": [
        4,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jimb%C5%8Dch%C5%8D_Book_Town"
    },
    {
      "id": 3,
      "text": "Kitazawa Bookstore, opened in 1902, specializes in foreign used books and is a one‑minute walk from Jimbocho Station.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.japan-experience.com/all-about-japan/tokyo/attractions-excursions/jinbocho"
    },
    {
      "id": 4,
      "text": "Bumpodo, an art‑supply shop founded in 1887, hosts a gallery and café where visitors can sip coffee amid canvases.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.magical-trip.com/media/ultimate-jimbocho-guide-tokyos-vintage-booktown-paradise-hidden-gems-best-bookstores-local-secrets/"
    },
    {
      "id": 5,
      "text": "Jimbocho’s Jimbocho Theater, completed in 2007, adds a modern cultural venue to the historic book‑town atmosphere.",
