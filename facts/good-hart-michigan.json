  "facts": [
    {
      "id": 1,
      "text": "Good Hart got its name when Silas McNeil opened a post office in 1874, misspelling \"heart\" as \"hart\" and keeping the error.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/good-hart-photos/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the early 1800s, Ojibwe leaders Joseph Black Hawk and his brother Good Heart made the area a central settlement.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Readmond_Township%2C_Michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Late 1800s settlers turned Good Hart into a fishing and lumbering village before tourism grew.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lifeingoodhart.com/the-history-of-good-hart-in-northern-michigan/",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Today Good Hart is largely a ghost town, once a bustling community on Lake Michigan.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://99wfmk.com/good-hart-photos/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The historic Tunnel of Trees drive along M‑119 offers scenic views of Lake Michigan near Good Hart.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lifeingoodhart.com/the-history-of-good-hart-in-northern-michigan/",
      "category": "landmark",
      "quality": "good"
    },
    {
