      "quality": "good"
    },
    {
      "id": 3,
      "text": "Free admission hours rotate: MFAH opens 11 am–9 pm, the Children’s Museum after 5 pm, the Health Museum 2–7 pm, and Natural Science Tuesdays 5–8 pm.",
      "sourceSentenceIds": [
        16,
        17,
