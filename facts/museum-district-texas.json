      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Museum District is a collective of 21 museums, cultural centers and community organizations that champion art, science, history and culture.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Houston_Museum_District",
