  "facts": [
    {
      "id": 1,
      "text": "Cowdrey was founded in 1882 as a supply station and cattle ranching hub near the confluence of the North Platte, Michigan, and Canadian rivers, named after homesteader Charles Cowdrey.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cowdrey_colorado",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s post office opened April 5, 1915, becoming a vital link for isolated ranchers and enabling mail‑order catalogs in the harsh North Park terrain.",
      "sourceSentenceIds": [
        13,
        24,
        25,
        26
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cowdrey%2C_Colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Cowdrey sits at 7,917 feet, giving it a cold semi‑arid climate with mild summers and harsh winters typical of the high‑elevation North Park basin.",
      "sourceSentenceIds": [
        14,
        28,
        30
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Cowdrey%2C_Colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The historic Cowdrey General Store, a two‑story stucco building with traditional vigas, remains a landmark that reflects the town’s early commercial architecture.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cowdrey_colorado",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Nearby Cowdrey Reservoir State Wildlife Area offers fishing and wildlife viewing, while the Arapaho National Wildlife Refuge nearby attracts birdwatchers and moose sightings.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/cowdrey_colorado",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the late 19th century, Cowdrey served as a key stopover for miners and travelers, featuring a hotel built by Cowdrey himself that supported local mining and agricultural activities.",
      "sourceSentenceIds": [
        17
      ],
