  "facts": [
    {
      "id": 1,
      "text": "Wolf Lake earned its name from its wolf‑shaped shoreline and the early abundance of wolves, bears, and deer that roamed the area.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_minnesota"
    },
    {
      "id": 2,
      "text": "Finnish immigrant John Wirkkanen was the first settler, arriving May 15, 1888, and homesteading Section 32 after a six‑week ox‑team trek.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_minnesota"
    },
    {
      "id": 3,
      "text": "A temporary post office called 'Wolf' operated 1909‑1911, and Wolf Lake was incorporated as a statutory village on May 12, 1949.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_minnesota"
    },
    {
      "id": 4,
      "text": "The lake itself spans roughly 1,460 acres and reaches a maximum depth of 16 feet.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_minnesota"
    },
    {
      "id": 5,
      "text": "Wolf Lake offers anglers walleye and northern pike, while nearby Smoky Hills State Forest provides hunting, hiking, and birdwatching opportunities.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_minnesota"
    },
    {
      "id": 6,
      "text": "Before European settlement, the area now known as Wolf Lake Township was largely inhabited by the Chippewa (Ojibwe) people.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/wolf_lake_minnesota"
    }
