  "facts": [
    {
      "id": 1,
      "text": "Leblon is named after Carlos Leblon, a French whaling empresario who owned a farm in the area since 1845.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leblon",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood began as a quilombo founded by José de Seixas Magalhães, a suitcase manufacturer who hid escaped slaves on his farm.",
      "sourceSentenceIds": [
        22,
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leblon",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Seixas cultivated camellias on his farm, turning the flower into a symbol of the abolitionist movement.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Leblon",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "In 1914, the government extended tram lines from Gávea and Ipanema to Leblon, linking the neighborhood to the city.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://freewalkertours.com/leblon-history-and-curiosities/",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Leblon beach is celebrated for its natural beauty, quiet streets, and gastronomy, making it a favorite among locals.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://freewalkertours.com/leblon-history-and-curiosities/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Café ao Leu, once in Copacabana, now serves arguably the city’s best coffee in Leblon.",
      "sourceSentenceIds": [
        6
