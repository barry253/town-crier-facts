  "facts": [
    {
      "id": 1,
      "text": "Hornitos was the first and only incorporated town in Mariposa County, founded during the Gold Rush era.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornitos%2C_California"
    },
    {
      "id": 2,
      "text": "The town’s name comes from Mexican stone graves shaped like small bake ovens, a detail noted by the California Office of Historic Preservation.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornitos%2C_California"
    },
    {
      "id": 3,
      "text": "Legends say Joaquin Murrieta hid in tunnels beneath Hornitos, though locals consider the tales folklore.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mercedcountytimes.com/legends-live-on-in-historic-town-of-hornitos/"
    },
    {
      "id": 4,
      "text": "Hornitos’ central plaza is a Mexican‑style layout, one of few Gold Rush settlements built around a plaza instead of a main street.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornitos%2C_California"
    },
    {
      "id": 5,
      "text": "The historic Masonic Lodge, built in 1873, served as a store before becoming a lodge hall until 1930.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hornitos%2C_California"
    },
    {
      "id": 6,
      "text": "In 1872 the arrival of the railroad through Merced caused Hornitos to decline, ending its boom period.",
