      ],
      "source": "https://en.wikipedia.org/wiki/Valley_Ford%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1846, Mexican land grant Rancho Estero Americano, awarded to Bartolomé Bojorquez, encompassed the area that would become Valley Ford.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
