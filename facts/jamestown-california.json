  "facts": [
    {
      "id": 1,
      "text": "Jamestown was founded in 1848 after Benjamin Wood discovered a 75‑pound gold nugget in a nearby creek.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westernmininghistory.com/towns/california/jamestown/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town earned its name from founder James, who reportedly served champagne to have it named after him.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westernmininghistory.com/towns/california/jamestown/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Railtown 1897 State Historic Park preserves Jamestown’s railroad heritage, where steam passenger trains still run.",
      "sourceSentenceIds": [
        1,
        17
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.visitcalifornia.com/places-to-visit/jamestown/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jamestown’s historic buildings, many from the Gold Rush era, now host cafés, a micro‑brewery, and wine tasting rooms.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://westernmininghistory.com/towns/california/jamestown/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town has been a filming location for over two dozen productions, including “Back to the Future Part III” and “Petticoat Junction.”.",
      "sourceSentenceIds": [
        10,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Web source 1"
      ],
      "source": "https://westernmininghistory.com/towns/california/jamestown/",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 6,
      "text": "In 1949, Jamestown was added to California’s Historical Landmark list to prevent it from becoming a ghost town.",
      "sourceSentenceIds": [
