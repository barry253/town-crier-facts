  "facts": [
    {
      "id": 1,
      "text": "Neapolis means “new city” in Greek, a name chosen in the 19th‑century trend of Greco‑Roman toponymy for new settlements.",
      "sourceSentenceIds": [
        13,
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/neapolis-187104"
    },
    {
      "id": 2,
      "text": "The community was laid out in 1872, shortly after the surrounding area began to grow.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neapolis%2C_Ohio"
    },
    {
      "id": 3,
      "text": "A post office has operated in Neapolis since 1873, serving the local residents for nearly a century.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Neapolis%2C_Ohio"
    },
    {
      "id": 4,
      "text": "Construction of the Wabash and Erie Canal in the mid‑1800s brought trade and agricultural transport to the Neapolis area.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/neapolis-187104"
    },
    {
      "id": 5,
      "text": "Today Neapolis remains an unincorporated residential enclave that reflects Lucas County’s agricultural heritage.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/neapolis-187104"
    },
    {
      "id": 6,
      "text": "Neapolis is situated within Providence Township in Lucas County, Ohio.",
