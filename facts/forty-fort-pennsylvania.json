  "facts": [
    {
      "id": 1,
      "text": "Forty Fort takes its name from a fort built in 1769 by forty Connecticut settlers who claimed this territory.",
      "sourceSentenceIds": [
        2,
        11
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.experiencepa.com/forty-fort-pennsylvania/"
    },
    {
      "id": 2,
      "text": "The original fort in Forty Fort featured double-thick log walls that extended five feet underground and twelve feet above ground.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://exploreforts.com/forts/forty-fort-pa"
    },
    {
      "id": 3,
      "text": "Competing land claims between Connecticut and Pennsylvania led to the Pennamite–Yankee Wars before the federal government awarded the land to Pennsylvania.",
      "sourceSentenceIds": [
        12,
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forty_Fort%2C_Pennsylvania"
    },
    {
      "id": 4,
      "text": "During the Revolutionary War, Forty Fort was the site of the Battle of Wyoming, also known as the Wyoming Massacre.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forty_Fort%2C_Pennsylvania"
    },
    {
      "id": 5,
      "text": "The Forty Fort Meetinghouse, built between 1806 and 1808, is located within the borough's cemetery.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forty_Fort%2C_Pennsylvania"
    },
    {
      "id": 6,
      "text": "The Daughters of the American Revolution placed a large stone at the end of Fort Street to mark the fort's approximate location.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Forty_Fort%2C_Pennsylvania"
