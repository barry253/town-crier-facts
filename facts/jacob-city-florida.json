  "facts": [
    {
      "id": 1,
      "text": "Jacob City began when Jacob Jones, a white settler, welcomed people of the African diaspora onto his land in the early 1800s.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob_City%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Jacob City’s earliest non‑indigenous settlement dates back to 1752, during the era of Spanish Florida.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob_City%2C_Florida",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A historic marker in Jacob City commemorates the town’s early roots and its founding story.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Jacob_City%2C_Florida",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s iconic water tower, a North Star Legacy landmark, reflects Jacob City’s heritage that stretches back to the early 1800s.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstarlegacies.com/2023/07/16/jacob-city/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Barbershops, beauty stores, and small cafés have long served as social hubs, weaving a vibrant fabric throughout Jacob City’s history.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://northstarlegacies.com/2023/07/16/jacob-city/",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "By the mid‑19th century, Jacob had become Jackson County’s first Black community, a milestone in the region’s history.",
      "sourceSentenceIds": [
        12
      ],
