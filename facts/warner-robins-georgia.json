  "facts": [
    {
      "id": 1,
      "text": "Warner Robins was founded in 1942 when the farming community of Wellston was renamed for Army Air Corps General Augustine Warner Robins.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warner_Robins%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s heart is Robins Air Force Base, one of Georgia’s largest employers, supplying over 25,000 military, civil, and contractor jobs.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warner_Robins%2C_Georgia",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Warner Robins hosts the Museum of Aviation, a tribute to the city’s military aviation heritage and the base’s storied past.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warner_Robins%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Actress Victoria Principal, famed for “Dallas,” hails from Warner Robins, adding a touch of Hollywood to the city’s profile.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warner_Robins%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bobbie Eakes, Emmy‑nominated actress and singer, also calls Warner Robins home, showcasing the town’s talent in television and music.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Warner_Robins%2C_Georgia",
      "category": "people",
      "quality": "good"
    },
    {
