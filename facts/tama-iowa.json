  "facts": [
    {
      "id": 1,
      "text": "Tama County was created on February 17, 1843, and named after Meskwaki leader Taimah.",
      "sourceSentenceIds": [
        1,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tama_County%2C_Iowa"
    },
    {
      "id": 2,
      "text": "Tama is Iowa’s oldest railroad town, once a bustling hub for several major rail lines.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tamatoledochamber.com/city-of-tama"
    },
    {
      "id": 3,
      "text": "The historic Tama City Brewery, founded in the early 1900s, still operates and is a local landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tamatoledochamber.com/city-of-tama"
    },
    {
      "id": 4,
      "text": "The Tama Creamery Paper Mill, established in 1905, produced paper for the national market and remains a key industrial heritage site.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tamatoledochamber.com/city-of-tama"
    },
    {
      "id": 5,
      "text": "The Tama Hydraulic Power Company, built in 1910, supplied electricity to the town before the regional grid arrived.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tamatoledochamber.com/city-of-tama"
    },
    {
      "id": 6,
      "text": "Both the Tama Creamery Paper Mill and Tama Hydraulic Power are listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Tama_County%2C_Iowa"
