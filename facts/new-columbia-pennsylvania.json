  "facts": [
    {
      "id": 1,
      "text": "New Columbia was formally laid out and incorporated in 1818 by David Yoder, who had once settled the area known as Dogtown.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Columbia%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "By 1886 the village boasted 100 houses, a hotel, a store, a post office, a train station, a boat shop, and about 350 residents.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Columbia%2C_Pennsylvania",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "In 1889 White Deer Township hired its first constable, Moses Brown, who also worked as a shoemaker.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Columbia%2C_Pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The 1890s saw New Columbia host a baker, confectioner, ice‑cream shop, and bicycle shop, reflecting its growing local economy.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Columbia%2C_Pennsylvania",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "New Columbia celebrated its 200th birthday in 2018 with a year‑long series of community events.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/New_Columbia%2C_Pennsylvania",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The village sits along U.S. Route 15, very near the West Branch Susquehanna River, a key waterway for early settlers.",
