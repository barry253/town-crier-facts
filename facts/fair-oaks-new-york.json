  "facts": [
    {
      "id": 1,
      "text": "Fair Oaks History Center first opened in 1980 inside a former cemetery office conference room.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 2,
      "text": "In 2014, the Center added an interactive video unit showcasing 800 historic photos, movie clips, and oral histories.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 3,
      "text": "The Center’s permanent exhibit features 11 storyboards that trace Fair Oaks’ journey from its 1895 founding through the 1950s and 1960s Aerojet era.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 4,
      "text": "Museum display cases preserve early Native American Maidu artifacts alongside relics from historic Fair Oaks homes and businesses.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 5,
      "text": "The building that now houses the History Center was leased to the Fair Oaks Historical Society in 2013 after the district had no immediate need for the site.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://fairoakshistory.org/center/"
    },
    {
      "id": 6,
      "text": "Fair Oaks’ post office opened in 1872, marking the community’s early establishment.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
