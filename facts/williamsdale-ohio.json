      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Busenbark’s Station famously hosted a World Championship Prize Fight on August 31, 1867, drawing crowds from across the region.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
