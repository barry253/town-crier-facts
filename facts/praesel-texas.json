    },
    {
      "id": 4,
      "text": "Praesel lies in the southwestern part of Milam County, bordered to the north by Rockdale.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Praesel%2C_Texas",
