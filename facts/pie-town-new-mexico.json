      "quality": "good"
    },
    {
      "id": 2,
      "text": "Pie Town’s name is famously unusual, a fact noted by many travelers and locals alike.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pie_Town%2C_New_Mexico",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Before settlers arrived, the area that is now Pie Town was home to Anasazi and Acoma Native American tribes.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
