  "facts": [
    {
      "id": 1,
      "text": "Euless takes its name from Elisha Adam Euless, a Tennessee native who moved to Texas in 1867 and bought land at what is now North Main St.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Euless%2C_Texas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first post office in the area opened in 1857 as Estill's Station on the site that is now the Euless airport.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/euless-tx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1903 the Rock Island Railroad built a depot two miles south of Euless at Candon, which was renamed Tarrant by 1905.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/euless-tx",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city’s first brick home, the Fuller House, has been restored and now serves as the Euless Museum.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.eulesstx.gov/community/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A log cabin from the 1850s, the Himes Log House, was preserved and restored as part of the city’s historic preservation efforts.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.eulesstx.gov/community/history",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Visitors can explore hundreds of artifacts at the Euless Heritage Park & Museum, located at 201 Cullum Drive.",
      "sourceSentenceIds": [
        13
