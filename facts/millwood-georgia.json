  "facts": [
    {
      "id": 1,
      "text": "Millwood’s name comes from the lumber mills that powered the local economy in the late 1800s, a classic example of industrial naming in the South.",
      "sourceSentenceIds": [
        1,
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/millwood-193264",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "A post office opened in Millwood in 1887, marking the community’s first federal presence.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millwood%2C_Georgia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The arrival of the railroad turned Millwood into a hub for pine products, allowing timber to reach larger markets efficiently.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/millwood-193264",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Millwood was incorporated as a town in 1905 but its municipal charter was repealed just four years later, in 1909.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Millwood%2C_Georgia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Today, Millwood remains a quiet rural locality, its history still echoing in the surrounding Okefenokee Swamp region.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wisdomlib.org/cities/millwood-193264",
