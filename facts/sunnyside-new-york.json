      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The neighborhood grew from a rural area of farms and industrial outposts along Newtown Creek before the 1909 Queensboro Bridge spurred rapid change.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Web source 1",
