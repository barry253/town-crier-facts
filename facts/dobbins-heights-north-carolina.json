  "facts": [
    {
      "id": 1,
      "text": "Dobbins Heights was once called North Yard, renamed in homage to Jim Dobbins, a 1930s minister who owned much of the area.",
      "sourceSentenceIds": [
        3,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dobbins_Heights%2C_North_Carolina",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1983, Representative Hugh Lee pushed a bill that led to a 1984 referendum, narrowly approving Dobbins Heights’ incorporation.",
      "sourceSentenceIds": [
        5,
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dobbins_Heights%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s roots include the 1908 Pee Dee Institute, a black school built in the former North Yard community.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dobbins_Heights%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Throughout the 1960s, rented homes with outdoor plumbing lined streets that stayed unpaved until the 1980s.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dobbins_Heights%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "A local minister founded the North Yard Improvement Association in the mid‑1960s, raising money to light main roads with streetlights.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Dobbins_Heights%2C_North_Carolina",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "From 1971 to 1972, Army engineers built a recreational area, prompting residents to seek annexation by Hamlet.",
