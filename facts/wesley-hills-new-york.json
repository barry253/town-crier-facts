  "facts": [
    {
      "id": 1,
      "text": "Wesley Hills became an independent village in 1982 when residents united to curb over‑development and shape their own future.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wesleyhills.gov/1306/About",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village spans roughly 3.4 square miles, mostly single‑family homes with a modest commercial hub at its center.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wesleyhills.gov/1306/About",
      "category": "other",
      "quality": "poor",
      "qualityReason": "vague"
    },
    {
      "id": 3,
      "text": "Local parks include Greg Sikorsky Children’s Park on Lime Kiln Road and Willow Tree Park, which offers a stocked pond, nature area, and jogging path.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wesleyhills.gov/1306/About",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The village’s name honors the Wesley Chapel, built in 1829, one of Rockland County’s earliest churches still standing near Spook Rock Road and Route 202.",
      "sourceSentenceIds": [
        16,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.wesleyhills.gov/1306/About",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Gurnee‑Sherwood House, a historic home in Wesley Hills, is listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        11
