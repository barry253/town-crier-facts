  "facts": [
    {
      "id": 1,
      "text": "Burfordville got its name from pioneer John Burford, who helped settle the area.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burfordville%2C_Missouri"
    },
    {
      "id": 2,
      "text": "Swiss‑German immigrant George Frederick Bollinger built the first mill on the Whitewater River in 1797.",
      "sourceSentenceIds": [
        20,
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Burfordville%2C_Missouri"
    },
    {
      "id": 3,
      "text": "The Burfordville Covered Bridge showcases a Howe‑truss design patented by William Howe in 1840.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mostateparks.com/page/bollinger-mill-state-historic-site/burfordville-covered-bridge"
    },
    {
      "id": 4,
      "text": "In 1908 a county contractor received $390 to repair the bridge, a modest sum by today’s standards.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://mostateparks.com/page/bollinger-mill-state-historic-site/burfordville-covered-bridge"
    },
    {
      "id": 5,
      "text": "Both the mill and bridge were donated to the state in 1967 and now form the Bollinger Mill State Historic Site.",
      "sourceSentenceIds": [
        7,
        12
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.legendsofamerica.com/burfordville-missouri/"
    },
    {
      "id": 6,
      "text": "Burfordville sits on the Whitewater River, roughly five miles west of Jackson along Route 34.",
      "sourceSentenceIds": [
