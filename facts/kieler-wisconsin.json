  "facts": [
    {
      "id": 1,
      "text": "Kieler was named after John Kieler, a stone mason from Prussia who arrived in the area in 1855.",
      "sourceSentenceIds": [
        1,
        2,
        3
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://mississippivalleytraveler.com/kieler/"
    },
    {
      "id": 2,
      "text": "George Kieler helped develop the town by building a general store and shoe shop before opening the first post office in 1883.",
      "sourceSentenceIds": [
        14,
        15,
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippivalleytraveler.com/kieler/"
    },
    {
      "id": 3,
      "text": "Immaculate Conception, the only Catholic church in Kieler, was constructed in 1858 for a predominantly German congregation.",
      "sourceSentenceIds": [
        9,
        20
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kieler%2C_Wisconsin"
    },
    {
      "id": 4,
      "text": "The towers of the Immaculate Conception church were added in 1896, followed by the addition of steeples in 1911.",
      "sourceSentenceIds": [
        10,
        21
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Kieler%2C_Wisconsin"
    },
    {
      "id": 5,
      "text": "Early travel to Kieler was difficult due to the local hills, with the daily stagecoach to Louisburg serving as the only connection.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mississippivalleytraveler.com/kieler/"
    },
    {
      "id": 6,
      "text": "Kieler connected to the electric grid in 1926 and received its first paved road in 1931.",
