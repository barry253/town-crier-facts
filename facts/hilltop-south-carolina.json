    },
    {
      "id": 2,
      "text": "Development in the Hilltop vicinity gained momentum during the late 19th and early 20th centuries due to expanding railroad infrastructure.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hilltop_south_carolina"
    },
    {
      "id": 3,
      "text": "Hilltop experiences a humid subtropical climate with hot, humid summers and mild winters typical of the South Carolina Piedmont.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/hilltop_south_carolina"
    },
    {
      "id": 4,
      "text": "The geology of Hilltop includes crystalline rock formations and prevalent red clay soils that support local vegetation.",
      "sourceSentenceIds": [
        25
