      "id": 1,
      "text": "Oak Park hosts the world’s largest collection of Frank Lloyd Wright buildings, including his former studio now a national historic landmark.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
