  "facts": [
    {
      "id": 1,
      "text": "Morris Park takes its name from John Albert Morris, who built the Morris Park Racecourse that operated from 1889 to 1910.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.morrisparkbid.org/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890 the Morris Park Racecourse hosted both the Preakness and Belmont Stakes, with the Belmont running there until 1905.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morris_Park%2C_Bronx",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Streets like Choctaw Place, Narragansett Avenue, Seminole Avenue, and Pawnee Place honor Native American tribes within Morris Park.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morris_Park%2C_Bronx",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Jacobi Medical Center and the Albert Einstein College of Medicine sit on Morris Park’s eastern edge, blending professional life into the neighborhood.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityneighborhoods.nyc/morris-park",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The 49th Precinct, located at 2121 Eastchester Road, patrols the streets of Morris Park.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Morris_Park%2C_Bronx",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Morris Park branch of the New York Public Library, at 985 Morris Park Avenue, was the first library built in the neighborhood.",
