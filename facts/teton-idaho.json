  "facts": [
    {
      "id": 1,
      "text": "Teton County was created in 1915 and named after the nearby Teton Mountains.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Teton_County%2C_Idaho"
    },
    {
      "id": 2,
      "text": "Driggs and Victor sprang up in 1888 and 1889, thanks to irrigation canals that made farming possible.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://welcometetonvalley.org/history/"
    },
    {
      "id": 3,
      "text": "The 1832 rendezvous near present-day Driggs and Victor ended in the Battle of Pierre’s Hole, a clash between trappers and the Blackfeet.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://welcometetonvalley.org/history/"
    },
    {
      "id": 4,
      "text": "A railroad arrived in the early 1900s, linking Teton Valley to wider markets and spurring economic growth.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://welcometetonvalley.org/history/"
    },
    {
      "id": 5,
      "text": "Despite many Idaho cheese factories closing around 1930, Teton Valley dairies and cream shipping continued through the 1940s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://welcometetonvalley.org/history/"
    },
    {
      "id": 6,
      "text": "Before Europeans arrived, Shoshone and Bannock peoples used the valley seasonally for hunting, fishing, and gathering camas roots.",
      "sourceSentenceIds": [
