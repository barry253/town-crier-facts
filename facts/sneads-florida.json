  "facts": [
    {
      "id": 1,
      "text": "Sneads sits on high ground just west of the original Flint‑Chattahoochee River confluence, making it one of Jackson County’s oldest communities.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
