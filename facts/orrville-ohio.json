      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first factory, a pottery, opened in 1862 on West Market Street, marking Orrville’s early industrial growth.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
