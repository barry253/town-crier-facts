  "facts": [
    {
      "id": 1,
      "text": "Acre’s Old City walls were once the site of a 1291 Mamluk siege that left the city a strategic stronghold for centuries.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Acre%2C_Israel",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Great Mosque of al‑Jazzār, built in 1781, still dominates Acre’s skyline and reflects the city’s Ottoman heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Acre-Israel",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Acre’s port hosts a lively fishermen’s market, where fresh catch is sold beside historic caravanserais that once sheltered traveling merchants.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://israel.travel/acre/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the Crusader era, Acre was renamed St. John and became a key naval base for the Latin Kingdom of Jerusalem.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.britannica.com/place/Acre-Israel",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s fort, once a medieval citadel, was later converted into a jail that held Jewish underground leaders during the British Mandate.",
      "sourceSentenceIds": [
        29
