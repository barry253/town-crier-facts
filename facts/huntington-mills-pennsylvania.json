  "facts": [
    {
      "id": 1,
      "text": "Huntington Mills was named in 1799 after Samuel Huntington, a Connecticut native and Declaration signer.",
      "sourceSentenceIds": [
        1,
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huntington_mills_pennsylvania",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The community sits in a rolling agricultural valley along Huntington Creek, the geographic center of Huntington Township.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huntington_mills_pennsylvania",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Early commerce flowed along the 1812 Berwick‑to‑Towanda turnpike, a toll road that carried grain, lumber, and textiles until it was abandoned around 1845.",
      "sourceSentenceIds": [
        3,
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huntington_mills_pennsylvania",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The first recorded settler, John Franklin, built a log house on Huntington Creek in 1775, marking the start of permanent habitation.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huntington_mills_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Key historical mills operated by early families solidified Huntington Mills’ milling heritage, a legacy still visible in the town’s layout.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huntington_mills_pennsylvania",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Originally part of Bloomingdale Township under disputed Connecticut claims, Huntington Mills became Pennsylvania territory after the 1782 Trenton Decree.",
      "sourceSentenceIds": [
        1,
        22
      ],
