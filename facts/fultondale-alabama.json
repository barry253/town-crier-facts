  "facts": [
    {
      "id": 1,
      "text": "Fultondale began in the early 1900s as Fulton Springs, a modest mining community that grew around coal extraction.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://fultondale.com/our-history/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In the 1870s, entrepreneur Bartholomew Boyle bought 2,000 acres and opened coal mines named after his daughter Mary Lee.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/fultondale/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fultondale was created when the towns of Lewisburg, Glendale, and Fulton Springs merged into one municipality.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://encyclopediaofalabama.org/article/fultondale/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The city officially incorporated in 1947, solidifying its status as a distinct community within Jefferson County.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fultondale%2C_Alabama",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Before Interstate 65, US 31 was the main northbound route from Birmingham to Nashville, and its old alignment—now Stouts Road—still traces through Fultondale.",
      "sourceSentenceIds": [
        17,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fultondale%2C_Alabama",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "route_only"
    },
    {
      "id": 6,
      "text": "On the city’s southern edge once stood the Skyview drive‑in theatre, one of only a few in the Birmingham area, before it was demolished when I‑65 was built.",
      "sourceSentenceIds": [
        19,
