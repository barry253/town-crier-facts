  "facts": [
    {
      "id": 1,
      "text": "White Oak earned its name from the state tree, the white oak, whose pale bark and gray twigs inspired Maryland’s official symbol.",
      "sourceSentenceIds": [
        4,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://mocoshow.com/2025/12/26/the-history-behind-marylands-state-tree/",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The state tree was chosen because it is widespread across Maryland and deeply tied to the state’s history.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mocoshow.com/2025/12/26/the-history-behind-marylands-state-tree/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Native Americans ground white oak acorns into flour, a practice later adopted by early European settlers in the area.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://mocoshow.com/2025/12/26/the-history-behind-marylands-state-tree/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "White Oak was once home to the Naval Ordnance Laboratory, a major defense research site that closed in 1994.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/White_Oak%2C_Maryland",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Rachel Carson, the famed author of *Silent Spring*, lived in the Quaint Acres subdivision of White Oak while writing her landmark book.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
