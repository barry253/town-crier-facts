  "facts": [
    {
      "id": 1,
      "text": "Montgomery, Texas, is one of the oldest towns in the state and the birthplace of the Texas flag.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.montgomerytexas.gov/tourism/page/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town was founded in 1835 when Shepperd opened the first store and named the settlement Montgomery after early settlers.",
      "sourceSentenceIds": [
        2,
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Texas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Fernland Historical Park, opened in 2012, preserves some of Texas’s oldest buildings and artifacts in Montgomery.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Old Montgomery Cemetery, a historic marker site, holds the graves of the town’s earliest settlers.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Montgomery%2C_Texas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Montgomery’s historic downtown features a walking tour that links many preserved 19th‑century buildings, including the Davis Cottage Museum and the First State Bank.",
