  "facts": [
    {
      "id": 1,
      "text": "Carbondale, Kansas, was founded in 1869, marking the start of a community that would grow around coal mining.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Carbondale%2C_Kansas"
    },
    {
      "id": 2,
      "text": "Carbondale’s name comes from the Carbon Coal Company, whose first buildings were erected there in the late 1860s.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carbondaleks.com/historic-information"
    },
    {
      "id": 3,
      "text": "In spring 1869, the Atchison, Topeka & Santa Fe Railroad reached Carbondale, building a switch to serve nearby coal fields.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carbondaleks.com/historic-information"
    },
    {
      "id": 4,
      "text": "Carbondale was incorporated as a third‑class city on October 15, 1872, formalizing its municipal status.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://carbondaleks.com/historic-information"
    },
    {
      "id": 5,
      "text": "The Carbondale City Library opened in 1971 and joined the Northeast Kansas Library System, offering residents a regional resource.",
      "sourceSentenceIds": [
