  "facts": [
    {
      "id": 1,
      "text": "Buhl was named for Frank H. Buhl, a mining businessman who helped shape the region.",
      "sourceSentenceIds": [
        1,
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buhl%2C_Minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Buhl’s water comes from a glacial aquifer 700 feet below ground, earning the motto “The Finest Water in America.”.",
      "sourceSentenceIds": [
        2,
        10,
        14
      ],
      "sourceLabels": [
        "Web source 2",
        "Wikipedia"
      ],
      "source": "https://www.cityofbuhlmn.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Buhl sits high on the Laurentian Divide, midway across the historic Mesabi Iron Range.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofbuhlmn.com/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Mesabi Trail winds through Buhl, offering a panoramic view of the historic Grant Iron Mine.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.cityofbuhlmn.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Buhl was incorporated on February 25, 1901, marking its official recognition as a city in Saint Louis County.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Buhl%2C_Minnesota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Buhl Library houses the city’s most precious artifacts, preserving local history for residents and visitors.",
