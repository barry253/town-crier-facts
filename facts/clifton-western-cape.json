  "facts": [
    {
      "id": 1,
      "text": "Clifton’s four beaches are split by granite boulders and boast almost pure white quartzite sand.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Cape_Town",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The beaches are named 1st to 4th from north to south, a naming that feels almost superfluous because of their beauty.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.sa-venues.com/attractionswc/clifton.php",
      "category": "other",
      "quality": "poor",
      "qualityReason": "editorial_filler"
    },
    {
      "id": 3,
      "text": "Clifton was originally called Skoenmakers Gat after a ship deserter who lived in a cave above Second Beach.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Cape_Town",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "A seasonal fifth beach, Moses Beach, appears and disappears as sand washes in and out with the seasons.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Cape_Town",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Fourth Beach draws families and anchors yachts, especially for summer weekends every day.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Clifton%2C_Cape_Town",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Original bungalows between Fourth and Second beaches were built from packing cases that carried imported motor cars in the 1920s and 30s.",
