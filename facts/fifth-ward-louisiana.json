  "facts": [
    {
      "id": 1,
      "text": "Fifth Ward earned its name by honoring King Louis XIV of France, reflecting the town’s French heritage.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://the50unitedstates.com/louisiana/fifth-ward",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "After devastating floods in 1780, French pioneers from Pointe Coupée settled in Fifth Ward, shaping its early colonial character.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fifth_ward_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In the 1860s, Jean Batiste Bringol operated Avoyelles Parish’s first steam‑powered cotton gin right in Fifth Ward.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/fifth_ward_louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "During the 1927 Great Flood, most of Avoyelles Parish was submerged, but a small Fifth Ward enclave—dubbed “The Island”—remained dry.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Fifth_Ward%2C_Louisiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Bayou Boeuf, a key waterway, winds through Fifth Ward, draining surrounding lowlands into the Red River system.",
      "sourceSentenceIds": [
        25
