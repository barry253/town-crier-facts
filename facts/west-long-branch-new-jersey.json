  "facts": [
    {
      "id": 1,
      "text": "West Long Branch sits on the Atlantic coast, just a few blocks from the historic Long Branch beach that became a Gilded Age resort in the late 18th century.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Long_Branch%2C_New_Jersey",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The borough’s train station, three blocks from the beach, marks the end of electrified trackage, forcing southbound travelers to switch to diesel.",
      "sourceSentenceIds": [
        8
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Long_Branch%2C_New_Jersey",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1987, a massive fire destroyed the famed amusement pier and Haunted Mansion in Long Branch, a landmark that once drew crowds to West Long Branch’s waterfront.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Long_Branch%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "West Long Branch shares the same transit village designation approved in 2013, aiming to encourage denser development and revitalization near its train station.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Long_Branch%2C_New_Jersey",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "The Seven Presidents Oceanfront Park, named for presidents who visited the resort town, lies just north of West Long Branch and reflects the borough’s historic ties to national leaders.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Long_Branch%2C_New_Jersey",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Garfield’s famous tea house in Elberon was built from railroad ties that once carried his train, a reminder of the borough’s connection to the rail network that serves West Long Branch.",
