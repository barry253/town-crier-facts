  "facts": [
    {
      "id": 1,
      "text": "Lake of the Woods began as a resort community built around a man‑made lake, now featuring two lakes: the Main Lake and Keaton's Lake.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_of_the_Woods%2C_Virginia",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Main Lake spans 500 acres, fed by Flat Run and springs, and its depth ranges from 2 feet to 45 feet near the dam.",
      "sourceSentenceIds": [
        14,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_of_the_Woods%2C_Virginia",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A 1,450‑foot Veterans Memorial Dam, erected in 1968, sits on the northwestern edge of the Main Lake.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_of_the_Woods%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The gated subdivision covers about 2,600 acres with 4,260 lots, 850 of which have lake frontage, spread across 16 sections named after southern landmarks.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lake_of_the_Woods%2C_Virginia",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Lake of the Woods was developed in 1967 by Virginia Wildlife Clubs, a subsidiary of U.S. Land, Inc., and later built into single‑family homes by Boise Cascade Corporation.",
      "sourceSentenceIds": [
        28,
        29
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.lowa.org/About-Us",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The community’s main entrance lies on Virginia Route 3, roughly halfway between Fredericksburg and Culpeper, 15 miles west of I‑95.",
