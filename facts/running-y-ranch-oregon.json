  "facts": [
    {
      "id": 1,
      "text": "Wendolin Nus became the first settler at Running Y Ranch in 1866, building a homestead and a rock wall that still stands.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.iliveattherunningy.com/ry-history/"
    },
    {
      "id": 2,
      "text": "Running Y Ranch spans 3,600 acres of ranch, forest, and wetlands on the shores of Upper Klamath Lake.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://runningy.com/our-story/"
    },
    {
      "id": 3,
      "text": "The Running Y Ranch Golf Course is located in Payne Canyon, situated in the center of the local hills.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Running_Y_Ranch%2C_Oregon"
    },
    {
      "id": 4,
      "text": "Early ranchers at Running Y drove cattle onto the marshes in summer to feed on native grasses like sedges and tules.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.iliveattherunningy.com/ry-history/"
    },
    {
      "id": 5,
      "text": "The name Caledonia Marsh likely originated from the Scottish McCornack family, who acquired thousands of acres in the area.",
      "sourceSentenceIds": [
