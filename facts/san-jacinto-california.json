  "facts": [
    {
      "id": 1,
      "text": "San Jacinto was founded in 1870 and incorporated on April 9, 1888, making it one of Riverside County’s oldest communities.",
      "sourceSentenceIds": [
        1,
        5
      ],
      "sourceLabels": [
        "Web source 1",
        "Wikipedia"
      ],
      "source": "https://www.sanjacintoca.gov/explore_san_jacinto/san_jacinto_history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The city’s name comes from Saint Hyacinth, a 13th‑century saint, and the valley was named by Mission padres in the 1820s.",
      "sourceSentenceIds": [
        8,
        10
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Jacinto%2C_California",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "In 1888 the Santa Fe railroad built a branch line into the valley, ending at San Jacinto and sparking its growth.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.sanjacintoca.gov/explore_san_jacinto/san_jacinto_history",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "San Jacinto College, a community college established in 1965, serves the region’s higher‑education needs.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Jacinto%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Soboba Casino, operated by the Soboba Band of Luiseño Indians, is a notable landmark in the city.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/San_Jacinto%2C_California",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In 1937 San Jacinto was the landing point for Mikhail Gromov’s historic 6,262‑mile polar flight, the longest nonstop flight of its time.",
