  "facts": [
    {
      "id": 1,
      "text": "Coello’s name comes from the first postmaster, Pete Coello, who donated the original post office building and equipment in 1918.",
      "sourceSentenceIds": [
        12,
        1
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/North_City%2C_Illinois",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The village grew around coal mining, with mines opening in the early 1900s and drawing workers and families to the area.",
      "sourceSentenceIds": [
        3,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_city_illinois",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Basic roads were built to link the mines to rail lines, and company houses formed a simple village layout amid the rural landscape.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_city_illinois",
      "category": "transport",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 4,
      "text": "Former mine sites have been reclaimed, blending into wooded and agricultural land while leaving a legacy of coal extraction.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/north_city_illinois",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Coello sits in Franklin County’s Tornado Alley, where thunderstorms and tornadoes are common, with several outbreaks each year.",
