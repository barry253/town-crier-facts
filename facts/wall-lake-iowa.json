  "facts": [
    {
      "id": 1,
      "text": "Wall Lake was platted in 1877 by the Blair Town Lot and Land Company, and the Chicago and North Western Railroad spurred rapid growth.",
      "sourceSentenceIds": [
        1,
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wall_lake_iowa",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Chicago & North Western Passenger Depot, built in 1899, stands as a preserved landmark listed on the National Register of Historic Places.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wall_lake_iowa",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Wall Lake is the birthplace of singer Andy Williams, whose family home has been restored to reflect 1930s Iowa life.",
      "sourceSentenceIds": [
        4,
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wall_lake_iowa",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The town’s namesake lake is a glacial kettle lake formed about 10,000 years ago during the last ice sheet retreat.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://grokipedia.com/page/wall_lake_iowa",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Wall Lake’s early settlers were drawn by fertile black loam farmlands, ideal for agriculture, lumber, and grain shipping.",
