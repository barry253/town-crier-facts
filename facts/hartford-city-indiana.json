  "facts": [
    {
      "id": 1,
      "text": "Hartford City’s name comes from “Hart’s ford,” a crossing over Lick Creek, per local folklore.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartford_City%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s historic brick home at 321 N High St now houses the Blackford County Historical Society, the museum, and the Cecil Beeson Genealogy Library.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.in.gov/hartfordcitylibrary/info/local-history/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Hartford City benefited from two railroad lines that crossed north–south and east–west, giving it a transportation advantage in the 19th century.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartford_City%2C_Indiana",
      "category": "transport",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Blackford County Courthouse and First Presbyterian Church are listed on the National Register of Historic Places, adding historic charm.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartford_City%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The city’s Carnegie library, funded by Andrew Carnegie in 1903, remains a key public library today.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hartford_City%2C_Indiana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Overhead Door, founded in 1923, and 3M, established there in 1955, replaced the glass factories as major employers after the gas boom.",
