  "facts": [
    {
      "id": 1,
      "text": "St. Cloud sits on the Mississippi River, its name borrowed from the Paris suburb Saint‑Cloud, itself named for the 6th‑century monk Clodoald.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Cloud%2C_Minnesota",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1868, the arrival of the railroad and the opening of the first granite quarry sparked rapid growth in St. Cloud.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ci.stcloud.mn.us/456/History-of-the-City",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "St. Cloud’s East Side blends historic industrial buildings with creative lofts, showcasing the city’s transition from manufacturing to arts.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitstcloud.com/",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "German settlers first arrived in St. Cloud in the late 1800s, followed by Polish and Irish immigrants who shaped the city’s cultural fabric.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/St._Cloud%2C_Minnesota",
      "category": "people",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "St. Cloud boasts nearly 6,000 historic structures built before 1955, reflecting its rich architectural heritage.",
      "sourceSentenceIds": [
        29
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.ci.stcloud.mn.us/456/History-of-the-City",
      "category": "landmark",
      "quality": "good"
    },
