  "facts": [
    {
      "id": 1,
      "text": "Pony, Montana earned its name from Tecumseh “Pony” Smith, a prospector of very small stature who found gold in 1866.",
      "sourceSentenceIds": [
        2,
        5
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Pony%2C_Montana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "In 1890 the Northern Pacific Railroad’s Red Bluff and Pony branch line arrived, turning Pony into a bustling mining hub.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128599",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The town’s 192‑acre Pony Historic District, with 95 contributing buildings, sits on the National Register of Historic Places.",
      "sourceSentenceIds": [
        9
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pony%2C_Montana",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Local masons built the Queen Anne‑style Pony School and the Morris State Bank, showcasing the town’s architectural pride.",
      "sourceSentenceIds": [
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.mtmemory.org/nodes/view/128599",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "By 1922 all mining operations in Pony had closed, marking the end of its gold‑mining era.",
      "sourceSentenceIds": [
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Pony%2C_Montana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Pony gained telephone service and electricity in the early 1900s, giving the town a more urban feel.",
