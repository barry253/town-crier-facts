  "facts": [
    {
      "id": 1,
      "text": "Elsberry was laid out in 1871 and named after founder Robert T. Elsberry, giving the town its distinctive name.",
      "sourceSentenceIds": [
        1,
        6
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsberry%2C_Missouri",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s origin ties directly to the railroad, with local landowners convincing the Clarksville and Western Railroad to build a depot on their property in 1879.",
      "sourceSentenceIds": [
        7,
        8
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.greatriverroad.com/elsberry",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "A post office has operated in Elsberry continuously since 1879, marking the town’s long‑standing role as a local hub.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsberry%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "The Joseph R. Palmer Family Library, part of the city’s historic preservation efforts, serves as a community gathering spot and resource center.",
      "sourceSentenceIds": [
        12,
        13,
        14
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Elsberry%2C_Missouri",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "After the 1993 flood, trees from Forrest Keeling were planted to reforest damaged wetlands, a project that also inspired similar efforts nationwide.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.greatriverroad.com/elsberry",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "The Elsberry Historical Society is restoring a relocated twin‑pin house, aiming to preserve the town’s architectural heritage for future generations.",
