  "facts": [
    {
      "id": 1,
      "text": "West Lebanon got its name in 1869 when the town was incorporated, likely honoring the Boone County Lebanon that opened a post office just eleven days earlier.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Lebanon%2C_Indiana",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "When the Wabash Railroad line opened a mile north of town in 1856, most residents moved closer to the station, reshaping West Lebanon.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Lebanon%2C_Indiana",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "West Lebanon still operates its Carnegie Library, built in 1916, a historic touchstone in the town’s downtown.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://westlebanonindiana.com/",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Every year the last weekend of September, West Lebanon hosts the Patriot Festival, celebrating its high school mascot Seeger High School.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/West_Lebanon%2C_Indiana",
      "category": "culture",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "West Lebanon sits just south of State Road 28, about 7.5 miles east of the Illinois border and five miles west of Williamsport.",
      "sourceSentenceIds": [
        5,
        28
      ],
      "sourceLabels": [
        "Web source 1",
