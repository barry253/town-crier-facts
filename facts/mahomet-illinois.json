  "facts": [
    {
      "id": 1,
      "text": "Mahomet was first settled in 1832 on the Sangamon River, becoming the earliest community in modern Champaign County.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mahomet%2C_Illinois"
    },
    {
      "id": 2,
      "text": "The village’s name evolved from Middletown to Mahomet after a post office adopted the name of a Mohegan sachem, Mahomet Weyonomon, in 1838.",
      "sourceSentenceIds": [
        18,
        21
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mahomet%2C_Illinois"
    },
    {
      "id": 3,
      "text": "In 1871 the railroad arrival prompted the town to officially adopt the Mahomet name, since another Middletown existed in Illinois.",
      "sourceSentenceIds": [
        7
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Mahomet%2C_Illinois"
    },
    {
      "id": 4,
      "text": "Mahomet hosts the Mahomet Historical Society Museum, which preserves local artifacts and tells the town’s pioneer story.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/mahomet-41603"
    },
    {
      "id": 5,
      "text": "The Mahomet Public Library, part of the village’s historic civic life, offers a quiet spot for readers amid the rural setting.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/mahomet-41603"
