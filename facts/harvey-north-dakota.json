      ],
      "source": "https://en.wikipedia.org/wiki/Harvey%2C_North_Dakota",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first newspaper, the Harvey Advertiser, began publishing on July 27, 1893, right after the town’s founding.",
      "sourceSentenceIds": [
