  "facts": [
    {
      "id": 1,
      "text": "Cedar Lane is an unincorporated community in Matagorda County, Texas.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Cedar_Lane%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town sits on Caney Creek at the junction of Farm Roads 457 and 521, about twenty miles southeast of Bay City.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cedar-lane-tx"
    },
    {
      "id": 3,
      "text": "In 1912 Cedar Lane opened its own post office and became a stop on the Texas and New Orleans Railroad.",
      "sourceSentenceIds": [
        5,
        15
      ],
      "sourceLabels": [
        "Web source 1",
        "Web source 2"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cedar-lane-tx"
    },
    {
      "id": 4,
      "text": "Early settlers clustered around a plantation store, with a lane of cedar trees giving the community its name.",
      "sourceSentenceIds": [
        24
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cedar-lane-tx"
    },
    {
      "id": 5,
      "text": "By 1936 the settlement boasted a church, a school, two businesses, sixteen homes, and a paved main street.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cedar-lane-tx"
    },
    {
      "id": 6,
      "text": "In 1967 Cedar Lane had 57 residents and three businesses, reflecting its steady, small‑town character.",
      "sourceSentenceIds": [
        26
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.tshaonline.org/handbook/entries/cedar-lane-tx"
