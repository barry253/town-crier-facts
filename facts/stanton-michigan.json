  "facts": [
    {
      "id": 1,
      "text": "Stanton’s name honors U.S. President Ulysses S. Grant, who visited the area in the 1860s.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Stanton%2C_Michigan",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first map dates to 1884, showing a bustling downtown with a hotel, school, and several factories.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-stanton-michigan",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Historic Sanborn Fire Insurance Maps reveal Stanton’s original street layout, including the footprint of its first post office.",
      "sourceSentenceIds": [
        11,
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-stanton-michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Stanton’s early economy relied on sawmills powered by the nearby Flat River, a fact highlighted in 19th‑century county histories.",
      "sourceSentenceIds": [
        28
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.michigan.gov/libraryofmichigan/public/michigan/county-guides/guides/montcalm",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s 1884 map shows a railway line that once connected Stanton to larger Michigan markets.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://hometownhistorymaps.com/pages/history-of-stanton-michigan",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Local historians use Stanton’s old maps to create accurate scale models of the town for educational exhibits.",
