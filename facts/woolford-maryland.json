  "facts": [
    {
      "id": 1,
      "text": "Woolford derives its name from Roger Woolford, an early settler who arrived around 1661–1662 and patented land near the Nanticoke River.",
      "sourceSentenceIds": [
        25
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woolford_maryland",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The Old Woolford Place, a Flemish bond brick house built circa 1725–1750, stands overlooking Fishing Creek and is one of Dorchester County's oldest surviving brick homes.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woolford_maryland",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Woolford sits on Maryland Route 16, just 1.5 miles west of Church Creek, within the Chesapeake Bay floodplain that shapes its low‑lying, marshy landscape.",
      "sourceSentenceIds": [
        12,
        2
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Woolford%2C_Maryland",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The community’s soils are alluvial and hydric, formed from recent river and marine deposits, giving the area fertile ground that historically supported tobacco and mixed farming.",
      "sourceSentenceIds": [
        16,
        9
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woolford_maryland",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "Woolford’s humid subtropical climate brings hot, humid summers with highs around 82–86°F and cool, wet winters dipping to 29–33°F, averaging 57°F year‑round.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woolford_maryland",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Conservation projects in Woolford focus on marsh restoration and shoreline management, using oyster reefs and wetland migration to counter sea‑level rise and flooding.",
      "sourceSentenceIds": [
        23,
        21
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/woolford_maryland",
