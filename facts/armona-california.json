  "facts": [
    {
      "id": 1,
      "text": "Armona got its name from a misspelled grave marker, a story passed down by Uncle Jim, and some say it’s a playful swap of the letters in 'Ramona'.",
      "sourceSentenceIds": [
        1,
        2,
        16
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Armona%2C_California"
    },
    {
      "id": 2,
      "text": "The town moved to its current spot on the Southern Pacific Railroad in 1891, and freight service still runs through Armona today.",
      "sourceSentenceIds": [
        4,
        5,
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Armona%2C_California"
    },
    {
      "id": 3,
      "text": "The first school, Giddings, opened in 1880; a brick building followed in the 1920s, but it was replaced in 1953 by the earthquake‑compliant Armona Elementary.",
      "sourceSentenceIds": [
        17,
        18,
        19
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Armona%2C_California"
    },
    {
      "id": 4,
      "text": "Armona’s post office began operating in 1887, long before the town was officially incorporated.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Armona%2C_California"
    },
    {
      "id": 5,
      "text": "Armona proudly proclaims its motto, 'Small and Proud,' a nod to its tight‑knit community spirit.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Armona%2C_California"
    },
    {
      "id": 6,
      "text": "The Armona Community Library, part of the Kings County Library System, sits on 11115 'C' St and serves as a local hub for books and events.",
