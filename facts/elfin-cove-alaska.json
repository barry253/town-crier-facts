  "facts": [
    {
      "id": 1,
      "text": "Elfin Cove, Alaska, began as a natural harbor where sailors sought refuge from stormy northern waters.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/elfin-cove/history",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Its proximity to Cross Sound and open ocean made Elfin Cove an ideal base for salmon and halibut harvest.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/elfin-cove/history",
      "category": "economy",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "The village earned the name Elfin Cove in 1935, inspired by a fairy‑tale vibe or the ship 'Elfin'.",
      "sourceSentenceIds": [
        19
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/elfin-cove/history",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Because of rugged terrain, Elfin Cove has never had a land road; all travel and trade happen by water.",
      "sourceSentenceIds": [
        22
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/elfin-cove/history",
      "category": "other",
      "quality": "poor",
      "qualityReason": "other"
    },
    {
      "id": 5,
      "text": "Entrepreneur Ernie Swanson erected the first shop, restaurant, and pier in the 1930s, sparking permanent settlement.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.kupi.com/en/explore/united-states/elfin-cove/history",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "A close‑knit, self‑sufficient culture emerged, with every resident tied to the sea through fishing and water‑borne trade.",
