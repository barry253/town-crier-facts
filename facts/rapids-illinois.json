  "facts": [
    {
      "id": 1,
      "text": "Rapids City was laid out in 1838 and officially incorporated in 1875, growing rapidly during the 1870s and 1880s.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rapidscity.us/"
    },
    {
      "id": 2,
      "text": "The village’s boom came from nearby coal mines, with stores, a blacksmith, and a hotel serving miners, farmers, and their families.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rapidscity.us/"
    },
    {
      "id": 3,
      "text": "Charles Shuler ran the Rapids City Coal Mining Company in the 1880s, a key player in the local mining scene.",
      "sourceSentenceIds": [
        14
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rapidscity.us/"
    },
    {
      "id": 4,
      "text": "Today Rapids City sits on the Mississippi River in northwestern Illinois, part of the Quad Cities metropolitan area.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rapidscity.us/"
    },
    {
      "id": 5,
      "text": "The village lies where Interstate 80 crosses into Iowa, making it a unique border point between the two states.",
      "sourceSentenceIds": [
        16
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rapidscity.us/"
    },
    {
      "id": 6,
      "text": "Rapids City covers 960 acres, with a perimeter just under six miles, giving it a compact yet well‑defined shape.",
      "sourceSentenceIds": [
        17
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.rapidscity.us/"
    }
  ]
