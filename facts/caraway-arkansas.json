    {
      "id": 1,
      "text": "Caraway started life as the lumber camp White Switch in 1912 before evolving into the town we see today.",
      "sourceSentenceIds": [
        1,
        29
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Caraway%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The town’s first post office opened on September 28, 1916, with Joseph Ewing Johnston as its inaugural postmaster.",
      "sourceSentenceIds": [
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://www.cityofcarawayar.org/city-info",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Caraway sits in the Arkansas Delta, within the Francis Lowlands ecoregion of the larger Mississippi Alluvial Plain.",
      "sourceSentenceIds": [
        9,
        10,
        11
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caraway%2C_Arkansas",
      "category": "other",
      "quality": "poor",
      "qualityReason": "location_description"
    },
    {
      "id": 4,
      "text": "The flat terrain of Caraway still bears sand blows and sunken lands left by the 1811–12 New Madrid earthquakes.",
      "sourceSentenceIds": [
        12
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Caraway%2C_Arkansas",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "In 1923 Caraway was incorporated, taking its name from U.S. Senator Thaddeus Caraway.",
      "sourceSentenceIds": [
        8,
        28
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 1"
      ],
      "source": "https://en.wikipedia.org/wiki/Caraway%2C_Arkansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Caraway is part of Craighead County and falls within the Jonesboro Metropolitan Statistical Area.",
