  "facts": [
    {
      "id": 1,
      "text": "Channing was founded in 1888 by George Channing Rivers, a paymaster for the Fort Worth and Denver City Railway.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channing%2C_Texas"
    },
    {
      "id": 2,
      "text": "The town’s original name was Rivers, changed to Channing later that year to avoid duplication with another Texas community.",
      "sourceSentenceIds": [
        5,
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channing%2C_Texas"
    },
    {
      "id": 3,
      "text": "Channing became the headquarters of the XIT Ranch, once the largest ranch in the world under fence during the 1880s.",
      "sourceSentenceIds": [
        24,
        25,
        17
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Channing%2C_Texas"
    },
    {
      "id": 4,
      "text": "A brick courthouse was completed in 1906 after a frame courthouse was hauled into town by mounted XIT cowboys in 1903.",
      "sourceSentenceIds": [
        29,
        30
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channing%2C_Texas"
    },
    {
      "id": 5,
      "text": "Two years after the town’s founding, a local women’s club established one of the earliest public libraries in the Texas Panhandle.",
      "sourceSentenceIds": [
        20
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Channing%2C_Texas"
    },
    {
      "id": 6,
      "text": "The historic courthouse building now serves as a museum of Texas history, preserved by the Texas State Historical Association.",
      "sourceSentenceIds": [
        6,
        16
      ],
      "sourceLabels": [
