  "facts": [
    {
      "id": 1,
      "text": "Suffield Township was named after Suffield, Connecticut, the hometown of many of its first settlers.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suffield_Township%2C_Portage_County%2C_Ohio"
    },
    {
      "id": 2,
      "text": "The Suffield Township Historical Society Museum sits in the town’s original fire station just south of the town hall on State Route 43.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.neoimc.org/museum-listings/r-z/suffield-township-historical-society"
    },
    {
      "id": 3,
      "text": "The museum houses a large collection of artifacts and memorabilia from the community, including an extensive county speedometer collection, local newspapers, and maps.",
      "sourceSentenceIds": [
        24,
        9
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.neoimc.org/museum-listings/r-z/suffield-township-historical-society"
    },
    {
      "id": 4,
      "text": "A post office called Suffield operated from 1836 until 1966, marking the township’s early communication hub.",
      "sourceSentenceIds": [
        15
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suffield_Township%2C_Portage_County%2C_Ohio"
    },
    {
      "id": 5,
      "text": "The township’s board of trustees elects three members, with two chosen the year after a presidential election and one the year before.",
      "sourceSentenceIds": [
        17,
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Suffield_Township%2C_Portage_County%2C_Ohio"
    },
    {
      "id": 6,
      "text": "Lifetime members of the Historical Society receive a t‑shirt, hat, and a History of Suffield bicentennial book as a thank‑you for preserving local heritage.",
      "sourceSentenceIds": [
        7
      ],
