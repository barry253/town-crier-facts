    },
    {
      "id": 2,
      "text": "The 1919 bunkhouse and company store of the Parrish Wooden Bowl Factory remains one of Hulbert's oldest buildings.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Hulbert%2C_Michigan"
    },
    {
      "id": 3,
      "text": "The Tahquamenon Hotel started as a 1919 bunkhouse for factory workers before evolving into a lodging house.",
      "sourceSentenceIds": [
        9
