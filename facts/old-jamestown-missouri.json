  "facts": [
    {
      "id": 1,
      "text": "Old Jamestown’s name comes from a person named James, a common practice for early settlements in English‑speaking America.",
      "sourceSentenceIds": [
        1,
        2
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/old-jamestown-23221",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "The first documented reference to Jamestown dates to June 1819, marking its official appearance on maps and records.",
      "sourceSentenceIds": [
        10
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldjamestownassociation.org/old-jamestown-history-highlights/",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Old Jamestown sits on a bluff along the southern bank of the Missouri River, just six miles above its confluence with the Mississippi.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldjamestownassociation.org/old-jamestown-history-highlights/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Before settlers arrived, the Missouri River and Mill Creek junction was a favored campsite for Native Americans of the late Woodland and Mississippian periods.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://oldjamestownassociation.org/old-jamestown-history-highlights/",
      "category": "nature",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The town’s history reflects the broader westward expansion that shaped Missouri’s development during the early 19th century.",
      "sourceSentenceIds": [
        13
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://www.wisdomlib.org/cities/old-jamestown-23221",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "Old Jamestown’s landscape still shows the natural beauty of rolling hills and river bluffs that once guided early travelers and traders.",
      "sourceSentenceIds": [
        5
      ],
      "sourceLabels": [
        "Web source 2"
      ],
