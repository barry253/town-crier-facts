    {
      "id": 1,
      "text": "Huey was named after John Huey, a 1820s landowner who owned a horse‑mill on Crooked Creek.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huey_illinois"
    },
    {
      "id": 2,
      "text": "The Baltimore and Ohio Railroad arrived late 19th century, turning Huey from a farming outpost into a rail village four miles east of Carlyle.",
      "sourceSentenceIds": [
        5,
        6
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huey_illinois"
    },
    {
      "id": 3,
      "text": "Huey began as a Methodist gathering spot in 1826, long before it became an incorporated village.",
      "sourceSentenceIds": [
        4,
        23
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huey_illinois"
    },
    {
      "id": 4,
      "text": "Huey officially incorporated on August 3, 1891.",
      "sourceSentenceIds": [
        22,
        30
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://grokipedia.com/page/huey_illinois"
    },
    {
      "id": 5,
      "text": "Today Huey remains a quiet, low‑density residential community with no major industries or tourist attractions.",
