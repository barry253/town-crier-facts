  "facts": [
    {
      "id": 1,
      "text": "Lecompton was originally called Bald Eagle, renamed in honor of Samuel Dexter Lecompte, chief justice of the territorial Supreme Court.",
      "sourceSentenceIds": [
        1
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lecompton%2C_Kansas",
      "category": "etymology",
      "quality": "good"
    },
    {
      "id": 2,
      "text": "Founded in 1854, Lecompton sits on a bluff on the south bank of the Kansas River.",
      "sourceSentenceIds": [
        5,
        3
      ],
      "sourceLabels": [
        "Wikipedia",
        "Web source 2"
      ],
      "source": "https://en.wikipedia.org/wiki/Lecompton%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 3,
      "text": "Lecompton quickly became a pro‑slavery stronghold, sparking conflict with nearby Lawrence, founded by Free‑Staters from Massachusetts.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lecompton%2C_Kansas",
      "category": "history",
      "quality": "good"
    },
    {
      "id": 4,
      "text": "Constitution Hall, built in 1856 by Sheriff Samuel J., now serves as a museum operated by the Kansas Historical Society.",
      "sourceSentenceIds": [
        4
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lecompton%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 5,
      "text": "The Radical United Brethren Church, erected on adjoining land, was added to the Kansas Register of Historic Places in 2016.",
      "sourceSentenceIds": [
        18
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Lecompton%2C_Kansas",
      "category": "landmark",
      "quality": "good"
    },
    {
      "id": 6,
      "text": "In the 1970s, the community raised funds to rehabilitate the old building into the Territorial Capital Museum, now maintained by the Lecompton Historical Society.",
