  "facts": [
    {
      "id": 1,
      "text": "Sky Valley began as a 1969 ski resort on a former cattle ranch, making it Georgia's northernmost city.",
      "sourceSentenceIds": [
        3
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://rabunhistory.org/towns/sky-valley/"
    },
    {
      "id": 2,
      "text": "After the ski slopes closed in 2004, Sky Valley reinvented itself as a golf resort and tight‑knit community.",
      "sourceSentenceIds": [
        6
      ],
      "sourceLabels": [
        "Web source 2"
      ],
      "source": "https://rabunhistory.org/towns/sky-valley/"
    },
    {
      "id": 3,
      "text": "Sky Valley sits at 3,100 feet above sea level, with slopes reaching over 4,200 feet, making it Georgia's highest incorporated city.",
      "sourceSentenceIds": [
        21,
        22
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sky_Valley%2C_Georgia"
    },
    {
      "id": 4,
      "text": "Rabun County proudly calls itself the Waterfall Capital of Georgia, a title Sky Valley shares as a scenic mountain town.",
      "sourceSentenceIds": [
        2
      ],
      "sourceLabels": [
        "Web source 1"
      ],
      "source": "https://visitskyvalleyga.com/"
    },
    {
      "id": 5,
      "text": "Sky Valley's high elevation gives it a rare temperate subtropical highland climate, uncommon in the southeastern United States.",
      "sourceSentenceIds": [
        23
      ],
      "sourceLabels": [
        "Wikipedia"
      ],
      "source": "https://en.wikipedia.org/wiki/Sky_Valley%2C_Georgia"
    },
    {
      "id": 6,
      "text": "The original ski resort featured five runs—Panorama, Scooter, Kamikaze, Gravity's Revenge, and Pokey—each with its own rope tow.",
      "sourceSentenceIds": [
        1
      ],
